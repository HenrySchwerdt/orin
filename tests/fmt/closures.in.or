// Arrow functions and function types (ADR-0011).
type Handler = { name: string; run: ( s : string ) => string; };
type Pred<T> = (x:T)=>bool;
type Table = ((a: int, b: int) => int)[];

function apply(f: (x: int)=>int, v: int): int { return f(v); }

function curry(a: int): (b: int) => (c: int) => int {
  return b=>c=>a+b+c;
}

