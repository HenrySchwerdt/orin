// Many conversions in a loop (reference counting of boxes and vtable calls).
interface Shape {
  area(): int;
}

class Sq implements Shape {
  constructor(public s: int) {}
  area(): int { return this.s * this.s; }
}

class Rc implements Shape {
  constructor(public w: int, public h: int) {}
  area(): int { return this.w * this.h; }
}

function make(i: int): Shape {
  if (i % 2 == 0) {
    return new Sq(i);
  }
  return new Rc(i, 2);
}

function main(): void {
  let total = 0;
  let i = 0;
  while (i < 2000) {
    const s = make(i);
    const t = s;
    total += t.area() + s.area();
    i += 1;
  }
  console.log(total.toString());
  let keep: Shape[] = [];
  i = 0;
  while (i < 100) {
    keep.push(make(i));
    i += 1;
  }
  let sum = 0;
  for (const k of keep) {
    sum += k.area();
  }
  console.log(sum.toString());
}
