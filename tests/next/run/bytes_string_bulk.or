// Bulk conversions between a `u8[]` and a string (built-ins `bytesToString`, `stringToBytes`): one byte per
// character, no decoding, one allocation. Checked against the per-byte definitions (`charCodeAt`, `fromCharCode`).

function allByteValues(): string {
  let s = "";
  let i = 0;
  while (i < 256) {
    s += String.fromCharCode(i);
    i += 1;
  }
  return s;
}

// the reference implementation: one 1-character string per byte
function slowToString(xs: u8[], start: usize, len: usize): string {
  let s = "";
  let k = start;
  while (k < start + len) {
    s += String.fromCharCode(xs[k].toInt());
    k += 1;
  }
  return s;
}

function sameBytes(a: u8[], b: u8[]): bool {
  if (a.length != b.length) {
    return false;
  }
  let i: usize = 0;
  while (i < a.length) {
    if (a[i] != b[i]) {
      return false;
    }
    i += 1;
  }
  return true;
}

function main(): void {
  // empty and small
  console.log(stringToBytes("").length.toString());
  console.log(bytesToString([], 0, 0).length.toString());
  const abc = stringToBytes("abc");
  console.log(abc.length.toString() + " " + abc[0].toString() + " " + abc[1].toString() + " " + abc[2].toString());
  console.log(bytesToString(abc, 0, 3) + "|" + bytesToString(abc, 1, 2) + "|" + bytesToString(abc, 3, 0) + "|" + bytesToString(abc, 0, 0) + "|");

  // every byte value, including NUL, round trip
  const all = allByteValues();
  const bytes = stringToBytes(all);
  console.log(bytes.length.toString() + " " + bytes[0].toString() + " " + bytes[127].toString() + " " + bytes[128].toString() + " " + bytes[255].toString());
  const back = bytesToString(bytes, 0, bytes.length);
  console.log((back == all).toString() + " " + back.length.toString() + " " + (back.charCodeAt(0) == 0).toString() + " " + back.charCodeAt(255).toString());
  console.log((slowToString(bytes, 10, 200) == bytesToString(bytes, 10, 200)).toString());
  console.log(sameBytes(stringToBytes(back), bytes).toString());

  // the result owns its storage: later changes to the array do not change the string, and vice versa
  let xs = stringToBytes("hello");
  const s1 = bytesToString(xs, 0, 5);
  xs[0] = 72;
  xs.push(33);
  console.log(s1 + " " + bytesToString(xs, 0, 6));
  let ys = xs;
  ys[1] = 69;
  console.log(bytesToString(xs, 0, 6) + " " + bytesToString(ys, 0, 6));

  // a UTF-8 text is converted as bytes, not code points
  const utf = stringToBytes("héllo");
  console.log(utf.length.toString() + " " + utf[1].toString() + " " + utf[2].toString());
  console.log((bytesToString(utf, 0, utf.length) == "héllo").toString());

  // a long input
  let big = "";
  let n = 0;
  while (n < 5000) {
    big += "0123456789abcdef";
    n += 1;
  }
  const bb = stringToBytes(big);
  console.log(bb.length.toString() + " " + (bytesToString(bb, 0, bb.length) == big).toString() + " " + bytesToString(bb, 79990, 10));
}
