// Codegen helpers (pure functions): type predicates, C spellings, literals, arithmetic and
// builtin call shapes. Port of the free functions of bootstrap/src/codegen.rs.

import { exit } from "std:process";
import {
  Type, HExpr, HExprKind, Builtin, BinOp, FieldDef, FieldInitH, HArm
} from "../hir";

export type Lits = { strs: string[]; buckets: usize[][]; };

// How a builtin / call result relates to its arguments (Rust `Kind`).
export type CKind = CkFresh | CkBorrowed | CkVoid;
export type CK = { code: string; kind: CKind; };

export function fail(msg: string): void {
  console.error("codegen: " + msg);
  exit(101);
}

// ---------------------------------------------------------------- types

export function isRef(t: Type): bool {
  return match (t) {
    TyInt => false,
    TyUsize => false,
    TyBool => false,
    TyVoid => false,
    _ => true
  };
}

export function isVoid(t: Type): bool {
  return match (t) { TyVoid => true, _ => false };
}

export function isUsize(t: Type): bool {
  return match (t) { TyUsize => true, _ => false };
}

export function isString(t: Type): bool {
  return match (t) { TyString => true, _ => false };
}

export function cty(t: Type): string {
  return match (t) {
    TyInt => "int64_t",
    TyBool => "int64_t",
    TyUsize => "uint64_t",
    TyVoid => "void",
    _ => "OrinObj *"
  };
}

export function fromSlot(t: Type, code: string): string {
  if (isVoid(t)) {
    return "((void)(" + code + "))";
  }
  if (isRef(t)) {
    return "ORIN_REF(" + code + ")";
  }
  return "((" + cty(t) + ")(" + code + "))";
}

export function toSlot(t: Type, code: string): string {
  if (isRef(t)) {
    return "ORIN_SLOT(" + code + ")";
  }
  return "((uint64_t)(" + code + "))";
}

// Bit i set when slot i is a reference; printed as an unsigned decimal.
export function maskOf(tys: Type[]): usize {
  if (tys.length > 64) {
    fail("more than 64 slots in one record/variant");
  }
  let m: usize = 0;
  let p: usize = 1;
  let i: usize = 0;
  while (i < tys.length) {
    if (isRef(tys[i])) {
      m += p;
    }
    if (i < 63) {
      p *= 2;
    }
    i += 1;
  }
  return m;
}

export function fieldTypes(fs: FieldDef[]): Type[] {
  let out: Type[] = [];
  for (const f of fs) {
    out.push(f.ty);
  }
  return out;
}

// ---------------------------------------------------------------- names and literals

export function sanitize(name: string): string {
  let out = "";
  let start: usize = 0;
  let i: usize = 0;
  while (i < name.length) {
    const c = name.charCodeAt(i);
    const ok = (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122);
    if (!ok) {
      out += name.substring(start, i);
      out += "_";
      start = i + 1;
    }
    i += 1;
  }
  out += name.substring(start, name.length);
  return out;
}

// `*/` must not end the comment that carries a local's name.
export function commentSafe(name: string): string {
  let out = "";
  let i: usize = 0;
  while (i < name.length) {
    if (name.charCodeAt(i) == 42 && i + 1 < name.length && name.charCodeAt(i + 1) == 47) {
      out += "* /";
      i += 2;
    } else {
      out += name.charAt(i);
      i += 1;
    }
  }
  return out;
}

// C string literal with octal escapes for everything but safe printable ASCII.
export function cString(s: string): string {
  let out = "\"";
  let start: usize = 0;
  let i: usize = 0;
  while (i < s.length) {
    const c = s.charCodeAt(i);
    let esc = "";
    if (c == 34) {
      esc = "\\\"";
    } else if (c == 92) {
      esc = "\\\\";
    } else if (c == 63) {
      esc = "\\?";
    } else if (c < 32 || c > 126) {
      esc = "\\" + (c / 64).toString() + ((c / 8) % 8).toString() + (c % 8).toString();
    }
    if (esc.length > 0) {
      out += s.substring(start, i);
      out += esc;
      start = i + 1;
    }
    i += 1;
  }
  out += s.substring(start, s.length);
  out += "\"";
  return out;
}

export function litBucket(s: string): usize {
  let h: usize = 7;
  let i: usize = 0;
  while (i < s.length && i < 12) {
    h = (h * 31 + s.charCodeAt(i).toUsize()) % 1021;
    i += 1;
  }
  return (h + s.length) % 1021;
}

export function newLits(): Lits {
  let b: usize[][] = [];
  const empty: usize[] = [];
  let i: usize = 0;
  while (i < 1021) {
    b.push(empty);
    i += 1;
  }
  const strs: string[] = [];
  return Lits { strs: strs, buckets: b };
}

export function findLit(l: Lits, s: string): Option<usize> {
  const bucket = l.buckets[litBucket(s)];
  for (const id of bucket) {
    if (l.strs[id] == s) {
      return Some(id);
    }
  }
  return None;
}

// Register a literal (no-op when present); returns the updated table.
export function internLit(l: Lits, s: string): Lits {
  if (findLit(l, s).isSome()) {
    return l;
  }
  let strs = l.strs;
  let buckets = l.buckets;
  const id = strs.length;
  strs.push(s);
  buckets[litBucket(s)].push(id);
  return Lits { strs: strs, buckets: buckets };
}

// Index of an already collected literal (see cgen.collectLits).
export function litId(l: Lits, s: string): usize {
  return match (findLit(l, s)) {
    Some(i) => i,
    None => 0
  };
}

// ---------------------------------------------------------------- expression shape analysis

// No side effects and cheap: safe to inline in any evaluation order.
export function isSimple(e: HExpr): bool {
  return match (e.kind) {
    XInt(_) => true,
    XBool(_) => true,
    XStr(_) => true,
    XLocal(_) => true,
    XField(b, _, _) => isSimple(b),
    _ => false
  };
}

export function anyEffects(xs: HExpr[]): bool {
  for (const x of xs) {
    if (hasEffects(x)) {
      return true;
    }
  }
  return false;
}

function armHasEffects(a: HArm): bool {
  if (a.body.stmts.length != 0) {
    return true;
  }
  return match (a.value) {
    Some(v) => hasEffects(v),
    None => false
  };
}

// May evaluating `e` change the value of a local?
export function hasEffects(e: HExpr): bool {
  return match (e.kind) {
    XInt(_) => false,
    XBool(_) => false,
    XStr(_) => false,
    XLocal(_) => false,
    XUnary(_, x) => hasEffects(x),
    XBinary(_, a, b) => hasEffects(a) || hasEffects(b),
    XCall(_, args) => anyEffects(args),
    XBuiltin(_, args) => anyEffects(args),
    XMutMethod(_, _, _) => true,
    XField(b, _, _) => hasEffects(b),
    XIndex(b, i) => hasEffects(b) || hasEffects(i),
    XRecord(_, sp, fields) => recordHasEffects(sp, fields),
    XVariant(_, payload) => anyEffects(payload),
    XArray(xs) => anyEffects(xs),
    XTry(x) => hasEffects(x),
    XCond(c, a, b) => hasEffects(c) || hasEffects(a) || hasEffects(b),
    XMatch(s, arms) => matchHasEffects(s, arms)
  };
}

function recordHasEffects(sp: Option<HExpr>, fields: FieldInitH[]): bool {
  const spe = match (sp) {
    Some(x) => hasEffects(x),
    None => false
  };
  if (spe) {
    return true;
  }
  for (const f of fields) {
    if (hasEffects(f.value)) {
      return true;
    }
  }
  return false;
}

function matchHasEffects(s: HExpr, arms: HArm[]): bool {
  if (hasEffects(s)) {
    return true;
  }
  for (const a of arms) {
    if (armHasEffects(a)) {
      return true;
    }
  }
  return false;
}

// ---------------------------------------------------------------- operators

export function arith(op: BinOp, ty: Type, a: string, b: string): string {
  const suffix = isUsize(ty) ? "u" : "i";
  const name = match (op) {
    OpAdd => "add",
    OpSub => "sub",
    OpMul => "mul",
    OpDiv => "div",
    OpRem => "rem",
    _ => "?"
  };
  return "orin_" + name + "_" + suffix + "(" + a + ", " + b + ")";
}

export function binary(op: BinOp, oty: Type, a: string, b: string): string {
  const str = isString(oty);
  return match (op) {
    OpAdd => str ? "orin_str_concat(" + a + ", " + b + ")" : arith(op, oty, a, b),
    OpSub => arith(op, oty, a, b),
    OpMul => arith(op, oty, a, b),
    OpDiv => arith(op, oty, a, b),
    OpRem => arith(op, oty, a, b),
    OpEq => str ? "orin_str_eq(" + a + ", " + b + ")" : "(" + a + " == " + b + ")",
    OpNe => str ? "(!orin_str_eq(" + a + ", " + b + "))" : "(" + a + " != " + b + ")",
    OpLt => "(" + a + " < " + b + ")",
    OpLe => "(" + a + " <= " + b + ")",
    OpGt => "(" + a + " > " + b + ")",
    OpGe => "(" + a + " >= " + b + ")",
    OpAnd => "(" + a + " && " + b + ")",
    OpOr => "(" + a + " || " + b + ")"
  };
}

function fr(code: string): CK {
  return CK { code: code, kind: CkFresh };
}

function vd(code: string): CK {
  return CK { code: code, kind: CkVoid };
}

function bw(code: string): CK {
  return CK { code: code, kind: CkBorrowed };
}

function c1(f: string, a: string[]): string {
  return f + "(" + a[0] + ")";
}

function c2(f: string, a: string[]): string {
  return f + "(" + a[0] + ", " + a[1] + ")";
}

function c3(f: string, a: string[]): string {
  return f + "(" + a[0] + ", " + a[1] + ", " + a[2] + ")";
}

export function builtinCall(op: Builtin, a: string[], ty: Type): CK {
  return match (op) {
    BConsoleLog => vd(c1("orin_console_log", a)),
    BConsoleError => vd(c1("orin_console_error", a)),
    BStringFromCharCode => fr(c1("orin_string_from_char_code", a)),
    BParseInt => fr(c1("orin_parse_int", a)),
    BFsReadFile => fr(c1("orin_fs_read_file", a)),
    BFsWriteFile => fr(c2("orin_fs_write_file", a)),
    BFsExists => fr(c1("orin_fs_exists", a)),
    BProcessArgs => fr("orin_process_args()"),
    BProcessExit => vd(c1("orin_process_exit", a)),
    BIoReadBytes => fr(c1("orin_io_read_bytes", a)),
    BIoReadLine => fr("orin_io_read_line()"),
    BIoWriteStdout => vd(c1("orin_io_write_stdout", a)),
    BStrLength => fr(c1("orin_str_len", a)),
    BStrCharCodeAt => fr(c2("orin_str_char_code_at", a)),
    BStrCharAt => fr(c2("orin_str_char_at", a)),
    BStrSubstring => fr(c3("orin_str_substring", a)),
    BStrIndexOf => fr(c2("orin_str_index_of", a)),
    BStrIncludes => fr(c2("orin_str_includes", a)),
    BStrStartsWith => fr(c2("orin_str_starts_with", a)),
    BStrEndsWith => fr(c2("orin_str_ends_with", a)),
    BStrSplit => fr(c2("orin_str_split", a)),
    BStrTrim => fr(c1("orin_str_trim", a)),
    BArrLength => fr(c1("orin_array_len", a)),
    BArrGet => fr(c2("orin_array_get", a)),
    BArrSlice => fr(c3("orin_array_slice", a)),
    BArrConcat => fr(c2("orin_array_concat", a)),
    BArrJoin => fr(c2("orin_array_join", a)),
    BIntToString => fr(c1("orin_int_to_string", a)),
    BIntToUsize => fr(c1("orin_int_to_usize", a)),
    BUsizeToString => fr(c1("orin_usize_to_string", a)),
    BUsizeToInt => fr(c1("orin_usize_to_int", a)),
    BBoolToString => fr(c1("orin_bool_to_string", a)),
    BOptIsSome => fr("(orin_tag(" + a[0] + ") == 0)"),
    BOptIsNone => fr("(orin_tag(" + a[0] + ") == 1)"),
    BResIsOk => fr("(orin_tag(" + a[0] + ") == 0)"),
    BResIsErr => fr("(orin_tag(" + a[0] + ") == 1)"),
    BOptUnwrap => bw(fromSlot(ty, c1("orin_opt_unwrap", a))),
    BOptUnwrapOr => bw("(orin_tag(" + a[0] + ") == 0 ? " + fromSlot(ty, "orin_struct_get(" + a[0] + ", 0)") + " : " + a[1] + ")"),
    BResUnwrap => isVoid(ty) ? vd("(void)orin_res_unwrap(" + a[0] + ")") : bw(fromSlot(ty, c1("orin_res_unwrap", a))),
    BResUnwrapErr => bw(fromSlot(ty, c1("orin_res_unwrap_err", a)))
  };
}
