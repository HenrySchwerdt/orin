// Unit tests of the MIR optimiser (rewrite step 3d): the block-rewrite classes, every pass on hand-built MIR (the result is
// checked by the ownership verifier and by the pass contracts), the parameter-mode inference, pruning, the well-formedness
// predicates, and `optimize` end to end on a program checked from source. Run:
// `orin test compiler/tests/opt_test.or --runtime runtime`. `orin test` checks contracts at run time, so the `@Requires` /
// `@Ensures` of every pass (`passKept`, the instruction-count claims, `pairsKept`, `prunedOk`) run on every call below.

import { Host, useFs } from "std:host";
import { FsGrant } from "std:fs";
import { assert, assertEqUsize, assertEqBool, assertEqString } from "std:test";
import { Span, SourceFile, span } from "../diag";
import { BArrConcat, BArrLength, BStrLength, UnNeg, OpAdd } from "../hir";
import {
  MType, MLocal, MBlock, Instr, Terminator, Operand, MFunction, MProgram, plainBlock,
} from "../mir";
import { loadWithOverlay } from "../loader";
import { check } from "../check";
import { lower } from "../lower";
import { verify } from "../verify";
import {
  optimize, inferModes, ParamInference, closureTargets, allBorrowed, sameFunctions, pruneProgram,
  prunedOk, insertCallDups, peephole, rewriteParam, scanSites, paramLiveness, livenessSolved,
  usedFlags, borrowReads, readInfo, callsOf, inplaceSlots, takePutChains, pairReturns, ancestors, ancestorsClosed, BlockSink,
  RewritePlan, fnShapeOk, fnWellFormed, progWellFormed, passKept, effects, instrCount, dupCount,
  releaseCount, concatCount, extendCount, getterCount, onlyEdgeBlocksAdded, indices, tablesAgree,
  instrUses, usesAffecting, forwardLoads, forwardProgram, forwardCount, uncheckAccesses, uncheckProgram, uncheckedCount, dropUniqueChecks, dropUniqueProgram, makeUniqueCount,
} from "../opt";

// ---------------------------------------------------------------- builders

function lr(n: string): MLocal {
  return MLocal { name: n, ty: MRef };
}

function li(n: string): MLocal {
  return MLocal { name: n, ty: MInt };
}

function lb(n: string): MLocal {
  return MLocal { name: n, ty: MBool };
}

function bk(instrs: Instr[], term: Terminator): MBlock {
  return plainBlock(instrs, term);
}

function borrowed(n: usize): bool[] {
  let out: bool[] = [];
  let i: usize = 0;
  while (i < n) {
    out.push(false);
    i += 1;
  }
  return out;
}

function fn(name: string, params: usize, locals: MLocal[], blocks: MBlock[]): MFunction {
  return MFunction {
    name: name,
    paramCount: params,
    paramOwned: borrowed(params),
    inout: false,
    locals: locals,
    ret: MVoid,
    blocks: blocks,
  };
}

function prog(fs: MFunction[]): MProgram {
  return MProgram { functions: fs, strings: ["s"], main: 0, vtables: [], inlineFns: [] };
}

function straight(locals: MLocal[], instrs: Instr[]): MFunction {
  return fn("f", 0, locals, [bk(instrs, TReturn(None))]);
}

function verifies(p: MProgram): bool {
  return verify(p).errors.length == 0;
}

function sp(a: usize): Span {
  return span(0, a, a + 1);
}

function isMove(i: Instr, d: usize, s: usize): bool {
  return match (i) {
    IMove(a, b) => a == d && b == s,
    _ => false,
  };
}

// ---------------------------------------------------------------- the block-rewrite classes

@Test
function blockSinkKeepsSpansInStep(): void {
  let s = new BlockSink();
  s.emit(IRelease(0), sp(1));
  s.emitAll([IRelease(1), IRelease(2)], sp(5));
  assertEqUsize(s.size(), 3, "three instructions");
  s.drop(1);
  const b = s.finish(TReturn(None), sp(9));
  assertEqUsize(b.instrs.length, 2, "one dropped");
  assertEqUsize(b.spans.length, 2, "spans dropped with it");
  assertEqUsize(b.spans[1].start, 5, "emitAll gives every instruction the span");
  assertEqUsize(b.termSpan.start, 9, "the terminator span");
}

@Test
function rewritePlanReplacesRemovesAndKeeps(): void {
  const blk = MBlock {
    instrs: [IRelease(0), IRelease(1), IRelease(2)],
    spans: [sp(0), sp(1), sp(2)],
    term: TReturn(None),
    termSpan: sp(3),
  };
  let plan = new RewritePlan(3);
  assertEqUsize(plan.changes(), 0, "nothing planned");
  assertEqUsize(plan.outLength(), 3, "an empty plan keeps the block");
  plan.replace(0, [IMove(5, 6), IRelease(5)]);
  plan.remove(2);
  assert(plan.touched(0) && !plan.touched(1) && plan.touched(2), "touched flags");
  assertEqUsize(plan.changes(), 2, "two changes");
  const out = plan.apply(blk);
  assertEqUsize(out.instrs.length, 3, "two replace one, one removed, one kept");
  assert(isMove(out.instrs[0], 5, 6), "the replacement comes first");
  assertEqUsize(out.spans[1].start, 0, "a replacement takes the span of what it replaces");
  assertEqUsize(out.spans[2].start, 1, "a kept instruction keeps its span");
}

// ---------------------------------------------------------------- stage 3: dup / release cancellation

@Test
function peepholeTurnsDupAndReleaseIntoAMove(): void {
  const f = straight(
    [lr("a"), lr("d")],
    [IDup(0, OStr(0)), IDup(1, OLocal(0)), IRelease(0), IRelease(1)],
  );
  const g = peephole(f);
  assertEqUsize(g.blocks[0].instrs.length, 3, "one instruction less");
  assert(isMove(g.blocks[0].instrs[1], 1, 0), "d = move a");
  assertEqUsize(dupCount(g), 1, "one dup left");
  assertEqUsize(releaseCount(g), 1, "one release left");
  assert(verifies(prog([g])), "the result verifies");
}

@Test
function peepholeCancelsADupReleasedRightAway(): void {
  const f = straight(
    [lr("a"), lr("d"), li("n")],
    [
      IDup(0, OStr(0)),
      IDup(1, OLocal(0)),
      IRelease(1),
      IBuiltin(Some(2), BStrLength, [OLocal(0)]),
      IRelease(0),
    ],
  );
  const g = peephole(f);
  assertEqUsize(g.blocks[0].instrs.length, 3, "the dup and its release are gone");
  assertEqUsize(dupCount(f) - dupCount(g), releaseCount(f) - releaseCount(g), "removed in pairs");
  assert(verifies(prog([g])), "the result verifies");
}

@Test
function peepholeKeepsADupWhoseSourceIsUsedBeforeTheRelease(): void {
  const f = straight(
    [lr("a"), lr("d"), li("n")],
    [
      IDup(0, OStr(0)),
      IDup(1, OLocal(0)),
      IBuiltin(Some(2), BStrLength, [OLocal(0)]),
      IRelease(0),
      IRelease(1),
    ],
  );
  const g = peephole(f);
  // `release a` is preceded by a use of a, so `d = dup a` cannot become a move; `release d` is found though
  assertEqUsize(dupCount(g), dupCount(f) - 1, "only the d pair is cancelled");
  assert(verifies(prog([g])), "the result verifies");
}

// ---------------------------------------------------------------- stage 4: slots, chains, concatenation

@Test
function aFieldUpdatedThroughADupBecomesTakeAndPut(): void {
  const f = straight(
    [lr("x"), lr("d1"), lr("d2")],
    [
      IStructNew(0, 0, [OStr(0)]),
      IGetField(1, OLocal(0), 0),
      IDup(2, OLocal(1)),
      IStrAppend(2, OStr(0)),
      IMakeUnique(0),
      ISetField(0, 0, OLocal(2)),
      IRelease(0),
    ],
  );
  assert(verifies(prog([f])), "the input verifies");
  const g = inplaceSlots(f);
  const is = g.blocks[0].instrs;
  assertEqUsize(is.length, 6, "the makeunique in the window is gone");
  assertEqUsize(dupCount(g), 0, "no retain of the slot");
  assertEqUsize(getterCount(g), 0, "the getter became makeunique");
  assert(
    match (is[2]) {
      ITakeField(d, x, k) => d == 2 && x == 0 && k == 0,
      _ => false,
    },
    "d2 = takefield x.0",
  );
  assert(
    match (is[4]) {
      IPutField(x, k, s) => x == 0 && k == 0 && s == 2,
      _ => false,
    },
    "putfield x.0 = d2",
  );
  assert(verifies(prog([g])), "the result verifies");
}

@Test
function aConcatenationReleasedRightAwayBecomesArrayExtend(): void {
  const f = straight(
    [lr("a"), lr("b"), lr("d")],
    [
      IArrayNew(0, false, [OInt(1)]),
      IArrayNew(1, false, [OInt(2)]),
      IBuiltin(Some(2), BArrConcat, [OLocal(0), OLocal(1)]),
      IRelease(0),
      IMove(0, 2),
      IRelease(1),
      IRelease(0),
    ],
  );
  assert(verifies(prog([f])), "the input verifies");
  const g = inplaceSlots(f);
  assertEqUsize(concatCount(g), 0, "no concatenation");
  assertEqUsize(extendCount(g), 1, "one arrayextend");
  assertEqUsize(instrCount(g), instrCount(f) - 2, "the release and the move are gone");
  assert(verifies(prog([g])), "the result verifies");
}

@Test
function aDyingConcatenationOperandIsExtendedInPlace(): void {
  // qs(lo).concat(eq): the temporary x is released right after the concatenation and is not moved back
  const f = straight(
    [lr("x"), lr("y"), lr("d")],
    [
      IArrayNew(0, false, [OInt(1)]),
      IArrayNew(1, false, [OInt(2)]),
      IBuiltin(Some(2), BArrConcat, [OLocal(0), OLocal(1)]),
      IRelease(0),
      IRelease(1),
      IRelease(2),
    ],
  );
  assert(verifies(prog([f])), "the input verifies");
  const g = inplaceSlots(f);
  assertEqUsize(concatCount(g), 0, "no concatenation");
  assertEqUsize(extendCount(g), 1, "one arrayextend");
  assertEqUsize(instrCount(g), instrCount(f), "the release became the move");
  assert(verifies(prog([g])), "the result verifies");
  // x.concat(x) is left alone (the operand being read is the one that would be extended)
  const h = straight(
    [lr("x"), lr("d")],
    [
      IArrayNew(0, false, [OInt(1)]),
      IBuiltin(Some(1), BArrConcat, [OLocal(0), OLocal(0)]),
      IRelease(0),
      IRelease(1),
    ],
  );
  assertEqUsize(extendCount(inplaceSlots(h)), 0, "x ++ x is not extended");
}

@Test
function aNestedSlotIsTakenThroughTheWholePath(): void {
  const f = straight(
    [lr("x"), lr("inner"), lr("r1"), lr("r2"), lr("d"), lr("t1")],
    [
      IStructNew(1, 0, [OStr(0)]),
      IStructNew(0, 0, [OLocal(1)]),
      IGetField(2, OLocal(0), 0),
      IGetField(3, OLocal(2), 0),
      IDup(4, OLocal(3)),
      IStrAppend(4, OStr(0)),
      IMakeUnique(0),
      ITakeField(5, 0, 0),
      IMakeUnique(5),
      ISetField(5, 0, OLocal(4)),
      IPutField(0, 0, 5),
      IRelease(0),
    ],
  );
  assert(verifies(prog([f])), "the input verifies");
  const g = takePutChains(f);
  assertEqUsize(instrCount(g), instrCount(f) - 2, "the two getters are gone");
  assertEqUsize(dupCount(g), 0, "the dup became a take");
  assertEqUsize(getterCount(g), 0, "no borrow of the path is left");
  assert(verifies(prog([g])), "the result verifies");
}

// ---------------------------------------------------------------- stage 1: parameter modes

// keep(p): retains p at its last use; pass(q): hands q to keep; boxed(r): like keep, but a closure target.
function modesProgram(): MProgram {
  const mainF = fn("main", 0, [], [bk([], TReturn(None))]);
  const pass = fn("pass", 1, [lr("q")], [bk([ICall(None, 2, [OLocal(0)])], TReturn(None))]);
  const keep = fn(
    "keep",
    1,
    [lr("p"), lr("d"), lr("box")],
    [bk([IDup(1, OLocal(0)), IStructNew(2, 0, [OLocal(1)]), IRelease(2)], TReturn(None))],
  );
  const boxed = fn(
    "boxed",
    1,
    [lr("env"), lr("d")],
    [bk([IDup(1, OLocal(0)), IRelease(1)], TReturn(None))],
  );
  const user = fn("user", 0, [lr("c")], [bk([IClosure(0, 3, []), IRelease(0)], TReturn(None))]);
  return prog([mainF, pass, keep, boxed, user]);
}

@Test
function ownershipFlowsBackwardsThroughCallsToAFixpoint(): void {
  const p = modesProgram();
  assert(progWellFormed(p) && allBorrowed(p), "lowering-shaped input");
  const pinned = closureTargets(p);
  assert(pinned[3] && !pinned[2], "only the closure target is pinned");
  const modes = inferModes(p, pinned);
  assert(modes[2][0], "keep consumes its parameter: owned");
  assert(modes[1][0], "pass hands its parameter to an owned position: owned (second round)");
  assert(!modes[3][0], "a closure target keeps borrowed parameters");
}

@Test
function theInferenceIsStableAfterRun(): void {
  const p = modesProgram();
  const sites = p.functions.map(f => indices(f.paramCount).map(k => scanSites(f, k)));
  let inf = new ParamInference(sites, closureTargets(p));
  assert(!inf.stable(), "keep wants to be owned before the run");
  inf.run();
  assert(inf.stable(), "no parameter wants to flip after the run");
}

@Test
function anOwnedParameterIsReleasedOnTheEdgeWhereItDies(): void {
  // f(p, c): if c { len(p) } ; return   -- p is live only into block 1
  const f = MFunction {
    name: "f",
    paramCount: 2,
    paramOwned: [true, false],
    inout: false,
    locals: [lr("p"), lb("c"), li("n")],
    ret: MVoid,
    blocks: [
      bk([], TBranch(OLocal(1), 1, 2)),
      bk([IBuiltin(Some(2), BStrLength, [OLocal(0)])], TGoto(2)),
      bk([], TReturn(None)),
    ],
  };
  const p = prog([f]);
  const anc = ancestors(f);
  assert(ancestorsClosed(f, anc), "ancestors are closed");
  const lv = paramLiveness(f, anc, 0);
  assert(livenessSolved(f, lv, usedFlags(f, anc, 0)), "the liveness equations hold");
  assert(lv.liveIn[1] && !lv.liveIn[2], "live into the use only");
  const g = rewriteParam(p, f, 0);
  assertEqUsize(g.blocks.length, 4, "one edge block (0 -> 2)");
  assert(onlyEdgeBlocksAdded(f, g, 0), "the new block releases p and continues");
  assertEqUsize(releaseCount(g), 2, "released after the use and on the edge");
  assert(verifies(prog([g])), "the result verifies");
  // the same with the branch the other way round: the edge is the `then` edge now
  let h = f;
  h.blocks[0] = bk([], TBranch(OLocal(1), 2, 1));
  const k = rewriteParam(prog([h]), h, 0);
  assertEqUsize(k.blocks.length, 4, "one edge block (0 -> 2) on the then side");
  assert(
    match (k.blocks[0].term) {
      TBranch(_, a, b) => a == 3 && b == 1,
      _ => false,
    },
    "the branch goes through the edge block",
  );
  assert(verifies(prog([k])), "the result verifies");
}


// ---------------------------------------------------------------- borrow inference (ADR-0038 class (d))

function isBorrow(i: Instr, d: usize, s: usize): bool {
  return match (i) {
    IBorrow(a, b) => a == d && b == s,
    _ => false,
  };
}

// peek(p): reads a copy of p. relay(q): hands a copy to peek. keep(r): stores a copy. relayKeep(t): hands a copy to keep.
// mutate(m): makes the copy unique and writes a field. twice(u): reads the copy, then copies it again.
// main passes a string to relayKeep, so the parameters of relayKeep and keep hold a real reference (otherwise unboxing
// would turn the never-built value into an empty aggregate).
function borrowProgram(): MProgram {
  const mainF = fn("main", 0, [], [bk([ICall(None, 4, [OStr(0)])], TReturn(None))]);
  const peek = fn(
    "peek",
    1,
    [lr("p"), lr("d"), li("n")],
    [bk([IDup(1, OLocal(0)), IBuiltin(Some(2), BStrLength, [OLocal(1)]), IRelease(1)], TReturn(None))],
  );
  const relay = fn(
    "relay",
    1,
    [lr("q"), lr("d")],
    [bk([IDup(1, OLocal(0)), ICall(None, 1, [OLocal(1)]), IRelease(1)], TReturn(None))],
  );
  const keep = fn(
    "keep",
    1,
    [lr("r"), lr("d"), lr("box")],
    [bk([IDup(1, OLocal(0)), IStructNew(2, 0, [OLocal(1)]), IRelease(2)], TReturn(None))],
  );
  const relayKeep = fn(
    "relayKeep",
    1,
    [lr("t"), lr("d")],
    [bk([IDup(1, OLocal(0)), ICall(None, 3, [OLocal(1)]), IRelease(1)], TReturn(None))],
  );
  const mutate = fn(
    "mutate",
    1,
    [lr("m"), lr("d")],
    [bk([IDup(1, OLocal(0)), IMakeUnique(1), ISetField(1, 0, OInt(1)), IRelease(1)], TReturn(None))],
  );
  const twice = fn(
    "twice",
    1,
    [lr("u"), lr("d"), li("n"), lr("e")],
    [bk(
      [
        IDup(1, OLocal(0)),
        IBuiltin(Some(2), BStrLength, [OLocal(1)]),
        IDup(3, OLocal(1)),
        IRelease(3),
        IRelease(1),
      ],
      TReturn(None),
    )],
  );
  return prog([mainF, peek, relay, keep, relayKeep, mutate, twice]);
}

@Test
function readInfoSeparatesReadOnlyCopiesFromConsumedOnes(): void {
  const p = borrowProgram();
  assert(progWellFormed(p) && allBorrowed(p), "lowering-shaped input");
  assert(!readInfo(p.functions[1]).bad[1], "a copy that is measured and released is read-only");
  const rl = readInfo(p.functions[2]);
  assert(!rl.bad[1] && callsOf(rl, 1).length == 1 && callsOf(rl, 1)[0].callee == 1, "a copy passed to a call: dependent position");
  assert(readInfo(p.functions[3]).bad[1], "a copy stored in a record is consumed");
  assert(readInfo(p.functions[5]).bad[1], "a copy that is made unique is mutated");
  assert(readInfo(p.functions[6]).bad[1], "a copy that is duplicated again is not read-only");
  assert(readInfo(p.functions[1]).bad[0], "a parameter is never a copy");
}

@Test
function aReadOnlyCopyDoesNotMakeTheParameterOwned(): void {
  const p = borrowProgram();
  const modes = inferModes(p, closureTargets(p));
  assert(!modes[1][0], "peek only reads its parameter: borrowed");
  assert(!modes[2][0], "relay passes a copy to a borrowed position: borrowed");
  assert(modes[3][0], "keep stores a copy: owned");
  assert(modes[4][0], "relayKeep passes a copy to an owned position: owned");
  assert(modes[5][0], "mutate changes its copy: owned");
  assert(modes[6][0], "twice retains the copy again: owned");
}

@Test
function borrowReadsTurnsTheCopyIntoABorrowOfTheParameter(): void {
  const p = borrowProgram();
  const q = optimize(p);
  assert(sameFunctions(p, q), "the same functions");
  const peek = q.functions[1];
  assertEqUsize(dupCount(peek), 0, "no retain");
  assertEqUsize(releaseCount(peek), 0, "no release");
  assert(isBorrow(peek.blocks[0].instrs[0], 1, 0), "d = borrow p");
  assert(!peek.paramOwned[0], "the parameter stays borrowed");
  const relay = q.functions[2];
  assertEqUsize(dupCount(relay) + releaseCount(relay), 0, "relay neither retains nor releases");
  assert(q.functions[3].paramOwned[0], "keep owns the parameter it stores");
  assertEqUsize(dupCount(q.functions[3]), 0, "and moves it into the record");
  assertEqUsize(verify(q).errors.length, 0, "the verifier accepts the borrowed parameters");
  // the program as hand-written (without the inferred modes) is also accepted
  assertEqUsize(verify(p).errors.length, 0, "the input verifies");
}

@Test
function borrowReadsLeavesAnOwnedParameterAlone(): void {
  const p = borrowProgram();
  let q = p;
  q.functions[1].paramOwned = [true];
  const g = borrowReads(q, q.functions[1]);
  assertEqUsize(dupCount(g), 1, "the copy of an owned parameter is not turned into a borrow");
  assertEqUsize(releaseCount(g), 1, "and keeps its release");
}

@Test
function aCallToAnOwnedPositionKeepsTheCopy(): void {
  // relay hands its copy to peek; with peek's parameter owned the copy is consumed there
  let p = borrowProgram();
  p.functions[1].paramOwned = [true];
  const g = borrowReads(p, p.functions[2]);
  assertEqUsize(dupCount(g), 1, "the dup stays");
  assertEqUsize(releaseCount(g), 1, "the release stays");
}

// One instruction of every kind: the optimiser's use / definition tables must agree with the lowering's (an instruction
// kind whose operand the optimiser misses is a release it may move over a use).
@Test
function analysisTablesAgreeOnEveryInstructionKind(): void {
  const all: Instr[] = [
    ICopy(0, OInt(1)),
    IMove(1, 2),
    IBorrow(1, 2),
    IDup(1, OLocal(2)),
    IRelease(1),
    IUnary(0, UnNeg, OLocal(3)),
    IBinary(0, OpAdd, OLocal(3), OLocal(4)),
    ICall(Some(1), 0, [OLocal(2), OInt(1)]),
    IBuiltin(None, BStrLength, [OLocal(2)]),
    IStrAppend(1, OLocal(2)),
    IStrPrepend(1, OLocal(2)),
    IStrAppendNum(1, OLocal(3), false),
    IStrAppendSub(1, OLocal(2), OLocal(3), OUsize(2)),
    IArrayExtend(1, OLocal(2)),
    IStructNew(1, 0, [OLocal(2), OLocal(3)]),
    INullary(1, 0),
    ITag(0, OLocal(2)),
    IGetField(1, OLocal(2), 0),
    ISetField(1, 0, OLocal(2)),
    ITakeField(1, 2, 0),
    IPutField(1, 0, 2),
    IMakeUnique(1),
    IArrayNew(1, true, [OLocal(2)]),
    IArrayGet(1, OLocal(2), OLocal(3)),
    IArraySet(1, OLocal(3), OLocal(2)),
    IArrayTake(1, 2, OLocal(3)),
    IArrayPut(1, OLocal(3), 2),
    IArrayPush(1, OLocal(2)),
    IArrayPop(1, 2),
    IForward(0, 3, OLocal(2), OLocal(4)),
    IClosure(1, 0, [OLocal(2)]),
    ICallIndirect(Some(1), OLocal(2), [OLocal(3)]),
    IIface(1, 0, OLocal(2)),
    ICallVirtual(Some(1), OLocal(2), 0, [OLocal(3)]),
  ];
  const locals = [li("i"), lr("a"), lr("b"), li("j"), li("k")];
  for (const ins of all) {
    assert(tablesAgree(fn("f", 0, locals, [bk([ins], TReturn(Some(OLocal(4))))])), "tables agree");
  }
  assert(
    tablesAgree(fn("f", 0, locals, [bk([], TBranch(OLocal(3), 0, 0))])),
    "a terminator use agrees",
  );
}

// ---------------------------------------------------------------- what the contracts check

@Test
function passKeptRejectsADroppedOrReorderedCall(): void {
  const a = fn("f", 0, [], [bk([ICall(None, 1, []), ICall(None, 2, [])], TReturn(None))]);
  const dropped = fn("f", 0, [], [bk([ICall(None, 1, [])], TReturn(None))]);
  const swapped = fn("f", 0, [], [bk([ICall(None, 2, []), ICall(None, 1, [])], TReturn(None))]);
  assert(passKept(a, a), "the identity keeps everything");
  assert(!passKept(a, dropped), "a dropped call is caught");
  assert(!passKept(a, swapped), "a reordered call is caught");
  assertEqUsize(effects(a).length, 2, "two effects");
  let renamed = a;
  renamed.paramOwned = [true];
  assert(!passKept(a, renamed), "a changed signature is caught");
}

@Test
function wellFormednessCatchesDanglingIndices(): void {
  const ok = prog([straight([lr("a")], [ICopy(0, OStr(0))])]);
  assert(progWellFormed(ok), "well formed");
  assert(
    !progWellFormed(prog([straight([lr("a")], [ICopy(0, OStr(1))])])),
    "a string past the table",
  );
  assert(!progWellFormed(prog([straight([lr("a")], [ICopy(1, OStr(0))])])), "an undeclared local");
  assert(
    !progWellFormed(prog([straight([], [ICall(None, 7, [])])])),
    "a call of a function that does not exist",
  );
  assert(!fnShapeOk(fn("f", 0, [], [bk([], TGoto(3))])), "a branch out of the function");
}

@Test
function pruningDropsOnlyUnreachablePreludeCode(): void {
  const mainF = fn("main", 0, [], [bk([ICall(None, 2, [])], TReturn(None))]);
  const dead = fn("$std/x.unused", 0, [], [bk([], TReturn(None))]);
  const used = fn("$std/x.used", 0, [], [bk([], TReturn(None))]);
  const userDead = fn("helper", 0, [], [bk([], TReturn(None))]);
  const p = prog([mainF, dead, used, userDead]);
  const r = pruneProgram(p);
  assertEqUsize(r.functions.length, 3, "the unreachable prelude function is dropped");
  assertEqString(r.functions[1].name, "$std/x.used", "order kept");
  assertEqString(r.functions[2].name, "helper", "user functions are never dropped");
  assert(
    match (r.functions[0].blocks[0].instrs[0]) {
      ICall(_, g, _) => g == 1,
      _ => false,
    },
    "the call is renumbered",
  );
  assert(prunedOk(p, r), "prunedOk");
  assert(!prunedOk(p, prog([mainF])), "dropping a user function is caught");
}

// ---------------------------------------------------------------- end to end

function optimized(fs: FsGrant, text: string): Option<MProgram> {
  const o = loadWithOverlay(fs, "/virt/a.or", [SourceFile { path: "/virt/a.or", text: text }]);
  return match (o.program) {
    Some(p) => {
      const r = check(p, o.sm);
      return r.isOk() ? Some(lower(r.unwrap())) : None;
    },
    None => None,
  };
}

export function sampleSource(): string {
  return "class Counter {\n  n: int = 0;\n  label: string = \"\";\n  next(): int {\n    this.n += 1;\n    return this.n;\n  }\n}\n"
      + "function keep(s: string): string {\n  return s;\n}\n"
      + "function grow(xs: int[], k: int): int[] {\n  let a = xs;\n  a = a.concat([k]);\n  return a;\n}\n"
      + "function main(): void {\n  let c = new Counter();\n  let i = 0;\n  while (i < 3) {\n    const v = c.next();\n"
      + "    c.label = c.label + \"x\" + v.toString();\n    i += 1;\n  }\n  console.log(keep(c.label));\n"
      + "  console.log(grow([1, 2], 3).length.toString());\n}\n";
}

@Test
function optimizeKeepsTheProgramAndTheVerifierAcceptsIt(host: Host): void {
  useFs(
    host,
    fs => {
      const m = optimized(fs, sampleSource());
      assert(m.isSome(), "checks and lowers");
      const p = m.unwrap();
      assert(allBorrowed(p) && progWellFormed(p), "lowering output");
      const q = optimize(p);
      assert(sameFunctions(p, q) && progWellFormed(q), "the same functions, well formed");
      assertEqUsize(verify(q).errors.length, 0, "the verifier accepts the optimised program");
      assert(q.functions.some(f => f.inout), "the mutating method with a result became in/out");
      assert(q.functions.some(f => f.paramOwned.some(o => o)), "some parameter became owned");
      const r = pruneProgram(q);
      assert(prunedOk(q, r), "pruning keeps the user functions");
      assertEqUsize(verify(r).errors.length, 0, "the pruned program verifies");
    },
  );
}

@Test
function optimizingTwiceFromTheSameInputGivesTheSameProgram(host: Host): void {
  useFs(
    host,
    fs => {
      const p = optimized(fs, sampleSource()).unwrap();
      const a = optimize(p);
      const b = optimize(p);
      assertEqUsize(instrCount(a.functions[0]), instrCount(b.functions[0]), "deterministic");
      let i: usize = 0;
      while (i < a.functions.length) {
        assertEqUsize(
          instrCount(a.functions[i]),
          instrCount(b.functions[i]),
          "same instruction count per function",
        );
        assertEqBool(a.functions[i].inout, b.functions[i].inout, "same in/out flags");
        i += 1;
      }
    },
  );
}

function readerSource(): string {
  return "class Reader {\n  data: int[];\n  pos: usize;\n  constructor(d: int[]) {\n    this.data = d;\n    this.pos = 0;\n  }\n"
      + "  cur(): int {\n    return this.data[this.pos];\n  }\n"
      + "  twoAhead(): int {\n    return this.cur() + this.data[this.pos];\n  }\n"
      + "  skip(): void {\n    this.pos += 1;\n  }\n}\n"
      + "function main(): void {\n  let r = new Reader([1, 2, 3]);\n  r.skip();\n  console.log(r.twoAhead().toString());\n}\n";
}

@Test
function aMethodThatOnlyReadsThisBorrowsIt(host: Host): void {
  useFs(
    host,
    fs => {
      const p = optimized(fs, readerSource()).unwrap();
      const q = optimize(p);
      assertEqUsize(verify(q).errors.length, 0, "the verifier accepts the optimised program");
      let seen: usize = 0;
      let i: usize = 0;
      while (i < q.functions.length) {
        const f = q.functions[i];
        if (f.name.endsWith("Reader.cur") || f.name.endsWith("Reader.twoAhead")) {
          seen += 1;
          assert(!f.paramOwned[0], f.name + ": this is borrowed");
          assertEqUsize(dupCount(f) + releaseCount(f), 0, f.name + ": no reference counting");
        }
        if (f.name.endsWith("Reader.skip")) {
          assert(f.paramOwned[0], "a method that updates this owns it");
        }
        i += 1;
      }
      assertEqUsize(seen, 2, "both read-only methods found");
    },
  );
}

// `usesAffecting` is its own match over the instructions (no use list is built); with no aliases it must name exactly
// the locals `instrUses` lists, on every instruction of the sample program before and after optimisation.
function usesAffectingAgrees(p: MProgram): bool {
  for (const f of p.functions) {
    let none: usize[][] = [];
    for (const _l of f.locals) {
      none.push([]);
    }
    for (const blk of f.blocks) {
      for (const ins of blk.instrs) {
        const us = instrUses(ins);
        let l: usize = 0;
        while (l < f.locals.length) {
          if (usesAffecting(none, ins, l) != us.includes(l)) {
            return false;
          }
          l += 1;
        }
      }
    }
  }
  return true;
}

@Test
function usesAffectingAgreesWithInstrUses(host: Host): void {
  useFs(
    host,
    fs => {
      const p = optimized(fs, sampleSource()).unwrap();
      assert(usesAffectingAgrees(p), "lowered");
      assert(usesAffectingAgrees(optimize(p)), "optimised");
    },
  );
}


// ---------------------------------------------------------------- redundant makeunique (ADR-0038 addendum T1)

@Test
function aMakeUniqueOfAFreshObjectIsDropped(): void {
  const f = straight(
    [lr("x")],
    [IStructNew(0, 0, [OStr(0)]), IMakeUnique(0), ISetField(0, 0, OStr(0)), IMakeUnique(0), ISetField(0, 0, OStr(0)), IRelease(0)],
  );
  const p = prog([f]);
  assert(verifies(p), "the input verifies");
  assertEqUsize(makeUniqueCount(f), 2, "two before");
  const g = dropUniqueChecks(prog([f]), f);
  assertEqUsize(makeUniqueCount(g), 0, "both are redundant: the struct is Unique from its creation");
  assertEqUsize(instrCount(g), instrCount(f) - 2, "nothing else changed");
  assert(verifies(prog([g])), "the verifier accepts the result");
}

@Test
function aMakeUniqueOfASharedObjectStays(): void {
  const f = straight(
    [lr("x"), lr("d")],
    [
      IStructNew(0, 0, [OStr(0)]),
      IDup(1, OLocal(0)),
      IMakeUnique(0),
      ISetField(0, 0, OStr(0)),
      IRelease(1),
      IRelease(0),
    ],
  );
  const p = prog([f]);
  assert(verifies(p), "the input verifies");
  const g = dropUniqueChecks(prog([f]), f);
  assertEqUsize(makeUniqueCount(g), 1, "x was shared by the dup: the check is needed");
  assert(verifies(prog([g])), "the verifier accepts the result");
}

@Test
function aMakeUniqueAfterAFirstOneIsDroppedAndOneParameterStays(): void {
  // f(p, q): makeunique of a borrowed-parameter copy is needed; the second one on the same local is not
  const f = fn(
    "f",
    1,
    [lr("p"), lr("x")],
    [bk([IDup(1, OLocal(0)), IMakeUnique(1), IMakeUnique(1), ISetField(1, 0, OStr(0)), IRelease(1)], TReturn(None))],
  );
  const p = prog([f]);
  assert(verifies(p), "the input verifies");
  const g = dropUniqueChecks(prog([f]), f);
  assertEqUsize(makeUniqueCount(g), 1, "the first stays, the second is redundant");
  assert(verifies(prog([g])), "the verifier accepts the result");
}

@Test
function aLoopKeepsUniquenessOnlyWhenEveryPathDoes(): void {
  // b0: x = struct; goto b1.  b1: makeunique x; setfield; branch c b1 b2.  b2: release x
  const f = fn(
    "f",
    1,
    [lb("c"), lr("x")],
    [
      bk([IStructNew(1, 0, [OStr(0)])], TGoto(1)),
      bk([IMakeUnique(1), ISetField(1, 0, OStr(0))], TBranch(OLocal(0), 1, 2)),
      bk([IRelease(1)], TReturn(None)),
    ],
  );
  assert(verifies(prog([f])), "the input verifies");
  assertEqUsize(makeUniqueCount(dropUniqueChecks(prog([f]), f)), 0, "Unique on entry and around the back edge");
  // a dup on the back edge path makes the join Owned: the check in the loop head is needed
  const g = fn(
    "g",
    1,
    [lb("c"), lr("x"), lr("d")],
    [
      bk([IStructNew(1, 0, [OStr(0)])], TGoto(1)),
      bk([IMakeUnique(1), ISetField(1, 0, OStr(0))], TBranch(OLocal(0), 3, 2)),
      bk([IRelease(1)], TReturn(None)),
      bk([IDup(2, OLocal(1)), IRelease(2)], TGoto(1)),
    ],
  );
  const pg = prog([g]);
  assert(verifies(pg), "the input verifies");
  const h = dropUniqueChecks(pg, g);
  assertEqUsize(makeUniqueCount(h), 1, "the dup demotes x on one path into the head");
  assert(verifies(prog([h])), "the verifier accepts the result");
}

@Test
function aCallArgumentDemotesTheLocalBeforeTheNextMakeUnique(): void {
  // g(x) returns a reference: passing a Unique x to it demotes x (docs/mir.md), so the check after the call stays
  const callee = MFunction {
    name: "id",
    paramCount: 1,
    paramOwned: [false],
    inout: false,
    locals: [lr("a"), lr("r")],
    ret: MRef,
    blocks: [bk([IDup(1, OLocal(0))], TReturn(Some(OLocal(1))))],
  };
  const f = fn(
    "f",
    0,
    [lr("x"), lr("r")],
    [
      bk(
        [
          IStructNew(0, 0, [OStr(0)]),
          ICall(Some(1), 1, [OLocal(0)]),
          IMakeUnique(0),
          ISetField(0, 0, OStr(0)),
          IRelease(1),
          IRelease(0),
        ],
        TReturn(None),
      ),
    ],
  );
  const p = prog([f, callee]);
  assert(verifies(p), "the input verifies");
  const q = dropUniqueProgram(p);
  assertEqUsize(makeUniqueCount(q.functions[0]), 1, "x may be shared with the result");
  assert(verifies(q), "the verifier accepts the result");
}

@Test
function aCallWithAScalarResultAndAMoveKeepUniqueness(): void {
  // len(a) -> int and arr.length(x) do not demote x; y = move x keeps the kind, so neither makeunique is needed
  const callee = MFunction {
    name: "len",
    paramCount: 1,
    paramOwned: [false],
    inout: false,
    locals: [lr("a"), li("n")],
    ret: MInt,
    blocks: [bk([ICopy(1, OInt(0))], TReturn(Some(OLocal(1))))],
  };
  const f = fn(
    "f",
    0,
    [lr("x"), li("n"), lr("y")],
    [
      bk(
        [
          IStructNew(0, 0, [OStr(0)]),
          ICall(Some(1), 1, [OLocal(0)]),
          IMakeUnique(0),
          IBuiltin(Some(1), BArrLength, [OLocal(0)]),
          IMakeUnique(0),
          IMove(2, 0),
          IMakeUnique(2),
          ISetField(2, 0, OStr(0)),
          IRelease(2),
        ],
        TReturn(None),
      ),
    ],
  );
  const p = prog([f, callee]);
  assert(verifies(p), "the input verifies");
  const q = dropUniqueProgram(p);
  assertEqUsize(makeUniqueCount(q.functions[0]), 0, "x stays Unique over the call and over the move");
  assert(verifies(q), "the verifier accepts the result");
}

// ---------------------------------------------------------------- load forwarding (T4, docs/mir.md v2.4)

function lu(n: string): MLocal {
  return MLocal { name: n, ty: MUsize };
}

// The positions of the `IForward` instructions of block 0.
function forwardsAt(f: MFunction): usize[] {
  let out: usize[] = [];
  let i: usize = 0;
  while (i < f.blocks[0].instrs.length) {
    match (f.blocks[0].instrs[i]) {
      IForward(_, _, _, _) => {
        out.push(i);
      },
      _ => {},
    }
    i += 1;
  }
  return out;
}

@Test
function aSecondLoadOfAScalarFieldIsForwarded(): void {
  const f = straight([lr("o"), li("s"), li("d")], [
    IStructNew(0, 0, [OInt(1), OInt(2)]),
    IGetField(1, OLocal(0), 0),
    IGetField(2, OLocal(0), 0),
    IRelease(0),
  ]);
  const p = prog([f]);
  assert(verifies(p), "the input verifies");
  const g = forwardLoads(p, f);
  assertEqUsize(forwardCount(g), 1, "one forward");
  assertEqUsize(getterCount(g), 1, "one load left");
  assertEqUsize(forwardsAt(g)[0], 2, "the second load");
  match (g.blocks[0].instrs[2]) {
    IForward(d, s, _, _) => {
      assertEqUsize(d, 2, "into the second local");
      assertEqUsize(s, 1, "from the first load");
    },
    _ => {
      assert(false, "an IForward");
    },
  }
  assert(passKept(f, g), "the pass keeps the function's shape and effects");
  assert(verifies(prog([g])), "the verifier accepts the result");
}

@Test
function aLoadAfterAStoreOfALocalIsForwardedFromTheStore(): void {
  const f = straight([lr("o"), li("v"), li("d")], [
    IStructNew(0, 0, [OInt(1), OInt(2)]),
    ICopy(1, OInt(7)),
    ISetField(0, 1, OLocal(1)),
    IGetField(2, OLocal(0), 1),
    IRelease(0),
  ]);
  const p = prog([f]);
  const g = forwardLoads(p, f);
  assertEqUsize(forwardCount(g), 1, "forwarded from the store");
  assert(verifies(prog([g])), "the verifier accepts the result");
}

@Test
function aLoadAfterAnArrayLoadWithTheSameIndexLocalIsForwarded(): void {
  const f = straight([lr("a"), lu("i"), li("s"), li("d")], [
    IArrayNew(0, false, [OInt(1), OInt(2)]),
    ICopy(1, OUsize(1)),
    IArrayGet(2, OLocal(0), OLocal(1)),
    IArrayGet(3, OLocal(0), OLocal(1)),
    IRelease(0),
  ]);
  const g = forwardLoads(prog([f]), f);
  assertEqUsize(forwardCount(g), 1, "forwarded");
  assert(verifies(prog([g])), "the verifier accepts the result");
}

@Test
function aWriteOfThePrecedingSlotBlocksTheForward(): void {
  const f = straight([lr("o"), li("s"), li("d")], [
    IStructNew(0, 0, [OInt(1), OInt(2)]),
    IGetField(1, OLocal(0), 0),
    ISetField(0, 0, OInt(9)),
    IGetField(2, OLocal(0), 0),
    IRelease(0),
  ]);
  const g = forwardLoads(prog([f]), f);
  assertEqUsize(forwardCount(g), 0, "the value changed in between");
  assertEqUsize(getterCount(g), 2, "both loads stay");
}

@Test
function aWriteToAnotherSlotDoesNotBlockTheForward(): void {
  const f = straight([lr("o"), li("s"), li("d")], [
    IStructNew(0, 0, [OInt(1), OInt(2)]),
    IGetField(1, OLocal(0), 0),
    ISetField(0, 1, OInt(9)),
    IGetField(2, OLocal(0), 0),
    IRelease(0),
  ]);
  const g = forwardLoads(prog([f]), f);
  assertEqUsize(forwardCount(g), 1, "slot 0 is unchanged");
  assert(verifies(prog([g])), "the verifier accepts the result");
}

@Test
function aCallThatReceivesTheObjectBlocksTheForward(): void {
  const callee = fn("g", 1, [lr("p")], [bk([], TReturn(None))]);
  const f = straight([lr("o"), li("s"), li("d")], [
    IStructNew(0, 0, [OInt(1), OInt(2)]),
    IGetField(1, OLocal(0), 0),
    ICall(None, 1, [OLocal(0)]),
    IGetField(2, OLocal(0), 0),
    IRelease(0),
  ]);
  const g = forwardLoads(prog([f, callee]), f);
  assertEqUsize(forwardCount(g), 0, "step 1 ends the window at a call that receives the object");
}

@Test
function referenceSlotsAndOtherSlotsAreNotForwarded(): void {
  const refs = straight([lr("o"), lr("s"), lr("d")], [
    IStructNew(0, 0, [OStr(0), OStr(0)]),
    IGetField(1, OLocal(0), 0),
    IGetField(2, OLocal(0), 0),
    IRelease(0),
  ]);
  assertEqUsize(forwardCount(forwardLoads(prog([refs]), refs)), 0, "a reference slot is not forwarded");
  const other = straight([lr("o"), li("s"), li("d")], [
    IStructNew(0, 0, [OInt(1), OInt(2)]),
    IGetField(1, OLocal(0), 0),
    IGetField(2, OLocal(0), 1),
    IRelease(0),
  ]);
  assertEqUsize(forwardCount(forwardLoads(prog([other]), other)), 0, "another slot is not forwarded");
}

@Test
function aForwardIsASourceForTheLoadsAfterIt(): void {
  const f = straight([lr("o"), li("a"), li("b"), li("c")], [
    IStructNew(0, 0, [OInt(1), OInt(2)]),
    IGetField(1, OLocal(0), 0),
    IGetField(2, OLocal(0), 0),
    IGetField(3, OLocal(0), 0),
    IRelease(0),
  ]);
  const g = forwardLoads(prog([f]), f);
  assertEqUsize(forwardCount(g), 2, "the second and the third load");
  assert(verifies(prog([g])), "the verifier accepts the result");
}

@Test
function optimizeForwardsLoadsAndTheVerifierAcceptsThem(host: Host): void {
  useFs(
    host,
    fs => {
      const p = optimized(fs, sampleSource()).unwrap();
      const q = optimize(p);
      assertEqUsize(verify(q).errors.length, 0, "the verifier accepts the optimised program");
      const n = q.functions.reduce((k: usize, f: MFunction) => k + forwardCount(f), 0);
      assert(n >= 1, "Counter.next reads this.n back after storing it: a forward");
      const r = forwardProgram(q);
      assertEqUsize(r.functions.reduce((k: usize, f: MFunction) => k + forwardCount(f), 0), n, "forwarding again changes nothing");
    },
  );
}

// ---------------------------------------------------------------- repeated bounds / kind checks (T2, docs/mir.md v2.5)

// The positions of the unchecked accesses of block 0.
function uncheckedAt(f: MFunction): usize[] {
  let out: usize[] = [];
  let i: usize = 0;
  while (i < f.blocks[0].instrs.length) {
    match (f.blocks[0].instrs[i]) {
      IArrayGetU(_, _, _) => {
        out.push(i);
      },
      IArraySetU(_, _, _) => {
        out.push(i);
      },
      _ => {},
    }
    i += 1;
  }
  return out;
}

@Test
function anArrayStoreAfterALoadOfTheSameElementIsUnchecked(): void {
  const f = straight([lr("a"), li("s"), li("w")], [
    IArrayNew(0, false, [OInt(1), OInt(2), OInt(3)]),
    IArrayGet(1, OLocal(0), OUsize(1)),
    ICopy(2, OInt(9)),
    IArraySet(0, OUsize(1), OLocal(2)),
    IRelease(0),
  ]);
  const p = prog([f]);
  assert(verifies(p), "the input verifies");
  const g = uncheckAccesses(p, f);
  assertEqUsize(uncheckedCount(g), 1, "one unchecked access");
  assertEqUsize(uncheckedAt(g)[0], 3, "the store, not the load");
  match (g.blocks[0].instrs[3]) {
    IArraySetU(x, _, _) => {
      assertEqUsize(x, 0, "on the array");
    },
    _ => {
      assert(false, "an IArraySetU");
    },
  }
  assert(passKept(f, g), "the pass keeps the function's shape and effects");
  assert(verifies(prog([g])), "the verifier accepts the result");
}

@Test
function everyLaterAccessOfTheSameElementIsUnchecked(): void {
  const f = straight([lr("a"), lu("i"), li("s"), li("d")], [
    IArrayNew(0, false, [OInt(1), OInt(2)]),
    ICopy(1, OUsize(1)),
    IArrayGet(2, OLocal(0), OLocal(1)),
    IArrayGet(3, OLocal(0), OLocal(1)),
    IArraySet(0, OLocal(1), OLocal(3)),
    IRelease(0),
  ]);
  const g = uncheckAccesses(prog([f]), f);
  assertEqUsize(uncheckedCount(g), 2, "the second load and the store");
  assert(verifies(prog([g])), "the verifier accepts the result");
}

@Test
function aPushOrAnotherElementOrAnotherArrayKeepsTheCheck(): void {
  const pushed = straight([lr("a"), li("s"), li("d")], [
    IArrayNew(0, false, [OInt(1), OInt(2)]),
    IArrayGet(1, OLocal(0), OUsize(0)),
    IArrayPush(0, OInt(4)),
    IArrayGet(2, OLocal(0), OUsize(0)),
    IRelease(0),
  ]);
  assertEqUsize(uncheckedCount(uncheckAccesses(prog([pushed]), pushed)), 0, "the push can reallocate and change the length");
  const other = straight([lr("a"), li("s"), li("d")], [
    IArrayNew(0, false, [OInt(1), OInt(2)]),
    IArrayGet(1, OLocal(0), OUsize(0)),
    IArrayGet(2, OLocal(0), OUsize(1)),
    IRelease(0),
  ]);
  assertEqUsize(uncheckedCount(uncheckAccesses(prog([other]), other)), 0, "another index has not been checked");
  const twoArrays = straight([lr("a"), lr("b"), li("s"), li("d")], [
    IArrayNew(0, false, [OInt(1), OInt(2)]),
    IArrayNew(1, false, [OInt(1), OInt(2)]),
    IArrayGet(2, OLocal(0), OUsize(0)),
    IArrayGet(3, OLocal(1), OUsize(0)),
    IRelease(0),
    IRelease(1),
  ]);
  assertEqUsize(uncheckedCount(uncheckAccesses(prog([twoArrays]), twoArrays)), 0, "another array has not been checked");
}

@Test
function aCallThatReceivesTheArrayKeepsTheCheck(): void {
  const callee = fn("g", 1, [lr("p")], [bk([], TReturn(None))]);
  const f = straight([lr("a"), li("s"), li("d")], [
    IArrayNew(0, false, [OInt(1), OInt(2)]),
    IArrayGet(1, OLocal(0), OUsize(0)),
    ICall(None, 1, [OLocal(0)]),
    IArrayGet(2, OLocal(0), OUsize(0)),
    IRelease(0),
  ]);
  assertEqUsize(uncheckedCount(uncheckAccesses(prog([f, callee]), f)), 0, "calls that receive the array end the window");
}

@Test
function aLoadThatOverwritesItsOwnIndexIsNotASource(): void {
  const f = straight([lr("a"), lu("i"), lu("d")], [
    IArrayNew(0, false, [OUsize(1), OUsize(0)]),
    ICopy(1, OUsize(0)),
    IArrayGet(1, OLocal(0), OLocal(1)),
    IArrayGet(2, OLocal(0), OLocal(1)),
    IRelease(0),
  ]);
  assertEqUsize(uncheckedCount(uncheckAccesses(prog([f]), f)), 0, "a[i] names another element after `i = a[i]`");
}

@Test
function optimizeUnchecksRepeatedAccessesAndTheVerifierAcceptsThem(host: Host): void {
  useFs(
    host,
    fs => {
      const p = optimized(fs, sampleSource()).unwrap();
      const q = optimize(p);
      assertEqUsize(verify(q).errors.length, 0, "the verifier accepts the optimised program");
      const n = q.functions.reduce((k: usize, f: MFunction) => k + uncheckedCount(f), 0);
      const r = uncheckProgram(q);
      assertEqUsize(r.functions.reduce((k: usize, f: MFunction) => k + uncheckedCount(f), 0), n, "doing it again changes nothing");
      assertEqUsize(verify(r).errors.length, 0, "and the verifier still accepts it");
    },
  );
}
