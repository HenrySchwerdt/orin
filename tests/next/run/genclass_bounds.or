// Bounded type parameters of generic classes (ADR-0026 + ADR-0019): `T extends I`, static dispatch per
// instance, bounded classes nested in other generic code.
interface Shape {
  area(): int;
  name(): string;
}

interface Ranked {
  rank(): int;
}

class Task implements Ranked {
  prio: int;
  title: string;
  constructor(prio: int, title: string) {
    this.prio = prio;
    this.title = title;
  }
  rank(): int {
    return this.prio;
  }
}

class Score implements Ranked {
  v: int;
  constructor(v: int) {
    this.v = v;
  }
  rank(): int {
    return 0 - this.v;
  }
}

// keeps its items ordered by rank
class SortedList<T extends Ranked> {
  items: T[] = [];
  add(x: T): void {
    let out: T[] = [];
    let placed = false;
    for (const it of this.items) {
      if (!placed && it.rank() > x.rank()) {
        out.push(x);
        placed = true;
      }
      out.push(it);
    }
    if (!placed) {
      out.push(x);
    }
    this.items = out;
  }
  first(): Option<T> {
    return this.items.length == 0 ? None : Some(this.items[0]);
  }
  ranks(): string {
    let parts: string[] = [];
    for (const it of this.items) {
      parts.push(it.rank().toString());
    }
    return parts.join(",");
  }
  best(): T {
    return this.items[0];
  }
}

class Sq implements Shape {
  s: int;
  constructor(s: int) {
    this.s = s;
  }
  area(): int {
    return this.s * this.s;
  }
  name(): string {
    return "sq";
  }
}

class Rect implements Shape {
  w: int;
  h: int;
  constructor(w: int, h: int) {
    this.w = w;
    this.h = h;
  }
  area(): int {
    return this.w * this.h;
  }
  name(): string {
    return "rect";
  }
}

class Group<T extends Shape> {
  members: T[];
  constructor(members: T[]) {
    this.members = members;
  }
  total(): int {
    let t = 0;
    for (const m of this.members) {
      t += m.area();
    }
    return t;
  }
  names(): string {
    let parts: string[] = [];
    for (const m of this.members) {
      parts.push(m.name());
    }
    return parts.join("+");
  }
}

// a bounded class used from a generic function with the same bound, and inside another bounded class
function totalOf<S extends Shape>(g: Group<S>): int {
  return g.total() * 2;
}

class Pair<A extends Shape, B extends Shape> {
  a: A;
  b: B;
  constructor(a: A, b: B) {
    this.a = a;
    this.b = b;
  }
  sum(): int {
    return this.a.area() + this.b.area();
  }
  firstGroup(): Group<A> {
    return new Group([this.a]);
  }
}

function main(): void {
  let l = new SortedList<Task>();
  l.add(new Task(5, "five"));
  l.add(new Task(1, "one"));
  l.add(new Task(3, "three"));
  console.log(l.ranks());
  console.log(l.first().unwrap().title);
  let s = new SortedList<Score>();
  s.add(new Score(10));
  s.add(new Score(30));
  s.add(new Score(20));
  console.log(s.ranks());
  console.log(s.best().v.toString());

  const g = new Group([new Sq(2), new Sq(3)]);
  console.log(g.total().toString() + " " + g.names() + " " + totalOf(g).toString());
  const r = new Group<Rect>([new Rect(2, 5)]);
  console.log(r.total().toString() + " " + r.names());
  // the bound is also met by an interface-typed element
  const mixed: Shape[] = [new Sq(1), new Rect(2, 3)];
  const gm = new Group<Shape>(mixed);
  console.log(gm.total().toString() + " " + gm.names());
  const p = new Pair(new Sq(2), new Rect(1, 2));
  console.log(p.sum().toString() + " " + p.firstGroup().total().toString());
}
