import { parse, stringify, Json } from "std:json";

function show(s: string): void {
  match (parse(s)) {
    Ok(j) => { console.log(stringify(j)); },
    Err(e) => { console.log("error " + e.message); }
  }
}

function main(): void {
  show("null");
  show("true");
  show(" false ");
  show("0");
  show("-17");
  show("\"hi\"");
  show("[]");
  show("{}");
  show("[1, 2 , [3, [4]], {\"a\": null}]");
  show("{\"k\": {\"x\": [true, false]}, \"z\": \"\"}");
  show("\t\n [ 1 ,\r\n 2 ] \n");
}
