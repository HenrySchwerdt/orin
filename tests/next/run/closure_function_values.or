function double(x: int): int {
  return x * 2;
}

function describe(s: string): string {
  return "[" + s + "]";
}

function identity<T>(x: T): T {
  return x;
}

function fact(n: int): int {
  return n <= 1 ? 1 : n * fact(n - 1);
}

function twice(f: (x: int) => int, x: int): int {
  return f(f(x));
}

function logIt(s: string): void {
  console.log("log " + s);
}

function main(): void {
  const f = double;
  console.log(f(21).toString());
  console.log(twice(double, 5).toString());
  const g: (s: string) => string = describe;
  console.log(g("x"));
  const ids = [3, 1, 2].map(identity);
  console.log(ids[0].toString() + ids[1].toString() + ids[2].toString());
  const idStr: (s: string) => string = identity;
  console.log(idStr("same"));
  const facts = [3, 5].map(fact);
  console.log(facts[0].toString() + "," + facts[1].toString());
  ["a", "b"].forEach(logIt);
  const table: ((n: int) => int)[] = [double, fact, identity];
  console.log(table[0](4).toString() + table[1](4).toString() + table[2](4).toString());
  console.log(twice(fact, 3).toString());
}
