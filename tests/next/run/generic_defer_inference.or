type Pair<A, B> = { first: A; second: B; };

function both<T>(a: T, b: T): T[] {
  return [a, b];
}

function orDefault<T>(o: Option<T>, d: T): T {
  return o.unwrapOr(d);
}

function main(): void {
  const xs = both(None, Some(3));
  console.log(xs.length.toString());
  const lits = both(1, 2);
  console.log(lits.length.toString());
  const u: usize = 4;
  const us = both(1, u);
  console.log(us[0].toString());
  console.log(orDefault(None, "dflt"));
  const ps: Pair<int, string>[] = [Pair { first: 1, second: "a" }];
  console.log(both(ps[0], ps[0]).length.toString());
}
