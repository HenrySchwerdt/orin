// Sorting 2000 pseudo-random numbers, stability on equal keys, and the original is unchanged.
type Item = { key: int; seq: int; };

function main(): void {
  let items: Item[] = [];
  let seed = 12345;
  let i = 0;
  while (i < 2000) {
    seed = (seed * 1103 + 12345) % 100003;
    items.push(Item { key: seed % 50, seq: i });
    i += 1;
  }
  const sorted = items.sort((a, b) => a.key - b.key);
  let ok = true;
  let j: usize = 1;
  while (j < sorted.length) {
    const p = sorted[j - 1];
    const q = sorted[j];
    if (p.key > q.key) {
      ok = false;
    }
    if (p.key == q.key && p.seq > q.seq) {
      ok = false;
    }
    j += 1;
  }
  console.log(sorted.length.toString() + " " + ok.toString());
  console.log(items[0].seq.toString() + " " + items[1999].seq.toString());
  const nums = items.map(it => it.key);
  const asc = nums.sort((a, b) => a - b);
  console.log(asc[0].toString() + " " + asc[1999].toString());
}
