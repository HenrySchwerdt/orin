// error: E0417
// stderr: does not declare `implements Shape`
interface Shape {
  area(): int;
}

class Blob implements Hash {
  constructor(public n: int) {}
  hash(): usize { return this.n.toUsize(); }
  equals(other: Blob): bool { return this.n == other.n; }
}

function render<T extends Hash & Shape>(x: T): int {
  return x.area() + x.hash().toInt();
}

function main(): void {
  console.log(render(new Blob(1)).toString());
}
