import { Graph, graphErrorMessage, GraphError } from "std:graph";

function msg<T>(r: Result<T, GraphError>): string {
  return match (r) {
    Ok(v) => "ok",
    Err(e) => graphErrorMessage(e)
  };
}

function msgVoid(r: Result<void, GraphError>): string {
  return match (r) {
    Ok => "ok",
    Err(e) => graphErrorMessage(e)
  };
}

function main(): void {
  let g1 = new Graph<int>(1);
  let g2 = new Graph<int>(2);
  const a1 = g1.add(100);
  const a2 = g2.add(200);
  console.log(msg(g2.get(a1)));
  console.log(msg(g1.get(a2)));
  console.log(msgVoid(g2.set(a1, 1)));
  console.log(msg(g2.remove(a1)));
  console.log(msg(g2.neighbors(a1)));
  console.log(msgVoid(g1.addEdge(a1, a2)));
  console.log(msgVoid(g1.addEdge(a2, a1)));
  console.log(g2.contains(a1).toString());
  console.log(msg(g1.get(a1)));
  // Same tag but an id naming a slot beyond the (empty) graph is foreign as well.
  const g3 = new Graph<int>(1);
  console.log(msg(g3.get(a1)));
  // A foreign id leaves the graph untouched.
  console.log(g2.size().toString() + " " + msg(g2.get(a2)));
}
