// User annotations are metadata: they are checked but change nothing in the generated program.
import { Verb, Get, Post, Route, Json, JsonName, Doc, Bounds, DEFAULT_LIMIT, ROOT } from "./annos";

// A module-private annotation, used in the same module.
@Annotation(function)
type Local = { n: int; };

@Json
@Doc("a user")
export type User = { id: int; @JsonName("display_name") name: string; @Doc("tags") tags: string[]; };

@Json
type Alias = int;

@Json
type Shape = Circle(int) | Dot;

@Bounds(-5, 10, -0.5, [true, false], ["a", "b"])
const LIMIT: int = 7;

@Bounds(DEFAULT_LIMIT, 3, 1.5, [], [], Some(2))
const OTHER: int = 8;

@Doc(ROOT)
interface Store {
  @Doc("find one")
  find(id: int): User;
  count(): int;
}

@Json
@Doc("the users")
class Users implements Store {
  @Doc("how many")
  private n: int;

  constructor() {
    this.n = 1;
  }

  @Route("/users/:id", Get)
  find(id: int): User {
    return User { id: id, name: "n" + id.toString(), tags: [] };
  }

  @Route(ROOT, Post, "admin")
  @Doc("size")
  count(): int {
    return this.n;
  }
}

@Local(1)
@Route("/ping", Get, None)
function ping(): int {
  return 1;
}

function main(): void {
  const u = new Users();
  console.log(u.find(3).name);
  console.log((u.count() + ping() + LIMIT + OTHER).toString());
}
