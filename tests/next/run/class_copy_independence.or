// Passing a class value to a function and mutating the copy never affects the caller.
class Bag {
  constructor(public n: int) {}
  add(): void {
    this.n += 1;
  }
}

function bumpCopy(b: Bag): int {
  let c = b;
  c.add();
  c.add();
  return c.n;
}

function rebuild(b: Bag): Bag {
  let c = b;
  c.add();
  return c;
}

function main(): void {
  let a = new Bag(1);
  console.log(bumpCopy(a).toString() + " " + a.n.toString());
  const r = rebuild(a);
  console.log(r.n.toString() + " " + a.n.toString());
  a = rebuild(a);
  console.log(a.n.toString());
  let arr = [a, a];
  arr[0].add();
  console.log(arr[0].n.toString() + " " + arr[1].n.toString() + " " + a.n.toString());
}
