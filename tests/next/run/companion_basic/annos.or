// The annotations of the companion test. `Json` has a recorded output (models.gen.Json.json); `Note` has none and stays metadata.
@Annotation(type, class)
export type Json = { };

@Annotation(type)
export type Note = { text: string; };

// A helper that the generated code imports from here although models.or does not.
export function helper(n: int): int {
  return n * 2;
}
