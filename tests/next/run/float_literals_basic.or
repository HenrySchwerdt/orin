// float literals: decimal, exponent, default type `float`, expected type f32, negative literals
const A = 1.5;
const B: float = 2e3;
const C: f32 = 0.25;
const D = -3.75;
const E1: float = 1E2;
const F: float = 2.5e-3;
const G: float = 1.5e+2;

function main(): void {
  console.log(A.toString());
  console.log(B.toString());
  console.log(C.toString());
  console.log(D.toString());
  console.log(E1.toString());
  console.log(F.toString());
  console.log(G.toString());
  const x = 0.5;
  const y: f32 = 0.5;
  const z = -0.5;
  console.log((x + 1.0).toString());
  console.log((y * 3.0).toString());
  console.log((z * z).toString());
  console.log((1.5).toString());
  console.log(7.0.toString());
  console.log(0.0.toString());
  console.log(100000000.0.toString());
  console.log(1e9.toString());
  console.log(12345.678.toString());
}
