import { assertEq, assertEqUsize, assertEqString, assertEqBool } from "std:test";
import { commentsOf, sameStrs, stripSpans, errorCodes, isErrorCode, firstDiag, splitLines, rstrip } from "../src/fmtlogic";

@Test
function commentsAreCollected(): void {
  const c = commentsOf("let a = 1; // one  \n/* two\nlines */ let b = \"// not\"; // three\n");
  assertEqUsize(c.length, 3, "three comments");
  assertEqBool(sameStrs(c, ["/* two\nlines */", "// one", "// three"]), true, "right-trimmed, sorted");
}

@Test
function commentsSkipStrings(): void {
  assertEqUsize(commentsOf("let s = \"a // b \\\" /* c\"; // d").length, 1, "an escaped quote does not end the string");
  assertEqUsize(commentsOf("x /* open").length, 1, "an unterminated block comment runs to the end");
  assertEqBool(sameStrs(commentsOf("// b\n// a\n// b"), ["// a", "// b", "// b"]), true, "a multiset keeps duplicates");
}

@Test
function spansAreStripped(): void {
  assertEqString(stripSpans("Fn(a)@3-10 x@12-14"), "Fn(a) x", "spans");
  assertEqString(stripSpans("a@b @1 @1- @-2 user@host"), "a@b @1 @1- @-2 user@host", "not spans");
  assertEqString(stripSpans("@12-3@4-5"), "", "adjacent spans");
}

@Test
function diagnosticsOfTextMode(): void {
  const t = "tests/errors/x.or:12:5: error[E0200]: expected\n  note\nother.or:1:1: error[E0300]: y\n";
  assertEqBool(sameStrs(errorCodes(t), ["E0200", "E0300"]), true, "codes");
  assertEqBool(isErrorCode("E0100"), true, "code");
  assertEqBool(isErrorCode("E010"), false, "short");
  assertEqBool(isErrorCode("X0100"), false, "letter");
  const d = firstDiag(t);
  assertEqBool(d.found, true, "found");
  assertEqString(d.file, "tests/errors/x.or", "file");
  assertEq(d.line, 12, "line");
  assertEq(d.col, 5, "col");
  assertEqBool(firstDiag("no diagnostic here\n").found, false, "none");
  assertEqString(firstDiag("a:b:1:2: error x").file, "a:b", "lazy file part: the first match");
}

@Test
function linesAndStrip(): void {
  assertEqUsize(splitLines("a\nb\n").length, 2, "trailing newline");
  assertEqUsize(splitLines("a\n\nb").length, 3, "blank line kept");
  assertEqUsize(splitLines("").length, 0, "empty");
  assertEqString(rstrip("x \t\n"), "x", "rstrip");
}
