type Config = { values: Map<string, string>; };

function defaults(): Config {
  let c = Config { values: new Map() };
  c.values.set("mode", "fast");
  return c;
}

function lookup(c: Config, k: string): string {
  return c.values.get(k).unwrapOr("<unset>");
}

function main(): void {
  const c = defaults();
  console.log(lookup(c, "mode"));
  console.log(lookup(c, "color"));
  let other = c;
  other.values.set("color", "red");
  console.log(lookup(c, "color") + " " + lookup(other, "color"));
  const maps: Map<int, int>[] = [new Map(), new Map<int, int>()];
  console.log(maps.length.toString());
  console.log(maps[0].size.toString());
}
