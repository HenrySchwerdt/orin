// `orin test [--filter <substring>] [--format=json] <file.or | package-dir>` (ADR-0024, docs/testing.md).
//
//   --filter S         run only the tests whose id (`<module>.<function>`) contains S
//   --format=json      one JSON object on stdout (stable key order, no timings) instead of text
//   --runtime DIR      directory with the C runtime (default: ./runtime/core; the `orin` launcher passes its own)
//   --cc CMD           C compiler command, flags allowed (default: cc)
//   --out-dir DIR      build here and keep the files (default: a temporary directory, removed afterwards)
//   --keep             keep the temporary build directory
//   --no-contracts     build without runtime contract checking (default: contract clauses are checked, ADR-0012)
//   --timeout SECONDS  per test (default 10, 0 = unlimited; native monotonic deadline; no external timeout tool)
//
// Exit status: 0 all selected tests passed (or none exist), 1 a test failed or the program does not
// compile, 2 usage.

import { FsGrant } from "std:fs";
import { ProcessGrant } from "std:process";
import {
  SourceMap, render, TerminalOptions, terminalOptions, renderTerminal, paint, terminalSafe,
} from "../diag";
import { printDiagnosticsJson } from "../tools";
import { quoteJson } from "../json";
import { TestOpts, TestRun, runTests, reportText, reportJson, runOk } from "./runner";
import { usageError } from "../util";

function usage(): int {
  return usageError(
    "usage: orin test [--filter <substring>] [--format=json] [--runtime <dir>] [--cc <cmd>] [--out-dir <dir>] [--keep] [--no-contracts] [--timeout <seconds>] <file.or | package-dir>",
  );
}

export function runTestCommand(fs: FsGrant, proc: ProcessGrant, args: string[]): int {
  const ui = terminalOptions(args);
  const argv = ui.args;
  let allowEmpty = false;
  let filter = "";
  let json = false;
  let runtime = "runtime/core";
  let cc = "cc";
  let outDir = "";
  let keep = false;
  let contracts = true;
  let timeout: int = 10;
  let entry = "";
  let i: usize = 0;
  while (i < argv.length) {
    const a = argv[i];
    i += 1;
    if (a == "--allow-empty") {
      allowEmpty = true;
    } else if (a == "--format=json") {
      json = true;
    } else if (a == "--keep") {
      keep = true;
    } else if (a == "--no-contracts") {
      contracts = false;
    } else if (a == "--filter"
        || a == "--runtime"
        || a == "--cc"
        || a == "--out-dir"
        || a == "--timeout") {
      if (i >= argv.length) {
        return usage();
      }
      const v = argv[i];
      i += 1;
      if (a == "--filter") {
        filter = v;
      } else if (a == "--runtime") {
        runtime = v;
      } else if (a == "--cc") {
        cc = v;
      } else if (a == "--out-dir") {
        outDir = v;
      } else {
        const n = parseInt(v);
        if (n.isNone() || n.unwrap() < 0) {
          console.error("error: --timeout needs a number of seconds");
          return 2;
        }
        timeout = n.unwrap();
      }
    } else if (a.startsWith("-")) {
      console.error("error: unknown option " + a);
      return usage();
    } else if (entry.length == 0) {
      entry = a;
    } else {
      return usage();
    }
  }
  if (entry.length == 0) {
    return usage();
  }
  const r = runTests(
    fs,
    proc,
    TestOpts {
      entry: entry,
      filter: filter,
      runtime: runtime,
      cc: cc,
      outDir: outDir,
      keep: keep,
      timeout: timeout,
      contracts: contracts,
      root: "",
    },
  );
  if (ui.rich
      && r.diags.length == 0
      && r.error == ""
      && r.results.length == 0
      && (!allowEmpty || filter != "")) {
    return finish(
      TestRun {
        ...r,
        error: "No tests matched. Use --allow-empty only when an empty suite is intentional.",
      },
      json,
      ui,
    );
  }
  return finish(r, json, ui);
}

function finish(r: TestRun, json: bool, ui: TerminalOptions): int {
  if (r.diags.length > 0) {
    if (json) {
      printDiagnosticsJson(r.sm, r.diags);
    } else {
      for (const d of r.diags) {
        console.error(
          ui.rich ? renderTerminal(r.sm, d, ui.color, ui.ascii) + "\n" : render(r.sm, d),
        );
      }
    }
    return 1;
  }
  if (r.error.length > 0) {
    if (json) {
      console.log("{\"ok\":false,\"error\":" + quoteJson(r.error) + "}");
    } else {
      console.error("error: " + r.error);
    }
    return 1;
  }
  if (json) {
    console.log(reportJson(r));
  } else {
    for (const d of r.warnings) {
      console.error(ui.rich ? renderTerminal(r.sm, d, ui.color, ui.ascii) + "\n" : render(r.sm, d));
    }
    console.log(ui.rich ? reportTerminal(r, ui) : reportText(r));
  }
  return runOk(r) ? 0 : 1;
}

// Compact per-file success rows; failed tests keep their actual captured evidence.
function reportTerminal(r: TestRun, ui: TerminalOptions): string {
  let lines: string[] = [];
  let files: string[] = [];
  for (const x of r.results) {
    if (!files.includes(x.path)) {
      files.push(x.path);
    }
  }
  for (const path of files) {
    let passed: usize = 0;
    let failed: usize = 0;
    for (const x of r.results) {
      if (x.path == path) {
        if (x.pass) {
          passed += 1;
        } else {
          failed += 1;
        }
      }
    }
    const mark = failed > 0 ? ui.ascii ? "FAIL" : "✗" : ui.ascii ? "OK" : "✓";
    if (!ui.quiet || failed > 0) {
      lines.push(
        paint(mark, failed > 0 ? "31" : "32", ui.color) + " " + terminalSafe(path) + "  "
            + passed.toString() + " passed"
            + (failed > 0 ? " · " + failed.toString() + " failed" : ""),
      );
    }
  }
  for (const x of r.results) {
    if (!x.pass) {
      lines.push("\n" + paint("FAIL " + terminalSafe(x.test.id), "1;31", ui.color));
      lines.push("  " + terminalSafe(x.path) + ":" + x.line.toString() + ":" + x.col.toString());
      lines.push("  " + x.reason + " (exit " + x.exitCode.toString() + ")");
      if (x.stderr.length > 0) {
        lines.push(
          "\n  stderr: " + x.stderr.split("\n").map(line => terminalSafe(line)).join("\n  "),
        );
      }
      if (x.stdout.length > 0) {
        lines.push(
          "  stdout: " + x.stdout.split("\n").map(line => terminalSafe(line)).join("\n  "),
        );
      }
    } else if (ui.verbose) {
      lines.push(paint("PASS " + terminalSafe(x.test.id), "32", ui.color));
    }
  }
  let passed: usize = 0;
  for (const x of r.results) {
    if (x.pass) {
      passed += 1;
    }
  }
  lines.push(
    "\n"
        + paint(
          (r.results.length - passed).toString() + " failed · " + passed.toString() + " passed",
          passed == r.results.length ? "32" : "31",
          ui.color,
        ),
  );
  return lines.join("\n");
}
