// `x = x + e` and `x = x.concat(e)` must cost the same as `x += e` / a push: 200,000 one-byte appends to a local string,
// a record field, a class field and an element of a record array, and 100,000 one-element array concatenations to a local
// and to a field (the plain `a = a.concat(b)` of a loop). Go appends to a slice / builder (naive `s += t` is quadratic in Go),
// C to a growable buffer.
type Rec = { s: string; a: int[]; };

class Buf {
  s: string;
  constructor() {
    this.s = "";
  }
  add(t: string): void {
    this.s = this.s + t;
  }
}

function main(): void {
  let s = "";
  let i = 0;
  while (i < 200000) {
    s = s + "x";
    i += 1;
  }
  console.log("local " + s.length.toString());
  let r = Rec { s: "", a: [] };
  i = 0;
  while (i < 200000) {
    r.s = r.s + "y";
    i += 1;
  }
  console.log("field " + r.s.length.toString());
  let b = new Buf();
  i = 0;
  while (i < 200000) {
    b.add("z");
    i += 1;
  }
  console.log("class field " + b.s.length.toString());
  let rs: Rec[] = [Rec { s: "", a: [] }, Rec { s: "", a: [] }];
  i = 0;
  while (i < 200000) {
    rs[1].s = rs[1].s + "w";
    i += 1;
  }
  console.log("element " + rs[1].s.length.toString() + " " + rs[0].s.length.toString());
  let a: int[] = [];
  i = 0;
  while (i < 100000) {
    a = a.concat([i]);
    i += 1;
  }
  console.log("array " + a.length.toString() + " " + a[99999].toString());
  i = 0;
  while (i < 100000) {
    r.a = r.a.concat([i, i]);
    i += 1;
  }
  console.log("array field " + r.a.length.toString() + " " + r.a[199999].toString());
}
