const A: int = 0x10;
const NEG: int = -5;
const NAME: string = "top";
const FLAG: bool = true;
const LIMIT: usize = 3;

function main(): void {
  console.log(A.toString());
  console.log(NEG.toString());
  console.log(NAME + "!");
  console.log(FLAG.toString());
  console.log((LIMIT + 1).toString());
  console.log((A + NEG).toString());
}
