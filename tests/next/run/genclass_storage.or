// Generic class values stored in arrays, Map, Option, Result, records, unions and other generic classes.
class Box<T> {
  value: T;
  constructor(v: T) {
    this.value = v;
  }
  get(): T {
    return this.value;
  }
  set(v: T): void {
    this.value = v;
  }
}

class Stack<T> {
  items: T[] = [];
  push(x: T): void {
    this.items.push(x);
  }
  pop(): Option<T> {
    return this.items.pop();
  }
  size(): usize {
    return this.items.length;
  }
}

type Cell = { name: string; box: Box<float>; };
type Slot = Empty | Full(Box<int>);

function find(xs: Box<int>[], n: int): Option<Box<int>> {
  for (const x of xs) {
    if (x.get() == n) {
      return Some(x);
    }
  }
  return None;
}

function parse(s: string): Result<Box<int>, string> {
  const n = parseInt(s);
  return match (n) {
    Some(v) => Ok(new Box(v)),
    None => Err("not a number: " + s)
  };
}

function sum(s: Slot): int {
  return match (s) {
    Empty => 0,
    Full(b) => b.get()
  };
}

function main(): void {
  // arrays of generic class values
  let boxes: Box<int>[] = [new Box(1), new Box(2), new Box(3)];
  boxes[1].set(20);
  boxes.push(new Box(4));
  let total = 0;
  for (const b of boxes) {
    total += b.get();
  }
  console.log(total.toString() + " " + boxes.length.toString());
  console.log(find(boxes, 20).isSome().toString() + " " + find(boxes, 5).isNone().toString());
  // Map<string, Box<float>>
  let m = new Map<string, Box<float>>();
  m.set("pi", new Box(3.5));
  m.set("e", new Box(2.5));
  console.log(m.get("pi").unwrap().get().toString() + " " + m.get("e").unwrap().get().toString());
  console.log(m.get("tau").isNone().toString() + " " + m.size.toString());
  // records and unions holding generic class values
  let cell = Cell { name: "c", box: new Box(1.5) };
  cell.box.set(2.5);
  console.log(cell.name + cell.box.get().toString());
  console.log((sum(Full(new Box(41))) + sum(Empty)).toString());
  // Result and Option
  console.log(match (parse("12")) { Ok(b) => b.get().toString(), Err(e) => e });
  console.log(match (parse("x")) { Ok(b) => b.get().toString(), Err(e) => e });
  // generic classes inside generic classes, arrays of arrays
  let stack = new Stack<Box<string>>();
  stack.push(new Box("a"));
  stack.push(new Box("b"));
  console.log(stack.pop().unwrap().get() + stack.size().toString());
  let grid = new Stack<Stack<int>>();
  let row = new Stack<int>();
  row.push(1);
  row.push(2);
  grid.push(row);
  row.push(3);
  console.log(grid.pop().unwrap().size().toString() + " " + row.size().toString());
  const nested: Box<Box<int>[]>[] = [new Box([new Box(1), new Box(2)])];
  console.log(nested[0].get()[1].get().toString());
}
