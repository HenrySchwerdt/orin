// Workspace: the analysis inputs (spec 18 §2). File contents keyed by (normalized) path — an
// overlay of unsaved editor buffers over the disk. Every change bumps `revision`.
// All operations are pure: they return a new Workspace.

import { SourceFile } from "../diag";
import { normalizePath } from "../loader";

export type Workspace = { files: SourceFile[]; revision: int; };

export function newWorkspace(): Workspace {
  const none: SourceFile[] = [];
  return Workspace { files: none, revision: 0 };
}

function indexOfPath(ws: Workspace, p: string): Option<usize> {
  let i: usize = 0;
  while (i < ws.files.length) {
    if (ws.files[i].path == p) {
      return Some(i);
    }
    i += 1;
  }
  return None;
}

export function hasFile(ws: Workspace, path: string): bool {
  return indexOfPath(ws, normalizePath(path)).isSome();
}

export function fileText(ws: Workspace, path: string): Option<string> {
  const k = indexOfPath(ws, normalizePath(path));
  if (k.isNone()) {
    return None;
  }
  return Some(ws.files[k.unwrap()].text);
}

// Set (insert or replace) the buffer for `path`.
export function openFile(ws: Workspace, path: string, text: string): Workspace {
  const p = normalizePath(path);
  let files = ws.files;
  const k = indexOfPath(ws, p);
  if (k.isSome()) {
    files[k.unwrap()] = SourceFile { path: p, text: text };
  } else {
    files.push(SourceFile { path: p, text: text });
  }
  return Workspace { files: files, revision: ws.revision + 1 };
}

// Full-document change (Phase 1 has no incremental edits). Same as openFile.
export function changeFile(ws: Workspace, path: string, text: string): Workspace {
  return openFile(ws, path, text);
}

// Drop the buffer: the file falls back to its on-disk contents.
export function closeFile(ws: Workspace, path: string): Workspace {
  const p = normalizePath(path);
  let files: SourceFile[] = [];
  for (const f of ws.files) {
    if (f.path != p) {
      files.push(f);
    }
  }
  return Workspace { files: files, revision: ws.revision + 1 };
}

// Paths of all overlay buffers, in open order.
export function openPaths(ws: Workspace): string[] {
  let out: string[] = [];
  for (const f of ws.files) {
    out.push(f.path);
  }
  return out;
}
