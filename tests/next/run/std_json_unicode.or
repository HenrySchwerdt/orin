import { parse, stringify, asString } from "std:json/legacy";

function codes(s: string): string {
  let parts: string[] = [];
  let i: usize = 0;
  while (i < s.length) {
    parts.push(s.charCodeAt(i).toString());
    i += 1;
  }
  return parts.join(",");
}

function main(): void {
  console.log(codes(asString(parse("\"\\u0041\"").unwrap()).unwrap()));
  console.log(codes(asString(parse("\"\\u00e9\"").unwrap()).unwrap()));
  console.log(codes(asString(parse("\"\\u20ac\"").unwrap()).unwrap()));
  console.log(codes(asString(parse("\"\\ud83d\\ude00\"").unwrap()).unwrap()));
  console.log(codes(asString(parse("\"\\ud83d x\"").unwrap()).unwrap()));
  console.log(codes(asString(parse("\"\\ude00\"").unwrap()).unwrap()));
  const raw = "\"h\xc3\xa9llo\"";
  const j = parse(raw).unwrap();
  console.log(stringify(j) == raw ? "raw utf8 passes through" : "changed");
}
