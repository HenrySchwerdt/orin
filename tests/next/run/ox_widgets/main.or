// OX with a Components provider (ADR-0044 §3, §4.1, §4.2, §4.4): markup builds widgets through ordinary function calls.
// Covers intrinsic tags as provider functions, typed attributes, a function-valued prop, an Option attribute, the
// default slot `Widget[]`, a spliced list, a required and an optional named slot, a `string` slot, fragments, spread and
// the evaluation order. No std:html in this program.
import ox from "./widgets";
import { Widget, show, press } from "./widgets";

// Typed attributes (string, int), an Option<int> attribute that may be left out, a function-valued prop.
function Counter(title: string, step: int, max: Option<int>, onClick: () => void): Widget {
  const limit = max.unwrapOr(100);
  return <column spacing={step}>
    <label value={`${title} (max ${limit})`} />
    <button title="+" onClick={onClick} />
  </column>;
}

// The default slot: `children` of type Widget[]; a list written as {children} is spliced.
function Stack(gap: int, children: Widget[]): Widget {
  return <column spacing={gap}>{children}</column>;
}

// A required named slot `header` (type Widget), the default slot, an optional named slot `footer`.
function Dialog(title: string, header: Widget, children: Widget[], footer: Option<Widget>): Widget {
  return <dialog title={title} header={header} footer={footer}>{children}</dialog>;
}

// A string slot: the children are text and numbers, concatenated (not encoded: it is a string, not markup).
function Title(children: string): Widget {
  return <label value={children} />;
}

type CounterProps = { title: string; step: int; };

function trace(name: string, v: int): int {
  console.log("eval " + name);
  return v;
}

function lab(name: string): Widget {
  console.log("make " + name);
  return <label value={name} />;
}

// Parameters in the order a, b, c; the call below writes the attributes c, a, b.
function Order(a: int, b: int, c: int): Widget {
  console.log(`call a=${a} b=${b} c=${c}`);
  return <label value={`${a}-${b}-${c}`} />;
}

type SpacerProps = { size: int; };

function main(): void {
  console.log("== intrinsics");
  console.log(show(<column spacing={2}><label value="hi" /><spacer size={1} />text child</column>));

  console.log("== typed attributes, Option left out and given, function prop");
  const c1 = <Counter title="Apples" step={3} onClick={() => { console.log("apples clicked"); }} />;
  const c2 = <Counter title="Pears" step={1} max={Some(9)} onClick={() => { console.log("pears clicked"); }} />;
  console.log(show(c1));
  console.log(show(c2));
  press(c1);
  press(c2);

  console.log("== default slot: elements, text, a spliced list");
  const xs: Widget[] = [<label value="x1" />, <label value="x2" />];
  const s = <Stack gap={4}>
    <label value="first" />
    plain words
    {xs}
    <spacer size={2} />
  </Stack>;
  console.log(show(s));
  console.log(show(<Stack gap={0} />));
  console.log(show(<Stack gap={1}><Stack gap={2}><label value="deep" /></Stack></Stack>));

  console.log("== named slots");
  const d1 = <Dialog title="Delete?">
    <:header><label value="Really delete?" /></:header>
    <label value="This cannot be undone." />
    <spacer size={1} />
    <:footer><button title="Delete" onClick={() => { console.log("deleted"); }} /></:footer>
  </Dialog>;
  console.log(show(d1));
  press(d1);
  const d2 = <Dialog title="Notice"><:header>Heads<spacer size={0} /></:header>Plain body</Dialog>;
  console.log(show(d2));
  const d3 = <Dialog title="Empty"><:header></:header></Dialog>;
  console.log(show(d3));

  console.log("== string slot");
  const name = "Orin";
  const n = 3;
  console.log(show(<Title>Hello {name}</Title>));
  console.log(show(<Title>Total: {n} items</Title>));

  console.log("== fragments");
  console.log(show(<><label value="a" /><label value="b" /></>));
  console.log(show(<><label value="solo" /></>));

  console.log("== spread");
  const props = CounterProps { title: "Spread", step: 2 };
  console.log(show(<Counter {...props} onClick={() => { console.log("spread clicked"); }} />));
  console.log(show(<Counter {...props} step={7} onClick={() => { console.log("spread clicked"); }} />));

  console.log("== spread on an intrinsic element");
  const sp = SpacerProps { size: 4 };
  console.log(show(<spacer {...sp} />));
  console.log(show(<spacer {...sp} size={9} />));
  console.log(show(<spacer size={1} {...sp} />));

  console.log("== evaluation order");
  const o = <Order c={trace("c", 3)} a={trace("a", 1)} b={trace("b", 2)} />;
  console.log(show(o));
  const o2 = <Stack gap={trace("gap", 5)}>{lab("k1")}{lab("k2")}</Stack>;
  console.log(show(o2));
}
