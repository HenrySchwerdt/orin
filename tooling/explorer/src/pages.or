// The pages of the explorer: overview, graph, symbol index, module pages and symbol pages. Each function returns the
// complete HTML document of one page; `Frame` (components.or) is the shared shell.

import ox from "std:html";
import { Html, document, empty } from "std:html";
import { CardGrid, Card, card, cardFull, compact, grouped } from "orin-reports";
import { Ix, ModStat, MEdge, NONE, outOf, inOf, isPageKind } from "./index";
import { Sym, Rel } from "./model";
import { moduleGraph, egoGraph, neighbours, Nb } from "./graphsvg";
import {
  Ctx, Frame, PageHead, KindBadge, EvBadge, Flag, SymLink, IdLink, qualified, Figure, Svg, Section, Empty, DocView, summaryOf, Loc,
  symHref, modHref, lastSegment,
} from "./components";
import { lower, clip, plural, percent, strCmp, afterLast } from "./util";

// ---- counts -----------------------------------------------------------------------------------------------------------

type Totals = { modules: int; symbols: int; exported: int; contracts: int; documented: int; effectful: int; calls: int; imports: int; };

function totals(ix: Ix): Totals {
  let t = Totals { modules: ix.mods.length.toInt(), symbols: 0, exported: 0, contracts: 0, documented: 0, effectful: 0, calls: 0, imports: 0 };
  for (const m of ix.mods) {
    t.symbols += m.symbols;
    t.exported += m.exported;
    t.contracts += m.contracts;
    t.documented += m.documented;
    t.effectful += m.effectful;
  }
  for (const e of ix.snap.edges) {
    if (e.kind == "CALLS") {
      t.calls += 1;
    } else if (e.kind == "IMPORTS") {
      t.imports += 1;
    }
  }
  return t;
}

function callCount(ix: Ix, i: usize, incoming: bool): int {
  let n: int = 0;
  for (const e of incoming ? ix.inn[i] : ix.out[i]) {
    if (ix.snap.edges[e].kind == "CALLS") {
      n += 1;
    }
  }
  return n;
}

function effectCount(ix: Ix, i: usize): int {
  let n: int = 0;
  for (const e of ix.out[i]) {
    if (ix.snap.edges[e].kind == "MAY_PERFORM") {
      n += 1;
    }
  }
  return n;
}

// ---- tables -----------------------------------------------------------------------------------------------------------

function SymRow(ctx: Ctx, i: usize, showModule: bool): Html {
  const ix = ctx.ix;
  const s = ix.snap.nodes[i];
  const fx = effectCount(ix, i);
  return <tr data-q={lower(s.id)} data-k={s.kind}>
    <th scope="row">
      <SymLink ctx={ctx} i={i} label={lastSegment(s.id)} />
      {s.exported ? <> <Flag text="pub" tip="exported" /></> : empty()}
      {s.entry ? <> <Flag text="entry" tip="entry point: main, an exported function or an exported public method" /></> : empty()}
      {ix.contracts[i] > 0 ? <> <Flag text={"C " + ix.contracts[i].toString()} tip={plural(ix.contracts[i], "contract clause", "contract clauses")} /></> : empty()}
      {fx > 0 ? <> <Flag text="IO" tip={plural(fx, "effect it may perform", "effects it may perform")} /></> : empty()}
      {s.doc.length > 0 ? <> <Flag text="doc" tip="has a documentation comment" /></> : empty()}
    </th>
    <td><KindBadge kind={s.kind} /></td>
    {showModule ? <td class="ex-mod">{s.module}</td> : empty()}
    <td class="ex-sig-cell"><code>{clip(s.sig, 140)}</code></td>
  </tr>;
}

function SymTable(ctx: Ctx, rows: usize[], showModule: bool, caption: string): Html {
  return <div class="r-table-wrap ex-table" role="region" aria-label={caption} tabindex={0}>
    <table class="r-table">
      <caption>{caption}</caption>
      <thead><tr><th scope="col">Symbol</th><th scope="col">Kind</th>{showModule ? <th scope="col">Module</th> : empty()}<th scope="col">Signature</th></tr></thead>
      <tbody>{rows.map(i => <SymRow ctx={ctx} i={i} showModule={showModule} />)}</tbody>
    </table>
    {rows.length == 0 ? <p class="r-empty">No symbols.</p> : empty()}
  </div>;
}

function ModRow(ctx: Ctx, m: ModStat, mi: usize): Html {
  return <tr>
    <th scope="row"><a class="ex-sym" href={modHref(ctx, mi)}>{m.name}</a></th>
    <td class="r-num">{m.symbols.toString()}</td>
    <td class="r-num">{m.exported.toString()}</td>
    <td class="r-num">{m.contracts.toString()}</td>
    <td class="r-num">{m.effectful.toString()}</td>
    <td class="r-num">{m.importsOut.length.toString()}</td>
    <td class="r-num">{m.importsIn.length.toString()}</td>
    <td class="r-num">{percent(m.documented, m.symbols)}</td>
  </tr>;
}

function ModTable(ctx: Ctx): Html {
  const ix = ctx.ix;
  let rows: Html[] = [];
  let k: usize = 0;
  while (k < ix.mods.length) {
    rows.push(<ModRow ctx={ctx} m={ix.mods[k]} mi={k} />);
    k += 1;
  }
  return <div class="r-table-wrap ex-table" role="region" aria-label="Modules" tabindex={0}>
    <table class="r-table">
      <caption>Modules</caption>
      <thead><tr><th scope="col">Module</th><th scope="col" class="r-num">Symbols</th><th scope="col" class="r-num">Exported</th><th scope="col" class="r-num">Contracts</th><th scope="col" class="r-num">Effectful</th><th scope="col" class="r-num">Imports</th><th scope="col" class="r-num">Imported by</th><th scope="col" class="r-num">Documented</th></tr></thead>
      <tbody>{rows}</tbody>
    </table>
  </div>;
}

// ---- overview -----------------------------------------------------------------------------------------------------------

function pageNodes(ix: Ix): usize[] {
  let r: usize[] = [];
  let i: usize = 0;
  while (i < ix.snap.nodes.length) {
    if (ix.page[i] == i) {
      r.push(i);
    }
    i += 1;
  }
  return r;
}

function mostCalled(ix: Ix, limit: usize): usize[] {
  const all = pageNodes(ix);
  let counts: int[] = [];
  let k: usize = 0;
  while (k < ix.snap.nodes.length) {
    counts.push(0);
    k += 1;
  }
  let callable: usize[] = [];
  for (const i of all) {
    counts[i] = callCount(ix, i, true);
    if (counts[i] > 0) {
      callable.push(i);
    }
  }
  const sorted = callable.sort((a: usize, b: usize): int => counts[a] != counts[b] ? (counts[a] > counts[b] ? -1 : 1) : strCmp(ix.snap.nodes[a].id, ix.snap.nodes[b].id));
  return sorted.length > limit ? sorted.slice(0, limit) : sorted;
}

function TopRow(ctx: Ctx, i: usize): Html {
  const s = ctx.ix.snap.nodes[i];
  return <tr>
    <th scope="row"><SymLink ctx={ctx} i={i} label={lastSegment(s.id)} /></th>
    <td class="ex-mod">{s.module}</td>
    <td class="r-num">{callCount(ctx.ix, i, true).toString()}</td>
    <td class="r-num">{callCount(ctx.ix, i, false).toString()}</td>
  </tr>;
}

export function OverviewPage(ctx: Ctx): string {
  const ix = ctx.ix;
  const t = totals(ix);
  const cards: Card[] = [
    card("Modules", t.modules.toString(), Some(plural(t.imports, "import", "imports")), None),
    card("Symbols", grouped(t.symbols), Some(plural(t.exported, "exported", "exported")), None),
    card("Calls", grouped(t.calls), Some("CALLS edges, with MUST / MAY / UNKNOWN evidence"), None),
    card("Contracts", grouped(t.contracts), Some("requires, ensures and invariant clauses"), None),
    card("Effectful", grouped(t.effectful), Some("functions that may perform an effect"), None),
    cardFull("Documented", percent(t.documented, t.symbols), t.documented.toString() + " of " + t.symbols.toString() + " symbols have a documentation comment", Some(t.documented.toString() + " of " + t.symbols.toString() + " symbols"), None),
  ];
  const g = moduleGraph(ix, "imports", "ov-", "");
  const top = mostCalled(ix, 10);
  const body = <>
    <PageHead eyebrow={<>Package</>} title={ix.snap.pkg} lead={"Snapshot " + ix.snap.schema + " · " + ix.snap.hash} />
    <CardGrid cards={cards} />
    {Section("graph", "Module dependencies", "Imports between modules" + (g.implied > 0 ? ", without the " + g.implied.toString()
      + " shortcuts that a longer path already implies" : "") + ". Click a module to open it. The accent bar marks modules with contracts (blue) or effects (amber).",
      <>{Figure("Module dependency graph: an arrow points from the importing module to the imported one.", g.svg, false)}
        <p class="ex-more"><a href="graph.html">Open the full graph and the call flow</a></p></>)}
    {Section("modules", "Modules", "", <ModTable ctx={ctx} />)}
    {Section("hot", "Most called symbols", "By number of call sites in the snapshot.", top.length == 0 ? Empty("No calls recorded.") :
      <div class="r-table-wrap ex-table" role="region" aria-label="Most called symbols" tabindex={0}><table class="r-table">
        <thead><tr><th scope="col">Symbol</th><th scope="col">Module</th><th scope="col" class="r-num">Callers</th><th scope="col" class="r-num">Callees</th></tr></thead>
        <tbody>{top.map(i => <TopRow ctx={ctx} i={i} />)}</tbody></table></div>)}
  </>;
  return document(<Frame ctx={ctx} active="overview" title="Overview" body={body} />);
}

// ---- graph ------------------------------------------------------------------------------------------------------------------

function Legend(): Html {
  return <ul class="ex-legend" aria-label="Legend">
    <li><span class="ex-sw ex-sw-contract"></span>module with contracts</li>
    <li><span class="ex-sw ex-sw-effect"></span>module with effects (IO)</li>
    <li><svg class="ex-sw-line" width="34" height="8" viewBox="0 0 34 8" aria-hidden="true"><line x1="1" y1="4" x2="33" y2="4" class="ex-edge-line" stroke-width="2" /></svg>MUST</li>
    <li><svg class="ex-sw-line ex-ev-may" width="34" height="8" viewBox="0 0 34 8" aria-hidden="true"><line x1="1" y1="4" x2="33" y2="4" class="ex-edge-line" stroke-width="2" stroke-dasharray="6 4" /></svg>MAY</li>
    <li><svg class="ex-sw-line ex-ev-unknown" width="34" height="8" viewBox="0 0 34 8" aria-hidden="true"><line x1="1" y1="4" x2="33" y2="4" class="ex-edge-line" stroke-width="2" stroke-dasharray="2 4" /></svg>UNKNOWN</li>
  </ul>;
}

function FlowRow(ctx: Ctx, e: MEdge): Html {
  return <tr>
    <th scope="row"><a class="ex-sym" href={modHref(ctx, e.a)}>{ctx.ix.mods[e.a].name}</a> → <a class="ex-sym" href={modHref(ctx, e.b)}>{ctx.ix.mods[e.b].name}</a></th>
    <td class="r-num">{e.calls.toString()}</td>
    <td class="r-num">{e.must.toString()}</td>
    <td class="r-num">{e.may.toString()}</td>
    <td class="r-num">{e.unknown.toString()}</td>
  </tr>;
}

function FlowTable(ctx: Ctx): Html {
  let rows: MEdge[] = [];
  for (const e of ctx.ix.medges) {
    if (e.calls > 0) {
      rows.push(e);
    }
  }
  rows = rows.sort((p: MEdge, q: MEdge): int => p.calls != q.calls ? (p.calls > q.calls ? -1 : 1) : (p.a != q.a ? (p.a < q.a ? -1 : 1) : (p.b < q.b ? -1 : 1)));
  const shown = rows.length > 40 ? rows.slice(0, 40) : rows;
  return <div class="r-table-wrap ex-table" role="region" aria-label="Module call flows" tabindex={0}><table class="r-table">
    <thead><tr><th scope="col">Flow</th><th scope="col" class="r-num">Calls</th><th scope="col" class="r-num">MUST</th><th scope="col" class="r-num">MAY</th><th scope="col" class="r-num">UNKNOWN</th></tr></thead>
    <tbody>{shown.map(e => <FlowRow ctx={ctx} e={e} />)}</tbody></table>
    {rows.length > 40 ? <p class="r-empty">{"The strongest 40 of " + rows.length.toString() + " flows."}</p> : empty()}</div>;
}

export function GraphPage(ctx: Ctx): string {
  const ix = ctx.ix;
  const imports = moduleGraph(ix, "imports", "gi-", "");
  const calls = moduleGraph(ix, "calls", "gc-", "");
  const body = <>
    <PageHead eyebrow={<>Graph</>} title="Module graph" lead="Left to right: a module sits to the left of the modules it uses. Scroll or drag the figure; the nodes are links." />
    <Legend />
    {Section("imports", "Imports", plural(imports.drawn, "import", "imports") + " drawn, " + imports.implied.toString() + " more are implied by longer paths and left out. All imports are listed on the module pages.",
      Figure("Module imports", imports.svg, true))}
    {Section("calls", "Call flow", "The " + calls.drawn.toString() + " strongest of " + calls.total.toString() + " flows of CALLS between modules. A thicker line means more call sites; the line style is the evidence of the calls (solid: at least one MUST, dashed: only MAY, dotted: only UNKNOWN). Hover a line for the counts; the table lists every flow.",
      <>{Figure("Module call flow", calls.svg, true)}<FlowTable ctx={ctx} /></>)}
  </>;
  return document(<Frame ctx={ctx} active="graph" title="Graph" body={body} />);
}

// ---- symbol index -------------------------------------------------------------------------------------------------------------

function KindOption(kind: string): Html {
  return <option value={kind}>{kind}</option>;
}

export function SymbolsPage(ctx: Ctx): string {
  const ix = ctx.ix;
  const rows = pageNodes(ix);
  let kinds: string[] = [];
  for (const i of rows) {
    const k = ix.snap.nodes[i].kind;
    let have = false;
    for (const x of kinds) {
      if (x == k) {
        have = true;
      }
    }
    if (!have) {
      kinds.push(k);
    }
  }
  kinds = kinds.sort((a: string, b: string): int => strCmp(a, b));
  const body = <>
    <PageHead eyebrow={<>Index</>} title="Symbols" lead={plural(rows.length.toInt(), "symbol", "symbols") + " with a page; fields, variants and contract clauses are listed on their owner's page."} />
    <div class="ex-filter" id="ex-filter" hidden>
      <label class="r-sr" for="ex-q">Filter symbols</label>
      <input type="search" id="ex-q" placeholder="Filter by name, e.g. checkout or analysis::" autocomplete="off" />
      <label class="r-sr" for="ex-k">Kind</label>
      <select id="ex-k"><option value="">All kinds</option>{kinds.map(k => <KindOption kind={k} />)}</select>
      <span class="ex-count" id="ex-count" aria-live="polite"></span>
    </div>
    <SymTable ctx={ctx} rows={rows} showModule={true} caption="All symbols" />
  </>;
  return document(<Frame ctx={ctx} active="symbols" title="Symbols" body={body} />);
}

// ---- module page ------------------------------------------------------------------------------------------------------------

function ModChip(ctx: Ctx, m: usize): Html {
  return <li><a class="ex-chip" href={modHref(ctx, m)}>{ctx.ix.mods[m].name}</a></li>;
}

function ModChips(ctx: Ctx, ms: usize[], none: string): Html {
  return ms.length == 0 ? Empty(none) : <ul class="ex-chips">{ms.map(m => <ModChip ctx={ctx} m={m} />)}</ul>;
}

export function ModulePage(ctx: Ctx, mi: usize): string {
  const ix = ctx.ix;
  const m = ix.mods[mi];
  let modId = "";
  let rows: usize[] = [];
  let i: usize = 0;
  while (i < ix.snap.nodes.length) {
    const s = ix.snap.nodes[i];
    if (s.kind == "Module" && s.name == m.name) {
      modId = s.id;
    }
    i += 1;
  }
  i = 0;
  while (i < ix.snap.nodes.length) {
    const s = ix.snap.nodes[i];
    if (ix.page[i] == i && s.module == m.name && s.owner == modId) {
      rows.push(i);
    }
    i += 1;
  }
  const cards: Card[] = [
    card("Symbols", m.symbols.toString(), Some(m.exported.toString() + " exported"), None),
    card("Contracts", m.contracts.toString(), None, None),
    card("Effectful", m.effectful.toString(), Some("functions that may perform an effect"), None),
    card("Documented", percent(m.documented, m.symbols), Some(m.documented.toString() + " of " + m.symbols.toString()), None),
  ];
  const body = <>
    <PageHead eyebrow={<><a href="../index.html">{ix.snap.pkg}</a> / module</>} title={m.name} lead="" />
    <CardGrid cards={cards} />
    {Section("deps", "Dependencies", "", <div class="ex-two">
      <div><h3>Imports</h3>{ModChips(ctx, m.importsOut, "Imports no other module.")}</div>
      <div><h3>Imported by</h3>{ModChips(ctx, m.importsIn, "Not imported by another module.")}</div>
    </div>)}
    {Section("symbols", "Symbols", "Top-level declarations of the module.", <SymTable ctx={ctx} rows={rows} showModule={false} caption={"Symbols of " + m.name} />)}
  </>;
  return document(<Frame ctx={ctx} active={"m:" + m.slug} title={m.name} body={body} />);
}

// ---- symbol page ---------------------------------------------------------------------------------------------------------------

function ContractItem(s: Sym): Html {
  return <li><span class="ex-contract-kind">{s.name}</span><code>{s.sig}</code></li>;
}

function EffectRow(ctx: Ctx, e: Rel): Html {
  const unknown = e.dst == "~unknown";
  const op = unknown ? "unknown (" + e.via + ")" : (e.dst.startsWith("~io:") ? e.dst.substring(4, e.dst.length) : e.dst);
  return <tr>
    <th scope="row"><code>{op}</code></th>
    <td>{unknown ? "" : e.via}</td>
    <td><EvBadge ev={e.ev} /></td>
    <td>{e.next.length > 0 ? <IdLink ctx={ctx} id={e.next} /> : <span class="ex-muted">performed here or through library code</span>}</td>
    <td><Loc file={e.file} line={e.line} /></td>
  </tr>;
}

function NbRow(ctx: Ctx, nb: Nb, root: string): Html {
  return <tr>
    <th scope="row">{nb.node == NONE ? <span class="ex-sym ex-gone">function value</span> : <SymLink ctx={ctx} i={nb.node} label={nb.label} />}</th>
    <td><KindBadge kind={nb.kind} /></td>
    <td><EvBadge ev={nb.ev} /></td>
    <td class="r-num">{nb.count.toString()}</td>
    <td><span class="ex-loc">{nb.site}</span></td>
  </tr>;
}

function CallTable(ctx: Ctx, nbs: Nb[], caption: string, none: string): Html {
  return nbs.length == 0 ? Empty(none) : <div class="r-table-wrap ex-table" role="region" aria-label={caption} tabindex={0}>
    <table class="r-table">
      <caption>{caption}</caption>
      <thead><tr><th scope="col">Symbol</th><th scope="col">Kind</th><th scope="col">Evidence</th><th scope="col" class="r-num">Sites</th><th scope="col">First site</th></tr></thead>
      <tbody>{nbs.map(nb => <NbRow ctx={ctx} nb={nb} root={ctx.root} />)}</tbody>
    </table>
  </div>;
}

function MemberRow(ctx: Ctx, i: usize): Html {
  const s = ctx.ix.snap.nodes[i];
  return <tr>
    <th scope="row">{ctx.ix.page[i] == i ? <SymLink ctx={ctx} i={i} label={s.name} /> : <span class="ex-sym">{s.name}</span>}</th>
    <td><KindBadge kind={s.kind} /></td>
    <td class="ex-sig-cell"><code>{clip(s.sig, 140)}</code></td>
    <td>{summaryOf(s.doc)}</td>
  </tr>;
}

function typeRefs(ix: Ix, i: usize, incoming: bool): usize[] {
  let seen = new Map<string, bool>();
  let r: usize[] = [];
  for (const e of incoming ? ix.inn[i] : ix.out[i]) {
    const ed = ix.snap.edges[e];
    if (ed.kind != "REFERENCES_TYPE") {
      continue;
    }
    const o = ix.byId.get(incoming ? ed.src : ed.dst);
    if (o.isNone()) {
      continue;
    }
    const p = ix.page[o.unwrap()];
    if (p == NONE || p == i || seen.has(p.toString())) {
      continue;
    }
    seen.set(p.toString(), true);
    r.push(p);
  }
  return r;
}

function RefChip(ctx: Ctx, i: usize): Html {
  return <li><a class="ex-chip" href={symHref(ctx, i)}>{lastSegment(ctx.ix.snap.nodes[i].id)}</a></li>;
}

function RefChips(ctx: Ctx, refs: usize[], none: string): Html {
  const shown = refs.length > 40 ? refs.slice(0, 40) : refs;
  return refs.length == 0 ? Empty(none)
    : <><ul class="ex-chips">{shown.map(r => <RefChip ctx={ctx} i={r} />)}</ul>{refs.length > 40 ? <p class="ex-muted">{"and " + (refs.length - 40).toString() + " more"}</p> : empty()}</>;
}

export function SymbolPage(ctx: Ctx, i: usize): string {
  const ix = ctx.ix;
  const s = ix.snap.nodes[i];
  const callers = neighbours(ix, i, true);
  const callees = neighbours(ix, i, false);
  let effects: Rel[] = [];
  for (const e of ix.out[i]) {
    if (ix.snap.edges[e].kind == "MAY_PERFORM") {
      effects.push(ix.snap.edges[e]);
    }
  }
  let contracts: Sym[] = [];
  let members: usize[] = [];
  for (const k of ix.kids[i]) {
    const ks = ix.snap.nodes[k];
    if (ks.kind == "Contract") {
      contracts.push(ks);
    } else if (ks.kind == "Field" || ks.kind == "Variant" || isPageKind(ks.kind)) {
      members.push(k);
    }
  }
  const mi = ix.modNode.get(s.module);
  const owner = ix.byId.get(s.owner);
  const ownerLink = owner.isSome() && ix.page[owner.unwrap()] == owner.unwrap()
    ? <> / <SymLink ctx={ctx} i={owner.unwrap()} label={ix.snap.nodes[owner.unwrap()].name} /></> : <></>;
  const eyebrow = <><a href={ctx.root + "index.html"}>{ix.snap.pkg}</a> / {mi.isSome() ? <a href={modHref(ctx, mi.unwrap())}>{s.module}</a> : <span>{s.module}</span>}{ownerLink}</>;
  const cards: Card[] = [
    card("Callers", callers.length.toString(), None, None),
    card("Callees", callees.length.toString(), None, None),
    card("Contracts", contracts.length.toString(), None, None),
    card("Effects", effects.length.toString(), Some(effects.length == 0 ? "pure as far as the analysis sees" : "it may perform"), None),
  ];
  const ego = egoGraph(ix, i, "ego-");
  const uses = typeRefs(ix, i, false);
  const usedBy = typeRefs(ix, i, true);
  const body = <>
    <PageHead eyebrow={eyebrow} title={s.name} lead="" />
    <p class="ex-meta"><KindBadge kind={s.kind} />
      {s.exported ? <> <Flag text="exported" tip="part of the module's public surface" /></> : empty()}
      {s.entry ? <> <Flag text="entry point" tip="main, an exported function or an exported public method" /></> : empty()}
      {s.file.length > 0 ? <> <Loc file={s.file} line={s.line} /></> : empty()}</p>
    <pre class="ex-sig"><code>{s.sig}</code></pre>
    <CardGrid cards={cards} />
    {Section("doc", "Documentation", "", s.doc.length > 0 ? <DocView doc={s.doc} /> : Empty("No documentation comment. Write a /** ... */ comment directly above the declaration."))}
    {contracts.length > 0 ? Section("contracts", "Contracts", "Clauses written on the declaration; the compiler checks them when it can prove them, otherwise they are checked at run time.",
      <ul class="ex-contracts">{contracts.map(c => <ContractItem s={c} />)}</ul>) : empty()}
    {effects.length > 0 ? Section("effects", "Effects", "What this symbol may perform, transitively. MUST: a primitive call in its own body; MAY: inherited through a callee, a closure or an implementation.",
      <div class="r-table-wrap ex-table" role="region" aria-label="Effects" tabindex={0}><table class="r-table">
        <thead><tr><th scope="col">Effect</th><th scope="col">Direction</th><th scope="col">Evidence</th><th scope="col">Inherited from</th><th scope="col">Site</th></tr></thead>
        <tbody>{effects.map(e => <EffectRow ctx={ctx} e={e} />)}</tbody></table></div>) : empty()}
    {members.length > 0 ? Section("members", "Members", "", <div class="r-table-wrap ex-table" role="region" aria-label="Members" tabindex={0}><table class="r-table">
        <thead><tr><th scope="col">Name</th><th scope="col">Kind</th><th scope="col">Signature</th><th scope="col">Summary</th></tr></thead>
        <tbody>{members.map(m => <MemberRow ctx={ctx} i={m} />)}</tbody></table></div>) : empty()}
    {Section("calls", "Calls", "Callers on the left, callees and effects on the right. Solid lines are MUST calls, dashed MAY, dotted UNKNOWN.",
      <>{ego.isSome() ? Figure("Call neighbourhood", ego.unwrap(), false) : Empty("No calls in or out.")}
        <div class="ex-stack">
          <div><h3>Callers</h3>{CallTable(ctx, callers, "Callers", "Nothing in the snapshot calls this symbol.")}</div>
          <div><h3>Callees</h3>{CallTable(ctx, callees, "Callees", "This symbol calls nothing that the snapshot resolves.")}</div>
        </div></>)}
    {uses.length + usedBy.length > 0 ? Section("types", "Type references", "", <div class="ex-two">
      <div><h3>Mentions</h3>{RefChips(ctx, uses, "Mentions no other type.")}</div>
      <div><h3>Mentioned by</h3>{RefChips(ctx, usedBy, "Not mentioned elsewhere.")}</div></div>) : empty()}
  </>;
  return document(<Frame ctx={ctx} active={mi.isSome() ? "m:" + ix.mods[mi.unwrap()].slug : ""} title={s.name} body={body} />);
}
