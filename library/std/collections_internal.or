// std:collections/internal -- the helper functions and node types behind std:collections (ADR-0048 rule 7.3). NOT API.
//
// Everything here exists because a contract has to be able to call it: the loop-based predicates the class invariants of
// `IntSet`, `SortedMap`, `SortedStringMap` and `PriorityQueue` are made of (no closures, no recursion: ADR-0030 section 3),
// and the B-tree shape, order and counting checks the sorted maps assert after every public method. The language has no
// visibility between "private to the file" and "exported", so they are exported from this module, which user code does not
// import; the loader may warn about such an import once ADR-0047's library layout is in place. Names and signatures here
// can change in any release. The B-tree helpers are generated from tools/sorted_map.tmpl by tools/gen_sorted_map.py.
//
// What `std:collections` is made of is documented in docs/std.md.

// allTrue(xs): bool -- every element is true. Loop-based (contracts cannot use `every`).
export function allTrue(xs: bool[]): bool {
  let i: usize = 0;
  while (i < xs.length) {
    if (!xs[i]) {
      return false;
    }
    i += 1;
  }
  return true;
}

// isStrictlyIncreasing(xs): bool -- xs[0] < xs[1] < ... (so sorted and without duplicates).
export function isStrictlyIncreasing(xs: int[]): bool {
  let i: usize = 1;
  while (i < xs.length) {
    if (xs[i - 1] >= xs[i]) {
      return false;
    }
    i += 1;
  }
  return true;
}

// compareBytewise(a, b): int -- -1, 0 or 1; byte-wise lexicographic order (shorter prefix first), the order of
// `SortedStringMap` (the public spelling is `std:collections.compareStrings`). O(min(a.length, b.length)).
@Ensures(result >= -1 && result <= 1)
@Ensures((result == 0) == (a.length == b.length && !differsAt(a, b)))
export function compareBytewise(a: string, b: string): int {
  const n = a.length < b.length ? a.length : b.length;
  let i: usize = 0;
  while (i < n) {
    const x = a.charCodeAt(i);
    const y = b.charCodeAt(i);
    if (x < y) {
      return -1;
    }
    if (x > y) {
      return 1;
    }
    i += 1;
  }
  if (a.length < b.length) {
    return -1;
  }
  if (a.length > b.length) {
    return 1;
  }
  return 0;
}

// Does some byte inside the common length differ?
function differsAt(a: string, b: string): bool {
  const n = a.length < b.length ? a.length : b.length;
  let i: usize = 0;
  while (i < n) {
    if (a.charCodeAt(i) != b.charCodeAt(i)) {
      return true;
    }
    i += 1;
  }
  return false;
}

// isStrictlyIncreasingStrings(xs): bool -- compareBytewise(xs[i-1], xs[i]) < 0 for all i.
export function isStrictlyIncreasingStrings(xs: string[]): bool {
  let i: usize = 1;
  while (i < xs.length) {
    if (compareBytewise(xs[i - 1], xs[i]) >= 0) {
      return false;
    }
    i += 1;
  }
  return true;
}


// ---------------------------------------------------------------------------------------------- priority queue

// Does the entry (p1, s1) leave before (p2, s2)? Lower priority first; equal priorities by insertion number.
export function leavesBefore(p1: int, s1: int, p2: int, s2: int): bool {
  return p1 < p2 || (p1 == p2 && s1 < s2);
}

// isMinHeap4(prios, seqs): bool -- every entry leaves strictly before its up to four children (children of i are
// 4i+1 .. 4i+4, parent of i is (i-1)/4). Loop-based.
export function isMinHeap4(prios: int[], seqs: int[]): bool {
  if (prios.length != seqs.length) {
    return false;
  }
  let i: usize = 1;
  while (i < prios.length) {
    const p = (i - 1) / 4;
    if (!leavesBefore(prios[p], seqs[p], prios[i], seqs[i])) {
      return false;
    }
    i += 1;
  }
  return true;
}

// Are all insertion numbers in 0..bound-1?
export function seqsBelow(seqs: int[], bound: int): bool {
  let i: usize = 0;
  while (i < seqs.length) {
    if (seqs[i] < 0 || seqs[i] >= bound) {
      return false;
    }
    i += 1;
  }
  return true;
}

