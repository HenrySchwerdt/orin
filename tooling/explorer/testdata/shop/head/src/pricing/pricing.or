/**
 * Price of `qty` items at `unit` cents each.
 *
 * Quantities are never negative; the result is exact (no rounding).
 *
 * @param qty number of items
 * @param unit price of one item in cents
 * @returns the total in cents
 */
@Requires(qty >= 0)
@Requires(unit >= 0)
@Ensures(result >= 0)
export function total(qty: int, unit: int): int {
  return qty * unit;
}

/** Applies a percentage rebate (renamed from discount). */
export function rebate(cents: int, percent: int): int {
  return cents - cents * percent / 100;
}
