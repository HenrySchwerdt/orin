import { Graph } from "std:graph";

function main(): void {
  let g = new Graph<string>(3);
  const a = g.add("first");
  g.remove(a).unwrap();
  const b = g.add("second");
  // The slot is reused, but the old id stays stale because the generation moved on.
  console.log(g.get(b).unwrap());
  console.log(g.get(a).isErr().toString());
  console.log(g.contains(a).toString() + " " + g.contains(b).toString());
  console.log((a.index == b.index).toString());
  console.log((a.gen != b.gen).toString());
  console.log(g.size().toString());
  g.remove(b).unwrap();
  const c = g.add("third");
  console.log(g.get(b).isErr().toString() + " " + g.get(c).unwrap());
}
