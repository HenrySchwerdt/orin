// A class value stored in a record; mutation through the record path.
class Meter {
  constructor(public reading: int) {}
  tick(): void {
    this.reading += 5;
  }
}

type Station = { name: string; meter: Meter; };

function main(): void {
  let s = Station { name: "alpha", meter: new Meter(0) };
  const old = s;
  s.meter.tick();
  s.meter.tick();
  console.log(s.name + " " + s.meter.reading.toString() + " " + old.meter.reading.toString());
  const moved = Station { ...s, name: "beta" };
  s.meter.tick();
  console.log(moved.name + " " + moved.meter.reading.toString() + " " + s.meter.reading.toString());
}
