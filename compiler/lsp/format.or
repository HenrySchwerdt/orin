// Formatter hook for `textDocument/formatting`.
//
// HOOK (lead): `compiler/fmt` is being built by another worker. When it lands, change the body of
// `formatAvailable` to `true` and `formatDocument` to call it, e.g.
//
//   import { formatSource } from "../fmt";
//   export function formatDocument(text: string): Result<string, string> { return formatSource(text); }
//
// The server advertises `documentFormattingProvider` only when `formatAvailable()` is true.
// `Err(msg)` (e.g. the file has syntax errors; fmt leaves such files untouched) becomes a
// `RequestFailed` error response.

export function formatAvailable(): bool {
  return false;
}

export function formatDocument(text: string): Result<string, string> {
  return Err("formatter not available");
}
