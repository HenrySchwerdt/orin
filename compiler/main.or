// orin — the self-hosted Orin compiler driver (Stage 1+).
//   orin check [--format=json] [--deps] [--strict-contracts] <entry.or | package-dir>
//   orin api [--check <snapshot>] <entry.or | package-dir>   public API snapshot / change detection
//   orin graph <entry.or | package-dir> [-o out.json]   OSIG snapshot (docs/osig.md)
//   orin diff --base <dir|.or|.json> --head <dir|.or|.json> [--format=json|text|html]   OSIG diff report
//   orin compile [--format=json] <entry.or> -o <out.c> [--no-verify] [--c-builtins] [--check-contracts] [--strict-contracts]
//       default pipeline: HIR -> MIR -> ownership verifier -> C (--backend=llvm: LLVM IR, -o x.ll)
//   orin fmt [--check] [--stdout] <file.or>...
//   orin lsp                 language server on stdio (spec 18)
//   orin mcp [--root <dir>] [--allow-exec] [--repo <dir>]   MCP server on stdio (spec 10)
//   orin test [--filter S] [--format=json] [--runtime DIR] [--cc CMD] <entry.or | package-dir>   run the @Test functions (docs/testing.md)
//   orin mir <entry.or>      print the MIR
//   orin verify --contracts [--format=json] [--z3 PATH] [--strict] <entry.or>   verify contracts with z3 (docs/contracts.md)
//   orin verify <entry.or>   run the MIR ownership verifier (errors and warning count)
//   (compile/mir/verify run the MIR optimiser, compiler/opt, unless --no-opt is given)
//   compile/mir/verify load the std prelude (std/, spec 19 R1) implicitly: moved built-ins call
//   Orin code. --c-builtins skips it and keeps the C runtime path.

import { Host, useHost } from "std:host";
import { FsGrant } from "std:fs";
import { ProcessGrant, args, exit } from "std:process";
import { StdioGrant } from "std:io";
import { writeFile } from "std:fs";
import { SourceMap, Diagnostic, render } from "./diag";
import { loadWithRoots, preludeRoots, noPreludeRoots } from "./loader";
import { SourceFile } from "./diag";
import { check, checkWithIndex, checkRuntime, deprecationWarnings, hasDeprecated, qualityWarnings, strictContracts } from "./check";
import { runTestCommand, hasTests, eraseTests } from "./testing";
import { LoadedProgram } from "./loader";
import { verifyContracts, reportJson, reportText, failedCount, unknownCount } from "./vc";
import { moduleDeps, depsText, depsJsonText, apiSnapshot, apiDiff, runGraph, runDiff } from "./analysis";
import { readFile } from "std:fs";
import { lower } from "./lower";
import { emitC } from "./cemit";
import { emitLlvm } from "./llvm";
import { MProgram, printProgram } from "./mir";
import { verify } from "./verify";
import { optimize, pruneProgram } from "./opt";
import { runFmt, printDiagnosticsJson } from "./tools";
import { runLsp } from "./lsp";
import { runMcp } from "./mcp";

function usage(): void {
  console.error("usage:\n  orin check [--format=json] [--deps] [--strict-contracts] <entry.or | package-dir>\n  orin api [--check <snapshot>] <entry.or | package-dir>\n  orin graph <entry.or | package-dir> [-o out.json]\n  orin diff --base <dir|.or|.json> --head <dir|.or|.json> [--format=json|text|html] [--link-base <url>] [-o out] [--exit-code]\n  orin compile [--format=json] <entry.or> -o <out.c> [--no-verify] [--no-opt] [--c-builtins] [--backend=c|llvm] [--check-contracts] [--strict-contracts]\n  orin fmt [--check] [--stdout] <file.or>...\n  orin lsp\n  orin mcp [--root <dir>] [--allow-exec] [--repo <dir>]\n  orin test [--filter <substring>] [--format=json] [--runtime <dir>] [--cc <cmd>] <entry.or | package-dir>\n  orin mir <entry.or>\n  orin verify [--contracts [--format=json] [--z3 PATH] [--strict]] <entry.or>");
  exit(2);
}

function report(sm: SourceMap, diags: Diagnostic[], json: bool): void {
  if (json) {
    printDiagnosticsJson(sm, diags);
    exit(1);
    return;
  }
  for (const d of diags) {
    console.error(render(sm, d));
  }
  exit(1);
}

// Prints the warnings of the program without failing: `@Deprecated` uses (ADR-0024) and contract-quality
// warnings (ADR-0028; the strict ones when `strictFlag` or `[contracts] strict = true` is set), to stderr as
// text, or as JSON objects on stdout with --format=json.
function printWarnings(program: LoadedProgram, sm: SourceMap, json: bool, strictFlag: bool): void {
  let ws: Diagnostic[] = [];
  if (hasDeprecated(program)) {
    ws = deprecationWarnings(program, checkWithIndex(program, sm).index);
  }
  ws = ws.concat(qualityWarnings(program, sm, strictContracts(program, strictFlag)));
  if (ws.length == 0) {
    return;
  }
  if (json) {
    printDiagnosticsJson(sm, ws);
    return;
  }
  for (const d of ws) {
    console.error(render(sm, d));
  }
}

// Runs the verifier; prints errors (and warnings when `verbose`). Returns the error count.
function runVerify(prog: MProgram, verbose: bool): usize {
  const rep = verify(prog);
  for (const d of rep.errors) {
    console.error("verify error: " + d.func + " b" + d.block.toString() + " i" + d.instr.toString() + ": " + d.message);
  }
  if (verbose) {
    for (const d of rep.warnings) {
      console.log("warning: " + d.func + " b" + d.block.toString() + " i" + d.instr.toString() + ": " + d.message);
    }
    console.log("verify: " + rep.errors.length.toString() + " errors, " + rep.warnings.length.toString() + " warnings");
  }
  return rep.errors.length;
}

// The compiler needs the whole file system (it reads sources and writes C / LLVM IR next to them), the process grant
// (`orin test`, `orin mcp` and `orin verify --contracts` run the C compiler and the solver; every command reads its
// arguments) and stdio (`orin lsp`, `orin mcp`); it does not use the clock. The grants come from the host policy
// (ORIN_DENY, ADR-0027).
function main(host: Host): void {
  useHost(host, (fs, proc, stdio, clock) => { driver(fs, proc, stdio); });
}

function driver(fs: FsGrant, proc: ProcessGrant, stdio: StdioGrant): void {
  const all = args(proc);
  if (all.length >= 1 && all[0] == "fmt") {
    const code = runFmt(fs, all.slice(1, all.length));
    if (code != 0) {
      exit(code);
    }
    return;
  }
  if (all.length >= 1 && all[0] == "graph") {
    exit(runGraph(fs, all.slice(1, all.length)));
    return;
  }
  if (all.length >= 1 && all[0] == "diff") {
    exit(runDiff(fs, all.slice(1, all.length)));
    return;
  }
  if (all.length >= 1 && all[0] == "lsp") {
    exit(runLsp(fs, stdio));
    return;
  }
  if (all.length >= 1 && all[0] == "test") {
    exit(runTestCommand(fs, proc, all.slice(1, all.length)));
    return;
  }
  if (all.length >= 1 && all[0] == "mcp") {
    exit(runMcp(fs, proc, stdio, all.slice(1, all.length)));
    return;
  }
  let json = false;
  let noVerify = false;
  let noOpt = false;
  let llvm = false;
  let cBuiltins = false;
  let checkContracts = false;
  let verifyContractsFlag = false;
  let strict = false;
  let strictContractsFlag = false;
  let z3 = "z3";
  let expectZ3 = false;
  let deps = false;
  let checkSnap = "";
  let haveSnap = false;
  let argv: string[] = [];
  let ai: usize = 0;
  while (ai < all.length) {
    const a = all[ai];
    ai += 1;
    if (expectZ3) {
      z3 = a;
      expectZ3 = false;
    } else if (a == "--z3") {
      expectZ3 = true;
    } else if (a == "--contracts") {
      verifyContractsFlag = true;
    } else if (a == "--strict") {
      strict = true;
    } else if (a == "--strict-contracts") {
      strictContractsFlag = true;
    } else if (a == "--check-contracts") {
      checkContracts = true;
    } else if (a == "--deps") {
      deps = true;
    } else if (a == "--check") {
      if (ai >= all.length) {
        usage();
        return;
      }
      checkSnap = all[ai];
      haveSnap = true;
      ai += 1;
    } else if (a == "--format=json") {
      json = true;
    } else if (a == "--no-verify") {
      noVerify = true;
    } else if (a == "--no-opt") {
      noOpt = true;
    } else if (a == "--backend=llvm") {
      llvm = true;
    } else if (a == "--backend=c") {
      llvm = false;
    } else if (a == "--c-builtins") {
      cBuiltins = true;
    } else {
      argv.push(a);
    }
  }
  if (argv.length < 2) {
    usage();
    return;
  }
  const cmd = argv[0];
  const entry = argv[1];
  const isCompile = cmd == "compile";
  if (!isCompile && cmd != "check" && cmd != "mir" && cmd != "verify" && cmd != "api") {
    usage();
    return;
  }
  if (isCompile && (argv.length < 4 || argv[2] != "-o")) {
    usage();
    return;
  }
  const usePrelude = !cBuiltins && cmd != "check" && cmd != "api";
  const noOverlay: SourceFile[] = [];
  const loaded = loadWithRoots(fs, entry, noOverlay, usePrelude ? preludeRoots() : noPreludeRoots());
  if (loaded.diags.length > 0) {
    report(loaded.sm, loaded.diags, json);
    return;
  }
  let program = loaded.program.unwrap();
  if (cmd == "api") {
    const ci = checkWithIndex(program, loaded.sm);
    if (ci.result.isErr()) {
      report(loaded.sm, ci.result.unwrapErr(), json);
      return;
    }
    const snap = apiSnapshot(program, ci.index);
    if (!haveSnap) {
      console.log(snap.substring(0, snap.length - 1));
      return;
    }
    const old = readFile(fs, checkSnap);
    if (old.isErr()) {
      console.error("error: cannot read " + checkSnap + ": " + old.unwrapErr());
      exit(2);
      return;
    }
    if (old.unwrap() == snap) {
      console.log("api unchanged");
      return;
    }
    console.error("error: public API changed (compared with " + checkSnap + "):");
    for (const l of apiDiff(old.unwrap(), snap)) {
      console.error(l);
    }
    exit(1);
    return;
  }
  const withTests = cmd != "check" && hasTests(program);
  if (withTests) {
    // `@Test` functions are checked like everything else (so they cannot rot) but erased from the
    // program that is lowered: nothing they use reaches the output (ADR-0024).
    const full = check(program, loaded.sm);
    if (full.isErr()) {
      report(loaded.sm, full.unwrapErr(), json);
      return;
    }
    printWarnings(program, loaded.sm, json && !verifyContractsFlag, strictContractsFlag);
    program = eraseTests(program);
  }
  const checked = checkContracts ? checkRuntime(program, loaded.sm) : check(program, loaded.sm);
  if (checked.isErr()) {
    report(loaded.sm, checked.unwrapErr(), json);
    return;
  }
  if (!withTests) {
    printWarnings(program, loaded.sm, json && !verifyContractsFlag, strictContractsFlag);
  }
  if (cmd == "check") {
    if (deps) {
      const md = moduleDeps(program);
      const text = json ? depsJsonText(program, md) : depsText(program, md);
      console.log(text.substring(0, text.length - 1));
    }
    return;
  }
  if (cmd == "mir") {
    console.log(printProgram(noOpt ? lower(checked.unwrap()) : optimize(lower(checked.unwrap()))));
    return;
  }
  if (cmd == "verify" && verifyContractsFlag) {
    const rep = verifyContracts(fs, proc, program, loaded.sm, z3);
    console.log(json ? reportJson(rep) : reportText(rep));
    if (failedCount(rep) > 0 || (strict && unknownCount(rep) > 0)) {
      exit(1);
    }
    return;
  }
  if (cmd == "verify") {
    if (runVerify(noOpt ? lower(checked.unwrap()) : optimize(lower(checked.unwrap())), true) > 0) {
      exit(1);
    }
    return;
  }
  let c = "";
  const mir = noOpt ? lower(checked.unwrap()) : optimize(lower(checked.unwrap()));
  if (!noVerify && runVerify(mir, false) > 0) {
    console.error("error: internal compiler error: MIR ownership verification failed");
    exit(70);
    return;
  }
  c = llvm ? emitLlvm(pruneProgram(mir)) : emitC(pruneProgram(mir));
  const written = writeFile(fs, argv[3], c);
  if (written.isErr()) {
    console.error("error: cannot write " + argv[3] + ": " + written.unwrapErr());
    exit(1);
  }
}
