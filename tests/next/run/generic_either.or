type Either<A, B> = Left(A) | Right(B);

function flip<A, B>(e: Either<A, B>): Either<B, A> {
  return match (e) {
    Left(a) => Right(a),
    Right(b) => Left(b),
  };
}

function lefts<A, B>(es: Either<A, B>[]): A[] {
  let out: A[] = [];
  for (const e of es) {
    match (e) {
      Left(a) => { out.push(a); },
      Right(_) => {},
    }
  }
  return out;
}

function show(e: Either<int, string>): string {
  return match (e) {
    Left(n) => "L" + n.toString(),
    Right(s) => "R" + s,
  };
}

function main(): void {
  const e: Either<int, string> = Left(1);
  const f: Either<int, string> = Right("x");
  console.log(show(e) + show(f));
  const g = flip(e);
  console.log(match (g) { Left(s) => s, Right(n) => n.toString() });
  const es: Either<int, string>[] = [e, f, Left(5)];
  console.log(lefts(es).length.toString());
  console.log(lefts(es)[1].toString());
}
