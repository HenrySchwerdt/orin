function show(b: bool): void {
  console.log(b.toString());
}

function main(): void {
  show(1 < 2);
  show(2 < 1);
  show(3 <= 3);
  show(4 > 4);
  show(5 >= 5);
  show(-1 < 0);
  const u: usize = 3;
  show(u < 4);
  show(u == 3);
  show(u != 3);
  show("abc" == "abc");
  show("abc" == "abd");
  show("" == "");
  show("a" != "b");
  show(true == true);
  show(true != false);
  show(false == true);
  const s1 = "ab";
  const s2 = "a" + "b";
  show(s1 == s2);
}
