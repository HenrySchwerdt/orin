// Closure inlining and fusion (ADR-0038 §2, compiler/fuse): the chains that must NOT be fused keep their meaning. Every line
// below would print something different (or in a different order) if the pass fused what it must not.
function twice(x: int): int {
  return x * 2;
}

function start(): int {
  console.log("start");
  return 1000;
}

function main(): void {
  const xs = [1, 2, 3, 4];
  // a function value that is not a literal: called through the value
  const f = (x: int) => x + 100;
  let g = f;
  console.log(xs.map(g).filter(x => x > 101).map(x => x.toString()).join(","));
  // a named function is a literal: fused (same result)
  console.log(xs.map(twice).reduce((a, b) => a + b, 0).toString());
  // an intermediate result used twice: computed once, then two chains read it
  const evens = xs.map(x => x * 2);
  console.log(`${evens.filter(x => x > 4).length} ${evens.reduce((a, b) => a + b, 0)}`);
  // sort is a barrier: the part before it and the part after it are separate chains
  const sorted = xs.map(x => 10 - x).sort((a, b) => a - b).filter(x => x > 6);
  console.log(sorted.map(x => x.toString()).join(","));
  // an initial value with an effect: it prints after the stages ran (they print too), as written
  console.log(xs.map(x => {
    console.log(`stage ${x}`);
    return x + 1;
  }).reduce((a, b) => a + b, start()).toString());
  // closures with effects: `map` runs on every element before `filter` sees any
  const ys = xs.map(x => {
    console.log(`map ${x}`);
    return x;
  }).filter(x => {
    console.log(`keep ${x}?`);
    return x % 2 == 0;
  });
  console.log(ys.map(x => x.toString()).join(","));
  // an effect in the terminal only: the pure stages before it are still not reordered around it
  xs.filter(x => x > 2).forEach(x => {
    console.log(`each ${x}`);
  });
}
