// Several processors over one module (Http and Name over api), a second module with its own companion (other),
// annotation arguments of every kind (tags, arrays, Option, a module constant) and member annotations. The snapshots of
// the runs are checked by tools/test_expand.py (expected.input.jsonl).
import { listUsers, Profile, Service } from "./api";
import { routes, fieldNames, routeCount } from "./api.gen";
import { otherRoutes } from "./other.gen";

function main(): void {
  for (const r of routes()) {
    console.log(r);
  }
  for (const n of fieldNames()) {
    console.log(n);
  }
  console.log(routeCount().toString());
  console.log(otherRoutes().join(","));
  console.log(listUsers().length.toString());
}
