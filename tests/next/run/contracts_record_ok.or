// flags: --check-contracts
// Records with invariants that are respected: literals, spreads, field writes, nested records, arrays of records,
// a helper in the invariant and a function result; the invariant does not fire.
function ordered(lo: int, hi: int): bool {
  return lo <= hi;
}

@Invariant(ordered(this.lo, this.hi))
type Range = { lo: int; hi: int; };
@Invariant(this.span.hi - this.span.lo <= this.limit)
type Window = { span: Range; limit: int; };

function widen(w: Window, by: int): Window {
  let r = w.span;
  r.hi += by;
  return Window { span: r, limit: w.limit + by };
}

function main(): void {
  let w = Window { span: Range { lo: 0, hi: 2 }, limit: 5 };
  w.span.hi = 4;
  w.limit = 9;
  const v = widen(w, 3);
  let rs: Range[] = [Range { lo: 1, hi: 1 }];
  rs.push(Range { ...v.span, lo: 2 });
  rs[0].hi = 7;
  console.log(v.span.hi.toString() + " " + v.limit.toString() + " " + rs[1].lo.toString() + " " + rs[0].hi.toString());
}
