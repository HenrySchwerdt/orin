// Binary trees: allocate, walk and drop many complete trees (tagged union).
type Tree = Leaf | Node(Tree, Tree);

function make(d: int): Tree {
  if (d == 0) { return Node(Leaf, Leaf); }
  return Node(make(d - 1), make(d - 1));
}

function check(t: Tree): int {
  return match (t) {
    Leaf => 0,
    Node(l, r) => 1 + check(l) + check(r),
  };
}

function main(): void {
  const maxDepth = 16;
  const longLived = make(maxDepth);
  let total = 0;
  let d = 4;
  while (d <= maxDepth) {
    let iters = 1;
    let k = 0;
    while (k < 22 - d) { iters *= 2; k += 1; }
    let sum = 0;
    let i = 0;
    while (i < iters) { sum += check(make(d)); i += 1; }
    console.log("depth " + d.toString() + " trees " + iters.toString() + " check " + sum.toString());
    total += sum;
    d += 4;
  }
  console.log("long lived check " + check(longLived).toString());
  console.log("total " + total.toString());
}
