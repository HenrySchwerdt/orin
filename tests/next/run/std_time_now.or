import { nowMillis, between, toMillis, formatIso } from "std:time";

function main(): void {
  const a = nowMillis();
  const b = nowMillis();
  // 2023-11-14 .. 2100: the clock is sane and does not run backwards between two reads here.
  console.log((a > 1700000000000).toString());
  console.log((a < 4102444800000).toString());
  console.log((toMillis(between(a, b)) >= 0).toString());
  console.log((formatIso(a).length == 24).toString());
}
