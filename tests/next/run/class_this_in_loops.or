// `this` inside while / for-of loops of mutating and non-mutating methods.
class Acc {
  constructor(public total: int, public xs: int[]) {}
  addAll(): void {
    for (const x of this.xs) {
      this.total += x;
    }
  }
  fill(n: int): void {
    let i = 0;
    while (i < n) {
      this.xs.push(i * i);
      i += 1;
    }
  }
  sum(): int {
    let s = 0;
    for (const x of this.xs) {
      s += x;
    }
    return s;
  }
  firstOver(limit: int): int {
    let i: usize = 0;
    while (i < this.xs.length) {
      if (this.xs[i] > limit) {
        return this.xs[i];
      }
      i += 1;
    }
    return 0 - 1;
  }
}

function main(): void {
  let a = new Acc(0, []);
  a.fill(6);
  a.addAll();
  a.addAll();
  console.log(a.total.toString() + " " + a.sum().toString() + " " + a.xs.length.toString());
  console.log(a.firstOver(10).toString() + " " + a.firstOver(100).toString());
}
