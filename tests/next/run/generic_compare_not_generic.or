function id<T>(x: T): T {
  return x;
}

function main(): void {
  const a = 1;
  const b = 2;
  const c = 3;
  const d = 4;
  if (a < b) {
    console.log("a<b");
  }
  if (a < b && c > d) {
    console.log("no");
  } else {
    console.log("else");
  }
  const r = a < b;
  const s = c > (d);
  console.log(r.toString() + s.toString());
  console.log((a < id(b)).toString());
  console.log((id(a) < id(b)).toString());
  const t = a < b ? "yes" : "no";
  console.log(t);
}
