import { milliseconds, seconds, minutes, hours, days, toMillis, toSeconds, addDuration, durationBetween, instantAfter, formatDuration } from "std:time";

function main(): void {
  console.log(toMillis(seconds(2)).toString());
  console.log(toMillis(minutes(3)).toString());
  console.log(toMillis(hours(1)).toString());
  console.log(toMillis(days(1)).toString());
  console.log(toSeconds(milliseconds(1999)).toString());
  console.log(toSeconds(milliseconds(-1999)).toString());
  console.log(formatDuration(milliseconds(3723005)));
  console.log(formatDuration(milliseconds(0)));
  console.log(formatDuration(milliseconds(-1500)));
  console.log(formatDuration(addDuration(days(2), seconds(1))));
  console.log(formatDuration(durationBetween(1000, 61000)));
  console.log(instantAfter(1000, minutes(1)).toString());
  console.log(formatDuration(milliseconds(999)));
}
