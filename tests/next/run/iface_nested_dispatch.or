// An implementation that itself dispatches through an interface value (a decorator).
interface Source {
  next(): int;
}

class Const implements Source {
  constructor(public v: int) {}
  next(): int { return this.v; }
}

class Plus implements Source {
  constructor(public inner: Source, public k: int) {}
  next(): int { return this.inner.next() + this.k; }
}

class Twice implements Source {
  constructor(public inner: Source) {}
  next(): int { return this.inner.next() * 2; }
}

function main(): void {
  const s: Source = new Twice(new Plus(new Plus(new Const(1), 2), 3));
  console.log(s.next().toString());
  const t: Source = new Plus(s, 1);
  console.log(t.next().toString());
}
