import { parse, formatError } from "std:json";

function bad(s: string): void {
  match (parse(s)) {
    Ok(j) => { console.log("unexpectedly ok"); },
    Err(e) => {
      console.log(e.line.toString() + ":" + e.column.toString() + " @" + e.offset.toString() + " " + e.message);
    }
  }
}

function main(): void {
  bad("");
  bad("   ");
  bad("x");
  bad("[1, 2");
  bad("[1 2]");
  bad("[1,]");
  bad("{\"a\" 1}");
  bad("{\"a\": 1,}");
  bad("{a: 1}");
  bad("{\"a\": 1");
  bad("{\n  \"a\": 1,\n  \"b\": ?\n}");
  bad("[\n[\n[\n  oops");
  bad("nul");
  bad("true false");
  bad("\"abc");
  bad("\"a\\qb\"");
  bad("\"a\nb\"");
  bad("\"\\u12G4\"");
  bad("01");
  bad("-");
  bad("1.5");
  bad("[1e3]");
  bad("{\"a\":\r\n  \r\n  @}");
  match (parse("[1,\n 2,\n x]")) {
    Ok(j) => { console.log("?"); },
    Err(e) => { console.log(formatError(e)); }
  }
}
