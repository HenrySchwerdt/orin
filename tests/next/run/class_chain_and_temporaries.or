// Calls on temporaries and chains of non-mutating methods.
class Temp {
  constructor(public deg: int) {}
  plus(n: int): Temp {
    return new Temp(this.deg + n);
  }
  warm(): bool {
    return this.deg > 20;
  }
  text(): string {
    return this.deg.toString() + "C";
  }
}

function main(): void {
  console.log(new Temp(10).plus(5).plus(7).text());
  console.log(new Temp(1).plus(1).warm().toString());
}
