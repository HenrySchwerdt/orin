import { Input, Output, fn, named, ret, str, exportDecl, output } from "std:meta";

@Annotation(type)
export type Big = { };

// Pure, but its encoded output is larger than the 16 MiB limit: one string constant of 16 MiB.
@Processor(Big)
export function bigProc(input: Input): Output {
  let s = "xxxxxxxxxxxxxxxx";
  let i = 0;
  while (i < 20) {
    s = s + s;
    i += 1;
  }
  return output([exportDecl(fn("big", [], named("string"), [ret(str(s))]), true)]);
}
