import { parse, stringify, jsonErrorMessage } from "std:json/legacy";

function show(s: string): void {
  match (parse(s)) {
    Ok(j) => { console.log(stringify(j)); },
    Err(e) => { console.log(jsonErrorMessage(e)); }
  }
}

function main(): void {
  show("0");
  show("-0");
  show("123456789");
  show("9223372036854775807");
  show("-9223372036854775807");
  show("9223372036854775808");
  show("99999999999999999999");
  show("[1,-2,30]");
  show("1.0");
  show("2e5");
  show("-");
  show("007");
}
