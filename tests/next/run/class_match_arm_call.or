// Mutating calls inside match arms are scoped to their arm.
type Cmd = Inc | Add(int) | Reset;

class Reg {
  constructor(public v: int) {}
  inc(): void {
    this.v += 1;
  }
  add(n: int): void {
    this.v += n;
  }
  take(): int {
    const old = this.v;
    this.v = 0;
    return old;
  }
}

function run(cmds: Cmd[]): int {
  let r = new Reg(0);
  let out = 0;
  for (const c of cmds) {
    match (c) {
      Inc => r.inc(),
      Add(n) => r.add(n),
      Reset => { out += r.take(); }
    }
  }
  return out * 1000 + r.v;
}

function label(c: Cmd, r0: Reg): string {
  let r = r0;
  return match (c) {
    Inc => "inc",
    Add(n) => "add" + n.toString(),
    Reset => "reset"
  };
}

function main(): void {
  console.log(run([Inc, Inc, Add(5), Reset, Inc, Add(2)]).toString());
  console.log(label(Add(3), new Reg(0)));
}
