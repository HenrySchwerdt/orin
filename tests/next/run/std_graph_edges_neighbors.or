import { newGraph, add, addEdge, neighbors, get, remove, GraphId, Graph } from "std:graph";

function names(g: Graph<string>, xs: GraphId<string>[]): string {
  let out: string[] = [];
  for (const x of xs) {
    out.push(get(g, x).unwrap());
  }
  return out.join(",");
}

function main(): void {
  let g = newGraph<string>(9);
  const a = add(g, "a");
  g = a.graph;
  const b = add(g, "b");
  g = b.graph;
  const c = add(g, "c");
  g = c.graph;
  g = addEdge(g, a.id, b.id).unwrap();
  g = addEdge(g, a.id, c.id).unwrap();
  g = addEdge(g, b.id, a.id).unwrap();
  g = addEdge(g, c.id, c.id).unwrap();
  console.log(names(g, neighbors(g, a.id).unwrap()));
  console.log(names(g, neighbors(g, b.id).unwrap()));
  console.log(names(g, neighbors(g, c.id).unwrap()));
  g = addEdge(g, a.id, b.id).unwrap();
  console.log(names(g, neighbors(g, a.id).unwrap()));
  g = remove(g, b.id).unwrap();
  console.log(names(g, neighbors(g, a.id).unwrap()));
  // A new node reusing b's slot is not a neighbour of a: the edge recorded b's old generation.
  const d = add(g, "d");
  g = d.graph;
  console.log(names(g, neighbors(g, a.id).unwrap()));
  console.log(neighbors(g, d.id).unwrap().length.toString());
}
