// File helpers.

import { FsGrant, readFile, writeFile, exists, fsErrorMessage } from "std:fs";

// The contents of `path`, or "" when it cannot be read.
export function readOr(fs: FsGrant, path: string): string {
  const r = readFile(fs, path);
  if (r.isErr()) {
    return "";
  }
  return r.unwrap();
}

// True when `path` exists; a path the grant refuses to look at, or that cannot be examined, counts as absent.
export function existsOr(fs: FsGrant, path: string): bool {
  const r = exists(fs, path);
  return r.isOk() && r.unwrap();
}

// The contents of `path`, or the rendered error ("cannot read '<path>': <reason>").
export function readText(fs: FsGrant, path: string): Result<string, string> {
  const r = readFile(fs, path);
  if (r.isErr()) {
    return Err(fsErrorMessage(r.unwrapErr()));
  }
  return Ok(r.unwrap());
}

// Writes `data` to `path`, or the rendered error ("cannot write '<path>': <reason>").
export function writeText(fs: FsGrant, path: string, data: string): Result<void, string> {
  const r = writeFile(fs, path, data);
  if (r.isErr()) {
    return Err(fsErrorMessage(r.unwrapErr()));
  }
  return Ok();
}
