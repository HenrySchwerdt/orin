type Point = { x: int; y: int; };
type Line = { start: Point; end: Point; };
type User = { name: string; age: int; admin: bool; tags: string[]; };

function dist2(p: Point): int {
  return p.x * p.x + p.y * p.y;
}

function mk(x: int, y: int): Point {
  return Point { x: x, y: y };
}

function main(): void {
  const p = Point { x: 3, y: 4 };
  console.log(p.x.toString());
  console.log(dist2(p).toString());
  console.log(mk(1, 2).y.toString());
  const l = Line { start: mk(0, 0), end: p };
  console.log(l.end.y.toString());
  console.log(dist2(l.end).toString());
  const u = User { name: "Ann", age: 30, admin: false, tags: ["a", "b"] };
  console.log(u.name);
  console.log(u.age.toString());
  console.log(u.admin.toString());
  console.log(u.tags.length.toString());
  console.log(u.tags[1]);
  const q = Point { y: 9, x: 8 };
  console.log(q.x.toString());
}
