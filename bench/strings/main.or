// String building (amortised append), split into separately allocated parts, join, parse.
function build(n: int): string {
  let s = "";
  let i = 0;
  while (i < n) {
    s += "item" + i.toString() + ",";
    i += 1;
  }
  return s;
}

function main(): void {
  const s = build(500000);
  const parts = s.split(",");
  const joined = parts.join(";");
  let sum = 0;
  let nonEmpty = 0;
  for (const p of parts) {
    if (p.length > 0) {
      sum += parseInt(p.substring(4, p.length)).unwrap();
      nonEmpty += 1;
    }
  }
  console.log("len " + s.length.toString());
  console.log("parts " + parts.length.toString() + " nonEmpty " + nonEmpty.toString());
  console.log("joined " + joined.length.toString());
  console.log("sum " + sum.toString());
}
