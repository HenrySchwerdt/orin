function main(): void {
  const xs = [3, 8, 12, 5, 20, 7];
  const first = xs.find(x => x > 10);
  console.log(first.unwrap().toString());
  console.log(xs.find(x => x > 100).isNone().toString());
  const idx = xs.findIndex(x => x == 5);
  console.log(idx.unwrap().toString());
  console.log(xs.findIndex(x => x < 0).isNone().toString());
  console.log(xs.some(x => x > 19).toString() + xs.some(x => x > 20).toString());
  console.log(xs.every(x => x > 2).toString() + xs.every(x => x > 3).toString());
  const none: int[] = [];
  console.log(none.some(x => true).toString() + none.every(x => false).toString());
  const words = ["alpha", "beta", "gamma"];
  const w = words.find(s => s.length == 4);
  console.log(w.unwrapOr("?") + words.find(s => s == "zeta").unwrapOr("?"));
  console.log(words.findIndex(s => s.startsWith("g")).unwrap().toString());
}
