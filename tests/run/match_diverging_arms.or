function double(o: Option<int>): int {
  const v = match (o) {
    Some(x) => x,
    None => { return -1; },
  };
  return v * 2;
}

function main(): void {
  console.log(double(Some(4)).toString());
  console.log(double(None).toString());
  let i = 0;
  let total = 0;
  while (i < 6) {
    i += 1;
    const v = match (i % 3) {
      0 => { continue; },
      1 => 10,
      _ => 1,
    };
    total += v;
  }
  console.log(total.toString());
  let j = 0;
  let sum = 0;
  while (true) {
    const w = match (j) {
      4 => { break; },
      _ => j * j,
    };
    sum += w;
    j += 1;
  }
  console.log(sum.toString());
}
