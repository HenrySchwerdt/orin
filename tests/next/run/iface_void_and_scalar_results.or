// Methods returning void, bool, usize, string and arrays through the vtable.
interface Probe {
  show(): void;
  ok(): bool;
  count(): usize;
  parts(): string[];
}

class P implements Probe {
  constructor(public tag: string, public n: usize) {}
  show(): void { console.log("P:" + this.tag); }
  ok(): bool { return this.n > 1; }
  count(): usize { return this.n; }
  parts(): string[] { return [this.tag, this.tag + this.tag]; }
}

function run(p: Probe): void {
  p.show();
  console.log(p.ok().toString() + p.count().toString() + p.parts().join("+"));
}

function main(): void {
  run(new P("x", 1));
  run(new P("yz", 2));
}
