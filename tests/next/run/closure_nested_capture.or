// A closure may capture variables of any enclosing function (through the intermediate closures).
function main(): void {
  const a = 1;
  let b = 20;
  const name = "n";
  const outer = (x: int) => {
    const mid = (y: int) => {
      const inner = (z: int) => name + (a + b + x + y + z).toString();
      return inner(1000);
    };
    return mid(300);
  };
  b = 99;
  console.log(outer(4000));
  const mk = (p: int) => (q: int) => (r: int) => p * 100 + q * 10 + r + a;
  console.log(mk(1)(2)(3).toString());
  const base = [1, 2, 3];
  const sums = base.map(v => base.map(w => v * w).reduce((s, t) => s + t, 0));
  console.log(sums[0].toString() + " " + sums[1].toString() + " " + sums[2].toString());
}
