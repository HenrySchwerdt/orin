// Built-ins implemented by the Orin std prelude instead of the C runtime (spec 19 R1).
//
// Each moved built-in has a slot; `preludeIds` finds the prelude function that implements it by
// qualified name. When the program has no prelude (--c-builtins) every slot is -1 and the
// built-ins are emitted as runtime calls as before. The prelude functions must have the same
// signature as the built-in (borrowed parameters, owned result) and must not use the built-in
// they implement (library/core/module.or lists the rules).
//
// To move another built-in: add it to both tables below, implement it in library/core/, regenerate the
// embedded prelude (tools/embed_prelude.py).

import { Program, Builtin } from "../hir";

export function preludeSlot(b: Builtin): int {
  return match (b) {
    BStrIndexOf => 0,
    BStrIncludes => 1,
    BStrStartsWith => 2,
    BStrEndsWith => 3,
    BStrSplit => 4,
    BStrTrim => 5,
    BParseInt => 6,
    BIntToString => 7,
    BUsizeToString => 8,
    BBoolToString => 9,
    BArrJoin => 10,
    _ => -1
  };
}

function preludeNames(): string[] {
  return [
    "$std/strings.strIndexOf", "$std/strings.strIncludes", "$std/strings.strStartsWith",
    "$std/strings.strEndsWith", "$std/strings.strSplit", "$std/strings.strTrim",
    "$std/numbers.strParseInt", "$std/numbers.intToString", "$std/numbers.usizeToString",
    "$std/numbers.boolToString", "$std/strings.strJoin"
  ];
}

// Function id of every slot's implementation (-1: absent); empty when the program has no prelude.
export function preludeIds(prog: Program): int[] {
  let ids: int[] = [];
  let any = false;
  for (const n of preludeNames()) {
    let found = -1;
    let i: usize = 0;
    while (i < prog.functions.length) {
      if (prog.functions[i].name == n) {
        found = i.toInt();
        break;
      }
      i += 1;
    }
    if (found >= 0) {
      any = true;
    }
    ids.push(found);
  }
  if (!any) {
    ids = [];
  }
  return ids;
}
