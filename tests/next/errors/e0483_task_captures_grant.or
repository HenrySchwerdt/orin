// error: E0483
// A task body cannot capture a resource handle: a grant is moved into a task with spawnFs, never copied by capture.
import { Host, useFs } from "std:host";
import { readFile } from "std:fs";
import { scopeDo, spawn } from "std:task";

function main(host: Host): void {
  useFs(host, fs => {
    scopeDo(s => {
      const h = spawn(s, () => readFile(fs, "orin.toml").isOk());
      console.log(h.join() ? "readable" : "denied");
    });
  });
}
