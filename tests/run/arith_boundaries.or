function main(): void {
  let x = 9223372036854775806;
  x = x + 1;
  console.log(x.toString());
  let n = -9223372036854775807;
  n = n - 1;
  console.log(n.toString());
  const h = 4611686018427387903;
  console.log((h * 2).toString());
  console.log((x * 1).toString());
  console.log((x - x).toString());
}
