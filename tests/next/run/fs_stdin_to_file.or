// stdin (std:io) into a file through the scope API, then back out again; and a large file round trip.
import { readLine } from "std:io";
import { withFile, useFile, Read, Write, Append, File } from "std:fs";

const PATH: string = "build/tests/fs_stdin_to_file.txt";
const BIG: string = "build/tests/fs_stdin_big.txt";

function main(): void {
  const stored = useFile(PATH, Write, f => {
    let n: int = 0;
    while (true) {
      const l = readLine();
      if (l.isNone()) {
        break;
      }
      n += 1;
      f.writeLine(n.toString() + ": " + l.unwrap());
    }
    f.writeLine("total " + n.toString());
  });
  console.log("stored: " + stored.isOk().toString());
  const text = withFile(PATH, Read, f => f.readAll()).unwrap();
  console.log(text);

  // a large file: 100000 lines, written in one scope, counted in another, partly read in a third
  useFile(BIG, Write, f => {
    let i: int = 0;
    while (i < 100000) {
      f.writeLine("row " + i.toString());
      i += 1;
    }
  }).unwrap();
  const rows = withFile(BIG, Read, f => {
    let n: int = 0;
    while (f.readLine().isSome()) {
      n += 1;
    }
    return n;
  });
  console.log("rows " + rows.unwrap().toString());
  const head = withFile(BIG, Read, f => {
    f.readLine();
    f.readLine();
    return f.read(5).unwrapOr("");
  });
  console.log("head [" + head.unwrap() + "]");
  const size = withFile(BIG, Read, f => f.readAll().length);
  console.log("bytes " + size.unwrap().toString());
  // read(n) with an n far bigger than the file: no allocation of n bytes
  const huge = withFile(BIG, Read, f => f.read(1000000000000).unwrapOr("").length);
  console.log("huge read " + huge.unwrap().toString());
}
