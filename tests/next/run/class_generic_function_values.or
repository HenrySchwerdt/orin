// Generic functions (ADR-0007) take class values like any other value.
class Pt {
  constructor(public x: int, public y: int) {}
  norm1(): int {
    return this.x + this.y;
  }
  shift(): void {
    this.x += 1;
  }
}

type Pair<A, B> = { first: A; second: B; };

function firstOf<T>(xs: T[]): Option<T> {
  if (xs.length == 0) {
    return None;
  }
  return Some(xs[0]);
}

function twice<T>(x: T): T[] {
  return [x, x];
}

function pairUp<A, B>(a: A, b: B): Pair<A, B> {
  return Pair { first: a, second: b };
}

function main(): void {
  const pts = [new Pt(1, 2), new Pt(3, 4)];
  console.log(firstOf(pts).unwrap().norm1().toString());
  let both = twice(new Pt(5, 5));
  both[0].shift();
  console.log(both[0].x.toString() + " " + both[1].x.toString());
  const p = pairUp(new Pt(7, 8), "tag");
  console.log(p.first.norm1().toString() + p.second);
}
