// The mutants of the OX part of the compiler (tools/mutate_ox.py MUTANTS, unchanged and in the same order): `oldText`
// (it must occur exactly once) of `compiler/<rel>` is replaced by `newText`.

export type OxMutant = { name: string; rel: string; oldText: string; newText: string; };

export function oxMutants(): OxMutant[] {
  return [
    // ---- provider rules and the buffer (check/ox.or)
    OxMutant { name: "static-encoding-ignored", rel: "check/ox.or", oldText: "      if (e.code == c) {", newText: "      if (e.code == c + 1000) {" },
    OxMutant { name: "rule-prefix-ignored", rel: "check/ox.or", oldText: " || r.prefix.length > 0 && n.startsWith(r.prefix)", newText: "" },
    OxMutant { name: "rule-names-case-sensitive", rel: "check/ox.or", oldText: "  const n = asciiLower(name);\n  for (const r of p.rules) {", newText: "  const n = name;\n  for (const r of p.rules) {" },
    OxMutant { name: "void-tags-ignored", rel: "check/ox.or", oldText: "  return listed(p.voidTags, tag);", newText: "  return false;" },
    OxMutant { name: "raw-text-tags-ignored", rel: "check/ox.or", oldText: "  return listed(p.rawTextTags, tag);", newText: "  return false;" },
    OxMutant { name: "sealed-ignored", rel: "check/ox.or", oldText: "  if (!env.sealed.some(x => x == qname)) {", newText: "  if (true) {" },
    OxMutant { name: "pending-text-dropped", rel: "check/ox.or", oldText: "  if (o.pending.length > 0) {\n    ps.push(mk(XStr(o.pending), TyString, span));\n  }\n  ps.push(e);", newText: "  ps.push(e);" },
    // ---- spread on intrinsic elements and Option attribute values (ADR-0044 §4.3)
    OxMutant { name: "spread-later-does-not-win", rel: "check/expr.or", oldText: "            if (oxOverridden(names, j, k)) {", newText: "            if (false) {" },
    OxMutant { name: "overridden-value-not-evaluated", rel: "check/expr.or", oldText: "            if (d.parts.length > 0) {", newText: "            if (false) {" },
    OxMutant { name: "option-attribute-inverted", rel: "check/expr.or", oldText: "mk(XCond(test, text, mk(XStr(\"\"), TyString, span)), TyString, span)", newText: "mk(XCond(test, mk(XStr(\"\"), TyString, span), text), TyString, span)" },
    // the capacity hint (ADR-0044) only sizes the buffer; this mutant starts the concatenation after the first piece
    OxMutant { name: "capacity-start-drops-first-piece", rel: "check/ox.or", oldText: "    i = 0;\n  }", newText: "    i = 1;\n  }" },
    // ---- the checker (check/expr.or, check/stmt.or)
    OxMutant { name: "dynamic-child-not-encoded", rel: "check/expr.or", oldText: "      return Ok(oxOutDyn(o, mk(XCall(p.text, [v]), TyString, span), span));", newText: "      return Ok(oxOutDyn(o, v, span));" },
    OxMutant { name: "rule-convert-ignored", rel: "check/expr.or", oldText: "              conv = f;", newText: "              conv = p.attr;" },
    OxMutant { name: "dynamic-attribute-not-encoded", rel: "check/expr.or", oldText: "      return Ok(OxPiece { presence: false, piece: mk(XCall(conv, [v]), TyString, span) });", newText: "      return Ok(OxPiece { presence: false, piece: v });" },
    OxMutant { name: "static-attribute-not-encoded", rel: "check/expr.or", oldText: "      JVStr(v) => {\n        return Ok(oxOutStatic(o, \" \" + name + \"=\\\"\" + oxEncodeStatic(p, v) + \"\\\"\"));", newText: "      JVStr(v) => {\n        return Ok(oxOutStatic(o, \" \" + name + \"=\\\"\" + v + \"\\\"\"));" },
    OxMutant { name: "static-text-not-encoded", rel: "check/expr.or", oldText: "o = oxOutStatic(o, raw ? t : oxEncodeStatic(p, t));", newText: "o = oxOutStatic(o, t);" },
    OxMutant { name: "bool-attribute-inverted", rel: "check/expr.or", oldText: "mk(XCond(v, on, off), TyString, span)", newText: "mk(XCond(v, off, on), TyString, span)" },
    OxMutant { name: "void-end-ignored", rel: "check/expr.or", oldText: "      return Ok(oxOutStatic(o, p.voidEnd));", newText: "      return Ok(oxOutStatic(o, \">\"));" },
    OxMutant { name: "presence-not-checked", rel: "check/expr.or", oldText: "  private oxPresent(p: OxProvider, name: string, span: Span, o: OxOut): Result<OxOut, Diagnostic> {\n    if (!p.presence) {", newText: "  private oxPresent(p: OxProvider, name: string, span: Span, o: OxOut): Result<OxOut, Diagnostic> {\n    if (false) {" },
    OxMutant { name: "source-order-ignored", rel: "check/expr.or", oldText: "          if (pi <= last) {\n            ordered = true;\n          }\n          last = pi;\n        },", newText: "          last = pi;\n        }," },
    OxMutant { name: "option-param-required", rel: "check/expr.or", oldText: "if (pn != \"children\" && !sig.opt[i]) {", newText: "if (pn != \"children\") {" },
    OxMutant { name: "single-child-wrapped-in-fragment", rel: "check/expr.or", oldText: "      if (items.length == 1 && !items[0].splice) {", newText: "      if (false) {" },
    OxMutant { name: "spread-later-attribute-lost", rel: "check/expr.or", oldText: "          args[pi] = Some(x);\n", newText: "          if (args[pi].isNone()) {\n            args[pi] = Some(x);\n          }\n" },
    OxMutant { name: "field-assignment-not-sealed", rel: "check/stmt.or", oldText: "          if (sealed.isSome()) {\n            return Err(sealed.unwrap());\n          }\n", newText: "" },
    // ---- lexer and parser (syntax/)
    OxMutant { name: "text-lines-not-trimmed", rel: "syntax/lexer.or", oldText: "  if (!first) {\n", newText: "  if (false) {\n" },
    OxMutant { name: "entities-not-decoded", rel: "syntax/lexer.or", oldText: "  if (!s.includes(\"&\")) {\n    return s;", newText: "  if (true) {\n    return s;" },
    OxMutant { name: "no-ox-after-return", rel: "syntax/lexer.or", oldText: "KKeyword => t.text == \"return\",", newText: "KKeyword => false," },
    OxMutant { name: "ox-after-identifier", rel: "syntax/lexer.or", oldText: "KPunct => t.text != \")\" && t.text != \"]\" && t.text != \"}\",", newText: "KPunct => t.text != \")\" && t.text != \"]\" && t.text != \"}\",\n      KIdent => true," },
    OxMutant { name: "closing-tag-name-unchecked", rel: "syntax/parser.or", oldText: "        if (!this.isIdentText(0, path[k])) {", newText: "        if (!this.isIdentAt(0)) {" },
    // ---- member tags (ADR-0044 §4.5)
    OxMutant { name: "member-receiver-dropped", rel: "syntax/parser.or", oldText: "        recv = Some(r);", newText: "        recv = None;" },
    OxMutant { name: "member-lowercase-accepted", rel: "syntax/parser.or", oldText: "        if (id.name.charCodeAt(0) < 65 || id.name.charCodeAt(0) > 90) {", newText: "        if (false) {" },
    OxMutant { name: "member-receiver-param-counted", rel: "check/expr.or", oldText: "ps.slice(1, ps.length)", newText: "ps" },
    OxMutant { name: "member-static-class-ignored", rel: "check/expr.or", oldText: "    const sc = this.oxStaticClass(recv);", newText: "    const sc: Option<usize> = None;" },
  ];
}
