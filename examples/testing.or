// Unit tests with `@Test` (docs/testing.md).
//
//   orin test examples/testing.or                  run every test, one process each
//   orin test --filter clamp examples/testing.or   only tests whose id contains "clamp"
//   orin test --format=json examples/testing.or    machine-readable report
//   orin run examples/testing.or                   the normal program; tests are erased from it
import { assert, assertEq, assertEqString } from "std:test";

function clamp(x: int, lo: int, hi: int): int {
  if (x < lo) {
    return lo;
  }
  if (x > hi) {
    return hi;
  }
  return x;
}

@Test
function clampKeepsValuesInRange(): void {
  assertEq(clamp(5, 0, 10), 5, "inside");
  assertEq(clamp(-3, 0, 10), 0, "below");
  assertEq(clamp(42, 0, 10), 10, "above");
}

@Test
function stringsAndBooleans(): void {
  assertEqString("or" + "in", "orin", "concat");
  assert(clamp(1, 1, 1) == 1, "degenerate range");
}

function main(): void {
  console.log(clamp(15, 0, 10).toString());
}
