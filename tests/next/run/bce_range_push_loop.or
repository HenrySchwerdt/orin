// Range facts for constant-length arrays (ADR-0038 lever 2 T6): an array that grows, shrinks or is replaced loses its length fact.
// Every access below is right at run time but must keep its checks (and the answers must not change).
function grow(): int {
  let a: int[] = [1, 2, 3];
  let s = 0;
  let i: usize = 0;
  while (i < 3) {
    a.push(a[i] * 10);
    i += 1;
  }
  // the array has six elements now
  let j: usize = 0;
  while (j < 6) {
    s += a[j];
    j += 1;
  }
  return s;
}

// push inside the guard that uses the literal length: the loop reads what it pushed
function chase(): int {
  let a: int[] = [1, 1];
  let s = 0;
  let i: usize = 0;
  while (i < 8) {
    a.push(a[i] + a[i + 1]);
    s += a[i];
    i += 1;
  }
  return s;
}

function shrink(): int {
  let a: int[] = [4, 5, 6, 7];
  const last = a.pop();
  let s = 0;
  let i: usize = 0;
  while (i < 3) {
    s += a[i];
    i += 1;
  }
  return s + last.unwrapOr(0);
}

function replace(): int {
  let a: int[] = [1, 2, 3, 4];
  let s = 0;
  let i: usize = 0;
  while (i < 4) {
    s += a[i];
    if (i == 1) {
      a = [100, 200, 300, 400, 500, 600];
    }
    i += 1;
  }
  let j: usize = 0;
  while (j < 6) {
    s += a[j];
    j += 1;
  }
  return s;
}

function extend(): int {
  let a: int[] = [1, 2];
  const b: int[] = [3, 4, 5];
  a = a.concat(b);
  let s = 0;
  let i: usize = 0;
  while (i < 5) {
    s += a[i];
    i += 1;
  }
  return s;
}

function main(): void {
  console.log(grow().toString());
  console.log(chase().toString());
  console.log(shrink().toString());
  console.log(replace().toString());
  console.log(extend().toString());
}
