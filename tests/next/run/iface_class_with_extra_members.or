// A class may have mutating methods and fields beyond the interface; only the interface part is visible
// through the interface value.
interface Reader {
  get(): int;
}

class Acc implements Reader {
  items: int[] = [];
  private total: int = 0;
  add(x: int): void {
    this.items.push(x);
    this.total += x;
  }
  get(): int { return this.total + this.items.length.toInt(); }
}

function read(r: Reader): int { return r.get(); }

function main(): void {
  let a = new Acc();
  a.add(5);
  a.add(7);
  console.log(read(a).toString());
  const r: Reader = a;
  a.add(100);
  console.log(read(r).toString() + " " + read(a).toString());
}
