// A class whose static methods are used as member tags from another module (tests/next/run/ox_member_static/main.or).
import { Html } from "std:html";
import ox from "std:html";

export class Ui {
  static Card(title: string, children: Html): Html {
    return <section class="card"><h2>{title}</h2>{children}</section>;
  }

  // named slot and an Option parameter
  static Dialog(title: string, header: Html, footer: Option<Html>, children: Html): Html {
    return <div class="dialog">
      <header>{header}</header>
      <h1>{title}</h1>
      {children}
      {footer.isSome() ? <footer>{footer.unwrap()}</footer> : <i>no footer</i>}
    </div>;
  }

  static Row(a: string, b: string): Html {
    return <tr><td>{a}</td><td>{b}</td></tr>;
  }

  // a static member tag of the own class, inside it
  static Table(children: Html): Html {
    return <table><Ui.Row a="x" b="y" />{children}</table>;
  }

  name(): string {
    return "ui";
  }
}
