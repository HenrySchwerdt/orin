// Closure inlining and fusion (ADR-0038 §2, compiler/fuse): every fused shape. The output is the same with and without the
// pass (`--no-opt` and `--no-fuse` run the prelude functions), which tools/diff_backends.py --mode opt / fuse checks.
type Item = { name: string; price: int; qty: int; };

function count(xs: int[], limit: int): usize {
  return xs.filter(x => x > limit).map(x => x).length;
}

function show(xs: int[]): string {
  return xs.map(x => x.toString()).join(",");
}

function main(): void {
  const xs = [5, 3, 8, 1, 9, 2, 7, 4, 6, 10];
  const empty: int[] = [];
  // map ending a chain (exact capacity), filter ending a chain
  console.log(show(xs.map(x => x * 10)));
  console.log(show(xs.filter(x => x % 2 == 0)));
  console.log(empty.map(x => x + 1).length.toString());
  // stages in any order, ending in every terminal
  console.log(xs.filter(x => x > 2).map(x => x * x).filter(x => x < 70).map(x => x.toString()).join(" "));
  console.log(xs.filter(x => x % 3 == 0).map(x => x * 2).reduce((a, b) => a + b, 100).toString());
  console.log(`${xs.map(x => x - 5).some(x => x == 0)} ${xs.map(x => x - 5).some(x => x > 99)}`);
  console.log(`${xs.filter(x => x > 1).every(x => x > 1)} ${xs.every(x => x < 10)} ${empty.every(x => x > 0)}`);
  console.log(`${xs.map(x => x * 3).find(x => x > 20).unwrapOr(-1)} ${xs.find(x => x > 50).isNone()}`);
  console.log(`${xs.filter(x => x % 2 == 1).findIndex(x => x > 6).unwrapOr(99)} ${empty.findIndex(x => x == 1).isNone()}`);
  console.log(`${xs.map(x => x + 1).includes(11)} ${xs.map(x => x + 1).includes(12)}`);
  console.log(`${xs.filter(x => x > 4).indexOf(9).unwrapOr(99)} ${xs.indexOf(42).isNone()}`);
  xs.filter(x => x > 100).forEach(x => {
    const y = x * 2;
  });
  // captures (snapshot taken where the closures are created), several in one chain
  const lo = 3;
  const hi = 8;
  const scale = 7;
  console.log(show(xs.filter(x => x >= lo && x <= hi).map(x => x * scale)));
  console.log(count(xs, 5).toString());
  // block bodies with lets, a nested closure, a match
  console.log(show(xs.map(x => {
    const sq = x * x;
    const half = sq / 2;
    return half + 1;
  }).filter(v => match (v % 3) {
    0 => true,
    _ => false,
  })));
  const adders = xs.map(x => (y: int) => x + y);
  console.log(show(adders.map(f => f(1))));
  // a body that cannot be inlined (early return): called directly
  console.log(xs.map(x => {
    if (x > 5) {
      return 1;
    }
    return 0;
  }).reduce((a, b) => a + b, 0).toString());
  // records and strings
  const items = [
    Item { name: "apple", price: 3, qty: 4 },
    Item { name: "pear", price: 5, qty: 0 },
    Item { name: "plum", price: 2, qty: 9 },
  ];
  console.log(items.filter(i => i.qty > 0).map(i => i.price * i.qty).reduce((a, b) => a + b, 0).toString());
  console.log(items.map(i => i.name).filter(n => n.startsWith("p")).reduce((a, b) => a + "+" + b, "="));
  console.log(items.filter(i => i.price > 2).map(i => i.name).join("/"));
  console.log(items.find(i => i.name == "plum").unwrap().qty.toString());
  // a chain inside a chain's closure
  const grid = [[1, 2], [3, 4, 5], []];
  console.log(show(grid.map(row => row.map(v => v * 2).reduce((a, b) => a + b, 0))));
  // floats and bools
  const fs = [0.5, 1.5, 2.25];
  console.log(fs.map(f => f * 2.0).reduce((a, b) => a + b, 0.0).toString());
  console.log([true, false, true].filter(b => b).length.toString());
}
