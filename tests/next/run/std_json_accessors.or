import { parse, get, at, path, keys, asString, asInt, asBool, asArray, asObject, isNull, getString, getInt, getBool, getArray } from "std:json";

function main(): void {
  const j = parse("{\"name\":\"orin\",\"v\":3,\"on\":true,\"tags\":[\"a\",\"b\",7],\"o\":{\"in\":{\"x\":null}}}").unwrap();
  console.log(getString(j, "name").unwrap());
  console.log(getInt(j, "v").unwrap().toString());
  console.log(getBool(j, "on").unwrap().toString());
  console.log(getArray(j, "tags").unwrap().length.toString());
  console.log(getString(j, "v").isNone().toString());
  console.log(getInt(j, "missing").isNone().toString());
  console.log(get(j, "tags").isSome().toString());
  console.log(asString(at(get(j, "tags").unwrap(), 1).unwrap()).unwrap());
  console.log(at(get(j, "tags").unwrap(), 9).isNone().toString());
  console.log(asInt(at(get(j, "tags").unwrap(), 2).unwrap()).unwrap().toString());
  console.log(isNull(path(j, ["o", "in", "x"]).unwrap()).toString());
  console.log(path(j, ["o", "nope", "x"]).isNone().toString());
  console.log(path(j, []).isSome().toString());
  console.log(keys(j).join("|"));
  console.log(keys(get(j, "v").unwrap()).length.toString());
  console.log(asObject(j).unwrap().length.toString());
  console.log(asArray(j).isNone().toString());
  console.log(asBool(get(j, "on").unwrap()).unwrap().toString());
  console.log(get(get(j, "name").unwrap(), "x").isNone().toString());
}
