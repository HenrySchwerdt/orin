// Non-mutating methods calling each other, statics, and free functions.
class Rect {
  constructor(public w: int, public h: int) {}
  area(): int {
    return this.w * this.h;
  }
  perimeter(): int {
    return 2 * (this.w + this.h);
  }
  describe(): string {
    return this.w.toString() + "x" + this.h.toString() + " area=" + this.area().toString()
      + " perim=" + this.perimeter().toString();
  }
  bigger(other: Rect): bool {
    return this.area() > other.area();
  }
  square(): Rect {
    return new Rect(this.w, this.w);
  }
}

function main(): void {
  const r = new Rect(3, 5);
  console.log(r.describe());
  console.log(r.square().describe());
  console.log(r.bigger(r.square()).toString());
  console.log(r.square().bigger(r).toString());
}
