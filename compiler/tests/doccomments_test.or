// Documentation comments are source metadata, not executable contracts.
import { documentationAt, renderDocComment } from "../analysis";
import { assertEqString, assertEqBool } from "std:test";

@Test
function rendersTSDoc(): void {
  const raw = "/**\n * Computes a value.\n *\n * @param x input\n * @returns result\n */";
  assertEqString(renderDocComment(raw), "Computes a value.\n\n@param x input\n@returns result", "tag rendering");
}

@Test
function keepsCodeIndentation(): void {
  const raw = "/**\n * Example:\n *\n *     const x = f(1);\n *     g(x);\n */";
  assertEqString(renderDocComment(raw), "Example:\n\n    const x = f(1);\n    g(x);", "indented code kept");
  assertEqString(renderDocComment("/** one line */"), "one line", "single line");
}

@Test
function attachesAcrossDecorators(): void {
  const src = "/**\n * Increment positive values.\n */\n@Requires(x > 0)\nfunction inc(x: int): int { return x + 1; }\n";
  const at = src.indexOf("@Requires").unwrap();
  assertEqString(documentationAt(src, at).unwrapOr(""), "Increment positive values.", "contract-adjacent doc");
}

@Test
function rejectsSeparatedOrNonDocComments(): void {
  const source = "/** doc */\nconst x: int = 1;\nfunction f(): int { return x; }";
  assertEqBool(documentationAt(source, source.indexOf("function").unwrap()).isNone(), true, "code breaks attachment");
  const normal = "/* normal */\nfunction f(): int { return 1; }";
  assertEqBool(documentationAt(normal, normal.indexOf("function").unwrap()).isNone(), true, "ordinary block ignored");
  const line = "/// line doc\nfunction f(): int { return 1; }";
  assertEqBool(documentationAt(line, line.indexOf("function").unwrap()).isNone(), true, "line comment not TSDoc");
}
