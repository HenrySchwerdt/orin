// u64 uses the whole unsigned 64-bit range: literals above 2^63, unsigned comparison, division, hex literals.
const MAX: u64 = 18446744073709551615;
const HALF: u64 = 9223372036854775808;
const HEX: u64 = 0xFFFFFFFFFFFFFFFF;
const MIN_I64: i64 = -9223372036854775808;

function isBig(x: u64): bool {
  return x > 9223372036854775807;
}

function classify(x: u64): string {
  return match (x) {
    0 => "zero",
    1 => "one",
    _ => "many"
  };
}

function main(): void {
  console.log(MAX.toString());
  console.log(HALF.toString());
  console.log(HEX.toString());
  console.log((MAX == HEX).toString());
  console.log((MAX > HALF).toString());
  console.log((HALF < MAX).toString());
  console.log((HALF - 1 < HALF).toString());
  console.log(isBig(HALF).toString());
  console.log(isBig(HALF - 1).toString());
  console.log((MAX / 2).toString());
  console.log((MAX % 10).toString());
  console.log((HALF / 3).toString());
  console.log((MAX - HALF).toString());
  console.log((HALF + (HALF - 1)).toString());
  console.log(classify(0) + classify(1) + classify(HALF));
  console.log(MIN_I64.toString());
  console.log((MIN_I64 + 1).toString());
  let acc: u64 = 1;
  let n: u64 = 0;
  while (n < 63) {
    acc *= 2;
    n += 1;
  }
  console.log(acc.toString());
  console.log((acc == HALF).toString());
  const xs: u64[] = [MAX, HALF, 0, 1];
  let sum: u64 = 0;
  for (const x of xs) {
    sum = sum.wrappingAdd(x);
  }
  console.log(sum.toString());
  console.log(xs.indexOf(HALF).unwrap().toString());
  console.log(xs.includes(MAX - 1).toString());
  const o: Option<u64> = Some(MAX);
  console.log(o.unwrap().toString());
  console.log(`${MAX} ${HALF} ${HEX}`);
}
