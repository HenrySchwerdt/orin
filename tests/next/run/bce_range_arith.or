// Range facts for constant-length arrays (ADR-0038 lever 2 T6): index arithmetic right at the bounds. Every index below is inside
// the array; some of them are provable by the intervals, some are not, and the output is the same in both cases.
function edges(): int {
  const a: int[] = [10, 20, 30, 40, 50];
  const n: usize = 5;
  let s = a[0] + a[n - 1] + a[4] + a[2 + 2];
  let i: usize = 0;
  while (i + 1 < n) {
    s += a[i + 1] - a[i];
    i += 1;
  }
  return s;
}

// reversed: `len - 1 - i`
function reverse(): int {
  const a: int[] = [1, 2, 3, 4, 5, 6];
  const n = a.length;
  let s = 0;
  let i: usize = 0;
  while (i < n) {
    s = s * 7 + a[n - 1 - i];
    i += 1;
    if (s > 100000) {
      s = s - 100000;
    }
  }
  return s;
}

// an index that is a sum of two guarded indices
function sums(): int {
  const a: int[] = [1, 2, 3, 4, 5, 6, 7];
  let s = 0;
  let i: usize = 0;
  while (i < 4) {
    let j: usize = 0;
    while (j < 4) {
      s += a[i + j];
      j += 1;
    }
    i += 1;
  }
  return s;
}

// a conditional index: `if (i == 3)`, `if (i != 0)`
function pick(k: usize): int {
  const a: int[] = [5, 4, 3, 2];
  let s = 0;
  if (k == 3) {
    s += a[k];
  }
  if (k != 0) {
    if (k < 4) {
      s += a[k - 1];
    }
  }
  if (k < 4) {
    s += a[k];
  }
  return s;
}

// an index that goes through a copy and a subtraction
function chain(): int {
  const a: int[] = [3, 6, 9, 12];
  let m: usize = 4;
  let s = 0;
  while (m > 0) {
    const k = m - 1;
    s += a[k];
    m = k;
  }
  return s;
}

function main(): void {
  console.log(edges().toString());
  console.log(reverse().toString());
  console.log(sums().toString());
  console.log(pick(0).toString() + " " + pick(1).toString() + " " + pick(3).toString() + " " + pick(9).toString());
  console.log(chain().toString());
}
