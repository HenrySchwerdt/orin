// Interface-typed fields of records and classes.
interface Shape {
  area(): int;
}

class Rect implements Shape {
  constructor(public w: int, public h: int) {}
  area(): int { return this.w * this.h; }
}

class Tri implements Shape {
  constructor(public b: int, public h: int) {}
  area(): int { return this.b * this.h / 2; }
}

type Item = { label: string; shape: Shape; };

class Holder {
  constructor(public inner: Shape) {}
  double(): int { return this.inner.area() * 2; }
  swap(s: Shape): void { this.inner = s; }
}

function main(): void {
  const it = Item { label: "r", shape: new Rect(2, 5) };
  console.log(it.label + it.shape.area().toString());
  let h = new Holder(new Tri(4, 5));
  console.log(h.double().toString());
  h.swap(it.shape);
  console.log(h.double().toString());
  const items = [Item { label: "a", shape: new Tri(2, 2) }, it];
  console.log(items[0].shape.area().toString() + items[1].shape.area().toString());
}
