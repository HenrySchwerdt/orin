import { a, B } from "./other";
export { a } from "./other";

function parse(s: string): Result<int, string> {
  const n = parseInt(s);
  return match (n) {
    Some(v) => Ok(v),
    None => Err("bad number"),
  };
}

function twice(s: string): Result<int, string> {
  const v = parse(s)?;
  const w = parse(s)?;
  return Ok(v + w);
}

function loop(xs: int[]): int {
  let i = 0;
  while (i < xs.length.toInt()) {
    if (xs[i.toUsize()] == 0) {
      break;
    } else if (xs[i.toUsize()] < 0) {
      i += 1;
      continue;
    }
    i += 1;
  }
  return i;
}
