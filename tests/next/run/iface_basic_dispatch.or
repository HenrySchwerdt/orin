// Interface-typed values: implicit conversion, calls through the vtable, array of interface values.
interface Shape {
  area(): int;
  name(): string;
}

class Circle implements Shape {
  constructor(public r: int) {}
  area(): int { return 3 * this.r * this.r; }
  name(): string { return "circle"; }
}

class Square implements Shape {
  constructor(public s: int) {}
  area(): int { return this.s * this.s; }
  name(): string { return "square"; }
}

function describe(s: Shape): string {
  return s.name() + ":" + s.area().toString();
}

function main(): void {
  const c = new Circle(2);
  const s: Shape = c;
  console.log(describe(s));
  const all: Shape[] = [new Circle(1), new Square(3), c];
  for (const x of all) {
    console.log(describe(x));
  }
  console.log(describe(new Square(4)));
}
