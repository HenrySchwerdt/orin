// Fixed workload at three sizes; checksum keeps every encode/decode/parse/stringify observable.
import { ByteBuilder } from "std:bytes";
import { percentEncode, percentDecode, parseQuery, stringifyQuery } from "std:url";

function input(n: usize): string {
  let out = new ByteBuilder();
  let i: usize = 0;
  while (i < n) {
    out.appendString("a +&=é");
    i += 1;
  }
  return out.build().toRawString();
}

function workload(s: string): usize {
  let sum: usize = 0;
  let i = 0;
  while (i < 64) {
    const wire = percentEncode(s, true);
    const text = percentDecode(wire, true).unwrap();
    const pairs = parseQuery("key=" + wire + "&key=" + wire, true).unwrap();
    const query = stringifyQuery(pairs, true).unwrap();
    sum += text.length + query.length;
    i += 1;
  }
  return sum;
}

function main(): void {
  const sizes: usize[] = [512, 2048, 8192];
  let i: usize = 0;
  while (i < sizes.length) {
    const s = input(sizes[i]);
    const sum = workload(s);
    console.log("bytes=" + s.length.toString() + " iterations=64 checksum=" + sum.toString());
    i += 1;
  }
}
