// exit: 101
// stderr: trap: substring out of range
// `out += s.substring(i, j)` appends the bytes without the substring object, but traps exactly like substring: the range
// check happens when the piece is evaluated, so nothing after it runs.
function main(): void {
  const s = "hello";
  let out = "ok:";
  out += s.substring(1, 3);
  console.log(out);
  const hi: usize = 9;
  out += s.substring(2, hi);
  console.log("not reached " + out);
}
