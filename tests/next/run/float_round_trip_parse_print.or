// toString and parseFloat are inverse: print, parse again, compare bit-exactly (via ==)
function check(x: float): void {
  const s = x.toString();
  const back = parseFloat(s).unwrap();
  console.log(s + " " + (back == x).toString());
}

function main(): void {
  check(0.1);
  check(0.2 + 0.1);
  check(1.0 / 3.0);
  check(1e-7);
  check(1e21);
  check(123456.789e10);
  check(5e-324);
  check(1.7976931348623157e308);
  check(-2.5e-300);
  check(3.141592653589793);
  check(299792458.0);
  check(6.02214076e23);
  check(1.602176634e-19);
  let i = 1;
  let v = 1.0;
  while (i < 40) {
    v = v * 7.3 + 0.1;
    check(v);
    i += 1;
  }
}
