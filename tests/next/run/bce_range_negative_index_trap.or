// exit: 101
// stderr: trap: negative int to usize
// Range facts for constant-length arrays (ADR-0038 lever 2 T6): a negative int cannot become a usize index (the conversion traps), so
// no negative index reaches an array access; the conversion gives the interval nothing, and the access keeps its bounds check.
function main(): void {
  const a: int[] = [7, 8, 9];
  let k: int = 2;
  console.log(a[k.toUsize()].toString());
  k = k - 1;
  console.log(a[k.toUsize()].toString());
  k = k - 1;
  console.log(a[k.toUsize()].toString());
  k = k - 1;
  console.log(a[k.toUsize()].toString());
  console.log("unreachable");
}
