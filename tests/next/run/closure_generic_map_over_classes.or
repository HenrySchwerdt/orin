class Point {
  constructor(public x: int, public y: int) {}
  norm1(): int {
    return this.x + this.y;
  }
  shifted(d: int): Point {
    return new Point(this.x + d, this.y + d);
  }
}

class Tag {
  constructor(public label: string) {}
  show(): string {
    return "#" + this.label;
  }
}

function mapAll<T, U>(xs: T[], f: (x: T) => U): U[] {
  let out: U[] = [];
  for (const x of xs) {
    out.push(f(x));
  }
  return out;
}

function keep<T>(xs: T[], pred: (x: T) => bool): T[] {
  let out: T[] = [];
  for (const x of xs) {
    if (pred(x)) {
      out.push(x);
    }
  }
  return out;
}

function main(): void {
  const pts = [new Point(1, 2), new Point(3, 4), new Point(5, 6)];
  const norms = mapAll(pts, p => p.norm1());
  console.log(norms[0].toString() + " " + norms[1].toString() + " " + norms[2].toString());
  const d = 10;
  const moved = pts.map(p => p.shifted(d));
  console.log(moved[2].x.toString() + "," + moved[2].y.toString());
  const big = keep(pts, p => p.norm1() > 5);
  console.log(big.length.toString());
  const tags = ["a", "b"].map(l => new Tag(l));
  console.log(tags.map(t => t.show()).join(" "));
  const labels = mapAll(tags, t => t.label);
  console.log(labels.join(""));
  const sizes = pts.map(p => (q: int) => p.x * q);
  console.log(sizes[2](3).toString());
}
