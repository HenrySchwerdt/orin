// ORIN_DENY=net: a network operation returns Err (it has a Result), the program keeps running
import { Host, useNet } from "std:host";
import { useListener, withConnection, resolve, isDenied, Listener, Stream } from "std:net";

function main(host: Host): void {
  useNet(host, net => {
    const r = useListener(net, "127.0.0.1", 0, 4, (ln: Listener) => { console.log("inside the listener scope"); });
    console.log(r.isOk() ? "listen: ok" : "listen: " + r.unwrapErr().message);
    const c = withConnection(net, "127.0.0.1", 9, 100, (s: Stream) => 1);
    console.log(c.isOk() ? "connect: ok" : (isDenied(c.unwrapErr()) ? "connect: denied" : "connect: failed"));
    const d = resolve(net, "localhost");
    console.log(d.isOk() ? "resolve: ok" : "resolve: " + d.unwrapErr().message);
  });
  console.log("done");
}
