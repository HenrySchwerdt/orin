import { newGraph, add, get, set, size, contains, ids } from "std:graph";

function main(): void {
  let g = newGraph<string>(1);
  const a = add(g, "alpha");
  g = a.graph;
  const b = add(g, "beta");
  g = b.graph;
  console.log(size(g).toString());
  console.log(get(g, a.id).unwrap());
  console.log(get(g, b.id).unwrap());
  console.log(contains(g, a.id).toString());
  const s = set(g, a.id, "ALPHA");
  g = s.unwrap();
  console.log(get(g, a.id).unwrap() + " " + get(g, b.id).unwrap());
  console.log(ids(g).length.toString());
  console.log(size(newGraph<int>(2)).toString());
}
