import { sqrt, abs, min, max } from "std:math";

function main(): void {
  const nan = 0.0 / 0.0;
  const negZero = -0.0;
  console.log(sqrt(-1.0).toString());
  console.log(sqrt(negZero).toString());
  console.log(sqrt(1.0 / 0.0).toString());
  console.log(abs(negZero).toString());
  console.log(abs(-1.0 / 0.0).toString());
  console.log(abs(nan).toString());
  console.log(min(nan, 1.0).toString());
  console.log(min(1.0, nan).toString());
  console.log(max(nan, 1.0).toString());
  console.log(max(1.0, nan).toString());
  console.log(min(negZero, 0.0).toString());
  console.log(min(0.0, negZero).toString());
  console.log(max(negZero, 0.0).toString());
  console.log(max(0.0, negZero).toString());
  console.log(min(1.0 / 0.0, 5.0).toString());
  console.log(max(-1.0 / 0.0, -5.0).toString());
  console.log(min(2.0, 2.0).toString());
}
