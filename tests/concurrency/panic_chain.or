// exit: 101
// Panics under the sanitizers: a panic crosses three tasks (leaf -> middle -> top -> main), each hop is a `join` that traps. Nothing may
// hang, race or touch freed memory; the process ends with the trap of the joiner, status 101, with the message
// "trap: task panicked: task panicked: task panicked: boom" on stderr.
import { scope, spawn } from "std:task";

function leaf(): int {
  const none: Option<int> = None;
  return none.unwrap();
}

function middle(): int {
  return scope(s => spawn(s, () => leaf()).join());
}

function top(): int {
  return scope(s => spawn(s, () => middle()).join());
}

function main(): void {
  console.log("start");
  const r = scope(s => spawn(s, () => top()).join());
  console.log("unreachable " + r.toString());
}
