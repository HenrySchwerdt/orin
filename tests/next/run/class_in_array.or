// Classes as array elements: element mutation rebinds the slot.
class Cell {
  constructor(public v: int) {}
  inc(): void {
    this.v += 1;
  }
  twice(): int {
    return this.v * 2;
  }
}

function total(cells: Cell[]): int {
  let s = 0;
  for (const c of cells) {
    s += c.v;
  }
  return s;
}

function main(): void {
  let cells = [new Cell(1), new Cell(2), new Cell(3)];
  const before = cells;
  cells[1].inc();
  cells[1].inc();
  let i: usize = 0;
  while (i < cells.length) {
    cells[i].inc();
    i += 1;
  }
  console.log(total(cells).toString() + " " + total(before).toString());
  cells.push(new Cell(10));
  console.log(cells[3].twice().toString() + " " + cells.length.toString());
  const popped = cells.pop();
  console.log(popped.unwrap().v.toString());
}
