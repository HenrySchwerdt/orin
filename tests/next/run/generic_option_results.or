function someIf<T>(c: bool, v: T): Option<T> {
  if (c) {
    return Some(v);
  }
  return None;
}

function orElse<T>(o: Option<T>, d: T): T {
  return match (o) {
    Some(v) => v,
    None => d,
  };
}

function none<T>(): Option<T> {
  return None;
}

function okOr<T, E>(o: Option<T>, e: E): Result<T, E> {
  return match (o) {
    Some(v) => Ok(v),
    None => Err(e),
  };
}

function valueOr<T, E>(r: Result<T, E>, d: T): T {
  return match (r) {
    Ok(v) => v,
    Err(_) => d,
  };
}

function firstOrErr<T>(xs: T[], msg: string): Result<T, string> {
  const v = okOr(xs.get(0), msg)?;
  return Ok(v);
}

function twoFirsts<T>(a: T[], b: T[]): Result<T[], string> {
  const x = firstOrErr(a, "first list is empty")?;
  const y = firstOrErr(b, "second list is empty")?;
  return Ok([x, y]);
}

function main(): void {
  console.log(orElse(someIf(true, 5), 0).toString());
  console.log(orElse(someIf(false, 5), 0).toString());
  console.log(orElse(someIf(true, "yes"), "no"));
  const n: Option<int> = none();
  console.log(n.isNone().toString());
  console.log(none<string>().isSome().toString());
  console.log(valueOr(okOr(Some(3), "e"), 9).toString());
  console.log(valueOr(okOr(none<int>(), "e"), 9).toString());
  match (twoFirsts([1], [2, 3])) {
    Ok(v) => { console.log("ok " + v.length.toString()); },
    Err(e) => { console.log(e); },
  }
  match (twoFirsts(["a"], [])) {
    Ok(v) => { console.log("ok"); },
    Err(e) => { console.log(e); },
  }
}
