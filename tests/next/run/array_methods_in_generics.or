// Array methods inside generic functions (checked once abstractly, instantiated per use).
type Box<T> = { value: T; };

function mapBox<T, U>(xs: Box<T>[], f: (x: T) => U): U[] {
  return xs.map(b => f(b.value));
}

function evens<T>(xs: T[], idx: (x: T) => int): T[] {
  return xs.filter(x => idx(x) % 2 == 0);
}

function count<T>(xs: T[], pred: (x: T) => bool): usize {
  return xs.filter(pred).length;
}

function firstOr<T>(xs: T[], pred: (x: T) => bool, dflt: T): T {
  return match (xs.find(pred)) {
    Some(x) => x,
    None => dflt,
  };
}

function sortBy<T>(xs: T[], key: (x: T) => int): T[] {
  return xs.sort((a, b) => key(a) - key(b));
}

function main(): void {
  const boxes = [Box { value: 1 }, Box { value: 2 }, Box { value: 3 }];
  console.log(mapBox(boxes, x => x * 10).map(x => x.toString()).join(","));
  console.log(mapBox(boxes, x => "v" + x.toString()).join(""));
  console.log(evens(["aa", "b", "cc"], s => s.length.toInt()).join("+"));
  console.log(count([1, 5, 10, 15], x => x > 4).toString());
  console.log(
    firstOr(["x", "yy"], s => s.length > 1, "none") + firstOr(["x"], s => s.length > 5, "none"),
  );
  console.log(sortBy(["ccc", "a", "bb"], s => s.length.toInt()).join(" "));
}
