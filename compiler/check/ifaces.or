// Interfaces (ADR-0019), checker side: resolution of interface method signatures, `implements`
// lists, conformance of classes (E0417 / E0418), generic bounds and vtable interning. Beyond Orin-B.
//
// Interfaces are nominal. A class conforms to `I` only if it declares `implements I` and has, for
// every interface method, a public instance method with identical parameter and result types that
// does not mutate its receiver (interface methods are non-mutating in 1.0 core).

import { Span, Diagnostic, diag } from "../diag";
import { Ident, FunctionDecl } from "../syntax";
import { Type, VTable } from "../hir";
import {
  Env, FuncInfo, IfaceSig, TypeEnt, EntIface, findType, typeEq, showType, showIfaceSig, ifaceMethodIndex, originOf,
  cmpKindOfIface, builtinIface
} from "./env";
import { plainScope, resolveType, instFunc } from "./types";
import { abstractInfo } from "./gclass";
import { classOfRec, findMethod, satisfies, boundIface, cmpProblem, cmpBoundError, checkParamBounds } from "./classes";

export type IfaceRes = { env: Env; diags: Diagnostic[]; };

// Resolves the method signatures of every interface (after record and union declarations).
export function resolveIfaceSigs(env0: Env): IfaceRes {
  let diags: Diagnostic[] = [];
  let cur = env0;
  let ii: usize = 0;
  while (ii < env0.ifaces.length) {
    const info = env0.ifaces[ii];
    const sc = plainScope(info.unit);
    let sigs: IfaceSig[] = [];
    for (const m of info.decl.methods) {
      let names: string[] = [];
      let tys: Type[] = [];
      for (const p of m.params) {
        let dup = false;
        for (const n of names) {
          if (n == p.name.name) {
            dup = true;
          }
        }
        if (dup) {
          diags.push(diag("E0304", p.name.span, "duplicate parameter `" + p.name.name + "`"));
        }
        match (resolveType(cur, sc, p.ty, false)) {
          Ok(r) => {
            cur = r.env;
            names.push(p.name.name);
            tys.push(r.ty);
          },
          Err(d) => { diags.push(d); }
        }
      }
      let ret: Type = TyVoid;
      match (m.ret) {
        Some(te) => {
          match (resolveType(cur, sc, te, true)) {
            Ok(r) => {
              cur = r.env;
              ret = r.ty;
            },
            Err(d) => { diags.push(d); }
          }
        },
        None => {}
      }
      sigs.push(IfaceSig { name: m.name.name, paramNames: names, params: tys, ret: ret });
    }
    cur.ifaces[ii].methods = sigs;
    ii += 1;
  }
  return IfaceRes { env: cur, diags: diags };
}

// Resolves the `implements` list of every class to interface ids.
export function resolveImpls(env0: Env): IfaceRes {
  let diags: Diagnostic[] = [];
  let env = env0;
  let ci: usize = 0;
  while (ci < env.classes.length) {
    const scope = env.units[env.classes[ci].unit].scope;
    let ids: usize[] = [];
    for (const n of env.classes[ci].implNames) {
      const found: Option<TypeEnt> = match (findType(scope, n.name)) {
        Some(te) => Some(te),
        None => match (builtinIface(env, n.name)) {
          Some(bi) => Some(EntIface(bi)),
          None => None,
        },
      };
      match (found) {
        None => {
          diags.push(diag("E0300", n.span, "unknown interface `" + n.name + "`"));
        },
        Some(te) => {
          match (te) {
            EntIface(i) => {
              let dup = false;
              for (const x of ids) {
                if (x == i) {
                  dup = true;
                }
              }
              if (dup) {
                diags.push(diag("E0304", n.span, "interface `" + n.name + "` is listed twice in `implements`"));
              } else {
                ids.push(i);
              }
            },
            _ => {
              diags.push(diag("E0400", n.span, "`" + n.name + "` is not an interface"));
            }
          }
        }
      }
    }
    env.classes[ci].impls = ids;
    ci += 1;
  }
  return IfaceRes { env: env, diags: diags };
}

function paramNamesOf(d: FunctionDecl): string[] {
  let out: string[] = [];
  let i: usize = 1;
  while (i < d.params.length) {
    out.push(d.params[i].name.name);
    i += 1;
  }
  return out;
}

@Requires(names.length == tys.length)
function sigText(env: Env, name: string, names: string[], tys: Type[], ret: Type): string {
  return showIfaceSig(env, IfaceSig { name: name, paramNames: names, params: tys, ret: ret });
}

function sameSig(m: IfaceSig, params: Type[], ret: Type): bool {
  if (m.params.length != params.length || !typeEq(m.ret, ret)) {
    return false;
  }
  let i: usize = 0;
  while (i < params.length) {
    if (!typeEq(m.params[i], params[i])) {
      return false;
    }
    i += 1;
  }
  return true;
}

// Conformance of every class to the interfaces it declares (after mutation inference):
// E0417 (missing method, wrong signature, static or private method), E0418 (mutating method).
export function checkImpls(env: Env): Diagnostic[] {
  let diags: Diagnostic[] = [];
  for (const ci of env.classes) {
    // `implements Eq` / `Ord` / `Hash` (ADR-0034): the explicit methods are well formed or the structural instance exists.
    // A generic class is checked on each instance when it is created.
    let q: usize = 0;
    while (q < ci.impls.length) {
      const ck = cmpKindOfIface(env, ci.impls[q]);
      if (ck > 0 && ci.gid < 0) {
        const pr = cmpProblem(env, TyRecord(ci.rec), ck);
        if (pr.isSome()) {
          diags.push(diag(pr.unwrap().code, ci.implNames[q].span, pr.unwrap().msg));
        }
      }
      q += 1;
    }
    let k: usize = 0;
    while (k < ci.impls.length) {
      const info = env.ifaces[ci.impls[k]];
      const where = ci.implNames[k].span;
      for (const m of info.methods) {
        const mo = findMethod(ci, m.name);
        const req = sigText(env, m.name, m.paramNames, m.params, m.ret);
        if (mo.isNone()) {
          diags.push(diag(
            "E0417", where,
            "class `" + ci.name + "` does not implement interface method `" + req + "` required by `" + info.name + "`"
          ));
        } else {
          const mi = ci.methods[mo.unwrap()];
          // A generic class (ADR-0026) is checked on the signatures under opaque type parameters.
          let fo: Option<FuncInfo> = None;
          let senv = env;
          if (mi.gen && !mi.isStatic) {
            const ai = abstractInfo(env, mi.fid);
            if (ai.isOk()) {
              fo = Some(ai.unwrap().f);
              senv = ai.unwrap().env;
            }
          } else {
            fo = Some(env.funcs[mi.fid]);
          }
          if (fo.isNone()) {
            continue;
          }
          const f = fo.unwrap();
          const sp = f.decl.name.span;
          if (mi.isStatic) {
            diags.push(diag(
              "E0417", sp,
              "`" + m.name + "` is a static method of `" + ci.name + "`; interface `" + info.name + "` requires the instance method `" + req + "`"
            ));
          } else if (mi.ownTps > 0) {
            diags.push(diag(
              "E0417", sp,
              "method `" + m.name + "` of class `" + ci.name + "` is generic and cannot implement interface method `" + req + "` of `"
                + info.name + "` (an interface method cannot be generic, ADR-0040)"
            ));
          } else if (mi.priv) {
            diags.push(diag(
              "E0417", sp,
              "method `" + m.name + "` of class `" + ci.name + "` is private; interface `" + info.name + "` requires the public method `" + req + "`"
            ));
          } else {
            let ps: Type[] = [];
            let i: usize = 1;
            while (i < f.params.length) {
              ps.push(f.params[i]);
              i += 1;
            }
            if (!sameSig(m, ps, f.srcRet)) {
              diags.push(diag(
                "E0417", sp,
                "method `" + sigText(senv, m.name, paramNamesOf(f.decl), ps, f.srcRet) + "` of class `" + ci.name
                  + "` does not match interface `" + info.name + "`, which requires `" + req + "`"
              ));
            } else if (mi.mutating) {
              diags.push(diag(
                "E0418", sp,
                "method `" + m.name + "` of class `" + ci.name + "` mutates its receiver and cannot implement interface method `"
                  + req + "` of `" + info.name + "` (interface methods are non-mutating in Orin 1.0, ADR-0019)"
              ));
            }
          }
        }
      }
      k += 1;
    }
  }
  return diags;
}

// ---------------------------------------------------------------------------
// Conversions and bounds
// ---------------------------------------------------------------------------

// Checks the arguments of a call of the generic function `decl` against the bounds of its type
// parameters (E0417 at `span`). Used for abstract checks (opaque arguments) and instantiations alike.
export function checkBounds(env: Env, unit: usize, decl: FunctionDecl, tys: Type[], span: Span): Option<Diagnostic> {
  let k: usize = 0;
  while (k < decl.bounds.length && k < tys.length) {
    const bad = checkParamBounds(env, unit, decl.bounds[k], tys[k], decl.typeParams[k].name, "`" + decl.name.name + "`", span);
    if (bad.isSome()) {
      return bad;
    }
    k += 1;
  }
  return None;
}

// The vtable of class `ci` for interface `iface`: the class methods in interface-method order.
// Interned (one per pair); conformance has been checked already. `rec` is the record of the value that is
// converted: the class's record, or for a generic class (ADR-0026) the instance record, whose methods are
// the instances of the generic methods under its type arguments (created here).
export type VtOut = { env: Env; id: usize; };

export function internVtable(env0: Env, ci: usize, rec: usize, iface: usize, depth: usize, span: Span): Result<VtOut, Diagnostic> {
  let env = env0;
  const cls = env.classes[ci];
  const info = env.ifaces[iface];
  const name = env.records[rec].name + " as " + info.name;
  let i: usize = 0;
  while (i < env.vtables.length) {
    if (env.vtables[i].name == name) {
      return Ok(VtOut { env: env, id: i });
    }
    i += 1;
  }
  let funcs: usize[] = [];
  for (const m of info.methods) {
    const mo = findMethod(cls, m.name);
    const fid = cls.methods[mo.unwrapOr(0)].fid;
    if (cls.gid >= 0) {
      const o = originOf(env, TyRecord(rec));
      const args = o.unwrap().args;
      const fo = instFunc(env, fid, args, depth + 1, span)?;
      env = fo.env;
      funcs.push(fo.fid);
    } else {
      funcs.push(fid);
    }
  }
  env.vtables.push(VTable { name: name, funcs: funcs });
  return Ok(VtOut { env: env, id: env.vtables.length - 1 });
}

export function ifaceSlot(env: Env, iface: usize, name: string): Option<usize> {
  return ifaceMethodIndex(env.ifaces[iface], name);
}
