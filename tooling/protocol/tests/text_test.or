import { assertEq, assertEqString, assertEqBool, assertEqUsize } from "std:test";
import { strip, shq, lower, findByte, findFrom, countNewlines, replaceAll, reprStr, lessThan, sortedStrs } from "../src/text";

@Test
function stripRemovesAsciiWhitespace(): void {
  assertEqString(strip("  a b \n"), "a b", "both ends");
  assertEqString(strip("\t\r\n"), "", "only blanks");
  assertEqString(strip("x"), "x", "nothing to strip");
}

@Test
function shellQuoting(): void {
  assertEqString(shq("a b"), "'a b'", "blank");
  assertEqString(shq("it's"), "'it'\\''s'", "quote");
  assertEqString(shq(""), "''", "empty");
}

@Test
function lowerCase(): void {
  assertEqString(lower("Content-LENGTH: 1"), "content-length: 1", "ascii");
}

@Test
function searches(): void {
  assertEqUsize(findByte("abc\ndef", 0, 10), 3, "newline");
  assertEqUsize(findByte("abc", 0, 10), 3, "absent gives the length");
  assertEq(findFrom("abcabc", "bc", 0), 1, "first");
  assertEq(findFrom("abcabc", "bc", 2), 4, "from an offset");
  assertEq(findFrom("abc", "x", 0), -1, "absent");
  assertEq(countNewlines("a\nb\nc", 3), 1, "prefix");
  assertEq(countNewlines("a\nb\nc", 5), 2, "all");
}

@Test
function replacing(): void {
  assertEqString(replaceAll("a + b + c", " + ", ","), "a,b,c", "all occurrences");
  assertEqString(replaceAll("abc", "x", "y"), "abc", "absent");
}

@Test
function quotedForMessages(): void {
  assertEqString(reprStr("a\nb'c"), "'a\\nb\\'c'", "escapes");
}

@Test
function byteOrder(): void {
  assertEqBool(lessThan("a", "b"), true, "a < b");
  assertEqBool(lessThan("ab", "a"), false, "prefix is smaller");
  assertEqBool(lessThan("a", "ab"), true, "prefix is smaller");
  const xs = sortedStrs(["lib.or:3:17", "main.or:5:15", "main.or:1:10"]);
  assertEqString(xs.join(" "), "lib.or:3:17 main.or:1:10 main.or:5:15", "sorted copy");
}
