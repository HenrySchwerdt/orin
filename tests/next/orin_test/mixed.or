// `orin test` fixture (tools/test_annotations.py): passing, failing, trapping, exiting and hanging tests
// in one file. There is deliberately no `main`: a test file needs none.
import { exit } from "std:process";
import { assert, assertEq, assertEqString, assertEqBool, assertEqUsize, assertNear, fail } from "std:test";

function double(x: int): int {
  return x * 2;
}

@Test
function passes(): void {
  assertEq(double(21), 42, "double");
  assertEqString("a" + "b", "ab", "concat");
  assertEqBool(true, true, "bool");
  assertEqUsize([1, 2].length, 2, "length");
  assertNear(0.1 + 0.2, 0.3, 0.000001, "float");
  assert(double(1) == 2, "one");
}

@Test
function assertionFails(): void {
  assertEq(double(2), 5, "expected to fail");
}

@Test
function trapsOnBounds(): void {
  const xs: int[] = [1];
  console.log("before the trap");
  console.log(xs[5].toString());
}

@Test
function exitsNonZero(): void {
  console.error("exiting with 3");
  exit(3);
}

@Test
function explicitFail(): void {
  fail("reached a place that must not be reached");
}

@Test
function stillRunsAfterFailures(): void {
  assertEq(double(0), 0, "zero");
}

@Test
function hangs(): void {
  let i = 0;
  while (true) {
    i += 1;
  }
}
