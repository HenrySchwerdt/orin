// Interface values as parameters and results; the class converts at `return`.
interface Greeter {
  greet(who: string): string;
}

class Polite implements Greeter {
  greet(who: string): string { return "Good day, " + who; }
}

class Casual implements Greeter {
  constructor(public tag: string) {}
  greet(who: string): string { return "hey " + who + this.tag; }
}

function pick(polite: bool): Greeter {
  if (polite) {
    return new Polite();
  }
  return new Casual("!");
}

function twice(g: Greeter, who: string): string {
  return g.greet(who) + " / " + g.greet(who + who);
}

function main(): void {
  console.log(twice(pick(true), "Ann"));
  console.log(twice(pick(false), "Bo"));
  console.log(pick(false).greet("x"));
}
