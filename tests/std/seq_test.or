// Tests for std:seq (ADR-0036): `range`, `sum`, `sumBy`. Run with `orin test` (contracts checked) and with
// `--no-contracts`; see tools/test_std.sh.
import { assert, assertEq, assertEqUsize, assertEqBool } from "std:test";
import { range, sum, sumBy } from "std:seq";

type Item = { price: int; qty: int; };

@Test
function rangeBasics(): void {
  assertEqUsize(range(0, 0).length, 0, "empty");
  assertEqUsize(range(3, 3).length, 0, "lo == hi");
  assertEqUsize(range(5, 2).length, 0, "hi < lo");
  const r = range(2, 6);
  assertEqUsize(r.length, 4, "length");
  assertEqUsize(r[0], 2, "first");
  assertEqUsize(r[3], 5, "last");
}

@Test
function sumBasics(): void {
  const none: int[] = [];
  assertEq(sum(none), 0, "empty");
  assertEq(sum([7]), 7, "one");
  assertEq(sum([1, 2, 3, 4]), 10, "four");
  assertEq(sum([5, -5, 3]), 3, "negative");
}

@Test
function sumByBasics(): void {
  const items: Item[] = [Item { price: 3, qty: 2 }, Item { price: 10, qty: 1 }];
  assertEq(sumBy(items, it => it.price * it.qty), 16, "line items");
  const none: Item[] = [];
  assertEq(sumBy(none, it => it.price), 0, "empty");
  assertEq(sumBy([1, 2, 3], x => x * x), 14, "squares");
}

// The quantifier idiom: for all i in a range, with a closure over the array.
@Test
function quantifierIdiom(): void {
  const xs = [1, 2, 2, 5];
  assertEqBool(range(1, xs.length).every(i => xs[i - 1] <= xs[i]), true, "sorted");
  assertEqBool(range(1, xs.length).every(i => xs[i - 1] < xs[i]), false, "not strictly sorted");
  assertEqBool(range(0, xs.length).some(i => xs[i] == 5), true, "some");
  assertEqBool(range(0, 0).every(i => false), true, "every over nothing");
  assertEqBool(range(0, 0).some(i => true), false, "some over nothing");
}
