// String and array helpers.

// Single-quote a string for /bin/sh: the result is one word that holds `s` (every `'` is closed, escaped and reopened).
@Ensures(result.startsWith("'") && result.endsWith("'") && result.length >= s.length + 2)
export function shq(s: string): string {
  return "'" + s.split("'").join("'\\''") + "'";
}

// `s` cut to `n` bytes, with a note of how many were dropped.
@Ensures(s.length <= n ==> result == s)
@Ensures(s.length > n ==> result.startsWith(s.substring(0, n)) && result.endsWith(" bytes]"))
export function trunc(s: string, n: usize): string {
  if (s.length <= n) {
    return s;
  }
  return s.substring(0, n) + "...[truncated " + (s.length - n).toString() + " bytes]";
}

// Number of "\n" bytes in `s`.
export function countNewlines(s: string): usize {
  let n: usize = 0;
  let i: usize = 0;
  while (i < s.length) {
    if (s.charCodeAt(i) == 10) {
      n += 1;
    }
    i += 1;
  }
  return n;
}

export type LineCol = { line: usize; col: usize; };

// 1-based line and column (both in bytes) of `offset` in `text`; an offset past the end counts as the end.
// A column never exceeds the clamped offset + 1, and a line number never exceeds the line count of `text`.
@Ensures(result.line >= 1 && result.col >= 1)
@Ensures(result.col <= (offset < text.length ? offset : text.length) + 1)
@Ensures(result.line <= countNewlines(text) + 1)
export function lineCol(text: string, offset: usize): LineCol {
  const stop = offset < text.length ? offset : text.length;
  let line: usize = 1;
  let col: usize = 1;
  let i: usize = 0;
  while (i < stop) {
    if (text.charCodeAt(i) == 10) {
      line += 1;
      col = 1;
    } else {
      col += 1;
    }
    i += 1;
  }
  return LineCol { line: line, col: col };
}

// `xs` with `x` appended unless it is already there.
export function addUnique(xs: string[], x: string): string[] {
  let out = xs;
  if (!out.includes(x)) {
    out.push(x);
  }
  return out;
}

export function hasStr(xs: string[], s: string): bool {
  return xs.includes(s);
}

export function hasUsize(xs: usize[], x: usize): bool {
  return xs.includes(x);
}

// Prints a command's usage text to stderr and returns the usage exit status (2).
export function usageError(text: string): int {
  console.error(text);
  return 2;
}
