type Employee = { name: string; salary: float; };

function main(): void {
  let groups = new Map<string, int[]>();
  groups.set("even", []);
  groups.set("odd", []);
  let i = 0;
  while (i < 7) {
    const key = i % 2 == 0 ? "even" : "odd";
    let cur = groups.get(key).unwrap();
    cur.push(i);
    groups.set(key, cur);
    i += 1;
  }
  console.log(groups.get("even").unwrap().map(x => x.toString()).join(","));
  console.log(groups.get("odd").unwrap().map(x => x.toString()).join(","));

  let staff = new Map<string, Employee>();
  staff.set("e1", Employee { name: "Ada", salary: 100.5 });
  staff.set("e2", Employee { name: "Bob", salary: 80.25 });
  let total = 0.0;
  for (const e of staff.entries()) {
    total += e.value.salary;
  }
  console.log(total.toString());
  console.log(staff.get("e2").unwrap().name);

  let outer = new Map<string, Map<string, int>>();
  let inner = new Map<string, int>();
  inner.set("x", 1);
  outer.set("first", inner);
  inner.set("y", 2);
  outer.set("second", inner);
  console.log(outer.get("first").unwrap().size.toString());
  console.log(outer.get("second").unwrap().size.toString());
  console.log(inner.size.toString());
}
