// Closures in contract clauses (ADR-0031 A4) are erased without a trace: tools/test_contract_erasure.py compiles
// this file with and without its clause lines and requires byte-identical output (the lifted closures of the clauses
// must not shift the names or ids of the closures in the bodies).
function isPositive(x: int): bool {
  return x > 0;
}

@Requires(xs.every(x => isPositive(x)))
@Ensures(result.length == xs.length && result.every(y => y > limit))
function lift(xs: int[], limit: int): int[] {
  return xs.map(x => x + limit);
}

@Ensures(result.some(x => x == 3))
function seq(): int[] {
  return [1, 2, 3].filter(x => x > 0);
}

function main(): void {
  console.log(lift([1, 2], 10).length.toString());
  console.log(seq().map(x => x * 2).length.toString());
}
