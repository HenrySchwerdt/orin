// Well-formedness predicates of lowered MIR. They are stated once here and used in the `@Requires` / `@Ensures` /
// `@Invariant` clauses of the lowering (builder.or, state.or, lowerer.or, lower.or) and in its tests. They are
// deliberately independent of the lowering code (and weaker than the verifier's `wf.or`: they are about what the lowering
// itself must guarantee, not about ownership).

import { Type, Local } from "../hir";
import { MType, MLocal, Operand, Instr, Terminator, MBlock, MFunction, MProgram, hasSpan } from "../mir";
import { mty, isVoidTy, mtyEq, mtyIsRef } from "./util";

// ---------------------------------------------------------------- operands, locals and strings of an instruction

function operandLocals(o: Operand): usize[] {
  return match (o) {
    OLocal(l) => [l],
    _ => []
  };
}

function opsLocals(os: Operand[]): usize[] {
  let out: usize[] = [];
  for (const o of os) {
    match (o) {
      OLocal(l) => {
        out.push(l);
      },
      _ => {}
    }
  }
  return out;
}

function optLocals(d: Option<usize>): usize[] {
  return match (d) {
    Some(x) => [x],
    None => []
  };
}

// Every local an instruction defines or uses (destinations, source locals, local operands).
export function instrLocals(i: Instr): usize[] {
  return match (i) {
    ICopy(d, o) => [d].concat(operandLocals(o)),
    IMove(d, s) => [d, s],
    IBorrow(d, s) => [d, s],
    IDup(d, o) => [d].concat(operandLocals(o)),
    IRelease(x) => [x],
    IUnary(d, _, o) => [d].concat(operandLocals(o)),
    IBinary(d, _, a, b) => [d].concat(operandLocals(a)).concat(operandLocals(b)),
    ICall(d, _, args) => optLocals(d).concat(opsLocals(args)),
    IBuiltin(d, _, args) => optLocals(d).concat(opsLocals(args)),
    IStrAppend(x, y) => [x].concat(operandLocals(y)),
    IStructNew(d, _, slots) => [d].concat(opsLocals(slots)),
    INullary(d, _) => [d],
    ITag(d, o) => [d].concat(operandLocals(o)),
    IGetField(d, o, _) => [d].concat(operandLocals(o)),
    ISetField(x, _, v) => [x].concat(operandLocals(v)),
    ITakeField(d, x, _) => [d, x],
    IPutField(x, _, s) => [x, s],
    IMakeUnique(x) => [x],
    IArrayNew(d, _, es) => [d].concat(opsLocals(es)),
    IArrayGet(d, a, i2) => [d].concat(operandLocals(a)).concat(operandLocals(i2)),
    IArraySet(x, i2, v) => [x].concat(operandLocals(i2)).concat(operandLocals(v)),
    IArrayTake(d, x, i2) => [d, x].concat(operandLocals(i2)),
    IArrayPut(x, i2, s) => [x, s].concat(operandLocals(i2)),
    IArrayPush(x, v) => [x].concat(operandLocals(v)),
    IArrayPop(d, x) => [d, x],
    IClosure(d, _, caps) => [d].concat(opsLocals(caps)),
    ICallIndirect(d, f, args) => optLocals(d).concat(operandLocals(f)).concat(opsLocals(args)),
    IIface(d, _, v) => [d].concat(operandLocals(v)),
    ICallVirtual(d, r, _, args) => optLocals(d).concat(operandLocals(r)).concat(opsLocals(args))
  };
}

// Every operand of an instruction.
export function instrOperands(i: Instr): Operand[] {
  return match (i) {
    ICopy(_, o) => [o],
    IMove(_, _) => [],
    IBorrow(_, _) => [],
    IDup(_, o) => [o],
    IRelease(_) => [],
    IUnary(_, _, o) => [o],
    IBinary(_, _, a, b) => [a, b],
    ICall(_, _, args) => args,
    IBuiltin(_, _, args) => args,
    IStrAppend(_, y) => [y],
    IStructNew(_, _, slots) => slots,
    INullary(_, _) => [],
    ITag(_, o) => [o],
    IGetField(_, o, _) => [o],
    ISetField(_, _, v) => [v],
    ITakeField(_, _, _) => [],
    IPutField(_, _, _) => [],
    IMakeUnique(_) => [],
    IArrayNew(_, _, es) => es,
    IArrayGet(_, a, i2) => [a, i2],
    IArraySet(_, i2, v) => [i2, v],
    IArrayTake(_, _, i2) => [i2],
    IArrayPut(_, i2, _) => [i2],
    IArrayPush(_, v) => [v],
    IArrayPop(_, _) => [],
    IClosure(_, _, caps) => caps,
    ICallIndirect(_, f, args) => [f].concat(args),
    IIface(_, _, v) => [v],
    ICallVirtual(_, r, _, args) => [r].concat(args)
  };
}

// The locals a terminator reads.
export function termLocals(t: Terminator): usize[] {
  return match (t) {
    TGoto(_) => [],
    TBranch(c, _, _) => operandLocals(c),
    TSwitch(o, _, _) => operandLocals(o),
    TReturn(o) => match (o) {
      Some(x) => operandLocals(x),
      None => []
    },
    TTrap(_) => []
  };
}

// The blocks a terminator can continue in.
export function successors(t: Terminator): usize[] {
  return match (t) {
    TGoto(a) => [a],
    TBranch(_, a, b) => [a, b],
    TSwitch(_, cases, d) => cases.map(k => k.target).concat([d]),
    TReturn(_) => [],
    TTrap(_) => []
  };
}

function strBelow(o: Operand, n: usize): bool {
  return match (o) {
    OStr(k) => k < n,
    _ => true
  };
}

// ---------------------------------------------------------------- blocks

// Every local that an instruction or terminator of `blocks` mentions is declared (index below `n`).
export function blocksLocalsBelow(blocks: MBlock[], n: usize): bool {
  return blocks.every(b => b.instrs.every(i => instrLocals(i).every(l => l < n)) && termLocals(b.term).every(l => l < n));
}

// Every string literal operand of `blocks` indexes the string table (`n` entries).
export function blocksStrsBelow(blocks: MBlock[], n: usize): bool {
  return blocks.every(b => b.instrs.every(i => instrOperands(i).every(o => strBelow(o, n))));
}

// Every branch target is a block of the function (`blocks.length` blocks).
export function blockTargetsInRange(blocks: MBlock[]): bool {
  return blocks.every(b => successors(b.term).every(t => t < blocks.length));
}

// Every block can be reached from block 0 (an independent depth-first search; the lowering drops dead code, so
// nothing it returns is unreachable). Empty block lists are vacuously reachable.
export function allReachable(blocks: MBlock[]): bool {
  const n = blocks.length;
  if (n == 0) {
    return true;
  }
  let seen: bool[] = [];
  let i: usize = 0;
  while (i < n) {
    seen.push(false);
    i += 1;
  }
  let stack: usize[] = [0];
  seen[0] = true;
  while (stack.length > 0) {
    const b = stack.pop().unwrap();
    for (const t of successors(blocks[b].term)) {
      if (t < n && !seen[t]) {
        seen[t] = true;
        stack.push(t);
      }
    }
  }
  return seen.every(s => s);
}

// Every instruction and terminator has a source position, one span per instruction.
export function spansComplete(blocks: MBlock[]): bool {
  return blocks.every(b => b.spans.length == b.instrs.length && b.spans.every(s => hasSpan(s)) && hasSpan(b.termSpan));
}

// The first locals of `ml` are the HIR locals, with the MIR type of their HIR type.
export function localsMatchHir(hl: Local[], ml: MLocal[]): bool {
  if (ml.length < hl.length) {
    return false;
  }
  let i: usize = 0;
  while (i < hl.length) {
    if (!mtyEq(ml[i].ty, mty(hl[i].ty))) {
      return false;
    }
    i += 1;
  }
  return true;
}

// `op` can stand for a value of the HIR type `ty` in the locals `ls`: a local has the MIR type of `ty`, a constant is of the
// right scalar class, a string literal is a reference. A `void` value has no operand to check.
export function operandMatches(ls: MLocal[], op: Operand, ty: Type): bool {
  if (isVoidTy(ty)) {
    return true;
  }
  const want = mty(ty);
  return match (op) {
    OLocal(l) => l < ls.length && mtyEq(ls[l].ty, want),
    OInt(_) => mtyEq(want, MInt),
    OUsize(_) => mtyEq(want, MUsize),
    OBool(_) => mtyEq(want, MBool),
    OFloat(_) => mtyEq(want, MFloat),
    OStr(_) => mtyIsRef(want)
  };
}

// What the lowering guarantees about one function: locals declared, branch targets in range, no unreachable block,
// every string literal in the table, a source position everywhere.
export function fnWellLowered(f: MFunction, nStrs: usize): bool {
  return blocksLocalsBelow(f.blocks, f.locals.length)
    && blockTargetsInRange(f.blocks)
    && allReachable(f.blocks)
    && blocksStrsBelow(f.blocks, nStrs)
    && spansComplete(f.blocks);
}

export function progWellLowered(p: MProgram): bool {
  return p.functions.every(f => fnWellLowered(f, p.strings.length));
}
