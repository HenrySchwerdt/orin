function main(): void {
  let m = new Map<int, int>();
  let i = 0;
  while (i < 200) {
    m.set(i, i * i);
    i += 1;
  }
  let removed = 0;
  i = 0;
  while (i < 200) {
    if (i % 3 != 0) {
      if (m.delete(i)) {
        removed += 1;
      }
    }
    i += 1;
  }
  console.log(removed.toString());
  console.log(m.size.toString());
  console.log(m.get(3).unwrap().toString());
  console.log(m.get(4).isNone().toString());
  console.log(m.get(198).unwrap().toString());
  const ks = m.keys();
  console.log(ks.length.toString());
  console.log(ks[0].toString() + " " + ks[1].toString() + " " + ks[66].toString());
  i = 0;
  while (i < 200) {
    m.set(i, -i);
    i += 1;
  }
  console.log(m.size.toString());
  console.log(m.get(4).unwrap().toString());
  console.log(m.get(3).unwrap().toString());
  console.log(m.keys()[0].toString() + " " + m.keys()[1].toString() + " " + m.keys()[199].toString());
  i = 0;
  while (i < 200) {
    m.delete(i);
    i += 1;
  }
  console.log(m.size.toString());
  console.log(m.keys().length.toString());
  m.set(1, 1);
  console.log(m.size.toString() + " " + m.get(1).unwrap().toString());
}
