// Interfaces and implementing classes pass through a re-export unchanged.
import { Counter, Fixed } from "./index";

function total(cs: Counter[]): int {
  let t = 0;
  for (const c of cs) {
    t += c.count();
  }
  return t;
}

function main(): void {
  console.log(total([new Fixed(4), new Fixed(5)]).toString());
}
