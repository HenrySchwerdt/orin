function main(): void {
  const a: Option<int> = Some(5);
  const b: Option<int> = None;
  console.log(a.isSome().toString());
  console.log(a.isNone().toString());
  console.log(b.isSome().toString());
  console.log(b.isNone().toString());
  console.log(a.unwrap().toString());
  console.log(a.unwrapOr(7).toString());
  console.log(b.unwrapOr(7).toString());
  const s: Option<string> = Some("hi");
  console.log(s.unwrap());
  const n: Option<string> = None;
  console.log(n.unwrapOr("dflt"));
  const xs = [4, 5];
  console.log(xs.get(1).unwrap().toString());
  console.log(xs.get(9).unwrapOr(0).toString());
}
