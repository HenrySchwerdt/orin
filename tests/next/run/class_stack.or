// A stack class: array field with push/pop; `pop` is mutating with a result.
class Stack {
  private items: int[] = [];
  push(x: int): void {
    this.items.push(x);
  }
  pop(): Option<int> {
    return this.items.pop();
  }
  size(): usize {
    return this.items.length;
  }
  peekOr(d: int): int {
    if (this.items.length == 0) {
      return d;
    }
    return this.items[this.items.length - 1];
  }
}

function drain(s: Stack): int {
  let t = s;
  let sum = 0;
  while (t.size() > 0) {
    sum += t.pop().unwrapOr(0);
  }
  return sum;
}

function main(): void {
  let s = new Stack();
  s.push(1);
  s.push(2);
  s.push(3);
  console.log(s.peekOr(0).toString() + " " + s.size().toString());
  const v = s.pop();
  console.log(v.unwrap().toString() + " " + s.size().toString());
  console.log(drain(s).toString() + " " + s.size().toString());
  console.log(s.pop().isNone().toString() + " " + s.peekOr(99).toString());
}
