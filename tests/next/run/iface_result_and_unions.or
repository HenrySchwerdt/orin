// Interface values inside unions and Result payloads; methods returning interface values.
interface Shape {
  area(): int;
  scaled(k: int): Shape;
}

class Sq implements Shape {
  constructor(public s: int) {}
  area(): int { return this.s * this.s; }
  scaled(k: int): Shape { return new Sq(this.s * k); }
}

type Tree = Leaf(Shape) | Node(Tree, Tree);

function sum(t: Tree): int {
  return match (t) {
    Leaf(s) => s.area(),
    Node(a, b) => sum(a) + sum(b)
  };
}

function check(k: int): Result<Shape, string> {
  if (k < 0) {
    return Err("negative");
  }
  return Ok(new Sq(k));
}

function main(): void {
  const t = Node(Leaf(new Sq(1)), Node(Leaf(new Sq(2)), Leaf(new Sq(3).scaled(2))));
  console.log(sum(t).toString());
  console.log(check(3).unwrap().scaled(2).area().toString());
  console.log(check(0 - 1).isErr().toString());
}
