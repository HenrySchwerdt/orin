type Acc = { vals: float[]; total: float; };

function addTo(a: Acc, v: float): Acc {
  let r = a;
  r.vals.push(v);
  r.total += v;
  return r;
}

function main(): void {
  let a = Acc { vals: [], total: 0.0 };
  a = addTo(a, 1.5);
  a = addTo(a, 2.5);
  const snap = a;
  a = addTo(a, 10.0);
  console.log(snap.vals.length.toString() + " " + snap.total.toString());
  console.log(a.vals.length.toString() + " " + a.total.toString());
  let xs: float[] = [1.0, 2.0];
  const ys = xs;
  xs[0] = 5.5;
  console.log(xs[0].toString() + " " + ys[0].toString());
}
