r-radius: 999px; background: var(--ex-tint); color: var(--r-accent); font-size: 0.8rem; font-weight: 550; line-height: 1.5; }\n.bz-chip-more { background: none; color: var(--r-ink-2); }\n.bz-chip-area { margin-left: 0.6rem; background: var(--r-info-bg); color: var(--r-info-fg); font-size: 0.72rem; font-weight: 650; text-transform: uppercase; letter-spacing: 0.05em; }\n.bz-area-network, .bz-area-programs, .bz-area-system { background: var(--r-regression-bg); color: var(--r-regression-fg); }\n.bz-area-files { background: var(--r-unproven-bg); color: var(--r-unproven-fg); }\n.bz-area-time, .bz-area-console, .bz-area-parallel-work { background: var(--r-info-bg); color: var(--r-info-fg); }\n.bz-area-not-known { background: var(--r-failed-bg); color: var(--r-failed-fg); }\n.bz-rules { display: grid; gap: 0.7rem; margin: 0.75rem 0 0; padding: 0; list-style: none; }\n.bz-rule { padding: 0.85rem 1.1rem 0.8rem; background: var(--r-surface); border: 1px solid var(--r-line); border-left: 4px solid var(--r-line); border-radius: 12px; }\n.bz-r-proved { border-left-color: var(--r-passed-fg); }\n.bz-r-runtime { border-left-color: var(--r-improvement-fg); }\n.bz-r-open { border-left-color: var(--r-regression-fg); }\n.bz-sentence { margin: 0 0 0.45rem; font-size: 1.08rem; line-height: 1.4; font-weight: 520; max-width: 70ch; }\n.bz-a { display: inline-block; padding: 0 0.6rem; border-radius: 999px; font-size: 0.72rem; font-weight: 700; line-height: 1.6; letter-spacing: 0.02em; cursor: help; }\n.bz-a-proved { background: var(--r-passed-bg); color: var(--r-passed-fg); }\n.bz-a-runtime { background: var(--r-improvement-bg); color: var(--r-improvement-fg); }\n.bz-a-open { background: var(--r-regression-bg); color: var(--r-regression-fg); }\n.bz-a-unknown { background: var(--r-info-bg); color: var(--r-info-fg); }\n.bz-legend { display: grid; grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); gap: 0.75rem 1.5rem; margin: 1.25rem 0 0; padding: 0; list-style: none; font-size: 0.86rem; color: var(--r-ink-2); }\n.bz-legend li { display: flex; flex-direction: column; gap: 0.3rem; align-items: flex-start; }\n.bz-notice { margin: 1.25rem 0 0; padding: 0.7rem 1rem; border: 1px solid var(--r-line); border-left: 4px solid var(--r-unproven-fg); border-radius: 10px; background: var(--r-surface); max-width: 75ch; }\n.bz-caplines { display: grid; gap: 0.6rem; margin: 0.75rem 0 0; padding: 0; list-style: none; }\n.bz-capline { padding: 0.75rem 1.1rem; background: var(--r-surface); border: 1px solid var(--r-line); border-left: 4px solid var(--ex-effect); border-radius: 12px; }\n.bz-capline-head { margin: 0 0 0.25rem; font-size: 1.05rem; font-weight: 520; }\n.bz-may { font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.07em; color: var(--ex-effect); }\n.bz-changes { display: grid; gap: 0.6rem; margin: 0.75rem 0 0; padding: 0; list-style: none; }\n.bz-change { display: grid; grid-template-columns: 5.5rem minmax(0, 1fr) auto; gap: 0.9rem; align-items: start; padding: 0.8rem 1.1rem; background: var(--r-surface); border: 1px solid var(--r-line); border-radius: 12px; }\n.bz-op { display: inline-block; justify-self: start; padding: 0 0.6rem; border-radius: 999px; font-size: 0.72rem; font-weight: 700; line-height: 1.7; text-transform: uppercase; letter-spacing: 0.05em; }\n.bz-c-added .bz-op { background: var(--r-passed-bg); color: var(--r-passed-fg); }\n.bz-c-removed .bz-op { background: var(--r-failed-bg); color: var(--r-failed-fg); }\n.bz-c-changed .bz-op { background: var(--r-regression-bg); color: var(--r-regression-fg); }\n.bz-ch-head { margin: 0; font-size: 1.05rem; font-weight: 520; line-height: 1.4; }\n.bz-ch-detail { margin: 0.2rem 0 0; font-size: 0.88rem; color: var(--r-ink-2); }\n.bz-ch-link { font-size: 0.82rem; white-space: nowrap; }\n.bz-glossary { display: grid; grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr)); gap: 1rem 1.5rem; margin: 0.5rem 0 0; }\n.bz-glossary dt { font-weight: 650; }\n.bz-glossary dd { m