import { assert, assertEq, assertEqBool, assertEqString } from "std:test";
import {
  MonotonicInstant, Deadline, milliseconds, elapsed, deadlineAfter, remaining, isExpired,
  timeErrorMessage,
} from "std:time";

export function checkMonotonicArithmetic(): void {
  const max: int = 9223372036854775807;
  const min: int = -9223372036854775807 - 1;
  const zero = MonotonicInstant { millis: 0 };
  const top = MonotonicInstant { millis: max };
  const bad = MonotonicInstant { millis: min };
  const end = deadlineAfter(zero, milliseconds(max)).unwrap();
  assertEq(end.at.millis, max, "largest representable deadline");
  assertEq(deadlineAfter(top, milliseconds(0)).unwrap().at.millis, max, "zero delay at maximum");
  assertEq(elapsed(zero, top).unwrap().millis, max, "largest elapsed span");
  assertEq(elapsed(top, top).unwrap().millis, 0, "equal observations");
  assertEq(remaining(end, zero).unwrap().millis, max, "largest remaining span");
  assertEq(remaining(end, top).unwrap().millis, 0, "equal deadline expired");
  assertEqBool(isExpired(end, top).unwrap(), true, "expiry is inclusive");
  assertEqBool(isExpired(end, zero).unwrap(), false, "future deadline");
  const immediate = deadlineAfter(zero, milliseconds(0)).unwrap();
  assertEq(remaining(immediate, top).unwrap().millis, 0, "expired clamps before subtracting");
  assertEqBool(isExpired(immediate, top).unwrap(), true, "past deadline");
  const ten = MonotonicInstant { millis: 10 };
  const later = deadlineAfter(ten, milliseconds(5)).unwrap();
  assertEq(later.at.millis, 15, "deadline sum");
  assertEq(remaining(later, ten).unwrap().millis, 5, "remaining milliseconds");
  assertEq(elapsed(ten, later.at).unwrap().millis, 5, "elapsed inverse");
  assertEqString(
    timeErrorMessage(deadlineAfter(top, milliseconds(1)).unwrapErr()),
    "monotonic deadline overflow",
    "overflow",
  );
  assertEqString(
    timeErrorMessage(deadlineAfter(ten, milliseconds(max)).unwrapErr()),
    "monotonic deadline overflow",
    "large delay",
  );
  assertEqString(
    timeErrorMessage(deadlineAfter(zero, milliseconds(-1)).unwrapErr()),
    "deadline delay must be nonnegative",
    "negative delay",
  );
  assertEqString(
    timeErrorMessage(deadlineAfter(zero, milliseconds(min)).unwrapErr()),
    "deadline delay must be nonnegative",
    "minimum delay",
  );
  assertEqString(
    timeErrorMessage(elapsed(top, zero).unwrapErr()),
    "monotonic observations are reversed",
    "reversed",
  );
  assertEqString(
    timeErrorMessage(elapsed(bad, zero).unwrapErr()),
    "monotonic milliseconds must be nonnegative",
    "invalid start",
  );
  assert(elapsed(zero, bad).isErr(), "invalid end");
  assert(deadlineAfter(bad, milliseconds(0)).isErr(), "invalid deadline origin");
  assert(remaining(Deadline { at: bad }, zero).isErr(), "invalid deadline");
  assert(remaining(immediate, bad).isErr(), "invalid now");
  assert(isExpired(Deadline { at: bad }, zero).isErr(), "invalid expiry deadline");
  assert(isExpired(immediate, bad).isErr(), "invalid expiry observation");
}

@Test
function monotonicArithmeticIsChecked(): void {
  checkMonotonicArithmetic();
}
