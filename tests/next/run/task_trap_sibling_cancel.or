// exit: 101
// stderr: trap: task panicked: unwrap on None
// std:task, trap-safe cleanup (C2): a child that traps cancels its scope, so the siblings that are still running stop at their next
// checkpoint (`isCancelled`); the scope waits for all of them and then traps with the message of the failure. (Before C2 the sibling
// never saw the cancellation and the program hung.)
import { scope, spawn, isCancelled } from "std:task";

function main(): void {
  scope(s => {
    spawn(s, () => {
      while (!isCancelled()) {
      }
      console.log("sibling: cancelled by the trap of another task of the scope");
      return 0;
    });
    spawn(s, () => {
      const none: Option<int> = None;
      return none.unwrap();
    });
    console.log("body: done");
    return 0;
  });
  console.log("not reached");
}
