// Round trip and error reporting of the generated `@Json` codecs.
import { stringify, parse } from "std:json/legacy";
import { User, Address } from "./models";
import { encodeUser, decodeUser, encodeAddress } from "./models.gen";

function show(text: string): void {
  const parsed = parse(text);
  if (parsed.isErr()) {
    console.log("parse error");
    return;
  }
  const r = decodeUser(parsed.unwrap());
  if (r.isErr()) {
    console.log("decode error: " + r.unwrapErr());
    return;
  }
  console.log("decoded " + r.unwrap().name);
}

function main(): void {
  const ann = User {
    id: 1,
    name: "Ann",
    admin: true,
    tags: ["a", "b"],
    nick: Some("annie"),
    address: Address { street: "Main St", zip: 12345 },
    previous: [Address { street: "Old Rd", zip: 1 }],
    scores: None,
  };
  const text = stringify(encodeUser(ann));
  console.log(text);
  const back = decodeUser(parse(text).unwrap()).unwrap();
  console.log(stringify(encodeUser(back)) == text ? "round trip ok" : "round trip differs");
  console.log(stringify(encodeAddress(back.address)));
  console.log(back.nick.unwrapOr("-"));
  console.log(back.previous[0].street);

  // Optional fields may be absent or null.
  show(
    "{\"id\":2,\"display_name\":\"Bob\",\"admin\":false,\"tags\":[],\"address\":{\"street\":\"S\",\"zip\":2},\"previous\":[],\"scores\":[1,2,3]}",
  );
  // Malformed input: a path says where.
  show(
    "{\"id\":2,\"display_name\":\"Bob\",\"admin\":false,\"tags\":[],\"address\":{\"street\":\"S\",\"zip\":\"x\"},\"previous\":[]}",
  );
  show(
    "{\"id\":2,\"admin\":false,\"tags\":[],\"address\":{\"street\":\"S\",\"zip\":2},\"previous\":[]}",
  );
  show(
    "{\"id\":2,\"display_name\":\"Bob\",\"admin\":false,\"tags\":[\"a\",3],\"address\":{\"street\":\"S\",\"zip\":2},\"previous\":[]}",
  );
  show("[1,2]");
}
