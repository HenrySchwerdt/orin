// flags: --check-contracts
// Same program as contracts_erased with runtime checking: every contract holds.
@Rule("SHOP-001")
@Requires(cents >= 0)
@Ensures(result >= 0 && result <= cents)
@Ensures(premium ==> result * 2 <= cents)
function discount(cents: int, premium: bool): int {
  if (premium) {
    return cents / 2;
  }
  return cents;
}

function abs(x: int): int {
  return x < 0 ? -x : x;
}

@Requires(n >= 0)
@Decreases(n)
@Ensures(result >= 1)
function factorial(n: int): int {
  if (n == 0) {
    return 1;
  }
  return n * factorial(n - 1);
}

@Invariant(this.balance >= 0)
class Account {
  balance: int;
  private log: string[] = [];

  @Requires(initial >= 0)
  constructor(initial: int) {
    this.balance = initial;
  }

  @Requires(amount > 0 && amount <= this.balance)
  @Ensures(this.balance == old(this.balance) - amount)
  withdraw(amount: int): void {
    this.balance -= amount;
    this.log.push("w");
  }

  @Requires(amount > 0)
  @Ensures(this.balance == old(this.balance) + amount)
  @Ensures(result == this.balance)
  deposit(amount: int): int {
    this.balance += amount;
    return this.balance;
  }

  @Ensures(result == this.log.length)
  count(): usize {
    return this.log.length;
  }
}

@Invariant(this.lo <= this.hi)
type Range = { lo: int; hi: int; };

@Requires(r.hi - r.lo >= 0)
@Ensures(result == r.hi - r.lo)
function width(r: Range): int {
  return r.hi - r.lo;
}

@Ensures(abs(result) == abs(x))
function negate(x: int): int {
  return -x;
}

function main(): void {
  console.log(discount(100, true).toString());
  console.log(discount(100, false).toString());
  console.log(factorial(5).toString());
  let a = new Account(10);
  a.withdraw(3);
  console.log(a.deposit(5).toString());
  console.log(a.count().toString());
  console.log(width(Range { lo: 2, hi: 9 }).toString());
  console.log(negate(4).toString());
  let i = 0;
  let sum = 0;
  @Invariant(i >= 0 && i <= 5)
  @Invariant(sum >= 0)
  @Decreases(5 - i)
  while (i < 5) {
    sum += i;
    i += 1;
  }
  console.log(sum.toString());
}
