// `a.inner.bump()` mutates a field of a class-typed field in place of the owner.
class Inner {
  constructor(public hits: int) {}
  bump(): void {
    this.hits += 1;
  }
}

class Outer {
  constructor(public inner: Inner, public label: string) {}
  poke(): void {
    this.inner.bump();
  }
  hits(): int {
    return this.inner.hits;
  }
}

function main(): void {
  let a = new Outer(new Inner(0), "a");
  a.inner.bump();
  a.poke();
  const b = a;
  a.poke();
  a.inner.bump();
  console.log(a.hits().toString() + " " + b.hits().toString());
  let list = [new Outer(new Inner(5), "x"), new Outer(new Inner(6), "y")];
  list[1].inner.bump();
  list[0].poke();
  console.log(list[0].hits().toString() + " " + list[1].hits().toString());
}
