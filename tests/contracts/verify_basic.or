// Inputs for tools/test_verify_contracts.py (orin verify --contracts). Expected statuses are in the
// `// expect:` lines: `function kind status`.
// expect: discount ensures VERIFIED
// expect: discount ensures VERIFIED
// expect: bad_max ensures FAILED
// expect: max ensures VERIFIED
// expect: max ensures VERIFIED
// expect: clamp ensures VERIFIED
// expect: abs ensures VERIFIED
// expect: abs_overflow_free ensures VERIFIED
// expect: use_clamp call-precondition VERIFIED
// expect: fact call-precondition VERIFIED
// expect: use_clamp ensures VERIFIED
// expect: bad_call call-precondition FAILED
// expect: counter ensures VERIFIED
// expect: sum_to ensures UNKNOWN
// expect: wrong_div ensures FAILED
// expect: modulo ensures VERIFIED
// expect: implies ensures VERIFIED
// expect: fact ensures VERIFIED
// expect: fact decreases UNKNOWN
// expect: with_string ensures UNKNOWN

@Rule("SHOP-001")
@Requires(cents >= 0)
@Ensures(result >= 0 && result <= cents)
@Ensures(premium ==> result * 2 <= cents)
function discount(cents: int, premium: bool): int {
  if (premium) {
    return cents / 2;
  }
  return cents;
}

@Ensures(result >= a && result >= b)
@Ensures(result == a || result == b)
function max(a: int, b: int): int {
  if (a > b) {
    return a;
  }
  return b;
}

// Wrong: the result can be smaller than a.
@Ensures(result >= a)
function bad_max(a: int, b: int): int {
  if (a > b) {
    return b;
  }
  return a;
}

@Requires(lo <= hi)
@Ensures(result >= lo && result <= hi)
function clamp(x: int, lo: int, hi: int): int {
  let r = x;
  if (r < lo) {
    r = lo;
  }
  if (r > hi) {
    r = hi;
  }
  return r;
}

@Ensures(result >= 0)
function abs(x: int): int {
  return x < 0 ? -x : x;
}

// The most negative int would trap on negation, so a normal return implies x != i64 min.
@Ensures(result >= 0 && (result == x || result == -x))
function abs_overflow_free(x: int): int {
  if (x < 0) {
    return -x;
  }
  return x;
}

@Ensures(result >= 0 && result <= 10)
function use_clamp(v: int): int {
  return clamp(v, 0, 10);
}

function bad_call(v: int): int {
  return clamp(v, 5, 1);
}

@Ensures(result == n + 3)
function counter(n: int): int {
  let c = n;
  c += 1;
  c += 2;
  return c;
}

@Ensures(result == n * (n + 1) / 2)
function sum_to(n: int): int {
  let i = 0;
  let s = 0;
  while (i < n) {
    i += 1;
    s += i;
  }
  return s;
}

// Truncating division: -7 / 2 == -3, so the result is not floor(a / b) for negative a.
@Requires(b > 0)
@Ensures(result * b <= a)
function wrong_div(a: int, b: int): int {
  return a / b;
}

@Requires(b > 0)
@Ensures(result > -b && result < b)
function modulo(a: int, b: int): int {
  return a % b;
}

@Ensures(a > 0 ==> result > 0)
function implies(a: int): int {
  if (a > 0) {
    return a;
  }
  return 1;
}

@Requires(n >= 0 && n <= 20)
@Decreases(n)
@Ensures(result >= 1)
function fact(n: int): int {
  if (n == 0) {
    return 1;
  }
  return n * fact(n - 1);
}

@Ensures(result >= 0)
function with_string(s: string): int {
  return s.length.toInt();
}

function main(): void {
  console.log(max(1, 2).toString());
}
