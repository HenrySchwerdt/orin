// Value semantics: an interface value holds a snapshot of the class value.
interface Reader {
  get(): int;
}

class Counter implements Reader {
  constructor(public n: int) {}
  get(): int { return this.n; }
  bump(): void { this.n += 1; }
}

function main(): void {
  let c = new Counter(1);
  const r: Reader = c;
  c.bump();
  c.bump();
  console.log(c.get().toString() + " " + r.get().toString());
  const r2 = r;
  let d = c;
  d.bump();
  const r3: Reader = d;
  console.log(r2.get().toString() + " " + r3.get().toString() + " " + c.get().toString());
  let rs: Reader[] = [r, r3];
  c.bump();
  rs.push(c);
  console.log(rs[0].get().toString() + rs[1].get().toString() + rs[2].get().toString());
}
