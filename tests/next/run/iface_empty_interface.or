// An interface without methods is a legal marker; conversion still boxes the value.
interface Marker {
}

class M1 implements Marker {
  constructor(public v: int) {}
}

function count(xs: Marker[]): usize {
  return xs.length;
}

function main(): void {
  const xs: Marker[] = [new M1(1), new M1(2)];
  console.log(count(xs).toString());
}
