// Text helpers for the formatter: indentation, string literal quoting, UTF-8 validity.

const HEX: string = "0123456789abcdef";

// `n` spaces.
@Ensures(result.length == n)
export function pad(n: usize): string {
  let parts: string[] = [];
  let k: usize = 0;
  while (k < n) {
    parts.push(" ");
    k += 1;
  }
  return parts.join("");
}

// True if every byte sequence in `s` is well-formed UTF-8.
export function isValidUtf8(s: string): bool {
  const n = s.length;
  let i: usize = 0;
  while (i < n) {
    const c = s.charCodeAt(i);
    let extra: usize = 0;
    if (c < 128) {
      extra = 0;
    } else if (c >= 194 && c <= 223) {
      extra = 1;
    } else if (c >= 224 && c <= 239) {
      extra = 2;
    } else if (c >= 240 && c <= 244) {
      extra = 3;
    } else {
      return false;
    }
    if (extra > 0 && i + extra >= n) {
      return false;
    }
    let k: usize = 1;
    while (k <= extra) {
      const d = s.charCodeAt(i + k);
      if (d < 128 || d > 191) {
        return false;
      }
      k += 1;
    }
    i += extra + 1;
  }
  return true;
}

function hex2(c: int): string {
  const hi = c / 16;
  const lo = c % 16;
  return HEX.charAt(hi.toUsize()) + HEX.charAt(lo.toUsize());
}

// Source spelling of a string literal with the given (unescaped) content. Bytes >= 0x80 are
// written raw when the content is valid UTF-8, else as \xHH. The literal is one line and valid UTF-8 (a formatted
// file stays valid UTF-8 and the lexer reads the literal back on one line).
@Ensures(result.startsWith("\"") && result.endsWith("\"") && result.length >= s.length + 2)
@Ensures(!result.includes("\n") && isValidUtf8(result))
export function quote(s: string): string {
  const utf8 = isValidUtf8(s);
  let parts: string[] = ["\""];
  let run: usize = 0;
  let i: usize = 0;
  while (i < s.length) {
    const ch = s.charCodeAt(i);
    let rep = "";
    if (ch == 34) {
      rep = "\\\"";
    } else if (ch == 92) {
      rep = "\\\\";
    } else if (ch == 10) {
      rep = "\\n";
    } else if (ch == 9) {
      rep = "\\t";
    } else if (ch == 13) {
      rep = "\\r";
    } else if (ch == 0) {
      rep = "\\0";
    } else if (ch < 32 || ch == 127 || (ch >= 128 && !utf8)) {
      rep = "\\x" + hex2(ch);
    }
    if (rep != "") {
      parts.push(s.substring(run, i));
      parts.push(rep);
      run = i + 1;
    }
    i += 1;
  }
  parts.push(s.substring(run, s.length));
  parts.push("\"");
  return parts.join("");
}

// Length of the last line of `s` if it spans lines, else `col` plus its length.
@Ensures(s.includes("\n") ? result < s.length : result == col + s.length)
export function endCol(s: string, col: usize): usize {
  let i = s.length;
  while (i > 0) {
    if (s.charCodeAt(i - 1) == 10) {
      return s.length - i;
    }
    i -= 1;
  }
  return col + s.length;
}
