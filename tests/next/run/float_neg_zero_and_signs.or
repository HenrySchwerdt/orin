function main(): void {
  const nz = -0.0;
  const pz = 0.0;
  console.log(nz.toString());
  console.log(pz.toString());
  console.log((nz + pz).toString());
  console.log((nz - pz).toString());
  console.log((nz * 1.0).toString());
  console.log((-nz).toString());
  console.log((1.0 / nz).toString());
  console.log((1.0 / pz).toString());
  console.log((nz == pz).toString());
  console.log(nz.toInt().toString());
  console.log((-0.4).round().toString());
  console.log((-0.4).ceil().toString());
  console.log((0.0 - 0.0).toString());
}
