// Parallel benchmark (tools/bench.py "Parallel speedup"; docs/benchmarks.md): the total number of Collatz steps of every integer in
// 1..2,000,000, computed by `parallelMap` from std:task in W tasks (one operating-system thread each, ADR-0017 stage 0).
//
// Worker count: the first command-line argument (default 1). This is the convention of every bench/parallel_* program: std:task
// has no global thread pool, a task is one OS thread, so the number of worker threads is the `parts` argument of `parallelMap`
// and the program takes it from its command line. tools/bench.py runs it with 1, 2 and 4. The output does not depend on W (the
// tool checks that), so W = 1 is the sequential baseline of the speedup.
//
//   build/bench/parallel_collatz/orin 4
import { Host, useProcess } from "std:host";
import { args } from "std:process";
import { parallelMap } from "std:task";

function collatzSteps(n: int): int {
  let x = n;
  let steps = 0;
  while (x != 1) {
    x = x % 2 == 0 ? x / 2 : 3 * x + 1;
    steps += 1;
  }
  return steps;
}

function main(host: Host): void {
  useProcess(
    host,
    proc => {
      const a = args(proc);
      const workers = a.length > 0 ? parseInt(a[0]).unwrapOr(1) : 1;
      const n = a.length > 1 ? parseInt(a[1]).unwrapOr(2000000) : 2000000;
      let xs: int[] = [];
      let i = 1;
      while (i <= n) {
        xs.push(i);
        i += 1;
      }
      const steps = parallelMap(xs, collatzSteps, workers.toUsize());
      let sum = 0;
      let longest = 0;
      for (const s of steps) {
        sum += s;
        if (s > longest) {
          longest = s;
        }
      }
      console.log(
        "collatz n=" + n.toString() + " steps " + sum.toString() + " longest " + longest.toString(),
      );
    },
  );
}
