// Generic methods (ADR-0040) and generic-class methods whose own type parameters have several bounds.
interface Weighted {
  weight(): int;
}

class Item implements Weighted, Hash {
  constructor(public id: int, public w: int) {}
  weight(): int { return this.w; }
  equals(other: Item): bool { return this.id == other.id; }
  hash(): usize { return this.id.toUsize(); }
}

class Index<K extends Hash & Ord> {
  keys: K[] = [];
  seen: Map<K, usize> = new Map<K, usize>();
  put(k: K): void {
    if (!this.seen.has(k)) {
      this.seen.set(k, this.keys.length);
      this.keys.push(k);
    }
  }
  smallest(): K {
    let best = this.keys[0];
    for (const k of this.keys) {
      if (k < best) {
        best = k;
      }
    }
    return best;
  }
  // the method's own parameters have bounds too
  heaviest<V extends Weighted & Hash>(vs: V[]): V {
    let best = vs[0];
    for (const v of vs) {
      if (v.weight() > best.weight()) {
        best = v;
      }
    }
    return best;
  }
  sameKey<A extends Ord & Hash, B extends Hash & Eq>(a: A, b: B): bool {
    return a.hash() == b.hash() && a.compare(a) == 0 && b == b;
  }
  static clamp<N extends Ord & Eq>(x: N, lo: N, hi: N): N {
    return x < lo ? lo : (x > hi ? hi : x);
  }
}

class Util {
  maxOf<T extends Ord & Hash>(a: T, b: T): T { return a >= b ? a : b; }
  count<T extends Hash & Eq>(xs: T[]): usize {
    let seen = new Map<T, bool>();
    let n: usize = 0;
    for (const x of xs) {
      if (!seen.has(x)) {
        seen.set(x, true);
        n += 1;
      }
    }
    return n;
  }
  total<W extends Weighted & Eq>(ws: W[]): int {
    let t = 0;
    for (const w of ws) {
      t += w.weight();
    }
    return t;
  }
}

function main(): void {
  let ix = new Index<string>();
  ix.put("m");
  ix.put("c");
  ix.put("m");
  ix.put("x");
  console.log(ix.smallest());
  console.log(ix.keys.length.toString());
  console.log(ix.heaviest([new Item(1, 5), new Item(2, 9), new Item(3, 2)]).id.toString());
  console.log(ix.sameKey(3, 3).toString());
  console.log(ix.sameKey(3, 4).toString());
  console.log(Index.clamp(15, 0, 10).toString());
  console.log(Index.clamp(-4, 0, 10).toString());
  const u = new Util();
  console.log(u.maxOf(3, 8).toString());
  console.log(u.maxOf("b", "a"));
  console.log(u.count([1, 2, 2, 3, 3, 3]).toString());
  console.log(u.total([new Item(1, 5), new Item(2, 9)]).toString());
}
