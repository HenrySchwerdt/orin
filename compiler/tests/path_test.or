// Assertions for compiler/loader/path.or. Prints `ok` or one line per failure (exit 1).

import { normalizePath, dirname, joinPath, relativeTo, isInside } from "../loader";
import { exit } from "std:process";

function checkS(fails: string[], what: string, got: string, want: string): string[] {
  let f = fails;
  if (got != want) {
    f.push(what + ": got `" + got + "`, want `" + want + "`");
  }
  return f;
}

function checkB(fails: string[], what: string, got: bool, want: bool): string[] {
  let f = fails;
  if (got != want) {
    f.push(what + ": got " + got.toString() + ", want " + want.toString());
  }
  return f;
}

function main(): void {
  let f: string[] = [];
  f = checkS(f, "norm 1", normalizePath("a/./b/../c"), "a/c");
  f = checkS(f, "norm 2", normalizePath("./a//b/"), "a/b");
  f = checkS(f, "norm 3", normalizePath("../a/../../b"), "../../b");
  f = checkS(f, "norm 4", normalizePath("/a/../.."), "/");
  f = checkS(f, "norm 5", normalizePath("/a//b/./c/.."), "/a/b");
  f = checkS(f, "norm 6", normalizePath("a/.."), ".");
  f = checkS(f, "norm 7", normalizePath(""), ".");
  f = checkS(f, "norm 8", normalizePath("compiler/main.or"), "compiler/main.or");
  f = checkS(f, "dirname 1", dirname("a/b/c.or"), "a/b");
  f = checkS(f, "dirname 2", dirname("c.or"), ".");
  f = checkS(f, "dirname 3", dirname("/c.or"), "/");
  f = checkS(f, "dirname 4", dirname("/a/c.or"), "/a");
  f = checkS(f, "dirname 5", dirname("./a/../c.or"), ".");
  f = checkS(f, "dirname 6", dirname("../c.or"), "..");
  f = checkS(f, "dirname 7", dirname("."), ".");
  f = checkS(f, "join 1", joinPath("a/b", "./c"), "a/b/c");
  f = checkS(f, "join 2", joinPath("a/b", "../../c"), "c");
  f = checkS(f, "join 3", joinPath(".", "x/y"), "x/y");
  f = checkS(f, "join 4", joinPath("/a", "../b"), "/b");
  f = checkS(f, "join 5", joinPath("a", "/z"), "/z");
  f = checkS(f, "join 6", joinPath("a", "../../b"), "../b");
  f = checkS(f, "rel 1", relativeTo("a/b", "a/b/c/d.or"), "c/d.or");
  f = checkS(f, "rel 2", relativeTo("a/b", "a/c.or"), "../c.or");
  f = checkS(f, "rel 3", relativeTo("a", "a"), ".");
  f = checkS(f, "rel 4", relativeTo("/x/y", "/x/z/w"), "../z/w");
  f = checkS(f, "rel 5", relativeTo(".", "a/b"), "a/b");
  f = checkS(f, "rel 6", relativeTo("a//b/", "./a/b/c"), "c");
  f = checkB(f, "inside 1", isInside("a/b", "a/b/c.or"), true);
  f = checkB(f, "inside 2", isInside("a/b", "a/bc/d.or"), false);
  f = checkB(f, "inside 3", isInside("a/b", "a/c.or"), false);
  f = checkB(f, "inside 4", isInside("/", "/a"), true);
  f = checkB(f, "inside 5", isInside("/a", "/b"), false);
  f = checkB(f, "inside 6", isInside(".", "a/b"), true);
  f = checkB(f, "inside 7", isInside(".", "../a"), false);
  f = checkB(f, "inside 8", isInside("a", "./a/../a/x"), true);
  f = checkB(f, "inside 9", isInside("..", "x.or"), true);
  f = checkB(f, "inside 10", isInside("..", "../x.or"), true);
  f = checkB(f, "inside 11", isInside("/a", "a/b"), false);
  f = checkB(f, "inside 12", isInside("a/b", "a"), false);
  if (f.length == 0) {
    console.log("ok");
  } else {
    for (const m of f) {
      console.log("FAIL " + m);
    }
    exit(1);
  }
}
