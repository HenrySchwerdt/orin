// HTML rendering, hand-written: a 2000-row product table rendered 400 times by plain string concatenation into one
// accumulating string (`out += ...`, appended in place while the string is unique). escape and safeUrl are local copies of
// what std:html will provide (same semantics). Orin only: the C / Go baselines are bench/html/main.c and main.go, which
// the JSX version bench/html/main.or must match byte for byte.
const ROWS: int = 2000;
const PAGES: int = 400;

function escape(s: string): string {
  let out = "";
  let start: usize = 0;
  let i: usize = 0;
  while (i < s.length) {
    const c = s.charCodeAt(i);
    let r = "";
    if (c == 38) {
      r = "&amp;";
    } else if (c == 60) {
      r = "&lt;";
    } else if (c == 62) {
      r = "&gt;";
    } else if (c == 34) {
      r = "&quot;";
    } else if (c == 39) {
      r = "&#39;";
    }
    if (r.length > 0) {
      out += s.substring(start, i);
      out += r;
      start = i + 1;
    }
    i += 1;
  }
  if (start == 0) {
    return s;
  }
  out += s.substring(start, s.length);
  return out;
}

function lower(s: string): string {
  let out = "";
  let i: usize = 0;
  while (i < s.length) {
    let c = s.charCodeAt(i);
    if (c >= 65 && c <= 90) {
      c += 32;
    }
    out += String.fromCharCode(c);
    i += 1;
  }
  return out;
}

function safeUrl(u: string): string {
  let i: usize = 0;
  while (i < u.length) {
    const c = u.charCodeAt(i);
    if (c == 47 || c == 63 || c == 35) {
      return u;
    }
    if (c == 58) {
      const scheme = lower(u.substring(0, i));
      if (scheme == "http" || scheme == "https" || scheme == "mailto" || scheme == "tel") {
        return u;
      }
      return "about:invalid#orin-unsafe-url";
    }
    i += 1;
  }
  return u;
}

function render(names: string[], urls: string[], prices: int[]): string {
  let out = "<html><head><title>Products</title></head><body><h1 class=\"title\">Catalog &amp; Prices</h1><table class=\"products\">";
  let i = 0;
  while (i < ROWS) {
    out += "<tr data-id=\"" + i.toString() + "\" class=\"row " + (i % 2 == 0 ? "even" : "odd") + "\">";
    out += "<td class=\"name\">" + escape(names[i.toUsize()]) + "</td>";
    out += "<td class=\"price\">" + prices[i.toUsize()].toString() + "</td>";
    out += "<td><a href=\"" + escape(safeUrl(urls[i.toUsize()])) + "\">details</a></td>";
    out += "<td><input type=\"checkbox\"" + (i % 3 == 0 ? " disabled" : "") + "></td></tr>";
    i += 1;
  }
  out += "</table><p>" + ROWS.toString() + " items</p></body></html>";
  return out;
}

function main(): void {
  let names: string[] = [];
  let urls: string[] = [];
  let prices: int[] = [];
  let i = 0;
  while (i < ROWS) {
    let n = "Item " + i.toString();
    if (i % 7 == 0) {
      n += " <b>&\"sale\"</b> it's";
    }
    names.push(n);
    urls.push(i % 11 == 0 ? "javascript:alert(" + i.toString() + ")" : "/item/" + i.toString());
    prices.push((i * 37) % 1000);
    i += 1;
  }
  let total = 0;
  let last = "";
  let p = 0;
  while (p < PAGES) {
    last = render(names, urls, prices);
    total += last.length.toInt();
    p += 1;
  }
  let h = 0;
  let k: usize = 0;
  while (k < last.length) {
    h = (h * 31 + last.charCodeAt(k)) % 1000000007;
    k += 1;
  }
  console.log("bytes " + total.toString());
  console.log("hash " + h.toString());
  console.log("head " + last.substring(0, 120));
}
