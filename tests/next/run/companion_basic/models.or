import { Json, Note } from "./annos";

// Private to this module: the generated companion (models.gen) can use all of it, nobody else can.
const SECRET: int = 41;

function secretBump(n: int): int {
  return n + SECRET;
}

type Secret = { code: int; };

@Json
export type User = { id: int; name: string; };

@Json
@Note("no recorded output for this one: plain metadata")
export type Account = { owner: User; balance: int; };

export function makeUser(id: int, name: string): User {
  return User { id: id, name: name };
}

export function makeAccount(owner: User, balance: int): Account {
  return Account { owner: owner, balance: balance };
}
