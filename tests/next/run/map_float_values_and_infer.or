function main(): void {
  let prices: Map<string, float> = new Map();
  prices.set("apple", 0.5);
  prices.set("pear", 0.75);
  prices.set("fig", 2.25);
  let total = 0.0;
  for (const p of prices.values()) {
    total += p;
  }
  console.log(total.toString());
  prices.set("apple", prices.get("apple").unwrap() * 2.0);
  console.log(prices.get("apple").unwrap().toString());
  let single: Map<int, f32> = new Map();
  single.set(1, 0.1);
  console.log(single.get(1).unwrap().toString());
  const none = single.get(2);
  console.log(none.isNone().toString());
}
