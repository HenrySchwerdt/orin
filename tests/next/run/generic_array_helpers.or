function reverse<T>(xs: T[]): T[] {
  let out: T[] = [];
  let i = xs.length;
  while (i > 0) {
    i -= 1;
    out.push(xs[i]);
  }
  return out;
}

function repeat<T>(x: T, n: usize): T[] {
  let out: T[] = [];
  let i: usize = 0;
  while (i < n) {
    out.push(x);
    i += 1;
  }
  return out;
}

function take<T>(xs: T[], n: usize): T[] {
  if (n >= xs.length) {
    return xs;
  }
  return xs.slice(0, n);
}

function append<T>(xs: T[], ys: T[]): T[] {
  return xs.concat(ys);
}

function show(xs: int[]): string {
  let parts: string[] = [];
  for (const x of xs) {
    parts.push(x.toString());
  }
  return "[" + parts.join(",") + "]";
}

function main(): void {
  console.log(show(reverse([1, 2, 3])));
  console.log(reverse(["a", "b", "c"]).join(""));
  console.log(show(repeat(7, 3)));
  console.log(repeat("ab", 2).join("+"));
  console.log(show(take([5, 6, 7, 8], 2)));
  console.log(show(take([5], 4)));
  console.log(show(append([1], [2, 3])));
  const e: int[] = [];
  console.log(show(reverse(e)));
  console.log(show(append(e, e)));
}
