function takesUsize(n: usize): usize {
  return n + 1;
}

function main(): void {
  const a: usize = 5;
  const b = a + 2;
  console.log(b.toString());
  console.log(takesUsize(9).toString());
  const xs = [1, 2, 3];
  const n = xs.length;
  console.log((n * 2).toString());
  console.log((5 + n).toString());
  const i: int = 4;
  console.log((i + 1).toString());
  console.log(a.toInt().toString());
  console.log(i.toUsize().toString());
  if (n == 3) { console.log("three"); }
  if (n > 2) { console.log("gt"); }
  let k: usize = 0;
  k += 1;
  k += 2;
  console.log(k.toString());
  const idx: usize = 2;
  console.log(xs[idx].toString());
  console.log((xs.length + 10).toString());
}
