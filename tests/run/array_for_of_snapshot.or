function show(xs: int[]): string {
  let s = "[";
  let i: usize = 0;
  while (i < xs.length) {
    if (i > 0) { s = s + ","; }
    s = s + xs[i].toString();
    i += 1;
  }
  return s + "]";
}

function main(): void {
  let xs = [1, 2, 3];
  let count = 0;
  for (const x of xs) {
    xs.push(x * 10);
    count += 1;
  }
  console.log(count.toString());
  console.log(xs.length.toString());
  console.log(show(xs));
  let ys = [1, 2, 3];
  let seen = 0;
  for (const y of ys) {
    ys.pop();
    seen += 1;
  }
  console.log(seen.toString());
  console.log(ys.length.toString());
}
