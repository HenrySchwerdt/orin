// Tests for std:http. Run with `orin test tests/std/http_test.or` (contracts are checked by default) and with
// `--no-contracts`. See tools/test_std.sh.
import { assert, assertEq, assertEqUsize, assertEqString, assertEqBool } from "std:test";
import { isToken, methodFromToken, methodName, isValidTarget, Get } from "std:http";

@Test
function tokenBasics(): void {
  assertEqBool(isToken("Content-Length"), true, "token");
  assertEqBool(isToken("a b"), false, "space");
  assertEqString(methodName(methodFromToken("GET").unwrap()), "GET", "GET");
  assertEqBool(isValidTarget(Get, "/x?y=1"), true, "origin");
}
