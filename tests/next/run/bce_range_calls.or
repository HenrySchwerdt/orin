// Range facts for constant-length arrays (ADR-0038 lever 2 T6): what a call may do to an array it receives. A borrowed argument
// keeps the length fact; an array handed over, or changed through a copy, has its fact destroyed. The answers are the same
// whichever accesses lose their checks.
function total(xs: int[]): int {
  let s = 0;
  let i: usize = 0;
  while (i < xs.length) {
    s += xs[i];
    i += 1;
  }
  return s;
}

function longer(xs: int[]): int[] {
  let ys = xs;
  ys.push(99);
  return ys;
}

function bump(xs: int[]): int {
  let ys = xs;
  ys[0] = 1000;
  return ys[0];
}

function main(): void {
  const a: int[] = [1, 2, 3, 4];
  let s = 0;
  let i: usize = 0;
  while (i < 4) {
    s += total(a) * a[i];
    i += 1;
  }
  console.log(s.toString());
  // a longer copy: the original keeps its four elements
  const b = longer(a);
  console.log(a.length.toString() + " " + b.length.toString() + " " + a[3].toString() + " " + b[4].toString());
  // a callee that stores into its parameter works on a copy
  let c: int[] = [5, 6, 7];
  console.log(bump(c).toString());
  console.log(c[0].toString() + " " + c[2].toString());
  // an array that is built in a loop from literals of different lengths
  let t = 0;
  let k: usize = 0;
  while (k < 3) {
    let d: int[] = [1, 2];
    if (k == 1) {
      d = [1, 2, 3, 4, 5];
    }
    let m: usize = 0;
    while (m < 2) {
      t += d[m];
      m += 1;
    }
    k += 1;
  }
  console.log(t.toString());
}
