type Row = { key: int; tag: string; };

function main(): void {
  const xs = [5, 3, 9, 1, 7, 3, 8];
  const asc = xs.sort((a, b) => a - b);
  const desc = xs.sort((a, b) => b - a);
  console.log(asc.map(x => x.toString()).join(" "));
  console.log(desc.map(x => x.toString()).join(" "));
  console.log(xs.map(x => x.toString()).join(" "));
  const rows = [
    Row { key: 2, tag: "a" },
    Row { key: 1, tag: "b" },
    Row { key: 2, tag: "c" },
    Row { key: 1, tag: "d" },
    Row { key: 3, tag: "e" },
    Row { key: 2, tag: "f" },
  ];
  const sorted = rows.sort((p, q) => p.key - q.key);
  console.log(sorted.map(r => r.key.toString() + r.tag).join(" "));
  const words = ["pear", "fig", "banana", "kiwi", "apple", "plum"];
  const byLen = words.sort((a, b) => a.length.toInt() - b.length.toInt());
  console.log(byLen.join(" "));
  const empty: int[] = [];
  console.log(empty.sort((a, b) => a - b).length.toString());
  console.log([42].sort((a, b) => a - b)[0].toString());
  const bools = [true, false, true, false];
  const falseFirst = bools.sort((a, b) => a == b ? 0 : a ? 1 : -1);
  console.log(falseFirst.map(b => b.toString()).join(","));
}
