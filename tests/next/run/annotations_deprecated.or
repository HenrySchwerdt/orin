// @Deprecated (ADR-0024) only produces warnings (W0440); the program compiles and behaves normally.
// tools/test_annotations.py checks the warnings themselves.
@Deprecated("use newAdd")
function oldAdd(a: int, b: int): int {
  return a + b;
}

function newAdd(a: int, b: int): int {
  return a + b;
}

@Deprecated("use Counter2")
class Counter {
  n: int;

  constructor() {
    this.n = 0;
  }

  @Deprecated("use bump")
  incr(): void {
    this.n += 1;
  }

  bump(by: int): void {
    this.n += by;
  }
}

@Deprecated("use Point")
type OldPoint = { x: int; y: int; };

type Point = { x: int; y: int; };

@Deprecated("use Sized2")
interface Sized {
  size(): int;
}

interface Shape {
  @Deprecated("use perimeter")
  circumference(): int;
  perimeter(): int;
}

class Square implements Shape {
  side: int;

  constructor(side: int) {
    this.side = side;
  }

  circumference(): int {
    return this.side * 4;
  }

  perimeter(): int {
    return this.side * 4;
  }
}

// A deprecated declaration may use other deprecated symbols without warnings.
@Deprecated("go away")
function legacy(): int {
  return oldAdd(1, 2);
}

function main(): void {
  console.log(oldAdd(1, 2).toString());
  console.log(newAdd(1, 2).toString());
  let c = new Counter();
  c.incr();
  c.bump(2);
  console.log(c.n.toString());
  const p = OldPoint { x: 1, y: 2 };
  console.log((p.x + p.y).toString());
  const s: Shape = new Square(2);
  console.log(s.circumference().toString());
  console.log(legacy().toString());
}
