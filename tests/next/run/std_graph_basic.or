import { Graph } from "std:graph";

function main(): void {
  let g = new Graph<string>(1);
  const a = g.add("alpha");
  const b = g.add("beta");
  console.log(g.size().toString());
  console.log(g.get(a).unwrap());
  console.log(g.get(b).unwrap());
  console.log(g.contains(a).toString());
  g.set(a, "ALPHA").unwrap();
  console.log(g.get(a).unwrap() + " " + g.get(b).unwrap());
  console.log(g.ids().length.toString());
  console.log(new Graph<int>(2).size().toString());
  const removed = g.remove(b).unwrap();
  console.log(removed + " " + g.size().toString());
}
