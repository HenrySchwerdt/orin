// Stream-style array pipelines against the equivalent loop (ADR-0038 §2: closure inlining and fusion; docs/benchmarks.md
// "Streams"). `filter -> map -> reduce` over 5,000,000 ints, repeated 10 times. The first argument picks the variant:
//   loop   the hand-written `for` loop;
//   chain  `xs.filter(..).map(..).reduce(..)` with arrow functions (fused into one loop by the compiler);
//   (none) both, one after the other.
// Both print the same checksum. Time each variant from outside: `time ./streams loop`, `time ./streams chain`.
import { Host, useProcess } from "std:host";
import { args } from "std:process";

function input(n: int): int[] {
  let xs: int[] = [];
  let i = 0;
  while (i < n) {
    xs.push(i);
    i += 1;
  }
  return xs;
}

function viaLoop(xs: int[]): int {
  let s = 0;
  for (const x of xs) {
    if (x % 3 == 0) {
      s += x * 2;
    }
  }
  return s;
}

function viaChain(xs: int[]): int {
  return xs.filter(x => x % 3 == 0).map(x => x * 2).reduce((a, b) => a + b, 0);
}

function run(which: string): void {
  const xs = input(5000000);
  let total = 0;
  let r = 0;
  while (r < 10) {
    total += which == "loop" ? viaLoop(xs) : viaChain(xs);
    r += 1;
  }
  console.log(`${which}: ${total}`);
}

function main(host: Host): void {
  useProcess(host, proc => {
    const a = args(proc);
    if (a.length == 0 || a[0] == "loop") {
      run("loop");
    }
    if (a.length == 0 || a[0] == "chain") {
      run("chain");
    }
  });
}
