const RATE: float = 0.075;
const NEG: float = -1.25;
const SMALL: f32 = 0.5;
const SCALE = 1e3;
const LIMIT: float = 1.0e-3;

function interest(amount: float, years: int): float {
  let v = amount;
  let i = 0;
  while (i < years) {
    v = v * (1.0 + RATE);
    i += 1;
  }
  return v;
}

function main(): void {
  console.log(interest(1000.0, 3).toString());
  console.log(NEG.toString());
  console.log(SMALL.toString());
  console.log(SCALE.toString());
  console.log((NEG * SCALE).toString());
  console.log(LIMIT.toString());
  const inferred = 2.0 * 3.0 + 1.0;
  console.log(inferred.toString());
  const t: f32 = 2.0 * 3.0 + 1.0;
  console.log(t.toString());
  const cond = inferred > 5.0 ? 1.5 : 2.5;
  console.log(cond.toString());
  const arr = [0.5, 1.5];
  console.log(arr[0].toString());
}
