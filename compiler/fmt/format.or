// `orin fmt` entry point: parse, pretty-print canonically, re-insert comments.

import { Diagnostic, span, diag } from "../diag";
import { parse, scanComments } from "../syntax";
import { Ctx, stripMarkers } from "./layout";
import { printModule } from "./printer";

// Canonical formatting of `src` (file index `file`). Syntax errors are returned as diagnostics
// and nothing is formatted. The result is idempotent: format(format(x)) == format(x).
export function format(file: usize, src: string): Result<string, Diagnostic> {
  const m = parse(file, src)?;
  if (src.includes("\x01") || src.includes("\x02")) {
    return Err(diag("E0100", span(file, 0, 0), "the formatter does not support control bytes 0x01/0x02 in source"));
  }
  const c = Ctx { src: src, cs: scanComments(src) };
  return Ok(stripMarkers(printModule(c, m)));
}
