// error: E0410
// Orin for TypeScript developers: == on a record compares it field by field (ADR-0034); a record with a float field has no ==.
type Point = { x: float; y: float; };
function main(): void {
  const p = Point { x: 1.0, y: 2.0 };
  const q = Point { x: 1.0, y: 2.0 };
  console.log(p == q ? "eq" : "ne");
}
