// flags: --check-contracts
// exit: 101
// stderr: trap: contract violated: @Invariant(this.n >= 0) at tests/next/run/contracts_record_return_violation.or:6
// stderr:     this.n = -2
// A record that comes out of a function (here from a spread copy) is checked at construction.
@Invariant(this.n >= 0)
type Counter = { n: int; tag: string; };

function bump(c: Counter, by: int): Counter {
  return Counter { ...c, n: c.n + by };
}

function main(): void {
  const c = Counter { n: 1, tag: "t" };
  console.log(bump(c, 2).n.toString());
  console.log(bump(c, -3).n.toString());
}
