// std:task: spawn and join (ADR-0017). The result of a task comes back through join; the tasks run independently.
import { scope, spawn, spawnDo } from "std:task";

function fib(n: int): int {
  if (n < 2) {
    return n;
  }
  return fib(n - 1) + fib(n - 2);
}

function main(): void {
  const total = scope(s => {
    const a = spawn(s, () => fib(20));
    const b = spawn(s, () => fib(21));
    const c = spawn(s, () => "text from a task");
    console.log(c.join());
    return a.join() + b.join();
  });
  console.log(total.toString());
  const words = scope(s => {
    const h = spawn(s, () => ["alpha", "beta", "gamma"].map(w => w + "!"));
    return h.join().join(" ");
  });
  console.log(words);
  const flag = scope(s => spawnDo(s, () => console.log("a task with no result")).join());
  console.log(flag ? "done" : "failed");
}
