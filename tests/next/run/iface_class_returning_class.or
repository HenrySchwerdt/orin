// Methods that return class values and interface values, converted at the call boundary.
interface Maker {
  make(k: int): Box;
  wrapped(k: int): Item;
}

class Box {
  constructor(public v: int) {}
}

interface Item {
  value(): int;
}

class Cell implements Item {
  constructor(public v: int) {}
  value(): int { return this.v; }
}

class Factory implements Maker {
  make(k: int): Box { return new Box(k * 2); }
  wrapped(k: int): Item { return new Cell(k + 1); }
}

function main(): void {
  const m: Maker = new Factory();
  console.log(m.make(4).v.toString() + " " + m.wrapped(4).value().toString());
}
