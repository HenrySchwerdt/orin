function main(): void {
  let i = 1;
  let sum = 0;
  while (i <= 10) {
    sum += i;
    i += 1;
  }
  console.log(sum.toString());
  let odd = 0;
  i = 0;
  while (i < 10) {
    i += 1;
    if (i % 2 == 0) { continue; }
    odd += i;
  }
  console.log(odd.toString());
  let n = 0;
  while (true) {
    n += 1;
    if (n * n > 50) { break; }
  }
  console.log(n.toString());
  let k = 10;
  while (k > 0) {
    k -= 3;
  }
  console.log(k.toString());
  while (i > 100) {
    console.log("never");
  }
}
