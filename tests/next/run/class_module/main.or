// Classes exported from a module and used (including their methods) by an importer.
import { Queue, Pair } from "./lib";

function main(): void {
  let q = Queue.of("first");
  q.put("second");
  const snap = q;
  console.log(q.pending().toString());
  console.log(q.take().unwrap());
  console.log(q.pending().toString() + " " + snap.pending().toString());
  const p = new Pair(1, 2).swap();
  console.log(p.a.toString() + p.b.toString());
  let ps = [p, p.swap()];
  console.log(ps[1].a.toString());
}
