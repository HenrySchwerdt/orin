// Import aliases: `import { a as b }` binds the export `a` as `b`; types, functions, constants and union types (the
// variants of an imported union keep their own names).
import { Html, empty as emptyHtml, render as renderHtml, text } from "std:html";
import { Bytes as Buf, fromString as bytesOf, empty as emptyBytes } from "std:bytes";

function size(b: Buf): usize {
  return b.length();
}

function main(): void {
  const h: Html = emptyHtml();
  console.log("[" + renderHtml(h) + "]");
  console.log(renderHtml(text("a<b")));
  console.log(size(bytesOf("abc")).toString());
  console.log(size(emptyBytes()).toString());
}
