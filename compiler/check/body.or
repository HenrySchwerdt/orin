// Function body checking: the entry points of the expression and statement checkers.
//
// The work is split by what it needs to know (rewrite step 2b; before, this was one 3,500-line file of
// functions that threaded the environment and the function context through every call):
//
//   fnctx.or   FnCtx: the state of the body being checked (locals, scopes, loops, hoisted statements)
//   ops.or     pure helpers: HIR constructors, literal and operator typing rules, shared diagnostics
//   match.or   match exhaustiveness (`Coverage`)
//   call.or    generic-call inference state (`Inference`), diagnostics of built-in calls
//   lift.or    closure conversion
//   hirok.or   HIR well-formedness predicates used by contracts
//   expr.or    ExprChecker: expressions, calls, places, arrow functions
//   stmt.or    StmtChecker: blocks, statements, match arms, contract clauses
//
// The drivers (checker.or, classfix.or, contracts.or) use only the two functions below.

export { checkBlock, checkClause, ClauseOut } from "./stmt";
export { BlockOut } from "./expr";
