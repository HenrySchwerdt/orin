// Process stdio for the language server loop (spec 18 §3): the only compiler file that uses
// `std:io`.

import { readBytes, readLine, writeStdout, shell } from "std:io";

export function stdinReadBytes(n: usize): Option<string> {
  return readBytes(n);
}

export function stdinReadLine(): Option<string> {
  return readLine();
}

export function stdoutWrite(s: string): void {
  writeStdout(s);
}

// Runs a shell command, returns its exit status (-1: could not run / signalled).
export function shellRun(cmd: string): int {
  return shell(cmd);
}
