// Fixed-width integers inside arrays, records, unions, Option/Result, Map keys and values, classes,
// closures, generics and interfaces.
type Pixel = { r: u8; g: u8; b: u8; };
type Shape = Circle(u16) | Rect(u16, u16) | Empty;
type Wide = { a: i8; b: u16; c: u32; d: i64; e: u64; f: isize; g: usize; h: i32; };

interface Sized {
  size(): u32;
}

class Buffer implements Sized {
  private len: u32 = 0;
  add(n: u32): void {
    this.len += n;
  }
  size(): u32 {
    return this.len;
  }
}

class Counter {
  count: i16 = 0;
  inc(): void {
    this.count += 1;
  }
}

function identity<T>(x: T): T {
  return x;
}

function firstOr<T>(xs: T[], d: T): T {
  return xs.length > 0 ? xs[0] : d;
}

function area(s: Shape): u32 {
  return match (s) {
    Circle(r) => r.toU32() * r.toU32() * 3,
    Rect(w, h) => w.toU32() * h.toU32(),
    Empty => 0
  };
}

function total(xs: i32[]): i32 {
  let s: i32 = 0;
  for (const x of xs) {
    s += x;
  }
  return s;
}

function bucket(x: u8): string {
  return match (x) {
    0 => "zero",
    1 => "one",
    255 => "max",
    _ => "other"
  };
}

function sign(x: i16): i8 {
  if (x < 0) {
    return -1;
  }
  return x == 0 ? 0 : 1;
}

function safeDiv(a: i32, b: i32): Result<i32, string> {
  if (b == 0) {
    return Err("div by zero");
  }
  return Ok(a / b);
}

function useSized(s: Sized): u32 {
  return s.size() + 1;
}

function main(): void {
  // arrays of every width
  const bytes: u8[] = [0, 1, 254, 255];
  let words: i16[] = [-1, 2];
  words.push(32767);
  console.log(bytes[3].toString() + " " + words[2].toString() + " " + words.length.toString());
  const longs: u64[] = [18446744073709551615, 0];
  console.log(longs[0].toString());
  console.log(total([1000000000, 1000000000, -5]).toString());
  console.log(bytes.slice(1, 3).length.toString());
  console.log(bytes.concat([7]).length.toString());
  console.log(firstOr<u16>([], 65535).toString());
  console.log(firstOr(words, 9).toString());

  // records, spread, nested update
  const p = Pixel { r: 255, g: 128, b: 0 };
  let q = Pixel { ...p, g: 1 };
  q.b += 9;
  console.log(`${p.r},${p.g},${p.b} ${q.r},${q.g},${q.b}`);
  const w = Wide { a: -128, b: 65535, c: 4294967295, d: -9223372036854775808, e: 18446744073709551615, f: -1, g: 7, h: -2147483648 };
  console.log(`${w.a} ${w.b} ${w.c} ${w.d} ${w.e} ${w.f} ${w.g} ${w.h}`);

  // unions, Option, Result
  console.log(area(Circle(100)).toString() + " " + area(Rect(65535, 65535)).toString() + " " + area(Empty).toString());
  let o: Option<i8> = Some(-7);
  console.log(o.unwrap().toString() + " " + o.unwrapOr(1).toString());
  o = None;
  console.log(o.unwrapOr(-128).toString());
  console.log(safeDiv(-2147483647, -1).unwrap().toString());
  console.log(safeDiv(1, 0).unwrapErr());

  // match on literals of narrow types
  console.log(bucket(0) + bucket(1) + bucket(255) + bucket(100));
  console.log(sign(-300).toString() + sign(0).toString() + sign(300).toString());

  // Map keys and values of integer types
  let m = new Map<i32, u8>();
  m.set(-1, 255);
  m.set(100000, 7);
  m.set(-1, 9);
  console.log(m.get(-1).unwrap().toString() + " " + m.get(100000).unwrap().toString() + " " + m.get(5).isNone().toString());
  console.log(m.size.toString());
  let big = new Map<u64, i64>();
  big.set(18446744073709551615, -1);
  big.set(0, 1);
  console.log(big.get(18446744073709551615).unwrap().toString());
  console.log(big.has(18446744073709551614).toString());
  let byte = new Map<u8, string>();
  byte.set(200, "two hundred");
  console.log(byte.get(200).unwrapOr("?"));
  console.log(byte.keys()[0].toString());

  // classes
  let buf = new Buffer();
  buf.add(4000000000);
  buf.add(5);
  console.log(buf.size().toString());
  console.log(useSized(buf).toString());
  let c = new Counter();
  c.inc();
  c.inc();
  console.log(c.count.toString());

  // closures capture integer values; parameters and results of any width
  const base: u16 = 1000;
  const addBase = (x: u16): u16 => x + base;
  console.log(addBase(234).toString());
  const widen = (x: i8): i64 => x.toI64() * 1000000000000;
  console.log(widen(-100).toString());
  const fs: ((x: i32) => i32)[] = [x => x + 1, x => x * 2];
  console.log(fs[0](10).toString() + " " + fs[1](10).toString());

  // generics instantiated at several integer types
  console.log(identity<i8>(-5).toString() + identity<u64>(18446744073709551615).toString() + identity(3).toString());
  console.log(bytes.map((x: u8): u16 => x.toU16() * 2).length.toString());
  console.log(words.filter((x: i16): bool => x > 0).length.toString());
  console.log(bytes.indexOf(254).unwrap().toString() + bytes.includes(3).toString());
  console.log(words.reduce((a: i32, x: i16): i32 => a + x.toI32(), 0).toString());
  const unsorted: i32[] = [30, -5, 17];
  const sorted = unsorted.sort((a: i32, b: i32): int => (a - b).toInt());
  console.log(sorted[0].toString() + sorted[1].toString() + sorted[2].toString());
}
