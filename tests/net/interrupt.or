// Interruptible network waits and operation-wide deadlines (ADR-0017 Addendum D, work package C3), for tools/test_net.sh
// (plain and ThreadSanitizer). Every case prints "<name>: ok" or "<name>: FAIL <why>"; the last line is "interrupt: ok" or
// "interrupt: FAIL". Times are read from the monotonic clock of a Stream (the only clock a program with a NetGrant has).
//
//   accept        a task blocked in accept wakes when its scope is cancelled from another task: Err(Cancelled), not Timeout
//   recv          the same for recv on an idle connection
//   send          the same for a send that fills the socket buffers of a peer that never reads
//   connect       the same for a connect that hangs (a listener with a full accept queue swallows the SYN; skipped where the OS
//                 refuses instead of dropping)
//   precancelled  a task spawned into an already cancelled scope fails every network call at once, without touching the socket
//   nested        cancelling an outer scope wakes a task of a scope nested in one of its tasks; cancelling the inner one wakes
//                 only the inner tasks
//   trickle       one deadline across many small reads: a peer sending a byte every 25 ms cannot stretch readExactUntil
//   senddeadline  sendAllUntil ends at its deadline although the peer reads nothing
//   connectdeadline connect to a hanging address ends at the deadline of withConnectionUntil
import { Host, useNet } from "std:host";
import { Deadline, MonotonicInstant, milliseconds } from "std:time";
import { Bytes, fromString } from "std:bytes";
import { Scope, TaskHandle, CancelToken, Sender, channel, scopeNetDo, spawnNet, sleepUntil } from "std:task";
import {
  NetGrant, Listener, Stream, Peer, NetError, NetErrorKind, StreamReader, Fill, Filled, FillClosed, FillLimit, FillTimeout, FillError,
  RecvResult, RecvData, RecvEof, RecvTimeout, RecvReset, RecvError, Denied, Closed, Timeout, Cancelled, Reset, InvalidArgument, InvalidPeer, Os,
  useListenerNet, useConnectionBeside, useAccepted, useConnection, withConnectionUntil, acceptDetached, dropAccepted, Accepted, portOf, recv, recvUntil,
  sendAll, sendAllUntil, monotonicMillis
} from "std:net";

const DELAY: int = 200;
const LONG: int = 30000;   // every blocking call below is given 30 s: only a cancellation (or the case's own deadline) ends it early
const WAKE_SLACK: int = 1500;

type Probe = { what: string; t0: int; t1: int; };

function kindName(k: NetErrorKind): string {
  return match (k) {
    Denied => "Denied",
    Closed => "Closed",
    Timeout => "Timeout",
    Cancelled => "Cancelled",
    Reset => "Reset",
    InvalidArgument => "InvalidArgument",
    InvalidPeer => "InvalidPeer",
    Os => "Os"
  };
}

function recvName(r: RecvResult): string {
  return match (r) {
    RecvData(b) => "data",
    RecvEof => "eof",
    RecvTimeout => "Timeout",
    RecvReset => "Reset",
    RecvError(e) => kindName(e.kind)
  };
}

function fillName(f: Fill): string {
  return match (f) {
    Filled(b) => "filled",
    FillClosed(b) => "closed",
    FillLimit => "limit",
    FillTimeout => "Timeout",
    FillError(e) => kindName(e.kind)
  };
}

// The monotonic clock in milliseconds, read through a scratch loopback connection.
function nowMs(net: NetGrant): int {
  const out: int[] = [];
  useListenerNet(net, "127.0.0.1", 0, 1, (ln: Listener, n: NetGrant) => {
    useConnectionBeside(n, "127.0.0.1", portOf(ln), milliseconds(2000), ln, (s: Stream, l2: Listener) => {
      out.push(monotonicMillis(s));
    });
  });
  return out.length > 0 ? out[0] : -1;
}

function at(ms: int): Deadline {
  return Deadline { at: MonotonicInstant { millis: ms } };
}

function verdict(name: string, p: Probe, wantKind: string): string {
  const waited = p.t1 - p.t0;
  if (p.what != wantKind) {
    return name + ": FAIL got " + p.what + " after " + waited.toString() + " ms, wanted " + wantKind;
  }
  if (waited < DELAY - 20) {
    return name + ": FAIL woke after " + waited.toString() + " ms, before the cancellation at " + DELAY.toString() + " ms";
  }
  if (waited > DELAY + WAKE_SLACK) {
    return name + ": FAIL woke only after " + waited.toString() + " ms";
  }
  return name + ": ok";
}

// ---------------------------------------------------------------------------------------------------- the blocked tasks

// accept: bind, make one connection and take it (so that the queue is empty and the clock is at hand), then wait for another.
function blockedAccept(net: NetGrant, starts: Sender<int>): Probe {
  const out: Probe[] = [];
  useListenerNet(net, "127.0.0.1", 0, 4, (ln: Listener, n: NetGrant) => {
    useConnectionBeside(n, "127.0.0.1", portOf(ln), milliseconds(2000), ln, (c: Stream, l2: Listener) => {
      useAccepted(l2, milliseconds(2000), (a: Stream, p: Peer) => {});
      const t0 = monotonicMillis(c);
      starts.send(t0);
      const r = acceptDetached(l2, milliseconds(LONG));
      const t1 = monotonicMillis(c);
      match (r) {
        Ok(acc) => {
          dropAccepted(acc);
          out.push(Probe { what: "accepted", t0: t0, t1: t1 });
        },
        Err(e) => {
          out.push(Probe { what: kindName(e.kind), t0: t0, t1: t1 });
        }
      }
    });
  });
  return out.length > 0 ? out[0] : Probe { what: "no listener", t0: 0, t1: 0 };
}

// recv: the server side of an idle connection waits for bytes the client never sends.
function blockedRecv(net: NetGrant, starts: Sender<int>): Probe {
  const out: Probe[] = [];
  useListenerNet(net, "127.0.0.1", 0, 4, (ln: Listener, n: NetGrant) => {
    useConnectionBeside(n, "127.0.0.1", portOf(ln), milliseconds(2000), ln, (c: Stream, l2: Listener) => {
      useAccepted(l2, milliseconds(2000), (a: Stream, p: Peer) => {
        const t0 = monotonicMillis(a);
        starts.send(t0);
        const r = recv(a, 100, milliseconds(LONG));
        out.push(Probe { what: recvName(r), t0: t0, t1: monotonicMillis(a) });
      });
    });
  });
  return out.length > 0 ? out[0] : Probe { what: "no connection", t0: 0, t1: 0 };
}

function megabytes(n: usize): Bytes {
  let block = "0123456789abcdef";
  while (block.length < 65536) {
    block = block + block;
  }
  let b = fromString(block);
  let total = b;
  let i: usize = 1;
  while (i < n * 16) {
    total = total.concat(b);
    i += 1;
  }
  return total;
}

// send: the server side writes 64 MB to a client that never reads.
function blockedSend(net: NetGrant, starts: Sender<int>): Probe {
  const out: Probe[] = [];
  useListenerNet(net, "127.0.0.1", 0, 4, (ln: Listener, n: NetGrant) => {
    useConnectionBeside(n, "127.0.0.1", portOf(ln), milliseconds(2000), ln, (c: Stream, l2: Listener) => {
      useAccepted(l2, milliseconds(2000), (a: Stream, p: Peer) => {
        const t0 = monotonicMillis(a);
        starts.send(t0);
        const r = sendAll(a, megabytes(64), milliseconds(LONG));
        const t1 = monotonicMillis(a);
        out.push(Probe { what: r.isOk() ? "sent" : kindName(r.unwrapErr().kind), t0: t0, t1: t1 });
      });
    });
  });
  return out.length > 0 ? out[0] : Probe { what: "no connection", t0: 0, t1: 0 };
}

// Fills the accept queue of a backlog-1 listener until a connect times out; true when one did (the queue swallows SYNs).
function fillQueue(net: NetGrant, port: int): bool {
  let i: int = 0;
  while (i < 8) {
    const r = useConnection(net, "127.0.0.1", port, milliseconds(250), (s: Stream) => {});
    if (r.isErr()) {
      return r.unwrapErr().kind == Timeout;
    }
    i += 1;
  }
  return false;
}

// connect: to a listener whose queue is full. what is "skipped" where the OS does not drop the SYN.
function blockedConnect(net: NetGrant, starts: Sender<int>): Probe {
  const out: Probe[] = [];
  useListenerNet(net, "127.0.0.1", 0, 1, (bh: Listener, n: NetGrant) => {
    const port = portOf(bh);
    if (!fillQueue(n, port)) {
      starts.send(nowMs(n));
      out.push(Probe { what: "skipped", t0: 0, t1: 0 });
    } else {
      const t0 = nowMs(n);
      starts.send(t0);
      const r = useConnection(n, "127.0.0.1", port, milliseconds(LONG), (s: Stream) => {});
      const t1 = nowMs(n);
      out.push(Probe { what: r.isOk() ? "connected" : kindName(r.unwrapErr().kind), t0: t0, t1: t1 });
    }
  });
  return out.length > 0 ? out[0] : Probe { what: "no listener", t0: 0, t1: 0 };
}

// ---------------------------------------------------------------------------------------------------- cases

// One probe task and one canceller in a scope; the canceller sleeps DELAY ms after the probe's start and cancels the scope.
function cancelCase(net: NetGrant, name: string, which: int): string {
  const ch = channel<int>(2);
  const result: string[] = [];
  scopeNetDo(net, (sc: Scope, g: NetGrant) => {
    const tok = sc.token();
    const rx = ch.rx;
    const tx = ch.tx;
    const probe = spawnNet(sc, g, (t: NetGrant) => {
      return which == 0 ? blockedAccept(t, tx) : (which == 1 ? blockedRecv(t, tx) : (which == 2 ? blockedSend(t, tx) : blockedConnect(t, tx)));
    });
    const stopper = spawnNet(sc, g, (t: NetGrant) => {
      const t0 = rx.recv().unwrapOr(0);
      sleepUntil(at(t0 + DELAY));
      return tok.cancel();
    });
    const p = probe.join();
    const cancelled = stopper.join();
    if (p.what == "skipped") {
      result.push(name + ": skipped (this OS does not drop a SYN for a full accept queue)");
    } else {
      result.push(verdict(name, p, "Cancelled") + (cancelled ? "" : " (the token was already cancelled)"));
    }
  });
  return result.length > 0 ? result[0] : name + ": FAIL no result";
}

// A task spawned into a cancelled scope fails at once, also against a listener that has a connection waiting.
function precancelled(net: NetGrant): string {
  const result: string[] = [];
  scopeNetDo(net, (sc: Scope, g: NetGrant) => {
    sc.cancel();
    const h = spawnNet(sc, g, (t: NetGrant) => {
      const out: string[] = [];
      useListenerNet(t, "127.0.0.1", 0, 4, (ln: Listener, n: NetGrant) => {
        const c = useConnection(n, "127.0.0.1", portOf(ln), milliseconds(LONG), (s: Stream) => {});
        out.push("connect " + (c.isErr() ? kindName(c.unwrapErr().kind) : "ok"));
        const a = acceptDetached(ln, milliseconds(LONG));
        out.push("accept " + (a.isErr() ? kindName(a.unwrapErr().kind) : "ok"));
      });
      return out.length == 2 ? out[0] + ", " + out[1] : "listener failed";
    });
    const r = h.join();
    result.push(r == "connect Cancelled, accept Cancelled" ? "precancelled: ok" : "precancelled: FAIL " + r);
  });
  return result[0];
}

// nested: a task of the outer scope opens an inner scope with a probe and a canceller of the INNER scope, while the outer scope has
// a second probe. The inner cancel (at DELAY) wakes the inner probe only; the outer probe is still blocked and is woken by the
// outer cancel (at 3 * DELAY).
function nested(net: NetGrant): string {
  const chOuter = channel<int>(2);
  const chInner = channel<int>(2);
  const result: string[] = [];
  scopeNetDo(net, (sc: Scope, g: NetGrant) => {
    const outerTok = sc.token();
    const rxOuter = chOuter.rx;
    const txOuter = chOuter.tx;
    const rxInner = chInner.rx;
    const txInner = chInner.tx;
    const outerProbe = spawnNet(sc, g, (t: NetGrant) => blockedRecv(t, txOuter));
    const middle = spawnNet(sc, g, (t: NetGrant) => {
      const inner: Probe[] = [];
      scopeNetDo(t, (sc2: Scope, g2: NetGrant) => {
        const innerTok = sc2.token();
        const innerProbe = spawnNet(sc2, g2, (u: NetGrant) => blockedAccept(u, txInner));
        const innerStop = spawnNet(sc2, g2, (u: NetGrant) => {
          const t0 = rxInner.recv().unwrapOr(0);
          sleepUntil(at(t0 + DELAY));
          return innerTok.cancel();
        });
        inner.push(innerProbe.join());
        innerStop.join();
      });
      return inner[0];
    });
    const outerStart = rxOuter.recv().unwrapOr(0);
    const innerResult = middle.join();
    sleepUntil(at(outerStart + 3 * DELAY));
    const outerSet = outerTok.cancel();
    const outerResult = outerProbe.join();
    result.push(innerResult.what == "Cancelled" ? "nested inner: ok" : "nested inner: FAIL " + innerResult.what);
    const stayed = outerResult.t1 - outerResult.t0;
    result.push(outerResult.what == "Cancelled" && stayed >= 3 * DELAY - 40 && stayed <= 3 * DELAY + WAKE_SLACK ? "nested outer: ok"
      : "nested outer: FAIL " + outerResult.what + " after " + stayed.toString() + " ms (it must outlast the inner cancel and end at the outer one)");
    result.push(outerSet ? "nested token: ok" : "nested token: FAIL already set");
  });
  return result[0] + "\n" + result[1] + "\n" + result[2];
}

// trickle: a peer that sends one byte every 25 ms; readExactUntil of 500 bytes with one 300 ms deadline ends at the deadline.
function trickleFeeder(net: NetGrant, port: int): bool {
  const r = useConnection(net, "127.0.0.1", port, milliseconds(2000), (c: Stream) => {
    const base = monotonicMillis(c);
    let i: int = 0;
    while (i < 200) {
      if (sendAll(c, fromString("x"), milliseconds(1000)).isErr()) {
        return;
      }
      i += 1;
      sleepUntil(at(base + 25 * i));
    }
  });
  return r.isOk();
}

function trickle(net: NetGrant): string {
  const result: string[] = [];
  scopeNetDo(net, (sc: Scope, g: NetGrant) => {
    const wire = useListenerNet(g, "127.0.0.1", 0, 4, (ln: Listener, n: NetGrant) => {
      const port = portOf(ln);
      const feeder = spawnNet(sc, n, (t: NetGrant) => trickleFeeder(t, port));
      useAccepted(ln, milliseconds(2000), (s: Stream, p: Peer) => {
        let rd = new StreamReader(1024);
        const t0 = monotonicMillis(s);
        const f = rd.readExactUntil(s, 500, at(t0 + 300));
        const dt = monotonicMillis(s) - t0;
        const got = rd.buffered().length();
        // then recvUntil in a loop on a second deadline: many small chunks, one deadline
        const t1 = monotonicMillis(s);
        const end = at(t1 + 300);
        let chunks: int = 0;
        let last = "data";
        while (last == "data") {
          last = recvName(recvUntil(s, 64, end));
          if (last == "data") {
            chunks += 1;
          }
        }
        const dt2 = monotonicMillis(s) - t1;
        if (fillName(f) != "Timeout") {
          result.push("trickle: FAIL readExactUntil gave " + fillName(f));
        } else if (dt < 280 || dt > 300 + WAKE_SLACK) {
          result.push("trickle: FAIL readExactUntil ended after " + dt.toString() + " ms (deadline 300)");
        } else if (got < 3 || got >= 500) {
          result.push("trickle: FAIL " + got.toString() + " bytes buffered");
        } else if (last != "Timeout" || dt2 < 280 || dt2 > 300 + WAKE_SLACK || chunks < 3) {
          result.push("trickle: FAIL recvUntil loop ended " + last + " after " + dt2.toString() + " ms with " + chunks.toString() + " chunks");
        } else {
          result.push("trickle: ok");
        }
      });
      feeder.join();
    });
    if (wire.isErr()) {
      result.push("trickle: FAIL no listener");
    }
  });
  return result.length > 0 ? result[0] : "trickle: FAIL no result";
}

// senddeadline: a peer that reads nothing; sendAllUntil of 64 MB with one 300 ms deadline.
function sendDeadline(net: NetGrant): string {
  const out: string[] = [];
  useListenerNet(net, "127.0.0.1", 0, 4, (ln: Listener, n: NetGrant) => {
    useConnectionBeside(n, "127.0.0.1", portOf(ln), milliseconds(2000), ln, (c: Stream, l2: Listener) => {
      useAccepted(l2, milliseconds(2000), (a: Stream, p: Peer) => {
        const t0 = monotonicMillis(a);
        const r = sendAllUntil(a, megabytes(64), at(t0 + 300));
        const dt = monotonicMillis(a) - t0;
        if (r.isOk() || r.unwrapErr().kind != Timeout) {
          out.push("senddeadline: FAIL " + (r.isOk() ? "sent everything" : kindName(r.unwrapErr().kind)));
        } else if (dt < 280 || dt > 300 + WAKE_SLACK) {
          out.push("senddeadline: FAIL ended after " + dt.toString() + " ms (deadline 300)");
        } else {
          out.push("senddeadline: ok");
        }
      });
    });
  });
  return out.length > 0 ? out[0] : "senddeadline: FAIL no result";
}

// connectdeadline: connect to a listener with a full queue, absolute deadline 300 ms away.
function connectDeadline(net: NetGrant): string {
  const out: string[] = [];
  useListenerNet(net, "127.0.0.1", 0, 1, (bh: Listener, n: NetGrant) => {
    const port = portOf(bh);
    if (!fillQueue(n, port)) {
      out.push("connectdeadline: skipped (this OS does not drop a SYN for a full accept queue)");
    } else {
      const t0 = nowMs(n);
      const r = withConnectionUntil(n, "127.0.0.1", port, at(t0 + 300), (s: Stream) => 0);
      const dt = nowMs(n) - t0;
      if (r.isOk() || r.unwrapErr().kind != Timeout) {
        out.push("connectdeadline: FAIL " + (r.isOk() ? "connected" : kindName(r.unwrapErr().kind)));
      } else if (dt < 280 || dt > 300 + WAKE_SLACK) {
        out.push("connectdeadline: FAIL ended after " + dt.toString() + " ms (deadline 300)");
      } else {
        out.push("connectdeadline: ok");
      }
    }
  });
  return out.length > 0 ? out[0] : "connectdeadline: FAIL no result";
}

function main(host: Host): void {
  useNet(host, net => {
    const lines: string[] = [];
    lines.push(cancelCase(net, "accept", 0));
    lines.push(cancelCase(net, "recv", 1));
    lines.push(cancelCase(net, "send", 2));
    lines.push(cancelCase(net, "connect", 3));
    lines.push(precancelled(net));
    lines.push(nested(net));
    lines.push(trickle(net));
    lines.push(sendDeadline(net));
    lines.push(connectDeadline(net));
    let bad: int = 0;
    for (const l of lines) {
      console.log(l);
      if (l.indexOf("FAIL") >= 0) {
        bad += 1;
      }
    }
    console.log(bad == 0 ? "interrupt: ok" : "interrupt: FAIL");
  });
}
