function main(): void {
  const z = 0;
  const neg = -42;
  const big = 9223372036854775807;
  const u: usize = 42;
  const flag = 1 < 2;
  const no = !flag;
  console.log(z.toString());
  console.log(neg.toString());
  console.log(big.toString());
  console.log(u.toString());
  console.log(flag.toString());
  console.log(no.toString());
  console.log("n=" + neg.toString() + ", u=" + u.toString());
  const m: usize = 9223372036854775807;
  console.log(m.toInt().toString());
  console.log(u.toInt().toString());
}
