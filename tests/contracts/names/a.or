// Unit `a` of the qualified-names fixture (main.or): `mk` and `Scope` are also declared in unit `b`.
export type Scope = { depth: int; };

@Ensures(result == x + 1)
export function mk(x: int): int {
  return x + 1;
}

@Requires(s.depth >= 0 && s.depth < 1000)
@Ensures(result.depth == s.depth + 1)
export function deeper(s: Scope): Scope {
  return Scope { depth: s.depth + 1 };
}
