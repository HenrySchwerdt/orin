import { Input, Output, MDecl, fn, named, ret, str, output } from "std:meta";

@Annotation(type)
export type Many = { };

// Pure, small output per declaration, but more declarations than the limit of 10,000.
@Processor(Many)
export function manyProc(input: Input): Output {
  let decls: MDecl[] = [];
  let i = 0;
  while (i < 10001) {
    decls.push(fn("f" + i.toString(), [], named("string"), [ret(str("x"))]));
    i += 1;
  }
  return output(decls);
}
