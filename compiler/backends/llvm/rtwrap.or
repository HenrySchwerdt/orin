// The C-named wrappers of the L1 entries in an LLVM module (ADR-0052 Addendum A section 3, step R3d.3): the C shells of the
// runtime still call `orin_struct_new`, `orin_variant1`, `orin_array_new` ..., which are Orin functions of `$rt` now. The module
// defines each under its C name (the C compiler of the runtime sees the prototypes of runtime/core/orin_runtime.h); the wrapper
// converts the C types to the words of the entry and calls it. The module's own calls go to the entry directly (`LlvmSymbols.l1`).
// The fixed `declare`s of these names are dropped when the wrapper is defined (`dropDeclares`).

import { RtWrap, rtWraps } from "../../mir";
import { LlvmSymbols } from "./symbols";

function lt(k: string): string {
  if (k == "o" || k == "p") {
    return "ptr";
  }
  if (k == "u32") {
    return "i32";
  }
  if (k == "v") {
    return "void";
  }
  return "i64";
}

// The definition of one wrapper.
function wrapper(w: RtWrap, sym: string): string {
  let ps = "";
  let pre = "";
  let args = "";
  let i: usize = 0;
  while (i < w.params.length) {
    const k = w.params[i];
    const n = i.toString();
    ps += (i > 0 ? ", " : "") + lt(k) + " %a" + n;
    args += (i > 0 ? ", " : "") + "i64 %w" + n;
    if (k == "o" || k == "p") {
      pre += "  %w" + n + " = ptrtoint ptr %a" + n + " to i64\n";
    } else if (k == "u32") {
      pre += "  %w" + n + " = zext i32 %a" + n + " to i64\n";
    } else {
      pre += "  %w" + n + " = add i64 %a" + n + ", 0\n";
    }
    i += 1;
  }
  let s = "define " + lt(w.ret) + " @" + w.name + "(" + ps + ") nounwind {\n" + pre;
  if (w.ret == "v") {
    return s + "  call void @" + sym + "(" + args + ")\n  ret void\n}\n";
  }
  s += "  %r = call i64 @" + sym + "(" + args + ")\n";
  if (w.ret == "o" || w.ret == "p") {
    return s + "  %p = inttoptr i64 %r to ptr\n  ret ptr %p\n}\n";
  }
  if (w.ret == "u32") {
    return s + "  %t = trunc i64 %r to i32\n  ret i32 %t\n}\n";
  }
  return s + "  ret i64 %r\n}\n";
}

// The definitions of all wrappers of the module ("" when it has no L1 entries).
export function rtWrapDefs(syms: LlvmSymbols): string {
  if (!syms.l1Loaded()) {
    return "";
  }
  let out = "";
  for (const w of rtWraps()) {
    const sym = syms.l1(w.entry);
    if (sym != "") {
      out += wrapper(w, sym);
    }
  }
  return out;
}

// `declares` without the lines of the functions the module defines as wrappers.
export function dropDeclares(text: string, syms: LlvmSymbols): string {
  if (!syms.l1Loaded()) {
    return text;
  }
  let drop: string[] = [];
  for (const w of rtWraps()) {
    if (syms.l1(w.entry) != "") {
      drop.push("@" + w.name + "(");
    }
  }
  let out: string[] = [];
  for (const line of text.split("\n")) {
    let skip = false;
    if (line.startsWith("declare ")) {
      for (const d of drop) {
        if (line.includes(d)) {
          skip = true;
        }
      }
    }
    if (!skip) {
      out.push(line);
    }
  }
  return out.join("\n");
}
