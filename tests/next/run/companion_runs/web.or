// Annotation definitions of the companion_runs test: two annotations with processors (Http, Name), one without (Doc).
export type Verb = Get | Post | Delete;

@Annotation(function, method)
export type Http = { verb: Verb; path: string; tags: string[]; limit: Option<int>; };

@Annotation(field)
export type Name = { value: string; };

@Annotation(type, function, class, method, const)
export type Doc = { text: string; };
