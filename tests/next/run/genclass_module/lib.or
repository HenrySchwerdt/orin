// Generic classes exported from a module: private members, mutating methods, a bound on an exported
// interface, a generic class built from another generic class, helper functions returning instances.
export interface Ordered {
  rank(): int;
}

export class Box<T> {
  private inner: T;
  count: int = 0;
  constructor(v: T) {
    this.inner = v;
  }
  get(): T {
    return this.inner;
  }
  put(v: T): int {
    this.inner = v;
    this.count += 1;
    return this.count;
  }
  private secret(): int {
    return 42;
  }
  reveal(): int {
    return this.secret();
  }
}

export class Ranked<T extends Ordered> {
  items: T[] = [];
  add(x: T): void {
    let out: T[] = [];
    let placed = false;
    for (const it of this.items) {
      if (!placed && it.rank() > x.rank()) {
        out.push(x);
        placed = true;
      }
      out.push(it);
    }
    if (!placed) {
      out.push(x);
    }
    this.items = out;
  }
  first(): Option<T> {
    return this.items.length == 0 ? None : Some(this.items[0]);
  }
  size(): usize {
    return this.items.length;
  }
}

export class Registry<K, V> {
  keys: K[] = [];
  boxes: Box<V>[] = [];
  register(k: K, v: V): void {
    this.keys.push(k);
    this.boxes.push(new Box(v));
  }
  at(i: usize): V {
    return this.boxes[i].get();
  }
}

function hidden(): int {
  return 3;
}

export function mk(n: int): Box<int> {
  return new Box<int>(n + hidden());
}
