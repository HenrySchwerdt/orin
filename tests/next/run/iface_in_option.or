// Option<Shape>: conversion inside Some(..), unwrap and match.
interface Shape {
  area(): int;
}

class Sq implements Shape {
  constructor(public s: int) {}
  area(): int { return this.s * this.s; }
}

function find(n: int): Option<Shape> {
  if (n > 0) {
    return Some(new Sq(n));
  }
  return None;
}

function main(): void {
  const a = find(3);
  const b = find(0);
  console.log(a.isSome().toString() + b.isNone().toString());
  console.log(a.unwrap().area().toString());
  const s = match (find(4)) {
    Some(x) => x.area(),
    None => 0 - 1
  };
  console.log(s.toString());
  const r: Result<Shape, string> = Ok(new Sq(2));
  console.log(r.unwrap().area().toString());
}
