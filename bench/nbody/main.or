// N-body simulation (5 bodies, 1,000,000 steps) with floats: struct-of-arrays, sqrt from std:math.
// Prints the energy before and after, scaled to integers (1e9) so all languages print identical text.
import { sqrt } from "std:math";

function energy(x: float[], y: float[], z: float[], vx: float[], vy: float[], vz: float[], m: float[]): float {
  let e = 0.0;
  let i: usize = 0;
  while (i < x.length) {
    e += 0.5 * m[i] * (vx[i] * vx[i] + vy[i] * vy[i] + vz[i] * vz[i]);
    let j = i + 1;
    while (j < x.length) {
      const dx = x[i] - x[j];
      const dy = y[i] - y[j];
      const dz = z[i] - z[j];
      e -= m[i] * m[j] / sqrt(dx * dx + dy * dy + dz * dz);
      j += 1;
    }
    i += 1;
  }
  return e;
}

function main(): void {
  const pi = 3.141592653589793;
  const solar = 4.0 * pi * pi;
  const dpy = 365.24;
  let x: float[] = [0.0, 4.84143144246472090e+00, 8.34336671824457987e+00, 1.28943695621391310e+01, 1.53796971148509165e+01];
  let y: float[] = [0.0, -1.16032004402742839e+00, 4.12479856412430479e+00, -1.51111514016986312e+01, -2.59193146099879641e+01];
  let z: float[] = [0.0, -1.03622044471123109e-01, -4.03523417114321381e-01, -2.23307578892655734e-01, 1.79258772950371181e-01];
  let vx: float[] = [0.0, 1.66007664274403694e-03 * dpy, -2.76742510726862411e-03 * dpy, 2.96460137564761618e-03 * dpy, 2.68067772490389322e-03 * dpy];
  let vy: float[] = [0.0, 7.69901118419740425e-03 * dpy, 4.99852801234917238e-03 * dpy, 2.37847173959480950e-03 * dpy, 1.62824170038242295e-03 * dpy];
  let vz: float[] = [0.0, -6.90460016972063023e-05 * dpy, 2.30417297573763929e-05 * dpy, -2.96589568540237556e-05 * dpy, -9.51592254519715870e-05 * dpy];
  let m: float[] = [solar, 9.54791938424326609e-04 * solar, 2.85885980666130812e-04 * solar, 4.36624404335156298e-05 * solar, 5.15138902046611451e-05 * solar];
  let px = 0.0;
  let py = 0.0;
  let pz = 0.0;
  let k: usize = 0;
  while (k < 5) {
    px += vx[k] * m[k];
    py += vy[k] * m[k];
    pz += vz[k] * m[k];
    k += 1;
  }
  vx[0] = -px / solar;
  vy[0] = -py / solar;
  vz[0] = -pz / solar;
  console.log("energy0: " + (energy(x, y, z, vx, vy, vz, m) * 1.0e9).round().toInt().toString());
  const dt = 0.01;
  let step = 0;
  while (step < 1000000) {
    let i: usize = 0;
    while (i < 5) {
      let j = i + 1;
      while (j < 5) {
        const dx = x[i] - x[j];
        const dy = y[i] - y[j];
        const dz = z[i] - z[j];
        const d2 = dx * dx + dy * dy + dz * dz;
        const mag = dt / (d2 * sqrt(d2));
        vx[i] -= dx * m[j] * mag;
        vy[i] -= dy * m[j] * mag;
        vz[i] -= dz * m[j] * mag;
        vx[j] += dx * m[i] * mag;
        vy[j] += dy * m[i] * mag;
        vz[j] += dz * m[i] * mag;
        j += 1;
      }
      i += 1;
    }
    i = 0;
    while (i < 5) {
      x[i] += dt * vx[i];
      y[i] += dt * vy[i];
      z[i] += dt * vz[i];
      i += 1;
    }
    step += 1;
  }
  console.log("energy1: " + (energy(x, y, z, vx, vy, vz, m) * 1.0e9).round().toInt().toString());
}
