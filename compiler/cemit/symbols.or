// The program-wide symbol table of the C backend (rewrite step 3d, rule 8).
//
// Everything that is numbered across the whole program is fixed here, in one step that runs before any function is
// emitted and walks the program in a fixed order: the function symbols (`orin_fn_<i>_<name>`, by function index), their
// C signatures, and the counts of the string literals (`orin_s<k>`, numbered by the lowering's string table) and the
// vtables (`orin_vt<k>`). Emitting a function only *reads* this table, so the functions can be emitted independently (in
// any order, or in parallel) and joined in index order with byte-identical output.

import { MProgram, MFunction, isInlineFn } from "../mir";
import { u, cty, fnSymbol, identChars } from "./text";

// `@Inline` (ADR-0024) becomes `static inline`: a hint the C compiler may ignore, so semantics and link behaviour (one
// translation unit) are unchanged.
@Requires(f.paramCount <= f.locals.length)
@Ensures(result.includes(` ${name}(`) && result.endsWith(")"))
export function signature(name: string, f: MFunction, inl: bool): string {
  let s = (inl ? "static inline " : "") + cty(f.ret) + " " + name + "(";
  if (f.paramCount == 0) {
    s += "void";
  }
  let i: usize = 0;
  while (i < f.paramCount) {
    if (i > 0) {
      s += ", ";
    }
    s += cty(f.locals[i].ty) + " l" + u(i);
    i += 1;
  }
  if (f.inout) {
    s += ", OrinObj **orin_out";
  }
  s += ")";
  return s;
}

// One symbol and one signature per function, in function order; the symbols are distinct (the index `byName` is as large
// as the list, so no symbol shadows another); the string literal and vtable counts are those of the program.
@Invariant(this.names.length == this.sigs.length)
@Invariant(this.byName.size == this.names.length)
export class CSymbols {
  private names: string[];
  private sigs: string[];
  private byName: Map<string, usize>;
  private nStrings: usize;
  private nVtables: usize;

  constructor(
    names: string[],
    sigs: string[],
    byName: Map<string, usize>,
    nStrings: usize,
    nVtables: usize,
  ) {
    this.names = names;
    this.sigs = sigs;
    this.byName = byName;
    this.nStrings = nStrings;
    this.nVtables = nVtables;
  }

  // Number of functions.
  count(): usize {
    return this.names.length;
  }

  strings(): usize {
    return this.nStrings;
  }

  vtables(): usize {
    return this.nVtables;
  }

  // The symbol of function `i`.
  @Requires(i < this.names.length)
  @Ensures(this.byName.get(result).isSome() && this.byName.get(result).unwrap() == i)
  name(i: usize): string {
    return this.names[i];
  }

  // The C signature of function `i` (without `;` or body).
  @Requires(i < this.sigs.length)
  sig(i: usize): string {
    return this.sigs[i];
  }

  // True when `sym` is the symbol of a function of the program.
  isFunction(sym: string): bool {
    return this.byName.has(sym);
  }
}

// The symbol table of `prog`: built in function order, before any function is emitted.
@Ensures(result.count() == prog.functions.length)
@Ensures(result.strings() == prog.strings.length && result.vtables() == prog.vtables.length)
export function cSymbols(prog: MProgram): CSymbols {
  let names: string[] = [];
  let sigs: string[] = [];
  let byName = new Map<string, usize>();
  let i: usize = 0;
  for (const f of prog.functions) {
    const n = fnSymbol(i, f.name);
    names.push(n);
    sigs.push(signature(n, f, isInlineFn(prog, f.name)));
    byName.set(n, i);
    i += 1;
  }
  return new CSymbols(names, sigs, byName, prog.strings.length, prog.vtables.length);
}

// ---------------------------------------------------------------- what a piece of output refers to

function isDigit(c: int): bool {
  return c >= 48 && c <= 57;
}

function isWordChar(c: int): bool {
  return isDigit(c) || c >= 65 && c <= 90 || c >= 97 && c <= 122 || c == 95;
}

// The end of the identifier that starts at `i`.
function wordEnd(text: string, i: usize): usize {
  let j = i;
  while (j < text.length && isWordChar(text.charCodeAt(j))) {
    j += 1;
  }
  return j;
}

// The index after the C string literal that starts (with its `"`) at `i`.
function stringEnd(text: string, i: usize): usize {
  let j = i + 1;
  while (j < text.length && text.charCodeAt(j) != 34) {
    j += text.charCodeAt(j) == 92 ? 2 : 1;
  }
  return j + 1;
}

// The index after the block comment that starts at `i`.
function commentEnd(text: string, i: usize): usize {
  let j = i + 2;
  while (j + 1 < text.length && !(text.charCodeAt(j) == 42 && text.charCodeAt(j + 1) == 47)) {
    j += 1;
  }
  return j + 2;
}

// Is the numbered symbol `<prefix><k>` at `i` (a whole identifier, k decimal) below `n`? Identifiers that start with the
// prefix but continue with something else than digits (`orin_str_eq`, `orin_s2f`, `orin_vtable`) are not numbered
// symbols and pass.
function numberedBelow(text: string, i: usize, prefix: string, n: usize): bool {
  const start = i + prefix.length;
  let j = start;
  let v: usize = 0;
  while (j < text.length && isDigit(text.charCodeAt(j))) {
    if (v < 1000000000) {
      v = v * 10 + (text.charCodeAt(j) - 48).toUsize();
    }
    j += 1;
  }
  if (j == start || j < text.length && isWordChar(text.charCodeAt(j))) {
    return true;
  }
  return v < n;
}

// Every program symbol that `text` (C code of one function, or of the whole unit) mentions is declared by `syms`: each
// `orin_fn_..` identifier outside string literals and comments is the symbol of a function, each `orin_s<k>` names a string literal (k below the number of
// literals: those are the ones the unit defines), each `orin_vt<k>` a vtable. Catches a call or closure that names a
// function by a stale or recomputed symbol, a string index past the literal table, a vtable that is not emitted.
export function refsDeclared(text: string, syms: CSymbols): bool {
  let i: usize = 0;
  while (i < text.length) {
    const c = text.charCodeAt(i);
    if (c == 34) {
      i = stringEnd(text, i);
    } else if (c == 47 && i + 1 < text.length && text.charCodeAt(i + 1) == 42) {
      i = commentEnd(text, i);
    } else if (isWordChar(c)) {
      const end = wordEnd(text, i);
      if (text.charCodeAt(i) == 111 && end - i > 5) {
        const w = text.substring(i, end);
        if (w.startsWith("orin_fn_") && !syms.isFunction(w)) {
          return false;
        }
        if (w.startsWith("orin_s") && !numberedBelow(text, i, "orin_s", syms.strings())) {
          return false;
        }
        if (w.startsWith("orin_vt") && !numberedBelow(text, i, "orin_vt", syms.vtables())) {
          return false;
        }
      }
      i = end;
    } else {
      i += 1;
    }
  }
  return true;
}

// Every symbol is a C identifier of the form `orin_fn_<i>_..` with its own index (used by the tests).
export function symbolsWellFormed(syms: CSymbols): bool {
  let i: usize = 0;
  while (i < syms.count()) {
    const n = syms.name(i);
    if (!identChars(n) || !n.startsWith(`orin_fn_${u(i)}_`)) {
      return false;
    }
    i += 1;
  }
  return true;
}
