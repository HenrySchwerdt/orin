      return false;
    }
    if (id != root && kc < t - 1) {
      return false;
    }
    const kk = nodes[id].kids.length;
    if (kk == 0) {
      if (leafDepth < 0) {
        leafDepth = d.toInt();
      } else if (leafDepth != d.toInt()) {
        return false;
      }
    } else {
      if (kk != kc + 1 || kc == 0) {
        return false;
      }
      let c: usize = 0;
      while (c < kk) {
