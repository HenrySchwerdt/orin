// orin — the self-hosted Orin compiler driver (Stage 1+).
// CLI (identical to the Stage 0 `orinb` subset used by tools/):
//   orin check <entry.or>
//   orin compile <entry.or> -o <out.c>

import { args, exit } from "std:process";
import { writeFile } from "std:fs";
import { SourceMap, Diagnostic, render } from "./diag";
import { loadAll } from "./loader";
import { check } from "./check";
import { generate } from "./codegen";
import { runFmt, printDiagnosticsJson } from "./tools";

function usage(): void {
  console.error("usage:\n  orin check [--format=json] <entry.or>\n  orin compile [--format=json] <entry.or> -o <out.c>\n  orin fmt [--check] [--stdout] <file.or>...");
  exit(2);
}

function report(sm: SourceMap, diags: Diagnostic[], json: bool): void {
  if (json) {
    printDiagnosticsJson(sm, diags);
    exit(1);
    return;
  }
  for (const d of diags) {
    console.error(render(sm, d));
  }
  exit(1);
}

function main(): void {
  const all = args();
  if (all.length >= 1 && all[0] == "fmt") {
    const code = runFmt(all.slice(1, all.length));
    if (code != 0) {
      exit(code);
    }
    return;
  }
  let json = false;
  let argv: string[] = [];
  for (const a of all) {
    if (a == "--format=json") {
      json = true;
    } else {
      argv.push(a);
    }
  }
  if (argv.length < 2) {
    usage();
    return;
  }
  const cmd = argv[0];
  const entry = argv[1];
  const isCompile = cmd == "compile";
  if (!isCompile && cmd != "check") {
    usage();
    return;
  }
  if (isCompile && (argv.length < 4 || argv[2] != "-o")) {
    usage();
    return;
  }
  const loaded = loadAll(entry);
  if (loaded.diags.length > 0) {
    report(loaded.sm, loaded.diags, json);
    return;
  }
  const program = loaded.program.unwrap();
  const checked = check(program, loaded.sm);
  if (checked.isErr()) {
    report(loaded.sm, checked.unwrapErr(), json);
    return;
  }
  if (!isCompile) {
    return;
  }
  const c = generate(checked.unwrap());
  const written = writeFile(argv[3], c);
  if (written.isErr()) {
    console.error("error: cannot write " + argv[3] + ": " + written.unwrapErr());
    exit(1);
  }
}
