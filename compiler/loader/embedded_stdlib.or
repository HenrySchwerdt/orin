;\n    let zc: usize[] = [];\n    if (yc.length > 0) {\n      zc = yc.slice(t, yc.length);\n      this.nodes[y].kids = yc.slice(0, t);\n    }\n    const z = this.alloc(yk.slice(t, yk.length), yv.slice(t, yv.length), zc);\n    this.nodes[y].keys = yk.slice(0, t - 1);\n    this.nodes[y].vals = yv.slice(0, t - 1);\n    this.insertKey(x, i, med, medv);\n    this.insertKid(x, i + 1, z);\n  }\n\n  // put(k, v): set the value for k; true when k was new (the size grows by 1), false when an existing value was\n  // replaced. One root-to-leaf pass that splits full nodes on the way down. O(t log_t n).\n  @Ensures(this.has(k) && this.get(k).isSome())\n  @Ensures(result == !old(this.has(k)))\n  @Ensures(result ==> this.size() == old(this.size()) + 1)\n  @Ensures(!result ==> this.size() == old(this.size()))\n  put(k: int, v: V): bool {\n    const maxKeys = 2 * this.t - 1;\n    if (this.nodes[this.root].keys.length == maxKeys) {\n      const nr = this.alloc([], [], [this.root]);\n      this.root = nr;\n      this.splitChild(nr, 0);\n    }\n    let x = this.root;\n    while (true) {\n      const i = lowerBoundInt(this.nodes[x].keys, k);\n      if (i < this.nodes[x].keys.length && (this.nodes[x].keys[i] == k)) {\n        this.nodes[x].vals[i] = v;\n        return false;\n      }\n      if (this.nodes[x].kids.length == 0) {\n        this.insertKey(x, i, k, v);\n        this.count += 1;\n        return true;\n      }\n      let ci = i;\n      if (this.nodes[this.nodes[x].kids[i]].keys.length == maxKeys) {\n        this.splitChild(x, i);\n        const m = this.nodes[x].keys[i];\n        if ((k == m)) {\n          this.nodes[x].vals[i] = v;\n          return false;\n        }\n        if ((k > m)) {\n          ci = i + 1;\n        }\n      }\n      x = this.nodes[x].kids[ci];\n    }\n    return false;\n  }\n\n  // Child number ci of x has t-1 keys: give it one more from a sibling (rotation through x) or merge it with a\n  // sibling. Returns the id of the child to descend into afterwards. May shrink the root.\n  private fill(x: usize, ci: usize): usize {\n    const t = this.t;\n    const len = this.nodes[x].keys.length;\n    const c = this.nodes[x].kids[ci];\n    if (ci > 0 && this.nodes[this.nodes[x].kids[ci - 1]].keys.length >= t) {\n      const l = this.nodes[x].kids[ci - 1];\n      const ll = this.nodes[l].keys.length;\n      this.insertKey(c, 0, this.nodes[x].keys[ci - 1], this.nodes[x].vals[ci - 1]);\n      this.nodes[x].keys[ci - 1] = this.nodes[l].keys[ll - 1];\n      this.nodes[x].vals[ci - 1] = this.nodes[l].vals[ll - 1];\n      if (this.nodes[l].kids.length > 0) {\n        this.insertKid(c, 0, this.nodes[l].kids[this.nodes[l].kids.length - 1]);\n        this.nodes[l].kids.pop();\n      }\n      this.nodes[l].keys.pop();\n      this.nodes[l].vals.pop();\n      return c;\n    }\n    if (ci < len && this.nodes[this.nodes[x].kids[ci + 1]].keys.length >= t) {\n      const r = this.nodes[x].kids[ci + 1];\n      this.insertKey(c, this.nodes[c].keys.length, this.nodes[x].keys[ci], this.nodes[x].vals[ci]);\n      this.nodes[x].keys[ci] = this.nodes[r].keys[0];\n      this.nodes[x].vals[ci] = this.nodes[r].vals[0];\n      this.removeKey(r, 0);\n      if (this.nodes[r].kids.length > 0) {\n        this.nodes[c].kids.push(this.nodes[r].kids[0]);\n        this.removeKid(r, 0);\n      }\n      return c;\n    }\n    if (ci < len) {\n      this.mergeChildren(x, ci);\n      return c;\n    }\n    const left = this.nodes[x].kids[ci - 1];\n    this.mergeChildren(x, ci - 1);\n    return left;\n  }\n\n  // Merges child i+1 of x and the separator key i into child i; releases child i+1. If x was the root and ends up\n  // without keys, its only child becomes the root.\n  private mergeChildren(x: usize, i: usize): void {\n    const y = this.nodes[x].kids[i];\n    const z = this.nodes[x].kids[i + 1];\n    this.nodes[y].keys.push(this.nodes[x].keys[i]);\n    this.nodes[y].vals.push(this.nodes[x].vals[i]);\n    let a: usize = 0;\n    while (a < this.nodes[z].keys.length) {\n      this.nodes[y].keys.push(this.nodes[z].keys[a]);\n      this.nodes[y].vals.push(this.nodes[z].vals[a]);\n      a += 1;\n    }\n    let b: usize = 0;\n    while (b < this.nodes[z].kids.length) {\n      this.nodes[y].kids.push(this.nodes[z].kids[b]);\n      b += 1;\n    }\n    this.removeKey(x, i);\n    this.removeKid(x, i + 1);\n    this.release(z);\n    if (x == this.root && this.nodes[x].keys.length == 0) {\n      this.root = y;\n      this.release(x);\n    }\n  }\n\n  // remove(k): delete the entry for k and return its value, None when absent. One root-to-leaf pass (CLRS\n  // top-down deletion): a node is only entered when it has at least t keys, so removing from a leaf never\n  // underflows. A key in an inner node is replaced by its predecessor or successor (or the children are merged) and\n  // that key is deleted further down. O(t log_t n).\n  @Ensures(!this.has(k))\n  @Ensures(result.isSome() == old(this.has(k)))\n  @Ensures(result.isSome() ==> this.size() == old(this.size()) - 1)\n  @Ensures(result.isNone() ==> this.size() == old(this.size()))\n  remove(k: int): Option<V> {\n    const t = this.t;\n    let x = this.root;\n    let target = k;\n    let removed: Option<V> = None;\n    let saved = false;\n    while (true) {\n      const len = this.nodes[x].keys.length;\n      const i = lowerBoundInt(this.nodes[x].keys, target);\n      const isLeaf = this.nodes[x].kids.length == 0;\n      if (i < len && (this.nodes[x].keys[i] == target)) {\n        if (isLeaf) {\n          if (!saved) {\n            removed = Some(this.nodes[x].vals[i]);\n          }\n          this.removeKey(x, i);\n          this.count -= 1;\n          return removed;\n        }\n        if (!saved) {\n          removed = Some(this.nodes[x].vals[i]);\n          saved = true;\n        }\n        const y = this.nodes[x].kids[i];\n        const z = this.nodes[x].kids[i + 1];\n        if (this.nodes[y].keys.length >= t) {\n          let w = y;\n          while (this.nodes[w].kids.length > 0) {\n            w = this.nodes[w].kids[this.nodes[w].kids.length - 1];\n          }\n          const last = this.nodes[w].keys.length - 1;\n          this.nodes[x].keys[i] = this.nodes[w].keys[last];\n          this.nodes[x].vals[i] = this.nodes[w].vals[last];\n          target = this.nodes[w].keys[last];\n          x = y;\n        } else if (this.nodes[z].keys.length >= t) {\n          let w = z;\n          while (this.nodes[w].kids.length > 0) {\n            w = this.nodes[w].kids[0];\n          }\n          this.nodes[x].keys[i] = this.nodes[w].keys[0];\n          this.nodes[x].vals[i] = this.nodes[w].vals[0];\n          target = this.nodes[w].keys[0];\n          x = z;\n        } else {\n          this.mergeChildren(x, i);\n          x = y;\n        }\n      } else {\n        if (isLeaf) {\n          return removed;\n        }\n        const c = this.nodes[x].kids[i];\n        if (this.nodes[c].keys.length < t) {\n          x = this.fill(x, i);\n        } else {\n          x = c;\n        }\n      }\n    }\n    return removed;\n  }\n\n  // firstKey(): the smallest key, None when empty. O(height).\n  @Ensures(result.isSome() == (this.size() > 0))\n  @Ensures(result.isSome() ==> this.has(result.unwrap()))\n  firstKey(): Option<int> {\n    if (this.count == 0) {\n      return None;\n    }\n    let x = this.root;\n    while (this.nodes[x].kids.length > 0) {\n      x = this.nodes[x].kids[0];\n    }\n    return Some(this.nodes[x].keys[0]);\n  }\n\n  // lastKey(): the largest key, None when empty. O(height).\n  @Ensures(result.isSome() == (this.size() > 0))\n  @Ensures(result.isSome() ==> this.has(result.unwrap()))\n  lastKey(): Option<int> {\n    if (this.count == 0) {\n      return None;\n    }\n    let x = this.root;\n    while (this.nodes[x].kids.length > 0) {\n      x = this.nodes[x].kids[this.nodes[x].kids.length - 1];\n    }\n    return Some(this.nodes[x].keys[this.nodes[x].keys.length - 1]);\n  }\n\n  // floorKey(k): the greatest key <= k, None when there is none. One descent. O(t log_t n).\n  @Ensures(result.isSome() ==> (result.unwrap() <= k) && this.has(result.unwrap()))\n  @Ensures(result.isNone() ==> this.firstKey().isNone() || (this.firstKey().unwrap() > k))\n  floorKey(k: int): Option<int> {\n    let best: Option<int> = None;\n    let x = this.root;\n    while (true) {\n      const i = lowerBoundInt(this.nodes[x].keys, k);\n      if (i < this.nodes[x].keys.length && (this.nodes[x].keys[i] == k)) {\n        return Some(k);\n      }\n      if (i > 0) {\n        best = Some(this.nodes[x].keys[i - 1]);\n      }\n      if (this.nodes[x].kids.length == 0) {\n        return best;\n      }\n      x = this.nodes[x].kids[i];\n    }\n    return best;\n  }\n\n  // ceilKey(k): the smallest key >= k, None when there is none. One descent. O(t log_t n).\n  @Ensures(result.isSome() ==> (result.unwrap() >= k) && this.has(result.unwrap()))\n  @Ensures(result.isNone() ==> this.lastKey().isNone() || (this.lastKey().unwrap() < k))\n  ceilKey(k: int): Option<int> {\n    let best: Option<int> = None;\n    let x = this.root;\n    while (true) {\n      const i = lowerBoundInt(this.nodes[x].keys, k);\n      if (i < this.nodes[x].keys.length) {\n        if ((this.nodes[x].keys[i] == k)) {\n          return Some(k);\n        }\n        best = Some(this.nodes[x].keys[i]);\n      }\n      if (this.nodes[x].kids.length == 0) {\n        return best;\n      }\n      x = this.nodes[x].kids[i];\n    }\n    return best;\n  }\n\n  // popFirst(): remove the entry with the smallest key and return it, None when empty. O(t log_t n).\n  @Ensures(result.isSome() == (old(this.size()) > 0))\n  @Ensures(result.isSome() ==> this.size() == old(this.size()) - 1 && !this.has(result.unwrap().key))\n  @Ensures(result.isSome() ==> (result.unwrap().key == old(this.firstKey().unwrapOr(0))))\n  @Ensures(result.isSome() && this.size() > 0 ==> (this.firstKey().unwrap() > result.unwrap().key))\n  popFirst(): Option<SortedEntry<V>> {\n    const f = this.firstKey();\n    if (f.isNone()) {\n      return None;\n    }\n    const v = this.remove(f.unwrap()).unwrap();\n    return Some(SortedEntry<V> { key: f.unwrap(), value: v });\n  }\n\n  // popLast(): remove the entry with the largest key and return it, None when empty. O(t log_t n).\n  @Ensures(result.isSome() == (old(this.size()) > 0))\n  @Ensures(result.isSome() ==> this.size() == old(this.size()) - 1 && !this.has(result.unwrap().key))\n  @Ensures(result.isSome() ==> (result.unwrap().key == old(this.lastKey().unwrapOr(0))))\n  @Ensures(result.isSome() && this.size() > 0 ==> (this.lastKey().unwrap() < result.unwrap().key))\n  popLast(): Option<SortedEntry<V>> {\n    const l = this.lastKey();\n    if (l.isNone()) {\n      return None;\n    }\n    const v = this.remove(l.unwrap()).unwrap();\n    return Some(SortedEntry<V> { key: l.unwrap(), value: v });\n  }\n\n  // keyArray(): all keys in increasing order. O(n).\n  @Ensures(result.length == this.size() && isStrictlyIncreasing(result))\n  keyArray(): int[] {\n    return btreeIntKeys(this.nodes, this.root);\n  }\n\n  // valueArray(): all values in key order. O(n).\n  @Ensures(result.length == this.size())\n  valueArray(): V[] {\n    return btreeIntVals(this.nodes, this.root);\n  }\n\n  // clear(): remove all entries. O(1).\n  @Ensures(this.size() == 0)\n  clear(): void {\n    this.nodes = [IntNode<V> { keys: [], vals: [], kids: [] }];\n    this.root = 0;\n    this.free = [];\n    this.count = 0;\n  }\n}\n\n// ------------------------------------------------------------------------------------------ SortedStringMap\n\n// One node of the B-tree: `keys` sorted, `vals` parallel to them, `kids` empty for a leaf, else keys.length + 1\n// child ids (indices into the arena `nodes` of the map).\nexport type StrNode<V> = { keys: string[]; vals: V[]; kids: usize[]; };\n\n// An entry returned by `SortedStringMap.popFirst` / `popLast`.\nexport type SortedStringEntry<V> = { key: string; value: V; };\n\n// The first index whose key is >= k (keys.length when there is none). Binary search, O(log keys.length).\n@Ensures(result <= keys.length)\n@Ensures(result < keys.length ==> (compareStrings(keys[result], k) >= 0))\n@Ensures(result > 0 ==> (compareStrings(keys[result - 1], k) < 0))\nexport function lowerBoundStr(keys: string[], k: string): usize {\n  let lo: usize = 0;\n  let hi: usize = keys.length;\n  while (lo < hi) {\n    const mid = lo + (hi - lo) / 2;\n    if ((compareStrings(keys[mid], k) < 0)) {\n      lo = mid + 1;\n    } else {\n      hi = mid;\n    }\n  }\n  return lo;\n}\n\n// Is `nodes` a well-formed B-tree arena of minimum degree t rooted at `root`, with free list `free`? Checked\n// iteratively with an explicit stack: every node id is in range and reached exactly once (no dangling or shared\n// ids, no cycles), keys and values have the same length, a leaf has no children and an inner node has one more\n// child than keys (and at least one key), every non-root node holds t-1 .. 2t-1 keys and the root at most 2t-1,\n// all leaves have the same depth, the free list holds distinct ids of unreachable nodes, and every arena slot is\n// either reachable or free.\nexport function btreeStrShapeOk<V>(nodes: StrNode<V>[], root: usize, t: usize, free: usize[]): bool {\n  const n = nodes.length;\n  if (t < 2 || root >= n) {\n    return false;\n  }\n  let seen: bool[] = [];\n  let i: usize = 0;\n  while (i < n) {\n    seen.push(false);\n    i += 1;\n  }\n  i = 0;\n  while (i < free.length) {\n    if (free[i] >= n || seen[free[i]]) {\n      return false;\n    }\n    seen[free[i]] = true;\n    i += 1;\n  }\n  let ids: usize[] = [root];\n  let depths: usize[] = [0];\n  let leafDepth: int = -1;\n  let reachable: usize = 0;\n  while (ids.length > 0) {\n    const id = ids.pop().unwrap();\n    const d = depths.pop().unwrap();\n    if (seen[id]) {\n      return false;\n    }\n    seen[id] = true;\n    reachable += 1;\n    const kc = nodes[id].keys.length;\n    if (nodes[id].vals.length != kc || kc > 2 * t - 1) {\n      return false;\n    }\n    if (id != root && kc < t - 1) {\n      return false;\n    }\n    const kk = nodes[id].kids.length;\n    if (kk == 0) {\n      if (leafDepth < 0) {\n        leafDepth = d.toInt();\n      } else if (leafDepth != d.toInt()) {\n        return false;\n      }\n    } else {\n      if (kk != kc + 1 || kc == 0) {\n        return false;\n      }\n      let c: usize = 0;\n      while (c < kk) {\n        if (nodes[id].kids[c] >= n) {\n          return false;\n        }\n        ids.push(nodes[id].kids[c]);\n        depths.push(d + 1);\n        c += 1;\n      }\n    }\n  }\n  return reachable + free.length == n;\n}\n\n// Are the keys ordered? Inside every node strictly increasing, and every key of a child lies strictly between the\n// separator keys around it in the parent (inherited bounds), which together say the in-order sequence is strictly\n// increasing. Iterative; tolerates a broken shape (out-of-range ids, revisits) by answering false.\nexport function btreeStrOrderOk<V>(nodes: StrNode<V>[], root: usize): bool {\n  if (root >= nodes.length) {\n    return false;\n  }\n  let ids: usize[] = [root];\n  let loFlags: bool[] = [false];\n  let los: string[] = [\"\"];\n  let hiFlags: bool[] = [false];\n  let his: string[] = [\"\"];\n  let visited: usize = 0;\n  while (ids.length > 0) {\n    visited += 1;\n    if (visited > nodes.length) {\n      return false;\n    }\n    const id = ids.pop().unwrap();\n    const hasLo = loFlags.pop().unwrap();\n    const lo = los.pop().unwrap();\n    const hasHi = hiFlags.pop().unwrap();\n    const hi = his.pop().unwrap();\n    const kc = nodes[id].keys.length;\n    let j: usize = 0;\n    while (j < kc) {\n      if (j > 0 && (compareStrings(nodes[id].keys[j - 1], nodes[id].keys[j]) >= 0)) {\n        return false;\n      }\n      j += 1;\n    }\n    if (kc > 0) {\n      if (hasLo && (compareStrings(nodes[id].keys[0], lo) <= 0)) {\n        return false;\n      }\n      if (hasHi && (compareStrings(nodes[id].keys[kc - 1], hi) >= 0)) {\n        return false;\n      }\n    }\n    const kk = nodes[id].kids.length;\n    if (kk > 0 && kk != kc + 1) {\n      return false;\n    }\n    let c: usize = 0;\n    while (c < kk) {\n      if (nodes[id].kids[c] >= nodes.length) {\n        return false;\n      }\n      ids.push(nodes[id].kids[c]);\n      if (c == 0) {\n        loFlags.push(hasLo);\n        los.push(lo);\n      } else {\n        loFlags.push(true);\n        los.push(nodes[id].keys[c - 1]);\n      }\n      if (c == kc) {\n        hiFlags.push(hasHi);\n        his.push(hi);\n      } else {\n        hiFlags.push(true);\n        his.push(nodes[id].keys[c]);\n      }\n      c += 1;\n    }\n  }\n  return true;\n}\n\n// The number of keys stored in the tree below `root` (iterative; a revisit or bad id stops the walk early).\nexport function btreeStrKeyCount<V>(nodes: StrNode<V>[], root: usize): usize {\n  if (root >= nodes.length) {\n    return 0;\n  }\n  let ids: usize[] = [root];\n  let total: usize = 0;\n  let visited: usize = 0;\n  while (ids.length > 0) {\n    visited += 1;\n    if (visited > nodes.length) {\n      return total;\n    }\n    const id = ids.pop().unwrap();\n    total += nodes[id].keys.length;\n    let c: usize = 0;\n    while (c < nodes[id].kids.length) {\n      if (nodes[id].kids[c] < nodes.length) {\n        ids.push(nodes[id].kids[c]);\n      }\n      c += 1;\n    }\n  }\n  return total;\n}\n\n// Height of the tree: the number of levels (1 for a single leaf root). Follows the first child down. O(height).\nexport function btreeStrHeight<V>(nodes: StrNode<V>[], root: usize): usize {\n  let h: usize = 1;\n  let id = root;\n  while (id < nodes.length && nodes[id].kids.length > 0 && h <= nodes.length) {\n    id = nodes[id].kids[0];\n    h += 1;\n  }\n  return h;\n}\n\n// The fewest keys a tree of minimum degree t and the given height can hold: the root has 1 key, every other node\n// at least t-1, so level d >= 1 has >= 2 t^(d-1) nodes and the total is 2 t^(h-1) - 1 (height 1: 1 key, but the\n// root leaf may also be empty, so 0 is returned for an empty tree by the caller). This is why height is O(log_t n).\n@Requires(t >= 2 && h >= 1)\nexport function btreeMinKeysStr(h: usize, t: usize): usize {\n  let p: usize = 1;\n  let d: usize = 1;\n  while (d < h) {\n    p *= t;\n    d += 1;\n  }\n  return 2 * p - 1;\n}\n\n// All keys in order, by an explicit-stack in-order walk (the stack holds a node id and how many of its children\n// were visited). O(n).\nexport function btreeStrKeys<V>(nodes: StrNode<V>[], root: usize): string[] {\n  let out: string[] = [];\n  let ids: usize[] = [root];\n  let js: usize[] = [0];\n  while (ids.length > 0) {\n    const top = ids.length - 1;\n    const id = ids[top];\n    const j = js[top];\n    const kc = nodes[id].keys.length;\n    if (nodes[id].kids.length == 0) {\n      let a: usize = 0;\n      while (a < kc) {\n        out.push(nodes[id].keys[a]);\n        a += 1;\n      }\n      ids.pop();\n      js.pop();\n    } else {\n      if (j > 0 && j - 1 < kc) {\n        out.push(nodes[id].keys[j - 1]);\n      }\n      if (j <= kc) {\n        js[top] = j + 1;\n        ids.push(nodes[id].kids[j]);\n        js.push(0);\n      } else {\n        ids.pop();\n        js.pop();\n      }\n    }\n  }\n  return out;\n}\n\n// All values in key order (same walk as `btreeStrKeys`). O(n).\nexport function btreeStrVals<V>(nodes: StrNode<V>[], root: usize): V[] {\n  let out: V[] = [];\n  let ids: usize[] = [root];\n  let js: usize[] = [0];\n  while (ids.length > 0) {\n    const top = ids.length - 1;\n    const id = ids[top];\n    const j = js[top];\n    const kc = nodes[id].keys.length;\n    if (nodes[id].kids.length == 0) {\n      let a: usize = 0;\n      while (a < kc) {\n        out.push(nodes[id].vals[a]);\n        a += 1;\n      }\n      ids.pop();\n      js.pop();\n    } else {\n      if (j > 0 && j - 1 < kc) {\n        out.push(nodes[id].vals[j - 1]);\n      }\n      if (j <= kc) {\n        js[top] = j + 1;\n        ids.push(nodes[id].kids[j]);\n        js.push(0);\n      } else {\n        ids.pop();\n        js.pop();\n      }\n    }\n  }\n  return out;\n}\n\n// An ordered map from string keys to values of type V: a B-tree of minimum degree t (every node but the root holds\n// t-1 .. 2t-1 keys, all leaves at the same depth) whose nodes live in an arena (`nodes`) and refer to each other\n// by index, so the structure is a plain value (copy-on-write arrays, no pointers, no parent links). `free` lists\n// the arena slots of merged-away nodes for reuse. Insertion splits full nodes on the way down and deletion makes\n// every node it enters hold at least t keys (borrow from a sibling or merge), so both run in one root-to-leaf pass.\n//\n// Invariants (`@Invariant`, checked after every public method by `orin test` / `--check-contracts`): the arena is a\n// valid B-tree of degree t (shape, occupancy, equal leaf depth, no dangling or shared ids, consistent free list),\n// keys are ordered (sorted within nodes and bounded by the separators above them) and the stored count equals the\n// number of keys. Complexity: has/get/put/remove/floorKey/ceilKey/firstKey/lastKey/popFirst/popLast O(t log_t n)\n// (a binary search of O(log t) in each of O(log_t n) nodes, plus O(t) to shift keys inside one node per level on\n// updates); size/isEmpty O(1); keyArray/valueArray O(n); `height()` <= 1 + log_t((n+1)/2). Use t = 16 unless you\n// have measured otherwise; `minDegree` 2 gives the smallest nodes and deepest trees (useful for tests).\n@Invariant(this.t >= 2)\n@Invariant(btreeStrShapeOk(this.nodes, this.root, this.t, this.free))\n@Invariant(btreeStrOrderOk(this.nodes, this.root))\n@Invariant(btreeStrKeyCount(this.nodes, this.root) == this.count)\nexport class SortedStringMap<V> {\n  private t: usize;\n  private nodes: StrNode<V>[] = [StrNode<V> { keys: [], vals: [], kids: [] }];\n  private root: usize = 0;\n  private free: usize[] = [];\n  private count: usize = 0;\n\n  // new SortedStringMap<V>(minDegree): an empty map; every node but the root keeps minDegree-1 .. 2*minDegree-1 keys.\n  @Requires(minDegree >= 2)\n  constructor(minDegree: usize) {\n    this.t = minDegree;\n  }\n\n  // size(): number of entries. O(1).\n  @Ensures(result == this.count)\n  size(): usize {\n    return this.count;\n  }\n\n  // isEmpty(): no entries. O(1).\n  @Ensures(result == (this.size() == 0))\n  isEmpty(): bool {\n    return this.count == 0;\n  }\n\n  // height(): number of levels of the tree (1 for the root leaf). It is logarithmic: a tree with this many levels\n  // holds at least 2 t^(h-1) - 1 keys, so n keys need at most about log_t(n/2) + 1 levels. O(height).\n  @Ensures(result >= 1)\n  @Ensures(this.count > 0 ==> btreeMinKeysStr(result, this.t) <= this.count)\n  height(): usize {\n    return btreeStrHeight(this.nodes, this.root);\n  }\n\n  // has(k): is there an entry for k? O(t log_t n).\n  @Ensures(result ==> this.size() > 0)\n  has(k: string): bool {\n    let x = this.root;\n    while (true) {\n      const i = lowerBoundStr(this.nodes[x].keys, k);\n      if (i < this.nodes[x].keys.length && (compareStrings(this.nodes[x].keys[i], k) == 0)) {\n        return true;\n      }\n      if (this.nodes[x].kids.length == 0) {\n        return false;\n      }\n      x = this.nodes[x].kids[i];\n    }\n    return false;\n  }\n\n  // get(k): the value for k, None when absent. O(t log_t n).\n  @Ensures(result.isSome() == this.has(k))\n  get(k: string): Option<V> {\n    let x = this.root;\n    while (true) {\n      const i = lowerBoundStr(this.nodes[x].keys, k);\n      if (i < this.nodes[x].keys.length && (compareStrings(this.nodes[x].keys[i], k) == 0)) {\n        return Some(this.nodes[x].vals[i]);\n      }\n      if (this.nodes[x].kids.length == 0) {\n        return None;\n      }\n      x = this.nodes[x].kids[i];\n    }\n    return None;\n  }\n\n  // A fresh arena slot (reusing a freed one) holding the given node contents.\n  private alloc(keys: string[], vals: V[], kids: usize[]): usize {\n    if (this.free.length > 0) {\n      const id = this.free.pop().unwrap();\n      this.nodes[id] = StrNode<V> { keys: keys, vals: vals, kids: kids };\n      return id;\n    }\n    this.nodes.push(StrNode<V> { keys: keys, vals: vals, kids: kids });\n    return this.nodes.length - 1;\n  }\n\n  // Empties an arena slot and puts it on the free list.\n  private release(id: usize): void {\n    this.nodes[id] = StrNode<V> { keys: [], vals: [], kids: [] };\n    this.free.push(id);\n  }\n\n  private insertKey(id: usize, pos: usize, k: string, v: V): void {\n    this.nodes[id].keys.push(k);\n    this.nodes[id].vals.push(v);\n    let j = this.nodes[id].keys.length - 1;\n    while (j > pos) {\n      this.nodes[id].keys[j] = this.nodes[id].keys[j - 1];\n      this.nodes[id].vals[j] = this.nodes[id].vals[j - 1];\n      j -= 1;\n    }\n    this.nodes[id].keys[pos] = k;\n    this.nodes[id].vals[pos] = v;\n  }\n\n  private removeKey(id: usize, pos: usize): void {\n    let j = pos;\n    while (j + 1 < this.nodes[id].keys.length) {\n      this.nodes[id].keys[j] = this.nodes[id].keys[j + 1];\n      this.nodes[id].vals[j] = this.nodes[id].vals[j + 1];\n      j += 1;\n    }\n    this.nodes[id].keys.pop();\n    this.nodes[id].vals.pop();\n  }\n\n  private insertKid(id: usize, pos: usize, kid: usize): void {\n    this.nodes[id].kids.push(kid);\n    let j = this.nodes[id].kids.length - 1;\n    while (j > pos) {\n      this.nodes[id].kids[j] = this.nodes[id].kids[j - 1];\n      j -= 1;\n    }\n    this.nodes[id].kids[pos] = kid;\n  }\n\n  private removeKid(id: usize, pos: usize): void {\n    let j = pos;\n    while (j + 1 < this.nodes[id].kids.length) {\n      this.nodes[id].kids[j] = this.nodes[id].kids[j + 1];\n      j += 1;\n    }\n    this.nodes[id].kids.pop();\n  }\n\n  // Splits the full child number i of node x around its median key, which moves up into x.\n  private splitChild(x: usize, i: usize): void {\n    const t = this.t;\n    const y = this.nodes[x].kids[i];\n    const yk = this.nodes[y].keys;\n    const yv = this.nodes[y].vals;\n    const yc = this.nodes[y].kids;\n    const med = yk[t - 1];\n    const medv = yv[t - 1];\n    let zc: usize[] = [];\n    if (yc.length > 0) {\n      zc = yc.slice(t, yc.length);\n      this.nodes[y].kids = yc.slice(0, t);\n    }\n    const z = this.alloc(yk.slice(t, yk.length), yv.slice(t, yv.length), zc);\n    this.nodes[y].keys = yk.slice(0, t - 1);\n    this.nodes[y].vals = yv.slice(0, t - 1);\n    this.insertKey(x, i, med, medv);\n    this.insertKid(x, i + 1, z);\n  }\n\n  // put(k, v): set the value for k; true when k was new (the size grows by 1), false when an existing value was\n  // replaced. One root-to-leaf pass that splits full nodes on the way down. O(t log_t n).\n  @Ensures(this.has(k) && this.get(k).isSome())\n  @Ensures(result == !old(this.has(k)))\n  @Ensures(result ==> this.size() == old(this.size()) + 1)\n  @Ensures(!result ==> this.size() == old(this.size()))\n  put(k: string, v: V): bool {\n    const maxKeys = 2 * this.t - 1;\n    if (this.nodes[this.root].keys.length == maxKeys) {\n      const nr = this.alloc([], [], [this.root]);\n      this.root = nr;\n      this.splitChild(nr, 0);\n    }\n    let x = this.root;\n    while (true) {\n      const i = lowerBoundStr(this.nodes[x].keys, k);\n      if (i < this.nodes[x].keys.length && (compareStrings(this.nodes[x].keys[i], k) == 0)) {\n        this.nodes[x].vals[i] = v;\n        return false;\n      }\n      if (this.nodes[x].kids.length == 0) {\n        this.insertKey(x, i, k, v);\n        this.count += 1;\n        return true;\n      }\n      let ci = i;\n      if (this.nodes[this.nodes[x].kids[i]].keys.length == maxKeys) {\n        this.splitChild(x, i);\n        const m = this.nodes[x].keys[i];\n        if ((compareStrings(k, m) == 0)) {\n          this.nodes[x].vals[i] = v;\n          return false;\n        }\n        if ((compareStrings(k, m) > 0)) {\n          ci = i + 1;\n        }\n      }\n      x = this.nodes[x].kids[ci];\n    }\n    return false;\n  }\n\n  // Child number ci of x has t-1 keys: give it one more from a sibling (rotation through x) or merge it with a\n  // sibling. Returns the id of the child to descend into afterwards. May shrink the root.\n  private fill(x: usize, ci: usize): usize {\n    const t = this.t;\n    const len = this.nodes[x].keys.length;\n    const c = this.nodes[x].kids[ci];\n    if (ci > 0 && this.nodes[this.nodes[x].kids[ci - 1]].keys.length >= t) {\n      const l = this.nodes[x].kids[ci - 1];\n      const ll = this.nodes[l].keys.length;\n      this.insertKey(c, 0, this.nodes[x].keys[ci - 1], this.nodes[x].vals[ci - 1]);\n      this.nodes[x].keys[ci - 1] = this.nodes[l].keys[ll - 1];\n      this.nodes[x].vals[ci - 1] = this.nodes[l].vals[ll - 1];\n      if (this.nodes[l].kids.length > 0) {\n        this.insertKid(c, 0, this.nodes[l].kids[this.nodes[l].kids.length - 1]);\n        this.nodes[l].kids.pop();\n      }\n      this.nodes[l].keys.pop();\n      this.nodes[l].vals.pop();\n      return c;\n    }\n    if (ci < len && this.nodes[this.nodes[x].kids[ci + 1]].keys.length >= t) {\n      const r = this.nodes[x].kids[ci + 1];\n      this.insertKey(c, this.nodes[c].keys.length, this.nodes[x].keys[ci], this.nodes[x].vals[ci]);\n      this.nodes[x].keys[ci] = this.nodes[r].keys[0];\n      this.nodes[x].vals[ci] = this.nodes[r].vals[0];\n      this.removeKey(r, 0);\n      if (this.nodes[r].kids.length > 0) {\n        this.nodes[c].kids.push(this.nodes[r].kids[0]);\n        this.removeKid(r, 0);\n      }\n      return c;\n    }\n    if (ci < len) {\n      this.mergeChildren(x, ci);\n      return c;\n    }\n    const left = this.nodes[x].kids[ci - 1];\n    this.mergeChildren(x, ci - 1);\n    return left;\n  }\n\n  // Merges child i+1 of x and the separator key i into child i; releases child i+1. If x was the root and ends up\n  // without keys, its only child becomes the root.\n  private mergeChildren(x: usize, i: usize): void {\n    const y = this.nodes[x].kids[i];\n    const z = this.nodes[x].kids[i + 1];\n    this.nodes[y].keys.push(this.nodes[x].keys[i]);\n    this.nodes[y].vals.push(this.nodes[x].vals[i]);\n    let a: usize = 0;\n    while (a < this.nodes[z].keys.length) {\n      this.nodes[y].keys.push(this.nodes[z].keys[a]);\n      this.nodes[y].vals.push(this.nodes[z].vals[a]);\n      a += 1;\n    }\n    let b: usize = 0;\n    while (b < this.nodes[z].kids.length) {\n      this.nodes[y].kids.push(this.nodes[z].kids[b]);\n      b += 1;\n    }\n    this.removeKey(x, i);\n    this.removeKid(x, i + 1);\n    this.release(z);\n    if (x == this.root && this.nodes[x].keys.length == 0) {\n      this.root = y;\n      this.release(x);\n    }\n  }\n\n  // remove(k): delete the entry for k and return its value, None when absent. One root-to-leaf pass (CLRS\n  // top-down deletion): a node is only entered when it has at least t keys, so removing from a leaf never\n  // underflows. A key in an inner node is replaced by its predecessor or successor (or the children are merged) and\n  // that key is deleted further down. O(t log_t n).\n  @Ensures(!this.has(k))\n  @Ensures(result.isSome() == old(this.has(k)))\n  @Ensures(result.isSome() ==> this.size() == old(this.size()) - 1)\n  @Ensures(result.isNone() ==> this.size() == old(this.size()))\n  remove(k: string): Option<V> {\n    const t = this.t;\n    let x = this.root;\n    let target = k;\n    let removed: Option<V> = None;\n    let saved = false;\n    while (true) {\n      const len = this.nodes[x].keys.length;\n      const i = lowerBoundStr(this.nodes[x].keys, target);\n      const isLeaf = this.nodes[x].kids.length == 0;\n      if (i < len && (compareStrings(this.nodes[x].keys[i], target) == 0)) {\n        if (isLeaf) {\n          if (!saved) {\n            removed = Some(this.nodes[x].vals[i]);\n          }\n          this.removeKey(x, i);\n          this.count -= 1;\n          return removed;\n        }\n        if (!saved) {\n          removed = Some(this.nodes[x].vals[i]);\n          saved = true;\n        }\n        const y = this.nodes[x].kids[i];\n        const z = this.nodes[x].kids[i + 1];\n        if (this.nodes[y].keys.length >= t) {\n          let w = y;\n          while (this.nodes[w].kids.length > 0) {\n            w = this.nodes[w].kids[this.nodes[w].kids.length - 1];\n          }\n          const last = this.nodes[w].keys.length - 1;\n          this.nodes[x].keys[i] = this.nodes[w].keys[last];\n          this.nodes[x].vals[i] = this.nodes[w].vals[last];\n          target = this.nodes[w].keys[last];\n          x = y;\n        } else if (this.nodes[z].keys.length >= t) {\n          let w = z;\n          while (this.nodes[w].kids.length > 0) {\n            w = this.nodes[w].kids[0];\n          }\n          this.nodes[x].keys[i] = this.nodes[w].keys[0];\n          this.nodes[x].vals[i] = this.nodes[w].vals[0];\n          target = this.nodes[w].keys[0];\n          x = z;\n        } else {\n          this.mergeChildren(x, i);\n          x = y;\n        }\n      } else {\n        if (isLeaf) {\n          return removed;\n        }\n        const c = this.nodes[x].kids[i];\n        if (this.nodes[c].keys.length < t) {\n          x = this.fill(x, i);\n        } else {\n          x = c;\n        }\n      }\n    }\n    return removed;\n  }\n\n  // firstKey(): the smallest key, None when empty. O(height).\n  @Ensures(result.isSome() == (this.size() > 0))\n  @Ensures(result.isSome() ==> this.has(result.unwrap()))\n  firstKey(): Option<string> {\n    if (this.count == 0) {\n      return None;\n    }\n    let x = this.root;\n    while (this.nodes[x].kids.length > 0) {\n      x = this.nodes[x].kids[0];\n    }\n    return Some(this.nodes[x].keys[0]);\n  }\n\n  // lastKey(): the largest key, None when empty. O(height).\n  @Ensures(result.isSome() == (this.size() > 0))\n  @Ensures(result.isSome() ==> this.has(result.unwrap()))\n  lastKey(): Option<string> {\n    if (this.count == 0) {\n      return None;\n    }\n    let x = this.root;\n    while (this.nodes[x].kids.length > 0) {\n      x = this.nodes[x].kids[this.nodes[x].kids.length - 1];\n    }\n    return Some(this.nodes[x].keys[this.nodes[x].keys.length - 1]);\n  }\n\n  // floorKey(k): the greatest key <= k, None when there is none. One descent. O(t log_t n).\n  @Ensures(result.isSome() ==> (compareStrings(result.unwrap(), k) <= 0) && this.has(result.unwrap()))\n  @Ensures(result.isNone() ==> this.firstKey().isNone() || (compareStrings(this.firstKey().unwrap(), k) > 0))\n  floorKey(k: string): Option<string> {\n    let best: Option<string> = None;\n    let x = this.root;\n    while (true) {\n      const i = lowerBoundStr(this.nodes[x].keys, k);\n      if (i < this.nodes[x].keys.length && (compareStrings(this.nodes[x].keys[i], k) == 0)) {\n        return Some(k);\n      }\n      if (i > 0) {\n        best = Some(this.nodes[x].keys[i - 1]);\n      }\n      if (this.nodes[x].kids.length == 0) {\n        return best;\n      }\n      x = this.nodes[x].kids[i];\n    }\n    return best;\n  }\n\n  // ceilKey(k): the smallest key >= k, None when there is none. One descent. O(t log_t n).\n  @Ensures(result.isSome() ==> (compareStrings(result.unwrap(), k) >= 0) && this.has(result.unwrap()))\n  @Ensures(result.isNone() ==> this.lastKey().isNone() || (compareStrings(this.lastKey().unwrap(), k) < 0))\n  ceilKey(k: string): Option<string> {\n    let best: Option<string> = None;\n    let x = this.root;\n    while (true) {\n      const i = lowerBoundStr(this.nodes[x].keys, k);\n      if (i < this.nodes[x].keys.length) {\n        if ((compareStrings(this.nodes[x].keys[i], k) == 0)) {\n          return Some(k);\n        }\n        best = Some(this.nodes[x].keys[i]);\n      }\n      if (this.nodes[x].kids.length == 0) {\n        return best;\n      }\n      x = this.nodes[x].kids[i];\n    }\n    return best;\n  }\n\n  // popFirst(): remove the entry with the smallest key and return it, None when empty. O(t log_t n).\n  @Ensures(result.isSome() == (old(this.size()) > 0))\n  @Ensures(result.isSome() ==> this.size() == old(this.size()) - 1 && !this.has(result.unwrap().key))\n  @Ensures(result.isSome() ==> (compareStrings(result.unwrap().key, old(this.firstKey().unwrapOr(\"\"))) == 0))\n  @Ensures(result.isSome() && this.size() > 0 ==> (compareStrings(this.firstKey().unwrap(), result.unwrap().key) > 0))\n  popFirst(): Option<SortedStringEntry<V>> {\n    const f = this.firstKey();\n    if (f.isNone()) {\n      return None;\n    }\n    const v = this.remove(f.unwrap()).unwrap();\n    return Some(SortedStringEntry<V> { key: f.unwrap(), value: v });\n  }\n\n  // popLast(): remove the entry with the largest key and return it, None when empty. O(t log_t n).\n  @Ensures(result.isSome() == (old(this.size()) > 0))\n  @Ensures(result.isSome() ==> this.size() == old(this.size()) - 1 && !this.has(result.unwrap().key))\n  @Ensures(result.isSome() ==> (compareStrings(result.unwrap().key, old(this.lastKey().unwrapOr(\"\"))) == 0))\n  @Ensures(result.isSome() && this.size() > 0 ==> (compareStrings(this.lastKey().unwrap(), result.unwrap().key) < 0))\n  popLast(): Option<SortedStringEntry<V>> {\n    const l = this.lastKey();\n    if (l.isNone()) {\n      return None;\n    }\n    const v = this.remove(l.unwrap()).unwrap();\n    return Some(SortedStringEntry<V> { key: l.unwrap(), value: v });\n  }\n\n  // keyArray(): all keys in increasing order. O(n).\n  @Ensures(result.length == this.size() && isStrictlyIncreasingStrings(result))\n  keyArray(): string[] {\n    return btreeStrKeys(this.nodes, this.root);\n  }\n\n  // valueArray(): all values in key order. O(n).\n  @Ensures(result.length == this.size())\n  valueArray(): V[] {\n    return btreeStrVals(this.nodes, this.root);\n  }\n\n  // clear(): remove all entries. O(1).\n  @Ensures(this.size() == 0)\n  clear(): void {\n    this.nodes = [StrNode<V> { keys: [], vals: [], kids: [] }];\n    this.root = 0;\n    this.free = [];\n    this.count = 0;\n  }\n}\n\n// END GENERATED\n\n// ------------------------------------------------------------------------------------- PriorityQueue\n\n// What `pop` and `peek` return.\nexport type PQEntry<T> = { priority: int; value: T; };\n\n// Does the entry (p1, s1) leave before (p2, s2)? Lower priority first; equal priorities by insertion number.\nfunction leavesBefore(p1: int, s1: int, p2: int, s2: int): bool {\n  return p1 < p2 || (p1 == p2 && s1 < s2);\n}\n\n// isMinHeap4(prios, seqs): every entry leaves strictly before its up to four children (children of i are\n// 4i+1 .. 4i+4, parent of i is (i-1)/4). Loop-based.\nexport function isMinHeap4(prios: int[], seqs: int[]): bool {\n  if (prios.length != seqs.length) {\n    return false;\n  }\n  let i: usize = 1;\n  while (i < prios.length) {\n    const p = (i - 1) / 4;\n    if (!leavesBefore(prios[p], seqs[p], prios[i], seqs[i])) {\n      return false;\n    }\n    i += 1;\n  }\n  return true;\n}\n\n// Are all insertion numbers in 0..bound-1?\nexport function seqsBelow(seqs: int[], bound: int): bool {\n  let i: usize = 0;\n  while (i < seqs.length) {\n    if (seqs[i] < 0 || seqs[i] >= bound) {\n      return false;\n    }\n    i += 1;\n  }\n  return true;\n}\n\nfunction minInt(a: int, b: int): int {\n  return a < b ? a : b;\n}\n\n// A min-priority queue on a 4-ary implicit heap. `push(priority, value)` adds a value; `pop` returns the entry\n// with the smallest priority, and among equal priorities the one pushed first. Storage is three parallel arrays\n// (priorities, insertion numbers, values: no per-entry allocation, and the comparison keys are contiguous), and\n// sifting moves a \"hole\" instead of swapping (one write per level instead of two). Measured on 200,000 random\n// pushes + pops: 4-ary 122 ms, binary with the same layout 164 ms, 8-ary 137 ms, the earlier binary heap of boxed\n// nodes with swaps 300 ms. Invariants: the three arrays have the same length, they form a heap (an entry leaves\n// strictly before its children) and every insertion number is below the counter `nextSeq`, which never decreases,\n// so insertion numbers are unique and the order is total.\n@Invariant(this.prios.length == this.seqs.length && this.prios.length == this.vals.length)\n@Invariant(isMinHeap4(this.prios, this.seqs))\n@Invariant(seqsBelow(this.seqs, this.nextSeq))\n@Invariant(this.nextSeq >= 0)\nexport class PriorityQueue<T> {\n  private prios: int[] = [];\n  private seqs: int[] = [];\n  private vals: T[] = [];\n  private nextSeq: int = 0;\n\n  // size(): number of queued entries. O(1).\n  @Ensures(result == this.prios.length)\n  size(): usize {\n    return this.prios.length;\n  }\n\n  // isEmpty(): nothing queued. O(1).\n  @Ensures(result == (this.size() == 0))\n  isEmpty(): bool {\n    return this.prios.length == 0;\n  }\n\n  // minPriority(): the smallest priority queued, None when empty. O(1).\n  @Ensures(result.isSome() == (this.size() > 0))\n  minPriority(): Option<int> {\n    if (this.prios.length == 0) {\n      return None;\n    }\n    return Some(this.prios[0]);\n  }\n\n  // allAtLeast(p): every queued priority is >= p. O(n).\n  @Ensures(this.size() == 0 ==> result)\n  @Ensures(result && this.size() > 0 ==> this.minPriority().unwrap() >= p)\n  allAtLeast(p: int): bool {\n    let i: usize = 0;\n    while (i < this.prios.length) {\n      if (this.prios[i] < p) {\n        return false;\n      }\n      i += 1;\n    }\n    return true;\n  }\n\n  // peek(): the entry `pop` would return, without removing it; None when empty. O(1).\n  @Ensures(result.isSome() == (this.size() > 0))\n  @Ensures(result.isSome() ==> result.unwrap().priority == this.minPriority().unwrap())\n  peek(): Option<PQEntry<T>> {\n    if (this.prios.length == 0) {\n      return None;\n    }\n    return Some(PQEntry<T> { priority: this.prios[0], value: this.vals[0] });\n  }\n\n  // push(priority, value): queue a value. O(log_4 n) comparisons, no allocation besides array growth.\n  @Ensures(this.size() == old(this.size()) + 1)\n  @Ensures(this.minPriority().unwrap() == minInt(priority, old(this.minPriority().unwrapOr(priority))))\n  @Ensures(this.allAtLeast(minInt(priority, old(this.minPriority().unwrapOr(priority)))))\n  push(priority: int, value: T): void {\n    const s = this.nextSeq;\n    this.nextSeq += 1;\n    let i = this.prios.length;\n    this.prios.push(priority);\n    this.seqs.push(s);\n    this.vals.push(value);\n    while (i > 0) {\n      const par = (i - 1) / 4;\n      if (!leavesBefore(priority, s, this.prios[par], this.seqs[par])) {\n        break;\n      }\n      this.prios[i] = this.prios[par];\n      this.seqs[i] = this.seqs[par];\n      this.vals[i] = this.vals[par];\n      i = par;\n    }\n    this.prios[i] = priority;\n    this.seqs[i] = s;\n    this.vals[i] = value;\n  }\n\n  // pop(): remove and return the entry with the smallest priority (the earliest pushed among equals); None when\n  // empty. The returned priority is <= every priority still queued. O(log_4 n) levels, up to 4 comparisons each.\n  @Ensures(result.isSome() == (old(this.size()) > 0))\n  @Ensures(result.isSome() ==> this.size() == old(this.size()) - 1)\n  @Ensures(result.isSome() ==> result.unwrap().priority == old(this.minPriority().unwrapOr(0)))\n  @Ensures(result.isSome() ==> this.allAtLeast(result.unwrap().priority))\n  @Ensures(result.isNone() ==> this.size() == 0)\n  pop(): Option<PQEntry<T>> {\n    if (this.prios.length == 0) {\n      return None;\n    }\n    const top = PQEntry<T> { priority: this.prios[0], value: this.vals[0] };\n    const lp = this.prios.pop().unwrap();\n    const ls = this.seqs.pop().unwrap();\n    const lv = this.vals.pop().unwrap();\n    const n = this.prios.length;\n    if (n > 0) {\n      let i: usize = 0;\n      while (true) {\n        const c = 4 * i + 1;\n        if (c >= n) {\n          break;\n        }\n        const end = c + 4 < n ? c + 4 : n;\n        let m = c;\n        let k = c + 1;\n        while (k < end) {\n          if (leavesBefore(this.prios[k], this.seqs[k], this.prios[m], this.seqs[m])) {\n            m = k;\n          }\n          k += 1;\n        }\n        if (!leavesBefore(this.prios[m], this.seqs[m], lp, ls)) {\n          break;\n        }\n        this.prios[i] = this.prios[m];\n        this.seqs[i] = this.seqs[m];\n        this.vals[i] = this.vals[m];\n        i = m;\n      }\n      this.prios[i] = lp;\n      this.seqs[i] = ls;\n      this.vals[i] = lv;\n    }\n    return Some(top);\n  }\n\n  // clear(): drop all entries. O(1).\n  @Ensures(this.size() == 0)\n  clear(): void {\n    this.prios = [];\n    this.seqs = [];\n    this.vals = [];\n  }\n}\n" });
  out.push(SourceFile { path: "$stdlib/fs.or", text: "// std:fs -- whole-file functions and streaming file access through the scope API (ADR-0025).\n//\n// UNSTABLE (ADR-0016 amendment): the signatures of std I/O modules may change when capabilities (ADR-0021)\n// are added, most likely by one extra capability parameter (`withFile(cap, path, mode, body)`); the scope\n// shape and the `File` methods are meant to survive that change. The language rules for `File` are not\n// unstable: see below.\n//\n// `File` is a RESOURCE HANDLE, not a value (spec 06): it can be passed to functions (borrowed) but not stored in a\n// record / class / array / Option / Result / Map, returned, assigned to another variable, captured by a closure,\n// compared or converted to string; those uses are compile errors E0450 / E0451 / E0452 (compiler/check/resources.or)\n// and, independently, MIR verifier errors (docs/mir.md, \"Resource handles\"). The only way to obtain one is a\n// scope function below: it opens the file, calls `body` with the handle as the body's PARAMETER, and closes the\n// file when `body` returns -- on every path, including when the result is later turned into an `Err`. A trap\n// inside `body` ends the process; the runtime flushes and closes open files in its exit hook, so bytes already\n// handed to `write` are not lost (a kill by signal still loses buffered bytes).\n//\n// Errors of reads/writes/flushes inside the scope are remembered by the file (the methods themselves stay\n// simple: `readLine(): Option<string>`, `write(s): void`); the scope function reports the first one as\n// `Err(FsError)` when it closes the file. A failed read looks like end of file to `body`.\n//\n// Why two flavours: a generic result `T` cannot be `void`; `withFile` returns the body's value, `useFile`\n// takes a body that returns nothing. Both exist for one file and for two files (`withFiles`, `useFiles`), which is how\n// you stream from one file to another: a handle cannot be captured by a nested scope's closure.\n//\n// Whole-file functions (unchanged): readFile(path): Result<string, string>, writeFile(path, data):\n// Result<void, string>, exists(path): bool.\n\nimport { File, fileOpen, fileIsOpen, fileOpenError, fileClose } from \"std:fsraw\";\n\nexport { readFile, writeFile, exists, File } from \"std:fsraw\";\n\n// Text of an error of this module (currently the human-readable message).\nexport type FsError = string;\n\n// How a file is opened: Read (the file must exist), Write (create or truncate), Append (create if missing,\n// every write goes to the end). A file opened with Read cannot be written and vice versa (the failed operation is\n// reported as an `Err` when the scope ends).\nexport type FileMode = Read | Write | Append;\n\nfunction modeCode(m: FileMode): int {\n  return match (m) {\n    Read => 0,\n    Write => 1,\n    Append => 2\n  };\n}\n\nfunction openMessage(path: string, h: File): string {\n  return \"cannot open '\" + path + \"': \" + fileOpenError(h);\n}\n\n// Close message of a handle: Some(error) if any operation failed.\nfunction firstError(a: Option<string>, b: Option<string>): Option<string> {\n  return match (a) {\n    Some(m) => Some(m),\n    None => b\n  };\n}\n\n// withFile<T>(path, mode, body): Result<T, FsError>\n// Opens `path`, runs `body(file)`, closes the file, and returns `Ok(<body's value>)`; `Err(message)` if the file\n// cannot be opened (body is not called) or if any operation on it or the final flush/close failed (the body's\n// value is discarded). O(1) plus the work of `body`; at most 256 files can be open at once.\nexport function withFile<T>(path: string, mode: FileMode, body: (file: File) => T): Result<T, FsError> {\n  const h = fileOpen(path, modeCode(mode));\n  if (!fileIsOpen(h)) {\n    const msg = openMessage(path, h);\n    fileClose(h);\n    return Err(msg);\n  }\n  const r = body(h);\n  const e = fileClose(h);\n  return match (e) {\n    Some(m) => Err(m),\n    None => Ok(r)\n  };\n}\n\n// useFile(path, mode, body): Result<void, FsError> -- `withFile` for a body that returns nothing.\nexport function useFile(path: string, mode: FileMode, body: (file: File) => void): Result<void, FsError> {\n  const h = fileOpen(path, modeCode(mode));\n  if (!fileIsOpen(h)) {\n    const msg = openMessage(path, h);\n    fileClose(h);\n    return Err(msg);\n  }\n  body(h);\n  const e = fileClose(h);\n  return match (e) {\n    Some(m) => Err(m),\n    None => Ok()\n  };\n}\n\n// withFiles<T>(pathA, modeA, pathB, modeB, body): Result<T, FsError> -- two files open at the same time (for\n// example copying a file line by line). If the second cannot be opened the first is closed again.\nexport function withFiles<T>(\n  pathA: string, modeA: FileMode, pathB: string, modeB: FileMode, body: (a: File, b: File) => T\n): Result<T, FsError> {\n  const a = fileOpen(pathA, modeCode(modeA));\n  if (!fileIsOpen(a)) {\n    const msg = openMessage(pathA, a);\n    fileClose(a);\n    return Err(msg);\n  }\n  const b = fileOpen(pathB, modeCode(modeB));\n  if (!fileIsOpen(b)) {\n    const msg = openMessage(pathB, b);\n    fileClose(b);\n    fileClose(a);\n    return Err(msg);\n  }\n  const r = body(a, b);\n  const eb = fileClose(b);\n  const ea = fileClose(a);\n  return match (firstError(ea, eb)) {\n    Some(m) => Err(m),\n    None => Ok(r)\n  };\n}\n\n// useFiles(pathA, modeA, pathB, modeB, body): Result<void, FsError> -- `withFiles` for a body that returns nothing.\nexport function useFiles(\n  pathA: string, modeA: FileMode, pathB: string, modeB: FileMode, body: (a: File, b: File) => void\n): Result<void, FsError> {\n  const a = fileOpen(pathA, modeCode(modeA));\n  if (!fileIsOpen(a)) {\n    const msg = openMessage(pathA, a);\n    fileClose(a);\n    return Err(msg);\n  }\n  const b = fileOpen(pathB, modeCode(modeB));\n  if (!fileIsOpen(b)) {\n    const msg = openMessage(pathB, b);\n    fileClose(b);\n    fileClose(a);\n    return Err(msg);\n  }\n  body(a, b);\n  const eb = fileClose(b);\n  const ea = fileClose(a);\n  return match (firstError(ea, eb)) {\n    Some(m) => Err(m),\n    None => Ok()\n  };\n}\n" });
  out.push(SourceFile { path: "$stdlib/graph.or", text: "// std:graph -- Graph<T> with generational, graph-tagged node ids (spec 06 \"Cyclic graph\", ADR-0016, ADR-0026).\n//\n// Cyclic structures are not expressible with owning values (no owning cycles), so a graph owner\n// holds all nodes and edges are checked, non-owning `GraphId<T>` handles:\n//   * Each id carries the graph's tag, the slot index and the slot's generation. Removing a node\n//     bumps its slot's generation, so an id that outlived its node is STALE and every operation\n//     rejects it with `Err(StaleId)`; an id minted by a graph with a different tag is `Err(ForeignId)`.\n//     (An id whose index lies beyond the graph is also `ForeignId`.)\n//   * `Graph<T>` is a generic class (value semantics like every class): `let g = new Graph<string>(1);\n//     const a = g.add(\"alpha\");`. A copy (`const h = g`) is independent: later changes to `g` are not\n//     visible in `h` (an id removed in `g` is still valid in the older `h`: ids identify a node of one\n//     *tag*, generations track its history).\n//   * The tag is supplied by the caller: `new Graph<T>(tag)`. Use a different tag per logical graph.\n//     TODO(after global state): an automatic unique tag once the language has a process-wide counter.\n//   * Edges are directed and stored in the source slot as (index, generation) pairs. Removing a node\n//     does not touch edges pointing at it: they become dangling and `neighbors` silently skips them\n//     (an edge only counts while both ends are live with the generations recorded at addEdge time).\n//     Duplicate edges are allowed and reported once per addEdge call.\n//   * Complexity: `add`, `get`, `contains`, `size` are O(1) (freed slots are reused through a free list);\n//     `remove` is O(1); `neighbors` is O(out-degree), `ids` O(nodes). Mutating methods update the\n//     graph in place when it is not shared; a shared graph is copied on the first change (O(nodes)).\n//\n// TODO(after floats/map): `Map`-based index, edge weights.\n\n// Opaque handle of a node of a graph with value type T. `T` is only a phantom parameter that ties\n// the id to its graph's value type; obtain ids through `Graph.add`.\nexport type GraphId<T> = { tag: int; index: usize; gen: int; };\n\n// StaleId: the node was removed (the slot has a newer generation or is empty).\n// ForeignId: the id belongs to another graph (different tag) or does not name a slot at all.\nexport type GraphError = StaleId | ForeignId;\n\ntype Edge = { index: usize; gen: int; };\n\ntype Slot<T> = { gen: int; value: Option<T>; edges: Edge[]; };\n\n// graphErrorMessage(e: GraphError): string -- \"stale graph id\" / \"foreign graph id\". O(1).\nexport function graphErrorMessage(e: GraphError): string {\n  return match (e) {\n    StaleId => \"stale graph id\",\n    ForeignId => \"foreign graph id\"\n  };\n}\n\nexport class Graph<T> {\n  private tag: int;\n  private slots: Slot<T>[] = [];\n  private free: usize[] = [];\n  private live: usize = 0;\n\n  // new Graph<T>(tag): an empty graph. Ids minted by it are accepted only by graphs with the same `tag`.\n  constructor(tag: int) {\n    this.tag = tag;\n  }\n\n  // size(): usize -- number of live nodes. O(1).\n  size(): usize {\n    return this.live;\n  }\n\n  // Validates `id`: Ok(slot index) when it names a live node of this graph.\n  private lookup(id: GraphId<T>): Result<usize, GraphError> {\n    if (id.tag != this.tag || id.index >= this.slots.length) {\n      return Err(ForeignId);\n    }\n    if (this.slots[id.index].gen != id.gen || this.slots[id.index].value.isNone()) {\n      return Err(StaleId);\n    }\n    return Ok(id.index);\n  }\n\n  // contains(id): bool -- true when `id` names a live node of this graph. O(1).\n  contains(id: GraphId<T>): bool {\n    return this.lookup(id).isOk();\n  }\n\n  // add(value): GraphId<T>\n  // Adds a node (reusing a freed slot, whose generation `remove` already bumped) and returns its id.\n  // Never fails. O(1).\n  add(value: T): GraphId<T> {\n    if (this.free.length > 0) {\n      const i = this.free.pop().unwrap();\n      this.slots[i].value = Some(value);\n      this.live += 1;\n      return GraphId<T> { tag: this.tag, index: i, gen: this.slots[i].gen };\n    }\n    this.slots.push(Slot<T> { gen: 0, value: Some(value), edges: [] });\n    this.live += 1;\n    return GraphId<T> { tag: this.tag, index: this.slots.length - 1, gen: 0 };\n  }\n\n  // get(id): Result<T, GraphError>\n  // The value of a live node. Errors: StaleId (removed node), ForeignId (other graph). O(1).\n  get(id: GraphId<T>): Result<T, GraphError> {\n    const i = this.lookup(id)?;\n    return Ok(this.slots[i].value.unwrap());\n  }\n\n  // set(id, value): Result<void, GraphError>\n  // Replaces a live node's value (its edges and id stay). Errors as `get`. O(1).\n  set(id: GraphId<T>, value: T): Result<void, GraphError> {\n    const i = this.lookup(id)?;\n    this.slots[i].value = Some(value);\n    return Ok();\n  }\n\n  // remove(id): Result<T, GraphError>\n  // Removes a live node and its outgoing edges and returns its value. The slot generation is bumped\n  // (invalidating `id` and every copy of it) and the slot is freed for reuse. Edges of other nodes that\n  // pointed at it dangle and are skipped by `neighbors`. Errors as `get`. O(1).\n  remove(id: GraphId<T>): Result<T, GraphError> {\n    const i = this.lookup(id)?;\n    const old = this.slots[i].value.unwrap();\n    const gone: Option<T> = None;\n    this.slots[i].value = gone;\n    this.slots[i].gen += 1;\n    this.slots[i].edges = [];\n    this.free.push(i);\n    this.live -= 1;\n    return Ok(old);\n  }\n\n  // addEdge(a, b): Result<void, GraphError>\n  // Adds the directed edge a -> b (self loops and duplicates allowed). Both ids must be live in this\n  // graph; the first failing id's error is returned (`a` is checked first). O(1).\n  addEdge(a: GraphId<T>, b: GraphId<T>): Result<void, GraphError> {\n    const i = this.lookup(a)?;\n    const j = this.lookup(b)?;\n    this.slots[i].edges.push(Edge { index: j, gen: b.gen });\n    return Ok();\n  }\n\n  // neighbors(id): Result<GraphId<T>[], GraphError>\n  // The targets of the outgoing edges of a live node, in insertion order, skipping dangling edges\n  // (removed targets). Errors as `get`. O(out-degree).\n  neighbors(id: GraphId<T>): Result<GraphId<T>[], GraphError> {\n    const i = this.lookup(id)?;\n    let out: GraphId<T>[] = [];\n    for (const e of this.slots[i].edges) {\n      if (this.slots[e.index].gen == e.gen && this.slots[e.index].value.isSome()) {\n        out.push(GraphId<T> { tag: this.tag, index: e.index, gen: e.gen });\n      }\n    }\n    return Ok(out);\n  }\n\n  // ids(): GraphId<T>[] -- ids of all live nodes in slot order. O(nodes).\n  ids(): GraphId<T>[] {\n    let out: GraphId<T>[] = [];\n    let i: usize = 0;\n    while (i < this.slots.length) {\n      if (this.slots[i].value.isSome()) {\n        out.push(GraphId<T> { tag: this.tag, index: i, gen: this.slots[i].gen });\n      }\n      i += 1;\n    }\n    return out;\n  }\n}\n" });
  out.push(SourceFile { path: "$stdlib/json.or", text: "// std:json -- JSON values, parser and printers (spec 08, ADR-0016).\n//\n// Data model: `Json` is a plain union (no classes), so values copy like any other value and are\n// inspected with `match`. Numbers are INTEGERS ONLY (`JNum(int)`) until floats land; see the\n// TODO(after floats/map) notes. Objects are ordered field lists (`JField[]`), not maps.\n//\n//   * parse accepts RFC 8259 JSON with these restrictions: numbers must be integers in the\n//     range -9223372036854775807 .. 9223372036854775807; a fraction or exponent (`1.5`, `1e3`)\n//     is a JsonError (\"floats are not supported yet\"). Nesting deeper than 200 levels is an error.\n//   * Strings are Orin byte strings holding UTF-8. `\\uXXXX` escapes decode to UTF-8; a surrogate\n//     pair gives one 4-byte sequence, a lone surrogate gives U+FFFD. Raw control characters\n//     (< 0x20) inside strings are rejected. Bytes >= 0x80 are copied through unchanged (the\n//     input is not validated as UTF-8).\n//   * Duplicate object keys are kept (in order); `get` returns the LAST occurrence (JS semantics).\n//   * Errors carry the byte offset plus a 1-based line and column (column counts bytes after the\n//     last \"\\n\"; \"\\r\\n\" ends a line at \"\\n\").\n//   * stringify is compact and deterministic; `pretty` indents with spaces. Object field order is\n//     insertion order. Strings escape `\"`, `\\`, \\b \\f \\n \\r \\t and other control characters as\n//     \\u00XX; all other bytes pass through unchanged.\n//\n// TODO(after floats/map): JNum(float) / separate JFloat, `parse<T>` is post-1.0 (ADR-0016).\n\nexport type Json = JNull | JBool(bool) | JNum(int) | JStr(string) | JArr(Json[]) | JObj(JField[]);\n\nexport type JField = { key: string; value: Json; };\n\n// Parse failure: `message` describes the problem, `offset` is the 0-based byte offset where it was\n// detected (== text length for \"unexpected end of input\"), `line`/`column` are 1-based.\nexport type JsonError = { message: string; offset: usize; line: usize; column: usize; };\n\n// ---- constructors -------------------------------------------------------------------------\n\n// field(key: string, value: Json): JField -- builds an object field. O(1).\nexport function field(key: string, value: Json): JField {\n  return JField { key: key, value: value };\n}\n\n// ---- parser -------------------------------------------------------------------------------\n\ntype PErr = { msg: string; at: usize; };\ntype PRes = { v: Json; pos: usize; };\ntype SRes = { text: string; pos: usize; };\ntype NRes = { n: int; pos: usize; };\n\nconst MAX_DEPTH: int = 200;\n\nfunction fail(msg: string, at: usize): PErr {\n  return PErr { msg: msg, at: at };\n}\n\nfunction isWs(c: int): bool {\n  return c == 32 || c == 9 || c == 10 || c == 13;\n}\n\nfunction skipWs(s: string, start: usize): usize {\n  let i = start;\n  while (i < s.length && isWs(s.charCodeAt(i))) {\n    i += 1;\n  }\n  return i;\n}\n\nfunction hexVal(c: int): int {\n  if (c >= 48 && c <= 57) {\n    return c - 48;\n  }\n  if (c >= 97 && c <= 102) {\n    return c - 87;\n  }\n  if (c >= 65 && c <= 70) {\n    return c - 55;\n  }\n  return -1;\n}\n\n// Four hex digits at `at`, or -1.\nfunction hex4(s: string, at: usize): int {\n  if (at + 4 > s.length) {\n    return -1;\n  }\n  let v = 0;\n  let k: usize = 0;\n  while (k < 4) {\n    const h = hexVal(s.charCodeAt(at + k));\n    if (h < 0) {\n      return -1;\n    }\n    v = v * 16 + h;\n    k += 1;\n  }\n  return v;\n}\n\nfunction utf8(cp: int): string {\n  if (cp < 128) {\n    return String.fromCharCode(cp);\n  }\n  if (cp < 2048) {\n    return String.fromCharCode(192 + cp / 64) + String.fromCharCode(128 + cp % 64);\n  }\n  if (cp < 65536) {\n    return String.fromCharCode(224 + cp / 4096) + String.fromCharCode(128 + (cp / 64) % 64)\n      + String.fromCharCode(128 + cp % 64);\n  }\n  return String.fromCharCode(240 + cp / 262144) + String.fromCharCode(128 + (cp / 4096) % 64)\n    + String.fromCharCode(128 + (cp / 64) % 64) + String.fromCharCode(128 + cp % 64);\n}\n\n// `s[start]` is the opening quote.\nfunction parseString(s: string, start: usize): Result<SRes, PErr> {\n  let parts: string[] = [];\n  let i = start + 1;\n  let runStart = i;\n  while (true) {\n    if (i >= s.length) {\n      return Err(fail(\"unterminated string\", start));\n    }\n    const c = s.charCodeAt(i);\n    if (c == 34) {\n      if (i > runStart) {\n        parts.push(s.substring(runStart, i));\n      }\n      return Ok(SRes { text: parts.join(\"\"), pos: i + 1 });\n    }\n    if (c < 32) {\n      return Err(fail(\"control character in string\", i));\n    }\n    if (c != 92) {\n      i += 1;\n      continue;\n    }\n    if (i > runStart) {\n      parts.push(s.substring(runStart, i));\n    }\n    if (i + 1 >= s.length) {\n      return Err(fail(\"unterminated escape\", i));\n    }\n    const e = s.charCodeAt(i + 1);\n    i += 2;\n    if (e == 34) {\n      parts.push(\"\\\"\");\n    } else if (e == 92) {\n      parts.push(\"\\\\\");\n    } else if (e == 47) {\n      parts.push(\"/\");\n    } else if (e == 98) {\n      parts.push(String.fromCharCode(8));\n    } else if (e == 102) {\n      parts.push(String.fromCharCode(12));\n    } else if (e == 110) {\n      parts.push(\"\\n\");\n    } else if (e == 114) {\n      parts.push(\"\\r\");\n    } else if (e == 116) {\n      parts.push(\"\\t\");\n    } else if (e == 117) {\n      const u = hex4(s, i);\n      if (u < 0) {\n        return Err(fail(\"invalid \\\\u escape\", i - 2));\n      }\n      i += 4;\n      let cp = u;\n      if (u >= 55296 && u <= 56319) {\n        // High surrogate: needs a following \\uDC00..\\uDFFF.\n        let lo = -1;\n        if (i + 1 < s.length && s.charCodeAt(i) == 92 && s.charCodeAt(i + 1) == 117) {\n          lo = hex4(s, i + 2);\n        }\n        if (lo >= 56320 && lo <= 57343) {\n          cp = 65536 + (u - 55296) * 1024 + (lo - 56320);\n          i += 6;\n        } else {\n          cp = 65533;\n        }\n      } else if (u >= 56320 && u <= 57343) {\n        cp = 65533;\n      }\n      parts.push(utf8(cp));\n    } else {\n      return Err(fail(\"invalid escape\", i - 2));\n    }\n    runStart = i;\n  }\n  return Err(fail(\"unreachable\", i));\n}\n\nfunction isDigit(c: int): bool {\n  return c >= 48 && c <= 57;\n}\n\nconst INT_MAX: int = 9223372036854775807;\n\nfunction parseNumber(s: string, start: usize): Result<NRes, PErr> {\n  let i = start;\n  let neg = false;\n  if (s.charCodeAt(i) == 45) {\n    neg = true;\n    i += 1;\n  }\n  const ds = i;\n  while (i < s.length && isDigit(s.charCodeAt(i))) {\n    i += 1;\n  }\n  if (i == ds) {\n    return Err(fail(\"invalid number\", start));\n  }\n  if (i - ds > 1 && s.charCodeAt(ds) == 48) {\n    return Err(fail(\"leading zero in number\", ds));\n  }\n  let v = 0;\n  let k = ds;\n  while (k < i) {\n    const d = s.charCodeAt(k) - 48;\n    if (v > (INT_MAX - d) / 10) {\n      return Err(fail(\"integer out of range\", start));\n    }\n    v = v * 10 + d;\n    k += 1;\n  }\n  if (i < s.length && (s.charCodeAt(i) == 46 || s.charCodeAt(i) == 101 || s.charCodeAt(i) == 69)) {\n    return Err(fail(\"floats are not supported yet (integers only)\", i));\n  }\n  if (neg) {\n    v = 0 - v;\n  }\n  return Ok(NRes { n: v, pos: i });\n}\n\nfunction expectLit(s: string, at: usize, lit: string): bool {\n  if (at + lit.length > s.length) {\n    return false;\n  }\n  return s.substring(at, at + lit.length) == lit;\n}\n\nfunction parseValue(s: string, start: usize, depth: int): Result<PRes, PErr> {\n  const i = skipWs(s, start);\n  if (i >= s.length) {\n    return Err(fail(\"unexpected end of input\", i));\n  }\n  if (depth > MAX_DEPTH) {\n    return Err(fail(\"nesting too deep\", i));\n  }\n  const c = s.charCodeAt(i);\n  if (c == 34) {\n    const r = parseString(s, i)?;\n    return Ok(PRes { v: JStr(r.text), pos: r.pos });\n  }\n  if (c == 123) {\n    return parseObject(s, i, depth);\n  }\n  if (c == 91) {\n    return parseArray(s, i, depth);\n  }\n  if (c == 45 || isDigit(c)) {\n    const r = parseNumber(s, i)?;\n    return Ok(PRes { v: JNum(r.n), pos: r.pos });\n  }\n  if (expectLit(s, i, \"true\")) {\n    return Ok(PRes { v: JBool(true), pos: i + 4 });\n  }\n  if (expectLit(s, i, \"false\")) {\n    return Ok(PRes { v: JBool(false), pos: i + 5 });\n  }\n  if (expectLit(s, i, \"null\")) {\n    return Ok(PRes { v: JNull, pos: i + 4 });\n  }\n  return Err(fail(\"unexpected character\", i));\n}\n\nfunction parseArray(s: string, start: usize, depth: int): Result<PRes, PErr> {\n  let items: Json[] = [];\n  let i = skipWs(s, start + 1);\n  if (i < s.length && s.charCodeAt(i) == 93) {\n    return Ok(PRes { v: JArr(items), pos: i + 1 });\n  }\n  while (true) {\n    const r = parseValue(s, i, depth + 1)?;\n    items.push(r.v);\n    i = skipWs(s, r.pos);\n    if (i >= s.length) {\n      return Err(fail(\"unexpected end of input, expected `,` or `]`\", i));\n    }\n    const c = s.charCodeAt(i);\n    if (c == 93) {\n      return Ok(PRes { v: JArr(items), pos: i + 1 });\n    }\n    if (c != 44) {\n      return Err(fail(\"expected `,` or `]`\", i));\n    }\n    i += 1;\n  }\n  return Err(fail(\"unreachable\", i));\n}\n\nfunction parseObject(s: string, start: usize, depth: int): Result<PRes, PErr> {\n  let fields: JField[] = [];\n  let i = skipWs(s, start + 1);\n  if (i < s.length && s.charCodeAt(i) == 125) {\n    return Ok(PRes { v: JObj(fields), pos: i + 1 });\n  }\n  while (true) {\n    i = skipWs(s, i);\n    if (i >= s.length) {\n      return Err(fail(\"unexpected end of input, expected string key\", i));\n    }\n    if (s.charCodeAt(i) != 34) {\n      return Err(fail(\"expected string key\", i));\n    }\n    const k = parseString(s, i)?;\n    i = skipWs(s, k.pos);\n    if (i >= s.length) {\n      return Err(fail(\"unexpected end of input, expected `:`\", i));\n    }\n    if (s.charCodeAt(i) != 58) {\n      return Err(fail(\"expected `:`\", i));\n    }\n    const r = parseValue(s, i + 1, depth + 1)?;\n    fields.push(JField { key: k.text, value: r.v });\n    i = skipWs(s, r.pos);\n    if (i >= s.length) {\n      return Err(fail(\"unexpected end of input, expected `,` or `}`\", i));\n    }\n    const c = s.charCodeAt(i);\n    if (c == 125) {\n      return Ok(PRes { v: JObj(fields), pos: i + 1 });\n    }\n    if (c != 44) {\n      return Err(fail(\"expected `,` or `}`\", i));\n    }\n    i += 1;\n  }\n  return Err(fail(\"unreachable\", i));\n}\n\n// 1-based line and column of byte `offset` in `s`.\nfunction locate(s: string, offset: usize): JsonError {\n  let line: usize = 1;\n  let lineStart: usize = 0;\n  let i: usize = 0;\n  while (i < offset && i < s.length) {\n    if (s.charCodeAt(i) == 10) {\n      line += 1;\n      lineStart = i + 1;\n    }\n    i += 1;\n  }\n  return JsonError { message: \"\", offset: offset, line: line, column: offset - lineStart + 1 };\n}\n\nfunction toError(s: string, e: PErr): JsonError {\n  const l = locate(s, e.at);\n  return JsonError { message: e.msg, offset: e.at, line: l.line, column: l.column };\n}\n\n// parse(text: string): Result<Json, JsonError>\n// Parses one JSON document (surrounding whitespace allowed, trailing characters are an error:\n// \"trailing characters\"). Errors: syntax errors, unsupported floats, integer overflow, nesting\n// deeper than 200, each with offset/line/column. Complexity: O(n) time and allocation (plus\n// O(n) to locate the line/column of an error).\nexport function parse(text: string): Result<Json, JsonError> {\n  const r = parseValue(text, 0, 0);\n  if (r.isErr()) {\n    return Err(toError(text, r.unwrapErr()));\n  }\n  const ok = r.unwrap();\n  const end = skipWs(text, ok.pos);\n  if (end < text.length) {\n    return Err(toError(text, fail(\"trailing characters\", end)));\n  }\n  return Ok(ok.v);\n}\n\n// formatError(e: JsonError): string -- \"line L, column C: message\". O(1).\nexport function formatError(e: JsonError): string {\n  return \"line \" + e.line.toString() + \", column \" + e.column.toString() + \": \" + e.message;\n}\n\n// ---- printers -----------------------------------------------------------------------------\n\nfunction hexDigit(n: int): string {\n  if (n < 10) {\n    return String.fromCharCode(48 + n);\n  }\n  return String.fromCharCode(87 + n);\n}\n\n// quote(s: string): string -- `s` as a JSON string literal with escapes. O(n).\nexport function quote(s: string): string {\n  let parts: string[] = [\"\\\"\"];\n  let runStart: usize = 0;\n  let i: usize = 0;\n  while (i < s.length) {\n    const c = s.charCodeAt(i);\n    if (c == 34 || c == 92 || c < 32) {\n      if (i > runStart) {\n        parts.push(s.substring(runStart, i));\n      }\n      if (c == 34) {\n        parts.push(\"\\\\\\\"\");\n      } else if (c == 92) {\n        parts.push(\"\\\\\\\\\");\n      } else if (c == 10) {\n        parts.push(\"\\\\n\");\n      } else if (c == 13) {\n        parts.push(\"\\\\r\");\n      } else if (c == 9) {\n        parts.push(\"\\\\t\");\n      } else if (c == 8) {\n        parts.push(\"\\\\b\");\n      } else if (c == 12) {\n        parts.push(\"\\\\f\");\n      } else {\n        parts.push(\"\\\\u00\" + hexDigit(c / 16) + hexDigit(c % 16));\n      }\n      runStart = i + 1;\n    }\n    i += 1;\n  }\n  if (s.length > runStart) {\n    parts.push(s.substring(runStart, s.length));\n  }\n  parts.push(\"\\\"\");\n  return parts.join(\"\");\n}\n\nfunction emit(j: Json, out: string[]): string[] {\n  let o = out;\n  match (j) {\n    JNull => { o.push(\"null\"); },\n    JBool(b) => { o.push(b ? \"true\" : \"false\"); },\n    JNum(n) => { o.push(n.toString()); },\n    JStr(s) => { o.push(quote(s)); },\n    JArr(a) => {\n      o.push(\"[\");\n      let i: usize = 0;\n      while (i < a.length) {\n        if (i > 0) {\n          o.push(\",\");\n        }\n        o = emit(a[i], o);\n        i += 1;\n      }\n      o.push(\"]\");\n    },\n    JObj(fs) => {\n      o.push(\"{\");\n      let i: usize = 0;\n      while (i < fs.length) {\n        if (i > 0) {\n          o.push(\",\");\n        }\n        o.push(quote(fs[i].key));\n        o.push(\":\");\n        o = emit(fs[i].value, o);\n        i += 1;\n      }\n      o.push(\"}\");\n    }\n  }\n  return o;\n}\n\n// stringify(j: Json): string\n// Compact deterministic serialization (no whitespace). Never fails. O(n) in the size of `j`.\n// parse(stringify(j)) == j for every j whose integers are in range.\nexport function stringify(j: Json): string {\n  const out: string[] = [];\n  return emit(j, out).join(\"\");\n}\n\nfunction spaces(n: usize): string {\n  let parts: string[] = [];\n  let i: usize = 0;\n  while (i < n) {\n    parts.push(\" \");\n    i += 1;\n  }\n  return parts.join(\"\");\n}\n\nfunction emitPretty(j: Json, indent: usize, level: usize, out: string[]): string[] {\n  let o = out;\n  match (j) {\n    JArr(a) => {\n      if (a.length == 0) {\n        o.push(\"[]\");\n      } else {\n        o.push(\"[\\n\");\n        let i: usize = 0;\n        while (i < a.length) {\n          o.push(spaces(indent * (level + 1)));\n          o = emitPretty(a[i], indent, level + 1, o);\n          o.push(i + 1 < a.length ? \",\\n\" : \"\\n\");\n          i += 1;\n        }\n        o.push(spaces(indent * level));\n        o.push(\"]\");\n      }\n    },\n    JObj(fs) => {\n      if (fs.length == 0) {\n        o.push(\"{}\");\n      } else {\n        o.push(\"{\\n\");\n        let i: usize = 0;\n        while (i < fs.length) {\n          o.push(spaces(indent * (level + 1)));\n          o.push(quote(fs[i].key));\n          o.push(\": \");\n          o = emitPretty(fs[i].value, indent, level + 1, o);\n          o.push(i + 1 < fs.length ? \",\\n\" : \"\\n\");\n          i += 1;\n        }\n        o.push(spaces(indent * level));\n        o.push(\"}\");\n      }\n    },\n    _ => { o = emit(j, o); }\n  }\n  return o;\n}\n\n// pretty(j: Json, indent: usize): string\n// Multi-line serialization: one array element / object field per line, `indent` spaces per\n// nesting level, \": \" after keys, empty containers as `[]` / `{}`, no trailing newline.\n// `pretty(j, 0)` still puts every element on its own line (use `stringify` for compact output).\n// Never fails. O(n) in the size of `j` (plus the indentation written).\nexport function pretty(j: Json, indent: usize): string {\n  const out: string[] = [];\n  return emitPretty(j, indent, 0, out).join(\"\");\n}\n\n// ---- accessors ----------------------------------------------------------------------------\n// All accessors are total: a wrong kind or a missing key gives None. They never trap.\n\n// get(j: Json, key: string): Option<Json>\n// The value of field `key` when `j` is an object (the LAST field with that key), else None.\n// O(fields).\nexport function get(j: Json, key: string): Option<Json> {\n  return match (j) {\n    JObj(fs) => lastField(fs, key),\n    _ => None\n  };\n}\n\nfunction lastField(fs: JField[], key: string): Option<Json> {\n  let i = fs.length;\n  while (i > 0) {\n    i -= 1;\n    if (fs[i].key == key) {\n      return Some(fs[i].value);\n    }\n  }\n  return None;\n}\n\n// at(j: Json, index: usize): Option<Json> -- element `index` of an array, else None. O(1).\nexport function at(j: Json, index: usize): Option<Json> {\n  return match (j) {\n    JArr(a) => index < a.length ? Some(a[index]) : None,\n    _ => None\n  };\n}\n\n// path(j: Json, keys: string[]): Option<Json> -- follows object keys: path(j, [\"a\", \"b\"]) is\n// get(get(j, \"a\"), \"b\"); an empty `keys` gives Some(j). O(sum of fields visited).\nexport function path(j: Json, keys: string[]): Option<Json> {\n  let cur = j;\n  for (const k of keys) {\n    const f = get(cur, k);\n    if (f.isNone()) {\n      return None;\n    }\n    cur = f.unwrap();\n  }\n  return Some(cur);\n}\n\n// asString(j: Json): Option<string> -- Some for JStr. O(1).\nexport function asString(j: Json): Option<string> {\n  return match (j) {\n    JStr(s) => Some(s),\n    _ => None\n  };\n}\n\n// asInt(j: Json): Option<int> -- Some for JNum. O(1).\nexport function asInt(j: Json): Option<int> {\n  return match (j) {\n    JNum(n) => Some(n),\n    _ => None\n  };\n}\n\n// asBool(j: Json): Option<bool> -- Some for JBool. O(1).\nexport function asBool(j: Json): Option<bool> {\n  return match (j) {\n    JBool(b) => Some(b),\n    _ => None\n  };\n}\n\n// asArray(j: Json): Option<Json[]> -- Some for JArr. O(1) (the array is copied lazily).\nexport function asArray(j: Json): Option<Json[]> {\n  return match (j) {\n    JArr(a) => Some(a),\n    _ => None\n  };\n}\n\n// asObject(j: Json): Option<JField[]> -- Some for JObj, in insertion order. O(1).\nexport function asObject(j: Json): Option<JField[]> {\n  return match (j) {\n    JObj(fs) => Some(fs),\n    _ => None\n  };\n}\n\n// isNull(j: Json): bool -- true for JNull. O(1).\nexport function isNull(j: Json): bool {\n  return match (j) {\n    JNull => true,\n    _ => false\n  };\n}\n\n// keys(j: Json): string[] -- the field names of an object in order (duplicates included);\n// [] for any non-object. O(fields).\nexport function keys(j: Json): string[] {\n  let out: string[] = [];\n  match (j) {\n    JObj(fs) => {\n      for (const f of fs) {\n        out.push(f.key);\n      }\n    },\n    _ => {}\n  }\n  return out;\n}\n\n// getString / getInt / getBool / getArray: `get` followed by the matching `as*`; None when the\n// key is missing or has another kind. O(fields).\nexport function getString(j: Json, key: string): Option<string> {\n  const f = get(j, key);\n  if (f.isNone()) {\n    return None;\n  }\n  return asString(f.unwrap());\n}\n\nexport function getInt(j: Json, key: string): Option<int> {\n  const f = get(j, key);\n  if (f.isNone()) {\n    return None;\n  }\n  return asInt(f.unwrap());\n}\n\nexport function getBool(j: Json, key: string): Option<bool> {\n  const f = get(j, key);\n  if (f.isNone()) {\n    return None;\n  }\n  return asBool(f.unwrap());\n}\n\nexport function getArray(j: Json, key: string): Option<Json[]> {\n  const f = get(j, key);\n  if (f.isNone()) {\n    return None;\n  }\n  return asArray(f.unwrap());\n}\n" });
  out.push(SourceFile { path: "$stdlib/path.or", text: "// std:path -- lexical POSIX path utilities (spec 08, ADR-0016).\n//\n// Semantics (documented once, for every function):\n//   * Paths are byte strings with \"/\" as the only separator (POSIX). There is no Windows\n//     handling, no filesystem access, no symlink resolution and no current directory: every\n//     function is pure and lexical. Results follow Node's `path.posix` where Node has an\n//     equivalent function.\n//   * A path is absolute when it starts with \"/\".\n//   * Every function is total (never traps, never returns Result); odd input such as \"\" or\n//     \"///\" is handled as documented per function.\n//   * Complexity: all functions are O(n) in the total length of their input and allocate O(n).\n\n// Non-empty segments of `p` in order (no \".\" / \"..\" processing).\nfunction splitSegments(p: string): string[] {\n  let out: string[] = [];\n  for (const s of p.split(\"/\")) {\n    if (s.length > 0) {\n      out.push(s);\n    }\n  }\n  return out;\n}\n\n// isAbsolute(p: string): bool\n// True when `p` starts with \"/\". `isAbsolute(\"\")` is false.\nexport function isAbsolute(p: string): bool {\n  return p.length > 0 && p.charCodeAt(0) == 47;\n}\n\n// normalize(p: string): string\n// Resolves \".\" and \"..\" segments lexically and collapses repeated separators.\n//   * \"\" normalizes to \".\"; a relative path that reduces to nothing is \".\" (\"a/..\" -> \".\").\n//   * \"..\" that would climb above the root of an absolute path is dropped (\"/..\" -> \"/\");\n//     in a relative path leading \"..\" segments are kept (\"../a\", \"a/../..\" -> \"..\").\n//   * A trailing separator is preserved (\"a//b/\" -> \"a/b/\", \"./\" -> \"./\"); the root is \"/\".\n// Examples: normalize(\"/a/./b/../c\") == \"/a/c\"; normalize(\"a//b\") == \"a/b\".\nexport function normalize(p: string): string {\n  if (p.length == 0) {\n    return \".\";\n  }\n  const abs = isAbsolute(p);\n  const trailing = p.charCodeAt(p.length - 1) == 47;\n  let out: string[] = [];\n  for (const s of splitSegments(p)) {\n    if (s == \".\") {\n      continue;\n    }\n    if (s == \"..\") {\n      if (out.length > 0 && out[out.length - 1] != \"..\") {\n        out.pop();\n      } else if (!abs) {\n        out.push(\"..\");\n      }\n      continue;\n    }\n    out.push(s);\n  }\n  const body = out.join(\"/\");\n  if (abs) {\n    if (body.length == 0) {\n      return \"/\";\n    }\n    return trailing ? \"/\" + body + \"/\" : \"/\" + body;\n  }\n  if (body.length == 0) {\n    return trailing ? \"./\" : \".\";\n  }\n  return trailing ? body + \"/\" : body;\n}\n\n// join(parts: string[]): string\n// Joins the non-empty `parts` with \"/\" and normalizes the result (see `normalize`). An empty\n// list, or a list of empty strings, gives \".\". Like Node, a later absolute part does NOT reset\n// the path: join([\"a\", \"/b\"]) == \"a/b\" (use `resolveAgainst` to get reset semantics).\n// Examples: join([\"/a\", \"b\", \"../c\"]) == \"/a/c\"; join([\"a\", \"\", \"b/\"]) == \"a/b/\".\nexport function join(parts: string[]): string {\n  let kept: string[] = [];\n  for (const q of parts) {\n    if (q.length > 0) {\n      kept.push(q);\n    }\n  }\n  if (kept.length == 0) {\n    return \".\";\n  }\n  return normalize(kept.join(\"/\"));\n}\n\n// resolveAgainst(base: string, p: string): string\n// `p` normalized when `p` is absolute, otherwise join([base, p]). Pure: there is no implicit\n// current directory, so `base` must be supplied by the caller.\nexport function resolveAgainst(base: string, p: string): string {\n  if (isAbsolute(p)) {\n    return normalize(p);\n  }\n  return join([base, p]);\n}\n\n// End offset (exclusive) of `p` after dropping trailing \"/\" characters; 0 when `p` is all \"/\".\nfunction endWithoutSlashes(p: string): usize {\n  let e = p.length;\n  while (e > 0 && p.charCodeAt(e - 1) == 47) {\n    e -= 1;\n  }\n  return e;\n}\n\n// Start offset of the last segment of p[0..e) (the position after the last \"/\" before e).\nfunction lastSegmentStart(p: string, e: usize): usize {\n  let i = e;\n  while (i > 0 && p.charCodeAt(i - 1) != 47) {\n    i -= 1;\n  }\n  return i;\n}\n\n// dirname(p: string): string\n// The directory part of `p`, ignoring trailing separators; the path is NOT normalized.\n//   dirname(\"/a/b/c\") == \"/a/b\"; dirname(\"/a/b/\") == \"/a\"; dirname(\"a\") == \".\"; dirname(\"\") == \".\";\n//   dirname(\"/a\") == \"/\"; dirname(\"/\") == \"/\"; dirname(\"a//b\") == \"a\"; dirname(\"a/./b\") == \"a/.\".\nexport function dirname(p: string): string {\n  const e = endWithoutSlashes(p);\n  if (e == 0) {\n    return p.length > 0 ? \"/\" : \".\";\n  }\n  const s = lastSegmentStart(p, e);\n  if (s == 0) {\n    return \".\";\n  }\n  const d = endWithoutSlashes(p.substring(0, s));\n  if (d == 0) {\n    return \"/\";\n  }\n  return p.substring(0, d);\n}\n\n// basename(p: string): string\n// The last segment of `p`, ignoring trailing separators. basename(\"/a/b.txt\") == \"b.txt\";\n// basename(\"a/b/\") == \"b\"; basename(\"/\") == \"\"; basename(\"\") == \"\".\nexport function basename(p: string): string {\n  const e = endWithoutSlashes(p);\n  if (e == 0) {\n    return \"\";\n  }\n  return p.substring(lastSegmentStart(p, e), e);\n}\n\n// extension(p: string): string\n// The extension of the basename including the leading dot, or \"\" when there is none (Node's\n// `extname`): extension(\"a/b.txt\") == \".txt\"; extension(\"a.tar.gz\") == \".gz\";\n// extension(\".bashrc\") == \"\"; extension(\"a.\") == \".\"; extension(\"a\") == \"\"; extension(\"..\") == \"\".\nexport function extension(p: string): string {\n  const b = basename(p);\n  let i = b.length;\n  while (i > 0) {\n    if (b.charCodeAt(i - 1) == 46) {\n      // i-1 is the last dot; a dot at offset 0 (\".bashrc\") or the name \"..\" has no extension.\n      if (i == 1 || b == \"..\") {\n        return \"\";\n      }\n      return b.substring(i - 1, b.length);\n    }\n    i -= 1;\n  }\n  return \"\";\n}\n\n// stem(p: string): string\n// The basename without its extension: stem(\"a/b.txt\") == \"b\"; stem(\".bashrc\") == \".bashrc\";\n// stem(\"a.tar.gz\") == \"a.tar\".\nexport function stem(p: string): string {\n  const b = basename(p);\n  const x = extension(p);\n  return b.substring(0, b.length - x.length);\n}\n\n// withExtension(p: string, ext: string): string\n// Replaces the extension of the basename of `p` by `ext` (which must include the dot, or be \"\"\n// to remove it). Trailing separators are dropped: withExtension(\"a/b.txt\", \".md\") == \"a/b.md\".\n// For \"\" or \"/\" (no basename) the result is `p + ext`.\nexport function withExtension(p: string, ext: string): string {\n  const e = endWithoutSlashes(p);\n  if (e == 0) {\n    return p + ext;\n  }\n  const x = extension(p);\n  return p.substring(0, e - x.length) + ext;\n}\n" });
  out.push(SourceFile { path: "$stdlib/test.or", text: "// std:test -- assertions for `@Test` functions (ADR-0024, docs/testing.md).\n//\n// A failed assertion TRAPS: it writes `trap: <message>` to stderr and exits with status 101, exactly\n// like any other trap (array bounds, `unwrap` of `None`, a violated contract). `orin test` runs\n// every test in its own process, so one failing test never stops the others. The functions work in\n// ordinary programs too (they are not tied to `orin test`).\n//\n//   * Every function is total apart from the trap it exists for; none returns a value.\n//   * `msg` describes what was being checked (\"\" is allowed); it is part of the trap message.\n//   * Orin has no generic equality, so there is one function per type: `assertEq` (int),\n//     `assertEqUsize`, `assertEqString`, `assertEqBool`, `assertNear` (float with a tolerance).\n//   * Complexity: O(1) (string equality: O(n)); no allocation unless the assertion fails.\n\nimport { exit } from \"std:process\";\n\n// fail(msg: string): void\n// Traps with `msg` unconditionally (a test that reached a place it must not reach).\nexport function fail(msg: string): void {\n  console.error(\"trap: \" + msg);\n  exit(101);\n}\n\n// assert(cond: bool, msg: string): void\n// Traps with \"assertion failed: <msg>\" when `cond` is false.\nexport function assert(cond: bool, msg: string): void {\n  if (!cond) {\n    fail(\"assertion failed: \" + msg);\n  }\n}\n\nfunction label(msg: string): string {\n  return msg.length > 0 ? msg + \": \" : \"\";\n}\n\n// assertEq(actual: int, expected: int, msg: string): void\n// Traps with \"assertEq failed: <msg>: expected <expected>, got <actual>\" when the ints differ.\nexport function assertEq(actual: int, expected: int, msg: string): void {\n  if (actual != expected) {\n    fail(\"assertEq failed: \" + label(msg) + \"expected \" + expected.toString() + \", got \" + actual.toString());\n  }\n}\n\n// assertEqUsize(actual: usize, expected: usize, msg: string): void\n// Like `assertEq` for `usize` (lengths, indices).\nexport function assertEqUsize(actual: usize, expected: usize, msg: string): void {\n  if (actual != expected) {\n    fail(\"assertEq failed: \" + label(msg) + \"expected \" + expected.toString() + \", got \" + actual.toString());\n  }\n}\n\n// assertEqString(actual: string, expected: string, msg: string): void\n// Like `assertEq` for strings; the values are shown in double quotes.\nexport function assertEqString(actual: string, expected: string, msg: string): void {\n  if (actual != expected) {\n    fail(\"assertEq failed: \" + label(msg) + \"expected \\\"\" + expected + \"\\\", got \\\"\" + actual + \"\\\"\");\n  }\n}\n\n// assertEqBool(actual: bool, expected: bool, msg: string): void\n// Like `assertEq` for bools.\nexport function assertEqBool(actual: bool, expected: bool, msg: string): void {\n  if (actual != expected) {\n    fail(\"assertEq failed: \" + label(msg) + \"expected \" + expected.toString() + \", got \" + actual.toString());\n  }\n}\n\n// assertNear(actual: float, expected: float, tolerance: float, msg: string): void\n// Traps unless |actual - expected| <= tolerance (a NaN on either side always fails).\nexport function assertNear(actual: float, expected: float, tolerance: float, msg: string): void {\n  const d = actual > expected ? actual - expected : expected - actual;\n  if (!(d <= tolerance)) {\n    fail(\"assertNear failed: \" + label(msg) + \"expected \" + expected.toString() + \" +/- \" + tolerance.toString() + \", got \" + actual.toString());\n  }\n}\n" });
  out.push(SourceFile { path: "$stdlib/time.or", text: "// std:time -- wall clock, durations with explicit units and UTC calendar conversion (spec 08).\n//\n// The only runtime primitive is `nowMillis` (builtin `std:clock`, runtime function\n// orin_time_now_millis); everything else is pure Orin. All quantities are `int` milliseconds\n// unless the name says otherwise (\"explicit units\": there is no unit-less number in this API).\n//   * Calendar functions use the proleptic Gregorian calendar in UTC; there are no time zones,\n//     no leap seconds. Instants are milliseconds since 1970-01-01T00:00:00Z (negative before).\n//   * Arithmetic on ints traps on overflow like everywhere in Orin; values here stay far from\n//     the limits for any date in years -292000000 .. 292000000.\n//\n// TODO(after floats/map): fractional seconds (`seconds(1.5)`), `sleep` (needs a second runtime\n// primitive), time zones / locale formatting.\n\n// nowMillis(): int\n// Wall-clock time in milliseconds since the Unix epoch (CLOCK_REALTIME). Not monotonic: the system\n// clock may jump. Cannot fail. O(1), no allocation.\nexport { nowMillis } from \"std:clock\";\n\n// A span of time in whole milliseconds (may be negative: a difference of two instants).\nexport type Duration = { millis: int; };\n\n// ---- durations ----------------------------------------------------------------------------\n\n// milliseconds / seconds / minutes / hours / days (n: int): Duration -- n units as a Duration. O(1).\nexport function milliseconds(n: int): Duration {\n  return Duration { millis: n };\n}\n\nexport function seconds(n: int): Duration {\n  return Duration { millis: n * 1000 };\n}\n\nexport function minutes(n: int): Duration {\n  return Duration { millis: n * 60000 };\n}\n\nexport function hours(n: int): Duration {\n  return Duration { millis: n * 3600000 };\n}\n\nexport function days(n: int): Duration {\n  return Duration { millis: n * 86400000 };\n}\n\n// toMillis(d: Duration): int -- the span in milliseconds. O(1).\nexport function toMillis(d: Duration): int {\n  return d.millis;\n}\n\n// toSeconds(d: Duration): int -- whole seconds, truncated toward zero (1999 ms -> 1). O(1).\nexport function toSeconds(d: Duration): int {\n  return d.millis / 1000;\n}\n\n// addDuration(a: Duration, b: Duration): Duration -- sum. O(1).\nexport function addDuration(a: Duration, b: Duration): Duration {\n  return Duration { millis: a.millis + b.millis };\n}\n\n// between(start: int, end: int): Duration -- end - start for two instants (milliseconds). O(1).\nexport function between(start: int, end: int): Duration {\n  return Duration { millis: end - start };\n}\n\n// plus(instant: int, d: Duration): int -- the instant `d` after `instant`. O(1).\nexport function plus(instant: int, d: Duration): int {\n  return instant + d.millis;\n}\n\n// formatDuration(d: Duration): string\n// Human-readable \"1d 2h 3m 4s 5ms\" with zero components omitted, \"0ms\" for zero and a leading\n// \"-\" for negative spans: formatDuration(milliseconds(3723005)) == \"1h 2m 3s 5ms\". O(1).\nexport function formatDuration(d: Duration): string {\n  if (d.millis == 0) {\n    return \"0ms\";\n  }\n  const neg = d.millis < 0;\n  let rest = neg ? 0 - d.millis : d.millis;\n  let parts: string[] = [];\n  const dd = rest / 86400000;\n  rest = rest % 86400000;\n  const hh = rest / 3600000;\n  rest = rest % 3600000;\n  const mm = rest / 60000;\n  rest = rest % 60000;\n  const ss = rest / 1000;\n  const ms = rest % 1000;\n  if (dd > 0) {\n    parts.push(dd.toString() + \"d\");\n  }\n  if (hh > 0) {\n    parts.push(hh.toString() + \"h\");\n  }\n  if (mm > 0) {\n    parts.push(mm.toString() + \"m\");\n  }\n  if (ss > 0) {\n    parts.push(ss.toString() + \"s\");\n  }\n  if (ms > 0) {\n    parts.push(ms.toString() + \"ms\");\n  }\n  const body = parts.join(\" \");\n  return neg ? \"-\" + body : body;\n}\n\n// ---- calendar (UTC) -----------------------------------------------------------------------\n\n// Broken-down UTC time. month 1..12, day 1..31, hour 0..23, minute 0..59, second 0..59,\n// millisecond 0..999, weekday 0 = Sunday .. 6 = Saturday.\nexport type DateTime = {\n  year: int; month: int; day: int;\n  hour: int; minute: int; second: int; millisecond: int;\n  weekday: int;\n};\n\nfunction floorDiv(a: int, b: int): int {\n  const q = a / b;\n  if (a % b != 0 && (a < 0) != (b < 0)) {\n    return q - 1;\n  }\n  return q;\n}\n\n// Days since 1970-01-01 of the civil date y-m-d (Howard Hinnant's days_from_civil).\nfunction daysFromCivil(y0: int, m: int, d: int): int {\n  const y = m <= 2 ? y0 - 1 : y0;\n  const era = floorDiv(y, 400);\n  const yoe = y - era * 400;\n  const mp = m > 2 ? m - 3 : m + 9;\n  const doy = (153 * mp + 2) / 5 + d - 1;\n  const doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;\n  return era * 146097 + doe - 719468;\n}\n\n// fromMillis(instant: int): DateTime -- UTC calendar fields of an instant. Total, O(1).\nexport function fromMillis(instant: int): DateTime {\n  const dayNum = floorDiv(instant, 86400000);\n  const msOfDay = instant - dayNum * 86400000;\n  const z = dayNum + 719468;\n  const era = floorDiv(z, 146097);\n  const doe = z - era * 146097;\n  const yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;\n  const doy = doe - (365 * yoe + yoe / 4 - yoe / 100);\n  const mp = (5 * doy + 2) / 153;\n  const d = doy - (153 * mp + 2) / 5 + 1;\n  const m = mp < 10 ? mp + 3 : mp - 9;\n  const y = yoe + era * 400 + (m <= 2 ? 1 : 0);\n  let wd = (dayNum + 4) % 7;\n  if (wd < 0) {\n    wd += 7;\n  }\n  return DateTime {\n    year: y, month: m, day: d,\n    hour: msOfDay / 3600000, minute: (msOfDay / 60000) % 60,\n    second: (msOfDay / 1000) % 60, millisecond: msOfDay % 1000,\n    weekday: wd\n  };\n}\n\n// isLeapYear(year: int): bool -- Gregorian rule. O(1).\nexport function isLeapYear(year: int): bool {\n  return (year % 4 == 0 && year % 100 != 0) || year % 400 == 0;\n}\n\n// daysInMonth(year: int, month: int): Option<int> -- None unless month is 1..12. O(1).\nexport function daysInMonth(year: int, month: int): Option<int> {\n  if (month < 1 || month > 12) {\n    return None;\n  }\n  if (month == 2) {\n    return Some(isLeapYear(year) ? 29 : 28);\n  }\n  if (month == 4 || month == 6 || month == 9 || month == 11) {\n    return Some(30);\n  }\n  return Some(31);\n}\n\n// toInstant(dt: DateTime): Option<int>\n// The instant of a UTC date-time, or None when a field is out of range (month 1..12, day within\n// the month, hour 0..23, minute/second 0..59, millisecond 0..999). `weekday` is ignored. O(1).\nexport function toInstant(dt: DateTime): Option<int> {\n  const dim = daysInMonth(dt.year, dt.month);\n  if (dim.isNone()) {\n    return None;\n  }\n  if (dt.day < 1 || dt.day > dim.unwrap()) {\n    return None;\n  }\n  if (dt.hour < 0 || dt.hour > 23 || dt.minute < 0 || dt.minute > 59\n      || dt.second < 0 || dt.second > 59 || dt.millisecond < 0 || dt.millisecond > 999) {\n    return None;\n  }\n  const dayNum = daysFromCivil(dt.year, dt.month, dt.day);\n  return Some(dayNum * 86400000 + dt.hour * 3600000 + dt.minute * 60000 + dt.second * 1000 + dt.millisecond);\n}\n\nfunction pad(n: int, width: usize): string {\n  let s = n.toString();\n  while (s.length < width) {\n    s = \"0\" + s;\n  }\n  return s;\n}\n\n// formatIso(instant: int): string\n// ISO 8601 / RFC 3339 UTC: \"2024-02-29T13:04:05.006Z\" (year padded to at least 4 digits; years\n// before 0 or after 9999 are printed with their sign / extra digits). O(1).\nexport function formatIso(instant: int): string {\n  const t = fromMillis(instant);\n  const ys = t.year < 0 ? \"-\" + pad(0 - t.year, 4) : pad(t.year, 4);\n  return ys + \"-\" + pad(t.month, 2) + \"-\" + pad(t.day, 2) + \"T\" + pad(t.hour, 2) + \":\"\n    + pad(t.minute, 2) + \":\" + pad(t.second, 2) + \".\" + pad(t.millisecond, 3) + \"Z\";\n}\n" });
  out.push(SourceFile { path: "$stdlib/utf8.or", text: "// std:utf8 -- validated UTF-8 decoding and encoding, code point iteration and `Utf8String`, a string with the\n// invariant \"always valid UTF-8\" (ADR-0030 \xc2\xa73, layer \"bytes and text\"). Pure safe Orin.\n//\n// Background. Orin strings are byte strings (`length`, `charCodeAt` and `substring` count bytes) that are\n// *expected* to hold UTF-8 but nothing in the language enforces it. This module turns the expectation into a\n// type: a `Utf8String` can only be built from bytes that passed `validate`, so every function that takes one\n// may rely on well-formedness (RFC 3629 / Unicode Table 3-7):\n//\n//   U+0000..U+007F    00..7F\n//   U+0080..U+07FF    C2..DF 80..BF\n//   U+0800..U+0FFF    E0 A0..BF 80..BF         (E0 80..9F is an overlong form)\n//   U+1000..U+CFFF    E1..EC 80..BF 80..BF\n//   U+D000..U+D7FF    ED 80..9F 80..BF         (ED A0..BF is a surrogate, U+D800..U+DFFF)\n//   U+E000..U+FFFF    EE..EF 80..BF 80..BF\n//   U+10000..U+3FFFF  F0 90..BF 80..BF 80..BF  (F0 80..8F is an overlong form)\n//   U+40000..U+FFFFF  F1..F3 80..BF 80..BF 80..BF\n//   U+100000..U+10FFFF F4 80..8F 80..BF 80..BF (F4 90..BF is above U+10FFFF)\n//\n// Rejected, with the error kind: a continuation byte (80..BF) as first byte, or F8..FF (`InvalidLead`); C0, C1\n// and the overlong forms above (`Overlong`); surrogates (`Surrogate`); F5..F7 and F4 90..BF (`TooLarge`);\n// a sequence cut off by the end of input (`TruncatedSequence`); a missing continuation byte\n// (`InvalidContinuation`). Noncharacters (U+FFFE, U+FFFF, U+FDD0..) are valid scalar values and accepted.\n//\n// Error position. `Utf8Error.position` is the byte offset where the first invalid sequence starts, i.e. the\n// length of the longest valid prefix, and `length` the number of bytes of the maximal invalid prefix at that\n// point (1..3; for a truncated sequence the bytes left). Everything before `position` is valid UTF-8.\n//\n// Contract standard (ADR-0030 \xc2\xa73): `Utf8String` and `CodePointCursor` carry invariants checked after every\n// public method (`orin test`, `--check-contracts`); the constructor of `Utf8String` *always* validates, so the\n// invariant also holds in builds without contract checking. Helpers used in contracts are loops, not closures.\n//\n// Complexity: n = byte length. `validate*`, `isValidUtf8` (one table-driven pass, no allocation), `codePointCount`, `codePoints`, `concat`, `trySlice`,\n// `fromCodePoints` O(n); `encodeCodePoint`, `codePointAt`, `isCharBoundary`, `byteLength` O(1);\n// `CodePointCursor.next` O(1); constructing a `Utf8String` validates, O(n).\n\nimport { Bytes, ByteBuilder, bytesFromString } from \"std:bytes\";\n\n// ---------------------------------------------------------------------------------------------- errors\n\nexport type Utf8ErrorKind = InvalidLead | TruncatedSequence | InvalidContinuation | Overlong | Surrogate | TooLarge;\n\n// position: byte offset of the first invalid sequence (the length of the longest valid prefix).\n// length: bytes of the maximal invalid prefix there (1..3). kind: why it is invalid.\nexport type Utf8Error = { position: usize; length: usize; kind: Utf8ErrorKind; };\n\n// utf8ErrorMessage(e): \"invalid UTF-8 at byte 3: overlong encoding\". O(1).\n@Ensures(result.length > 0)\nexport function utf8ErrorMessage(e: Utf8Error): string {\n  const why = match (e.kind) {\n    InvalidLead => \"invalid leading byte\",\n    TruncatedSequence => \"truncated sequence\",\n    InvalidContinuation => \"invalid continuation byte\",\n    Overlong => \"overlong encoding\",\n    Surrogate => \"encoded surrogate\",\n    TooLarge => \"code point above U+10FFFF\"\n  };\n  return `invalid UTF-8 at byte ${e.position.toString()}: ${why}`;\n}\n\n// ------------------------------------------------------------------------------------ scalar values\n\n// isScalarValue(cp): cp is a Unicode scalar value: 0..0xD7FF or 0xE000..0x10FFFF. O(1).\n@Ensures(result ==> cp >= 0 && cp <= 1114111)\n@Ensures(cp >= 55296 && cp <= 57343 ==> !result)\nexport function isScalarValue(cp: int): bool {\n  return (cp >= 0 && cp < 55296) || (cp >= 57344 && cp <= 1114111);\n}\n\n// utf8Len(cp): number of UTF-8 bytes of a scalar value (1..4). O(1).\n@Requires(isScalarValue(cp))\n@Ensures(result >= 1 && result <= 4)\n@Ensures((result == 1) == (cp < 128))\n@Ensures((result == 4) == (cp >= 65536))\nexport function utf8Len(cp: int): int {\n  if (cp < 128) {\n    return 1;\n  }\n  if (cp < 2048) {\n    return 2;\n  }\n  if (cp < 65536) {\n    return 3;\n  }\n  return 4;\n}\n\n// encodeCodePoint(cp): the UTF-8 bytes of a scalar value as a string; None for surrogates, values above U+10FFFF\n// and negative values. O(1).\n@Ensures(result.isSome() == isScalarValue(cp))\n@Ensures(result.isSome() ==> result.unwrap().length.toInt() == utf8Len(cp))\n@Ensures(result.isSome() ==> isValidUtf8(result.unwrap()) && decodeAt(result.unwrap(), 0) == cp)\nexport function encodeCodePoint(cp: int): Option<string> {\n  if (!isScalarValue(cp)) {\n    return None;\n  }\n  if (cp < 128) {\n    return Some(String.fromCharCode(cp));\n  }\n  if (cp < 2048) {\n    return Some(String.fromCharCode(192 + cp / 64) + String.fromCharCode(128 + cp % 64));\n  }\n  if (cp < 65536) {\n    return Some(String.fromCharCode(224 + cp / 4096) + String.fromCharCode(128 + (cp / 64) % 64)\n      + String.fromCharCode(128 + cp % 64));\n  }\n  return Some(String.fromCharCode(240 + cp / 262144) + String.fromCharCode(128 + (cp / 4096) % 64)\n    + String.fromCharCode(128 + (cp / 64) % 64) + String.fromCharCode(128 + cp % 64));\n}\n\n// ------------------------------------------------------------------------------------------ scanning\n\nfunction isCont(c: int): bool {\n  return c >= 128 && c <= 191;\n}\n\n// Result of looking at one sequence: `kind` is None for a valid sequence of `len` bytes, else the error.\ntype Seq = { len: usize; kind: Option<Utf8ErrorKind>; };\n\nfunction okSeq(len: usize): Seq {\n  return Seq { len: len, kind: None };\n}\n\nfunction badSeq(len: usize, k: Utf8ErrorKind): Seq {\n  return Seq { len: len, kind: Some(k) };\n}\n\n// Looks at the sequence starting at byte i of s (i < s.length).\n@Requires(i < s.length)\n@Ensures(result.len >= 1 && result.len <= 4 && i + result.len <= s.length)\nfunction scanSeq(s: string, i: usize): Seq {\n  const n = s.length;\n  const c = s.charCodeAt(i);\n  if (c < 128) {\n    return okSeq(1);\n  }\n  if (c < 192) {\n    return badSeq(1, InvalidLead);\n  }\n  if (c < 194) {\n    return badSeq(1, Overlong);\n  }\n  if (c >= 245) {\n    if (c < 248) {\n      return badSeq(1, TooLarge);\n    }\n    return badSeq(1, InvalidLead);\n  }\n  let need: usize = 1;\n  let lo2 = 128;\n  let hi2 = 191;\n  if (c >= 240) {\n    need = 3;\n    if (c == 240) {\n      lo2 = 144;\n    }\n    if (c == 244) {\n      hi2 = 143;\n    }\n  } else if (c >= 224) {\n    need = 2;\n    if (c == 224) {\n      lo2 = 160;\n    }\n    if (c == 237) {\n      hi2 = 159;\n    }\n  }\n  if (i + 1 >= n) {\n    return badSeq(1, TruncatedSequence);\n  }\n  const b2 = s.charCodeAt(i + 1);\n  if (!isCont(b2)) {\n    return badSeq(1, InvalidContinuation);\n  }\n  if (b2 < lo2 || b2 > hi2) {\n    if (c == 237) {\n      return badSeq(1, Surrogate);\n    }\n    if (c == 244) {\n      return badSeq(1, TooLarge);\n    }\n    return badSeq(1, Overlong);\n  }\n  let k: usize = 2;\n  while (k <= need) {\n    if (i + k >= n) {\n      return badSeq(k, TruncatedSequence);\n    }\n    if (!isCont(s.charCodeAt(i + k))) {\n      return badSeq(k, InvalidContinuation);\n    }\n    k += 1;\n  }\n  return okSeq(need + 1);\n}\n\n// The validator is table-driven (Bjoern Hoehrmann's UTF-8 DFA, 12 byte classes x 9 states, accepting state 0,\n// rejecting state 12; the tables are string constants because Orin has no constant arrays). Runs of ASCII bytes\n// are skipped without table lookups. `scanSeq` (above) is only used on the error path, to classify the first bad\n// sequence; the tests check the DFA against it on every 1- and 2-byte input and on boundary-heavy 3- and 4-byte\n// inputs. Class table: 256 entries indexed by the byte; transition table: next = NEXT[state + class].\nconst UTF8_CLASS: string = \"\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x01\\x01\\x01\\x01\\x01\\x01\\x01\\x01\\x01\\x01\\x01\\x01\\x01\\x01\\x01\\x01\\x09\\x09\\x09\\x09\\x09\\x09\\x09\\x09\\x09\\x09\\x09\\x09\\x09\\x09\\x09\\x09\\x07\\x07\\x07\\x07\\x07\\x07\\x07\\x07\\x07\\x07\\x07\\x07\\x07\\x07\\x07\\x07\\x07\\x07\\x07\\x07\\x07\\x07\\x07\\x07\\x07\\x07\\x07\\x07\\x07\\x07\\x07\\x07\\x08\\x08\\x02\\x02\\x02\\x02\\x02\\x02\\x02\\x02\\x02\\x02\\x02\\x02\\x02\\x02\\x02\\x02\\x02\\x02\\x02\\x02\\x02\\x02\\x02\\x02\\x02\\x02\\x02\\x02\\x02\\x02\\x0a\\x03\\x03\\x03\\x03\\x03\\x03\\x03\\x03\\x03\\x03\\x03\\x03\\x04\\x03\\x03\\x0b\\x06\\x06\\x06\\x05\\x08\\x08\\x08\\x08\\x08\\x08\\x08\\x08\\x08\\x08\\x08\";\nconst UTF8_NEXT: string = \"\\x00\\x0c\\x18\\x24\\x3c\\x60\\x54\\x0c\\x0c\\x0c\\x30\\x48\\x0c\\x0c\\x0c\\x0c\\x0c\\x0c\\x0c\\x0c\\x0c\\x0c\\x0c\\x0c\\x0c\\x00\\x0c\\x0c\\x0c\\x0c\\x0c\\x00\\x0c\\x00\\x0c\\x0c\\x0c\\x18\\x0c\\x0c\\x0c\\x0c\\x0c\\x18\\x0c\\x18\\x0c\\x0c\\x0c\\x0c\\x0c\\x0c\\x0c\\x0c\\x0c\\x18\\x0c\\x0c\\x0c\\x0c\\x0c\\x18\\x0c\\x0c\\x0c\\x0c\\x0c\\x0c\\x0c\\x18\\x0c\\x0c\\x0c\\x0c\\x0c\\x0c\\x0c\\x0c\\x0c\\x24\\x0c\\x24\\x0c\\x0c\\x0c\\x24\\x0c\\x0c\\x0c\\x0c\\x0c\\x24\\x0c\\x24\\x0c\\x0c\\x0c\\x24\\x0c\\x0c\\x0c\\x0c\\x0c\\x0c\\x0c\\x0c\\x0c\\x0c\";\n\n// validPrefix(s): the length of the longest prefix of s that is valid UTF-8 and ends on a sequence boundary:\n// s.length when s is valid, else the offset of the first invalid (or cut-off) sequence. One pass, O(n), no\n// allocation. The spec decoder `scanSeq` agrees at the returned offset (checked by the contract).\n@Ensures(result <= s.length)\n@Ensures(result < s.length ==> scanSeq(s, result).kind.isSome())\nfunction validPrefix(s: string): usize {\n  const n = s.length;\n  let i: usize = 0;\n  while (i < n) {\n    if (s.charCodeAt(i) < 128) {\n      i += 1;\n      while (i < n && s.charCodeAt(i) < 128) {\n        i += 1;\n      }\n    } else {\n      const start = i;\n      let st = 0;\n      while (i < n) {\n        st = UTF8_NEXT.charCodeAt((st + UTF8_CLASS.charCodeAt(s.charCodeAt(i).toUsize())).toUsize());\n        i += 1;\n        if (st <= 12) {\n          break;\n        }\n      }\n      if (st != 0) {\n        return start;\n      }\n    }\n  }\n  return n;\n}\n\n// checkUtf8(s): Ok when the bytes of `s` are well-formed UTF-8, else the first error. O(n).\n@Ensures(result.isErr() ==> result.unwrapErr().position < s.length)\n@Ensures(result.isErr() ==> result.unwrapErr().position + result.unwrapErr().length <= s.length)\n@Ensures(s.length == 0 ==> result.isOk())\nexport function checkUtf8(s: string): Result<void, Utf8Error> {\n  const p = validPrefix(s);\n  if (p == s.length) {\n    return Ok();\n  }\n  const q = scanSeq(s, p);\n  return Err(Utf8Error { position: p, length: q.len, kind: q.kind.unwrap() });\n}\n\n// isValidUtf8(s): are the bytes of `s` well-formed UTF-8? Usable in contracts. O(n).\n@Ensures(s.length == 0 ==> result)\nexport function isValidUtf8(s: string): bool {\n  return validPrefix(s) == s.length;\n}\n\n// Number of code points of a string that is valid UTF-8 (not re-checked: that would make callers quadratic): the bytes that are not continuation bytes. O(n).\n@Ensures(result <= s.length)\n@Ensures((result == 0) == (s.length == 0))\nfunction countCodePoints(s: string): usize {\n  let n: usize = 0;\n  let i: usize = 0;\n  while (i < s.length) {\n    if (!isCont(s.charCodeAt(i))) {\n      n += 1;\n    }\n    i += 1;\n  }\n  return n;\n}\n\n// The code point of the sequence starting at byte i of s, which must be valid UTF-8 (not re-checked, see above).\n@Requires(i < s.length && !isCont(s.charCodeAt(i)))\n@Ensures(isScalarValue(result))\nfunction decodeAt(s: string, i: usize): int {\n  const c = s.charCodeAt(i);\n  if (c < 128) {\n    return c;\n  }\n  if (c < 224) {\n    return (c - 192) * 64 + (s.charCodeAt(i + 1) - 128);\n  }\n  if (c < 240) {\n    return (c - 224) * 4096 + (s.charCodeAt(i + 1) - 128) * 64 + (s.charCodeAt(i + 2) - 128);\n  }\n  return (c - 240) * 262144 + (s.charCodeAt(i + 1) - 128) * 4096 + (s.charCodeAt(i + 2) - 128) * 64\n    + (s.charCodeAt(i + 3) - 128);\n}\n\n// ------------------------------------------------------------------------------------------ Utf8String\n\n// A string that is valid UTF-8 by construction. Value semantics like every class: a copy is independent and\n// there is no mutating method, so the invariant cannot be broken after construction.\n@Invariant(isValidUtf8(this.text))\nexport class Utf8String {\n  private text: string;\n\n  // new Utf8String(text): wraps a string that is already valid UTF-8. Traps (unwrap of an Err) on invalid\n  // input, in every build: use `validateString` / `validate` to get a Result. O(n).\n  @Requires(isValidUtf8(text))\n  constructor(text: string) {\n    this.text = checked(text);\n  }\n\n  // asString(): the text (valid UTF-8). O(1).\n  @Ensures(isValidUtf8(result))\n  asString(): string {\n    return this.text;\n  }\n\n  // byteLength(): number of bytes. O(1).\n  @Ensures(result == this.text.length)\n  byteLength(): usize {\n    return this.text.length;\n  }\n\n  // isEmpty(): no bytes (and no code points). O(1).\n  @Ensures(result == (this.byteLength() == 0))\n  isEmpty(): bool {\n    return this.text.length == 0;\n  }\n\n  // toBytes(): the UTF-8 encoding as `Bytes`. O(n).\n  @Ensures(result.length() == this.text.length)\n  toBytes(): Bytes {\n    return bytesFromString(this.text);\n  }\n\n  // codePointCount(): number of code points. Between byteLength()/4 and byteLength(). O(n).\n  @Ensures(result <= this.text.length)\n  @Ensures(result * 4 >= this.text.length)\n  codePointCount(): usize {\n    return countCodePoints(this.text);\n  }\n\n  // isCharBoundary(i): i is 0, byteLength(), or the index of the first byte of a code point. O(1).\n  @Ensures(i > this.text.length ==> !result)\n  @Ensures(i == 0 || i == this.text.length ==> result)\n  isCharBoundary(i: usize): bool {\n    if (i > this.text.length) {\n      return false;\n    }\n    if (i == this.text.length) {\n      return true;\n    }\n    return !isCont(this.text.charCodeAt(i));\n  }\n\n  // codePointAt(i): the code point starting at byte i; None unless i is a boundary before the end. O(1).\n  @Ensures(result.isSome() == (i < this.text.length && this.isCharBoundary(i)))\n  @Ensures(result.isSome() ==> isScalarValue(result.unwrap()))\n  codePointAt(i: usize): Option<int> {\n    if (i >= this.text.length || isCont(this.text.charCodeAt(i))) {\n      return None;\n    }\n    return Some(decodeAt(this.text, i));\n  }\n\n  // codePoints(): all code points in order. O(n).\n  @Ensures(result.length == this.codePointCount())\n  codePoints(): int[] {\n    let out: int[] = [];\n    let i: usize = 0;\n    while (i < this.text.length) {\n      const c = decodeAt(this.text, i);\n      out.push(c);\n      i += utf8Len(c).toUsize();\n    }\n    return out;\n  }\n\n  // concat(other): this followed by other; concatenation of valid UTF-8 is valid. O(n + m).\n  @Ensures(result.byteLength() == this.text.length + other.byteLength())\n  @Ensures(result.codePointCount() == this.codePointCount() + other.codePointCount())\n  concat(other: Utf8String): Utf8String {\n    return new Utf8String(this.text + other.asString());\n  }\n\n  // trySlice(lo, hi): the bytes [lo, hi) as a Utf8String; None unless lo <= hi <= byteLength() and both ends\n  // are code point boundaries (so the result is valid by construction). O(hi - lo).\n  @Ensures(result.isSome() == (lo <= hi && this.isCharBoundary(lo) && this.isCharBoundary(hi)))\n  @Ensures(result.isSome() ==> result.unwrap().byteLength() == hi - lo)\n  trySlice(lo: usize, hi: usize): Option<Utf8String> {\n    if (lo > hi || !this.isCharBoundary(lo) || !this.isCharBoundary(hi)) {\n      return None;\n    }\n    return Some(new Utf8String(this.text.substring(lo, hi)));\n  }\n}\n\n// Returns s when it is valid UTF-8 and traps otherwise (the guard of the `Utf8String` constructor).\n@Requires(isValidUtf8(s))\n@Ensures(result == s)\nfunction checked(s: string): string {\n  checkUtf8(s).unwrap();\n  return s;\n}\n\n// validateString(s): `s` as a Utf8String, or the first error. O(n).\n@Ensures(result.isOk() == isValidUtf8(s))\n@Ensures(result.isOk() ==> result.unwrap().asString() == s)\n@Ensures(result.isErr() ==> result.unwrapErr().position < s.length)\nexport function validateString(s: string): Result<Utf8String, Utf8Error> {\n  const r = checkUtf8(s);\n  if (r.isErr()) {\n    return Err(r.unwrapErr());\n  }\n  return Ok(new Utf8String(s));\n}\n\n// validate(b): decodes bytes to text, rejecting overlong forms, surrogates and values above U+10FFFF, with the\n// error position. O(n).\n@Ensures(result.isOk() ==> result.unwrap().byteLength() == b.length())\n@Ensures(result.isErr() ==> result.unwrapErr().position < b.length())\nexport function validate(b: Bytes): Result<Utf8String, Utf8Error> {\n  return validateString(b.toRawString());\n}\n\n// encode(s): the UTF-8 bytes of a Utf8String. O(n).\n@Ensures(result.length() == s.byteLength())\nexport function encode(s: Utf8String): Bytes {\n  return s.toBytes();\n}\n\n// fromCodePoints(cps): the string made of the code points; None if any is not a scalar value. O(n).\n@Ensures(result.isSome() ==> result.unwrap().codePointCount() == cps.length)\n@Ensures(cps.length == 0 ==> result.isSome() && result.unwrap().isEmpty())\nexport function fromCodePoints(cps: int[]): Option<Utf8String> {\n  let parts: string[] = [];\n  let i: usize = 0;\n  while (i < cps.length) {\n    const e = encodeCodePoint(cps[i]);\n    if (e.isNone()) {\n      return None;\n    }\n    parts.push(e.unwrap());\n    i += 1;\n  }\n  return Some(new Utf8String(parts.join(\"\")));\n}\n\n// --------------------------------------------------------------------------------------------- cursor\n\n// Iterates the code points of a Utf8String. The cursor always sits on a code point boundary.\n@Invariant(this.pos <= this.src.byteLength() && this.src.isCharBoundary(this.pos))\nexport class CodePointCursor {\n  private src: Utf8String;\n  private pos: usize = 0;\n\n  constructor(src: Utf8String) {\n    this.src = src;\n  }\n\n  // position(): byte offset of the next code point. O(1).\n  @Ensures(result <= this.src.byteLength())\n  position(): usize {\n    return this.pos;\n  }\n\n  // hasNext(): a code point is left. O(1).\n  @Ensures(result == (this.pos < this.src.byteLength()))\n  hasNext(): bool {\n    return this.pos < this.src.byteLength();\n  }\n\n  // next(): the next code point and advance past it; None at the end. O(1).\n  @Ensures(result.isSome() == old(this.hasNext()))\n  @Ensures(result.isSome() ==> isScalarValue(result.unwrap()))\n  @Ensures(result.isSome() ==> this.position() == old(this.position()) + utf8Len(result.unwrap()).toUsize())\n  @Ensures(result.isNone() ==> this.position() == old(this.position()))\n  next(): Option<int> {\n    const c = this.src.codePointAt(this.pos);\n    if (c.isNone()) {\n      return None;\n    }\n    this.pos += utf8Len(c.unwrap()).toUsize();\n    return c;\n  }\n}\n" });
  return out;
}
