// error: E0476
class Key {
  n: int;
  constructor(n: int) {
    this.n = n;
  }
  private equals(other: Key): bool {
    return this.n == other.n;
  }
}

function same<T extends Eq>(a: T, b: T): bool {
  return a == b;
}

function main(): void {
  console.log(same(new Key(1), new Key(1)).toString());
}
