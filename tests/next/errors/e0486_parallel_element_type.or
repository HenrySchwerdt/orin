// error: E0486
// The input of a parallel pipeline is lent to the worker tasks without a copy, which is sound only for elements that hold
// no counted references until borrow inference exists (ADR-0039 §4): strings are not allowed.
function main(): void {
  const names = ["a", "bb", "ccc"];
  const lens = names.parallel().map(s => s.length).toArray();
}
