// std:net (ADR-0033): the pure helpers, and StreamReader / recv / send on a real loopback socket. Run by tools/test_std.sh
// with contract checking (every @Invariant / @Requires / @Ensures of std:net is a run-time trap) and without.
import { assert, assertEq, assertEqUsize, assertEqString, assertEqBool, fail } from "std:test";
import { Host, useNet } from "std:host";
import { Bytes, fromString, fromInts } from "std:bytes";
import {
  NetGrant, Listener, Stream, Peer, parsePeer, findFrom, makeError, isDenied, isTimeout, isReset, useListenerNet, useConnectionBeside,
  useAccepted, portOf, recv, send, sendAll, shutdownWrite, nowMillis, StreamReader, RecvResult, RecvData, RecvEof, RecvTimeout, RecvReset,
  RecvError, Fill, Filled, FillClosed, FillLimit, FillTimeout, FillError
} from "std:net";

@Test
function peerParsing(): void {
  const a = parsePeer("127.0.0.1:8080");
  assertEqString(a.host, "127.0.0.1", "ipv4 host");
  assertEq(a.port, 8080, "ipv4 port");
  const b = parsePeer("[::1]:443");
  assertEqString(b.host, "::1", "ipv6 host");
  assertEq(b.port, 443, "ipv6 port");
  assertEq(parsePeer("nonsense").port, 0, "no port");
  assertEq(parsePeer("1.2.3.4:99x").port, 0, "bad port");
}

@Test
function errorClassification(): void {
  assert(isDenied(makeError(1)), "EPERM is a denial");
  assert(isTimeout(makeError(1002)), "timeout");
  assert(isReset(makeError(1003)), "reset");
  assert(!isDenied(makeError(1002)), "a timeout is not a denial");
  assert(makeError(1002).message.length > 0, "every error has text");
  assert(makeError(111).message.length > 0, "an errno has text");
}

@Test
function delimiterSearch(): void {
  const crlf = fromString("\r\n");
  const h = fromString("GET / HTTP/1.1\r\nHost: x\r\n\r\n");
  assertEqUsize(findFrom(h, crlf, 0, 100).unwrap(), 16, "first CRLF");
  assertEqUsize(findFrom(h, crlf, 16, 100).unwrap(), 25, "second CRLF");
  assert(findFrom(h, crlf, 0, 15).isNone(), "the delimiter would end past the limit");
  assertEqUsize(findFrom(h, crlf, 0, 16).unwrap(), 16, "the delimiter ends exactly at the limit");
  assert(findFrom(fromString("ab\r"), crlf, 0, 100).isNone(), "half a delimiter");
  assertEqUsize(findFrom(fromString("aaab"), fromString("aab"), 0, 10).unwrap(), 4, "overlapping prefix");
  assert(findFrom(fromString(""), crlf, 0, 10).isNone(), "empty haystack");
}

function kind(r: RecvResult): string {
  return match (r) {
    RecvData(b) => "data " + b.length().toString(),
    RecvEof => "eof",
    RecvTimeout => "timeout",
    RecvReset => "reset",
    RecvError(e) => "error"
  };
}

function fillKind(f: Fill): string {
  return match (f) {
    Filled(b) => "filled " + b.toRawString(),
    FillClosed(b) => "closed " + b.toRawString(),
    FillLimit => "limit",
    FillTimeout => "timeout",
    FillError(e) => "error"
  };
}

// client side: connect to the listener in the same process and run `body` with the accepted stream (the connect completes
// before accept: the kernel queues it)
function pair(ln: Listener, net: NetGrant, client: (c: Stream) => void, server: (s: Stream) => void): void {
  const r = useConnectionBeside(net, "127.0.0.1", portOf(ln), 2000, ln, (c: Stream, ln2: Listener) => {
    client(c);
    const a = useAccepted(ln2, 2000, (s: Stream, p: Peer) => { server(s); });
    assert(a.isOk(), "accepted");
  });
  assert(r.isOk(), "connected");
}

@Test
function readUntilAndExact(host: Host): void {
  useNet(host, net => {
    const l = useListenerNet(net, "127.0.0.1", 0, 8, (ln, n) => {
      pair(ln, n, (c: Stream) => {
        // a head that arrives as three separate sends, and a body behind it
        sendAll(c, fromString("GET / HT"), 1000);
        sendAll(c, fromString("TP/1.1\r"), 1000);
        sendAll(c, fromString("\nHost: x\r\n\r\nbody!"), 1000);
        shutdownWrite(c);
      }, (s: Stream) => {
        let rd = new StreamReader(1024);
        assertEqString(fillKind(rd.readUntil(s, fromString("\r\n"), 100, 1000)), "filled GET / HTTP/1.1\r\n", "request line");
        assertEqString(fillKind(rd.readUntil(s, fromString("\r\n\r\n"), 100, 1000)), "filled Host: x\r\n\r\n", "rest of the head");
        assertEqString(fillKind(rd.readExact(s, 3, 1000)), "filled bod", "exact");
        assertEqString(fillKind(rd.readExact(s, 5, 1000)), "closed y!", "the peer closed before 5 bytes");
        assertEqUsize(rd.buffered().length(), 0, "nothing buffered at the end");
      });
    });
    assert(l.isOk(), "listener");
  });
}

@Test
function limitsAndDeadlines(host: Host): void {
  useNet(host, net => {
    const l = useListenerNet(net, "127.0.0.1", 0, 8, (ln, n) => {
      pair(ln, n, (c: Stream) => {
        sendAll(c, fromString("0123456789"), 1000);
      }, (s: Stream) => {
        let rd = new StreamReader(64);
        assertEqString(fillKind(rd.readUntil(s, fromString("\n"), 4, 500)), "limit", "no delimiter within 4 bytes");
        assert(rd.buffered().length() <= 4, "at most the limit was received");
        // the rest is still there for the next read: nothing was lost
        assertEqString(fillKind(rd.readExact(s, 10, 500)), "filled 0123456789", "all ten bytes, nothing lost");
        // a deadline for the whole call: nothing more arrives
        const t0 = nowMillis(s);
        assertEqString(fillKind(rd.readExact(s, 1, 120)), "timeout", "deadline");
        const dt = nowMillis(s) - t0;
        assert(dt >= 100 && dt < 2000, "the deadline is about 120 ms, not much less and not infinite: " + dt.toString());
        assertEqString(kind(recv(s, 8, 20)), "timeout", "recv timeout");
      });
    });
    assert(l.isOk(), "listener");
  });
}

@Test
function recvAndSend(host: Host): void {
  useNet(host, net => {
    const l = useListenerNet(net, "127.0.0.1", 0, 8, (ln, n) => {
      pair(ln, n, (c: Stream) => {
        const one = send(c, fromInts([1, 2, 3, 250, 251]), 1000);
        assertEqUsize(one.unwrap(), 5, "send reports what it handed over");
        assert(send(c, fromString(""), 1000).unwrap() == 0, "an empty send");
      }, (s: Stream) => {
        assertEqString(kind(recv(s, 2, 1000)), "data 2", "recv is capped by maxBytes");
        const r = recv(s, 100, 1000);
        match (r) {
          RecvData(b) => {
            assertEqUsize(b.length(), 3, "the rest");
            assertEq(b.at(0).toInt(), 3, "byte values survive");
            assertEq(b.at(2).toInt(), 251, "high byte values survive");
          },
          _ => { fail("expected data"); }
        }
        assertEqString(kind(recv(s, 0, 10)), "error", "maxBytes 0");
        sendAll(s, fromString("x"), 1000);
      });
    });
    assert(l.isOk(), "listener");
  });
}

@Test
function sendViewsOfALargerArray(host: Host): void {
  useNet(host, net => {
    const l = useListenerNet(net, "127.0.0.1", 0, 8, (ln, n) => {
      pair(ln, n, (c: Stream) => {
        // views that start and end inside their storage: only their own bytes go out
        const all = fromString("xxHELLOyyWORLDzz");
        assertEqUsize(send(c, all.slice(2, 7), 1000).unwrap(), 5, "send of a view");
        assert(sendAll(c, all.slice(9, 14), 1000).isOk(), "sendAll of a view");
        shutdownWrite(c);
      }, (s: Stream) => {
        let rd = new StreamReader(64);
        assertEqString(fillKind(rd.readExact(s, 10, 1000)), "filled HELLOWORLD", "only the bytes of the views");
        assertEqString(fillKind(rd.readExact(s, 1, 1000)), "closed ", "nothing after them");
      });
    });
    assert(l.isOk(), "listener");
  });
}

@Test
function refusals(host: Host): void {
  useNet(host, net => {
    const a = useListenerNet(net, "127.0.0.1", 0, 0, (ln, n) => { fail("backlog 0 must be refused"); });
    assert(a.isErr(), "backlog 0");
    const b = useListenerNet(net, "not an address", 0, 4, (ln, n) => { fail("not numeric"); });
    assert(b.isErr(), "a name is not an address");
    const c = useListenerNet(net, "127.0.0.1", 99999, 4, (ln, n) => { fail("bad port"); });
    assert(c.isErr(), "port out of range");
  });
}

@Test
function readUntilNeverBuffersPastTheLimit(host: Host): void {
  useNet(host, net => {
    const l = useListenerNet(net, "127.0.0.1", 0, 8, (ln, n) => {
      pair(ln, n, (c: Stream) => {
        sendAll(c, fromString("0123456789"), 1000);
      }, (s: Stream) => {
        let rd = new StreamReader(64);
        rd.unread(fromString("xx"));
        assertEqString(fillKind(rd.readUntil(s, fromString("\n"), 4, 500)), "limit", "no delimiter within 4 bytes");
        assertEqUsize(rd.buffered().length(), 4, "two bytes were already buffered, so only two more were received");
      });
    });
    assert(l.isOk(), "listener");
  });
}

@Test
function readUntilDeadline(host: Host): void {
  useNet(host, net => {
    const l = useListenerNet(net, "127.0.0.1", 0, 8, (ln, n) => {
      pair(ln, n, (c: Stream) => {
        sendAll(c, fromString("abc"), 1000);
      }, (s: Stream) => {
        let rd = new StreamReader(64);
        const t0 = nowMillis(s);
        assertEqString(fillKind(rd.readUntil(s, fromString("\n"), 64, 150)), "timeout", "the delimiter never comes");
        const dt = nowMillis(s) - t0;
        assert(dt >= 120 && dt < 3000, "readUntil honours its deadline: " + dt.toString());
        assertEqUsize(rd.buffered().length(), 3, "the bytes that did arrive stay buffered");
      });
    });
    assert(l.isOk(), "listener");
  });
}
