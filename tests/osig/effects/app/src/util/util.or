// Recursion and mutual recursion without effects: a fixed point, and pure.
export function fact(n: int): int {
  return n <= 1 ? 1 : n * fact(n - 1);
}

export function even(n: int): bool {
  return n == 0 ? true : odd(n - 1);
}

function odd(n: int): bool {
  return n == 0 ? false : even(n - 1);
}
