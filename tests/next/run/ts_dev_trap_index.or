// exit: 101
// Orin for TypeScript developers: out-of-bounds a[i] traps (TypeScript gives undefined); get() returns Option.
function main(): void {
  const a = [10, 20];
  const i: usize = 5;
  match (a.get(i)) {
    Some(v) => { console.log(`${v}`); },
    None => { console.log("none"); },
  }
  console.log(`${a[i]}`);
}
