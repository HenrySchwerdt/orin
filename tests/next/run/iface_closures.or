// Interface values captured by closures, and the array API over Shape[].
interface Shape {
  area(): int;
}

class Sq implements Shape {
  constructor(public s: int) {}
  area(): int { return this.s * this.s; }
}

class Rc implements Shape {
  constructor(public w: int, public h: int) {}
  area(): int { return this.w * this.h; }
}

function main(): void {
  const shapes: Shape[] = [new Sq(1), new Rc(2, 3), new Sq(3), new Rc(1, 1)];
  const areas = shapes.map(s => s.area());
  console.log(areas.map(a => a.toString()).join(","));
  const big = shapes.filter(s => s.area() > 1);
  console.log(big.length.toString());
  const total = shapes.reduce((acc: int, s) => acc + s.area(), 0);
  console.log(total.toString());
  const first: Shape = shapes[1];
  const f = (k: int): int => first.area() * k;
  console.log(f(10).toString());
  const sorted = shapes.sort((a, b) => b.area() - a.area());
  console.log(sorted[0].area().toString() + sorted[3].area().toString());
}
