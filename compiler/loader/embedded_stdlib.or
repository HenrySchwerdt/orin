  out.push(SourceFile { path: "$stdlib/bytes.or", text: "// std:bytes -- immutable byte sequences, a byte builder and a bounds-checked byte reader (ADR-0030 \xc2\xa73,\n// layer \"bytes and text\"). Pure safe Orin: no C, no new built-ins.\n//\n// Representation. A byte is a `u8`. `Bytes` is a view `data[start .. start + len)` of a `u8[]`; arrays are\n// copy-on-write values, so a `Bytes` never changes and `slice` is O(1) (the storage is shared, nothing is\n// copied until somebody mutates it, and nobody can: the fields are private and `Bytes` has no mutating\n// method). The runtime stores a `u8` array element in 8 bytes (ADR-0022); strings are the compact form and\n// `toRawString` / `bytesFromString` convert byte for byte in O(n).\n//\n// Contract standard (ADR-0030 \xc2\xa73). Every class carries an `@Invariant` that the checked build\n// (`orin test`, `--check-contracts`) verifies after every public method; every public method states\n// `@Requires` / `@Ensures`; helpers used in contracts are loops, not closures, and never call themselves.\n// Reads never trap: `ByteReader` returns `Err(ReadError)` when fewer bytes remain than requested, and the\n// cursor is left where it was.\n//\n// Complexity: n = number of bytes involved. `length`, `get`, `at`, `slice`, `trySlice` O(1); `concat`, `equals`,\n// `startsWith`, `indexOf`, `toArray`, `toRawString`, `toHex` O(n); `ByteBuilder.append*` amortised O(1) per byte;\n// `ByteReader.read*` O(1) per byte read (`readExact` O(n): it copies nothing, it slices).\n\n// ---------------------------------------------------------------------------------------------- Bytes\n\n// Is every element of `xs` a valid byte (0..255)? Loop-based so that contracts can use it.\nexport function allBytes(xs: int[]): bool {\n  let i: usize = 0;\n  while (i < xs.length) {\n    if (xs[i] < 0 || xs[i] > 255) {\n      return false;\n    }\n    i += 1;\n  }\n  return true;\n}\n\n// An immutable sequence of bytes: the view data[start .. start + len).\n@Invariant(this.start + this.len <= this.data.length)\nexport class Bytes {\n  private data: u8[];\n  private start: usize;\n  private len: usize;\n\n  // new Bytes(data, start, len): the view of `len` bytes of `data` from `start`. Most code uses\n  // `bytesFromArray` / `bytesFromString` / `emptyBytes` instead.\n  @Requires(start + len <= data.length)\n  constructor(data: u8[], start: usize, len: usize) {\n    this.data = data;\n    this.start = start;\n    this.len = len;\n  }\n\n  // length(): number of bytes. O(1).\n  @Ensures(result == this.len)\n  length(): usize {\n    return this.len;\n  }\n\n  // isEmpty(): true when there are no bytes. O(1).\n  @Ensures(result == (this.length() == 0))\n  isEmpty(): bool {\n    return this.len == 0;\n  }\n\n  // get(i): the byte at index i, or None when i >= length(). Never traps. O(1).\n  @Ensures(result.isSome() == (i < this.len))\n  get(i: usize): Option<u8> {\n    if (i >= this.len) {\n      return None;\n    }\n    return Some(this.data[this.start + i]);\n  }\n\n  // at(i): the byte at index i. Precondition i < length(). O(1).\n  @Requires(i < this.len)\n  at(i: usize): u8 {\n    return this.data[this.start + i];\n  }\n\n  // slice(lo, hi): the bytes [lo, hi). Shares storage with the receiver. O(1).\n  @Requires(lo <= hi && hi <= this.len)\n  @Ensures(result.length() == hi - lo)\n  @Ensures(hi > lo ==> result.at(0) == this.at(lo) && result.at(hi - lo - 1) == this.at(hi - 1))\n  slice(lo: usize, hi: usize): Bytes {\n    return new Bytes(this.data, this.start + lo, hi - lo);\n  }\n\n  // trySlice(lo, hi): `slice` that answers None instead of requiring lo <= hi <= length(). O(1).\n  @Ensures(result.isSome() == (lo <= hi && hi <= this.len))\n  @Ensures(result.isSome() ==> result.unwrap().length() == hi - lo)\n  trySlice(lo: usize, hi: usize): Option<Bytes> {\n    if (lo > hi || hi > this.len) {\n      return None;\n    }\n    return Some(this.slice(lo, hi));\n  }\n\n  // concat(other): this followed by other. O(length() + other.length()).\n  @Ensures(result.length() == this.len + other.length())\n  @Ensures(this.len > 0 ==> result.at(0) == this.at(0))\n  @Ensures(other.length() > 0 ==> result.at(this.len) == other.at(0))\n  @Ensures(other.length() > 0 ==> result.at(this.len + other.length() - 1) == other.at(other.length() - 1))\n  concat(other: Bytes): Bytes {\n    let out: u8[] = [];\n    let i: usize = 0;\n    while (i < this.len) {\n      out.push(this.data[this.start + i]);\n      i += 1;\n    }\n    let j: usize = 0;\n    while (j < other.length()) {\n      out.push(other.at(j));\n      j += 1;\n    }\n    return new Bytes(out, 0, out.length);\n  }\n\n  // equals(other): same length and same bytes. O(n).\n  @Ensures(result ==> this.len == other.length())\n  @Ensures(this.len != other.length() ==> !result)\n  equals(other: Bytes): bool {\n    if (this.len != other.length()) {\n      return false;\n    }\n    let i: usize = 0;\n    while (i < this.len) {\n      if (this.data[this.start + i] != other.at(i)) {\n        return false;\n      }\n      i += 1;\n    }\n    return true;\n  }\n\n  // startsWith(prefix): the first prefix.length() bytes equal `prefix`. O(prefix.length()).\n  @Ensures(result ==> prefix.length() <= this.len)\n  @Ensures(prefix.length() == 0 ==> result)\n  startsWith(prefix: Bytes): bool {\n    if (prefix.length() > this.len) {\n      return false;\n    }\n    let i: usize = 0;\n    while (i < prefix.length()) {\n      if (this.data[this.start + i] != prefix.at(i)) {\n        return false;\n      }\n      i += 1;\n    }\n    return true;\n  }\n\n  // indexOf(b): the first index holding byte b, or None. O(n).\n  @Ensures(result.isSome() ==> result.unwrap() < this.len && this.at(result.unwrap()) == b)\n  indexOf(b: u8): Option<usize> {\n    let i: usize = 0;\n    while (i < this.len) {\n      if (this.data[this.start + i] == b) {\n        return Some(i);\n      }\n      i += 1;\n    }\n    return None;\n  }\n\n  // toArray(): a copy of the bytes. O(n).\n  @Ensures(result.length == this.len)\n  toArray(): u8[] {\n    return this.data.slice(this.start, this.start + this.len);\n  }\n\n  // storage(): the array the view reads, without a copy: byte i of the view is `storage()[storageStart() + i]`. For\n  // byte loops that would otherwise call `at` per byte (a call and a reference count each) or copy with `toArray`.\n  // Arrays are values, so the caller cannot change the view through it. O(1).\n  @Ensures(result.length >= this.start + this.len)\n  @Ensures(this.len > 0 ==> result[this.start] == this.at(0) && result[this.start + this.len - 1] == this.at(this.len - 1))\n  storage(): u8[] {\n    return this.data;\n  }\n\n  // storageStart(): the index in `storage()` of the first byte of the view. O(1).\n  @Ensures(result == this.start && result + this.len <= this.storage().length)\n  storageStart(): usize {\n    return this.start;\n  }\n\n  // toRawString(): the same bytes as a string. No validation: the string holds arbitrary bytes (use\n  // `std:utf8` to get text). Inverse of `bytesFromString`. O(n).\n  @Ensures(result.length == this.len)\n  toRawString(): string {\n    return bytesToString(this.data, this.start, this.len);\n  }\n\n  // toHex(): lower-case hexadecimal, two digits per byte. O(n).\n  @Ensures(result.length == 2 * this.len)\n  toHex(): string {\n    let out = \"\";\n    let i: usize = 0;\n    while (i < this.len) {\n      const b = this.data[this.start + i].toInt();\n      out += hexDigit(b / 16);\n      out += hexDigit(b % 16);\n      i += 1;\n    }\n    return out;\n  }\n}\n\n@Requires(d >= 0 && d < 16)\n@Ensures(result.length == 1)\nfunction hexDigit(d: int): string {\n  return \"0123456789abcdef\".charAt(d.toUsize());\n}\n\n// The value of a hexadecimal digit character code, or -1.\n@Ensures(result >= -1 && result < 16)\nfunction hexValue(c: int): int {\n  if (c >= 48 && c <= 57) {\n    return c - 48;\n  }\n  if (c >= 97 && c <= 102) {\n    return c - 87;\n  }\n  if (c >= 65 && c <= 70) {\n    return c - 55;\n  }\n  return -1;\n}\n\n// emptyBytes(): no bytes. O(1).\n@Ensures(result.length() == 0)\nexport function emptyBytes(): Bytes {\n  return new Bytes([], 0, 0);\n}\n\n// bytesFromArray(xs): the bytes of `xs` (the array is shared, not copied). O(1).\n@Ensures(result.length() == xs.length)\nexport function bytesFromArray(xs: u8[]): Bytes {\n  return new Bytes(xs, 0, xs.length);\n}\n\n// bytesFromInts(xs): bytes from integers; every element must lie in 0..255. O(n).\n@Requires(allBytes(xs))\n@Ensures(result.length() == xs.length)\nexport function bytesFromInts(xs: int[]): Bytes {\n  let out: u8[] = [];\n  let i: usize = 0;\n  while (i < xs.length) {\n    out.push(xs[i].toU8());\n    i += 1;\n  }\n  return new Bytes(out, 0, out.length);\n}\n\n// bytesFromString(s): the bytes of a string, one per string byte (no encoding step). O(n).\n@Ensures(result.length() == s.length)\nexport function bytesFromString(s: string): Bytes {\n  const out = stringToBytes(s);\n  return new Bytes(out, 0, out.length);\n}\n\n// bytesFromHex(s): decodes pairs of hex digits (either case); None for an odd length or a non-hex character. O(n).\n@Ensures(result.isSome() ==> result.unwrap().length() * 2 == s.length)\n@Ensures(s.length % 2 == 1 ==> result.isNone())\nexport function bytesFromHex(s: string): Option<Bytes> {\n  if (s.length % 2 == 1) {\n    return None;\n  }\n  let out: u8[] = [];\n  let i: usize = 0;\n  while (i < s.length) {\n    const hi = hexValue(s.charCodeAt(i));\n    const lo = hexValue(s.charCodeAt(i + 1));\n    if (hi < 0 || lo < 0) {\n      return None;\n    }\n    out.push((hi * 16 + lo).toU8());\n    i += 2;\n  }\n  return Some(new Bytes(out, 0, out.length));\n}\n\n// ----------------------------------------------------------------------------------------- ByteBuilder\n\n// Strings up to this length are appended by `ByteBuilder.appendString` byte by byte; longer ones in one block.\nconst SHORT_STRING: usize = 64;\n\n// A growable byte buffer. `capacity` is bookkeeping for `reserve` (the runtime has no array reserve: the array\n// still grows geometrically on `push`); the invariant ties it to the length.\n@Invariant(this.capacity >= this.data.length)\nexport class ByteBuilder {\n  private data: u8[] = [];\n  private capacity: usize = 0;\n\n  // length(): number of bytes appended so far. O(1).\n  @Ensures(result == this.data.length)\n  length(): usize {\n    return this.data.length;\n  }\n\n  // capacity(): the number of bytes that fit without a reservation being exceeded; never below length(). O(1).\n  @Ensures(result == this.capacity)\n  reserved(): usize {\n    return this.capacity;\n  }\n\n  // byteAt(i): the byte at index i. Precondition i < length(). O(1).\n  @Requires(i < this.data.length)\n  byteAt(i: usize): u8 {\n    return this.data[i];\n  }\n\n  // reserve(extra): room for `extra` more bytes. The contents do not change. O(1).\n  @Ensures(this.length() == old(this.length()))\n  @Ensures(this.reserved() >= this.length() + extra)\n  reserve(extra: usize): void {\n    if (this.capacity < this.data.length + extra) {\n      this.capacity = this.data.length + extra;\n    }\n  }\n\n  private grew(): void {\n    if (this.capacity < this.data.length) {\n      this.capacity = this.data.length;\n    }\n  }\n\n  // appendU8(v): one byte. Amortised O(1).\n  @Ensures(this.length() == old(this.length()) + 1)\n  @Ensures(this.byteAt(this.length() - 1) == v)\n  appendU8(v: u8): void {\n    this.data.push(v);\n    this.grew();\n  }\n\n  // appendU16be(v): two bytes, most significant first. O(1).\n  @Ensures(this.length() == old(this.length()) + 2)\n  @Ensures(this.byteAt(this.length() - 2).toInt() == v.toInt() / 256)\n  @Ensures(this.byteAt(this.length() - 1).toInt() == v.toInt() % 256)\n  appendU16be(v: u16): void {\n    const n = v.toInt();\n    this.data.push((n / 256).toU8());\n    this.data.push((n % 256).toU8());\n    this.grew();\n  }\n\n  // appendU16le(v): two bytes, least significant first. O(1).\n  @Ensures(this.length() == old(this.length()) + 2)\n  @Ensures(this.byteAt(this.length() - 2).toInt() == v.toInt() % 256)\n  @Ensures(this.byteAt(this.length() - 1).toInt() == v.toInt() / 256)\n  appendU16le(v: u16): void {\n    const n = v.toInt();\n    this.data.push((n % 256).toU8());\n    this.data.push((n / 256).toU8());\n    this.grew();\n  }\n\n  // appendU32be(v): four bytes, most significant first. O(1).\n  @Ensures(this.length() == old(this.length()) + 4)\n  @Ensures(this.byteAt(this.length() - 4).toInt() == v.toInt() / 16777216)\n  @Ensures(this.byteAt(this.length() - 1).toInt() == v.toInt() % 256)\n  appendU32be(v: u32): void {\n    const n = v.toInt();\n    this.data.push((n / 16777216).toU8());\n    this.data.push(((n / 65536) % 256).toU8());\n    this.data.push(((n / 256) % 256).toU8());\n    this.data.push((n % 256).toU8());\n    this.grew();\n  }\n\n  // appendU32le(v): four bytes, least significant first. O(1).\n  @Ensures(this.length() == old(this.length()) + 4)\n  @Ensures(this.byteAt(this.length() - 4).toInt() == v.toInt() % 256)\n  @Ensures(this.byteAt(this.length() - 1).toInt() == v.toInt() / 16777216)\n  appendU32le(v: u32): void {\n    const n = v.toInt();\n    this.data.push((n % 256).toU8());\n    this.data.push(((n / 256) % 256).toU8());\n    this.data.push(((n / 65536) % 256).toU8());\n    this.data.push((n / 16777216).toU8());\n    this.grew();\n  }\n\n  // appendBytes(b): all bytes of `b`. O(b.length()). A view of a whole array is appended in one step (the buffer is\n  // extended in place); a partial view is copied from its storage in a plain loop: no call and no reference count per\n  // byte, no temporary array.\n  @Ensures(this.length() == old(this.length()) + b.length())\n  @Ensures(b.length() > 0 ==> this.byteAt(this.length() - b.length()) == b.at(0))\n  @Ensures(b.length() > 0 ==> this.byteAt(this.length() - 1) == b.at(b.length() - 1))\n  appendBytes(b: Bytes): void {\n    const src = b.storage();\n    const s0 = b.storageStart();\n    const n = b.length();\n    if (s0 == 0 && n == src.length) {\n      this.data = this.data.concat(src);\n    } else {\n      let i: usize = 0;\n      while (i < n) {\n        this.data.push(src[s0 + i]);\n        i += 1;\n      }\n    }\n    this.grew();\n  }\n\n  // appendString(s): the bytes of `s` (no encoding step). O(s.length). A short string is appended byte by byte (no\n  // temporary array); a long one through one temporary array and an in-place extension.\n  @Ensures(this.length() == old(this.length()) + s.length)\n  @Ensures(s.length > 0 ==> this.byteAt(this.length() - s.length).toInt() == s.charCodeAt(0))\n  @Ensures(s.length > 0 ==> this.byteAt(this.length() - 1).toInt() == s.charCodeAt(s.length - 1))\n  appendString(s: string): void {\n    if (s.length <= SHORT_STRING) {\n      let i: usize = 0;\n      while (i < s.length) {\n        this.data.push(s.charCodeAt(i).toU8());\n        i += 1;\n      }\n    } else {\n      this.data = this.data.concat(stringToBytes(s));\n    }\n    this.grew();\n  }\n\n  // clear(): remove all bytes; the reservation stays. O(1).\n  @Ensures(this.length() == 0)\n  @Ensures(this.reserved() == old(this.reserved()))\n  clear(): void {\n    this.data = [];\n  }\n\n  // build(): the bytes appended so far as an immutable `Bytes`; the builder stays usable. O(1) (shares storage).\n  @Ensures(result.length() == this.data.length)\n  build(): Bytes {\n    return new Bytes(this.data, 0, this.data.length);\n  }\n}\n\n// ----------------------------------------------------------------------------------------- ByteReader\n\n// Why a read failed: at `position` the reader needed `needed` bytes but only `remaining` were left.\nexport type ReadError = { position: usize; needed: usize; remaining: usize; };\n\n// readErrorMessage(e): \"unexpected end of input at byte 3: needed 4 bytes, 1 remaining\". O(1).\n@Ensures(result.length > 0)\nexport function readErrorMessage(e: ReadError): string {\n  return `unexpected end of input at byte ${e.position.toString()}: needed ${e.needed.toString()} bytes, ${e.remaining.toString()} remaining`;\n}\n\n// A cursor over a `Bytes`. Invariant: the cursor never passes the end, so `remaining()` cannot underflow and\n// every successful read is in bounds. A failed read changes nothing.\n@Invariant(this.pos <= this.src.length())\nexport class ByteReader {\n  private src: Bytes;\n  private pos: usize = 0;\n\n  constructor(src: Bytes) {\n    this.src = src;\n  }\n\n  // position(): index of the next byte to read. O(1).\n  @Ensures(result <= this.src.length())\n  position(): usize {\n    return this.pos;\n  }\n\n  // remaining(): number of unread bytes. O(1).\n  @Ensures(result + this.pos == this.src.length())\n  remaining(): usize {\n    return this.src.length() - this.pos;\n  }\n\n  // isAtEnd(): no unread bytes. O(1).\n  @Ensures(result == (this.remaining() == 0))\n  isAtEnd(): bool {\n    return this.pos == this.src.length();\n  }\n\n  // peekAt(offset): the unread byte `offset` positions ahead (0 = next), without moving. None past the end. O(1).\n  @Ensures(result.isSome() == (offset < this.remaining()))\n  peekAt(offset: usize): Option<u8> {\n    return this.src.get(this.pos + offset);\n  }\n\n  private shortRead(n: usize): ReadError {\n    return ReadError { position: this.pos, needed: n, remaining: this.src.length() - this.pos };\n  }\n\n  // readU8(): the next byte. Err when no byte is left (cursor unchanged). O(1).\n  @Ensures(result.isOk() == (old(this.remaining()) >= 1))\n  @Ensures(result.isOk() ==> this.position() == old(this.position()) + 1)\n  @Ensures(result.isErr() ==> this.position() == old(this.position()))\n  @Ensures(result.isOk() ==> result.unwrap() == old(this.peekAt(0).unwrapOr(0)))\n  @Ensures(result.isErr() ==> result.unwrapErr().needed == 1 && result.unwrapErr().remaining == old(this.remaining()))\n  readU8(): Result<u8, ReadError> {\n    if (this.src.length() - this.pos < 1) {\n      return Err(this.shortRead(1));\n    }\n    const v = this.src.at(this.pos);\n    this.pos += 1;\n    return Ok(v);\n  }\n\n  // readU16be(): the next two bytes as a big-endian u16. Err when fewer than 2 remain (cursor unchanged). O(1).\n  @Ensures(result.isOk() == (old(this.remaining()) >= 2))\n  @Ensures(result.isOk() ==> this.position() == old(this.position()) + 2)\n  @Ensures(result.isErr() ==> this.position() == old(this.position()))\n  @Ensures(result.isOk() ==> result.unwrap().toInt() == old(this.peekAt(0).unwrapOr(0)).toInt() * 256 + old(this.peekAt(1).unwrapOr(0)).toInt())\n  readU16be(): Result<u16, ReadError> {\n    if (this.src.length() - this.pos < 2) {\n      return Err(this.shortRead(2));\n    }\n    const a = this.src.at(this.pos).toInt();\n    const b = this.src.at(this.pos + 1).toInt();\n    this.pos += 2;\n    return Ok((a * 256 + b).toU16());\n  }\n\n  // readU16le(): the next two bytes as a little-endian u16. Err when fewer than 2 remain (cursor unchanged). O(1).\n  @Ensures(result.isOk() == (old(this.remaining()) >= 2))\n  @Ensures(result.isOk() ==> this.position() == old(this.position()) + 2)\n  @Ensures(result.isErr() ==> this.position() == old(this.position()))\n  @Ensures(result.isOk() ==> result.unwrap().toInt() == old(this.peekAt(1).unwrapOr(0)).toInt() * 256 + old(this.peekAt(0).unwrapOr(0)).toInt())\n  readU16le(): Result<u16, ReadError> {\n    if (this.src.length() - this.pos < 2) {\n      return Err(this.shortRead(2));\n    }\n    const a = this.src.at(this.pos).toInt();\n    const b = this.src.at(this.pos + 1).toInt();\n    this.pos += 2;\n    return Ok((b * 256 + a).toU16());\n  }\n\n  // readU32be(): the next four bytes as a big-endian u32. Err when fewer than 4 remain (cursor unchanged). O(1).\n  @Ensures(result.isOk() == (old(this.remaining()) >= 4))\n  @Ensures(result.isOk() ==> this.position() == old(this.position()) + 4)\n  @Ensures(result.isErr() ==> this.position() == old(this.position()))\n  @Ensures(result.isOk() ==> result.unwrap().toInt() / 16777216 == old(this.peekAt(0).unwrapOr(0)).toInt())\n  @Ensures(result.isOk() ==> result.unwrap().toInt() % 256 == old(this.peekAt(3).unwrapOr(0)).toInt())\n  readU32be(): Result<u32, ReadError> {\n    if (this.src.length() - this.pos < 4) {\n      return Err(this.shortRead(4));\n    }\n    const a = this.src.at(this.pos).toInt();\n    const b = this.src.at(this.pos + 1).toInt();\n    const c = this.src.at(this.pos + 2).toInt();\n    const d = this.src.at(this.pos + 3).toInt();\n    this.pos += 4;\n    return Ok((((a * 256 + b) * 256 + c) * 256 + d).toU32());\n  }\n\n  // readU32le(): the next four bytes as a little-endian u32. Err when fewer than 4 remain (cursor unchanged). O(1).\n  @Ensures(result.isOk() == (old(this.remaining()) >= 4))\n  @Ensures(result.isOk() ==> this.position() == old(this.position()) + 4)\n  @Ensures(result.isErr() ==> this.position() == old(this.position()))\n  @Ensures(result.isOk() ==> result.unwrap().toInt() / 16777216 == old(this.peekAt(3).unwrapOr(0)).toInt())\n  @Ensures(result.isOk() ==> result.unwrap().toInt() % 256 == old(this.peekAt(0).unwrapOr(0)).toInt())\n  readU32le(): Result<u32, ReadError> {\n    if (this.src.length() - this.pos < 4) {\n      return Err(this.shortRead(4));\n    }\n    const a = this.src.at(this.pos).toInt();\n    const b = this.src.at(this.pos + 1).toInt();\n    const c = this.src.at(this.pos + 2).toInt();\n    const d = this.src.at(this.pos + 3).toInt();\n    this.pos += 4;\n    return Ok((((d * 256 + c) * 256 + b) * 256 + a).toU32());\n  }\n\n  // readExact(n): the next n bytes (a slice sharing storage, no copy). Err when fewer than n remain (cursor\n  // unchanged). O(1).\n  @Ensures(result.isOk() == (old(this.remaining()) >= n))\n  @Ensures(result.isOk() ==> result.unwrap().length() == n && this.position() == old(this.position()) + n)\n  @Ensures(result.isErr() ==> this.position() == old(this.position()))\n  readExact(n: usize): Result<Bytes, ReadError> {\n    if (this.src.length() - this.pos < n) {\n      return Err(this.shortRead(n));\n    }\n    const out = this.src.slice(this.pos, this.pos + n);\n    this.pos += n;\n    return Ok(out);\n  }\n\n  // skip(n): advance n bytes. Err when fewer than n remain (cursor unchanged). O(1).\n  @Ensures(result.isOk() == (old(this.remaining()) >= n))\n  @Ensures(result.isOk() ==> this.position() == old(this.position()) + n)\n  @Ensures(result.isErr() ==> this.position() == old(this.position()))\n  skip(n: usize): Result<void, ReadError> {\n    if (this.src.length() - this.pos < n) {\n      return Err(this.shortRead(n));\n    }\n    this.pos += n;\n    return Ok();\n  }\n\n  // rest(): all unread bytes as a slice; the cursor moves to the end. O(1).\n  @Ensures(this.isAtEnd() && result.length() == old(this.remaining()))\n  rest(): Bytes {\n    const out = this.src.slice(this.pos, this.src.length());\n    this.pos = this.src.length();\n    return out;\n  }\n}\n" });
  out.push(SourceFile { path: "$stdlib/collections.or", text: "// std:collections -- sets, a ring-buffer deque, sorted maps and a priority queue (ADR-0030 \xc2\xa73, layer\n// \"collections\"). Pure safe Orin on top of arrays and `Map`; no C, no new built-ins.\n//\n// What is generic and what is not (language limits, see docs/std.md \"Limitations\"):\n//   * `Map<K, V>` keys must be `int`, `usize`, `bool` or `string` *concretely* (E0400 for a type parameter), and\n//     there is no `==`, `<` or hash on a type parameter. So the sets and sorted maps are specialised by key:\n//     `IntSet` / `StringSet`, `SortedMap<V>` (int keys) / `SortedStringMap<V>` (string keys). The values and\n//     the elements of `Deque<T>` and `PriorityQueue<T>` are fully generic.\n//   * A contract cannot call a function value (E0416), so a comparator closure could not appear in the heap\n//     invariant. `PriorityQueue<T>` therefore orders by an explicit `int` priority given to `push`.\n//   * Because `==` does not exist on a type parameter, the contracts of the generic containers state sizes,\n//     membership, ordering of keys/priorities and presence, but not \"the value that comes back is the one that\n//     was put in\" (that needs equality on `V` / `T`). The tests check values with `int` instances and against a\n//     naive reference model.\n//\n// Contract standard (ADR-0030 \xc2\xa73): every class has `@Invariant`s that `--check-contracts` / `orin test` verify\n// after every public method, and every public method states `@Requires` / `@Ensures`. Helpers that contracts call\n// are loops (no closures, no recursion). All classes are values with copy-on-write storage like every class.\n//\n// Complexity summary (n = size, t = B-tree minimum degree, default choice 16):\n//   IntSet / StringSet        has, add, remove expected O(1) (the prelude's open-addressing hash map); union O(n + m),\n//                             intersection O(min(n, m)), difference and isSubsetOf O(n)\n//   Deque<T>                  pushFront/pushBack/popFront/popBack/get/front/back amortised O(1); toArray O(n)\n//   SortedMap / SortedStringMap  B-tree in an arena: has/get/put/remove/floorKey/ceilKey/firstKey/lastKey/popFirst/\n//                             popLast all O(t log_t n) = O(log n); keyArray/valueArray O(n); size O(1)\n//   PriorityQueue<T>          4-ary heap: push, pop O(log n); peek, minPriority, size O(1)\n// Each choice was compared with the simpler alternative it replaces (numbers in docs/std.md): B-tree vs sorted\n// array 31 ms vs 1782 ms for 20,000 random inserts + lookups + removals; 4-ary struct-of-arrays heap vs boxed binary\n// heap 122 ms vs 300 ms; table-driven UTF-8 validator vs per-sequence decoder 5 ms vs 82 ms per MB; plain-slot ring\n// vs `Option` slots 84 ms vs 128 ms.\n\n// ---------------------------------------------------------------------------------------------- helpers\n\n// allTrue(xs): every element is true. Loop-based (contracts cannot use `every`).\nexport function allTrue(xs: bool[]): bool {\n  let i: usize = 0;\n  while (i < xs.length) {\n    if (!xs[i]) {\n      return false;\n    }\n    i += 1;\n  }\n  return true;\n}\n\n// isStrictlyIncreasing(xs): xs[0] < xs[1] < ... (so sorted and without duplicates).\nexport function isStrictlyIncreasing(xs: int[]): bool {\n  let i: usize = 1;\n  while (i < xs.length) {\n    if (xs[i - 1] >= xs[i]) {\n      return false;\n    }\n    i += 1;\n  }\n  return true;\n}\n\n// compareStrings(a, b): -1, 0 or 1; byte-wise lexicographic order (shorter prefix first), the order of\n// `SortedStringMap`. O(min(a.length, b.length)).\n@Ensures(result >= -1 && result <= 1)\n@Ensures((result == 0) == (a.length == b.length && !differsAt(a, b)))\nexport function compareStrings(a: string, b: string): int {\n  const n = a.length < b.length ? a.length : b.length;\n  let i: usize = 0;\n  while (i < n) {\n    const x = a.charCodeAt(i);\n    const y = b.charCodeAt(i);\n    if (x < y) {\n      return -1;\n    }\n    if (x > y) {\n      return 1;\n    }\n    i += 1;\n  }\n  if (a.length < b.length) {\n    return -1;\n  }\n  if (a.length > b.length) {\n    return 1;\n  }\n  return 0;\n}\n\n// Does some byte inside the common length differ?\nfunction differsAt(a: string, b: string): bool {\n  const n = a.length < b.length ? a.length : b.length;\n  let i: usize = 0;\n  while (i < n) {\n    if (a.charCodeAt(i) != b.charCodeAt(i)) {\n      return true;\n    }\n    i += 1;\n  }\n  return false;\n}\n\n// isStrictlyIncreasingStrings(xs): compareStrings(xs[i-1], xs[i]) < 0 for all i.\nexport function isStrictlyIncreasingStrings(xs: string[]): bool {\n  let i: usize = 1;\n  while (i < xs.length) {\n    if (compareStrings(xs[i - 1], xs[i]) >= 0) {\n      return false;\n    }\n    i += 1;\n  }\n  return true;\n}\n\n// ------------------------------------------------------------------------------------------ IntSet\n\n// A set of ints on top of `Map<int, bool>`. Invariants: the map's size matches its key list and every stored flag\n// is true (a key is a member exactly when it is in the map).\n@Invariant(this.items.size == this.items.keys().length)\n@Invariant(allTrue(this.items.values()))\nexport class IntSet {\n  private items: Map<int, bool> = new Map<int, bool>();\n\n  // size(): number of members. O(1).\n  @Ensures(result == this.items.keys().length)\n  size(): usize {\n    return this.items.size;\n  }\n\n  // isEmpty(): no members. O(1).\n  @Ensures(result == (this.size() == 0))\n  isEmpty(): bool {\n    return this.items.size == 0;\n  }\n\n  // has(x): is x a member? Expected O(1).\n  @Ensures(result ==> this.size() > 0)\n  has(x: int): bool {\n    return this.items.has(x);\n  }\n\n  // add(x): insert x; true when it was not a member (the size grows by 1), false when it already was. Expected O(1).\n  @Ensures(this.has(x))\n  @Ensures(result == !old(this.has(x)))\n  @Ensures(result ==> this.size() == old(this.size()) + 1)\n  @Ensures(!result ==> this.size() == old(this.size()))\n  add(x: int): bool {\n    if (this.items.has(x)) {\n      return false;\n    }\n    this.items.set(x, true);\n    return true;\n  }\n\n  // remove(x): delete x; true when it was a member (the size shrinks by 1). Expected O(1).\n  @Ensures(!this.has(x))\n  @Ensures(result == old(this.has(x)))\n  @Ensures(result ==> this.size() == old(this.size()) - 1)\n  @Ensures(!result ==> this.size() == old(this.size()))\n  remove(x: int): bool {\n    if (!this.items.has(x)) {\n      return false;\n    }\n    this.items.delete(x);\n    return true;\n  }\n\n  // clear(): remove all members. O(1).\n  @Ensures(this.size() == 0)\n  clear(): void {\n    this.items = new Map<int, bool>();\n  }\n\n  // toArray(): the members in insertion order (not sorted). O(n).\n  @Ensures(result.length == this.size())\n  toArray(): int[] {\n    return this.items.keys();\n  }\n\n  // isSubsetOf(other): every member of this is a member of other. O(n).\n  @Ensures(result ==> this.size() <= other.size())\n  @Ensures(this.size() == 0 ==> result)\n  isSubsetOf(other: IntSet): bool {\n    if (this.items.size > other.size()) {\n      return false;\n    }\n    const xs = this.items.keys();\n    let i: usize = 0;\n    while (i < xs.length) {\n      if (!other.has(xs[i])) {\n        return false;\n      }\n      i += 1;\n    }\n    return true;\n  }\n\n  // union(other): the members of either. O(n + m).\n  @Ensures(this.isSubsetOf(result) && other.isSubsetOf(result))\n  @Ensures(result.size() >= this.size() && result.size() <= this.size() + other.size())\n  union(other: IntSet): IntSet {\n    // start from the larger set (a copy-on-write value copy) and insert only the smaller one's members\n    let out = this;\n    let small = other;\n    if (other.size() > this.items.size) {\n      out = other;\n      small = this;\n    }\n    const xs = small.toArray();\n    let i: usize = 0;\n    while (i < xs.length) {\n      out.add(xs[i]);\n      i += 1;\n    }\n    return out;\n  }\n\n  // intersection(other): the members of both. O(n).\n  @Ensures(result.isSubsetOf(this) && result.isSubsetOf(other))\n  @Ensures(result.size() <= this.size() && result.size() <= other.size())\n  intersection(other: IntSet): IntSet {\n    // walk the smaller set and probe the larger one\n    let out = new IntSet();\n    const walk = this.items.size <= other.size() ? this : other;\n    const probe = this.items.size <= other.size() ? other : this;\n    const xs = walk.toArray();\n    let i: usize = 0;\n    while (i < xs.length) {\n      if (probe.has(xs[i])) {\n        out.add(xs[i]);\n      }\n      i += 1;\n    }\n    return out;\n  }\n\n  // difference(other): the members of this that are not in other. O(n).\n  @Ensures(result.isSubsetOf(this))\n  @Ensures(result.intersection(other).isEmpty())\n  @Ensures(result.size() + this.intersection(other).size() == this.size())\n  difference(other: IntSet): IntSet {\n    let out = new IntSet();\n    const xs = this.items.keys();\n    let i: usize = 0;\n    while (i < xs.length) {\n      if (!other.has(xs[i])) {\n        out.add(xs[i]);\n      }\n      i += 1;\n    }\n    return out;\n  }\n}\n\n// --------------------------------------------------------------------------------------- StringSet\n\n// A set of strings on top of `Map<string, bool>`; same invariants as `IntSet`.\n@Invariant(this.items.size == this.items.keys().length)\n@Invariant(allTrue(this.items.values()))\nexport class StringSet {\n  private items: Map<string, bool> = new Map<string, bool>();\n\n  // size(): number of members. O(1).\n  @Ensures(result == this.items.keys().length)\n  size(): usize {\n    return this.items.size;\n  }\n\n  // isEmpty(): no members. O(1).\n  @Ensures(result == (this.size() == 0))\n  isEmpty(): bool {\n    return this.items.size == 0;\n  }\n\n  // has(x): is x a member? Expected O(1 + |x|).\n  @Ensures(result ==> this.size() > 0)\n  has(x: string): bool {\n    return this.items.has(x);\n  }\n\n  // add(x): insert x; true when it was not a member (the size grows by 1). Expected O(1 + |x|).\n  @Ensures(this.has(x))\n  @Ensures(result == !old(this.has(x)))\n  @Ensures(result ==> this.size() == old(this.size()) + 1)\n  @Ensures(!result ==> this.size() == old(this.size()))\n  add(x: string): bool {\n    if (this.items.has(x)) {\n      return false;\n    }\n    this.items.set(x, true);\n    return true;\n  }\n\n  // remove(x): delete x; true when it was a member (the size shrinks by 1). Expected O(1 + |x|).\n  @Ensures(!this.has(x))\n  @Ensures(result == old(this.has(x)))\n  @Ensures(result ==> this.size() == old(this.size()) - 1)\n  @Ensures(!result ==> this.size() == old(this.size()))\n  remove(x: string): bool {\n    if (!this.items.has(x)) {\n      return false;\n    }\n    this.items.delete(x);\n    return true;\n  }\n\n  // clear(): remove all members. O(1).\n  @Ensures(this.size() == 0)\n  clear(): void {\n    this.items = new Map<string, bool>();\n  }\n\n  // toArray(): the members in insertion order (not sorted). O(n).\n  @Ensures(result.length == this.size())\n  toArray(): string[] {\n    return this.items.keys();\n  }\n\n  // isSubsetOf(other): every member of this is a member of other. O(n).\n  @Ensures(result ==> this.size() <= other.size())\n  @Ensures(this.size() == 0 ==> result)\n  isSubsetOf(other: StringSet): bool {\n    if (this.items.size > other.size()) {\n      return false;\n    }\n    const xs = this.items.keys();\n    let i: usize = 0;\n    while (i < xs.length) {\n      if (!other.has(xs[i])) {\n        return false;\n      }\n      i += 1;\n    }\n    return true;\n  }\n\n  // union(other): the members of either. O(n + m).\n  @Ensures(this.isSubsetOf(result) && other.isSubsetOf(result))\n  @Ensures(result.size() >= this.size() && result.size() <= this.size() + other.size())\n  union(other: StringSet): StringSet {\n    // start from the larger set (a copy-on-write value copy) and insert only the smaller one's members\n    let out = this;\n    let small = other;\n    if (other.size() > this.items.size) {\n      out = other;\n      small = this;\n    }\n    const xs = small.toArray();\n    let i: usize = 0;\n    while (i < xs.length) {\n      out.add(xs[i]);\n      i += 1;\n    }\n    return out;\n  }\n\n  // intersection(other): the members of both. O(n).\n  @Ensures(result.isSubsetOf(this) && result.isSubsetOf(other))\n  @Ensures(result.size() <= this.size() && result.size() <= other.size())\n  intersection(other: StringSet): StringSet {\n    // walk the smaller set and probe the larger one\n    let out = new StringSet();\n    const walk = this.items.size <= other.size() ? this : other;\n    const probe = this.items.size <= other.size() ? other : this;\n    const xs = walk.toArray();\n    let i: usize = 0;\n    while (i < xs.length) {\n      if (probe.has(xs[i])) {\n        out.add(xs[i]);\n      }\n      i += 1;\n    }\n    return out;\n  }\n\n  // difference(other): the members of this that are not in other. O(n).\n  @Ensures(result.isSubsetOf(this))\n  @Ensures(result.intersection(other).isEmpty())\n  @Ensures(result.size() + this.intersection(other).size() == this.size())\n  difference(other: StringSet): StringSet {\n    let out = new StringSet();\n    const xs = this.items.keys();\n    let i: usize = 0;\n    while (i < xs.length) {\n      if (!other.has(xs[i])) {\n        out.add(xs[i]);\n      }\n      i += 1;\n    }\n    return out;\n  }\n}\n\n// --------------------------------------------------------------------------------------------- Deque\n\n// A double-ended queue on a ring buffer: `buf` has `capacity` slots (0 until the first push, then 4, 8, 16, ...),\n// the element number i from the front lives in slot (head + i) mod capacity, and the ring is unrolled into a\n// buffer of twice the size when it is full. Index arithmetic wraps by one conditional subtraction (no division).\n// The language has no uninitialised slot and no default value of a type parameter, so slots that are not live hold\n// `filler`, a copy of the first element ever pushed (a popped slot is overwritten with it, so at most that one\n// value is kept alive beyond its time). Earlier versions used `Option<T>` slots, which boxes every element and made\n// the invariant \"exactly the live slots are Some\" statable; measured on 500,000 push/pop rounds, plain slots take\n// 84 ms against 128 ms. What the invariants can still state without equality on T is the index discipline:\n// `len <= capacity`, `head` in range, and a filler exists exactly when there is storage.\n@Invariant(this.len <= this.buf.length)\n@Invariant(this.buf.length == 0 ? this.head == 0 : this.head < this.buf.length)\n@Invariant(this.filler.isSome() == (this.buf.length > 0))\nexport class Deque<T> {\n  private buf: T[] = [];\n  private head: usize = 0;\n  private len: usize = 0;\n  private filler: Option<T> = None;\n\n  // size(): number of elements. O(1).\n  @Ensures(result == this.len)\n  size(): usize {\n    return this.len;\n  }\n\n  // isEmpty(): no elements. O(1).\n  @Ensures(result == (this.size() == 0))\n  isEmpty(): bool {\n    return this.len == 0;\n  }\n\n  // capacity(): number of slots of the ring (0 until the first push; then 4, 8, 16, ...). O(1).\n  @Ensures(result == this.buf.length)\n  capacity(): usize {\n    return this.buf.length;\n  }\n\n  // Slot of the element number i from the front (i <= len; i = len is the slot after the back).\n  // A private method does not assume the class invariant, so `head < buf.length` is stated here; it holds at\n  // every call (found by `orin verify --contracts`, ADR-0031 B).\n  @Requires(this.buf.length > 0 && this.head < this.buf.length && i <= this.len)\n  @Ensures(result < this.buf.length)\n  private slot(i: usize): usize {\n    const idx = this.head + i;\n    if (idx >= this.buf.length) {\n      return idx - this.buf.length;\n    }\n    return idx;\n  }\n\n  // Doubles the ring (4 slots at first) when it is full, unrolling it so that head becomes 0. O(n).\n  private grow(x: T): void {\n    if (this.filler.isNone()) {\n      this.filler = Some(x);\n    }\n    const cap = this.buf.length;\n    if (this.len < cap) {\n      return;\n    }\n    const ncap: usize = cap == 0 ? 4 : cap * 2;\n    const fill = this.filler.unwrap();\n    let nb: T[] = [];\n    let i: usize = 0;\n    while (i < this.len) {\n      nb.push(this.buf[this.slot(i)]);\n      i += 1;\n    }\n    while (nb.length < ncap) {\n      nb.push(fill);\n    }\n    this.buf = nb;\n    this.head = 0;\n  }\n\n  // pushBack(x): append x. Amortised O(1).\n  @Ensures(this.size() == old(this.size()) + 1)\n  @Ensures(this.back().isSome() && this.get(this.size() - 1).isSome())\n  @Ensures(old(this.isEmpty()) ==> this.front().isSome())\n  @Ensures(this.capacity() >= old(this.capacity()))\n  pushBack(x: T): void {\n    this.grow(x);\n    this.buf[this.slot(this.len)] = x;\n    this.len += 1;\n  }\n\n  // pushFront(x): prepend x. Amortised O(1).\n  @Ensures(this.size() == old(this.size()) + 1)\n  @Ensures(this.front().isSome() && this.get(0).isSome())\n  @Ensures(old(this.isEmpty()) ==> this.back().isSome())\n  @Ensures(this.capacity() >= old(this.capacity()))\n  pushFront(x: T): void {\n    this.grow(x);\n    if (this.head == 0) {\n      this.head = this.buf.length - 1;\n    } else {\n      this.head -= 1;\n    }\n    this.buf[this.head] = x;\n    this.len += 1;\n  }\n\n  // popFront(): remove and return the first element, None when empty. O(1).\n  @Ensures(result.isSome() == (old(this.size()) > 0))\n  @Ensures(result.isSome() ==> this.size() == old(this.size()) - 1)\n  @Ensures(result.isNone() ==> this.size() == 0)\n  popFront(): Option<T> {\n    if (this.len == 0) {\n      return None;\n    }\n    const v = this.buf[this.head];\n    this.buf[this.head] = this.filler.unwrap();\n    this.head += 1;\n    if (this.head == this.buf.length) {\n      this.head = 0;\n    }\n    this.len -= 1;\n    return Some(v);\n  }\n\n  // popBack(): remove and return the last element, None when empty. O(1).\n  @Ensures(result.isSome() == (old(this.size()) > 0))\n  @Ensures(result.isSome() ==> this.size() == old(this.size()) - 1)\n  @Ensures(result.isNone() ==> this.size() == 0)\n  popBack(): Option<T> {\n    if (this.len == 0) {\n      return None;\n    }\n    const at = this.slot(this.len - 1);\n    const v = this.buf[at];\n    this.buf[at] = this.filler.unwrap();\n    this.len -= 1;\n    return Some(v);\n  }\n\n  // front(): the first element without removing it, None when empty. O(1).\n  @Ensures(result.isSome() == (this.size() > 0))\n  front(): Option<T> {\n    if (this.len == 0) {\n      return None;\n    }\n    return Some(this.buf[this.head]);\n  }\n\n  // back(): the last element without removing it, None when empty. O(1).\n  @Ensures(result.isSome() == (this.size() > 0))\n  back(): Option<T> {\n    if (this.len == 0) {\n      return None;\n    }\n    return Some(this.buf[this.slot(this.len - 1)]);\n  }\n\n  // get(i): the i-th element from the front, None when i >= size(). O(1).\n  @Ensures(result.isSome() == (i < this.size()))\n  get(i: usize): Option<T> {\n    if (i >= this.len) {\n      return None;\n    }\n    return Some(this.buf[this.slot(i)]);\n  }\n\n  // clear(): remove all elements and release the storage. O(1).\n  @Ensures(this.size() == 0 && this.capacity() == 0)\n  clear(): void {\n    this.buf = [];\n    this.head = 0;\n    this.len = 0;\n    this.filler = None;\n  }\n\n  // toArray(): the elements front to back. O(n).\n  @Ensures(result.length == this.size())\n  toArray(): T[] {\n    let out: T[] = [];\n    let i: usize = 0;\n    while (i < this.len) {\n      out.push(this.buf[this.slot(i)]);\n      i += 1;\n    }\n    return out;\n  }\n}\n\n// BEGIN GENERATED by tools/gen_sorted_map.py from tools/sorted_map.tmpl: do not edit, run the script\n// ------------------------------------------------------------------------------------------ SortedMap\n\n// One node of the B-tree: `keys` sorted, `vals` parallel to them, `kids` empty for a leaf, else keys.length + 1\n// child ids (indices into the arena `nodes` of the map).\nexport type IntNode<V> = { keys: int[]; vals: V[]; kids: usize[]; };\n\n// An entry returned by `SortedMap.popFirst` / `popLast`.\nexport type SortedEntry<V> = { key: int; value: V; };\n\n// The first index whose key is >= k (keys.length when there is none). Binary search, O(log keys.length).\n@Ensures(result <= keys.length)\n@Ensures(result < keys.length ==> (keys[result] >= k))\n@Ensures(result > 0 ==> (keys[result - 1] < k))\nexport function lowerBoundInt(keys: int[], k: int): usize {\n  let lo: usize = 0;\n  let hi: usize = keys.length;\n  while (lo < hi) {\n    const mid = lo + (hi - lo) / 2;\n    if ((keys[mid] < k)) {\n      lo = mid + 1;\n    } else {\n      hi = mid;\n    }\n  }\n  return lo;\n}\n\n// Is `nodes` a well-formed B-tree arena of minimum degree t rooted at `root`, with free list `free`? Checked\n// iteratively with an explicit stack: every node id is in range and reached exactly once (no dangling or shared\n// ids, no cycles), keys and values have the same length, a leaf has no children and an inner node has one more\n// child than keys (and at least one key), every non-root node holds t-1 .. 2t-1 keys and the root at most 2t-1,\n// all leaves have the same depth, the free list holds distinct ids of unreachable nodes, and every arena slot is\n// either reachable or free.\nexport function btreeIntShapeOk<V>(nodes: IntNode<V>[], root: usize, t: usize, free: usize[]): bool {\n  const n = nodes.length;\n  if (t < 2 || root >= n) {\n    return false;\n  }\n  let seen: bool[] = [];\n  let i: usize = 0;\n  while (i < n) {\n    seen.push(false);\n    i += 1;\n  }\n  i = 0;\n  while (i < free.length) {\n    if (free[i] >= n || seen[free[i]]) {\n      return false;\n    }\n    seen[free[i]] = true;\n    i += 1;\n  }\n  let ids: usize[] = [root];\n  let depths: usize[] = [0];\n  let leafDepth: int = -1;\n  let reachable: usize = 0;\n  while (ids.length > 0) {\n    const id = ids.pop().unwrap();\n    const d = depths.pop().unwrap();\n    if (seen[id]) {\n      return false;\n    }\n    seen[id] = true;\n    reachable += 1;\n    const kc = nodes[id].keys.length;\n    if (nodes[id].vals.length != kc || kc > 2 * t - 1) {\n      return false;\n    }\n    if (id != root && kc < t - 1) {\n      return false;\n    }\n    const kk = nodes[id].kids.length;\n    if (kk == 0) {\n      if (leafDepth < 0) {\n        leafDepth = d.toInt();\n      } else if (leafDepth != d.toInt()) {\n        return false;\n      }\n    } else {\n      if (kk != kc + 1 || kc == 0) {\n        return false;\n      }\n      let c: usize = 0;\n      while (c < kk) {\n        if (nodes[id].kids[c] >= n) {\n          return false;\n        }\n        ids.push(nodes[id].kids[c]);\n        depths.push(d + 1);\n        c += 1;\n      }\n    }\n  }\n  return reachable + free.length == n;\n}\n\n// Are the keys ordered? Inside every node strictly increasing, and every key of a child lies strictly between the\n// separator keys around it in the parent (inherited bounds), which together say the in-order sequence is strictly\n// increasing. Iterative; tolerates a broken shape (out-of-range ids, revisits) by answering false.\nexport function btreeIntOrderOk<V>(nodes: IntNode<V>[], root: usize): bool {\n  if (root >= nodes.length) {\n    return false;\n  }\n  let ids: usize[] = [root];\n  let loFlags: bool[] = [false];\n  let los: int[] = [0];\n  let hiFlags: bool[] = [false];\n  let his: int[] = [0];\n  let visited: usize = 0;\n  while (ids.length > 0) {\n    visited += 1;\n    if (visited > nodes.length) {\n      return false;\n    }\n    const id = ids.pop().unwrap();\n    const hasLo = loFlags.pop().unwrap();\n    const lo = los.pop().unwrap();\n    const hasHi = hiFlags.pop().unwrap();\n    const hi = his.pop().unwrap();\n    const kc = nodes[id].keys.length;\n    let j: usize = 0;\n    while (j < kc) {\n      if (j > 0 && (nodes[id].keys[j - 1] >= nodes[id].keys[j])) {\n        return false;\n      }\n      j += 1;\n    }\n    if (kc > 0) {\n      if (hasLo && (nodes[id].keys[0] <= lo)) {\n        return false;\n      }\n      if (hasHi && (nodes[id].keys[kc - 1] >= hi)) {\n        return false;\n      }\n    }\n    const kk = nodes[id].kids.length;\n    if (kk > 0 && kk != kc + 1) {\n      return false;\n    }\n    let c: usize = 0;\n    while (c < kk) {\n      if (nodes[id].kids[c] >= nodes.length) {\n        return false;\n      }\n      ids.push(nodes[id].kids[c]);\n      if (c == 0) {\n        loFlags.push(hasLo);\n        los.push(lo);\n      } else {\n        loFlags.push(true);\n        los.push(nodes[id].keys[c - 1]);\n      }\n      if (c == kc) {\n        hiFlags.push(hasHi);\n        his.push(hi);\n      } else {\n        hiFlags.push(true);\n        his.push(nodes[id].keys[c]);\n      }\n      c += 1;\n    }\n  }\n  return true;\n}\n\n// The number of keys stored in the tree below `root` (iterative; a revisit or bad id stops the walk early).\nexport function btreeIntKeyCount<V>(nodes: IntNode<V>[], root: usize): usize {\n  if (root >= nodes.length) {\n    return 0;\n  }\n  let ids: usize[] = [root];\n  let total: usize = 0;\n  let visited: usize = 0;\n  while (ids.length > 0) {\n    visited += 1;\n    if (visited > nodes.length) {\n      return total;\n    }\n    const id = ids.pop().unwrap();\n    total += nodes[id].keys.length;\n    let c: usize = 0;\n    while (c < nodes[id].kids.length) {\n      if (nodes[id].kids[c] < nodes.length) {\n        ids.push(nodes[id].kids[c]);\n      }\n      c += 1;\n    }\n  }\n  return total;\n}\n\n// Height of the tree: the number of levels (1 for a single leaf root). Follows the first child down. O(height).\nexport function btreeIntHeight<V>(nodes: IntNode<V>[], root: usize): usize {\n  let h: usize = 1;\n  let id = root;\n  while (id < nodes.length && nodes[id].kids.length > 0 && h <= nodes.length) {\n    id = nodes[id].kids[0];\n    h += 1;\n  }\n  return h;\n}\n\n// The fewest keys a tree of minimum degree t and the given height can hold: the r