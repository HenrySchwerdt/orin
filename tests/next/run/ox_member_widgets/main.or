// OX member tags with a Components provider (ADR-0044 §4.5): the methods of a class instance and of an interface value
// are called with the component rules; the provider is the one of tests/next/run/ox_widgets.
import ox from "../ox_widgets/widgets";
import { Widget, show, press } from "../ox_widgets/widgets";

interface Panel {
  Box(title: string, footer: Option<Widget>, children: Widget[]): Widget;
}

class Fancy implements Panel {
  mark: string;

  constructor(mark: string) {
    this.mark = mark;
  }

  Box(title: string, footer: Option<Widget>, children: Widget[]): Widget {
    return <column spacing={1}>
      <label value={this.mark + title} />
      {children}
      {footer.isSome() ? footer.unwrap() : <spacer size={0} />}
    </column>;
  }

  Pair(left: string, right: string): Widget {
    return <column spacing={2}><label value={left} /><label value={right} /></column>;
  }

  Both(): Widget {
    return <this.Pair right="r" left="l" />;
  }
}

function note(s: string): string {
  console.log(`eval ${s}`);
  return s;
}

function render(p: Panel): Widget {
  return <p.Box title="via interface"><label value="inside" /></p.Box>;
}

function main(): void {
  const f = new Fancy("* ");
  console.log("== class instance, default slot and Option left out");
  console.log(show(<f.Box title="one"><label value="a" />text</f.Box>));
  console.log("== Option given, a button inside");
  console.log(show(<f.Box title="two" footer={Some(<button title="Ok" onClick={() => console.log("ok clicked")} />)}></f.Box>));
  press(<f.Box title="two" footer={Some(<button title="Ok" onClick={() => console.log("ok clicked")} />)} />);
  console.log("== interface value");
  console.log(show(render(f)));
  console.log("== this.Method inside a method");
  console.log(show(f.Both()));
  console.log("== source order");
  console.log(show(<f.Pair right={note("right")} left={note("left")} />));
}
