// Several interfaces with the same method name; classes pick which ones they implement.
interface Readable {
  size(): int;
}

interface Writable {
  size(): int;
  put(n: int): int;
}

class Buf implements Readable, Writable {
  constructor(public n: int) {}
  size(): int { return this.n; }
  put(k: int): int { return this.n + k; }
}

class Ro implements Readable {
  size(): int { return 7; }
}

function sizeOf(r: Readable): int { return r.size(); }
function fill(w: Writable): int { return w.size() * 100 + w.put(1); }

function main(): void {
  const b = new Buf(4);
  console.log(sizeOf(b).toString() + " " + sizeOf(new Ro()).toString() + " " + fill(b).toString());
}
