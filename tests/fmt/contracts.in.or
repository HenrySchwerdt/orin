// Contract clauses (ADR-0012): printed one per line before the declaration they constrain.
@Rule( "SHOP-001" )
@Requires(  cents>=0  )
@Ensures(result>=0&&result<=cents)
@Ensures(premium==>result*2<=cents)
export function discount(cents:int,premium:bool):int{
  if(premium){return cents/2;}
  return cents;
}

// the invariant of the class
@Invariant(this.balance>=0)
@Rule("BANK-7")
class BankAccount {
  balance:int;
  @Requires(initialBalance>=0)
  constructor(initialBalance:int){this.balance=initialBalance;}

  // withdraw
  @Requires(amount>0&&amount<=this.balance)   @Ensures(this.balance==old(this.balance)-amount)
  withdraw(amount:int):void{this.balance-=amount;}
  @Ensures((a ==> b) ==> c)
  @Ensures(a ==> b ==> c)
  @Ensures(x ? (a ==> b) : c)
  @Ensures(veryLongConditionNumberOne(this.balance) && veryLongConditionNumberTwo(this.balance) ==> veryLongConditionNumberThree(this.balance))
  private check(a: bool, b: bool, c: bool, x: bool): bool {return a;}
}

@Invariant(this.lo<=this.hi)
type Range={lo:int;hi:int;};

@Rule("R-1")
type Id = int;

function main(): void {
  let i=0;
  @Invariant(i>=0&&i<=10)
  @Decreases(10-i)
  while(i<10){
    // body
    i+=1;
  }
  @Invariant(true)
  for (const x of [1,2]) {
    i += x;
  }
}
