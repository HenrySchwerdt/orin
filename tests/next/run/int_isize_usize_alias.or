// `int` is an alias of `i64`; `isize` and `usize` are separate types of pointer width; `usize` keeps its
// behaviour (the only array index type, length, charCodeAt arguments, literals adopt it).
function takesI64(x: i64): i64 {
  return x + 1;
}

function takesInt(x: int): int {
  return x + 1;
}

type Pair = { a: int; b: i64; };

function main(): void {
  const a: int = 41;
  const b: i64 = a;
  console.log(takesI64(a).toString() + " " + takesInt(b).toString());
  const p = Pair { a: b, b: a };
  console.log((p.a + p.b).toString());
  const xs: i64[] = [1, 2, 3];
  const ys: int[] = xs;
  console.log(ys.length.toString());
  const f: (x: int) => i64 = (x: i64): int => x * 2;
  console.log(f(21).toString());

  // usize
  const arr = [10, 20, 30];
  const i: usize = 2;
  console.log(arr[i].toString());
  console.log(arr[arr.length - 1].toString());
  console.log("abc".charCodeAt(1).toString());
  console.log("hello".substring(1, 3));
  console.log((arr.length + i).toString());
  const n = arr.length.toInt() - 5;
  console.log(n.toString());
  console.log((arr.length > 2).toString());
  let k: usize = 0;
  while (k < arr.length) {
    k += 1;
  }
  console.log(k.toString());

  // isize
  const s: isize = -12;
  const t: isize = s * 3 + 1;
  console.log(t.toString());
  console.log((t / 5).toString());
  console.log((t % 5).toString());
  console.log(s.toInt().toString());
  console.log(s.toI64().toString());
  const z: isize = 5;
  console.log(z.toUsize().toString());
}
