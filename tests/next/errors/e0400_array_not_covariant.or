// error: E0400
// `Circle[]` is not a `Shape[]`: the conversion is not applied to arrays.
interface Shape {
  area(): int;
}

class Circle implements Shape {
  area(): int { return 1; }
}

function count(xs: Shape[]): usize {
  return xs.length;
}

function main(): void {
  const cs: Circle[] = [new Circle()];
  console.log(count(cs).toString());
}
