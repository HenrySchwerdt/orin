// Name tables of the semantic index: the per-unit scope and export tables and what kind of HIR function a name maps to.
// Part of the semantic index (check/index/build.or).

// Name tables of one unit: type namespace (records, unions, aliases) and value namespace (functions, consts,
// variants), each as the unit's scope and as its exports; plus the def of each top-level item. The first binding of a
// name wins (a duplicate declaration is a checker error, the index still resolves to the first one).
export class UnitTab {
  private types: Map<string, usize> = new Map<string, usize>();
  private vals: Map<string, usize> = new Map<string, usize>();
  private exTypes: Map<string, usize> = new Map<string, usize>();
  private exVals: Map<string, usize> = new Map<string, usize>();
  private items: usize[] = [];

  typeDef(name: string): Option<usize> {
    return this.types.get(name);
  }

  valDef(name: string): Option<usize> {
    return this.vals.get(name);
  }

  exportedType(name: string): Option<usize> {
    return this.exTypes.get(name);
  }

  exportedVal(name: string): Option<usize> {
    return this.exVals.get(name);
  }

  // The def of top-level item `k` of the unit (0 for an item without a definition).
  itemDef(k: usize): usize {
    return this.items[k];
  }

  setItemDefs(defs: usize[]): void {
    this.items = defs;
  }

  // A declaration: in scope, and exported when `exported`.
  bindType(name: string, def: usize, exported: bool): void {
    this.scopeType(name, def);
    if (exported) {
      this.exportType(name, def);
    }
  }

  bindVal(name: string, def: usize, exported: bool): void {
    this.scopeVal(name, def);
    if (exported) {
      this.exportVal(name, def);
    }
  }

  // An imported name: in scope, or exported only when the import is a re-export.
  importType(name: string, def: usize, reexport: bool): void {
    if (reexport) {
      this.exportType(name, def);
    } else {
      this.scopeType(name, def);
    }
  }

  importVal(name: string, def: usize, reexport: bool): void {
    if (reexport) {
      this.exportVal(name, def);
    } else {
      this.scopeVal(name, def);
    }
  }

  scopeType(name: string, def: usize): void {
    if (!this.types.has(name)) {
      this.types.set(name, def);
    }
  }

  scopeVal(name: string, def: usize): void {
    if (!this.vals.has(name)) {
      this.vals.set(name, def);
    }
  }

  // A re-export adds to the exports only.
  exportType(name: string, def: usize): void {
    if (!this.exTypes.has(name)) {
      this.exTypes.set(name, def);
    }
  }

  exportVal(name: string, def: usize): void {
    if (!this.exVals.has(name)) {
      this.exVals.set(name, def);
    }
  }
}

// What a HIR function is: FkOrdinary an ordinary function or generic instance, FkClosure a lifted closure body,
// FkWrapper a function-value wrapper (`f$closure`).
export type FnKind = FkOrdinary | FkClosure | FkWrapper;

export function fnKindNos(ks: FnKind[]): usize[] {
  let out: usize[] = [];
  for (const k of ks) {
    out.push(fnKindNo(k));
  }
  return out;
}

export function isOrdinaryKind(k: FnKind): bool {
  return match (k) {
    FkOrdinary => true,
    _ => false,
  };
}

export function isClosureKind(k: FnKind): bool {
  return match (k) {
    FkClosure => true,
    _ => false,
  };
}

export function isWrapperKind(k: FnKind): bool {
  return match (k) {
    FkWrapper => true,
    _ => false,
  };
}

// The kind as the number `SemanticIndex.fnKinds` stores (0 ordinary, 1 closure, 2 wrapper).
function fnKindNo(k: FnKind): usize {
  return match (k) {
    FkOrdinary => 0,
    FkClosure => 1,
    FkWrapper => 2,
  };
}

// `m` with `name` bound to `def` unless it is bound already (the first binding wins).
export function bindFirst(m: Map<string, usize>, name: string, def: usize): Map<string, usize> {
  let out = m;
  if (!out.has(name)) {
    out.set(name, def);
  }
  return out;
}
