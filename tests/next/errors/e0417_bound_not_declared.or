// error: E0417
interface Shape {
  area(): int;
}

class Square {
  constructor(public s: int) {}
  area(): int { return this.s * this.s; }
}

function total<T extends Shape>(xs: T[]): int {
  let t = 0;
  for (const x of xs) {
    t += x.area();
  }
  return t;
}

function main(): void {
  console.log(total([new Square(2)]).toString());
}
