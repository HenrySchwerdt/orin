// Process stdio for the language server loop (spec 18 §3): the only compiler file that uses
// `std:io`.

import { ProcessGrant } from "std:process";
import { StdioGrant } from "std:io";
import { readBytes, readLine, writeStdout, shell, shellTimeout } from "std:io";

export function stdinReadBytes(stdio: StdioGrant, n: usize): Option<string> {
  return readBytes(stdio, n);
}

export function stdinReadLine(stdio: StdioGrant): Option<string> {
  return readLine(stdio);
}

export function stdoutWrite(stdio: StdioGrant, s: string): void {
  writeStdout(stdio, s);
}

// Runs a shell command, returns its exit status (-1: could not run / signalled).
export function shellRun(proc: ProcessGrant, cmd: string): int {
  return shell(proc, cmd);
}

// seconds > 0: native monotonic deadline; -2 timeout. 0 explicitly disables the limit.
export function shellRunTimeout(proc: ProcessGrant, cmd: string, seconds: int): int {
  if (seconds == 0) { return shell(proc, cmd); }
  return shellTimeout(proc, cmd, seconds);
}
