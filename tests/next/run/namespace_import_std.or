// Namespace imports and import aliases (ADR-0048 addendum): `bytes.fromString`, `html.empty`, and an alias next to a plain
// import of the same name from another module (`empty` of std:bytes and std:html).
import * as bytes from "std:bytes";
import * as html from "std:html";
import { empty as emptyBytes } from "std:bytes";
import { empty } from "std:html";

function main(): void {
  const b: bytes.Bytes = bytes.fromString("hi");
  console.log(b.length().toString());
  const e = emptyBytes();
  console.log(e.length().toString());
  console.log(bytes.empty().length().toString());
  console.log(html.escape("<a href=\"x\">&</a>"));
  const h: html.Html = empty();
  console.log(html.isEmpty(h) ? "empty" : "not empty");
  console.log(html.render(html.text("1 < 2")));
  console.log(html.render(html.fragment([html.text("a"), html.text("&")])));
}
