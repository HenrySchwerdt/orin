function sum(xs: float[]): float {
  let s = 0.0;
  for (const x of xs) {
    s += x;
  }
  return s;
}

function scaled(xs: float[], k: float): float[] {
  let out: float[] = [];
  for (const x of xs) {
    out.push(x * k);
  }
  return out;
}

function main(): void {
  let xs: float[] = [1.5, 2.5, 3.5];
  xs.push(4.5);
  console.log(sum(xs).toString());
  xs[0] = -1.5;
  xs[3] += 0.5;
  xs[1] *= 2.0;
  console.log(xs.map(x => x.toString()).join(" "));
  const ys = scaled(xs, 0.5);
  console.log(ys.map(x => x.toString()).join(" "));
  console.log(sum(ys).toString());
  const copy = xs;
  xs[2] = 99.0;
  console.log(copy[2].toString() + " " + xs[2].toString());
  console.log(xs.length.toString());
  const popped = xs.pop();
  console.log(popped.unwrap().toString());
  console.log(xs.get(1).unwrapOr(0.0).toString());
  console.log(xs.get(10).unwrapOr(-1.0).toString());
  console.log(xs.slice(1, 3).map(x => x.toString()).join(","));
  console.log(xs.concat([0.25]).length.toString());
  const empty: float[] = [];
  console.log(sum(empty).toString());
  console.log(xs.filter(x => x > 0.0).length.toString());
  console.log(xs.reduce((a, x) => a + x, 0.0).toString());
  console.log(xs.some(x => x == 99.0).toString());
  console.log(xs.every(x => x < 50.0).toString());
}
