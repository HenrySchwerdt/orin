import { newGraph, add, get, set, neighbors, addEdge } from "std:graph";

type City = { name: string; pop: int; };
class Counter {
  constructor(public n: int) {}
  bump(): void {
    this.n += 1;
  }
}

function main(): void {
  let g = newGraph<City>(21);
  const a = add(g, City { name: "Aachen", pop: 250 });
  g = a.graph;
  const b = add(g, City { name: "Bonn", pop: 330 });
  g = b.graph;
  g = addEdge(g, a.id, b.id).unwrap();
  const c = get(g, a.id).unwrap();
  console.log(c.name + " " + c.pop.toString());
  g = set(g, b.id, City { name: "Bonn", pop: 331 }).unwrap();
  console.log(get(g, neighbors(g, a.id).unwrap()[0]).unwrap().pop.toString());

  let cg = newGraph<Counter>(22);
  const k = add(cg, new Counter(1));
  cg = k.graph;
  let copy = get(cg, k.id).unwrap();
  copy.bump();
  console.log(get(cg, k.id).unwrap().n.toString() + " " + copy.n.toString());
}
