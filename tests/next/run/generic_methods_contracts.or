// flags: --check-contracts
// exit: 101
// stderr: contract violated: @Requires(n > 0)
// ADR-0040: the contracts of a generic method are checked per instance at run time.
class Rep {
  @Requires(n > 0)
  @Ensures(result.length == n.toUsize())
  times<T>(x: T, n: int): T[] {
    let out: T[] = [];
    let i = 0;
    while (i < n) {
      out.push(x);
      i += 1;
    }
    return out;
  }
}

class Cell<T> {
  v: T;

  constructor(v: T) {
    this.v = v;
  }

  @Requires(n > 0)
  many<U>(u: U, n: int): U[] {
    return [u];
  }
}

function main(): void {
  const r = new Rep();
  console.log(r.times("ab", 2).length.toString());
  console.log(r.times(1, 3).length.toString());
  const c = new Cell<int>(1);
  console.log(c.many(true, 1).length.toString());
  console.log(c.many("x", 0).length.toString());
}
