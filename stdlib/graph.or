// std:graph -- Graph<T> with generational, graph-tagged node ids (spec 06 "Cyclic graph", ADR-0016, ADR-0026).
//
// Cyclic structures are not expressible with owning values (no owning cycles), so a graph owner
// holds all nodes and edges are checked, non-owning `GraphId<T>` handles:
//   * Each id carries the graph's tag, the slot index and the slot's generation. Removing a node
//     bumps its slot's generation, so an id that outlived its node is STALE and every operation
//     rejects it with `Err(StaleId)`; an id minted by a graph with a different tag is `Err(ForeignId)`.
//     (An id whose index lies beyond the graph is also `ForeignId`.)
//   * `Graph<T>` is a generic class (value semantics like every class): `let g = new Graph<string>(1);
//     const a = g.add("alpha");`. A copy (`const h = g`) is independent: later changes to `g` are not
//     visible in `h` (an id removed in `g` is still valid in the older `h`: ids identify a node of one
//     *tag*, generations track its history).
//   * The tag is supplied by the caller: `new Graph<T>(tag)`. Use a different tag per logical graph.
//     TODO(after global state): an automatic unique tag once the language has a process-wide counter.
//   * Edges are directed and stored in the source slot as (index, generation) pairs. Removing a node
//     does not touch edges pointing at it: they become dangling and `neighbors` silently skips them
//     (an edge only counts while both ends are live with the generations recorded at addEdge time).
//     Duplicate edges are allowed and reported once per addEdge call.
//   * Complexity: `add`, `get`, `contains`, `size` are O(1) (freed slots are reused through a free list);
//     `remove` is O(1); `neighbors` is O(out-degree), `ids` O(nodes). Mutating methods update the
//     graph in place when it is not shared; a shared graph is copied on the first change (O(nodes)).
//
// TODO(after floats/map): `Map`-based index, edge weights.

// Opaque handle of a node of a graph with value type T. `T` is only a phantom parameter that ties
// the id to its graph's value type; obtain ids through `Graph.add`.
export type GraphId<T> = { tag: int; index: usize; gen: int; };

// StaleId: the node was removed (the slot has a newer generation or is empty).
// ForeignId: the id belongs to another graph (different tag) or does not name a slot at all.
export type GraphError = StaleId | ForeignId;

type Edge = { index: usize; gen: int; };

type Slot<T> = { gen: int; value: Option<T>; edges: Edge[]; };

// graphErrorMessage(e: GraphError): string -- "stale graph id" / "foreign graph id". O(1).
export function graphErrorMessage(e: GraphError): string {
  return match (e) {
    StaleId => "stale graph id",
    ForeignId => "foreign graph id"
  };
}

export class Graph<T> {
  private tag: int;
  private slots: Slot<T>[] = [];
  private free: usize[] = [];
  private live: usize = 0;

  // new Graph<T>(tag): an empty graph. Ids minted by it are accepted only by graphs with the same `tag`.
  constructor(tag: int) {
    this.tag = tag;
  }

  // size(): usize -- number of live nodes. O(1).
  size(): usize {
    return this.live;
  }

  // Validates `id`: Ok(slot index) when it names a live node of this graph.
  private lookup(id: GraphId<T>): Result<usize, GraphError> {
    if (id.tag != this.tag || id.index >= this.slots.length) {
      return Err(ForeignId);
    }
    if (this.slots[id.index].gen != id.gen || this.slots[id.index].value.isNone()) {
      return Err(StaleId);
    }
    return Ok(id.index);
  }

  // contains(id): bool -- true when `id` names a live node of this graph. O(1).
  contains(id: GraphId<T>): bool {
    return this.lookup(id).isOk();
  }

  // add(value): GraphId<T>
  // Adds a node (reusing a freed slot, whose generation `remove` already bumped) and returns its id.
  // Never fails. O(1).
  add(value: T): GraphId<T> {
    if (this.free.length > 0) {
      const i = this.free.pop().unwrap();
      this.slots[i].value = Some(value);
      this.live += 1;
      return GraphId<T> { tag: this.tag, index: i, gen: this.slots[i].gen };
    }
    this.slots.push(Slot<T> { gen: 0, value: Some(value), edges: [] });
    this.live += 1;
    return GraphId<T> { tag: this.tag, index: this.slots.length - 1, gen: 0 };
  }

  // get(id): Result<T, GraphError>
  // The value of a live node. Errors: StaleId (removed node), ForeignId (other graph). O(1).
  get(id: GraphId<T>): Result<T, GraphError> {
    const i = this.lookup(id)?;
    return Ok(this.slots[i].value.unwrap());
  }

  // set(id, value): Result<void, GraphError>
  // Replaces a live node's value (its edges and id stay). Errors as `get`. O(1).
  set(id: GraphId<T>, value: T): Result<void, GraphError> {
    const i = this.lookup(id)?;
    this.slots[i].value = Some(value);
    return Ok();
  }

  // remove(id): Result<T, GraphError>
  // Removes a live node and its outgoing edges and returns its value. The slot generation is bumped
  // (invalidating `id` and every copy of it) and the slot is freed for reuse. Edges of other nodes that
  // pointed at it dangle and are skipped by `neighbors`. Errors as `get`. O(1).
  remove(id: GraphId<T>): Result<T, GraphError> {
    const i = this.lookup(id)?;
    const old = this.slots[i].value.unwrap();
    const gone: Option<T> = None;
    this.slots[i].value = gone;
    this.slots[i].gen += 1;
    this.slots[i].edges = [];
    this.free.push(i);
    this.live -= 1;
    return Ok(old);
  }

  // addEdge(a, b): Result<void, GraphError>
  // Adds the directed edge a -> b (self loops and duplicates allowed). Both ids must be live in this
  // graph; the first failing id's error is returned (`a` is checked first). O(1).
  addEdge(a: GraphId<T>, b: GraphId<T>): Result<void, GraphError> {
    const i = this.lookup(a)?;
    const j = this.lookup(b)?;
    this.slots[i].edges.push(Edge { index: j, gen: b.gen });
    return Ok();
  }

  // neighbors(id): Result<GraphId<T>[], GraphError>
  // The targets of the outgoing edges of a live node, in insertion order, skipping dangling edges
  // (removed targets). Errors as `get`. O(out-degree).
  neighbors(id: GraphId<T>): Result<GraphId<T>[], GraphError> {
    const i = this.lookup(id)?;
    let out: GraphId<T>[] = [];
    for (const e of this.slots[i].edges) {
      if (this.slots[e.index].gen == e.gen && this.slots[e.index].value.isSome()) {
        out.push(GraphId<T> { tag: this.tag, index: e.index, gen: e.gen });
      }
    }
    return Ok(out);
  }

  // ids(): GraphId<T>[] -- ids of all live nodes in slot order. O(nodes).
  ids(): GraphId<T>[] {
    let out: GraphId<T>[] = [];
    let i: usize = 0;
    while (i < this.slots.length) {
      if (this.slots[i].value.isSome()) {
        out.push(GraphId<T> { tag: this.tag, index: i, gen: this.slots[i].gen });
      }
      i += 1;
    }
    return out;
  }
}
