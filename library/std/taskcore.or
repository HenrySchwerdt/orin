// std:taskcore -- the pure bookkeeping of std:task (ADR-0017 stage 0): the state machine of one channel buffer (`Ring`) and of one
// scope's task table (`Ledger`). No I/O, no threads, no primitives: `std:task` loads one of them from a monitor, changes it and stores
// it back inside one critical section, so the invariants below hold whenever a lock is released, and they can be tested and mutated
// (tools/mutation.sh std) without a single thread. Part of the std:task implementation; import `std:task` for the API.

// The ring arithmetic on plain numbers: `Ring` is built on these, and std:task calls them directly on locals loaded from the
// channel's monitor (a `Ring` object per send / receive was 40% of the allocations of a channel benchmark), so the tests and
// the mutants of `Ring` below cover the code the channels run.

// A send would not block and would be accepted.
export function ringCanPush(len: usize, cap: usize, txClosed: bool, rxClosed: bool): bool {
  return !txClosed && !rxClosed && len < cap;
}

// The slot of the next value to write (requires len < cap).
export function ringSlot(cap: usize, head: usize, len: usize): usize {
  return (head + len) % cap;
}

// The head after one pop (requires cap >= 1).
export function ringNextHead(cap: usize, head: usize): usize {
  return (head + 1) % cap;
}

// No value will ever be received (cancelled by the receiver, or closed by the sender and drained).
export function ringIsDone(len: usize, txClosed: bool, rxClosed: bool): bool {
  return rxClosed || (txClosed && len == 0);
}

// The bookkeeping of one channel buffer, a bounded ring of `cap` slots. Pure: the channel functions load it from the
// channel's monitor, change it and store it back inside one critical section, so the invariants hold whenever the
// lock is released (they are checked after every method under --check-contracts, and `orin test` does).
@Invariant(this.cap >= 1)
@Invariant(this.head < this.cap)
@Invariant(this.len <= this.cap)
export class Ring {
  cap: usize;
  head: usize;
  len: usize;
  txClosed: bool;
  rxClosed: bool;

  @Requires(cap >= 1 && head < cap && len <= cap)
  constructor(cap: usize, head: usize, len: usize, txClosed: bool, rxClosed: bool) {
    this.cap = cap;
    this.head = head;
    this.len = len;
    this.txClosed = txClosed;
    this.rxClosed = rxClosed;
  }

  // canPush(): a send would not block and would be accepted.
  @Ensures(result == (!this.txClosed && !this.rxClosed && this.len < this.cap))
  canPush(): bool {
    return ringCanPush(this.len, this.cap, this.txClosed, this.rxClosed);
  }

  // canPop(): there is a value to receive.
  @Ensures(result == (this.len > 0))
  canPop(): bool {
    return this.len > 0;
  }

  // isDone(): no value will ever be received (cancelled by the receiver, or closed by the sender and drained).
  @Ensures(result == (this.rxClosed || (this.txClosed && this.len == 0)))
  isDone(): bool {
    return ringIsDone(this.len, this.txClosed, this.rxClosed);
  }

  // push(): the slot to write the next value into; the ring now holds one more value.
  @Requires(this.len < this.cap)
  @Ensures(result < this.cap)
  @Ensures(this.len == old(this.len) + 1)
  @Ensures(this.head == old(this.head))
  push(): usize {
    const slot = ringSlot(this.cap, this.head, this.len);
    this.len += 1;
    return slot;
  }

  // pop(): the slot to read the oldest value from; the ring now holds one value less.
  @Requires(this.len > 0)
  @Ensures(result < this.cap)
  @Ensures(result == old(this.head))
  @Ensures(this.len + 1 == old(this.len))
  pop(): usize {
    const slot = this.head;
    this.head = ringNextHead(this.cap, this.head);
    this.len -= 1;
    return slot;
  }

  // closeTx(): no more sends (what is buffered can still be received).
  @Ensures(this.txClosed && this.len == old(this.len))
  closeTx(): void {
    this.txClosed = true;
  }

  // closeRx(): no more receives; senders are refused from now on.
  @Ensures(this.rxClosed && this.len == old(this.len))
  closeRx(): void {
    this.rxClosed = true;
  }

  // released(): both ends have closed, so the channel's monitor can be freed.
  @Ensures(result == (this.txClosed && this.rxClosed))
  released(): bool {
    return this.txClosed && this.rxClosed;
  }
}

// The task table of a scope, as the scope's monitor holds it: [0] number of tasks spawned, [1] scan cursor (every entry below
// it has been claimed), [2] closed flag, [3] size of the monitor in words, then three words per task: its thread handle
// (0 until spawn has started the thread), its result monitor, and a state word (0 = nobody has joined it yet, 1 = claimed
// by a join or by the scope's exit).
@Invariant(this.cursor <= this.count)
export class Ledger {
  count: usize;
  cursor: usize;
  closed: bool;

  @Requires(cursor <= count)
  constructor(count: usize, cursor: usize, closed: bool) {
    this.count = count;
    this.cursor = cursor;
    this.closed = closed;
  }

  // add(): the index of a new task.
  @Requires(!this.closed)
  @Ensures(result == old(this.count) && this.count == old(this.count) + 1)
  add(): usize {
    const i = this.count;
    this.count += 1;
    return i;
  }

  // advance(): the scan has passed one more entry.
  @Requires(this.cursor < this.count)
  @Ensures(this.cursor == old(this.cursor) + 1)
  advance(): void {
    this.cursor += 1;
  }

  // isScanned(): the scan has passed every task.
  @Ensures(result == (this.cursor == this.count))
  isScanned(): bool {
    return this.cursor == this.count;
  }

  // close(): no task can be added any more; legal only when the scan has passed every task.
  @Requires(this.cursor == this.count)
  @Ensures(this.closed)
  close(): void {
    this.closed = true;
  }
}

// The chunk ranges of a fork/join pool (std:task `forkJoin`, ADR-0039): worker w owns the chunks lo[w] .. hi[w] - 1 and takes
// them from the front; a worker whose range is empty steals the back half of the largest range of another worker. Chunks at
// or after `cut` are cancelled (`forkJoinUntil`: everything to the right of the leftmost hit found so far). Pure: the pool
// keeps the words in its monitor and loads, changes and stores them inside one critical section.
@Invariant(this.lo.length == this.hi.length && this.lo.length >= 1)
@Invariant(this.cut <= this.chunks)
@Invariant(rangesOk(this.lo, this.hi, this.chunks))
export class Ranges {
  lo: usize[];
  hi: usize[];
  cut: usize;
  chunks: usize;

  @Requires(lo.length == hi.length && lo.length >= 1 && cut <= chunks && rangesOk(lo, hi, chunks))
  constructor(lo: usize[], hi: usize[], cut: usize, chunks: usize) {
    this.lo = lo;
    this.hi = hi;
    this.cut = cut;
    this.chunks = chunks;
  }

  // claim(w): the next chunk for worker w: its own next one, else one stolen from the back of the largest other range
  // (counting only chunks before the cut). None when no chunk before the cut is left to anybody.
  @Requires(w < this.lo.length)
  @Ensures(result.isSome() ==> result.unwrap() < this.cut && result.unwrap() < this.chunks)
  @Ensures(result.isSome() ==> this.lo[w] == result.unwrap() + 1)
  @Ensures(this.cut == old(this.cut))
  claim(w: usize): Option<usize> {
    if (this.lo[w] >= this.hi[w] || this.lo[w] >= this.cut) {
      const n = this.lo.length;
      let best = n;
      let most: usize = 0;
      let v: usize = 0;
      while (v < n) {
        const top = this.hi[v] < this.cut ? this.hi[v] : this.cut;
        if (v != w && top > this.lo[v] && top - this.lo[v] > most) {
          best = v;
          most = top - this.lo[v];
        }
        v += 1;
      }
      if (best == n) {
        return None;
      }
      // the victim keeps the front half, the thief takes the back half (all of it when one chunk is left)
      const mid = this.lo[best] + most / 2;
      this.lo[w] = mid;
      this.hi[w] = this.hi[best];
      this.hi[best] = mid;
    }
    const k = this.lo[w];
    this.lo[w] = k + 1;
    return Some(k);
  }

  // cancelAfter(k): chunk k produced a hit, so no chunk after it needs to run.
  @Ensures(this.cut <= old(this.cut) && this.cut <= k + 1)
  cancelAfter(k: usize): void {
    if (k + 1 < this.cut) {
      this.cut = k + 1;
    }
  }

  // cancelAll(): a worker failed; nothing more needs to run.
  @Ensures(this.cut == 0)
  cancelAll(): void {
    this.cut = 0;
  }
}

// Every range is inside 0 .. chunks and no chunk belongs to two ranges (so no chunk can run twice).
export function rangesOk(lo: usize[], hi: usize[], chunks: usize): bool {
  if (lo.length != hi.length) {
    return false;
  }
  let i: usize = 0;
  while (i < lo.length) {
    if (lo[i] > hi[i] || hi[i] > chunks) {
      return false;
    }
    let j: usize = i + 1;
    while (j < lo.length) {
      const overlap = lo[i] < hi[i] && lo[j] < hi[j] && lo[i] < hi[j] && lo[j] < hi[i];
      if (overlap) {
        return false;
      }
      j += 1;
    }
    i += 1;
  }
  return true;
}
