type Vec = { x: float; y: float; };
type Particle = { pos: Vec; mass: f32; tags: string[]; };
type Shape = Circle(float) | Rect(float, float) | Empty;

function area(s: Shape): float {
  return match (s) {
    Circle(r) => 3.0 * r * r,
    Rect(w, h) => w * h,
    Empty => 0.0
  };
}

function safeDiv(a: float, b: float): Option<float> {
  if (b == 0.0) {
    return None;
  }
  return Some(a / b);
}

function describe(r: Result<float, string>): string {
  return match (r) {
    Ok(v) => "ok " + v.toString(),
    Err(e) => "err " + e
  };
}

function main(): void {
  let p = Particle { pos: Vec { x: 1.5, y: -2.5 }, mass: 0.5, tags: [] };
  p.pos.x += 1.0;
  p.pos.y = p.pos.y * 2.0;
  p.mass = p.mass + 0.25;
  console.log(p.pos.x.toString() + " " + p.pos.y.toString() + " " + p.mass.toString());
  const q = p;
  p.pos.x = 100.0;
  console.log(q.pos.x.toString() + " " + p.pos.x.toString());
  console.log(area(Circle(2.0)).toString());
  console.log(area(Rect(2.0, 4.5)).toString());
  console.log(area(Empty).toString());
  console.log(safeDiv(1.0, 4.0).unwrapOr(-1.0).toString());
  console.log(safeDiv(1.0, 0.0).unwrapOr(-1.0).toString());
  console.log(safeDiv(9.0, 2.0).isSome().toString());
  console.log(describe(Ok(2.5)));
  console.log(describe(Err("bad")));
  const r: Result<float, string> = Ok(1.0 / 8.0);
  console.log(describe(r));
  const o = safeDiv(3.0, 4.0);
  match (o) {
    Some(v) => { console.log("some " + v.toString()); },
    None => { console.log("none"); }
  }
}
