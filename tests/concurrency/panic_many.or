// exit: 101
// Panics under the sanitizers: 300 tasks panic at about the same time and nobody joins them; every task also allocated and sent
// messages before it trapped (a trap does not unwind: its objects leak by design, the process must not crash). When the body returns,
// the scope joins all 300 tasks and traps with the first panic ("trap: task panicked: index out of bounds").
import { scopeDo, spawnDo, channel } from "std:task";

function boom(n: int): int {
  const xs: int[] = [1, 2, 3];
  return xs[n.toUsize()];
}

function main(): void {
  const ch = channel<string>(1000);
  scopeDo(s => {
    let i = 0;
    while (i < 300) {
      const k = i;
      spawnDo(s, () => {
        ch.tx.send("message from task " + k.toString());
        boom(k + 3);
      });
      i += 1;
    }
    console.log("spawned");
  });
  console.log("unreachable");
}
