// A generic function bounded by an interface, instantiated with classes from two other modules.
import { Priced } from "./api";
import { cheapest, sumPrices } from "./util";
import { Book } from "./book";
import { Toy } from "./toy";

function main(): void {
  console.log(cheapest([new Book("a", 30), new Book("b", 20)]));
  console.log(cheapest([new Toy(7), new Toy(3)]));
  console.log(sumPrices([new Toy(1), new Toy(2)]).toString());
  const mixed: Priced[] = [new Book("c", 5), new Toy(1)];
  console.log(cheapest(mixed) + " " + sumPrices(mixed).toString());
}
