// Text helpers of the conformance runner: shell quoting, Python-compatible `splitlines` / `strip` / `head`, the
// `repr` of a list of strings, byte-order sorting and a unified diff. Pure functions, no I/O (tests/text_test.or).

// True for the ASCII whitespace Python's str.strip() / str.split() remove from the files of this repository.
export function isSpace(c: int): bool {
  return c == 32 || (c >= 9 && c <= 13);
}

export function strip(s: string): string {
  let a: usize = 0;
  let b = s.length;
  while (a < b && isSpace(s.charCodeAt(a))) {
    a += 1;
  }
  while (b > a && isSpace(s.charCodeAt(b - 1))) {
    b -= 1;
  }
  return s.substring(a, b);
}

// Python's str.split() without argument: runs of whitespace separate, no empty fields.
export function splitWords(s: string): string[] {
  let out: string[] = [];
  let i: usize = 0;
  while (i < s.length) {
    while (i < s.length && isSpace(s.charCodeAt(i))) {
      i += 1;
    }
    if (i >= s.length) {
      break;
    }
    const start = i;
    while (i < s.length && !isSpace(s.charCodeAt(i))) {
      i += 1;
    }
    out.push(s.substring(start, i));
  }
  return out;
}

// POSIX shell quoting of one word.
export function shq(s: string): string {
  return "'" + s.split("'").join("'\\''") + "'";
}

function isLineBreak(c: int): bool {
  return c == 10 || c == 13 || c == 11 || c == 12 || c == 28 || c == 29 || c == 30;
}

// Python's str.splitlines(): "\n", "\r\n", "\r" (and the other ASCII line boundaries) end a line; no empty last line.
export function splitLines(s: string): string[] {
  let out: string[] = [];
  let start: usize = 0;
  let i: usize = 0;
  while (i < s.length) {
    const c = s.charCodeAt(i);
    if (isLineBreak(c)) {
      out.push(s.substring(start, i));
      if (c == 13 && i + 1 < s.length && s.charCodeAt(i + 1) == 10) {
        i += 1;
      }
      start = i + 1;
    }
    i += 1;
  }
  if (start < s.length) {
    out.push(s.substring(start, s.length));
  }
  return out;
}

// Cuts `s` to at most `n` bytes without splitting a UTF-8 sequence.
export function cutBytes(s: string, n: usize): string {
  if (s.length <= n) {
    return s;
  }
  let e = n;
  while (e > 0 && s.charCodeAt(e) >= 128 && s.charCodeAt(e) < 192) {
    e -= 1;
  }
  return s.substring(0, e);
}

// tools/run_tests.py `head`: the first `lines` lines, joined by "\n", cut to `chars` (bytes here, on a character boundary).
export function head(text: string, lines: usize, chars: usize): string {
  const all = splitLines(text);
  let kept: string[] = [];
  let i: usize = 0;
  while (i < all.length && i < lines) {
    kept.push(all[i]);
    i += 1;
  }
  return cutBytes(kept.join("\n"), chars);
}

// Python's repr of one string (for the `%r` of messages).
export function reprStr(x: string): string {
  const escaped = x.split("\\").join("\\\\");
  if (x.includes("'") && !x.includes("\"")) {
    return "\"" + escaped + "\"";
  }
  return "'" + escaped.split("'").join("\\'") + "'";
}

// Python's repr of a list of strings: ['W0450', 'W0452'].
export function reprList(xs: string[]): string {
  let parts: string[] = [];
  for (const x of xs) {
    parts.push(reprStr(x));
  }
  return "[" + parts.join(", ") + "]";
}

// Byte-wise "a < b".
export function lessThan(a: string, b: string): bool {
  const n = a.length < b.length ? a.length : b.length;
  let i: usize = 0;
  while (i < n) {
    const x = a.charCodeAt(i);
    const y = b.charCodeAt(i);
    if (x != y) {
      return x < y;
    }
    i += 1;
  }
  return a.length < b.length;
}

// Sorted copy (stable merge sort, byte order: Python's sorted() on ASCII/UTF-8 text).
export function sortedStrings(xs: string[]): string[] {
  if (xs.length <= 1) {
    return xs;
  }
  const mid = xs.length / 2;
  let l: string[] = [];
  let r: string[] = [];
  let i: usize = 0;
  while (i < xs.length) {
    if (i < mid) {
      l.push(xs[i]);
    } else {
      r.push(xs[i]);
    }
    i += 1;
  }
  const a = sortedStrings(l);
  const b = sortedStrings(r);
  let out: string[] = [];
  let p: usize = 0;
  let q: usize = 0;
  while (p < a.length && q < b.length) {
    if (lessThan(b[q], a[p])) {
      out.push(b[q]);
      q += 1;
    } else {
      out.push(a[p]);
      p += 1;
    }
  }
  while (p < a.length) {
    out.push(a[p]);
    p += 1;
  }
  while (q < b.length) {
    out.push(b[q]);
    q += 1;
  }
  return out;
}

// ------------------------------------------------------------------------------------------------ unified diff

// One line of an alignment: kind 0 = equal, 1 = only in a (deleted), 2 = only in b (inserted).
type Edit = { kind: int; text: string; ai: usize; bi: usize; };

// Alignment of the lines of `a` and `b` (a longest common subsequence). Common prefix and suffix are stripped first; a
// middle too large for the quadratic table is reported as one replacement.
function align(a: string[], b: string[]): Edit[] {
  let out: Edit[] = [];
  let pre: usize = 0;
  while (pre < a.length && pre < b.length && a[pre] == b[pre]) {
    out.push(Edit { kind: 0, text: a[pre], ai: pre, bi: pre });
    pre += 1;
  }
  let sa = a.length;
  let sb = b.length;
  while (sa > pre && sb > pre && a[sa - 1] == b[sb - 1]) {
    sa -= 1;
    sb -= 1;
  }
  const n = sa - pre;
  const m = sb - pre;
  if (n > 0 && m > 0 && n * m <= 4000000) {
    // t[i * (m + 1) + j] = length of the LCS of a[pre + i ..] and b[pre + j ..]
    let t: usize[] = [];
    let k: usize = 0;
    while (k < (n + 1) * (m + 1)) {
      t.push(0);
      k += 1;
    }
    let i = n;
    while (i > 0) {
      i -= 1;
      let j = m;
      while (j > 0) {
        j -= 1;
        if (a[pre + i] == b[pre + j]) {
          t[i * (m + 1) + j] = t[(i + 1) * (m + 1) + j + 1] + 1;
        } else {
          const down = t[(i + 1) * (m + 1) + j];
          const right = t[i * (m + 1) + j + 1];
          t[i * (m + 1) + j] = down >= right ? down : right;
        }
      }
    }
    let x: usize = 0;
    let y: usize = 0;
    // inside a run of changes, deletions come before insertions (as the opcodes of difflib are printed)
    let dels: Edit[] = [];
    let adds: Edit[] = [];
    while (x < n || y < m) {
      if (x < n && y < m && a[pre + x] == b[pre + y]) {
        for (const d of dels) { out.push(d); }
        for (const d of adds) { out.push(d); }
        dels = [];
        adds = [];
        out.push(Edit { kind: 0, text: a[pre + x], ai: pre + x, bi: pre + y });
        x += 1;
        y += 1;
      } else if (y >= m || (x < n && t[(x + 1) * (m + 1) + y] >= t[x * (m + 1) + y + 1])) {
        dels.push(Edit { kind: 1, text: a[pre + x], ai: pre + x, bi: pre + y });
        x += 1;
      } else {
        adds.push(Edit { kind: 2, text: b[pre + y], ai: pre + x, bi: pre + y });
        y += 1;
      }
    }
    for (const d of dels) { out.push(d); }
    for (const d of adds) { out.push(d); }
  } else {
    let x: usize = 0;
    while (x < n) {
      out.push(Edit { kind: 1, text: a[pre + x], ai: pre + x, bi: pre });
      x += 1;
    }
    let y: usize = 0;
    while (y < m) {
      out.push(Edit { kind: 2, text: b[pre + y], ai: sa, bi: pre + y });
      y += 1;
    }
  }
  let s = sa;
  let u = sb;
  while (s < a.length) {
    out.push(Edit { kind: 0, text: a[s], ai: s, bi: u });
    s += 1;
    u += 1;
  }
  return out;
}

// difflib's format_range_unified.
function rangeText(start: usize, length: usize): string {
  let beginning = start + 1;
  if (length == 1) {
    return beginning.toString();
  }
  if (length == 0) {
    beginning -= 1;
  }
  return beginning.toString() + "," + length.toString();
}

// difflib.unified_diff(a, b, fromfile, tofile, lineterm="", n=context), as one string ("" when the sequences are equal).
export function unifiedDiff(a: string[], b: string[], fromFile: string, toFile: string, context: usize): string {
  const edits = align(a, b);
  let changed = false;
  for (const e of edits) {
    if (e.kind != 0) {
      changed = true;
    }
  }
  if (!changed) {
    return "";
  }
  // hunks: ranges [lo, hi) of `edits`: every change with `context` equal lines around it; an equal run longer than
  // 2 * context separates two hunks
  let lines: string[] = ["--- " + fromFile, "+++ " + toFile];
  let i: usize = 0;
  while (i < edits.length) {
    while (i < edits.length && edits[i].kind == 0) {
      i += 1;
    }
    if (i >= edits.length) {
      break;
    }
    let lo = i >= context ? i - context : 0;
    // extend over changes and short equal runs
    let end = i;
    while (true) {
      while (end < edits.length && edits[end].kind != 0) {
        end += 1;
      }
      let run = end;
      while (run < edits.length && edits[run].kind == 0) {
        run += 1;
      }
      if (run >= edits.length || run - end > 2 * context) {
        break;
      }
      end = run;
    }
    let hi = end + context;
    if (hi > edits.length) {
      hi = edits.length;
    }
    // equal run at the end of the hunk may be shorter than `context`
    let aLen: usize = 0;
    let bLen: usize = 0;
    let body: string[] = [];
    let k = lo;
    while (k < hi) {
      const e = edits[k];
      if (e.kind == 0) {
        body.push(" " + e.text);
        aLen += 1;
        bLen += 1;
      } else if (e.kind == 1) {
        body.push("-" + e.text);
        aLen += 1;
      } else {
        body.push("+" + e.text);
        bLen += 1;
      }
      k += 1;
    }
    const first = edits[lo];
    lines.push("@@ -" + rangeText(first.ai, aLen) + " +" + rangeText(first.bi, bLen) + " @@");
    for (const l of body) {
      lines.push(l);
    }
    i = hi;
  }
  return lines.join("\n");
}
