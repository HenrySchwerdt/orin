#!/bin/sh
# orin — launcher for a release package of the Orin compiler.
# Layout: bin/orin (this script), libexec/orin (compiler), lib/orin/runtime/ (C runtime).
#   orin build <file.or|dir> [-o <exe>]   compile to a native executable (needs a C compiler);
#                                         a directory containing orin.toml is a package (its entry is built)
#   orin run <file.or|dir> [args...]      build to a temp dir and run
#   orin <anything else>              forwarded to the compiler (check, compile, fmt, lsp, ...)
set -e
HERE=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
BIN="$HERE/libexec/orin"
RT="$HERE/lib/orin/runtime"
CC=${CC:-cc}

native() { # native <src> <exe>
  tmp=$(mktemp -d)
  "$BIN" compile "$1" -o "$tmp/out.c" || { rm -rf "$tmp"; exit 1; }
  $CC -O2 -w -I "$RT" "$tmp/out.c" "$RT"/*.c -o "$2" || { rm -rf "$tmp"; exit 1; }
  rm -rf "$tmp"
}

case "${1:-}" in
  build)
    [ $# -ge 2 ] || { echo "usage: orin build <file.or|package-dir> [-o <exe>]" >&2; exit 2; }
    src=$2; out=$(basename "$src" .or)
    if [ -d "$src" ]; then out=$(basename "$(CDPATH= cd -- "$src" && pwd)"); fi
    if [ "${3:-}" = "-o" ] && [ -n "${4:-}" ]; then out=$4; fi
    native "$src" "$out"
    ;;
  run)
    [ $# -ge 2 ] || { echo "usage: orin run <file.or|package-dir> [args...]" >&2; exit 2; }
    src=$2; shift 2
    dir=$(mktemp -d)
    native "$src" "$dir/prog"
    set +e; "$dir/prog" "$@"; st=$?; set -e
    rm -rf "$dir"; exit $st
    ;;
  --version|version)
    cat "$HERE/VERSION"
    ;;
  *)
    exec "$BIN" "$@"
    ;;
esac
