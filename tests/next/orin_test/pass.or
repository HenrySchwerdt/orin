// `orin test` fixture: every test passes; the program's own main is not run by `orin test`.
import { assertEq, assert } from "std:test";
import { exit } from "std:process";

type Pair = { a: int; b: int; };

function add(p: Pair): int {
  return p.a + p.b;
}

@Test
function addsPairs(): void {
  assertEq(add(Pair { a: 1, b: 2 }), 3, "pair");
}

@Test
function closuresAndArrays(): void {
  const ys = [1, 2, 3].map(x => x + 1).filter(x => x > 2);
  assertEq(ys.length.toInt(), 2, "filtered");
}

@Test
function stdoutIsCaptured(): void {
  console.log("this line is hidden for passing tests");
  assert(true, "ok");
}

function main(): void {
  console.log("main must not run under orin test");
  exit(9);
}
