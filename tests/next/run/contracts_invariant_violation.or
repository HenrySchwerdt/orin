// flags: --check-contracts
// exit: 101
// stderr: contract violated: @Invariant(this.n >= 0)
@Invariant(this.n >= 0)
class Counter {
  n: int;

  constructor(start: int) {
    this.n = start;
  }

  add(d: int): void {
    this.n += d;
  }
}

function main(): void {
  let c = new Counter(2);
  c.add(-1);
  console.log("ok");
  c.add(-5);
  console.log("after");
}
