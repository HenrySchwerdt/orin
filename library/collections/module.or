// Array API prelude (spec 08, ADR-0011): entry of the `$array` prelude root. The functions live in
// array.or; the checker rewrites `xs.map(f)` etc. to calls of them (check/body.or, arrayApiCall).
export { map, filter, find, findIndex, some, every, reduce, forEach, sort } from "./array";
export { indexOfInt, indexOfUsize, indexOfBool, indexOfString } from "./array";
export { includesInt, includesUsize, includesBool, includesString } from "./array";
// Map<K, V> (ADR-0018): the checker maps `Map`, `MapEntry`, `new Map<K, V>()` and the map methods to map.or.
export { Map, MapEntry, keyHash, keyEq, hashInt, hashUsize, hashBool, hashString, eqInt, eqUsize, eqBool, eqString } from "./map";
export { mapNew, mapGet, mapHas, mapSet, mapDelete, mapKeys, mapValues, mapEntries } from "./map";
