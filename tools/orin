#!/bin/sh
# Use the release CLI against this checkout without replacing an installed Orin.
set -eu
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
(cd "$ROOT" && tools/dev.sh >&2)
LAYOUT=$ROOT/build/dev-install
mkdir -p "$LAYOUT/bin" "$LAYOUT/libexec" "$LAYOUT/lib/orin"
cp "$ROOT/dist/orin" "$LAYOUT/bin/orin"
ln -sfn "$ROOT/dist/orin-cli.sh" "$LAYOUT/bin/orin-cli.sh"
ln -sfn "$ROOT/build/dev/orin" "$LAYOUT/libexec/orin"
ln -sfn "$ROOT/runtime" "$LAYOUT/lib/orin/runtime"
ln -sfn "$ROOT/platform" "$LAYOUT/lib/orin/platform"
ln -sfn "$ROOT/dist/llvm.pin" "$LAYOUT/lib/orin/llvm.pin"
ln -sfn "$ROOT/examples" "$LAYOUT/examples"
printf 'development\n' > "$LAYOUT/VERSION"
exec "$LAYOUT/bin/orin" "$@"
