function main(): void {
  const xs = [1, 2, 3, 4, 5, 6];
  let sum = 0;
  for (const x of xs) {
    sum += x;
  }
  console.log(sum.toString());
  let odd = 0;
  for (const x of xs) {
    if (x % 2 == 0) { continue; }
    odd += x;
  }
  console.log(odd.toString());
  let firstBig = 0;
  for (const x of xs) {
    if (x > 3) {
      firstBig = x;
      break;
    }
  }
  console.log(firstBig.toString());
  const words = ["a", "bb", "ccc"];
  let total: usize = 0;
  let acc = "";
  for (const w of words) {
    total += w.length;
    acc = acc + w + "|";
  }
  console.log(total.toString());
  console.log(acc);
  for (const x of xs.slice(0, 2)) {
    console.log(x.toString());
  }
}
