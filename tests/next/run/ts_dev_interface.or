// Orin for TypeScript developers: nominal interfaces, no inheritance.
interface Shape {
  area(): int;
}

class Square implements Shape {
  constructor(public side: int) {}
  area(): int { return this.side * this.side; }
}

class Rect implements Shape {
  constructor(public w: int, public h: int) {}
  area(): int { return this.w * this.h; }
}

function total<T extends Shape>(xs: T[]): int {
  let t = 0;
  for (const x of xs) { t += x.area(); }
  return t;
}

function main(): void {
  const shapes: Shape[] = [new Square(2), new Rect(2, 3)];
  let sum = 0;
  for (const s of shapes) { sum += s.area(); }
  console.log(`${sum}`);
  console.log(`${total([new Square(2), new Square(3)])}`);
}
