function show(xs: int[]): string {
  let s = "[";
  let i: usize = 0;
  while (i < xs.length) {
    if (i > 0) { s = s + ","; }
    s = s + xs[i].toString();
    i += 1;
  }
  return s + "]";
}

function main(): void {
  let grid = [[1, 2], [3, 4]];
  const snap = grid;
  grid[0][1] = 20;
  grid[1].push(5);
  console.log(show(grid[0]));
  console.log(show(grid[1]));
  console.log(show(snap[0]));
  console.log(show(snap[1]));
  grid.push([7]);
  console.log(grid.length.toString());
  console.log(snap.length.toString());
  let rows: int[][] = [];
  rows.push([1]);
  rows.push([2, 3]);
  console.log(rows.length.toString());
  console.log(rows[1][1].toString());
}
