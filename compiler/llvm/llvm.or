    "declare i64 @orin_rt_task_join(i64)",
    "declare ptr @orin_rt_task_message()",
    "declare void @orin_rt_trap_str(ptr)",
    "declare i64 @orin_cap_net(i64)",
    "declare i64 @orin_cap_listen(i64, ptr, i64)",
    "declare i64 @orin_cap_connect(i64, ptr, i64, i64)",
    "declare i64 @orin_net_listen(i64, ptr, i64, i64, i64)",
    "declare i64 @orin_net_accept(i64, i64, i64)",
    "declare i64 @orin_net_connect(i64, ptr, i64, i64, i64)",
    "declare i64 @orin_net_status(i64)",
    "declare void @orin_net_close(i64)",
    "declare i64 @orin_net_port(i64)",
    "declare i64 @orin_net_now(i64)",
    "declare ptr @orin_net_recv(i64, i64, i64)",
    "declare ptr @orin_net_send(i64, ptr, i64, i64, i64)",
    "declare i64 @orin_net_shutdown(i64, i64)",
    "declare ptr @orin_net_peer(i64)",
    "declare ptr @orin_net_resolve(i64, ptr)",
    "declare ptr @orin_net_error_text(i64)",
    "declare i64 @orin_file_is_open(i64)",
    "declare ptr @orin_file_open_error(i64)",
    "declare ptr @orin_file_close(i64)",
    "declare ptr @orin_file_read_line(i64)",
    "declare ptr @orin_file_read(i64, i64)",
    "declare ptr @orin_file_read_all(i64)",
    "declare void @orin_file_write(i64, ptr)",
    "declare void @orin_file_write_line(i64, ptr)",
    "declare void @orin_file_flush(i64)",
    "declare ptr @orin_process_args(i64)",
    "declare void @orin_process_exit(i64)",
    "declare ptr @orinl_io_read_bytes(i64, i64)",
    "declare ptr @orinl_io_read_line(i64)",
    "declare void @orinl_io_write_stdout(i64, ptr)",
    "declare i64 @orinl_str_char_code_at(ptr, i64)",
    "declare i64 @orinl_io_shell(i64, ptr)",
    "declare i64 @orinl_time_now_millis(i64)",
    "declare ptr @orin_str_char_at(ptr, i64)",
    "declare ptr @orin_str_substring(ptr, i64, i64)",
    "declare ptr @orin_str_index_of(ptr, ptr)",
    "declare i64 @orin_str_includes(ptr, ptr)",
    "declare i64 @orin_str_starts_with(ptr, ptr)",
    "declare i64 @orin_str_ends_with(ptr, ptr)",
    "declare ptr @orin_str_split(ptr, ptr)",
    "declare ptr @orin_str_trim(ptr)",
    "declare ptr @orin_array_get(ptr, i64)",
    "declare ptr @orin_array_slice(ptr, i64, i64)",
    "declare ptr @orin_array_concat(ptr, ptr)",
    "declare ptr @orin_array_join(ptr, ptr)",
    "declare ptr @orin_bytes_to_string(ptr, i64, i64)",
    "declare ptr @orin_string_to_bytes(ptr)",
    "declare ptr @orin_array_extend(ptr, ptr)",
    "declare ptr @orin_int_to_string(i64)",
    "declare ptr @orin_usize_to_string(i64)",
    "declare ptr @orin_bool_to_string(i64)",
    "declare ptr @orin_parse_float(ptr)",
    "declare i64 @orin_int_op(i64, i64, i64, i64)",
    "declare ptr @orin_int_chk(i64, i64, i64, i64)",
    "declare ptr @orin_parse_int_k(ptr, i64)",
    "declare ptr @orin_float_to_string(double)",
    "declare ptr @orin_f32_to_string(double)",
    "declare i64 @orin_float_to_int(double)",
    "declare double @llvm.floor.f64(double)",
    "declare double @llvm.ceil.f64(double)",
    "declare double @llvm.round.f64(double)",
    "declare double @llvm.sqrt.f64(double)",
    "declare double @llvm.fabs.f64(double)",
    "declare double @llvm.pow.f64(double, double)",
    "declare { i64, i1 } @llvm.sadd.with.overflow.i64(i64, i64)",
    "declare { i64, i1 } @llvm.ssub.with.overflow.i64(i64, i64)",
    "declare { i64, i1 } @llvm.smul.with.overflow.i64(i64, i64)",
    "declare { i64, i1 } @llvm.uadd.with.overflow.i64(i64, i64)",
    "declare { i64, i1 } @llvm.usub.with.overflow.i64(i64, i64)",
    "declare { i64, i1 } @llvm.umul.with.overflow.i64(i64, i64)"
  ];
  return d.join("\n") + "\n";
}

// ---------------------------------------------------------------- operands

function opTy(fx: Fx, o: Operand): MType {
  return match (o) {
    OLocal(l) => fx.f.locals[l].ty,
    OInt(_) => MInt,
    OUsize(_) => MUsize,
    OBool(_) => MBool,
    OFloat(_) => MFloat,
    OStr(_) => MRef
  };
}

// SSA value of operand `n` of the instruction named `p` (a load result for locals).
function ov(p: string, n: usize, o: Operand): string {
  return match (o) {
    OLocal(_) => p + "o" + u(n),
    OInt(v) => v.toString(),
    OUsize(v) => v.toString(),
    OBool(b) => b ? "1" : "0",
    OFloat(t) => t,
    OStr(i) => "@orin_s" + u(i)
  };
}

// The load that materialises operand `n` ("" for constants).
function ld(fx: Fx, p: string, n: usize, o: Operand): string {
  return match (o) {
    OLocal(l) => "  " + ov(p, n, o) + " = load " + lty(fx.f.locals[l].ty) + ", ptr %l" + u(l) + "\n",
    _ => ""
  };
}

function targ(fx: Fx, p: string, n: usize, o: Operand): string {
  return lty(opTy(fx, o)) + " " + ov(p, n, o);
}

// The address of the local an operand names (the in/out argument of a call, docs/mir.md v1.10).
function operandPtr(o: Operand): string {
  return match (o) {
    OLocal(l) => "%l" + u(l),
    _ => "null"
  };
}

function loadsOf(fx: Fx, p: string, os: Operand[]): string {
  let s = "";
  let i: usize = 0;
  while (i < os.length) {
    s += ld(fx, p, i, os[i]);
    i += 1;
  }
  return s;
}

function argList(fx: Fx, p: string, os: Operand[]): string {
  let parts: string[] = [];
  let i: usize = 0;
  while (i < os.length) {
    parts.push(targ(fx, p, i, os[i]));
    i += 1;
  }
  return parts.join(", ");
}

function st(fx: Fx, d: usize, val: string): string {
  return "  store " + lty(fx.f.locals[d].ty) + " " + val + ", ptr %l" + u(d) + "\n";
}

// Unchecked slot address: only for an object that `orin_struct_new` just returned in the same instruction
// sequence with a constant slot count that covers `k` (closure and interface construction).
function slotGep(name: string, base: string, k: usize): string {
  return "  " + name + " = getelementptr inbounds i8, ptr " + base + ", i64 " + u(32 + 8 * k) + "\n";
}

// Checked slot address for an object of unknown provenance: traps unless it is a struct with more than `k` slots
// (defence in depth against shape confusion, same check as `orin_chk_slot` in the C runtime).
function slotChk(name: string, base: string, k: usize): string {
  return "  " + name + " = call ptr @orinl_slot(ptr " + base + ", i64 " + u(k) + ")\n";
}

// Slot value as an i64 for the array push helper (references are converted).
function asSlot(fx: Fx, p: string, n: usize, o: Operand): string {
  if (isRefT(opTy(fx, o))) {
    return "  " + p + "q" + u(n) + " = ptrtoint ptr " + ov(p, n, o) + " to i64\n";
  }
  if (isFloatT(opTy(fx, o))) {
    return "  " + p + "q" + u(n) + " = bitcast double " + ov(p, n, o) + " to i64\n";
  }
  return "";
}

function slotVal(fx: Fx, p: string, n: usize, o: Operand): string {
  if (isRefT(opTy(fx, o)) || isFloatT(opTy(fx, o))) {
    return p + "q" + u(n);
  }
  return ov(p, n, o);
}

function lbl(p: string, sfx: string): string {
  return p.substring(1, p.length) + sfx;
}

function maskOf(fx: Fx, os: Operand[]): usize {
  let m: usize = 0;
  let pw: usize = 1;
  let i: usize = 0;
  while (i < os.length) {
    if (isRefT(opTy(fx, os[i]))) {
      m += pw;
    }
    if (i < 63) {
      pw *= 2;
    }
    i += 1;
  }
  return m;
}

// ---------------------------------------------------------------- operators and builtins

function arithHelper(op: BinOp, usz: bool): string {
  const suffix = usz ? "_u" : "_i";
  const name = match (op) {
    OpAdd => "add",
    OpSub => "sub",
    OpMul => "mul",
    OpDiv => "div",
    OpRem => "rem",
    _ => "?"
  };
  return "@orinl_" + name + suffix;
}

function cmpPred(op: BinOp, usz: bool): string {
  return match (op) {
    OpEq => "eq",
    OpNe => "ne",
    OpLt => usz ? "ult" : "slt",
    OpLe => usz ? "ule" : "sle",
    OpGt => usz ? "ugt" : "sgt",
    _ => usz ? "uge" : "sge"
  };
}

function fcmpPred(op: BinOp): string {
  return match (op) {
    OpEq => "oeq",
    OpNe => "une",
    OpLt => "olt",
    OpLe => "ole",
    OpGt => "ogt",
    _ => "oge"
  };
}

// IEEE operations on doubles: no traps; `!=` is true for NaN (une), every other comparison false.
function binaryF(fx: Fx, p: string, d: usize, op: BinOp, a: Operand, b: Operand): string {
  const va = ov(p, 0, a);
  const vb = ov(p, 1, b);
  const r = p + "r";
  const pre = ld(fx, p, 0, a) + ld(fx, p, 1, b);
  return pre + match (op) {
    OpAdd => "  " + r + " = fadd double " + va + ", " + vb + "\n" + st(fx, d, r),
    OpSub => "  " + r + " = fsub double " + va + ", " + vb + "\n" + st(fx, d, r),
    OpMul => "  " + r + " = fmul double " + va + ", " + vb + "\n" + st(fx, d, r),
    OpDiv => "  " + r + " = fdiv double " + va + ", " + vb + "\n" + st(fx, d, r),
    _ => "  " + p + "c = fcmp " + fcmpPred(op) + " double " + va + ", " + vb + "\n  " + r + " = zext i1 " + p + "c to i64\n" + st(fx, d, r)
  };
}

function binaryI(fx: Fx, p: string, d: usize, op: BinOp, a: Operand, b: Operand): string {
  const t = opTy(fx, a);
  if (isFloatT(t)) {
    return binaryF(fx, p, d, op, a, b);
  }
  const va = ov(p, 0, a);
  const vb = ov(p, 1, b);
  const r = p + "r";
  const pre = ld(fx, p, 0, a) + ld(fx, p, 1, b);
  if (isRefT(t)) {
    // string equality
    let s = pre + "  " + r + " = call i64 @orin_str_eq(ptr " + va + ", ptr " + vb + ")\n";
    if (isNe(op)) {
      s += "  " + p + "x = xor i64 " + r + ", 1\n" + st(fx, d, p + "x");
      return s;
    }
    return s + st(fx, d, r);
  }
  const usz = isUsizeT(t);
  return pre + match (op) {
    OpAdd => callBin(r, arithHelper(op, usz), va, vb) + st(fx, d, r),
    OpSub => callBin(r, arithHelper(op, usz), va, vb) + st(fx, d, r),
    OpMul => callBin(r, arithHelper(op, usz), va, vb) + st(fx, d, r),
    OpDiv => callBin(r, arithHelper(op, usz), va, vb) + st(fx, d, r),
    OpRem => callBin(r, arithHelper(op, usz), va, vb) + st(fx, d, r),
    OpAnd => "  " + r + " = and i64 " + va + ", " + vb + "\n" + st(fx, d, r),
    OpOr => "  " + r + " = or i64 " + va + ", " + vb + "\n" + st(fx, d, r),
    _ => "  " + p + "c = icmp " + cmpPred(op, usz) + " i64 " + va + ", " + vb + "\n  " + r + " = zext i1 " + p + "c to i64\n" + st(fx, d, r)
  };
}

function isNe(op: BinOp): bool {
  return match (op) {
    OpNe => true,
    _ => false
  };
}

function callBin(r: string, fn: string, a: string, b: string): string {
  return "  " + r + " = call i64 " + fn + "(i64 " + a + ", i64 " + b + ")\n";
}

function unaryI(fx: Fx, p: string, d: usize, op: UnOp, o: Operand): string {
  const v = ov(p, 0, o);
  const pre = ld(fx, p, 0, o);
  if (isFloatT(fx.f.locals[d].ty)) {
    return pre + "  " + p + "r = fneg double " + v + "\n" + st(fx, d, p + "r");
  }
  return pre + match (op) {
    UnNot => "  " + p + "c = icmp eq i64 " + v + ", 0\n  " + p + "r = zext i1 " + p + "c to i64\n" + st(fx, d, p + "r"),
    UnNeg => "  " + p + "r = call i64 @orinl_" + (isUsizeT(fx.f.locals[d].ty) ? "neg_u" : "neg_i") + "(i64 " + v + ")\n" + st(fx, d, p + "r")
  };
}

// Name of the C runtime function for builtins that are a plain call ("" for inline ones).
function bname(op: Builtin): string {
  return match (op) {
    BConsoleLog => "orin_console_log",
    BConsoleError => "orin_console_error",
    BStringFromCharCode => "orin_string_from_char_code",
    BParseInt => "orin_parse_int",
    BFsReadFile => "orin_fs_read_file",
    BFsWriteFile => "orin_fs_write_file",
    BFsExists => "orin_fs_exists",
    BProcessArgs => "orin_process_args",
    BProcessExit => "orin_process_exit",
    BIoReadBytes => "orinl_io_read_bytes",
    BIoReadLine => "orinl_io_read_line",
    BIoWriteStdout => "orinl_io_write_stdout",
    BIoShell => "orinl_io_shell",
    BTimeNowMillis => "orinl_time_now_millis",
    BGrantFs => "orin_cap_fs",
    BGrantProcess => "orin_cap_process",
    BGrantStdio => "orin_cap_stdio",
    BGrantClock => "orin_cap_clock",
    BGrantUnder => "orin_cap_under",
    BGrantReadOnly => "orin_cap_read_only",
    BGrantArgsOnly => "orin_cap_args_only",
    BGrantRevoke => "orin_cap_revoke",
    BTask(k) => taskOpC(k),
    BGrantNet => "orin_cap_net",
    BGrantListen => "orin_cap_listen",
    BGrantConnect => "orin_cap_connect",
    BNetListen => "orin_net_listen",
    BNetAccept => "orin_net_accept",
    BNetConnect => "orin_net_connect",
    BNetStatus => "orin_net_status",
    BNetClose => "orin_net_close",
    BNetPort => "orin_net_port",
    BNetNow => "orin_net_now",
    BNetRecv => "orin_net_recv",
    BNetSend => "orin_net_send",
    BNetShutdown => "orin_net_shutdown",
    BNetPeer => "orin_net_peer",
    BNetResolve => "orin_net_resolve",
    BNetErrorText => "orin_net_error_text",
    BFileOpen => "orin_file_open",
    BFileIsOpen => "orin_file_is_open",
    BFileOpenError => "orin_file_open_error",
    BFileClose => "orin_file_close",
    BFileReadLine => "orin_file_read_line",
    BFileRead => "orin_file_read",
    BFileReadAll => "orin_file_read_all",
    BFileWrite => "orin_file_write",
    BFileWriteLine => "orin_file_write_line",
    BFileFlush => "orin_file_flush",
    BStrCharCodeAt => "orinl_str_char_code_at",
    BStrCharAt => "orin_str_char_at",
    BStrSubstring => "orin_str_substring",
    BStrIndexOf => "orin_str_index_of",
    BStrIncludes => "orin_str_includes",
    BStrStartsWith => "orin_str_starts_with",
    BStrEndsWith => "orin_str_ends_with",
    BStrSplit => "orin_str_split",
    BStrTrim => "orin_str_trim",
    BArrGet => "orin_array_get",
    BArrSlice => "orin_array_slice",
    BArrConcat => "orin_array_concat",
    BArrJoin => "orin_array_join",
    BBytesToString => "orin_bytes_to_string",
    BStringToBytes => "orin_string_to_bytes",
    BIntToString => "orin_int_to_string",
    BUsizeToString => "orin_usize_to_string",
    BBoolToString => "orin_bool_to_string",
    BParseFloat => "orin_parse_float",
    BFloatToString => "orin_float_to_string",
    BF32ToString => "orin_f32_to_string",
    BFloatToInt => "orin_float_to_int",
    BIntToUsize => "orinl_int_to_usize",
    BUsizeToInt => "orinl_usize_to_int",
    BIntRange => "orinl_range",
    BIntConv => "orinl_conv_i",
    BUIntConv => "orinl_conv_u",
    BIntOp => "orin_int_op",
    BIntChk => "orin_int_chk",
    BParseIntK => "orin_parse_int_k",
    _ => ""
  };
}

function bret(op: Builtin): string {
  return match (op) {
    BConsoleLog => "void",
    BConsoleError => "void",
    BIoWriteStdout => "void",
    BProcessExit => "void",
    BFsExists => "i64",
    BFileOpen => "i64",
    BGrantFs => "i64",
    BGrantProcess => "i64",
    BGrantStdio => "i64",
    BGrantClock => "i64",
    BGrantUnder => "i64",
    BGrantReadOnly => "i64",
    BGrantArgsOnly => "i64",
    BGrantRevoke => "void",
    BTask(k) => taskOpRet(k) == 0 ? "void" : (taskOpRet(k) == 1 ? "i64" : "ptr"),
    BGrantNet => "i64",
    BGrantListen => "i64",
    BGrantConnect => "i64",
    BNetListen => "i64",
    BNetAccept => "i64",
    BNetConnect => "i64",
    BNetStatus => "i64",
    BNetClose => "void",
    BNetPort => "i64",
    BNetNow => "i64",
    BNetShutdown => "i64",
    BFileIsOpen => "i64",
    BFileWrite => "void",
    BFileWriteLine => "void",
    BFileFlush => "void",
    BIoShell => "i64",
    BTimeNowMillis => "i64",
    BStrCharCodeAt => "i64",
    BStrIncludes => "i64",
    BStrStartsWith => "i64",
    BStrEndsWith => "i64",
    BIntToUsize => "i64",
    BUsizeToInt => "i64",
    BFloatToInt => "i64",
    BIntRange => "i64",
    BIntConv => "i64",
    BUIntConv => "i64",
    BIntOp => "i64",
    _ => "ptr"
  };
}

function dupIf(rt: MType, p: string, raw: string): R {
  if (isRefT(rt)) {
    return R { text: "  " + p + "q = inttoptr i64 " + raw + " to ptr\n  " + p + "d = call ptr @orinl_dup(ptr " + p + "q)\n", val: p + "d" };
  }
  return R { text: "", val: raw };
}

function builtinR(fx: Fx, p: string, b: Builtin, args: Operand[], rt: MType): R {
  const a0 = args.length > 0 ? ov(p, 0, args[0]) : "";
  const r = p + "r";
  const name = bname(b);
  if (name != "") {
    const ret = bret(b);
    if (ret == "void") {
      return R { text: "  call void @" + name + "(" + argList(fx, p, args) + ")\n", val: "" };
    }
    return R { text: "  " + r + " = call " + ret + " @" + name + "(" + argList(fx, p, args) + ")\n", val: r };
  }
  return match (b) {
    BStrLength => lenR(p, a0),
    BArrLength => lenR(p, a0),
    BOptIsSome => tagIs(p, a0, 0),
    BOptIsNone => tagIs(p, a0, 1),
    BResIsOk => tagIs(p, a0, 0),
    BResIsErr => tagIs(p, a0, 1),
    BOptUnwrap => unwrapR(p, "orin_opt_unwrap", a0, rt),
    BResUnwrap => unwrapR(p, "orin_res_unwrap", a0, rt),
    BResUnwrapErr => unwrapR(p, "orin_res_unwrap_err", a0, rt),
    BIntToFloat => R { text: "  " + r + " = sitofp i64 " + a0 + " to double\n", val: r },
    BUsizeToFloat => R { text: "  " + r + " = uitofp i64 " + a0 + " to double\n", val: r },
    BF32Round => R { text: "  " + p + "f = fptrunc double " + a0 + " to float\n  " + r + " = fpext float " + p + "f to double\n", val: r },
    BF32ToFloat => R { text: "", val: a0 },
    BIntId => R { text: "", val: a0 },
    BFloatFloor => R { text: "  " + r + " = call double @llvm.floor.f64(double " + a0 + ")\n", val: r },
    BFloatCeil => R { text: "  " + r + " = call double @llvm.ceil.f64(double " + a0 + ")\n", val: r },
    BFloatRound => R { text: "  " + r + " = call double @llvm.round.f64(double " + a0 + ")\n", val: r },
    BFloatSqrt => R { text: "  " + r + " = call double @llvm.sqrt.f64(double " + a0 + ")\n", val: r },
    BFloatAbs => R { text: "  " + r + " = call double @llvm.fabs.f64(double " + a0 + ")\n", val: r },
    BFloatPow => R { text: "  " + r + " = call double @llvm.pow.f64(double " + a0 + ", double " + ov(p, 1, args[1]) + ")\n", val: r },
    BFloatIsNaN => R { text: "  " + p + "c = fcmp uno double " + a0 + ", " + a0 + "\n  " + r + " = zext i1 " + p + "c to i64\n", val: r },
    BFloatIsFinite => R {
      text: "  " + p + "a = call double @llvm.fabs.f64(double " + a0 + ")\n  " + p + "c = fcmp olt double " + p + "a, 0x7FF0000000000000\n  "
        + r + " = zext i1 " + p + "c to i64\n",
      val: r
    },
    _ => unwrapOrR(fx, p, a0, args[1], rt)
  };
}

function lenR(p: string, a0: string): R {
  return R { text: "  " + p + "g = getelementptr inbounds i8, ptr " + a0 + ", i64 16\n  " + p + "r = load i64, ptr " + p + "g\n", val: p + "r" };
}

function tagIs(p: string, a0: string, k: usize): R {
  return R {
    text: "  " + p + "g = getelementptr inbounds i8, ptr " + a0 + ", i64 12\n  " + p + "t = load i32, ptr " + p + "g\n  "
      + p + "c = icmp eq i32 " + p + "t, " + u(k) + "\n  " + p + "r = zext i1 " + p + "c to i64\n",
    val: p + "r"
  };
}

function unwrapR(p: string, fn: string, a0: string, rt: MType): R {
  const call = "  " + p + "r = call i64 @" + fn + "(ptr " + a0 + ")\n";
  if (isFloatT(rt)) {
    return R { text: call + "  " + p + "f = bitcast i64 " + p + "r to double\n", val: p + "f" };
  }
  const d = dupIf(rt, p, p + "r");
  return R { text: call + d.text, val: d.val };
}

function unwrapOrR(fx: Fx, p: string, a0: string, dflt: Operand, rt: MType): R {
  const ty = isRefT(rt) ? "ptr" : (isFloatT(rt) ? "double" : "i64");
  const lt = lbl(p, "Lt");
  const lf = lbl(p, "Lf");
  const lj = lbl(p, "Lj");
  const text = "  " + p + "g = getelementptr inbounds i8, ptr " + a0 + ", i64 12\n  " + p + "t = load i32, ptr " + p + "g\n"
    + "  " + p + "c = icmp eq i32 " + p + "t, 0\n  br i1 " + p + "c, label %" + lt + ", label %" + lf + "\n"
    + lt + ":\n" + slotChk(p + "s", a0, 0) + "  " + p + "v = load " + ty + ", ptr " + p + "s\n  br label %" + lj + "\n"
    + lf + ":\n  br label %" + lj + "\n"
    + lj + ":\n  " + p + "m = phi " + ty + " [ " + p + "v, %" + lt + " ], [ " + ov(p, 1, dflt) + ", %" + lf + " ]\n";
  if (isRefT(rt)) {
    return R { text: text + "  " + p + "d = call ptr @orinl_dup(ptr " + p + "m)\n", val: p + "d" };
  }
  return R { text: text, val: p + "m" };
}

// ---------------------------------------------------------------- instructions

function builtinInstr(fx: Fx, p: string, d: Option<usize>, b: Builtin, args: Operand[]): string {
  const pre = loadsOf(fx, p, args);
  return match (d) {
    Some(x) => builtinStore(fx, p, x, pre, builtinR(fx, p, b, args, fx.f.locals[x].ty)),
    None => pre + builtinR(fx, p, b, args, MVoid).text
  };
}

function builtinStore(fx: Fx, p: string, x: usize, pre: string, r: R): string {
  return pre + r.text + st(fx, x, r.val);
}

function callI(fx: Fx, p: string, d: Option<usize>, f: usize, args: Operand[]): string {
  const pre = loadsOf(fx, p, args);
  const callee = fx.prog.functions[f];
  // in/out receiver (docs/mir.md v1.10): pass the address of the argument's local, the callee stores its final receiver there
  const outArg = callee.inout ? ", ptr " + operandPtr(args[0]) : "";
  const call = "call " + lty(callee.ret) + " @" + fx.names[f] + "(" + argList(fx, p, args) + outArg + ")\n";
  return pre + match (d) {
    Some(x) => "  " + p + "r = " + call + st(fx, x, p + "r"),
    None => "  " + call
  };
}

function structNewI(fx: Fx, p: string, d: usize, tag: usize, slots: Operand[]): string {
  let s = loadsOf(fx, p, slots);
  const n = p + "n";
  s += "  " + n + " = call ptr @orin_struct_new(i32 " + u(tag) + ", i32 " + u(slots.length) + ", i64 " + u(maskOf(fx, slots)) + ")\n";
  let k: usize = 0;
  while (k < slots.length) {
    s += slotGep(p + "g" + u(k), n, k);
    s += "  store " + targ(fx, p, k, slots[k]) + ", ptr " + p + "g" + u(k) + "\n";
    k += 1;
  }
  return s + st(fx, d, n);
}

// Closure (docs/mir.md v1.3): struct { code pointer (scalar slot 0), environment (reference slot 1) }; the
// environment is a struct of the captured values (the nullary singleton when nothing is captured).
function closureI(fx: Fx, p: string, d: usize, f: usize, caps: Operand[]): string {
  let s = loadsOf(fx, p, caps);
  let env = p + "e";
  if (caps.length > 0) {
    s += "  " + env + " = call ptr @orin_struct_new(i32 0, i32 " + u(caps.length) + ", i64 " + u(maskOf(fx, caps)) + ")\n";
    let k: usize = 0;
    while (k < caps.length) {
      s += slotGep(p + "g" + u(k), env, k);
      s += "  store " + targ(fx, p, k, caps[k]) + ", ptr " + p + "g" + u(k) + "\n";
      k += 1;
    }
  } else {
    s += "  " + env + " = call ptr @orin_nullary(i32 0)\n";
  }
  const n = p + "n";
  s += "  " + n + " = call ptr @orin_struct_new(i32 0, i32 2, i64 2)\n";
  s += slotGep(p + "c0", n, 0) + "  store ptr @" + fx.names[f] + ", ptr " + p + "c0\n";
  s += slotGep(p + "c1", n, 1) + "  store ptr " + env + ", ptr " + p + "c1\n";
  return s + st(fx, d, n);
}

// Call through a closure: load code pointer and environment, call with the environment first.
function callIndirectI(fx: Fx, p: string, d: Option<usize>, f: Operand, args: Operand[]): string {
  let s = ld(fx, p, 0, f);
  let all: string[] = [];
  let k: usize = 0;
  while (k < args.length) {
    s += ld(fx, p, k + 1, args[k]);
    all.push(targ(fx, p, k + 1, args[k]));
    k += 1;
  }
  const cv = ov(p, 0, f);
  s += slotChk(p + "c0", cv, 0) + "  " + p + "fp = load ptr, ptr " + p + "c0\n";
  s += slotChk(p + "c1", cv, 1) + "  " + p + "ev = load ptr, ptr " + p + "c1\n";
  const rt = match (d) {
    Some(x) => lty(fx.f.locals[x].ty),
    None => "void"
  };
  let argl = "ptr " + p + "ev";
  if (all.length > 0) {
    argl += ", " + all.join(", ");
  }
  const call = "call " + rt + " " + p + "fp(" + argl + ")\n";
  return s + match (d) {
    Some(x) => "  " + p + "r = " + call + st(fx, x, p + "r"),
    None => "  " + call
  };
}

// Interface value (docs/mir.md v1.5, ADR-0019): struct { vtable pointer (scalar slot 0), boxed value
// (reference slot 1) }; the vtable is the constant table `@orin_vtN`.
function ifaceI(fx: Fx, p: string, d: usize, vt: usize, v: Operand): string {
  let s = loadsOf(fx, p, [v]);
  const n = p + "n";
  s += "  " + n + " = call ptr @orin_struct_new(i32 0, i32 2, i64 2)\n";
  s += slotGep(p + "c0", n, 0) + "  store ptr @orin_vt" + u(vt) + ", ptr " + p + "c0\n";
  s += slotGep(p + "c1", n, 1) + "  store " + targ(fx, p, 0, v) + ", ptr " + p + "c1\n";
  return s + st(fx, d, n);
}

// Call through the vtable of an interface value: load the table and the boxed value, call entry `slot`
// with the boxed value first.
function callVirtualI(fx: Fx, p: string, d: Option<usize>, r: Operand, slot: usize, args: Operand[]): string {
  let s = ld(fx, p, 0, r);
  let all: string[] = [];
  let k: usize = 0;
  while (k < args.length) {
    s += ld(fx, p, k + 1, args[k]);
    all.push(targ(fx, p, k + 1, args[k]));
    k += 1;
  }
  const cv = ov(p, 0, r);
  s += slotChk(p + "c0", cv, 0) + "  " + p + "vt = load ptr, ptr " + p + "c0\n";
  s += slotChk(p + "c1", cv, 1) + "  " + p + "ev = load ptr, ptr " + p + "c1\n";
  s += "  " + p + "fg = getelementptr inbounds ptr, ptr " + p + "vt, i64 " + u(slot) + "\n";
  s += "  " + p + "fp = load ptr, ptr " + p + "fg\n";
  const rt = match (d) {
    Some(x) => lty(fx.f.locals[x].ty),
    None => "void"
  };
  let argl = "ptr " + p + "ev";
  if (all.length > 0) {
    argl += ", " + all.join(", ");
  }
  const call = "call " + rt + " " + p + "fp(" + argl + ")\n";
  return s + match (d) {
    Some(x) => "  " + p + "r = " + call + st(fx, x, p + "r"),
    None => "  " + call
  };
}

function arrayNewI(fx: Fx, p: string, d: usize, isRef: bool, es: Operand[]): string {
  let s = loadsOf(fx, p, es);
  const n = p + "n";
  s += "  " + n + " = call ptr @orin_array_new(i64 " + u(es.length) + ", i64 " + (isRef ? "1" : "0") + ")\n";
  let k: usize = 0;
  while (k < es.length) {
    s += asSlot(fx, p, k, es[k]);
    s += "  call void @orinl_array_push(ptr " + n + ", i64 " + slotVal(fx, p, k, es[k]) + ")\n";
    k += 1;
  }
  return s + st(fx, d, n);
}

// store `v` (operand n) to `slot`; if it is a reference, release the old value first read.
function replaceI(fx: Fx, p: string, slot: string, n: usize, v: Operand): string {
  if (isRefT(opTy(fx, v))) {
    return "  " + p + "old = load ptr, ptr " + slot + "\n  store ptr " + ov(p, n, v) + ", ptr " + slot + "\n  call void @orinl_release(ptr " + p + "old)\n";
  }
  return "  store " + lty(opTy(fx, v)) + " " + ov(p, n, v) + ", ptr " + slot + "\n";
}

function instrI(fx: Fx, p: string, i: Instr): string {
  return match (i) {
    ICopy(d, o) => ld(fx, p, 0, o) + st(fx, d, ov(p, 0, o)),
    IMove(d, s) => moveI(fx, p, d, s),
    IBorrow(d, s) => moveI(fx, p, d, s),
    IDup(d, o) => ld(fx, p, 0, o) + "  " + p + "r = call ptr @orinl_dup(ptr " + ov(p, 0, o) + ")\n" + st(fx, d, p + "r"),
    IRelease(x) => "  " + p + "r = load ptr, ptr %l" + u(x) + "\n  call void @orinl_release(ptr " + p + "r)\n",
    IUnary(d, op, o) => unaryI(fx, p, d, op, o),
    IBinary(d, op, a, b) => binaryI(fx, p, d, op, a, b),
    ICall(d, f, args) => callI(fx, p, d, f, args),
    IBuiltin(d, b, args) => builtinInstr(fx, p, d, b, args),
    IStrAppend(x, y) => "  " + p + "x = load ptr, ptr %l" + u(x) + "\n" + ld(fx, p, 1, y)
      + "  " + p + "r = call ptr @orin_str_append(ptr " + p + "x, ptr " + ov(p, 1, y) + ")\n" + st(fx, x, p + "r"),
    IArrayExtend(x, y) => "  " + p + "x = load ptr, ptr %l" + u(x) + "\n" + ld(fx, p, 1, y)
      + "  " + p + "r = call ptr @orin_array_extend(ptr " + p + "x, ptr " + ov(p, 1, y) + ")\n" + st(fx, x, p + "r"),
    IStructNew(d, tag, slots) => structNewI(fx, p, d, tag, slots),
    INullary(d, t) => "  " + p + "r = call ptr @orin_nullary(i32 " + u(t) + ")\n" + st(fx, d, p + "r"),
    ITag(d, o) => ld(fx, p, 0, o) + "  " + p + "g = getelementptr inbounds i8, ptr " + ov(p, 0, o) + ", i64 12\n  "
      + p + "t = load i32, ptr " + p + "g\n  " + p + "r = zext i32 " + p + "t to i64\n" + st(fx, d, p + "r"),
    IGetField(d, o, k) => ld(fx, p, 0, o) + slotChk(p + "g", ov(p, 0, o), k)
      + "  " + p + "r = load " + lty(fx.f.locals[d].ty) + ", ptr " + p + "g\n" + st(fx, d, p + "r"),
    ISetField(x, k, v) => "  " + p + "x = load ptr, ptr %l" + u(x) + "\n" + ld(fx, p, 1, v) + slotChk(p + "g", p + "x", k)
      + replaceI(fx, p, p + "g", 1, v),
    ITakeField(d, x, k) => "  " + p + "x = load ptr, ptr %l" + u(x) + "\n" + slotChk(p + "g", p + "x", k)
      + "  " + p + "r = load ptr, ptr " + p + "g\n  store ptr null, ptr " + p + "g\n" + st(fx, d, p + "r"),
    IPutField(x, k, s) => "  " + p + "x = load ptr, ptr %l" + u(x) + "\n  " + p + "s = load ptr, ptr %l" + u(s) + "\n"
      + slotChk(p + "g", p + "x", k) + "  store ptr " + p + "s, ptr " + p + "g\n",
    IMakeUnique(x) => "  " + p + "x = load ptr, ptr %l" + u(x) + "\n  " + p + "r = call ptr @orinl_make_unique(ptr " + p + "x)\n" + st(fx, x, p + "r"),
    IArrayNew(d, r, es) => arrayNewI(fx, p, d, r, es),
    IArrayGet(d, a, k) => ld(fx, p, 0, a) + ld(fx, p, 1, k)
      + "  " + p + "g = call ptr @orinl_array_slot(ptr " + ov(p, 0, a) + ", i64 " + ov(p, 1, k) + ")\n"
      + "  " + p + "r = load " + lty(fx.f.locals[d].ty) + ", ptr " + p + "g\n" + st(fx, d, p + "r"),
    IArraySet(x, k, v) => "  " + p + "x = load ptr, ptr %l" + u(x) + "\n" + ld(fx, p, 1, k) + ld(fx, p, 2, v)
      + "  " + p + "g = call ptr @orinl_array_slot(ptr " + p + "x, i64 " + ov(p, 1, k) + ")\n" + replaceI(fx, p, p + "g", 2, v),
    IArrayTake(d, x, k) => "  " + p + "x = load ptr, ptr %l" + u(x) + "\n" + ld(fx, p, 1, k)
      + "  " + p + "g = call ptr @orinl_array_slot(ptr " + p + "x, i64 " + ov(p, 1, k) + ")\n"
      + "  " + p + "r = load ptr, ptr " + p + "g\n  store ptr null, ptr " + p + "g\n" + st(fx, d, p + "r"),
    IArrayPut(x, k, s) => "  " + p + "x = load ptr, ptr %l" + u(x) + "\n" + ld(fx, p, 1, k) + "  " + p + "s = load ptr, ptr %l" + u(s) + "\n"
      + "  " + p + "g = call ptr @orinl_array_slot(ptr " + p + "x, i64 " + ov(p, 1, k) + ")\n  store ptr " + p + "s, ptr " + p + "g\n",
    IArrayPush(x, v) => "  " + p + "x = load ptr, ptr %l" + u(x) + "\n" + ld(fx, p, 1, v) + asSlot(fx, p, 1, v)
      + "  " + p + "u = call ptr @orinl_make_unique(ptr " + p + "x)\n"
      + "  call void @orinl_array_push(ptr " + p + "u, i64 " + slotVal(fx, p, 1, v) + ")\n" + st(fx, x, p + "u"),
    IArrayPop(d, x) => "  " + p + "x = load ptr, ptr %l" + u(x) + "\n  " + p + "u = call ptr @orinl_make_unique(ptr " + p + "x)\n"
      + st(fx, x, p + "u") + "  " + p + "r = call ptr @orin_array_pop(ptr " + p + "u)\n" + st(fx, d, p + "r"),
    IClosure(d, f, caps) => closureI(fx, p, d, f, caps),
    ICallIndirect(d, f, args) => callIndirectI(fx, p, d, f, args),
    IIface(d, vt, v) => ifaceI(fx, p, d, vt, v),
    ICallVirtual(d, r, slot, args) => callVirtualI(fx, p, d, r, slot, args)
  };
}

function moveI(fx: Fx, p: string, d: usize, s: usize): string {
  return "  " + p + "r = load ptr, ptr %l" + u(s) + "\n" + st(fx, d, p + "r");
}

function termI(fx: Fx, p: string, t: Terminator): string {
  return match (t) {
    TGoto(b) => "  br label %B" + u(b) + "\n",
    TBranch(c, a, b) => ld(fx, p, 0, c) + "  " + p + "c = icmp ne i64 " + ov(p, 0, c) + ", 0\n  br i1 " + p + "c, label %B" + u(a) + ", label %B" + u(b) + "\n",
    TSwitch(o, cases, d) => switchI(fx, p, o, cases, d),
    TReturn(o) => {
      const outStore = fx.f.inout ? "  " + p + "o = load ptr, ptr %l0\n  store ptr " + p + "o, ptr %pout\n" : "";
      return match (o) {
        Some(x) => ld(fx, p, 0, x) + outStore + "  ret " + targ(fx, p, 0, x) + "\n",
        None => outStore + "  ret void\n"
      };
    },
    TTrap(m) => "  call void @orin_trap(ptr @.m" + u(msgIndex(fx.msgs, m)) + ")\n  unreachable\n"
  };
}

function switchI(fx: Fx, p: string, o: Operand, cases: SwitchCase[], d: usize): string {
  let s = ld(fx, p, 0, o) + "  switch i64 " + ov(p, 0, o) + ", label %B" + u(d) + " [";
  for (const k of cases) {
    s += " i64 " + k.value.toString() + ", label %B" + u(k.target);
  }
  return s + " ]\n";
}

// ---------------------------------------------------------------- functions

function genFunction(fx: Fx, name: string): string {
  const f = fx.f;
  let out: string[] = [];
  // ADR-0038 step 1: every value is initialised (`noundef`) and a reference is never null (`nonnull`); no function unwinds.
  let sig = "define internal " + attrTy(f.ret) + " @" + name + "(";
  let i: usize = 0;
  while (i < f.paramCount) {
    if (i > 0) {
      sig += ", ";
    }
    sig += paramTy(f.locals[i].ty) + " %p" + u(i);
    i += 1;
  }
  if (f.inout) {
    sig += ", ptr noundef nonnull %pout";
  }
  sig += (isInlineFn(fx.prog, f.name) ? ") alwaysinline nounwind {\nentry:\n" : ") nounwind {\nentry:\n");
  out.push(sig);
  i = 0;
  while (i < f.locals.length) {
    const t = lty(f.locals[i].ty);
    out.push("  %l" + u(i) + " = alloca " + t + ", align 8\n");
    if (i >= f.paramCount) {
      out.push("  store " + t + " " + (isRefT(f.locals[i].ty) ? "null" : (isFloatT(f.locals[i].ty) ? "0.0" : "0")) + ", ptr %l" + u(i) + "\n");
    }
    i += 1;
  }
  i = 0;
  while (i < f.paramCount) {
    const t = lty(f.locals[i].ty);
    out.push("  store " + t + " %p" + u(i) + ", ptr %l" + u(i) + "\n");
    i += 1;
  }
  out.push("  br label %B0\n");
  let b: usize = 0;
  for (const blk of f.blocks) {
    out.push("B" + u(b) + ":\n");
    let k: usize = 0;
    for (const ins of blk.instrs) {
      out.push(instrI(fx, "%b" + u(b) + "i" + u(k), ins));
      k += 1;
    }
    out.push(termI(fx, "%b" + u(b) + "t", blk.term));
    b += 1;
  }
  out.push("}\n\n");
  return out.join("");
}

export function emitLlvm(prog: MProgram): string {
  let names: string[] = [];
  let i: usize = 0;
  for (const f of prog.functions) {
    names.push("orin_fn_" + u(i) + "_" + sanitize(f.name));
    i += 1;
  }
  const msgs = collectMsgs(prog);
  let out: string[] = [];
  out.push("; Generated by orinc (Orin Stage 1, MIR -> LLVM IR backend). Do not edit.\n\n");
  i = 0;
  while (i < msgs.length) {
    out.push(cstrGlobal("@.m" + u(i), "private unnamed_addr", msgs[i]));
    i += 1;
  }
  i = 0;
  while (i < prog.strings.length) {
    out.push(strGlobal(i, prog.strings[i]));
    i += 1;
  }
  i = 0;
  while (i < prog.vtables.length) {
    let fs: string[] = [];
    for (const g of prog.vtables[i].funcs) {
      fs.push("ptr @" + names[g]);
    }
    if (fs.length == 0) {
      fs.push("ptr null");
    }
    out.push("@orin_vt" + u(i) + " = private unnamed_addr constant [" + u(fs.length) + " x ptr] [" + fs.join(", ") + "]\n");
    i += 1;
  }
  out.push("\n");
  out.push(declares());
  out.push("\n");
  out.push(prelude());
  out.push("\n");
  i = 0;
  while (i < prog.functions.length) {
    const fx = Fx { prog: prog, f: prog.functions[i], names: names, msgs: msgs };
    out.push(genFunction(fx, names[i]));
    i += 1;
  }
  const hostCall = prog.functions[prog.main].paramCount == 1;
  out.push("define i32 @main(i32 %argc, ptr %argv) {\n  call void @orin_init(i32 %argc, ptr %argv)\n"
    + (hostCall ? "  %host = call i64 @orin_cap_host_root()\n" : "")
    + "  call " + lty(prog.functions[prog.main].ret) + " @" + names[prog.main] + "(" + (hostCall ? "i64 %host" : "") + ")\n  call void @orin_flush()\n  ret i32 0\n}\n");
  return out.join("");
}
