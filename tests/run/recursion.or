function fib(n: int): int {
  if (n < 2) { return n; }
  return fib(n - 1) + fib(n - 2);
}

function fact(n: int): int {
  if (n <= 1) { return 1; }
  return n * fact(n - 1);
}

function gcd(a: int, b: int): int {
  if (b == 0) { return a; }
  return gcd(b, a % b);
}

function sumTo(n: int): int {
  if (n == 0) { return 0; }
  return n + sumTo(n - 1);
}

function ack(m: int, n: int): int {
  if (m == 0) { return n + 1; }
  if (n == 0) { return ack(m - 1, 1); }
  return ack(m - 1, ack(m, n - 1));
}

function main(): void {
  console.log(fib(20).toString());
  console.log(fact(10).toString());
  console.log(gcd(48, 18).toString());
  console.log(sumTo(10000).toString());
  console.log(ack(2, 3).toString());
}
