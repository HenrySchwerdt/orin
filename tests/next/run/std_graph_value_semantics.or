import { newGraph, add, set, remove, get, size, Graph } from "std:graph";

function main(): void {
  const g0 = newGraph<int>(4);
  const a = add(g0, 1);
  const g1 = a.graph;
  const b = add(g1, 2);
  const g2 = b.graph;
  // g2 is a different value from g1; changing g2 never changes g1.
  const g3 = set(g2, a.id, 99).unwrap();
  console.log(get(g2, a.id).unwrap().toString() + " " + get(g3, a.id).unwrap().toString());
  const g4 = remove(g3, a.id).unwrap();
  console.log(size(g1).toString() + size(g2).toString() + size(g3).toString() + size(g4).toString());
  // The old version still holds the node; the new one rejects the id.
  console.log(get(g3, a.id).isOk().toString() + " " + get(g4, a.id).isErr().toString());
  console.log(get(g1, b.id).isErr().toString() + " " + get(g2, b.id).isOk().toString());
}
