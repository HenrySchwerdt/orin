function parseDigit(c: string): Result<int, string> {
  const code = c.charCodeAt(0);
  if (code >= 48 && code <= 57) {
    return Ok(code - 48);
  }
  return Err("not a digit: " + c);
}

function parseTwo(s: string): Result<int, string> {
  if (s.length != 2) {
    return Err("length");
  }
  const a = parseDigit(s.charAt(0))?;
  const b = parseDigit(s.charAt(1))?;
  return Ok(a * 10 + b);
}

function sumPair(x: string, y: string): Result<int, string> {
  const a = parseTwo(x)?;
  const b = parseTwo(y)?;
  return Ok(a + b);
}

function step(ok: bool): Result<void, string> {
  if (ok) {
    return Ok();
  }
  return Err("step failed");
}

function two(a: bool, b: bool): Result<void, string> {
  step(a)?;
  step(b)?;
  return Ok();
}

function report(r: Result<int, string>): void {
  match (r) {
    Ok(v) => { console.log("ok " + v.toString()); },
    Err(e) => { console.log("err " + e); },
  }
}

function reportV(r: Result<void, string>): void {
  if (r.isOk()) {
    console.log("ok");
  } else {
    console.log("err " + r.unwrapErr());
  }
}

function main(): void {
  report(sumPair("12", "34"));
  report(sumPair("12", "3x"));
  report(sumPair("1", "23"));
  report(sumPair("a1", "23"));
  reportV(two(true, true));
  reportV(two(true, false));
  reportV(two(false, true));
}
