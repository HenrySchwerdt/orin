// Orin for TypeScript developers: absence is Option<T>, failure is Result<T, E> with `?`.
function find(xs: int[], k: int): Option<int> {
  for (const x of xs) {
    if (x == k) { return Some(x); }
  }
  return None;
}

function parse(s: string): Result<int, string> {
  return match (parseInt(s)) {
    Some(v) => Ok(v),
    None => Err("not a number: " + s),
  };
}

function twice(s: string): Result<int, string> {
  const v = parse(s)?;
  return Ok(v * 2);
}

function main(): void {
  match (find([1, 2, 3], 2)) {
    Some(v) => { console.log(`found ${v}`); },
    None => { console.log("missing"); },
  }
  console.log(`${find([1], 5).unwrapOr(-1)}`);
  match (twice("21")) {
    Ok(v) => { console.log(`${v}`); },
    Err(e) => { console.log(e); },
  }
  match (twice("x")) {
    Ok(v) => { console.log(`${v}`); },
    Err(e) => { console.log(e); },
  }
}
