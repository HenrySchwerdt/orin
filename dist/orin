#!/bin/sh
# orin — launcher for a release package of the Orin compiler.
# Layout: bin/orin (this script), libexec/orin (compiler), lib/orin/runtime/ (C runtime), lib/orin/platform/ (L0 platform layer).
#   orin build <file.or|dir> [-o <exe>]   compile to a native executable (needs a C compiler);
#                                         a directory containing orin.toml is a package (its entry is built)
#   orin run <file.or|dir> [args...]      build to a temp dir and run
#   orin test [--filter S] [--format=json] <file.or|dir>   run the @Test functions (needs a C compiler)
#   orin toolchain install|status     the pinned LLVM for --backend=llvm (ADR-0038 section 8; pin: lib/orin/llvm.pin)
#   orin --version                  print the package version
#   orin doctor                       check the install (version, layout, C compiler, PATH); exit 1 on a problem
#   orin <anything else>              forwarded to the compiler (check, compile, fmt, lsp, ...)
set -e

# Follow symlinks (install.sh links bin/orin into other directories)
# so that HERE is the real package root.
resolve() { # resolve <path>: print the path with symlinks on the last component followed
  _p=$1
  while [ -h "$_p" ]; do
    _d=$(dirname -- "$_p"); _l=$(readlink "$_p")
    case $_l in /*) _p=$_l ;; *) _p=$_d/$_l ;; esac
  done
  printf '%s\n' "$_p"
}
SELF=$(resolve "$0")
HERE=$(CDPATH= cd -- "$(dirname -- "$SELF")/.." && pwd -P)
BIN="$HERE/libexec/orin"
RT="$HERE/lib/orin/runtime"
PF="$HERE/lib/orin/platform"
CC=${CC:-cc}

if [ -f "$HERE/bin/orin-cli.sh" ] && [ "${ORIN_LEGACY_DRIVER:-0}" != 1 ]; then
  export ORIN_PACKAGE_ROOT="$HERE"
  exec bash "$HERE/bin/orin-cli.sh" "$@"
fi

native() { # native <src> <exe>
  tmp=$(mktemp -d)
  "$BIN" compile "$1" -o "$tmp/out.c" --runtime "$RT" --cc "$CC" || { rm -rf "$tmp"; exit 1; }
  $CC -O2 -w -I "$RT" "$tmp/out.c" "$RT"/*.c "$PF"/*.c -lm -pthread -o "$2" || { rm -rf "$tmp"; exit 1; }
  rm -rf "$tmp"
}

# ---- pinned LLVM toolchain (ADR-0038 section 8, gate 3) ----------------------------------------------------------
# The pin (version, and per platform the archive URL and its sha256) is lib/orin/llvm.pin (dist/llvm.pin in the source tree).
#   orin toolchain install [--force]   download the pinned LLVM, verify its sha256, unpack to ~/.orin/toolchains/llvm-<version>
#   orin toolchain status              pinned version, platform, install state (exit 1 if not installed)
#   orin toolchain path                print the pinned clang when installed (exit 1 otherwise); used by orin-cli.sh
#   orin toolchain version             print the pinned version
# Environment: ORIN_HOME (default ~/.orin), ORIN_LLVM_PIN (alternative pin file), ORIN_PLATFORM (platform override).
PIN=${ORIN_LLVM_PIN:-$HERE/lib/orin/llvm.pin}
TC_HOME=${ORIN_HOME:-${HOME:-}/.orin}/toolchains

tc_die() { echo "orin toolchain: error: $*" >&2; exit 1; }

tc_platform() {
  if [ -n "${ORIN_PLATFORM:-}" ]; then printf '%s\n' "$ORIN_PLATFORM"; return; fi
  _os=$(uname -s 2>/dev/null || echo unknown); _m=$(uname -m 2>/dev/null || echo unknown)
  case $_m in x86_64|amd64) _a=x86_64 ;; aarch64|arm64) _a=arm64 ;; *) _a=$_m ;; esac
  case $_os in
    Linux) [ "$_a" = arm64 ] && _a=aarch64; printf 'linux-%s\n' "$_a" ;;
    Darwin)
      if [ "$_a" = x86_64 ] && [ "$(sysctl -n hw.optional.arm64 2>/dev/null || echo 0)" = 1 ]; then _a=arm64; fi
      printf 'macos-%s\n' "$_a" ;;
    *) printf '%s-%s\n' "$_os" "$_a" ;;
  esac
}

tc_version() { # the pinned version, or empty when there is no usable pin file
  [ -r "$PIN" ] || return 0
  awk '$1 == "version" { print $2; exit }' "$PIN"
}

tc_asset() { # tc_asset <platform>: prints "<sha256> <url>" of the pinned archive for the platform
  [ -r "$PIN" ] || return 0
  awk -v p="$1" '$1 == "asset" && $2 == p { print $3, $4; exit }' "$PIN"
}

tc_dir() { printf '%s/llvm-%s\n' "$TC_HOME" "$1"; }

tc_installed_clang() { # prints the pinned clang when the pinned version is installed
  _v=$(tc_version); [ -n "$_v" ] || return 1
  _c=$(tc_dir "$_v")/bin/clang
  [ -x "$_c" ] && [ -f "$(tc_dir "$_v")/.orin-toolchain" ] || return 1
  printf '%s\n' "$_c"
}

tc_sha256() { # tc_sha256 <file>
  if command -v sha256sum >/dev/null 2>&1; then sha256sum "$1" | cut -d ' ' -f 1
  elif command -v shasum >/dev/null 2>&1; then shasum -a 256 "$1" | cut -d ' ' -f 1
  elif command -v openssl >/dev/null 2>&1; then openssl dgst -sha256 "$1" | sed 's/^.*= *//'
  else tc_die "need sha256sum, shasum or openssl to verify the download (refusing to install unverified)"; fi
}

tc_install() {
  force=0
  for _a in "$@"; do case $_a in --force) force=1 ;; *) tc_die "unknown option '$_a' (usage: orin toolchain install [--force])" ;; esac; done
  ver=$(tc_version); [ -n "$ver" ] || tc_die "no usable pin file ($PIN)"
  plat=$(tc_platform)
  entry=$(tc_asset "$plat")
  [ -n "$entry" ] || tc_die "the pin has no LLVM $ver archive for platform '$plat'; use a system clang instead (CC=clang orin build --backend=llvm)"
  want=${entry%% *}; url=${entry#* }
  case $want in *[!0-9a-f]*|"") tc_die "malformed sha256 in $PIN for $plat" ;; esac
  [ "${#want}" = 64 ] || tc_die "malformed sha256 in $PIN for $plat"
  case $TC_HOME in /*) ;; *) tc_die "ORIN_HOME must be an absolute path (got $TC_HOME)" ;; esac
  case $TC_HOME in *[[:space:]]*) tc_die "ORIN_HOME must not contain whitespace (got $TC_HOME)" ;; esac
  dest=$(tc_dir "$ver")
  if [ "$force" = 0 ] && tc_installed_clang >/dev/null; then echo "LLVM $ver is already installed: $dest"; return 0; fi
  mkdir -p "$TC_HOME"
  work=$(mktemp -d "$TC_HOME/.install.XXXXXX") || tc_die "cannot write under $TC_HOME"
  trap 'rm -rf "$work"' EXIT
  archive=$work/archive
  echo "Downloading LLVM $ver for $plat"
  echo "  $url"
  if command -v curl >/dev/null 2>&1; then curl -fL --retry 2 -sS -o "$archive" "$url" || tc_die "download failed: $url"
  elif command -v wget >/dev/null 2>&1; then wget -q -O "$archive" "$url" || tc_die "download failed: $url"
  else tc_die "need curl or wget to download the toolchain"; fi
  got=$(tc_sha256 "$archive")
  if [ "$got" != "$want" ]; then
    tc_die "sha256 mismatch for $url: expected $want, got $got. Nothing was installed."
  fi
  echo "  sha256 verified"
  mkdir "$work/x"
  # Only what compiling C and LLVM IR needs (the full archive unpacks to several GB): clang, llc and clang's resource directory.
  wild=; if tar --version 2>/dev/null | grep -q 'GNU tar'; then wild=--wildcards; fi
  tar -xf "$archive" -C "$work/x" --strip-components=1 $wild '*/bin/clang' '*/bin/clang-[0-9]*' '*/bin/llc' '*/lib/clang' \
    || tc_die "cannot unpack the archive (tar needs xz support for .tar.xz)"
  rm -f "$archive"
  [ -x "$work/x/bin/clang" ] && [ -x "$work/x/bin/llc" ] || tc_die "the archive has no bin/clang and bin/llc; nothing was installed"
  "$work/x/bin/clang" --version 2>/dev/null | grep -q "clang version $ver" \
    || tc_die "the unpacked clang does not report version $ver; nothing was installed"
  printf 'version %s\nplatform %s\nsha256 %s\nurl %s\n' "$ver" "$plat" "$want" "$url" > "$work/x/.orin-toolchain"
  rm -rf "$dest.old"; [ ! -e "$dest" ] || mv "$dest" "$dest.old"
  mv "$work/x" "$dest"
  rm -rf "$dest.old"
  echo "Installed LLVM $ver: $dest"
  echo "  orin build --backend=llvm now uses $dest/bin/clang"
}

tc_status() {
  ver=$(tc_version); [ -n "$ver" ] || tc_die "no usable pin file ($PIN)"
  plat=$(tc_platform)
  echo "pinned LLVM: $ver ($plat)"
  if [ -z "$(tc_asset "$plat")" ]; then echo "archive:     none pinned for this platform"; fi
  if c=$(tc_installed_clang); then echo "installed:   yes ($c)"
  else echo "installed:   no (orin toolchain install)"; return 1; fi
}

toolchain() {
  case "${1:-}" in
    install) shift; tc_install "$@" ;;
    status) tc_status ;;
    path) tc_installed_clang ;;
    version) v=$(tc_version); [ -n "$v" ] || exit 1; echo "$v" ;;
    *) echo "usage: orin toolchain install [--force] | status | path | version" >&2; exit 2 ;;
  esac
}

cc_hint() { # print how to install a C compiler on this system
  case $(uname -s 2>/dev/null) in
    Darwin) echo "         fix: xcode-select --install   (installs clang and the command line tools)" ;;
    *)
      _id=$( (. /etc/os-release 2>/dev/null && echo "${ID:-} ${ID_LIKE:-}") || true)
      case " $_id " in
        *" debian "*|*" ubuntu "*) echo "         fix: sudo apt-get update && sudo apt-get install -y build-essential" ;;
        *" fedora "*|*" rhel "*|*" centos "*) echo "         fix: sudo dnf install -y gcc make" ;;
        *" arch "*) echo "         fix: sudo pacman -S --needed base-devel" ;;
        *" alpine "*) echo "         fix: sudo apk add build-base" ;;
        *" suse "*|*" opensuse "*) echo "         fix: sudo zypper install gcc make" ;;
        *) echo "         fix: install gcc or clang with your package manager, or point CC at one (CC=clang orin run ...)" ;;
      esac ;;
  esac
}

doctor() {
  bad=0; warn=0
  ok() { printf '  [ ok ] %s\n' "$1"; }
  wn() { printf '  [warn] %s\n' "$1"; warn=$((warn + 1)); }
  fl() { printf '  [FAIL] %s\n' "$1"; bad=$((bad + 1)); }
  echo "orin doctor"

  # version
  if [ -s "$HERE/VERSION" ]; then ok "version: $(cat "$HERE/VERSION")"
  else fl "version: $HERE/VERSION is missing or empty"; echo "         fix: reinstall Orin (see docs/install.md)"; fi

  # install layout
  missing=
  [ -x "$BIN" ] || missing="$missing libexec/orin"
  [ -f "$RT/orin_runtime.c" ] || missing="$missing lib/orin/runtime/orin_runtime.c"
  [ -f "$PF/orin_platform.c" ] || missing="$missing lib/orin/platform/orin_platform.c"
  if [ -n "$missing" ]; then
    fl "install layout: missing$missing under $HERE"
    echo "         fix: the package is incomplete; reinstall it (curl -fsSL https://raw.githubusercontent.com/HenrySchwerdt/orin/main/install.sh | sh)"
  else ok "install layout: $HERE"; fi

  # C compiler
  set -- $CC
  ccbin=${1:-cc}
  if ! command -v "$ccbin" >/dev/null 2>&1; then
    fl "C compiler: '$ccbin' not found on PATH (needed by orin build/run/test)"
    cc_hint
  else
    ccv=$($CC --version 2>/dev/null | head -n 1 || true)
    t=$(mktemp -d)
    printf 'int main(void) { return 0; }\n' > "$t/t.c"
    if $CC "$t/t.c" -lm -o "$t/t" >/dev/null 2>&1 && "$t/t"; then
      ok "C compiler: $ccbin (${ccv:-version unknown})"
    else
      fl "C compiler: '$ccbin' exists but cannot compile and link a trivial program (with -lm)"
      echo "         fix: check that the compiler is complete (build-essential / Xcode command line tools) or set CC to a working one"
      cc_hint
    fi
    rm -rf "$t"
  fi

  # pinned LLVM toolchain (optional: only --backend=llvm --release needs it)
  tcv=$(tc_version)
  if [ -z "$tcv" ]; then wn "LLVM toolchain: no pin file ($PIN)"
  elif tcc=$(tc_installed_clang); then ok "LLVM toolchain: pinned $tcv installed ($tcc)"
  else
    ok "LLVM toolchain: pinned $tcv is not installed (optional; --release --backend=llvm falls back to C; orin toolchain install)"
  fi

  # end to end: compile and run a tiny program
  if [ "$bad" -eq 0 ]; then
    t=$(mktemp -d)
    printf 'function main(): void {\n  console.log("orin-doctor-ok");\n}\n' > "$t/d.or"
    if out=$(native "$t/d.or" "$t/d" 2>&1) && [ "$("$t/d")" = "orin-doctor-ok" ]; then
      ok "end to end: compiled and ran a test program"
    else
      fl "end to end: compiling and running a test program failed"
      printf '%s\n' "$out" | head -n 8 | sed 's/^/         /'
      echo "         fix: on Alpine/musl the release binary needs gcompat or a source build (docs/install.md)"
    fi
    rm -rf "$t"
  fi

  # PATH
  selfdir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
  found=$(command -v orin 2>/dev/null || true)
  if [ -z "$found" ]; then
    wn "PATH: 'orin' is not on your PATH"
    echo "         fix: add this to your shell profile (~/.profile, ~/.bashrc or ~/.zshrc):"
    echo "                export PATH=\"$selfdir:\$PATH\""
  else
    foundhere=$(CDPATH= cd -- "$(dirname -- "$(resolve "$found")")/.." 2>/dev/null && pwd -P || true)
    if [ "$foundhere" = "$HERE" ]; then ok "PATH: $found"
    else
      wn "PATH: 'orin' on your PATH ($found) is a different install than this one ($HERE)"
      echo "         fix: put $selfdir before the other directory in PATH, or remove the other install"
    fi
  fi

  if [ "$bad" -gt 0 ]; then echo "$bad problem(s) found."; return 1; fi
  if [ "$warn" -gt 0 ]; then echo "OK with $warn warning(s)."; else echo "All good."; fi
}

case "${1:-}" in
  doctor)
    doctor || exit 1
    ;;
  build)
    [ $# -ge 2 ] || { echo "usage: orin build <file.or|package-dir> [-o <exe>]" >&2; exit 2; }
    src=$2; out=$(basename "$src" .or)
    if [ -d "$src" ]; then out=$(basename "$(CDPATH= cd -- "$src" && pwd)"); fi
    if [ "${3:-}" = "-o" ] && [ -n "${4:-}" ]; then out=$4; fi
    native "$src" "$out"
    ;;
  run)
    [ $# -ge 2 ] || { echo "usage: orin run <file.or|package-dir> [args...]" >&2; exit 2; }
    src=$2; shift 2
    dir=$(mktemp -d)
    native "$src" "$dir/prog"
    set +e; "$dir/prog" "$@"; st=$?; set -e
    rm -rf "$dir"; exit $st
    ;;
  toolchain)
    shift
    toolchain "$@"
    ;;
  test)
    shift
    exec "$BIN" test --runtime "$RT" --cc "$CC" "$@"
    ;;
  --version|version)
    cat "$HERE/VERSION"
    ;;
  *)
    exec "$BIN" "$@"
    ;;
esac
