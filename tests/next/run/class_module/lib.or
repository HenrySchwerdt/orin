export class Queue {
  private items: string[] = [];
  private head: usize = 0;
  static make(first: string): Queue {
    let q = new Queue();
    q.put(first);
    return q;
  }
  put(s: string): void {
    this.items.push(s);
  }
  take(): Option<string> {
    if (this.head >= this.items.length) {
      return None;
    }
    const s = this.items[this.head];
    this.head += 1;
    return Some(s);
  }
  pending(): usize {
    return this.items.length - this.head;
  }
}

export class Pair {
  constructor(public a: int, public b: int) {}
  swap(): Pair {
    return new Pair(this.b, this.a);
  }
}
