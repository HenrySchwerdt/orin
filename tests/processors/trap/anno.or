import { Input, Output, MDecl, fn, named, ret, str, output } from "std:meta";

@Annotation(type)
export type Boom = { };

// Pure, but traps at run time: an index out of bounds.
@Processor(Boom)
export function boomProc(input: Input): Output {
  const xs: int[] = [1, 2, 3];
  const i = input.decls.length + 10;
  const v = xs[i];
  return output([fn("never" + v.toString(), [], named("string"), [ret(str("x"))])]);
}
