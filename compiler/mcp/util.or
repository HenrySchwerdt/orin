// Shared helpers for `orin mcp`: hashing (content-stable diagnostic ids), path authorization,
// JSON construction and diagnostic rendering.

import { Json, JNull, JBool, JNum, JStr, JArr, JObj, JField, jField, stringifyJson } from "../json";
import { Analysis, PathDiag, fileIndexOf, offsetToPos } from "../analysis";
import { SourceMap, Diagnostic } from "../diag";
import { normalizePath, joinPath, isInside, relativeTo, isNormalized } from "../loader";

// One check snapshot (a delta base): the diagnostics of `entry` at revision `rev`; `keys[i]` is the stable id of the
// diagnostic whose compact line is `lines[i]`.
@Invariant(this.keys.length == this.lines.length)
export type Snap = { rev: int; entry: string; fp: string; keys: string[]; lines: string[]; };

// The number of check snapshots a session keeps (the oldest is dropped first).
export const MAX_SNAPS: usize = 32;

// Snapshot revisions are handed out in increasing order and are below the next one, so a revision names at most one
// snapshot and a client's `sinceRevision` can never match a snapshot that was not taken yet.
export function revsOrdered(snaps: Snap[], nextRev: int): bool {
  let prev: int = 0;
  for (const s of snaps) {
    if (s.rev <= prev || s.rev >= nextRev) {
      return false;
    }
    prev = s.rev;
  }
  return true;
}

// The state of one MCP session: the authorized root, what the client may run, and the recent `check` snapshots (the
// bases of `sinceRevision` deltas).
@Invariant(isNormalized(this.root))
@Invariant(this.nextRev >= 1)
@Invariant(this.snaps.length <= MAX_SNAPS)
@Invariant(revsOrdered(this.snaps, this.nextRev))
export class McpSession {
  root: string;            // authorized root (normalized)
  allowExec: bool;         // test/build may execute code
  repo: string;            // directory holding runtime/ and tools/ (for build/test)
  inited: bool;
  private nextRev: int;
  private snaps: Snap[];   // recent check snapshots (delta bases), oldest first

  constructor(root: string, allowExec: bool, repo: string) {
    this.root = normalizePath(root);
    this.allowExec = allowExec;
    this.repo = repo;
    this.inited = false;
    this.nextRev = 1;
    this.snaps = [];
  }

  // The newest snapshot of `entry`.
  @Ensures(result.isSome() ==> result.unwrap().entry == entry && result.unwrap().rev < this.nextRev)
  latest(entry: string): Option<Snap> {
    let found: Option<Snap> = None;
    for (const s of this.snaps) {
      if (s.entry == entry) {
        found = Some(s);
      }
    }
    return found;
  }

  // The snapshot `rev` of `entry`, if the session still has it.
  @Ensures(result.isSome() ==> result.unwrap().entry == entry && result.unwrap().rev == rev)
  find(entry: string, rev: int): Option<Snap> {
    const k = this.snaps.findIndex(s => s.entry == entry && s.rev == rev);
    return k.isSome() ? Some(this.snaps[k.unwrap()]) : None;
  }

  // Records a check of `entry` whose inputs have the fingerprint `fp` and returns its revision: an unchanged project
  // (the same fingerprint as the entry's latest snapshot) keeps that revision, anything else gets the next one.
  @Requires(keys.length == lines.length)
  @Ensures(this.find(entry, result).isSome() && result < this.nextRev)
  @Ensures(this.nextRev == old(this.nextRev) || this.nextRev == old(this.nextRev) + 1)
  @Ensures(this.nextRev == old(this.nextRev) + 1 ==> result == old(this.nextRev))
  record(entry: string, fp: string, keys: string[], lines: string[]): int {
    const latest = this.latest(entry);
    if (latest.isSome() && latest.unwrap().fp == fp) {
      return latest.unwrap().rev;
    }
    const rev = this.nextRev;
    this.nextRev += 1;
    this.snaps.push(Snap { rev: rev, entry: entry, fp: fp, keys: keys, lines: lines });
    if (this.snaps.length > MAX_SNAPS) {
      this.snaps = this.snaps.slice(1, this.snaps.length);
    }
    return rev;
  }
}

export function newState(root: string, allowExec: bool, repo: string): McpSession {
  return new McpSession(root, allowExec, repo);
}

// ---- JSON helpers -----------------------------------------------------------------------

export function jstrs(xs: string[]): Json {
  return JArr(xs.map(x => JStr(x)));
}

export function jtext(j: Json): string {
  return stringifyJson(j);
}

// ---- hashing -----------------------------------------------------------------------------

// A 31-bit polynomial hash; stays in [0, 2^31 - 1) when it starts there.
@Requires(h0 >= 0 && h0 < 2147483647)
@Ensures(result >= 0 && result < 2147483647)
export function hashStr(h0: int, s: string): int {
  let h = h0;
  let i: usize = 0;
  while (i < s.length) {
    h = (h * 131 + s.charCodeAt(i) + 1) % 2147483647;
    i += 1;
  }
  return h;
}

function hexDigit(n: int): string {
  if (n < 10) {
    return String.fromCharCode(48 + n);
  }
  return String.fromCharCode(87 + n);
}

@Requires(h0 >= 0)
@Ensures(result.length == 8)
export function hex8(h0: int): string {
  let h = h0;
  let out = "";
  let i = 0;
  while (i < 8) {
    out = hexDigit(h % 16) + out;
    h = h / 16;
    i += 1;
  }
  return out;
}

// ---- paths / authorization ---------------------------------------------------------------

// Resolve a client-supplied path against the root; Err when it escapes the authorized root.
// Lexical only (symlinks are not resolved; see docs/mcp.md).
@Ensures(result.isOk() ==> isNormalized(result.unwrap()) && isInside(st.root, result.unwrap()))
export function resolvePath(st: McpSession, p: string): Result<string, string> {
  if (p.length == 0) {
    return Err("empty path");
  }
  const r = joinPath(st.root, p);
  if (!isInside(st.root, r)) {
    return Err("path is outside the authorized root: " + p);
  }
  return Ok(r);
}

export function relPath(st: McpSession, p: string): string {
  return relativeTo(st.root, p);
}

// Every file the analysis read must lie inside the root (imports may use `../`).
export function checkAllInside(st: McpSession, a: Analysis): Option<string> {
  for (const f of a.sm.files) {
    // `$...` paths are the embedded prelude roots (compiler/loader/prelude.or), not files on disk.
    if (!f.path.startsWith("$") && !isInside(st.root, f.path)) {
      return Some("project reads a file outside the authorized root: " + f.path);
    }
  }
  return None;
}

// Single-quote a string for /bin/sh: the result is one word that holds `s` (every `'` is closed, escaped and reopened).
@Ensures(result.startsWith("'") && result.endsWith("'") && result.length >= s.length + 2)
export function shq(s: string): string {
  return "'" + s.split("'").join("'\\''") + "'";
}

@Ensures(s.length <= n ==> result == s)
@Ensures(s.length > n ==> result.startsWith(s.substring(0, n)) && result.endsWith(" bytes]"))
export function trunc(s: string, n: usize): string {
  if (s.length <= n) {
    return s;
  }
  return s.substring(0, n) + "...[truncated " + (s.length - n).toString() + " bytes]";
}

// ---- diagnostics -------------------------------------------------------------------------

export type DiagView = {
  id: string;        // content-stable identity (code + file + message + occurrence)
  code: string;
  file: string;      // relative to root
  line: usize;       // 1-based
  col: usize;
  eline: usize;
  ecol: usize;
  message: string;
  notes: string[];
};

export function compactLine(d: DiagView): string {
  return d.code + " " + d.file + ":" + d.line.toString() + ":" + d.col.toString() + " " + d.message;
}

export function detailedJson(d: DiagView): Json {
  let fs: JField[] = [
    jField("id", JStr(d.id)), jField("code", JStr(d.code)), jField("file", JStr(d.file)),
    jField("line", JNum(d.line.toInt())), jField("col", JNum(d.col.toInt())),
    jField("endLine", JNum(d.eline.toInt())), jField("endCol", JNum(d.ecol.toInt())),
    jField("message", JStr(d.message))
  ];
  if (d.notes.length > 0) {
    fs.push(jField("notes", jstrs(d.notes)));
  }
  return JObj(fs);
}

// Views of diagnostics (over source map `sm`), with occurrence-disambiguated stable ids; positions are 1-based.
@Ensures(result.length == ds.length)
@Ensures(result.every(v => v.line >= 1 && v.col >= 1 && v.id.length == 8))
export function viewsOf(st: McpSession, sm: SourceMap, ds: PathDiag[]): DiagView[] {
  let out: DiagView[] = [];
  let seen: string[] = [];
  for (const d of ds) {
    let text = "";
    for (const f of sm.files) {
      if (f.path == d.path) {
        text = f.text;
      }
    }
    const s = offsetToPos(text, d.start);
    const e = offsetToPos(text, d.end);
    const rel = relPath(st, d.path);
    const base = d.code + "|" + rel + "|" + d.message;
    let n = 0;
    for (const k of seen) {
      if (k == base) {
        n += 1;
      }
    }
    seen.push(base);
    out.push(DiagView {
      id: hex8(hashStr(hashStr(7, base), n.toString())),
      code: d.code, file: rel,
      line: s.line + 1, col: s.character + 1, eline: e.line + 1, ecol: e.character + 1,
      message: d.message, notes: d.notes
    });
  }
  return out;
}

// Raw compiler diagnostics (build path) as PathDiags over `sm`.
@Requires(ds.every(d => d.span.file < sm.files.length))
@Ensures(result.length == ds.length)
export function toPathDiags(sm: SourceMap, ds: Diagnostic[]): PathDiag[] {
  return ds.map(d => PathDiag {
    path: sm.files[d.span.file].path, code: d.code, message: d.message,
    start: d.span.start, end: d.span.end, notes: d.notes
  });
}

// Fingerprint of everything the analysis read (paths + contents).
export function fingerprint(a: Analysis): string {
  let h: int = 17;
  for (const f of a.sm.files) {
    h = hashStr(hashStr(h, f.path), f.text);
  }
  return hex8(h) + a.sm.files.length.toString();
}
