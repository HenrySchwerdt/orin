// The sidebar block of the business view (ADR-0051). Kept apart from components.or, which renders it, so that the shared nav
// changes by one line; it needs nothing but the relative root of the page.

import ox from "std:html";
import { Html } from "std:html";

function Item(href: string, label: string, on: bool): Html {
  return <li><a href={href} class={on ? "ex-nav-on" : "ex-nav-off"} aria-current={on ? "page" : ""}><span>{label}</span></a></li>;
}

export function BusinessNav(root: string, hasDiff: bool, active: string): Html {
  return <>
    <p class="ex-nav-head">Business view</p>
    <ul class="r-nav ex-nav">
      <Item href={root + "business.html"} label="Summary" on={active == "biz"} />
      <Item href={root + "usecases.html"} label="Use cases" on={active == "biz-usecases"} />
      <Item href={root + "rules.html"} label="Business rules" on={active == "biz-rules"} />
      <Item href={root + "capabilities.html"} label="Capabilities" on={active == "biz-caps"} />
      {hasDiff ? <Item href={root + "behaviour.html"} label="What changed" on={active == "biz-behaviour"} /> : <></>}
    </ul>
  </>;
}
