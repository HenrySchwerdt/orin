// Hygiene of a companion module (ADR-0046 §2, S4): the names that generated code exports must be unique within the
// companion, across the outputs of all processors that ran over the source module (E0449). Helper names come from
// `fresh` (`__g<N>_<name>`, distinct per run through `freshBase`), so they cannot collide with each other or with user
// names; a collision of a *private* generated name with another private one is an ordinary duplicate definition (E0304) that the
// checker reports in the second check of the program.

import { Diagnostic, Span, diag } from "../diag";
import { Item } from "../syntax";
import { declName, declExported } from "./lookup";

// The names a declaration binds in the module's scope: itself, and the variants of a union (they are values).
export function boundNames(it: Item): string[] {
  let out: string[] = [declName(it)];
  match (it) {
    IType(t) => {
      match (t.body) {
        DUnion(vs) => {
          for (const v of vs) {
            out.push(v.name.name);
          }
        },
        _ => {},
      }
    },
    _ => {},
  }
  return out;
}

// What one processor run generated: its declarations, a label for messages and the span of the annotation use.
export type RunItems = { label: string; cause: Span; items: Item[]; };

type Seen = { name: string; exported: bool; label: string; };

// E0449 for every name that is exported twice in the companion `companion` (or exported and bound privately by another
// declaration); reported at the annotation use of the later declaration. `runs` are in processor order.
export function hygieneDiags(companion: string, runs: RunItems[]): Diagnostic[] {
  let seen: Seen[] = [];
  let out: Diagnostic[] = [];
  for (const r of runs) {
    for (const it of r.items) {
      const exported = declExported(it);
      let names = boundNames(it);
      let fresh: Seen[] = [];
      for (const n of names) {
        let clash: Option<Seen> = None;
        for (const s of seen) {
          if (s.name == n && (s.exported || exported)) {
            clash = Some(s);
          }
        }
        if (clash.isSome()) {
          let d = diag(
            "E0449",
            r.cause,
            "`" + n + "` is generated more than once in the companion module `" + companion
                + "` and at least one of them is exported",
          );
          d.notes.push("first generated by " + clash.unwrap().label + ", again by " + r.label);
          d.notes.push("exported names of one companion must be unique (ADR-0046, hygiene); rename one of them");
          out.push(d);
        }
        fresh.push(Seen { name: n, exported: exported, label: r.label });
      }
      for (const s of fresh) {
        seen.push(s);
      }
    }
  }
  return out;
}
