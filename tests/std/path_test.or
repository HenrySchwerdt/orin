// std:path (ADR-0048): join(base, part) / joinAll(parts), replaceExtension and the deprecated withExtension.
// Run by tools/test_std.sh with and without contract checking.
import { assertEqString } from "std:test";
import { join, joinAll, normalize, resolveAgainst, replaceExtension, withExtension } from "std:path";

@Test
function joinTwo(): void {
  assertEqString(join("a", "b"), "a/b", "plain");
  assertEqString(join("/a", "b/../c"), "/a/c", "normalized");
  assertEqString(join("", "x"), "x", "empty base");
  assertEqString(join("x", ""), "x", "empty part");
  assertEqString(join("", ""), ".", "both empty");
  assertEqString(join("a", "/b"), "a/b", "an absolute part does not reset");
  assertEqString(join("a/", "b/"), "a/b/", "trailing separator kept");
}

@Test
function joinMany(): void {
  assertEqString(joinAll(["a", "b", "c"]), "a/b/c", "three parts");
  assertEqString(joinAll([]), ".", "no parts");
  assertEqString(joinAll(["/a", "", "b", "../c"]), "/a/c", "empty parts and ..");
  assertEqString(join(join("a", "b"), "c"), joinAll(["a", "b", "c"]), "join nests");
  assertEqString(resolveAgainst("/base", "x/y"), "/base/x/y", "relative resolves against the base");
  assertEqString(resolveAgainst("/base", "/abs/./z"), normalize("/abs/z"), "absolute wins");
}

@Test
function replacingExtensions(): void {
  assertEqString(replaceExtension("a/b.txt", ".md"), "a/b.md", "replace");
  assertEqString(replaceExtension("a/b", ".md"), "a/b.md", "add");
  assertEqString(replaceExtension("a/b.tar.gz", ""), "a/b.tar", "remove");
  assertEqString(replaceExtension("a/b/", ".x"), "a/b.x", "trailing separator dropped");
  assertEqString(replaceExtension("", ".x"), ".x", "no basename");
  assertEqString(withExtension("a/b.txt", ".md"), replaceExtension("a/b.txt", ".md"), "the deprecated name is the same function");
}
