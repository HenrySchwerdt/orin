// HTML rendering with OX (ADR-0043): the 2000-row product table of bench/html_hand (hand-written string concatenation),
// main.c and main.go, rendered 400 times by components. Every page is one buffer per component: the HTML elements of a
// component are fused into one appended string with the static parts merged at compile time; only the escaped values
// and the component results are separate pieces.
import { Html, render } from "std:html";

const ROWS: int = 2000;
const PAGES: int = 400;

function Row(id: int, name: string, price: int, url: string): Html {
  return <tr data-id={id} class={id % 2 == 0 ? "row even" : "row odd"}>
    <td class="name">{name}</td>
    <td class="price">{price}</td>
    <td><a href={url}>details</a></td>
    <td><input type="checkbox" disabled={id % 3 == 0} /></td>
  </tr>;
}

function Page(rows: Html[]): Html {
  return <html>
    <head><title>Products</title></head>
    <body>
      <h1 class="title">Catalog &amp; Prices</h1>
      <table class="products">{rows}</table>
      <p>{ROWS} items</p>
    </body>
  </html>;
}

function renderPage(names: string[], urls: string[], prices: int[]): string {
  let rows: Html[] = [];
  let i = 0;
  while (i < ROWS) {
    const k = i.toUsize();
    rows.push(<Row id={i} name={names[k]} price={prices[k]} url={urls[k]} />);
    i += 1;
  }
  return render(<Page rows={rows} />);
}

function main(): void {
  let names: string[] = [];
  let urls: string[] = [];
  let prices: int[] = [];
  let i = 0;
  while (i < ROWS) {
    let n = "Item " + i.toString();
    if (i % 7 == 0) {
      n += " <b>&\"sale\"</b> it's";
    }
    names.push(n);
    urls.push(i % 11 == 0 ? "javascript:alert(" + i.toString() + ")" : "/item/" + i.toString());
    prices.push((i * 37) % 1000);
    i += 1;
  }
  let total = 0;
  let last = "";
  let p = 0;
  while (p < PAGES) {
    last = renderPage(names, urls, prices);
    total += last.length.toInt();
    p += 1;
  }
  let h = 0;
  let k: usize = 0;
  while (k < last.length) {
    h = (h * 31 + last.charCodeAt(k)) % 1000000007;
    k += 1;
  }
  console.log("bytes " + total.toString());
  console.log("hash " + h.toString());
  console.log("head " + last.substring(0, 120));
}
