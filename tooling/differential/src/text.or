// Text helpers of the differential harness: shell quoting, `strip`, cutting, Python-compatible `repr` of strings and
// bytes, byte-order sorting. Pure functions, no I/O (tests/text_test.or).

// True for the ASCII whitespace Python's str.strip() removes from the files of this repository.
export function isSpace(c: int): bool {
  return c == 32 || (c >= 9 && c <= 13);
}

export function strip(s: string): string {
  let a: usize = 0;
  let b = s.length;
  while (a < b && isSpace(s.charCodeAt(a))) {
    a += 1;
  }
  while (b > a && isSpace(s.charCodeAt(b - 1))) {
    b -= 1;
  }
  return s.substring(a, b);
}

// POSIX shell quoting of one word.
export function shq(s: string): string {
  return "'" + s.split("'").join("'\\''") + "'";
}

// Cuts `s` to at most `n` bytes without splitting a UTF-8 sequence.
export function cutBytes(s: string, n: usize): string {
  if (s.length <= n) {
    return s;
  }
  let e = n;
  while (e > 0 && s.charCodeAt(e) >= 128 && s.charCodeAt(e) < 192) {
    e -= 1;
  }
  return s.substring(0, e);
}

// Python's repr of one string (for the `%r` of messages): quotes as for bytes, \\ \n \r \t escaped, other control
// characters as \xNN, everything else (UTF-8 text) unchanged.
export function reprStr(x: string): string {
  const hex = "0123456789abcdef";
  const quote = x.includes("'") && !x.includes("\"") ? "\"" : "'";
  let out = quote;
  let i: usize = 0;
  while (i < x.length) {
    const c = x.charCodeAt(i);
    if (c == 92) {
      out += "\\\\";
    } else if (c == 9) {
      out += "\\t";
    } else if (c == 10) {
      out += "\\n";
    } else if (c == 13) {
      out += "\\r";
    } else if (c == 39 && quote == "'") {
      out += "\\'";
    } else if (c < 32 || c == 127) {
      const hi = (c / 16).toUsize();
      const lo = (c % 16).toUsize();
      out += "\\x" + hex.substring(hi, hi + 1) + hex.substring(lo, lo + 1);
    } else {
      out += x.substring(i, i + 1);
    }
    i += 1;
  }
  return out + quote;
}

// Python's repr of a bytes object: b'...' (double quotes when the content has ' and no "), \t \n \r and \\ escaped,
// other bytes outside 32..126 as \xNN. `s` holds the bytes (a file read as text).
export function reprBytes(s: string): string {
  const hex = "0123456789abcdef";
  const quote = s.includes("'") && !s.includes("\"") ? "\"" : "'";
  let out = "b" + quote;
  let i: usize = 0;
  while (i < s.length) {
    const c = s.charCodeAt(i);
    if (c == 92) {
      out += "\\\\";
    } else if (c == 9) {
      out += "\\t";
    } else if (c == 10) {
      out += "\\n";
    } else if (c == 13) {
      out += "\\r";
    } else if (c == 39 && quote == "'") {
      out += "\\'";
    } else if (c >= 32 && c < 127) {
      out += s.substring(i, i + 1);
    } else {
      const hi = (c / 16).toUsize();
      const lo = (c % 16).toUsize();
      out += "\\x" + hex.substring(hi, hi + 1) + hex.substring(lo, lo + 1);
    }
    i += 1;
  }
  return out + quote;
}

// Byte-wise "a < b".
export function lessThan(a: string, b: string): bool {
  const n = a.length < b.length ? a.length : b.length;
  let i: usize = 0;
  while (i < n) {
    const x = a.charCodeAt(i);
    const y = b.charCodeAt(i);
    if (x != y) {
      return x < y;
    }
    i += 1;
  }
  return a.length < b.length;
}

// Sorted copy (stable merge sort, byte order: Python's sorted() on ASCII/UTF-8 text).
export function sortedStrings(xs: string[]): string[] {
  if (xs.length <= 1) {
    return xs;
  }
  const mid = xs.length / 2;
  let l: string[] = [];
  let r: string[] = [];
  let i: usize = 0;
  while (i < xs.length) {
    if (i < mid) {
      l.push(xs[i]);
    } else {
      r.push(xs[i]);
    }
    i += 1;
  }
  const a = sortedStrings(l);
  const b = sortedStrings(r);
  let out: string[] = [];
  let p: usize = 0;
  let q: usize = 0;
  while (p < a.length && q < b.length) {
    if (lessThan(b[q], a[p])) {
      out.push(b[q]);
      q += 1;
    } else {
      out.push(a[p]);
      p += 1;
    }
  }
  while (p < a.length) {
    out.push(a[p]);
    p += 1;
  }
  while (q < b.length) {
    out.push(b[q]);
    q += 1;
  }
  return out;
}
