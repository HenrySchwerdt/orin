function pick(k: int): (x: int) => int {
  return x => x + k;
}

// A function value of unknown origin is called: the target is not known, so the effect is UNKNOWN, never pure.
export function runDynamic(): int {
  const f = pick(1);
  return f(2);
}

function apply(f: (x: int) => int, x: int): int {
  return f(x);
}

// A closure literal handed to a function that calls its parameter: the effects are those of the literal (none here).
export function runLiteral(): int {
  return apply(x => x * 2, 21);
}
