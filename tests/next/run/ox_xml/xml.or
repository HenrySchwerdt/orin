// A `Markup<Xml>` OX provider (ADR-0044 §3, §4.3): XML, not HTML. Differences from std:html: its own escape table
// (`& < > "`, the apostrophe is kept), void tags end with "/>", no presence attributes, no raw text elements except
// `cdata`, `href` and `ref` go through a converter of this module, `script-*` attributes are static only.
import { Markup, AttrRule, Escape } from "std:ox";

// Rendered XML. Sealed: only OX and this module build it.
@Sealed
export type Xml = { xml: string; };

// The run-time encoding of a computed string: & < > " become entities, every other byte is kept.
export function escapeXml(s: string): string {
  let out = "";
  let i: usize = 0;
  while (i < s.length) {
    const c = s.charCodeAt(i);
    if (c == 38) {
      out += "&amp;";
    } else if (c == 60) {
      out += "&lt;";
    } else if (c == 62) {
      out += "&gt;";
    } else if (c == 34) {
      out += "&quot;";
    } else {
      out += s.substring(i, i + 1);
    }
    i += 1;
  }
  return out;
}

// The converter of `href` and `ref`: spaces become %20, then the value is encoded like any attribute value.
export function refAttr(s: string): string {
  let out = "";
  let i: usize = 0;
  while (i < s.length) {
    out += s.charCodeAt(i) == 32 ? "%20" : s.substring(i, i + 1);
    i += 1;
  }
  return escapeXml(out);
}

@Inline
export function wrapXml(markup: string): Xml {
  return Xml { xml: markup };
}

@Inline
export function embedXml(x: Xml): string {
  return x.xml;
}

@Inline
export function embedAllXml(xs: Xml[]): string {
  let out = "";
  for (const x of xs) {
    out += x.xml;
  }
  return out;
}

// The markup as a string.
export function render(x: Xml): string {
  return x.xml;
}

// A whole document: the XML declaration, then `x`.
export function document(x: Xml): string {
  return "<?xml version=\"1.0\" encoding=\"UTF-8\"?>" + x.xml;
}

export function ox(): Markup<Xml> {
  return Markup<Xml> {
    wrap: wrapXml,
    embed: embedXml,
    embedAll: embedAllXml,
    text: escapeXml,
    attr: escapeXml,
    rules: [
      AttrRule { names: ["href", "ref"], prefix: "", convert: Some(refAttr) },
      AttrRule { names: [], prefix: "script-", convert: None },
    ],
    escapes: [
      Escape { char: "&", encoded: "&amp;" },
      Escape { char: "<", encoded: "&lt;" },
      Escape { char: ">", encoded: "&gt;" },
      Escape { char: "\"", encoded: "&quot;" },
    ],
    voidTags: ["br", "item-ref"],
    voidEnd: "/>",
    rawTextTags: ["cdata"],
    presenceAttrs: false,
  };
}
