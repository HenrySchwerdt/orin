// Module loader: reads files, parses them, resolves imports, enforces module boundaries (E0302),
// acyclicity of files (E0303) and the module rules of a package (E0501, E0502, E0303).
//
// The units come out in dependency order: a depth-first walk in import order, a unit being
// completed (and numbered) after all its imports, the entry last. File paths are normalized
// lexically (see path.or), not canonicalized.

import { Module, Item, ImportDecl, Ident, parse } from "../syntax";
import { Span, SourceMap, SourceFile, Diagnostic, diag, span, isRenderable } from "../diag";
import { Manifest, edgeError, findModuleCycle, displayModule } from "../package";
import {
  ImportTarget, StdModule, Unit, LoadedProgram, LoadOutcome, failedLoad, importOf, isWellFormed,
} from "./program";
import { normalizePath, dirname, joinPath } from "./path";
import { PreludeRoot, noPreludeRoots } from "./prelude";
import { Sources } from "./sources";
import { FsGrant } from "std:fs";
import { Resolved, resolveImport, unitName } from "./resolve";
import { moduleOf, findManifest, readManifest, manifestEntry } from "./modules";

export type LoadResult = { program: LoadedProgram; sm: SourceMap; };

// An import between two different modules of a package, kept to check the module graph for cycles.
type ModuleEdge = { importer: string; imported: string; at: Span; };

// One load of a program. `files` and `units` are filled while walking the import graph; after a
// failed `run`, `files` holds every file read so far (the entry first, then in discovery order).
@Invariant(this.units.length == this.done.size)
@Invariant(this.done.size + this.stack.length <= this.files.length)
class Loader {
  files: SourceFile[] = [];
  private units: Unit[] = [];
  private done: Map<string, usize> = new Map<string, usize>(); // file path -> index in `units`
  private stack: string[] = []; // files being loaded (their imports are not complete yet)
  private edges: ModuleEdge[] = [];
  private src: Sources;
  private roots: PreludeRoot[];
  private base: string; // directory of the entry file; unit names are relative to it
  private srcRoot: string; // module ids are relative to this directory
  private manifest: Option<Manifest>;

  constructor(
    src: Sources,
    roots: PreludeRoot[],
    base: string,
    srcRoot: string,
    manifest: Option<Manifest>,
  ) {
    this.src = src;
    this.roots = roots;
    this.base = base;
    this.srcRoot = srcRoot;
    this.manifest = manifest;
  }

  // Loads the entry file and everything it imports; the entry is the last unit.
  run(fs: FsGrant, entry: string, entryDisplay: string): Result<LoadedProgram, Diagnostic> {
    this.visit(fs, entry, entryDisplay)?;
    this.checkModuleCycles()?;
    return Ok(LoadedProgram {
      units: this.units,
      entry: this.units.length - 1,
      manifest: this.manifest,
    });
  }

  // Opens, parses and completes the unit of file `path` (`display` is how diagnostics name it);
  // returns its index in `units`.
  private visit(fs: FsGrant, path: string, display: string): Result<usize, Diagnostic> {
    const text = this.src.read(fs, path);
    if (text.isErr()) {
      this.files.push(SourceFile { path: display, text: "" });
      return Err(
        diag(
          "E0301",
          span(this.files.length - 1, 0, 0),
          `cannot read \`${path}\`: ${text.unwrapErr()}`,
        ),
      );
    }
    const file = this.files.length;
    this.files.push(SourceFile { path: display, text: text.unwrap() });
    const parsed = parse(file, text.unwrap())?;
    // The entry file also gets the implicit imports of the prelude roots, in front of its own items.
    const ast = file == 0
        ? Module { file: parsed.file, items: this.preludeImports(file).concat(parsed.items) }
        : parsed;
    this.stack.push(path);
    let imports: ImportTarget[] = [];
    for (const item of ast.items) {
      const decl = importOf(item);
      if (decl.isSome()) {
        imports.push(this.importTarget(fs, path, decl.unwrap())?);
      }
    }
    this.stack.pop();
    const index = this.units.length;
    this.units.push(Unit {
      file: file,
      path: path,
      name: unitName(this.base, path),
      module: moduleOf(fs, this.src, this.srcRoot, path),
      ast: ast,
      imports: imports,
    });
    this.done.set(path, index);
    return Ok(index);
  }

  // `import {} from "<entry>"` for every prelude root that has an entry file (library roots such as
  // std:path are served from memory and imported on demand).
  private preludeImports(file: usize): Item[] {
    const sp = span(file, 0, 0);
    const none: Ident[] = [];
    return this.roots
        .filter(r => r.entry != "")
        .map(r => IImport(ImportDecl { names: none, path: r.entry, pathSpan: sp, span: sp }));
  }

  private importTarget(fs: FsGrant, importer: string, decl: ImportDecl): Result<ImportTarget, Diagnostic> {
    const res = resolveImport(fs, this.src, importer, decl.path, decl.pathSpan, this.base)?;
    if (res.std.isSome()) {
      return Ok(ImportStd(res.std.unwrap()));
    }
    this.recordModuleEdge(fs, importer, res.path, decl.pathSpan)?;
    const finished = this.done.get(res.path);
    if (finished.isSome()) {
      return Ok(ImportUnit(finished.unwrap()));
    }
    const open = this.stack.indexOf(res.path);
    if (open.isSome()) {
      // Import cycle: the stack from the file being re-entered, then that file again.
      const chain = this.stack
          .slice(open.unwrap(), this.stack.length)
          .concat([res.path])
          .map(p => unitName(this.base, p));
      return Err(diag("E0303", decl.pathSpan, `import cycle: ${chain.join(" -> ")}`));
    }
    return Ok(ImportUnit(this.visit(fs, res.path, res.path)?));
  }

  // In a package, an import between two different modules must be allowed by the manifest (E0501);
  // allowed edges are collected for the cycle check. Prelude units and files outside the src root
  // have no module ("").
  private recordModuleEdge(fs: FsGrant, importer: string, target: string, at: Span): Result<void, Diagnostic> {
    if (this.manifest.isNone()) {
      return Ok();
    }
    const fromModule = moduleOf(fs, this.src, this.srcRoot, importer);
    const toModule = moduleOf(fs, this.src, this.srcRoot, target);
    if (fromModule != "" && toModule != "" && fromModule != toModule) {
      const forbidden = edgeError(this.manifest.unwrap(), fromModule, toModule);
      if (forbidden.isSome()) {
        return Err(diag("E0501", at, forbidden.unwrap()));
      }
      this.edges.push(ModuleEdge { importer: fromModule, imported: toModule, at: at });
    }
    return Ok();
  }

  // The module graph of a package must be acyclic (E0303), reported at the import that closes the
  // cycle: the last edge back to the cycle's first module.
  private checkModuleCycles(): Result<void, Diagnostic> {
    const cycle = findModuleCycle(this.edges.map(e => e.importer), this.edges.map(e => e.imported));
    if (cycle.length == 0) {
      return Ok();
    }
    const last = cycle[cycle.length - 1];
    const beforeLast = cycle[cycle.length - 2];
    const closing = this.edges.filter(e => e.importer == beforeLast && e.imported == last);
    const shown = cycle.map(m => displayModule(m)).join(" -> ");
    return Err(diag("E0303", closing[closing.length - 1].at, `module import cycle: ${shown}`));
  }
}

// True when every diagnostic can be rendered against `sm`.
function allRenderable(sm: SourceMap, ds: Diagnostic[]): bool {
  for (const d of ds) {
    if (!isRenderable(sm, d)) {
      return false;
    }
  }
  return true;
}

// Loads the program rooted at `entryPath`, which may also be a package directory (orin.toml) or a
// file inside one. File contents come from `overlay` (unsaved editor buffers, spec 18 §2) when a
// path matches (compared after `normalizePath`), otherwise from disk; an overlay file also counts as
// existing for import resolution. Every prelude root's files are served from memory and each root's
// entry file is imported (with no names) by the program's entry file, so the prelude units come
// first in `units` (before the entry's own dependencies) and are checked, lowered and emitted with
// the program. (The entry file keeps file id 0; prelude files get the next ids.)
@Ensures(result.program.isSome() == (result.diags.length == 0))
@Ensures(result.program.isSome() ==> isWellFormed(result.program.unwrap(), result.sm))
@Ensures(allRenderable(result.sm, result.diags))
export function loadWithRoots(
  fs: FsGrant,
  entryPath: string,
  overlay: SourceFile[],
  roots: PreludeRoot[],
): LoadOutcome {
  const src = new Sources(roots.reduce((all, r) => all.concat(r.files), overlay));
  let entry = normalizePath(entryPath);
  let entryDisplay = entryPath;
  let srcRoot = dirname(entry);
  let manifest: Option<Manifest> = None;
  const tomlPath = findManifest(fs, src, entry);
  if (tomlPath.isSome()) {
    const read = readManifest(fs, src, tomlPath.unwrap());
    if (read.isErr()) {
      return read.unwrapErr();
    }
    const m = read.unwrap();
    const packageEntry = manifestEntry(tomlPath.unwrap(), m);
    srcRoot = dirname(packageEntry);
    if (joinPath(entry, "orin.toml") == tomlPath.unwrap()) {
      // `entryPath` named the package directory: start at the package's entry file.
      entry = packageEntry;
      entryDisplay = packageEntry;
    }
    manifest = Some(m);
  }
  let loader = new Loader(src, roots, dirname(entry), srcRoot, manifest);
  const r = loader.run(fs, entry, entryDisplay);
  if (r.isErr()) {
    return failedLoad(loader.files, [r.unwrapErr()]);
  }
  return LoadOutcome {
    sm: SourceMap { files: loader.files },
    program: Some(r.unwrap()),
    diags: [],
  };
}

// Like loadWithRoots with the roots every compilation has (the array API and the Orin std modules).
export function loadWithOverlay(fs: FsGrant, entryPath: string, overlay: SourceFile[]): LoadOutcome {
  return loadWithRoots(fs, entryPath, overlay, noPreludeRoots());
}

export function loadAll(fs: FsGrant, entryPath: string): LoadOutcome {
  return loadWithOverlay(fs, entryPath, []);
}

export function load(fs: FsGrant, entryPath: string): Result<LoadResult, Diagnostic[]> {
  const o = loadAll(fs, entryPath);
  return match (o.program) {
    Some(p) => Ok(LoadResult { program: p, sm: o.sm }),
    None => Err(o.diags),
  };
}
