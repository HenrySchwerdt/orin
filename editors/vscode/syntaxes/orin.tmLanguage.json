{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Orin",
  "scopeName": "source.orin",
  "fileTypes": ["or"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#annotations" },
    { "include": "#declarations" },
    { "include": "#keywords" },
    { "include": "#constants" },
    { "include": "#types" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#calls" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.orin",
          "begin": "/\\*",
          "end": "\\*/",
          "beginCaptures": { "0": { "name": "punctuation.definition.comment.begin.orin" } },
          "endCaptures": { "0": { "name": "punctuation.definition.comment.end.orin" } }
        },
        {
          "name": "comment.line.double-slash.orin",
          "match": "(//).*$",
          "captures": { "1": { "name": "punctuation.definition.comment.orin" } }
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.orin",
      "begin": "\"",
      "end": "\"|$",
      "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.orin" } },
      "endCaptures": { "0": { "name": "punctuation.definition.string.end.orin" } },
      "patterns": [
        {
          "name": "constant.character.escape.orin",
          "match": "\\\\(?:[nrt0\\\\\"']|x[0-9A-Fa-f]{2})"
        },
        {
          "name": "invalid.illegal.escape.orin",
          "match": "\\\\."
        }
      ]
    },
    "annotations": {
      "name": "meta.annotation.orin",
      "match": "(@)([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "punctuation.definition.annotation.orin" },
        "2": { "name": "entity.name.function.annotation.orin" }
      }
    },
    "declarations": {
      "patterns": [
        {
          "name": "meta.function.orin",
          "match": "\\b(function)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.function.orin" },
            "2": { "name": "entity.name.function.orin" }
          }
        },
        {
          "name": "meta.type.declaration.orin",
          "match": "\\b(type)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.type.orin" },
            "2": { "name": "entity.name.type.orin" }
          }
        },
        {
          "name": "meta.definition.constant.orin",
          "match": "\\b(const)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.modifier.const.orin" },
            "2": { "name": "variable.other.constant.orin" }
          }
        },
        {
          "name": "meta.definition.variable.orin",
          "match": "\\b(let)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.modifier.let.orin" },
            "2": { "name": "variable.other.readwrite.orin" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.import.orin",
          "match": "\\b(import|from)\\b"
        },
        {
          "name": "keyword.control.export.orin",
          "match": "\\bexport\\b"
        },
        {
          "name": "keyword.control.flow.orin",
          "match": "\\b(if|else|while|for|of|break|continue|return|match)\\b"
        },
        {
          "name": "storage.type.class.orin",
          "match": "\\b(class|interface)\\b"
        },
        {
          "name": "keyword.other.orin",
          "match": "\\b(new|this|implements|extends)\\b"
        },
        {
          "name": "invalid.illegal.reserved.orin",
          "match": "\\b(var|enum|null|undefined|async|await)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.orin",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.option.orin",
          "match": "\\b(None|Some|Ok|Err)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.orin",
          "match": "\\b(int|usize|bool|string|void)\\b"
        },
        {
          "name": "support.type.builtin.orin",
          "match": "\\b(Option|Result)\\b"
        },
        {
          "name": "support.class.builtin.orin",
          "match": "\\b(console|String)\\b"
        },
        {
          "name": "entity.name.type.orin",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.orin",
          "match": "\\b0[xX][0-9A-Fa-f]+\\b"
        },
        {
          "name": "constant.numeric.decimal.orin",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "storage.type.function.arrow.orin",
          "match": "=>"
        },
        {
          "name": "keyword.operator.spread.orin",
          "match": "\\.\\.\\."
        },
        {
          "name": "keyword.operator.comparison.orin",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.assignment.compound.orin",
          "match": "\\+=|-=|\\*=|/=|%="
        },
        {
          "name": "keyword.operator.assignment.orin",
          "match": "="
        },
        {
          "name": "keyword.operator.logical.orin",
          "match": "&&|\\|\\||!|\\|"
        },
        {
          "name": "keyword.operator.arithmetic.orin",
          "match": "\\+|-|\\*|/|%"
        },
        {
          "name": "keyword.operator.ternary.orin",
          "match": "\\?|:"
        }
      ]
    },
    "calls": {
      "name": "meta.function-call.orin",
      "match": "\\b([a-z_][A-Za-z0-9_]*)\\s*(?=\\()",
      "captures": {
        "1": { "name": "entity.name.function.call.orin" }
      }
    },
    "punctuation": {
      "patterns": [
        { "name": "punctuation.terminator.statement.orin", "match": ";" },
        { "name": "punctuation.separator.comma.orin", "match": "," },
        { "name": "punctuation.accessor.orin", "match": "\\." },
        { "name": "punctuation.definition.block.orin", "match": "[{}]" },
        { "name": "punctuation.definition.array.orin", "match": "[\\[\\]]" },
        { "name": "punctuation.definition.parameters.orin", "match": "[()]" }
      ]
    }
  }
}
