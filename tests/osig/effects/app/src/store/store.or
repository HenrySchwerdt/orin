import { FsGrant, readFile, writeFile } from "std:fs";

// Direct input: Fs.ReadFile.
export function loadConfig(fs: FsGrant, path: string): string {
  const r = readFile(fs, path);
  return r.isOk() ? r.unwrap() : "";
}

// Direct output: Fs.WriteFile.
export function saveConfig(fs: FsGrant, path: string, text: string): void {
  writeFile(fs, path, text);
}

// Transitive: Fs.ReadFile through loadConfig.
export function reload(fs: FsGrant, path: string): string {
  return loadConfig(fs, path);
}
