// A complete annotation with a real processor (ADR-0046 S5): `@Describe("text")` on a type generates, in the companion module
// of the annotated module, `describe<Name>(): string` returning "<Name> - <text>". The processor is an ordinary pure function;
// the compiler builds it into a helper executable and runs it at compile time.
import { Input, Output, MDecl, fn, named, ret, str, exportDecl, output, findAnnotation, annotationArg, constString } from "std:meta";

@Annotation(type, function)
export type Describe = { text: string; };

@Processor(Describe)
export function describeProc(input: Input): Output {
  let decls: MDecl[] = [];
  for (const d of input.decls) {
    let text = "";
    const a = findAnnotation(d.annotations, "Describe");
    if (a.isSome()) {
      const v = annotationArg(a.unwrap(), "text");
      if (v.isSome()) {
        text = constString(v.unwrap()).unwrapOr("");
      }
    }
    const f = fn("describe" + d.name, [], named("string"), [ret(str(d.name + " - " + text))]);
    decls.push(exportDecl(f, true));
  }
  return output(decls);
}
