// Orin for TypeScript developers: tagged unions replace `int | string`; match is exhaustive.
type Id = Num(int) | Name(string);

function show(id: Id): string {
  return match (id) {
    Num(n) => `n${n}`,
    Name(s) => s,
  };
}

// No `==` on unions, records, classes, arrays or Option: compare the parts.
type Point = { x: int; y: int; };
function samePoint(a: Point, b: Point): bool {
  return a.x == b.x && a.y == b.y;
}

function main(): void {
  console.log(show(Num(1)));
  console.log(show(Name("bob")));
  console.log(`${samePoint(Point { x: 1, y: 2 }, Point { x: 1, y: 2 })}`);
}
