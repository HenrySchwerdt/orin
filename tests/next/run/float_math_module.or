import { sqrt, abs, min, max, pow, floor, ceil, round, PI, E } from "std:math";

function main(): void {
  console.log(PI.toString());
  console.log(E.toString());
  console.log(sqrt(144.0).toString());
  console.log(abs(-3.5).toString());
  console.log(abs(3.5).toString());
  console.log(min(2.0, 3.0).toString());
  console.log(max(2.0, 3.0).toString());
  console.log(min(-1.0, -2.0).toString());
  console.log(pow(2.0, 8.0).toString());
  console.log(pow(10.0, -2.0).toString());
  console.log(floor(-1.5).toString());
  console.log(ceil(-1.5).toString());
  console.log(round(1.5).toString());
  console.log(round(-1.5).toString());
  console.log(floor(7.0).toInt().toString());
  const r = 2.0;
  console.log((PI * r * r).toString());
  console.log(sqrt(2.0).toString());
}
