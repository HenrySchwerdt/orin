// Range facts for constant-length arrays (ADR-0038 lever 2 T6): nested loops, the inner index starts at the outer index plus one
// (the nbody pattern), several arrays of different lengths, and a bound that is only right for one of them.
function pairs(): int {
  const x: int[] = [1, 2, 3, 4, 5];
  const y: int[] = [10, 20, 30, 40, 50];
  let s = 0;
  let i: usize = 0;
  while (i < 5) {
    let j = i + 1;
    while (j < 5) {
      s += (x[i] - x[j]) * y[j] + y[i];
      j += 1;
    }
    i += 1;
  }
  return s;
}

function triangle(): int {
  const a: int[] = [1, 2, 3, 4];
  let s = 0;
  let i: usize = 0;
  while (i < 4) {
    let j: usize = 0;
    while (j <= i) {
      s += a[j] * a[i];
      j += 1;
    }
    i += 1;
  }
  return s;
}

// two arrays, the guard is the shorter length: both accesses stay in range
function zip(): int {
  const a: int[] = [1, 2, 3, 4, 5, 6];
  const b: int[] = [10, 20, 30];
  let s = 0;
  let i: usize = 0;
  while (i < b.length) {
    s += a[i] * b[i];
    i += 1;
  }
  return s;
}

// the inner loop reads a row of a flat 3 x 3 table: the index i * 3 + j is not tracked, the checks stay
function table(): int {
  const m: int[] = [1, 2, 3, 4, 5, 6, 7, 8, 9];
  let s = 0;
  let i: usize = 0;
  while (i < 3) {
    let j: usize = 0;
    while (j < 3) {
      s += m[i * 3 + j] * (i + 1).toInt();
      j += 1;
    }
    i += 1;
  }
  return s;
}

function main(): void {
  console.log(pairs().toString());
  console.log(triangle().toString());
  console.log(zip().toString());
  console.log(table().toString());
}
