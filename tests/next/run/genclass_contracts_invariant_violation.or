// flags: --check-contracts
// exit: 101
// stderr: contract violated: @Invariant(this.items.length <= this.cap)
// The invariant of a generic class is checked for every instantiation after the constructor and after
// every public method.
@Invariant(this.items.length <= this.cap)
class Bounded<T> {
  items: T[] = [];
  cap: usize;

  constructor(cap: usize) {
    this.cap = cap;
  }

  push(x: T): void {
    this.items.push(x);
  }
}

function main(): void {
  let ok = new Bounded<int>(1);
  ok.push(1);
  console.log("int ok");
  let b = new Bounded<string>(1);
  b.push("a");
  console.log("first");
  b.push("b");
  console.log("unreachable");
}
