// `orin test` must report this test as FAILED (a trap): a 204 response has no body, so a Response with a body for
// status 204 is not well formed (the constructor validates in every build).
import { Response, Http11, emptyHeaders, standardStatus } from "std:http";
import { fromString } from "std:bytes";

@Test
function constructorTrapsOnBodyWith204(): void {
  const r = new Response(standardStatus(204), Http11, emptyHeaders(), fromString("x"), emptyHeaders(), false);
  r.isBodyless();
}
