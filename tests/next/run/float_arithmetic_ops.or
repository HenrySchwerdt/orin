function main(): void {
  let x = 10.0;
  x += 2.5;
  console.log(x.toString());
  x -= 0.5;
  console.log(x.toString());
  x *= 3.0;
  console.log(x.toString());
  x /= 4.0;
  console.log(x.toString());
  console.log((x * x - 2.0 * x + 1.0).toString());
  console.log((-x).toString());
  console.log((-(x + 1.0)).toString());
  console.log((7.0 / 2.0).toString());
  console.log((1.0 - 0.9).toString());
  console.log((x < 9.0).toString());
  console.log((x <= 9.0).toString());
  console.log((x > 9.0).toString());
  console.log((x >= 9.0).toString());
  console.log((x == 9.0).toString());
  console.log((x != 9.0).toString());
  const big = 1.0e15;
  console.log((big + 0.3).toString());
  console.log((0.1 + 0.7).toString());
  console.log((4.35 * 100.0).toString());
}
