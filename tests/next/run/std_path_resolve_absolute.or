import { isAbsolute, resolveAgainst, joinAll, normalize } from "std:path";

function main(): void {
  console.log(isAbsolute("/a").toString() + " " + isAbsolute("a").toString() + " " + isAbsolute("").toString());
  console.log(resolveAgainst("/base/dir", "../x/y"));
  console.log(resolveAgainst("/base/dir", "/etc/../hosts"));
  console.log(resolveAgainst("rel", "a"));
  console.log(normalize(joinAll(["/a", "b", "..", "c", "."])));
}
