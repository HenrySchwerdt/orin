// Classes (ADR-0009), part 1: desugaring and class tables. Beyond Orin-B.
//
// `lowerClasses` runs before collection and replaces every `IClass` item by ordinary items:
//   * a record type `C` (parameter properties first, then the declared fields);
//   * a constructor function `C.constructor(params): C`. Its body binds `let this = C { .. }` built
//     from the leading `this.f = e;` statements, parameter properties and field initializers, then
//     runs the remaining statements (the checker appends `return this`);
//   * one function per method: `C.m(this$: C, params)` whose body starts with `let this = this$;`
//     (static methods: `C.s(params)` unchanged).
// Names such as `C.m` and `this$` cannot be written in source, so they never clash with user names.
// Everything that needs types (call lowering, mutation inference, access checks) lives in the
// checker proper (expr.or, stmt.or, classfix.or); this file only holds syntax-level work and the tables.

import { Span, Diagnostic, diag } from "../diag";
import {
  Ident, Item, Block, Stmt, SLet, SAssign, Expr, EIdent, EMember, EThis, ERecord, ERecordT, FieldInit, TypeExpr, TNamed, TArray, TFn,
  TypeDecl, DRecord, FieldDecl, FunctionDecl, Param, ClassDecl, MField, MCtor, MMethod, ClassField, CtorDecl,
  MethodDecl, IClass, IType, IFunction, OpAssign, Module, ContractClause
} from "../syntax";
import { LoadedProgram, Unit } from "../loader";
import { Type } from "../hir";
import {
  Env, ClassInfo, FieldAcc, MethodInfo, EntRecord, EntGen, EntIface, VFunc, VGFunc, findType, findVal, originOf, boundOf, showType,
  FmCtor, FmMethod, FmStatic, isRecordKind, cmpKindOfIface, builtinIface, isOpaqueRec, mapOrigin, parOrigin, typeEq, isVoid, isMapKeyType,
} from "./env";

export type Lowered = { prog: LoadedProgram; classes: ClassInfo[]; diags: Diagnostic[]; };

type ClassOut = { items: Item[]; info: ClassInfo; diags: Diagnostic[]; };

// `Box<T>` for a generic class (ADR-0026): the class name applied to its own type parameters.
function paramTypes(tps: Ident[]): TypeExpr[] {
  let out: TypeExpr[] = [];
  for (const p of tps) {
    out.push(TypeExpr { kind: TNamed(p, []), span: p.span });
  }
  return out;
}

// The first class type parameter mentioned in `te`, if any.
function mentionedParam(te: TypeExpr, tps: Ident[]): Option<Ident> {
  return match (te.kind) {
    TNamed(id, args) => {
      if (args.length == 0) {
        for (const p of tps) {
          if (p.name == id.name) {
            return Some(id);
          }
        }
      }
      for (const a of args) {
        const r = mentionedParam(a, tps);
        if (r.isSome()) {
          return r;
        }
      }
      return None;
    },
    TArray(e) => mentionedParam(e, tps),
    TFn(ps, ret) => {
      for (const p of ps) {
        const r = mentionedParam(p.ty, tps);
        if (r.isSome()) {
          return r;
        }
      }
      return mentionedParam(ret, tps);
    }
  };
}

function selfTypeOf(c: ClassDecl): TypeExpr {
  return TypeExpr { kind: TNamed(c.name, paramTypes(c.typeParams)), span: c.name.span };
}

function fieldNamed(names: string[], n: string): bool {
  for (const x of names) {
    if (x == n) {
      return true;
    }
  }
  return false;
}

// Statements of a constructor body up to the first one that is not `this.f = e;` for a distinct
// field `f` (conservative definite-initialization rule of ADR-0009).
type Prefix = { inits: FieldInit[]; next: usize; };

function ctorPrefix(stmts: Stmt[], fieldNames: string[]): Prefix {
  let inits: FieldInit[] = [];
  let assigned: string[] = [];
  let k: usize = 0;
  let go = true;
  while (go && k < stmts.length) {
    go = false;
    match (stmts[k].kind) {
      SAssign(target, op, value) => {
        const plain = match (op) { OpAssign => true, _ => false };
        if (plain) {
          match (target.kind) {
            EMember(base, f) => {
              const onThis = match (base.kind) { EThis => true, _ => false };
              if (onThis && fieldNamed(fieldNames, f.name) && !fieldNamed(assigned, f.name)) {
                inits.push(FieldInit { name: f, value: value, span: stmts[k].span });
                assigned.push(f.name);
                go = true;
              }
            },
            _ => {}
          }
        }
      },
      _ => {}
    }
    if (go) {
      k += 1;
    }
  }
  return Prefix { inits: inits, next: k };
}

function lowerClass(ui: usize, c: ClassDecl): ClassOut {
  let diags: Diagnostic[] = [];
  let items: Item[] = [];
  match (c.ext) {
    Some(b) => {
      diags.push(diag("E0408", b.span, "class inheritance (`extends`) is not supported; use composition (ADR-0009)"));
    },
    None => {}
  }
  const generic = c.typeParams.length > 0;
  const noBounds: Option<Ident>[] = [];
  const noTps: Ident[] = [];
  let fields: ClassField[] = [];
  let ctors: CtorDecl[] = [];
  let methods: MethodDecl[] = [];
  for (const m of c.members) {
    match (m) {
      MField(f) => { fields.push(f); },
      MCtor(k) => { ctors.push(k); },
      MMethod(md) => { methods.push(md); }
    }
  }
  if (ctors.length > 1) {
    diags.push(diag("E0304", ctors[1].span, "class `" + c.name.name + "` has more than one constructor"));
  }
  const noParams: Param[] = [];
  let ctorParams: Param[] = noParams;
  let ctorSpan = c.name.span;
  let ctorBody: Block = Block { stmts: [], span: c.span };
  let propNames: string[] = [];
  let recFields: FieldDecl[] = [];
  let accs: FieldAcc[] = [];
  if (ctors.length > 0) {
    ctorSpan = ctors[0].span;
    ctorBody = ctors[0].body;
    let ps: Param[] = [];
    for (const p of ctors[0].params) {
      ps.push(Param { name: p.name, ty: p.ty, span: p.span });
      if (p.access > 0) {
        propNames.push(p.name.name);
        recFields.push(FieldDecl { name: p.name, ty: p.ty, annotations: [], span: p.span });
        accs.push(FieldAcc { name: p.name.name, priv: p.access == 2 });
      }
    }
    ctorParams = ps;
  }
  let fieldNames: string[] = [];
  for (const n of propNames) {
    fieldNames.push(n);
  }
  for (const f of fields) {
    fieldNames.push(f.name.name);
    recFields.push(FieldDecl { name: f.name, ty: f.ty, annotations: [], span: f.span });
    accs.push(FieldAcc { name: f.name.name, priv: f.priv });
  }

  // Constructor.
  const pre = ctorPrefix(ctorBody.stmts, fieldNames);
  let lit: FieldInit[] = [];
  let covered: string[] = [];
  for (const i of pre.inits) {
    covered.push(i.name.name);
  }
  for (const f of fields) {
    if (f.init.isSome() && !fieldNamed(covered, f.name.name)) {
      lit.push(FieldInit { name: f.name, value: f.init.unwrap(), span: f.span });
      covered.push(f.name.name);
    }
  }
  if (ctors.length > 0) {
    for (const p of ctors[0].params) {
      if (p.access > 0 && !fieldNamed(covered, p.name.name)) {
        lit.push(FieldInit { name: p.name, value: Expr { kind: EIdent(p.name), span: p.name.span }, span: p.span });
        covered.push(p.name.name);
      }
    }
  }
  for (const i of pre.inits) {
    lit.push(i);
  }
  let missing: string[] = [];
  for (const n of fieldNames) {
    if (!fieldNamed(covered, n)) {
      missing.push(n);
    }
  }
  if (missing.length > 0) {
    diags.push(diag(
      "E0411", ctorSpan,
      "field(s) not definitely initialized by the constructor of `" + c.name.name + "`: " + missing.join(", ")
        + " (only leading `this.f = e;` statements, parameter properties and field initializers count)"
    ));
  }
  const thisId = Ident { name: "this", span: ctorSpan };
  let cstmts: Stmt[] = [];
  cstmts.push(Stmt {
    kind: SLet(
      true,
      thisId,
      Some(selfTypeOf(c)),
      Expr {
        kind: generic ? ERecordT(c.name, paramTypes(c.typeParams), None, lit) : ERecord(c.name, None, lit),
        span: ctorSpan
      }
    ),
    span: ctorSpan
  });
  let k = pre.next;
  while (k < ctorBody.stmts.length) {
    cstmts.push(ctorBody.stmts[k]);
    k += 1;
  }

  const recDecl = TypeDecl {
    exported: c.exported,
    name: c.name,
    typeParams: c.typeParams,
    body: DRecord(recFields),
    contracts: [],
    annotations: c.annotations,
    span: c.span
  };
  items.push(IType(recDecl));
  // Contract clauses (ADR-0012): the class invariants and the constructor's own clauses are checked
  // with the constructor (it always exists); methods carry their own.
  let ctorClauses: ContractClause[] = [];
  for (const k of c.contracts) {
    ctorClauses.push(k);
  }
  if (ctors.length > 0) {
    for (const k of ctors[0].contracts) {
      ctorClauses.push(k);
    }
  }
  items.push(IFunction(FunctionDecl {
    exported: false,
    name: Ident { name: c.name.name + ".constructor", span: c.name.span },
    typeParams: c.typeParams,
    bounds: c.bounds,
    params: ctorParams,
    ret: Some(selfTypeOf(c)),
    body: Block { stmts: cstmts, span: ctorBody.span },
    contracts: ctorClauses,
    annotations: [],
    span: ctorSpan
  }));

  // Methods.
  let minfos: MethodInfo[] = [];
  let seen: string[] = [];
  for (const m of methods) {
    if (m.typeParams.length > 0) {
      diags.push(diag(
        "E0460", m.typeParams[0].span,
        "generic methods are not supported in Orin 1.0 (ADR-0026); make the class generic or use a generic function"
      ));
    }
    if (generic && m.isStatic) {
      // A static method has no instance, hence no type arguments (as in TypeScript): its signature may
      // not mention the class's type parameters.
      let sigTypes: TypeExpr[] = [];
      for (const p of m.params) {
        sigTypes.push(p.ty);
      }
      match (m.ret) {
        Some(rt) => { sigTypes.push(rt); },
        None => {}
      }
      for (const st of sigTypes) {
        const mp = mentionedParam(st, c.typeParams);
        if (mp.isSome()) {
          diags.push(diag(
            "E0461", mp.unwrap().span,
            "static method `" + m.name.name + "` cannot use the type parameter `" + mp.unwrap().name + "` of class `"
              + c.name.name + "` (a static method has no type arguments); use an instance method or a generic function"
          ));
        }
      }
    }
    if (fieldNamed(seen, m.name.name)) {
      diags.push(diag("E0304", m.name.span, "duplicate method `" + m.name.name + "` in class `" + c.name.name + "`"));
    }
    seen.push(m.name.name);
    let params: Param[] = [];
    let stmts: Stmt[] = [];
    if (!m.isStatic) {
      const recv = Ident { name: "this$", span: m.name.span };
      params.push(Param { name: recv, ty: selfTypeOf(c), span: m.name.span });
      stmts.push(Stmt {
        kind: SLet(true, thisId, None, Expr { kind: EIdent(recv), span: m.name.span }),
        span: m.name.span
      });
    }
    for (const p of m.params) {
      params.push(p);
    }
    for (const s of m.body.stmts) {
      stmts.push(s);
    }
    items.push(IFunction(FunctionDecl {
      exported: false,
      name: Ident { name: c.name.name + "." + m.name.name, span: m.name.span },
      typeParams: m.isStatic ? noTps : c.typeParams,
      bounds: m.isStatic ? noBounds : c.bounds,
      params: params,
      ret: m.ret,
      body: Block { stmts: stmts, span: m.body.span },
      contracts: m.contracts,
      annotations: m.annotations,
      span: m.span
    }));
    minfos.push(MethodInfo {
      name: m.name.name,
      fid: 0,
      isStatic: m.isStatic,
      priv: m.priv,
      mutating: false,
      hasRet: false,
      retRec: 0
    });
  }
  const info = ClassInfo {
    name: c.name.name,
    unit: ui,
    gid: -1,
    bounds: c.bounds,
    rec: 0,
    fields: accs,
    ctor: 0,
    methods: minfos,
    implNames: c.impls,
    impls: []
  };
  return ClassOut { items: items, info: info, diags: diags };
}

// Replaces every class of the program by its lowering. Units without classes are shared as is.
export function lowerClasses(prog: LoadedProgram): Lowered {
  let diags: Diagnostic[] = [];
  let classes: ClassInfo[] = [];
  let units: Unit[] = [];
  let ui: usize = 0;
  for (const u of prog.units) {
    let has = false;
    for (const it of u.ast.items) {
      match (it) {
        IClass(_) => { has = true; },
        _ => {}
      }
    }
    if (!has) {
      units.push(u);
    } else {
      let items: Item[] = [];
      for (const it of u.ast.items) {
        match (it) {
          IClass(c) => {
            const o = lowerClass(ui, c);
            for (const d of o.diags) {
              diags.push(d);
            }
            for (const x of o.items) {
              items.push(x);
            }
            classes.push(o.info);
          },
          _ => { items.push(it); }
        }
      }
      units.push(Unit {
        file: u.file,
        path: u.path,
        name: u.name,
        module: u.module,
        ast: Module { file: u.ast.file, items: items },
        imports: u.imports
      });
    }
    ui += 1;
  }
  return Lowered { prog: LoadedProgram { units: units, entry: prog.entry, manifest: prog.manifest }, classes: classes, diags: diags };
}

// After collection: finds the record and function ids of every class and tags the method
// functions with their class and mode (ADR-0009: mode 1 constructor, 2 method, 5 static).
// Generic classes (ADR-0026): the record is a generic type (`gid`), the constructor and instance methods
// are generic functions (their GenFunc entries carry the mode and class, instances inherit them).
export function buildClassTables(env0: Env, infos: ClassInfo[]): Env {
  let env = env0;
  let out: ClassInfo[] = [];
  let ci: usize = 0;
  for (const info of infos) {
    const scope = env.units[info.unit].scope;
    let c = info;
    match (findType(scope, info.name)) {
      Some(te) => {
        match (te) {
          EntRecord(r) => { c.rec = r; },
          EntGen(g) => { c.gid = g.toInt(); },
          _ => {}
        }
      },
      None => {}
    }
    match (findVal(scope, info.name + ".constructor")) {
      Some(ve) => {
        match (ve) {
          VFunc(f) => {
            c.ctor = f;
            env.funcs[f].mode = FmCtor;
            env.funcs[f].cls = ci;
          },
          VGFunc(f) => {
            c.ctor = f;
            env.gfuncs[f].mode = FmCtor;
            env.gfuncs[f].cls = ci;
          },
          _ => {}
        }
      },
      None => {}
    }
    let ms: MethodInfo[] = [];
    for (const m of info.methods) {
      let mi = m;
      match (findVal(scope, info.name + "." + m.name)) {
        Some(ve) => {
          match (ve) {
            VFunc(f) => {
              mi.fid = f;
              env.funcs[f].mode = m.isStatic ? FmStatic : FmMethod;
              env.funcs[f].cls = ci;
            },
            VGFunc(f) => {
              mi.fid = f;
              env.gfuncs[f].mode = FmMethod;
              env.gfuncs[f].cls = ci;
            },
            _ => {}
          }
        },
        None => {}
      }
      ms.push(mi);
    }
    c.methods = ms;
    out.push(c);
    ci += 1;
  }
  env.classes = out;
  return env;
}

// ---------------------------------------------------------------------------
// Lookups used while checking bodies
// ---------------------------------------------------------------------------

// The class that record `r` belongs to: an ordinary class's record, or an instance of a generic class's
// record (ADR-0026).
export function classOfRec(env: Env, r: usize): Option<usize> {
  let i: usize = 0;
  let anyGeneric = false;
  while (i < env.classes.length) {
    if (env.classes[i].gid < 0) {
      if (env.classes[i].rec == r) {
        return Some(i);
      }
    } else {
      anyGeneric = true;
    }
    i += 1;
  }
  if (anyGeneric) {
    const o = originOf(env, TyRecord(r));
    if (o.isSome() && isRecordKind(o.unwrap().kind)) {
      return classOfGeneric(env, o.unwrap().gid);
    }
  }
  return None;
}

// The generic class whose record is generic type `g`.
export function classOfGeneric(env: Env, g: usize): Option<usize> {
  let i: usize = 0;
  while (i < env.classes.length) {
    if (env.classes[i].gid == g.toInt()) {
      return Some(i);
    }
    i += 1;
  }
  return None;
}

export function findMethod(ci: ClassInfo, name: string): Option<usize> {
  let i: usize = 0;
  while (i < ci.methods.length) {
    if (ci.methods[i].name == name) {
      return Some(i);
    }
    i += 1;
  }
  return None;
}

export function fieldIsPrivate(ci: ClassInfo, name: string): bool {
  for (const f of ci.fields) {
    if (f.name == name) {
      return f.priv;
    }
  }
  return false;
}

// Does class record `r` declare `implements iface`? Also true for the opaque type of a parameter
// bounded by `iface` (abstract check).
export function recordImplements(env: Env, r: usize, iface: usize): bool {
  const co = classOfRec(env, r);
  if (co.isSome()) {
    for (const i of env.classes[co.unwrap()].impls) {
      if (i == iface) {
        return true;
      }
    }
    return false;
  }
  const b = boundOf(env, r);
  return b.isSome() && b.unwrap() == iface;
}

// ---------------------------------------------------------------------------
// The constraint interfaces Eq / Ord / Hash (ADR-0034)
// ---------------------------------------------------------------------------

// Why a type is not `Eq` / `Ord` / `Hash`: the error code (E0475: the type has no such instance, E0476: an explicit
// `equals` / `compare` / `hash` of a class is unusable or inconsistent) and the message.
export type CmpProb = { code: string; msg: string; };

function cmpWord(kind: usize): string {
  return kind == 1 ? "Eq" : (kind == 2 ? "Ord" : "Hash");
}

function prob(code: string, msg: string): Option<CmpProb> {
  return Some(CmpProb { code: code, msg: msg });
}

function inside(p: Option<CmpProb>, ctx: string): Option<CmpProb> {
  return match (p) {
    Some(q) => Some(CmpProb { code: q.code, msg: ctx + ": " + q.msg }),
    None => None,
  };
}

// None when a value of type `t` is `Eq` (kind 1), `Ord` (2) or `Hash` (3), else the reason. Tier 1 (derivation): the
// integers, `bool` and `string` are all three; `Option`, `Result`, arrays, records and unions are when all their
// components are; floats, function values, interface values and resource handles never are. Tier 2: a class is `Eq`
// when it declares `equals` (or `implements Eq`/`Ord`/`Hash`, which asks for the structural instance), `Ord` with
// `compare` (or `implements Ord`), `Hash` with `hash` (or `implements Hash`). A parameter bounded by `Ord` or `Hash`
// is `Eq` as well.
export function cmpProblem(env: Env, t: Type, kind: usize): Option<CmpProb> {
  const seen: string[] = [];
  return cmpProb(env, t, kind, seen, true);
}

// Like `cmpProblem`, but a record, union or class is accepted without looking inside: for a place where those types are
// still being declared (a `Map<K, V>` written in a declaration); the full check happens when a value is created.
export function cmpShapeProblem(env: Env, t: Type, kind: usize): Option<CmpProb> {
  const seen: string[] = [];
  return cmpProb(env, t, kind, seen, false);
}

function cmpProb(env: Env, t: Type, kind: usize, seen: string[], deep: bool): Option<CmpProb> {
  const w = cmpWord(kind);
  match (t) {
    TyFloat => {
      return prob("E0475", "`float` is not `" + w + "` (NaN is not equal to itself); use an integer, or a wrapper with an explicit total order");
    },
    TyF32 => {
      return prob("E0475", "`f32` is not `" + w + "` (NaN is not equal to itself); use an integer, or a wrapper with an explicit total order");
    },
    TyVoid => {
      return prob("E0475", "`void` has no value to compare");
    },
    TyArray(e) => {
      return inside(cmpProb(env, e, kind, seen, deep), "element type `" + showType(env, e) + "`");
    },
    TyOption(e) => {
      return inside(cmpProb(env, e, kind, seen, deep), "type `" + showType(env, e) + "` inside `Option`");
    },
    TyResult(a, b) => {
      if (!isVoid(a)) {
        const pa = cmpProb(env, a, kind, seen, deep);
        if (pa.isSome()) {
          return inside(pa, "type `" + showType(env, a) + "` inside `Result`");
        }
      }
      return inside(cmpProb(env, b, kind, seen, deep), "type `" + showType(env, b) + "` inside `Result`");
    },
    TyFn(_, _) => {
      return prob("E0475", "function values are neither `Eq`, `Ord` nor `Hash`");
    },
    TyIface(_) => {
      return prob("E0475", "interface values are neither `Eq`, `Ord` nor `Hash`");
    },
    TyFile => {
      return prob("E0475", "resource handles are neither `Eq`, `Ord` nor `Hash`");
    },
    TyGrant(_) => {
      return prob("E0475", "resource handles are neither `Eq`, `Ord` nor `Hash`");
    },
    TyUnion(u) => {
      if (!deep) {
        return None;
      }
      const key = "u" + u.toString();
      if (seen.includes(key)) {
        return None;
      }
      let seen2 = seen;
      seen2.push(key);
      for (const v of env.unions[u].variants) {
        for (const pt of v.payload) {
          const p = cmpProb(env, pt, kind, seen2, deep);
          if (p.isSome()) {
            return inside(p, "payload of variant `" + v.name + "` of `" + showType(env, t) + "`");
          }
        }
      }
      return None;
    },
    TyRecord(r) => {
      return recProb(env, r, kind, seen, deep);
    },
    _ => {
      return None;
    },
  }
}

function recProb(env: Env, r: usize, kind: usize, seen: string[], deep: bool): Option<CmpProb> {
  const w = cmpWord(kind);
  if (isOpaqueRec(env, r)) {
    const b = boundOf(env, r);
    if (b.isSome()) {
      const bk = cmpKindOfIface(env, b.unwrap());
      if (bk == kind || kind == 1 && bk > 0) {
        return None;
      }
    }
    const n = env.records[r].name;
    return prob("E0475", "type parameter `" + n + "` is not `" + w + "`; declare `" + n + " extends " + w + "`");
  }
  const t = TyRecord(r);
  if (mapOrigin(env, t).isSome() || parOrigin(env, t).isSome()) {
    return prob("E0475", "`" + showType(env, t) + "` is not `" + w + "`");
  }
  if (!deep) {
    return None;
  }
  const key = "r" + r.toString() + ":" + kind.toString();
  if (seen.includes(key)) {
    return None;
  }
  let seen2 = seen;
  seen2.push(key);
  const co = classOfRec(env, r);
  if (co.isSome()) {
    return classProb(env, co.unwrap(), r, kind, seen2);
  }
  return fieldsProb(env, r, kind, seen2);
}

function fieldsProb(env: Env, r: usize, kind: usize, seen: string[]): Option<CmpProb> {
  for (const f of env.records[r].fields) {
    const p = cmpProb(env, f.ty, kind, seen, true);
    if (p.isSome()) {
      return inside(p, "field `" + f.name + "` of `" + showType(env, TyRecord(r)) + "`");
    }
  }
  return None;
}

// The explicit method of tier 2 for `kind` (1 equals, 2 compare, 3 hash) of class `c`.
export function cmpMethodName(kind: usize): string {
  return kind == 1 ? "equals" : (kind == 2 ? "compare" : "hash");
}

// The method of tier 2 that class `c` declares for `kind`, if any.
export function cmpMethodOf(c: ClassInfo, kind: usize): Option<usize> {
  return findMethod(c, cmpMethodName(kind));
}

// Does class `c` ask for derivation with `implements Eq` / `Ord` / `Hash`? (`kind` 0: any of them.)
function implementsCmp(env: Env, c: ClassInfo, kind: usize): bool {
  for (const i of c.impls) {
    const k = cmpKindOfIface(env, i);
    if (k > 0 && (kind == 0 || k == kind)) {
      return true;
    }
  }
  return false;
}

function classProb(env: Env, ci: usize, rec: usize, kind: usize, seen: string[]): Option<CmpProb> {
  const c = env.classes[ci];
  const w = cmpWord(kind);
  const mEq = cmpMethodOf(c, 1);
  const mine = cmpMethodOf(c, kind);
  const sig = kind == 1 ? "equals(other: " + c.name + "): bool" : (kind == 2 ? "compare(other: " + c.name + "): int" : "hash(): usize");
  if (kind > 1) {
    const e = classProb(env, ci, rec, 1, seen);
    if (e.isSome()) {
      return e;
    }
  }
  if (mine.isSome()) {
    return methodProb(env, c, rec, mine.unwrap(), kind);
  }
  const wants = kind == 1 ? implementsCmp(env, c, 0) : implementsCmp(env, c, kind);
  if (!wants) {
    return prob("E0475", "class `" + c.name + "` is not `" + w + "`: declare `" + sig + "`, or `implements " + w + "` for the structural instance");
  }
  if (kind > 1 && mEq.isSome()) {
    return prob("E0476", "class `" + c.name + "` has an explicit `equals`, so `implements " + w + "` cannot derive `" + cmpMethodName(kind) + "` structurally (it could disagree with `equals`); declare `" + sig + "`");
  }
  return fieldsProb(env, rec, kind, seen);
}

// A declared `equals` / `compare` / `hash` must be a public, non-static, non-mutating instance method with the
// signature `equals(other: C): bool`, `compare(other: C): int`, `hash(): usize`. A generic class is checked on
// the instance when it is created (derive.or), because its signature mentions the type parameters.
function methodProb(env: Env, c: ClassInfo, rec: usize, m: usize, kind: usize): Option<CmpProb> {
  const mi = c.methods[m];
  const n = cmpMethodName(kind);
  const sig = kind == 1 ? "equals(other: " + c.name + "): bool" : (kind == 2 ? "compare(other: " + c.name + "): int" : "hash(): usize");
  if (mi.isStatic) {
    return prob("E0476", "`" + n + "` of class `" + c.name + "` is static; it must be an instance method `" + sig + "`");
  }
  if (mi.priv) {
    return prob("E0476", "`" + n + "` of class `" + c.name + "` is private; it must be public: `" + sig + "`");
  }
  if (mi.mutating) {
    return prob("E0476", "`" + n + "` of class `" + c.name + "` mutates its receiver; it must not");
  }
  if (c.gid < 0 && env.funcs[mi.fid].params.length > 0) {
    // (a method whose signature is not resolved yet, while declarations are resolved, is accepted here and checked on use)
    const f = env.funcs[mi.fid];
    const want = TyRecord(rec);
    const okParams = kind == 3 ? f.params.length == 1 : (f.params.length == 2 && typeEq(f.params[1], want));
    const wantRet: Type = kind == 1 ? TyBool : (kind == 2 ? TyInt : TyUsize);
    if (!okParams || !typeEq(f.srcRet, wantRet)) {
      return prob("E0476", "`" + n + "` of class `" + c.name + "` must have the signature `" + sig + "`");
    }
  }
  return None;
}

// The message of a bound that a type does not satisfy (`kind` 1..3), for `T extends Eq` of a function or class.
export function cmpBoundError(env: Env, t: Type, kind: usize, what: string, span: Span): Option<Diagnostic> {
  const p = cmpProblem(env, t, kind);
  if (p.isNone()) {
    return None;
  }
  return Some(diag(p.unwrap().code, span, "type `" + showType(env, t) + "` does not satisfy the bound `" + cmpWord(kind) + "` of " + what + ": " + p.unwrap().msg));
}

// Is `t` a type that is built from other types (so that a `Map` key problem is about its components)?
function isCompositeTy(env: Env, t: Type): bool {
  return match (t) {
    TyArray(_) => true,
    TyOption(_) => true,
    TyResult(_, _) => true,
    TyUnion(_) => true,
    TyRecord(r) => !isOpaqueRec(env, r),
    _ => false,
  };
}

// The error for a `Map` key type that is not `Hash` (E0400 for a type that can never be a key, such as `float`; E0475 when
// a component is the problem). `deep` false: records, unions and classes are taken on trust (declaration time).
export function mapKeyError(env: Env, t: Type, deep: bool, span: Span): Option<Diagnostic> {
  if (isMapKeyType(t)) {
    return None;
  }
  const p = deep ? cmpProblem(env, t, 3) : cmpShapeProblem(env, t, 3);
  if (p.isNone()) {
    return None;
  }
  return Some(diag(
    isCompositeTy(env, t) ? p.unwrap().code : "E0400",
    span,
    "`Map` keys must be `Hash` (integers, `bool`, `string`, and records, unions, `Option`, `Result` and arrays of them, or a class with `hash`), found `"
      + showType(env, t) + "`: " + p.unwrap().msg
  ));
}

// Does a value of type `t` satisfy the bound / convert to interface `iface`?
export function satisfies(env: Env, t: Type, iface: usize): bool {
  const ck = cmpKindOfIface(env, iface);
  if (ck > 0) {
    return cmpProblem(env, t, ck).isNone();
  }
  return match (t) {
    TyRecord(r) => recordImplements(env, r, iface),
    TyIface(j) => j == iface,
    _ => false
  };
}

// The interface named by the bound of type parameter `k` of `decl` (None: unbounded).
export function boundIface(env: Env, unit: usize, b: Ident): Result<usize, Diagnostic> {
  const found = findType(env.units[unit].scope, b.name);
  if (found.isNone()) {
    const bi = builtinIface(env, b.name);
    if (bi.isSome()) {
      return Ok(bi.unwrap());
    }
    return Err(diag("E0300", b.span, "unknown interface `" + b.name + "` in a type parameter bound"));
  }
  return match (found.unwrap()) {
    EntIface(i) => Ok(i),
    _ => Err(diag("E0400", b.span, "`" + b.name + "` is not an interface; only interfaces can bound a type parameter"))
  };
}

// A type argument of a generic class (`Box<Foo>`) that does not satisfy the bound of its parameter (E0417).
// Checked wherever the instance is created (ADR-0026).
export function checkClassBounds(env: Env, ci: usize, args: Type[], span: Span): Option<Diagnostic> {
  const c = env.classes[ci];
  let k: usize = 0;
  while (k < c.bounds.length && k < args.length) {
    match (c.bounds[k]) {
      Some(b) => {
        match (boundIface(env, c.unit, b)) {
          Ok(i) => {
            const ck = cmpKindOfIface(env, i);
            if (ck > 0) {
              const bad = cmpBoundError(env, args[k], ck, "class `" + c.name + "`", span);
              if (bad.isSome()) {
                return bad;
              }
            } else if (!satisfies(env, args[k], i)) {
              let why = "";
              match (args[k]) {
                TyRecord(r) => {
                  const co = classOfRec(env, r);
                  if (co.isSome()) {
                    why = ": class `" + env.classes[co.unwrap()].name + "` does not declare `implements " + b.name + "`";
                  }
                },
                _ => {}
              }
              return Some(diag(
                "E0417", span,
                "type `" + showType(env, args[k]) + "` does not satisfy the bound `" + env.gtypes[c.gid.toUsize()].decl.typeParams[k].name
                  + " extends " + env.ifaces[i].name + "` of class `" + c.name + "`" + why
              ));
            }
          },
          Err(d) => {
            return Some(d);
          }
        }
      },
      None => {}
    }
    k += 1;
  }
  return None;
}
