// Scripted LSP sessions against compiler/lsp (pure handler). Prints `ok` or one line per failure.
// Build: build/bootstrap/orin2 compile compiler/tests/lsp_test.or -o x.c && cc -O1 -w -I runtime x.c runtime/orin_runtime.c

import {
  LspState, LspStep, newLspState, withTestIndex, lspExitCode, handleText, pump, frameMessage, unframe,
  uriToPath, pathToUri, fullDocumentEdits
} from "../lsp";
import { Json, stringifyJson } from "../json";
import { SemanticIndex, SymbolDef, SymbolRef, TypeAt, SkFunction, SkParam } from "../hir";
import { span } from "../diag";
import { exit } from "std:process";

function eq(fails: string[], what: string, got: string, want: string): string[] {
  let f = fails;
  if (got != want) {
    f.push(what + ":\n  got  " + got + "\n  want " + want);
  }
  return f;
}

function show(s: LspStep): string {
  let parts: string[] = [];
  for (const j of s.out) {
    parts.push(stringifyJson(j));
  }
  return parts.join("\n");
}

function has(hay: string, needle: string): string {
  return hay.includes(needle).toString();
}

const INIT: string = "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{\"processId\":null,\"capabilities\":{}}}";

function open(st: LspState, uri: string, text: string): LspStep {
  return handleText(st, "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":{\"textDocument\":{\"uri\":\"" + uri
    + "\",\"languageId\":\"orin\",\"version\":1,\"text\":" + jsonStr(text) + "}}}");
}

function change(st: LspState, uri: string, text: string): LspStep {
  return handleText(st, "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didChange\",\"params\":{\"textDocument\":{\"uri\":\""
    + uri + "\",\"version\":2},\"contentChanges\":[{\"text\":" + jsonStr(text) + "}]}}");
}

function close(st: LspState, uri: string): LspStep {
  return handleText(st, "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didClose\",\"params\":{\"textDocument\":{\"uri\":\"" + uri + "\"}}}");
}

function req(st: LspState, id: int, method: string, params: string): LspStep {
  return handleText(st, "{\"jsonrpc\":\"2.0\",\"id\":" + id.toString() + ",\"method\":\"" + method + "\",\"params\":" + params + "}");
}

// JSON string literal for `s` (escapes quotes, backslashes and newlines).
function jsonStr(s: string): string {
  let out = "\"";
  let i: usize = 0;
  while (i < s.length) {
    const c = s.charCodeAt(i);
    if (c == 34) {
      out += "\\\"";
    } else if (c == 92) {
      out += "\\\\";
    } else if (c == 10) {
      out += "\\n";
    } else {
      out += s.charAt(i);
    }
    i += 1;
  }
  return out + "\"";
}

function diagNote(uri: string, diags: string): string {
  return "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/publishDiagnostics\",\"params\":{\"uri\":\"" + uri + "\",\"diagnostics\":[" + diags + "]}}";
}

function initialized(): LspState {
  const s1 = handleText(newLspState(), INIT);
  return handleText(s1.state, "{\"jsonrpc\":\"2.0\",\"method\":\"initialized\",\"params\":{}}").state;
}

function testLifecycle(f: string[]): string[] {
  let fails = f;
  // Requests before initialize are rejected.
  let s = handleText(newLspState(), "{\"jsonrpc\":\"2.0\",\"id\":7,\"method\":\"textDocument/documentSymbol\",\"params\":{}}");
  fails = eq(fails, "before init", show(s), "{\"jsonrpc\":\"2.0\",\"id\":7,\"error\":{\"code\":-32002,\"message\":\"server not initialized\"}}");

  s = handleText(newLspState(), INIT);
  fails = eq(fails, "initialize", show(s),
    "{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":{\"capabilities\":{\"textDocumentSync\":{\"openClose\":true,\"change\":1,\"save\":{\"includeText\":false}},"
    + "\"documentSymbolProvider\":true,\"completionProvider\":{\"resolveProvider\":false}},\"serverInfo\":{\"name\":\"orin\",\"version\":\"0.1.0\"}}}");
  s = handleText(s.state, "{\"jsonrpc\":\"2.0\",\"method\":\"initialized\",\"params\":{}}");
  fails = eq(fails, "initialized", show(s), "");

  // Unknown request -> MethodNotFound; unknown notification ignored; string ids are echoed.
  s = handleText(s.state, "{\"jsonrpc\":\"2.0\",\"id\":\"abc\",\"method\":\"textDocument/semanticTokens/full\",\"params\":{}}");
  fails = eq(fails, "method not found", show(s),
    "{\"jsonrpc\":\"2.0\",\"id\":\"abc\",\"error\":{\"code\":-32601,\"message\":\"method not found: textDocument/semanticTokens/full\"}}");
  s = handleText(s.state, "{\"jsonrpc\":\"2.0\",\"method\":\"$/setTrace\",\"params\":{\"value\":\"off\"}}");
  fails = eq(fails, "unknown notification", show(s), "");

  // Malformed JSON and missing params.
  s = handleText(s.state, "{oops");
  fails = eq(fails, "parse error", has(show(s), "\"code\":-32700"), "true");
  s = req(s.state, 3, "textDocument/documentSymbol", "{}");
  fails = eq(fails, "invalid params", show(s), "{\"jsonrpc\":\"2.0\",\"id\":3,\"error\":{\"code\":-32602,\"message\":\"invalid params\"}}");

  // Index-based features are not advertised/answered while the checker has no index.
  s = req(s.state, 4, "textDocument/definition", "{\"textDocument\":{\"uri\":\"file:///t/x.or\"},\"position\":{\"line\":0,\"character\":0}}");
  fails = eq(fails, "definition null", show(s), "{\"jsonrpc\":\"2.0\",\"id\":4,\"result\":null}");

  // shutdown / exit.
  s = req(s.state, 5, "shutdown", "null");
  fails = eq(fails, "shutdown", show(s), "{\"jsonrpc\":\"2.0\",\"id\":5,\"result\":null}");
  s = req(s.state, 6, "textDocument/documentSymbol", "{}");
  fails = eq(fails, "after shutdown", has(show(s), "\"code\":-32600"), "true");
  fails = eq(fails, "no exit yet", lspExitCode(s.state).isNone().toString(), "true");
  s = handleText(s.state, "{\"jsonrpc\":\"2.0\",\"method\":\"exit\"}");
  fails = eq(fails, "exit code 0", lspExitCode(s.state).unwrapOr(-1).toString(), "0");

  const abrupt = handleText(initialized(), "{\"jsonrpc\":\"2.0\",\"method\":\"exit\"}");
  fails = eq(fails, "exit code 1", lspExitCode(abrupt.state).unwrapOr(-1).toString(), "1");
  return fails;
}

function testDiagnostics(f: string[]): string[] {
  let fails = f;
  const uri = "file:///t/a.or";
  let st = initialized();

  // Valid document: empty diagnostics.
  let s = open(st, uri, "function f(x: int): int {\n  return x;\n}\n");
  fails = eq(fails, "open valid", show(s), diagNote(uri, ""));
  st = s.state;

  // Syntax error -> E0200 at the offending token.
  s = change(st, uri, "function f( {\n");
  fails = eq(fails, "syntax", show(s), diagNote(uri,
    "{\"range\":{\"start\":{\"line\":0,\"character\":12},\"end\":{\"line\":0,\"character\":13}},\"severity\":1,\"code\":\"E0200\",\"source\":\"orin\","
    + "\"message\":\"expected identifier, found `{`\"}"));
  st = s.state;

  // Type error on the second line -> E0400 on `true`.
  s = change(st, uri, "function f(): int {\n  return true;\n}\n");
  fails = eq(fails, "type error", show(s), diagNote(uri,
    "{\"range\":{\"start\":{\"line\":1,\"character\":9},\"end\":{\"line\":1,\"character\":13}},\"severity\":1,\"code\":\"E0400\",\"source\":\"orin\","
    + "\"message\":\"expected `int`, found `bool`\"}"));
  st = s.state;

  // Fixed again: cleared.
  s = change(st, uri, "function f(): int {\n  return 1;\n}\n");
  fails = eq(fails, "fixed", show(s), diagNote(uri, ""));
  st = s.state;

  // Save re-publishes.
  s = handleText(st, "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didSave\",\"params\":{\"textDocument\":{\"uri\":\"" + uri + "\"}}}");
  fails = eq(fails, "save", show(s), diagNote(uri, ""));

  // Close clears.
  s = close(st, uri);
  fails = eq(fails, "close", show(s), diagNote(uri, ""));
  return fails;
}

function testCrossModule(f: string[]): string[] {
  let fails = f;
  const ua = "file:///w/main.or";
  const ub = "file:///w/lib.or";
  let st = initialized();
  let s = open(st, ub, "export function g(x: int): int {\n  return \"s\";\n}\n");
  st = s.state;
  // lib.or alone: its own type error.
  fails = eq(fails, "lib alone", has(show(s), "\"code\":\"E0400\""), "true");
  s = open(st, ua, "import { g } from \"./lib\";\nfunction main(): void {\n  console.log(g(1).toString());\n}\n");
  st = s.state;
  // main.or has no error of its own; the error in lib.or is attached to lib.or exactly once.
  const out = show(s);
  const lines = out.split("\n");
  fails = eq(fails, "cross n notes", lines.length.toString(), "2");
  fails = eq(fails, "cross lib", has(out, ub) + has(out, "\"code\":\"E0400\""), "truetrue");
  let mainNote = "";
  for (const l of lines) {
    if (l.includes(ua)) {
      mainNote = l;
    }
  }
  fails = eq(fails, "cross main clean", mainNote, diagNote(ua, ""));

  // Fix lib via a change: both documents clean.
  s = change(st, ub, "export function g(x: int): int {\n  return x;\n}\n");
  st = s.state;
  fails = eq(fails, "cross fixed", show(s), diagNote(ub, "") + "\n" + diagNote(ua, ""));

  // Break lib's export: the importer reports E0300.
  s = change(st, ub, "function g(x: int): int {\n  return x;\n}\n");
  st = s.state;
  fails = eq(fails, "cross E0300", has(show(s), "\"code\":\"E0300\""), "true");

  // Close lib: it is cleared (and the importer still sees it through the disk fallback, which
  // does not exist here -> E0301).
  s = close(st, ub);
  fails = eq(fails, "cross close", has(show(s), "\"code\":\"E0301\""), "true");
  return fails;
}

function testQueries(f: string[]): string[] {
  let fails = f;
  const uri = "file:///q/a.or";
  const src = "import { h } from \"./nothere\";\nexport type P = { x: int; };\nfunction f(a: int): int {\n  return a;\n}\n";
  let st = initialized();
  st = open(st, uri, src).state;

  let s = req(st, 10, "textDocument/documentSymbol", "{\"textDocument\":{\"uri\":\"" + uri + "\"}}");
  fails = eq(fails, "docsym", show(s),
    "{\"jsonrpc\":\"2.0\",\"id\":10,\"result\":["
    + "{\"name\":\"P\",\"detail\":\"type P (record)\",\"kind\":23,\"range\":{\"start\":{\"line\":1,\"character\":0},\"end\":{\"line\":1,\"character\":28}},"
    + "\"selectionRange\":{\"start\":{\"line\":1,\"character\":12},\"end\":{\"line\":1,\"character\":13}},\"children\":["
    + "{\"name\":\"x\",\"detail\":\"int\",\"kind\":8,\"range\":{\"start\":{\"line\":1,\"character\":18},\"end\":{\"line\":1,\"character\":25}},"
    + "\"selectionRange\":{\"start\":{\"line\":1,\"character\":18},\"end\":{\"line\":1,\"character\":19}},\"children\":[]}]},"
    + "{\"name\":\"f\",\"detail\":\"function f(a: int): int\",\"kind\":12,\"range\":{\"start\":{\"line\":2,\"character\":0},\"end\":{\"line\":4,\"character\":1}},"
    + "\"selectionRange\":{\"start\":{\"line\":2,\"character\":9},\"end\":{\"line\":2,\"character\":10}},\"children\":[]}]}");

  s = req(st, 11, "textDocument/completion", "{\"textDocument\":{\"uri\":\"" + uri + "\"},\"position\":{\"line\":3,\"character\":2}}");
  const c = show(s);
  fails = eq(fails, "completion head", has(c, "{\"jsonrpc\":\"2.0\",\"id\":11,\"result\":{\"isIncomplete\":false,\"items\":[{\"label\":\"P\",\"kind\":22,"), "true");
  fails = eq(fails, "completion decl", has(c, "{\"label\":\"f\",\"kind\":3,\"detail\":\"function f(a: int): int\"}"), "true");
  fails = eq(fails, "completion import", has(c, "{\"label\":\"h\",\"kind\":6,"), "true");
  fails = eq(fails, "completion keyword", has(c, "{\"label\":\"while\",\"kind\":14,\"detail\":\"keyword\"}"), "true");
  fails = eq(fails, "completion builtin", has(c, "{\"label\":\"Option\""), "true");

  // Formatting: stub returns no edits.
  s = req(st, 12, "textDocument/formatting", "{\"textDocument\":{\"uri\":\"" + uri + "\"},\"options\":{\"tabSize\":2,\"insertSpaces\":true}}");
  fails = eq(fails, "formatting stub", show(s), "{\"jsonrpc\":\"2.0\",\"id\":12,\"result\":[]}");

  // The edit helper used when a formatter is wired.
  const edits = fullDocumentEdits("a\nb", "a\n  b");
  fails = eq(fails, "full edit", stringifyJson(edits[0]),
    "{\"range\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":1,\"character\":1}},\"newText\":\"a\\n  b\"}");
  fails = eq(fails, "no edit", fullDocumentEdits("x", "x").length.toString(), "0");
  return fails;
}

function testIndexRequests(f: string[]): string[] {
  let fails = f;
  const uri = "file:///q/idx.or";
  const text = "function add(a: int): int { return a; }\nfunction main(): void { add(1); }\n";
  // Spans (file 0): decl `add` 9..12; param `a` 13..14; use of `a` at 35; call `add` on line 1.
  const l1: usize = 40;
  const defs = [
    SymbolDef { id: 0, name: "add", kind: SkFunction, nameSpan: span(0, 9, 12), declSpan: span(0, 0, 39), unit: 0, container: None, exported: false, detail: "function add(a: int): int" },
    SymbolDef { id: 1, name: "a", kind: SkParam, nameSpan: span(0, 13, 14), declSpan: span(0, 13, 19), unit: 0, container: Some(0), exported: false, detail: "a: int" },
    SymbolDef { id: 2, name: "main", kind: SkFunction, nameSpan: span(0, l1 + 9, l1 + 13), declSpan: span(0, l1, l1 + 33), unit: 0, container: None, exported: false, detail: "function main(): void" }
  ];
  const refs = [
    SymbolRef { span: span(0, 35, 36), def: 1 },
    SymbolRef { span: span(0, l1 + 24, l1 + 27), def: 0 }
  ];
  const types = [TypeAt { span: span(0, l1 + 24, l1 + 30), ty: "int" }];
  const idx = SemanticIndex { defs: defs, refs: refs, types: types };

  let st = withTestIndex(newLspState(), idx);
  const init = handleText(st, INIT);
  fails = eq(fails, "caps advertise", has(show(init), "\"definitionProvider\":true,\"hoverProvider\":true,\"referencesProvider\":true,\"renameProvider\":{\"prepareProvider\":true}"), "true");
  st = handleText(init.state, "{\"jsonrpc\":\"2.0\",\"method\":\"initialized\",\"params\":{}}").state;
  st = open(st, uri, text).state;
  const doc = "\"textDocument\":{\"uri\":\"" + uri + "\"}";
  const onCall = "\"position\":{\"line\":1,\"character\":24}";

  let s = req(st, 20, "textDocument/definition", "{" + doc + "," + onCall + "}");
  fails = eq(fails, "definition", show(s),
    "{\"jsonrpc\":\"2.0\",\"id\":20,\"result\":{\"uri\":\"" + uri + "\",\"range\":{\"start\":{\"line\":0,\"character\":9},\"end\":{\"line\":0,\"character\":12}}}}");
  s = req(st, 21, "textDocument/definition", "{" + doc + ",\"position\":{\"line\":0,\"character\":2}}");
  fails = eq(fails, "definition none", show(s), "{\"jsonrpc\":\"2.0\",\"id\":21,\"result\":null}");

  s = req(st, 22, "textDocument/hover", "{" + doc + "," + onCall + "}");
  fails = eq(fails, "hover", show(s),
    "{\"jsonrpc\":\"2.0\",\"id\":22,\"result\":{\"contents\":{\"kind\":\"markdown\",\"value\":\"```orin\\nfunction add(a: int): int\\n```\"},"
    + "\"range\":{\"start\":{\"line\":1,\"character\":24},\"end\":{\"line\":1,\"character\":27}}}}");
  s = req(st, 23, "textDocument/hover", "{" + doc + ",\"position\":{\"line\":1,\"character\":28}}");
  fails = eq(fails, "hover type", has(show(s), "\"value\":\"```orin\\nint\\n```\""), "true");

  s = req(st, 24, "textDocument/references", "{" + doc + "," + onCall + ",\"context\":{\"includeDeclaration\":true}}");
  fails = eq(fails, "references", show(s),
    "{\"jsonrpc\":\"2.0\",\"id\":24,\"result\":["
    + "{\"uri\":\"" + uri + "\",\"range\":{\"start\":{\"line\":0,\"character\":9},\"end\":{\"line\":0,\"character\":12}}},"
    + "{\"uri\":\"" + uri + "\",\"range\":{\"start\":{\"line\":1,\"character\":24},\"end\":{\"line\":1,\"character\":27}}}]}");
  s = req(st, 25, "textDocument/references", "{" + doc + "," + onCall + ",\"context\":{\"includeDeclaration\":false}}");
  fails = eq(fails, "references no decl", has(show(s), "\"line\":0"), "false");

  s = req(st, 26, "textDocument/prepareRename", "{" + doc + "," + onCall + "}");
  fails = eq(fails, "prepareRename", show(s),
    "{\"jsonrpc\":\"2.0\",\"id\":26,\"result\":{\"range\":{\"start\":{\"line\":1,\"character\":24},\"end\":{\"line\":1,\"character\":27}},\"placeholder\":\"add\"}}");

  s = req(st, 27, "textDocument/rename", "{" + doc + "," + onCall + ",\"newName\":\"plus\"}");
  fails = eq(fails, "rename", show(s),
    "{\"jsonrpc\":\"2.0\",\"id\":27,\"result\":{\"changes\":{\"" + uri + "\":["
    + "{\"range\":{\"start\":{\"line\":0,\"character\":9},\"end\":{\"line\":0,\"character\":12}},\"newText\":\"plus\"},"
    + "{\"range\":{\"start\":{\"line\":1,\"character\":24},\"end\":{\"line\":1,\"character\":27}},\"newText\":\"plus\"}]}}}");
  s = req(st, 28, "textDocument/rename", "{" + doc + "," + onCall + ",\"newName\":\"main\"}");
  fails = eq(fails, "rename collision", show(s),
    "{\"jsonrpc\":\"2.0\",\"id\":28,\"error\":{\"code\":-32803,\"message\":\"`main` is already defined in this scope\"}}");
  return fails;
}

function testFraming(f: string[]): string[] {
  let fails = f;
  fails = eq(fails, "frame", frameMessage("{\"a\":1}"), "Content-Length: 7\r\n\r\n{\"a\":1}");
  // Multi-byte body: Content-Length counts bytes.
  fails = eq(fails, "frame utf8", frameMessage("\"\xc3\xa9\""), "Content-Length: 4\r\n\r\n\"\xc3\xa9\"");
  const two = frameMessage("{\"a\":1}") + frameMessage("[2]");
  let u = unframe(two + "Content-Len");
  fails = eq(fails, "unframe ok", u.isOk().toString(), "true");
  if (u.isOk()) {
    fails = eq(fails, "unframe msgs", u.unwrap().messages.join("|"), "{\"a\":1}|[2]");
    fails = eq(fails, "unframe rest", u.unwrap().rest, "Content-Len");
  }
  u = unframe("Content-Length: 10\r\n\r\n12345");
  fails = eq(fails, "partial body", u.unwrap().messages.length.toString() + ":" + u.unwrap().rest.length.toString(), "0:27");
  u = unframe("content-length:  3 \r\nContent-Type: x\r\n\r\nabcX");
  fails = eq(fails, "case-insens", u.unwrap().messages.join("|") + "/" + u.unwrap().rest, "abc/X");
  fails = eq(fails, "missing header", unframe("Foo: 1\r\n\r\nabc").unwrapErr(), "missing Content-Length header");
  fails = eq(fails, "bad header", unframe("Content-Length: x\r\n\r\n").unwrapErr(), "invalid Content-Length header");

  // pump: framed initialize + shutdown in one buffer, split read for the second.
  const m1 = frameMessage(INIT);
  const m2 = frameMessage("{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"shutdown\"}");
  const cut = m2.length - 5;
  let p = pump(newLspState(), m1 + m2.substring(0, cut));
  fails = eq(fails, "pump 1", p.isOk().toString(), "true");
  if (p.isOk()) {
    const first = p.unwrap();
    fails = eq(fails, "pump 1 out", has(first.output, "\"capabilities\""), "true");
    fails = eq(fails, "pump rest", first.rest, m2.substring(0, cut));
    const p2 = pump(first.state, first.rest + m2.substring(cut, m2.length));
    fails = eq(fails, "pump 2", p2.unwrap().output, frameMessage("{\"jsonrpc\":\"2.0\",\"id\":2,\"result\":null}"));
  }

  fails = eq(fails, "uri->path", uriToPath("file:///a/b%20c/d.or").unwrapOr("?"), "/a/b c/d.or");
  fails = eq(fails, "uri other", uriToPath("untitled:x").isNone().toString(), "true");
  fails = eq(fails, "path->uri", pathToUri("/a/b c/d+e.or"), "file:///a/b%20c/d%2Be.or");
  return fails;
}

function main(): void {
  let f: string[] = [];
  f = testLifecycle(f);
  f = testDiagnostics(f);
  f = testCrossModule(f);
  f = testQueries(f);
  f = testIndexRequests(f);
  f = testFraming(f);
  if (f.length == 0) {
    console.log("ok");
  } else {
    for (const m of f) {
      console.log("FAIL " + m);
    }
    exit(1);
  }
}
