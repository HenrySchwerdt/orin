// `a + b` where `b` is a temporary that dies there is built in place on `b`'s buffer (docs/mir.md v2.3, `strprepend`), and
// `x.concat(y)` where `x` is a dying temporary extends `x` (`arrayextend`). Both only reuse an object nobody else holds: the
// runtime checks the reference count, so every case below also checks that every other name of the operand keeps its value.

function num(n: int): string {
  return n.toString();
}

function same(s: string): string {
  return s;
}

function sameArr(a: int[]): int[] {
  return a;
}

function sameStrs(a: string[]): string[] {
  return a;
}

function ints(a: int[]): string {
  let r = "";
  for (const v of a) {
    r += (r.length > 0 ? "," : "") + v.toString();
  }
  return r;
}

type Box = { s: string; xs: int[]; };

function fresh(): int[] {
  return [1, 2];
}

function big(n: int): string {
  let s = "";
  let i = 0;
  while (i < n) {
    s += "0123456789";
    i += 1;
  }
  return s;
}

function main(): void {
  // a fresh number string: the common case
  console.log("w" + num(5));
  console.log("" + num(5));
  console.log("w" + "");
  console.log("abc" + num(1234567) + "!");
  // the operand is shared: it must not change
  const a = num(42);
  const b = "p" + same(a);
  const c = "q" + same(a);
  console.log(a + " " + b + " " + c);
  // the operand is a field of a record, an element of an array: shared with its container
  const box: Box = Box { s: num(9), xs: [1] };
  const d = "f" + same(box.s);
  console.log(box.s + " " + d);
  const strs = [num(1), num(2)];
  const e = "e" + same(strs[0]) + same(strs[1]);
  console.log(strs.join(",") + " " + e);
  // aliases created before and after
  let x = num(100);
  const y = x;
  const z = "z" + same(x);
  x = "x" + x;
  console.log(x + " " + y + " " + z);
  // the left operand is the same text as the right one
  const t = num(7);
  console.log(t + t);
  console.log(same(t) + same(t));
  console.log("7" + same(t));
  // a long left operand and growth over several steps
  let acc = "";
  let i = 0;
  while (i < 5) {
    acc = num(i) + same(acc) + "-";
    i += 1;
  }
  console.log(acc);
  const g = big(30) + num(1);
  console.log(g.length.toString());
  let h = num(0);
  i = 0;
  while (i < 20) {
    h = big(3) + h;
    i += 1;
  }
  console.log(h.length.toString());
  // dying array operand
  console.log(ints(fresh().concat([3])));
  console.log(ints(fresh().concat(fresh()).concat(fresh())));
  const arr = [5, 6];
  const arr2 = sameArr(arr).concat([7]);
  console.log(ints(arr) + " " + ints(arr2));
  const arr3 = sameArr(arr).concat(sameArr(arr));
  console.log(ints(arr) + " " + ints(arr3));
  const base = ["a", "b"];
  const more = sameStrs(base).concat(["c"]).concat(sameStrs(base));
  console.log(base.join(",") + " " + more.join(","));
  const empty: int[] = [];
  console.log(sameArr(empty).concat(empty).length.toString() + " " + fresh().concat(empty).length.toString());
  // the operand is stored in a record before: a second owner
  const keep = fresh();
  const rec: Box = Box { s: "", xs: keep };
  const ext = same2(rec).concat([9]);
  console.log(ints(rec.xs) + " " + ints(ext));
}

function same2(r: Box): int[] {
  return r.xs;
}
