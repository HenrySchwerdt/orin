/**
 * A plane figure.
 *
 * @remarks Implemented by `Circle` and `Square`.
 */
export interface Shape {
  area(): int;
  name(): string;
}

export class Circle implements Shape {
  constructor(public radius: int) {}
  area(): int { return 3 * this.radius * this.radius; }
  name(): string { return "circle"; }
}

export class Square implements Shape {
  constructor(public side: int) {}
  area(): int { return this.side * this.side; }
  name(): string { return "square"; }
}

// Generic with an interface bound: the call of `area` is a call of the interface method.
/** Sum of the areas of `xs`. */
export function totalArea<T extends Shape>(xs: T[]): int {
  let t = 0;
  for (const x of xs) {
    t += x.area();
  }
  return t;
}

// A call through an interface value.
export function describeFirst(xs: Shape[]): string {
  const s = xs[0];
  return s.name() + ":" + s.area().toString();
}

// A generic class with an interface bound: the call of `area` inside is a call of the interface method.
export class Bag<T extends Shape> {
  items: T[] = [];
  add(x: T): void { this.items.push(x); }
  total(): int {
    let t = 0;
    for (const x of this.items) {
      t += x.area();
    }
    return t;
  }
}
