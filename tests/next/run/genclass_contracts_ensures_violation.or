// flags: --check-contracts
// exit: 101
// stderr: contract violated: @Ensures(this.items.length == old(this.items.length) + 1)
class Stack<T> {
  items: T[] = [];

  @Ensures(this.items.length == old(this.items.length) + 1)
  push(x: T): void {
    // a bug: pushes only the first element
    if (this.items.length == 0) {
      this.items.push(x);
    }
  }
}

function main(): void {
  let s = new Stack<string>();
  s.push("a");
  console.log("one");
  s.push("b");
  console.log("two");
}
