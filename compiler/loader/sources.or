// Where the loader gets file contents from: in-memory files shadow the disk.

import { SourceFile } from "../diag";
import { readFile, exists, FsGrant } from "std:fs";
import { normalizePath } from "./path";

// In-memory files (unsaved editor buffers, spec 18 §2, and the embedded prelude roots) plus the
// disk. Paths are compared after `normalizePath`; an in-memory file also counts as existing.
export class Sources {
  private mem: Map<string, string> = new Map<string, string>();

  // `files` in priority order: when several have the same normalized path, the first one wins.
  constructor(files: SourceFile[]) {
    for (const f of files) {
      const p = normalizePath(f.path);
      if (!this.mem.has(p)) {
        this.mem.set(p, f.text);
      }
    }
  }

  // `p` must already be normalized. Disk access needs the file-system grant `fs` (ADR-0027): a class cannot hold a
  // grant, so every method that may touch the disk takes it as a parameter.
  exists(fs: FsGrant, p: string): bool {
    return this.mem.has(p) || exists(fs, p);
  }

  read(fs: FsGrant, p: string): Result<string, string> {
    const m = this.mem.get(p);
    return m.isSome() ? Ok(m.unwrap()) : readFile(fs, p);
  }
}
