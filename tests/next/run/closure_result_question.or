function parsePos(s: string): Result<int, string> {
  const r = parseInt(s);
  return match (r) {
    Some(n) => n >= 0 ? Ok(n) : Err("negative " + s),
    None => Err("not a number: " + s),
  };
}

function sumDoubled(xs: string[]): Result<int, string> {
  const step = (s: string): Result<int, string> => {
    const n = parsePos(s)?;
    return Ok(n * 2);
  };
  let total = 0;
  for (const x of xs) {
    total += step(x)?;
  }
  return Ok(total);
}

function main(): void {
  console.log(sumDoubled(["1", "2", "3"]).unwrap().toString());
  console.log(sumDoubled(["1", "zz", "3"]).unwrapErr());
  console.log(sumDoubled(["4", "-5"]).unwrapErr());
  const attempts = ["7", "x"].map(s => parsePos(s));
  console.log(attempts[0].isOk().toString() + attempts[1].isErr().toString());
  const safeDiv = (a: int, b: int): Result<int, string> => b == 0 ? Err("div by zero") : Ok(a / b);
  console.log(safeDiv(9, 3).unwrap().toString() + safeDiv(1, 0).unwrapErr());
}
