// A bounded generic function may be instantiated with the interface type itself.
interface Shape {
  area(): int;
}

class Sq implements Shape {
  constructor(public s: int) {}
  area(): int { return this.s * this.s; }
}

class Line implements Shape {
  area(): int { return 0; }
}

function sum<T extends Shape>(xs: T[]): int {
  let t = 0;
  for (const x of xs) {
    t += x.area();
  }
  return t;
}

function main(): void {
  const mixed: Shape[] = [new Sq(2), new Line(), new Sq(3)];
  console.log(sum(mixed).toString());
  console.log(sum<Shape>([new Sq(1), new Line()]).toString());
}
