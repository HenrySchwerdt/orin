function main(): void {
  let m = new Map<string, int>();
  m.set("a", 1);
  m.set("b", 2);
  if (m.delete("a")) {
    console.log("deleted a");
  } else {
    console.log("no a");
  }
  if (m.delete("a")) {
    console.log("deleted a again");
  } else {
    console.log("no a now");
  }
  const had = m.delete("b");
  console.log(had.toString() + " " + m.size.toString());
  let removed = 0;
  let keys = ["x", "y", "x"];
  m.set("x", 1);
  m.set("y", 2);
  for (const k of keys) {
    if (m.delete(k)) {
      removed += 1;
    }
  }
  console.log(removed.toString());
  console.log(m.size.toString());
}
