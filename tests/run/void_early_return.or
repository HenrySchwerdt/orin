function check(n: int): void {
  if (n < 0) {
    console.log("negative");
    return;
  }
  console.log("non-negative");
}

function loopReturn(xs: int[]): void {
  for (const x of xs) {
    if (x == 0) {
      console.log("found zero");
      return;
    }
  }
  console.log("no zero");
}

function main(): void {
  check(-1);
  check(0);
  loopReturn([1, 0, 2]);
  loopReturn([1, 2]);
}
