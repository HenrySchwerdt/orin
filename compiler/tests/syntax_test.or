// Unit tests of the front end's syntax module (rewrite step 3c): `Lexer`, `Parser`, the operator table, the placement
// rules, the comment scanner and the well-formedness predicates of tokens and trees. Run:
// `orin test compiler/tests/syntax_test.or --runtime runtime/core`. `orin test` checks contracts at run time, so the class
// invariants of `Lexer`, `Parser` and `OpTable`, the progress `@Ensures` of every `parseX` (`spansFrom`: at least one
// token consumed, the node spans exactly the consumed tokens) and the `@Ensures` of `lex` / `parse` (tokens and trees
// well formed, error spans inside the source) run on every call below.

import { assert, assertEq, assertEqString, assertEqUsize, assertEqBool, fail } from "std:test";
import { Span, Diagnostic, span } from "../diag";
import {
  Ident, Module, Item, Expr, ExprKind, BinaryOp, UnaryOp, ContractKind, AnnotationKind, Stmt,
  Pattern, TypeExpr, Block, ContractClause, Annotation, Token, TokKind, Lexer, lex, isEofTok,
  tokensWellFormed, Parser, parse, isSyntaxCode, OpRow, OpTable, binaryOps, opRowsOk, MAX_LEVEL,
  T_FUNCTION, T_METHOD, T_CTOR, T_CLASS, T_LOOP, T_CONST, T_FIELD, annotationName, clauseAllowed, annotationAllowed, checkPlacement,
  checkAnnoPlacement, inside, nestedIn, exprOk, exprShallowOk, stmtOk, typeOk, itemSpan,
  moduleWellFormed, Comment, scanComments, commentsWellFormed, cookOxText, decodeEntities, oxExprs,
  oxComponents, oxIsComponent, importedName,
} from "../syntax";

function sp(a: usize, b: usize): Span {
  return span(0, a, b);
}

function toks(src: string): Token[] {
  return lex(0, src).unwrap();
}

function opName(op: BinaryOp): string {
  return match (op) {
    BAdd => "+",
    BSub => "-",
    BMul => "*",
    BDiv => "/",
    BRem => "%",
    BEq => "==",
    BNe => "!=",
    BLt => "<",
    BLe => "<=",
    BGt => ">",
    BGe => ">=",
    BAnd => "&&",
    BOr => "||",
    BImplies => "==>",
  };
}

function unName(op: UnaryOp): string {
  return match (op) {
    UNot => "!",
    UNeg => "neg",
  };
}

// The shape of an expression as an S-expression (the parts the precedence tests look at).
function shape(e: Expr): string {
  return match (e.kind) {
    EIdent(id) => id.name,
    EInt(v) => `${v}`,
    EBinary(op, a, b) => `(${opName(op)} ${shape(a)} ${shape(b)})`,
    EUnary(op, x) => `(${unName(op)} ${shape(x)})`,
    ECond(c, a, b) => `(? ${shape(c)} ${shape(a)} ${shape(b)})`,
    ECall(f, args) => `(call ${shape(f)} ${args.map(a => shape(a)).join(" ")})`,
    ETyApp(id, tys) => `(tyapp ${id.name} ${tys.length})`,
    EMethodT(x, id, tys) => `(methodt ${shape(x)} ${id.name} ${tys.length})`,
    EMember(x, id) => `(. ${shape(x)} ${id.name})`,
    ETry(x) => `(try ${shape(x)})`,
    EArrow(ps, _, _) => `(arrow ${ps.length})`,
    _ => "?",
  };
}

function exprOf(src: string): Expr {
  let p = new Parser(toks(src));
  const r = p.parseExpr();
  assert(r.isOk(), `parses: ${src}`);
  assert(p.atEnd(), `consumes everything: ${src}`);
  return r.unwrap();
}

function errOf(src: string): Diagnostic {
  const r = parse(0, src);
  assert(r.isErr(), `is an error: ${src}`);
  return r.unwrapErr();
}

// A deterministic pseudo-random sequence (LCG), for the garbage inputs.
function nextSeed(s: int): int {
  return (s * 1103515245 + 12345) % 2147483648;
}

// ---------------------------------------------------------------------------
// Lexer
// ---------------------------------------------------------------------------

@Test
function lexerTokensAreOrderedAndEndWithEof(): void {
  const src = "const x: int = 0x1F + 2.5e3; // c\nlet s = \"a\\n\" + `t${x}u`; /* b */ f(a) ==> b ... 18446744073709551615";
  const ts = toks(src);
  assert(tokensWellFormed(ts, 0, src.length), "well formed");
  assert(isEofTok(ts[ts.length - 1]), "ends with KEof");
  assertEqString(ts[0].text, "const", "keyword");
  assertEq(ts[5].value, 31, "hex value");
  assertEqString(ts[7].text, "2.5e3", "float spelling (already canonical)");
  const big = ts[ts.length - 2];
  assertEq(big.value, -1, "2^64-1 is the 64-bit pattern -1");
  let texts: string[] = [];
  for (const t of ts) {
    texts.push(t.text);
  }
  assert(texts.includes("==>") && texts.includes("..."), "longest-match punctuation");
}

@Test
function lexerStepAdvancesUntilFinished(): void {
  const src = "  a = b(1, `x${ { y: 2 }.y }z`) ;\n// end";
  let lx = new Lexer(0, src);
  let steps: usize = 0;
  while (!lx.finished()) {
    const before = lx.position();
    const n = lx.tokens().length;
    lx.step();
    assert(lx.error().isNone(), "lexes");
    if (!lx.finished()) {
      assert(lx.position() > before, "a step advances the cursor");
      assertEqUsize(lx.tokens().length, n + 1, "a step adds one token");
      assertEqUsize(lx.tokens()[n].span.end, lx.position(), "the token ends at the cursor");
    }
    steps += 1;
    assert(steps <= src.length + 1, "terminates: at most one step per byte");
  }
  assertEqUsize(lx.position(), src.length, "finished at the end");
  // an error finishes the lexer and is kept
  let bad = new Lexer(0, "a \"open");
  while (!bad.finished()) {
    bad.step();
  }
  assert(bad.error().isSome(), "the error is kept");
  assertEqString(bad.error().unwrap().message, "unterminated string literal", "first error");
  assertEqUsize(bad.tokens().length, 1, "tokens before the error stay");
}

@Test
function lexerErrorsHaveSpansInsideTheSource(): void {
  const bad = [
    "\"abc",
    "\"a\nb\"",
    "/* open",
    "`a${b",
    "`x",
    "0x",
    "0xG",
    "1..2",
    "#",
    "\"\\q\"",
    "\"\\x4\"",
    "99999999999999999999999",
    "1.5e99999",
    ".5",
    "x @ y",
    "\xe9",
    "`a\\",
    "0x1.5",
    "12ab",
  ];
  for (const s of bad) {
    const r = lex(0, s);
    assert(r.isErr(), `lexical error: ${s}`);
    const d = r.unwrapErr();
    assertEqString(d.code, "E0100", `code: ${s}`);
    assert(d.span.start <= d.span.end && d.span.end <= s.length, `span inside the source: ${s}`);
  }
  assertEqString(lex(0, "/* x").unwrapErr().message, "unterminated block comment", "message kept");
  assertEqString(
    lex(0, "`a${b").unwrapErr().message,
    "unterminated template literal interpolation (missing `}`)",
    "message kept",
  );
}

@Test
function tokensWellFormedRejectsBrokenStreams(): void {
  const good = toks("a b");
  assert(tokensWellFormed(good, 0, 3), "good");
  assert(!tokensWellFormed(good, 0, 4), "KEof not at the end of the source");
  assert(!tokensWellFormed(good, 1, 3), "wrong file");
  const a = good[0];
  const b = good[1];
  const eof = good[2];
  const overlap = Token { kind: KIdent, text: "x", span: sp(0, 2), value: 0 };
  assert(!tokensWellFormed([a, overlap, eof], 0, 3), "overlapping tokens");
  assert(!tokensWellFormed([b, a, eof], 0, 3), "out of order");
  assert(!tokensWellFormed([a, b], 0, 3), "no KEof");
  assert(!tokensWellFormed([a, eof, b, eof], 0, 3), "two KEof");
  const empty = Token { kind: KIdent, text: "", span: sp(1, 1), value: 0 };
  assert(!tokensWellFormed([a, empty, eof], 0, 3), "empty token");
  assert(!tokensWellFormed([], 0, 0), "nothing");
}

// ---------------------------------------------------------------------------
// Operator table and precedence climbing
// ---------------------------------------------------------------------------

@Test
function operatorTableIsAPrecedenceTable(): void {
  const rows = binaryOps();
  assert(opRowsOk(rows), "the table is well formed");
  assertEqUsize(rows.length, 13, "13 binary operators");
  const t = new OpTable();
  assertEq(t.level("||"), 0, "|| loosest");
  assertEq(t.level("&&"), 1, "&&");
  assertEq(t.level("!="), 2, "!=");
  assertEq(t.level(">="), 3, ">=");
  assertEq(t.level("-"), 4, "-");
  assertEq(t.level("%"), MAX_LEVEL, "% tightest");
  assertEq(t.level("?"), -1, "? is not a binary operator");
  assertEq(t.level("==>"), -1, "==> is not in the table");
  assertEq(t.level("="), -1, "= is not an operator");
  // the invariant rejects tables that would mis-group
  let gap = binaryOps();
  gap[12] = OpRow { text: "%", level: 7, op: BRem, rightAssoc: false };
  assert(!opRowsOk(gap), "a level gap / out of range");
  let down = binaryOps();
  down[1] = OpRow { text: "&&", level: 0, op: BAnd, rightAssoc: false };
  down[0] = OpRow { text: "||", level: 1, op: BOr, rightAssoc: false };
  assert(!opRowsOk(down), "levels decrease");
  let mixed = binaryOps();
  mixed[9] = OpRow { text: "-", level: 4, op: BSub, rightAssoc: true };
  assert(!opRowsOk(mixed), "mixed associativity on one level");
}

@Test
function precedenceAndAssociativity(): void {
  assertEqString(shape(exprOf("a - b - c")), "(- (- a b) c)", "left-associative");
  assertEqString(shape(exprOf("a + b * c - d")), "(- (+ a (* b c)) d)", "* binds tighter");
  assertEqString(shape(exprOf("a || b && c || d")), "(|| (|| a (&& b c)) d)", "&& tighter than ||");
  assertEqString(
    shape(exprOf("a < b == c > d")),
    "(== (< a b) (> c d))",
    "comparison tighter than equality",
  );
  assertEqString(shape(exprOf("!a && -b * c")), "(&& (! a) (* (neg b) c))", "unary tightest");
  assertEqString(shape(exprOf("a ? b : c ? d : e")), "(? a b (? c d e))", "?: right-associative");
  assertEqString(shape(exprOf("a ==> b ==> c")), "(==> a (==> b c))", "==> right-associative");
  assertEqString(shape(exprOf("a || b ? c : d")), "(? (|| a b) c d)", "?: below ||");
  assertEqString(shape(exprOf("a % b / c * d")), "(* (/ (% a b) c) d)", "one level, left to right");
}

@Test
function speculativeParsesBacktrack(): void {
  assertEqString(shape(exprOf("f<T>(x)")), "(call (tyapp f 1) x)", "type application");
  assertEqString(
    shape(exprOf("a < b > c")),
    "(> (< a b) c)",
    "a type-argument list not followed by ( or { is a comparison",
  );
  assertEqString(shape(exprOf("a < b")), "(< a b)", "comparison");
  assertEqString(shape(exprOf("(x: int): int => x")), "(arrow 1)", "arrow with result type");
  assertEqString(shape(exprOf("(a)")), "a", "parenthesised");
  assertEqString(shape(exprOf("(a, b) => a")), "(arrow 2)", "arrow");
  assertEqString(shape(exprOf("f(a)?.b")), "(. (try (call f a)) b)", "postfix chain");
}

// ---------------------------------------------------------------------------
// Parser: progress and spans
// ---------------------------------------------------------------------------

@Test
function everyParseMethodConsumesAndSpansItsTokens(): void {
  const exprs = [
    "x",
    "1 + 2",
    "f(a, b)[i].m",
    "Point { x: 1, y: 2 }",
    "match (v) { A => 1, _ => { return; } }",
    "`a${b}c`",
    "new C<T>(1)",
    "[1, 2]",
    "x => x + 1",
  ];
  for (const s of exprs) {
    let p = new Parser(toks(s));
    const r = p.parseExpr();
    assert(r.isOk(), `expr: ${s}`);
    assert(p.position() > 0 && p.atEnd(), `consumed: ${s}`);
    assertEqUsize(r.unwrap().span.start, 0, `starts at the first token: ${s}`);
    assertEqUsize(r.unwrap().span.end, s.length, `ends at the last token: ${s}`);
    assert(exprOk(r.unwrap()), `well formed: ${s}`);
  }
  const types = ["int", "Map<string, int[]>[]", "(a: int, b: T) => void", "(int)[]"];
  for (const s of types) {
    let p = new Parser(toks(s));
    const r = p.parseType();
    assert(
      r.isOk() && p.atEnd() && r.unwrap().span.end == s.length && typeOk(r.unwrap()),
      `type: ${s}`,
    );
  }
  const stmts = [
    "let x: int = 1;",
    "if (a) { b(); } else if (c) { } else { d = 1; }",
    "while (x) { break; }",
    "for (const a of xs) { continue; }",
    "return;",
    "{ x += 2; }",
  ];
  for (const s of stmts) {
    let p = new Parser(toks(s));
    const r = p.parseStmt();
    assert(
      r.isOk() && p.atEnd() && r.unwrap().span.end == s.length && stmtOk(r.unwrap()),
      `stmt: ${s}`,
    );
  }
  const pats = ["_", "None", "Some(x)", "-5", "\"s\"", "true", "Pair(A(_), b)"];
  for (const s of pats) {
    let p = new Parser(toks(s));
    const r = p.parsePattern();
    assert(r.isOk() && p.atEnd() && r.unwrap().span.end == s.length, `pattern: ${s}`);
  }
  const items = [
    "@Requires(x > 0) @Test function f(x: int): int { return x; }",
    "export type P = { a: int; };",
    "type U = A | B(int);",
    "const K: int = 1;",
    "@Invariant(this.n >= 0) class C<T> implements I { private n: int = 0; constructor(public a: int) { } @Ensures(result >= 0) m(): int { return this.n; } }",
    "interface I { @Deprecated(\"x\") m(a: int): bool; }",
    "import { a, b } from \"./m\";",
    "export { a } from \"./m\";",
  ];
  for (const s of items) {
    let p = new Parser(toks(s));
    const r = p.parseItem();
    assert(r.isOk() && p.atEnd(), `item: ${s}`);
    assertEqUsize(
      itemSpan(r.unwrap()).start,
      0,
      `item starts at its first decoration or keyword: ${s}`,
    );
    assertEqUsize(itemSpan(r.unwrap()).end, s.length, `item ends at its last token: ${s}`);
  }
}

@Test
function nothingConsumedOnlyWhereDocumented(): void {
  // a failing parse leaves the cursor on a token (the class invariant) and the final KEof is never consumed
  const bad = ["", ")", "}", "@Foo", "function", "class C {", "let = 1;", "x +", "match (x) {"];
  for (const s of bad) {
    const ts = toks(s);
    let p = new Parser(ts);
    const r = p.parseExpr();
    assert(p.position() < ts.length, `cursor on a token: ${s}`);
    if (r.isOk()) {
      assert(p.position() > 0, `a successful parse consumed: ${s}`);
    }
  }
}

@Test
function parseTerminatesOnGarbage(): void {
  // Token soups: random sequences of spellings that start most constructs, so the parser goes deep into every
  // production before it fails. Every parse returns (no loop without progress), with a parse-error code and a span
  // inside the source, or with a well-formed module.
  const words = [
    "(",
    ")",
    "{",
    "}",
    "[",
    "]",
    "<",
    ">",
    ",",
    ";",
    ":",
    "=>",
    "=",
    "==",
    "?",
    ".",
    "...",
    "@Requires",
    "@Test",
    "@",
    "function",
    "class",
    "interface",
    "type",
    "const",
    "let",
    "if",
    "else",
    "while",
    "for",
    "of",
    "return",
    "match",
    "new",
    "this",
    "export",
    "import",
    "from",
    "x",
    "T",
    "1",
    "2.5",
    "\"s\"",
    "`a${",
    "}b`",
    "`t`",
    "|",
    "-",
    "!",
    "+",
    "&&",
    "==>",
    "constructor",
    "private",
    "static",
    "extends",
    "implements",
    "var",
    "_",
    "\n",
  ];
  let seed: int = 7;
  let oks: usize = 0;
  let errs: usize = 0;
  let i: usize = 0;
  while (i < 400) {
    seed = nextSeed(seed);
    const n = seed % 40 + 1;
    let parts: string[] = [];
    let k: int = 0;
    while (k < n) {
      seed = nextSeed(seed);
      parts.push(words[(seed % words.length.toInt()).toUsize()]);
      k += 1;
    }
    const src = parts.join(" ");
    const r = parse(0, src);
    if (r.isOk()) {
      assert(moduleWellFormed(r.unwrap(), src.length), `well formed: ${src}`);
      oks += 1;
    } else {
      const d = r.unwrapErr();
      assert(isSyntaxCode(d.code), `code ${d.code}: ${src}`);
      assert(d.span.end <= src.length, `span inside the source: ${src}`);
      errs += 1;
    }
    i += 1;
  }
  assert(errs > 300, "garbage is mostly rejected");
  // Every prefix of a real program: the parser stops at the first error, wherever the text is cut.
  const prog = "@Requires(n >= 0)\nexport function f<T extends S>(n: int, g: (x: T) => bool): Result<int[], string> {\n  let xs: int[] = [];\n  for (const a of [1, 2]) { xs.push(a * n - 1); }\n  match (g) { A(y) => { return Ok(xs); }, _ => {} }\n  const s = `n=${n + 1}`;\n  return n > 0 ? Ok(xs) : Err(\"neg\");\n}\nclass C { private a: int = 1; m(): int { return this.a; } }\n";
  let cut: usize = 0;
  while (cut <= prog.length) {
    const src = prog.substring(0, cut);
    const r = parse(0, src);
    if (r.isErr()) {
      assert(r.unwrapErr().span.end <= src.length, `prefix ${cut}: span inside the source`);
    } else {
      assert(moduleWellFormed(r.unwrap(), src.length), `prefix ${cut}: well formed`);
    }
    cut += 1;
  }
  assert(parse(0, prog).isOk(), "the whole program parses");
}

@Test
function firstErrorIsReportedUnchanged(): void {
  const e1 = errOf("function f(): void { let x = 1 }");
  assertEqString(e1.code, "E0200", "code");
  assertEqString(e1.message, "expected `;`, found `}`", "message");
  assertEqUsize(e1.span.start, 31, "at the `}`");
  const e2 = errOf("function f(): void { var x = 1; }");
  assertEqString(e2.code, "E0201", "var");
  const e3 = errOf("function f(");
  assertEqString(e3.message, "expected identifier, found end of file", "end of file");
  const e4 = errOf("@Ensures(true) const K: int = 1;");
  assertEqString(e4.message, "contract clauses cannot precede a constant", "placement");
  const e5 = errOf("@Test @Test function f(): void {}");
  assertEqString(e5.code, "E0442", "duplicate annotation");
  const e6 = errOf("@Annotation function f(): void {}");
  assertEqString(e6.code, "E0441", "@Annotation without targets");
  assertEqString(errOf("@Annotation(function, statement) type T = {};").code, "E0441", "unknown target word");
  assertEqString(errOf("@Annotation(function) function f(): void {}").code, "E0440", "@Annotation only on records");
  assertEqString(errOf("@Foo @Foo function f(): void {}").code, "E0442", "duplicate user annotation");
  assertEqString(errOf("@Foo(1 function f(): void {}").code, "E0200", "unclosed argument list");
  assertEqString(errOf("function __g1(): void {}").code, "E0447", "reserved prefix");
  const e7 = errOf("interface I { x: int; }");
  assertEqString(e7.code, "E0408", "interface field");
  const e8 = errOf("type T<A extends B> = A;");
  assertEqString(e8.code, "E0408", "bound on a type alias");
}

// The bound names of the type parameters of the first item (a function, a class or its first method), `&`-joined per parameter.
function boundsOfFirst(src: string): string[] {
  const src2 = src;
  const m = parse(0, src2).unwrap();
  assert(moduleWellFormed(m, src2.length), `well formed: ${src2}`);
  let out: string[] = [];
  let bs: Ident[][] = [];
  match (m.items[0]) {
    IFunction(d) => {
      bs = d.bounds;
    },
    IClass(d) => {
      bs = d.bounds;
      match (d.members[0]) {
        MMethod(md) => {
          bs = bs.concat(md.bounds);
        },
        _ => {},
      }
    },
    _ => {},
  }
  for (const b of bs) {
    out.push(b.map(i => i.name).join("&"));
  }
  return out;
}

@Test
function boundListsParse(): void {
  assertEqString(boundsOfFirst("function f<T extends Ord & Hash, U, V extends A>(): void {}").join(","), "Ord&Hash,,A", "function");
  assertEqString(boundsOfFirst("function f<T extends A&B&C>(): void {}").join(","), "A&B&C", "three bounds, no spaces");
  assertEqString(boundsOfFirst("class C<K extends Hash & Ord> { m<V extends A & B>(): void {} }").join(","), "Hash&Ord,A&B", "class and method");
  assertEqString(errOf("function f<T extends A &>(): void {}").code, "E0200", "bound expected after `&`");
  assertEqString(errOf("function f<T extends & A>(): void {}").code, "E0200", "no leading `&`");
  assertEqString(errOf("type P<T extends A & B> = T;").code, "E0408", "bound list on a type alias");
}

// ---------------------------------------------------------------------------
// Well-formedness predicates
// ---------------------------------------------------------------------------

@Test
function spanPredicatesRejectMisplacedChildren(): void {
  assert(inside(sp(2, 3), sp(0, 5)), "inside");
  assert(!inside(sp(2, 6), sp(0, 5)), "overshoots");
  assert(!inside(span(1, 2, 3), sp(0, 5)), "other file");
  assert(nestedIn([sp(0, 1), sp(1, 2), sp(3, 5)], sp(0, 5)), "ordered children");
  assert(!nestedIn([sp(0, 2), sp(1, 3)], sp(0, 5)), "overlapping children");
  assert(!nestedIn([sp(3, 4), sp(0, 1)], sp(0, 5)), "children out of order");
  const a = Expr { kind: EIdent(Ident { name: "a", span: sp(0, 1) }), span: sp(0, 1) };
  const b = Expr { kind: EIdent(Ident { name: "b", span: sp(4, 5) }), span: sp(4, 5) };
  const good = Expr { kind: EBinary(BAdd, a, b), span: sp(0, 5) };
  assert(exprOk(good), "a + b");
  const short = Expr { kind: EBinary(BAdd, a, b), span: sp(0, 3) };
  assert(!exprShallowOk(short), "a span that misses a child");
  const swapped = Expr { kind: EBinary(BAdd, b, a), span: sp(0, 5) };
  assert(!exprOk(swapped), "children out of order");
  const deep = Expr {
    kind: EUnary(UNeg, Expr { kind: EIdent(Ident { name: "a", span: sp(2, 3) }), span: sp(0, 1) }),
    span: sp(0, 9),
  };
  assert(exprShallowOk(deep), "the root alone is fine");
  assert(!exprOk(deep), "a broken grandchild is found by the deep check");
  const m = parse(0, "function f(): void { g(1, 2); }").unwrap();
  assert(moduleWellFormed(m, 31), "a parsed module");
  assert(!moduleWellFormed(m, 10), "items past the end of the source");
  assert(!moduleWellFormed(Module { file: 1, items: m.items }, 31), "items in another file");
}

// ---------------------------------------------------------------------------
// Placement rules and comments
// ---------------------------------------------------------------------------

@Test
function placementRules(): void {
  const req = parse(0, "@Requires(true) function f(): void {}").unwrap();
  let cs: ContractClause[] = [];
  match (req.items[0]) {
    IFunction(d) => {
      cs = d.contracts;
    },
    _ => {},
  }
  assertEqUsize(cs.length, 1, "one clause");
  assert(checkPlacement(cs, T_FUNCTION).isOk(), "@Requires on a function");
  assert(checkPlacement(cs, T_METHOD).isOk(), "@Requires on a method");
  assert(checkPlacement(cs, T_CLASS).isErr(), "@Requires not on a class");
  assert(checkPlacement(cs, T_LOOP).isErr(), "@Requires not on a loop");
  assert(
    clauseAllowed(CInvariant, T_LOOP)
        && clauseAllowed(CInvariant, T_CLASS)
        && !clauseAllowed(CInvariant, T_FUNCTION),
    "@Invariant",
  );
  assert(
    annotationAllowed(ATest, T_FUNCTION) && !annotationAllowed(ATest, T_METHOD),
    "@Test only on functions",
  );
  assert(!annotationAllowed(ADeprecated, T_CONST), "@Deprecated not on a constant");
  const twice = [
    Annotation { kind: AInline, message: "", span: sp(0, 7) },
    Annotation { kind: AInline, message: "", span: sp(8, 15) },
  ];
  assertEqString(checkAnnoPlacement(twice, T_FUNCTION).unwrapErr().code, "E0442", "duplicate");
}

@Test
function userAnnotationsParse(): void {
  const m = parse(0, "@Foo(1, -2, [\"a\"], Get) @Annotation(field, const) type T = { @Bar x: int; };\n@Baz const K: int = 1;").unwrap();
  match (m.items[0]) {
    IType(d) => {
      assertEqUsize(d.annotations.length, 2, "two annotations");
      assertEqString(annotationName(d.annotations[0].kind), "@Foo", "user annotation name");
      match (d.annotations[0].kind) {
        ACustom(_, args) => {
          assertEqUsize(args.length, 4, "four arguments");
        },
        _ => {
          fail("expected a user annotation");
        },
      }
      match (d.body) {
        DRecord(fs) => {
          assertEqUsize(fs[0].annotations.length, 1, "field annotation");
          assert(fs[0].span.start < fs[0].name.span.start, "the field span starts at its annotation");
        },
        _ => {
          fail("expected a record");
        },
      }
    },
    _ => {
      fail("expected a type");
    },
  }
  match (m.items[1]) {
    IConst(k) => {
      assertEqUsize(k.annotations.length, 1, "constant annotation");
    },
    _ => {
      fail("expected a constant");
    },
  }
  assert(annotationAllowed(ACustom(Ident { name: "Foo", span: sp(0, 3) }, []), T_FIELD), "user annotations on fields");
  assert(!annotationAllowed(ACustom(Ident { name: "Foo", span: sp(0, 3) }, []), T_CTOR), "not on constructors");
}

@Test
function commentsAreFoundInOrder(): void {
  const src = "// a\nconst s = \"// not\"; /* b */\n\n  // c   \nconst t = `x${ /* in */ 1 }`;";
  const cs = scanComments(src);
  assertEqUsize(cs.length, 3, "three comments, none inside a string or template");
  assertEqString(cs[0].text, "// a", "line comment");
  assertEqString(cs[1].text, "/* b */", "block comment");
  assertEqString(cs[2].text, "// c", "trailing spaces trimmed");
  assertEqBool(cs[2].ownLine, true, "own line");
  assertEqBool(cs[2].blankBefore, true, "blank line before");
  assert(commentsWellFormed(cs, src), "well formed");
  const swapped = [cs[1], cs[0]];
  assert(!commentsWellFormed(swapped, src), "out of order");
  const wrongText = [
    Comment { start: 0, end: 4, text: "// b", isLine: true, ownLine: true, blankBefore: false },
  ];
  assert(!commentsWellFormed(wrongText, src), "text differs from the source");
}

// ---------------------------------------------------------------------------
// OX (ADR-0043)
// ---------------------------------------------------------------------------

function kindName(t: Token): string {
  return match (t.kind) {
    KOxOpen => "open",
    KOxEnd => "end",
    KOxText => "text",
    KIdent => "ident",
    KPunct => "punct",
    KStr => "str",
    KKeyword => "kw",
    KEof => "eof",
    _ => "other",
  };
}

function oxShape(src: string): string {
  return toks(src).map(t => kindName(t) + ":" + t.text).join(" ");
}

@Test
function lexerSplitsOxIntoTagsTextAndExpressions(): void {
  assertEqString(
    oxShape("x = <a class=\"c\" n={1}>hi {y} <b /></a>;"),
    "ident:x punct:= open:< ident:a ident:class punct:= str:c ident:n punct:= punct:{ other:1 punct:} end:> text:hi  punct:{ ident:y punct:} text:  open:< ident:b end:/> open:</ ident:a end:> punct:; eof:",
    "tokens of an element",
  );
}

@Test
function lexerKeepsLessThanAfterAnOperand(): void {
  assertEqString(oxShape("a <b"), "ident:a punct:< ident:b eof:", "comparison after a name");
  assertEqString(oxShape("f(x) <y"), "ident:f punct:( ident:x punct:) punct:< ident:y eof:", "after `)`");
  assertEqString(oxShape("xs[0] <y"), "ident:xs punct:[ other:0 punct:] punct:< ident:y eof:", "after `]`");
  assertEqString(oxShape("return <br/>"), "kw:return open:< ident:br end:/> eof:", "after `return`");
  assertEqString(oxShape("(<>t</>)"), "punct:( open:< end:> text:t open:</ end:> punct:) eof:", "fragment after `(`");
}

@Test
function lexerOxAttributeNamesAndStrings(): void {
  assertEqString(
    oxShape("(<a data-id='x &amp; \"y\"' class for />)"),
    "punct:( open:< ident:a ident:data-id punct:= str:x & \"y\" ident:class ident:for end:/> punct:) eof:",
    "dashes, keywords as names, single quotes, entities",
  );
}

@Test
function lexerOxStepContractHolds(): void {
  // every step adds exactly one token and advances (the @Ensures of `step`), also over whitespace-only text
  const src = "(<ul>\n  <li>a</li>\n  {/* c */}\n  <li>{b}</li>\n</ul>)";
  let lx = new Lexer(0, src);
  while (!lx.finished()) {
    lx.step();
  }
  assert(lx.error().isNone(), "no error");
  assert(tokensWellFormed(toks(src), 0, src.length), "well formed");
}

@Test
function lexerOxErrors(): void {
  const bad = ["(<a>x", "(<a>x } y</a>)", "(<a>x > y</a>)", "(<a b=\"x></a>)", "(<a @ />)", "(<a>< </a>)"];
  for (const b of bad) {
    const r = lex(0, b);
    assert(r.isErr(), "rejected: " + b);
    assertEqString(r.unwrapErr().code, "E0100", "lexical error: " + b);
    assert(r.unwrapErr().span.end <= b.length, "span inside: " + b);
  }
}

@Test
function oxTextWhitespaceRules(): void {
  assertEqString(cookOxText("  a  b  "), "  a  b  ", "one line: kept as written");
  assertEqString(cookOxText("\n    a\n    b\n  "), "a b", "lines trimmed and joined");
  assertEqString(cookOxText("\n   \n  "), "", "whitespace with a line break: nothing");
  assertEqString(cookOxText("a \n\t b"), "a b", "tabs are spaces");
  assertEqString(cookOxText("x\r\n  y"), "x y", "CRLF");
}

@Test
function oxEntities(): void {
  assertEqString(decodeEntities("a &amp; b &lt;&gt; &quot;&apos;"), "a & b <> \"'", "named");
  assertEqString(decodeEntities("&#65;&#x42;&#X43;"), "ABC", "numeric");
  assertEqString(decodeEntities("&#169;"), "\xc2\xa9", "UTF-8 of U+00A9");
  assertEqString(decodeEntities("&#x20AC;"), "\xe2\x82\xac", "UTF-8 of U+20AC");
  assertEqString(decodeEntities("&#x1F600;"), "\xf0\x9f\x98\x80", "UTF-8 of U+1F600");
  assertEqString(decodeEntities("&nope; & &amp &#0; &#xD800; &#x110000;"), "&nope; & &amp &#0; &#xD800; &#x110000;", "kept");
}

function parseExpr1(src: string): Expr {
  let p = new Parser(toks(src));
  return p.parseExpr().unwrap();
}

@Test
function parserBuildsOxElements(): void {
  const e = parseExpr1("<div id=\"a\" n={x} on>t {y}<b/><Card k={1}>c</Card></div>");
  assert(exprOk(e), "well formed");
  match (e.kind) {
    EOx(el) => {
      assertEqString(el.name.unwrap().name, "div", "name");
      assertEqUsize(el.attrs.length, 3, "attributes");
      assertEqUsize(el.children.length, 4, "children: text, expr, b, Card");
      assertEqUsize(oxExprs(el).length, 3, "expressions: x, y, 1");
      assertEqUsize(oxComponents(el).length, 1, "one component");
      assert(!oxIsComponent(el), "div is an element");
    },
    _ => {
      assert(false, "not OX");
    },
  }
}

@Test
function parserRejectsMalformedOx(): void {
  const bad = ["<a></b>", "<a x=1 />", "<a {p} />", "<a {...p x=\"1\" />", "<a x=\"1\" x=\"2\" />", "</>", "<>x</a>", "<a>x</>"];
  for (const b of bad) {
    const r = parse(0, "const v = " + b + ";");
    assert(r.isErr(), "rejected: " + b);
  }
}

// ADR-0044 syntax: `import ox`, spread attributes, named slots.

@Test
function parserImportOxIsAProvider(): void {
  const r = parse(0, "import ox from \"std:html\";\nimport { a } from \"m\";");
  assert(r.isOk(), "parses");
  match (r.unwrap().items[0]) {
    IImport(d) => {
      assert(d.provider, "provider");
      assertEqUsize(d.names.length, 0, "binds no name");
      assertEqString(d.path, "std:html", "path");
    },
    _ => {
      assert(false, "not an import");
    },
  }
  match (r.unwrap().items[1]) {
    IImport(d) => {
      assert(!d.provider, "ordinary import");
    },
    _ => {
      assert(false, "not an import");
    },
  }
  assertEqString(errOf("import ox from \"a\";\nimport ox from \"b\";").code, "E0200", "second provider");
  assert(parse(0, "import { ox } from \"a\"; import ox from \"b\";").isOk(), "ox as a name is still a name");
  assert(parse(0, "export ox from \"a\";").isErr(), "no export ox");
}

@Test
function parserBuildsOxSpreads(): void {
  const e = parseExpr1("<Card {...p} a=\"1\" {...q.r} />");
  assert(exprOk(e), "well formed");
  match (e.kind) {
    EOx(el) => {
      assertEqUsize(el.attrs.length, 3, "attributes");
      assertEqString(el.attrs[0].name.name, "...", "spread name");
      match (el.attrs[0].value) {
        JVSpread(_) => {},
        _ => {
          assert(false, "not a spread");
        },
      }
      assertEqUsize(oxExprs(el).length, 2, "p and q.r");
    },
    _ => {
      assert(false, "not OX");
    },
  }
  assert(parseExpr1("<div {...p} {...p} />").span.end > 0, "spreads may repeat, on any element at parse time");
}

@Test
function parserBuildsMemberTags(): void {
  const e = parseExpr1("<a.b.C x={1}>t<:s>u</:s></a.b.C>");
  assert(exprOk(e), "well formed");
  match (e.kind) {
    EOx(el) => {
      assertEqString(el.name.unwrap().name, "C", "the method is the last segment");
      assert(oxIsComponent(el), "a member tag is a component call");
      assertEqUsize(oxComponents(el).length, 0, "not a reference to a function");
      assertEqUsize(oxExprs(el).length, 2, "the receiver a.b and the value 1");
      match (el.recv.unwrap().kind) {
        EMember(base, n) => {
          assertEqString(n.name, "b", "receiver field");
          match (base.kind) {
            EIdent(id) => {
              assertEqString(id.name, "a", "receiver root");
            },
            _ => {
              assert(false, "root is not a name");
            },
          }
        },
        _ => {
          assert(false, "receiver is not a field access");
        },
      }
    },
    _ => {
      assert(false, "not OX");
    },
  }
  match (parseExpr1("<this.Row />").kind) {
    EOx(el) => {
      match (el.recv.unwrap().kind) {
        EThis => {},
        _ => {
          assert(false, "receiver is not `this`");
        },
      }
    },
    _ => {
      assert(false, "not OX");
    },
  }
  const bad = ["<a.b></a.b>", "<a.B></a.C>", "<a.B></B>", "<a.B></a>", "<a.B></a.B.C>", "<a.>x</a.>", "<a.B.>x</a.B.>", "<.B />"];
  for (const b of bad) {
    const r = parse(0, "const v = " + b + ";");
    assert(r.isErr(), "rejected: " + b);
    assertEqString(r.unwrapErr().code, "E0200", "syntax error code: " + b);
  }
}

@Test
function parserBuildsOxSlots(): void {
  const e = parseExpr1("<Dialog><:header>Title {t}<b/></:header>body<:footer></:footer></Dialog>");
  assert(exprOk(e), "well formed");
  match (e.kind) {
    EOx(el) => {
      assertEqUsize(el.children.length, 3, "slot, text, slot");
      match (el.children[0]) {
        JSlot(n, ks, _) => {
          assertEqString(n.name, "header", "slot name");
          assertEqUsize(ks.length, 3, "text, expr, element");
        },
        _ => {
          assert(false, "not a slot");
        },
      }
      match (el.children[2]) {
        JSlot(n, ks, _) => {
          assertEqString(n.name, "footer", "slot name");
          assertEqUsize(ks.length, 0, "empty slot");
        },
        _ => {
          assert(false, "not a slot");
        },
      }
      assertEqUsize(oxExprs(el).length, 1, "t");
    },
    _ => {
      assert(false, "not OX");
    },
  }
}

@Test
function parserRejectsMisplacedOxSlots(): void {
  const bad = [
    "<div><:x>a</:x></div>",
    "<><:x>a</:x></>",
    "<Card><div><:x>a</:x></div></Card>",
    "<Card><:x><:y>a</:y></:x></Card>",
    "<Card><:x>a</:y></Card>",
    "<Card><:x/></Card>",
    "<Card><:x a=\"1\">a</:x></Card>",
    "<Card><:x>a</x></Card>",
    "<Card>a</:x></Card>",
  ];
  for (const b of bad) {
    const r = parse(0, "const v = " + b + ";");
    assert(r.isErr(), "rejected: " + b);
    assertEqString(r.unwrapErr().code, "E0200", "syntax error code: " + b);
  }
  assert(parse(0, "const v = <Card><:x>a</Card>;").isErr(), "slot not closed (lexical error)");
}

// ADR-0048 addendum: namespace imports and import aliases.

@Test
function parserNamespaceImportCollectsItsUses(): void {
  const r = parse(0, "import * as m from \"./x\";\nfunction f(a: m.T): m.T { return m.g(a); }\nfunction h(m2: int): int { return m2; }");
  assert(r.isOk(), "parses");
  match (r.unwrap().items[0]) {
    IImport(d) => {
      assert(d.namespace.isSome(), "namespace");
      assertEqString(d.namespace.unwrap().name, "m", "namespace name");
      assertEqUsize(d.names.length, 0, "binds no single name");
      assertEqUsize(d.uses.length, 2, "m.T and m.g");
      assertEqString(d.uses[0].name, "m.T", "first use");
      assertEqString(d.uses[1].name, "m.g", "second use");
    },
    _ => {
      assert(false, "not an import");
    },
  }
}

@Test
function parserImportAliases(): void {
  const r = parse(0, "import { a as b, c, as, d as as } from \"./x\";\nexport { a as z } from \"./x\";");
  assert(r.isOk(), "parses");
  match (r.unwrap().items[0]) {
    IImport(d) => {
      assertEqUsize(d.names.length, 4, "four names");
      assertEqString(importedName(d, 0).name, "b", "alias");
      assertEqString(d.names[0].name, "a", "exported name");
      assertEqString(importedName(d, 1).name, "c", "no alias");
      assertEqString(importedName(d, 2).name, "as", "a name `as`");
      assertEqString(importedName(d, 3).name, "as", "an alias `as`");
    },
    _ => {
      assert(false, "not an import");
    },
  }
  match (r.unwrap().items[1]) {
    IReExport(d) => {
      assertEqString(importedName(d, 0).name, "z", "re-export alias");
    },
    _ => {
      assert(false, "not a re-export");
    },
  }
  assertEqString(errOf("import * from \"a\";").code, "E0200", "import * needs as");
  assert(parse(0, "import * as m, { a } from \"a\";").isErr(), "no mixed form");
  assert(parse(0, "export * as m from \"a\";").isErr(), "no namespace re-export");
  assert(parse(0, "import { a as } from \"a\";").isErr(), "alias needs a name");
}
