function upper(s: string): string {
  let out = "";
  let i: usize = 0;
  while (i < s.length) {
    const c = s.charCodeAt(i);
    if (c >= 97 && c <= 122) {
      out = out + String.fromCharCode(c - 32);
    } else {
      out = out + s.charAt(i);
    }
    i += 1;
  }
  return out;
}

function main(): void {
  console.log(String.fromCharCode(72) + String.fromCharCode(105) + String.fromCharCode(33));
  let s = "";
  let i = 97;
  while (i < 102) {
    s = s + String.fromCharCode(i);
    i += 1;
  }
  console.log(s);
  console.log("A".charCodeAt(0).toString());
  console.log(upper("Hello, World 42"));
}
