// exit: 101
// Traps under the sanitizers (ADR-0052 Addendum B, step R3e.4 gate): 10,000 tasks end on a trap, in waves of 100 tasks run by 100 driver
// tasks. A trap ends a task thread with the unwinding `thread_exit`, which must walk every frame between the trap and the thread entry:
// here 60 to 120 frames of generated code with live strings and arrays, and traps in generated code (index out of bounds, integer
// overflow) and in the runtime's own Orin frames (`Option.unwrap` -> $rt/leaf, `slice` -> $rt/array, `substring` -> $rt/str). The
// runtime lock and the monitors must not stay held, the heap of the dying task is retired (free lists drained, counters folded), and
// the end of the task is announced to its joiner: nothing may hang, race or touch freed memory.
//
// A task announces itself on a channel just before it traps, and the main task starts the next driver only when the 100 tasks of the
// last one have announced themselves, so at most a few hundred threads exist at a time (ThreadSanitizer allows 8,128). Nobody
// joins a trapped task but the scope that spawned it: the scope of each driver traps when its 100 tasks have ended, and the scope of the main task
// traps when the 100 drivers have ended, with the message of the first panic, "trap: task panicked: task panicked: index out of bounds",
// status 101.
import { scopeDo, spawnDo, channel } from "std:task";

// `n` frames, each holding a string and an array, then the trap of kind `kind`.
function deep(n: int, kind: int): int {
  const xs: int[] = [n, n + 1, n + 2];
  const label = "frame " + n.toString();
  if (n == 0) {
    return leaf(kind, xs, label);
  }
  return deep(n - 1, kind) + xs[1] - xs[1] + label.length.toInt() - label.length.toInt();
}

function leaf(kind: int, xs: int[], label: string): int {
  if (kind == 0) {
    return xs[xs.length + 5];
  }
  if (kind == 1) {
    const none: Option<int> = None;
    return none.unwrap();
  }
  if (kind == 2) {
    let v = 9223372036854775807;
    v = v + xs[2];
    return v;
  }
  if (kind == 3) {
    return xs.slice(2, xs.length + 7).length.toInt();
  }
  return label.substring(3, label.length + 9).length.toInt();
}

function main(): void {
  console.log("start");
  const done = channel<int>(1000);
  scopeDo(s => {
    let d = 0;
    while (d < 100) {
      const id = d;
      spawnDo(s, () => {
        scopeDo(w => {
          let i = 0;
          while (i < 100) {
            const k = id * 100 + i;
            spawnDo(w, () => {
              done.tx.send(k);
              deep(60 + (k % 7) * 10, k % 5);
            });
            i += 1;
          }
        });
      });
      let got = 0;
      while (got < 100) {
        done.rx.recv();
        got += 1;
      }
      d += 1;
    }
    console.log("10000 tasks announced their trap");
  });
  console.log("unreachable");
}
