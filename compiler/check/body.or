// Function body checking: statements, places, expressions, calls and match.
// Port of `FnCx` (bootstrap/src/checker/mod.rs). All of these functions are mutually recursive
// (match arms contain blocks, blocks contain expressions), so they live in one file; the
// non-recursive parts are in env.or, fnctx.or, builtins.or and pattern.or.
//
// Every function takes the read-only `Env` and the function context `FnCtx` and returns the
// updated context together with its result. Errors abort the whole function body.

import { Span, Diagnostic, diag } from "../diag";
import {
  Ident, Block, Stmt, StmtKind, Expr, ExprKind, FieldInit, MatchArm, ArmBody, TypeExpr, TNamed, TFn, AssignOp,
  UnaryOp, BinaryOp, Pattern, TypeDecl, DRecord, DUnion, FieldDecl, FunctionDecl, Param, ArrowParam, ArrowBody,
  ContractClause
} from "../syntax";
import {
  Type, Function, Local, FieldDef, RecordDef, VariantDef, HBlock, HStmt, Place, PlaceElem, HExpr, HExprKind, UnOp, BinOp, FieldInitH, HArm,
  HPattern, Builtin, MutBuiltin
} from "../hir";
import {
  Env, ValEnt, Inst, FuncInfo, ConstLit, LitFloat, mapOrigin, mapGenType, isMapKeyType, EntRecord, EntUnion, EntAlias, EntGen, EntIface, typeEq, isInt, isUsize, isBool, isString, isVoid,
  isIntish, isFloatTy, isNumeric, isArrayTy, isFn, isIface, expIsUsize, showType, mismatch, globalVal, findType, findVal, originOf, typesEq,
  boundOf, ifaceMethodIndex
} from "./env";
import { checkBounds, internVtable, recordImplements } from "./ifaces";
import { classOfRec, findMethod, fieldIsPrivate } from "./classes";
import {
  FnCtx, newLocal, declare, declaredInScope, pushScope, popScope, lookupLocal, pushLoop, popLoop, markBreak,
  newClosureCtx, lookupVar, isVisibleVar, isCapturedLocal
} from "./fnctx";
import { builtinSig, methodSig, Sig, MSig } from "./builtins";
import { checkPattern, PatOut } from "./pattern";
import {
  TScope, resolveType, aliasType, instType, instFunc, unify, noBinds, mentionsUnbound, indexOfName, scopeOf
} from "./types";

export type ExprOut = { fx: FnCtx; expr: HExpr; };
export type BlockOut = { fx: FnCtx; block: HBlock; div: bool; };
type ArgsOut = { fx: FnCtx; args: HExpr[]; };
type PairOut = { fx: FnCtx; l: HExpr; r: HExpr; };
type PlaceOut = { fx: FnCtx; place: Place; mutable: bool; rootName: string; };
type StmtOut = { fx: FnCtx; stmt: HStmt; div: bool; };
type MatchOut = { fx: FnCtx; expr: HExpr; div: bool; };
type LetInit = { fx: FnCtx; expr: HExpr; ty: Type; };
type ElseOut = { fx: FnCtx; block: Option<HBlock>; div: bool; };
type TyFx = { fx: FnCtx; ty: Type; };
type InferOut = { fx: FnCtx; tys: Type[]; args: HExpr[]; };

function mk(kind: HExprKind, ty: Type, span: Span): HExpr {
  return HExpr { kind: kind, ty: ty, span: span };
}

function done(fx: FnCtx, kind: HExprKind, ty: Type, span: Span): Result<ExprOut, Diagnostic> {
  return Ok(ExprOut { fx: fx, expr: mk(kind, ty, span) });
}

function noExprs(): HExpr[] {
  const xs: HExpr[] = [];
  return xs;
}

// ---------------------------------------------------------------------------
// Syntactic helpers
// ---------------------------------------------------------------------------

function isArithOp(op: BinaryOp): bool {
  return match (op) {
    BAdd => true,
    BSub => true,
    BMul => true,
    BDiv => true,
    BRem => true,
    _ => false
  };
}

// Syntactic "untyped numeric literal expression": adopts the type demanded by context (an integer
// literal an int type, a float literal a float type; there is no conversion between the two, ADR-0018).
function untypedInt(e: Expr): bool {
  return match (e.kind) {
    EInt(_) => true,
    EFloat(_) => true,
    EUnary(op, x) => match (op) { UNeg => untypedInt(x), _ => false },
    EBinary(op, l, r) => isArithOp(op) && untypedInt(l) && untypedInt(r),
    _ => false
  };
}

function toBinOp(op: BinaryOp): BinOp {
  return match (op) {
    BAdd => OpAdd,
    BSub => OpSub,
    BMul => OpMul,
    BDiv => OpDiv,
    BRem => OpRem,
    BEq => OpEq,
    BNe => OpNe,
    BLt => OpLt,
    BLe => OpLe,
    BGt => OpGt,
    BGe => OpGe,
    BAnd => OpAnd,
    BOr => OpOr,
    BImplies => OpOr
  };
}

function intishHint(exp: Option<Type>): Option<Type> {
  return match (exp) {
    Some(t) => isNumeric(t) ? Some(t) : None,
    None => None
  };
}

function hintOf(t: Type): Option<Type> {
  return isNumeric(t) ? Some(t) : None;
}

// Expected type of a float literal: `f32` when the context says so, else `float`.
function expIsF32(exp: Option<Type>): bool {
  return match (exp) {
    Some(t) => match (t) { TyF32 => true, _ => false },
    None => false
  };
}

function fieldIndex(fields: FieldDef[], name: string): Option<usize> {
  let i: usize = 0;
  for (const f of fields) {
    if (f.name == name) {
      return Some(i);
    }
    i += 1;
  }
  return None;
}

function noField(env: Env, name: Ident, t: Type): Diagnostic {
  return diag("E0405", name.span, "no field `" + name.name + "` on type `" + showType(env, t) + "`");
}

// ---------------------------------------------------------------------------
// Expressions
// ---------------------------------------------------------------------------

function expect(env: Env, fx: FnCtx, e: Expr, ty: Type): Result<ExprOut, Diagnostic> {
  const r = checkExpr(env, fx, e, Some(ty))?;
  if (!typeEq(r.expr.ty, ty)) {
    return coerce(r, e.span, ty);
  }
  return Ok(r);
}

// The one implicit conversion of the language (ADR-0019): a value of a class type converts to an
// interface type the class declares with `implements`. Anything else is a type mismatch.
function coerce(r: ExprOut, span: Span, ty: Type): Result<ExprOut, Diagnostic> {
  return match (ty) {
    TyIface(i) => toIface(r, span, i),
    _ => Err(mismatch(r.fx.env, span, ty, r.expr.ty))
  };
}

function toIface(r: ExprOut, span: Span, i: usize): Result<ExprOut, Diagnostic> {
  const env = r.fx.env;
  match (r.expr.ty) {
    TyRecord(rec) => {
      const co = classOfRec(env, rec);
      if (co.isSome()) {
        if (!recordImplements(env, rec, i)) {
          return Err(diag(
            "E0417",
            span,
            "class `" + env.classes[co.unwrap()].name + "` does not implement interface `" + env.ifaces[i].name
              + "`; declare `class " + env.classes[co.unwrap()].name + " implements " + env.ifaces[i].decl.name.name
              + "` (conformance is nominal)"
          ));
        }
        const vo = internVtable(env, co.unwrap(), i);
        return done(withEnv(r.fx, vo.env), XIface(vo.id, r.expr), TyIface(i), span);
      }
      if (recordImplements(env, rec, i)) {
        // the opaque type of a bounded type parameter (abstract check; the HIR is discarded)
        return done(r.fx, XIface(0, r.expr), TyIface(i), span);
      }
    },
    _ => {}
  }
  return Err(mismatch(env, span, TyIface(i), r.expr.ty));
}

// `s.m(args)` on an interface value, or on a value of a type parameter bounded by the interface
// (abstract check): a call through the vtable (ADR-0019).
function ifaceCall(
  env: Env, b: ExprOut, span: Span, i: usize, name: Ident, args: Expr[]
): Result<ExprOut, Diagnostic> {
  const info = b.fx.env.ifaces[i];
  const so = ifaceMethodIndex(info, name.name);
  if (so.isNone()) {
    return Err(diag("E0405", name.span, "no method `" + name.name + "` on interface `" + info.name + "`"));
  }
  const slot = so.unwrap();
  const m = info.methods[slot];
  const a = argsExpect(env, b.fx, span, "method `" + name.name + "`", args, m.params)?;
  return done(a.fx, XCallVirtual(b.expr, slot, a.args), m.ret, span);
}

export function checkExpr(env: Env, fx: FnCtx, e: Expr, exp: Option<Type>): Result<ExprOut, Diagnostic> {
  const span = e.span;
  return match (e.kind) {
    EInt(n) => done(fx, XInt(n), expIsUsize(exp) ? TyUsize : TyInt, span),
    EFloat(t) => done(fx, XFloat(t), expIsF32(exp) ? TyF32 : TyFloat, span),
    EStr(s) => done(fx, XStr(s), TyString, span),
    EBool(b) => done(fx, XBool(b), TyBool, span),
    EIdent(id) => checkIdent(env, fx, id, exp, span),
    EUnary(op, x) => checkUnary(env, fx, span, op, x, exp),
    EBinary(op, l, r) => checkBinary(env, fx, span, op, l, r, exp),
    ECall(callee, args) => checkCall(env, fx, span, callee, args, exp),
    EMember(base, name) => checkMember(env, fx, span, base, name),
    EIndex(base, idx) => checkIndex(env, fx, span, base, idx),
    ETry(x) => fx.cmode > 0 ? Err(diag("E0415", span, "`?` is not allowed in a contract expression")) : checkTry(env, fx, span, x),
    ECond(c, t, f) => checkCond(env, fx, span, c, t, f, exp),
    EArray(elems) => checkArray(env, fx, span, elems, exp),
    ERecord(name, spread, fields) => checkRecord(env, fx, span, name, None, spread, fields, exp),
    ERecordT(name, targs, spread, fields) => checkRecord(env, fx, span, name, Some(targs), spread, fields, exp),
    ETyApp(_, _) => Err(diag("E0400", span, "type arguments are only allowed on a call or a record literal")),
    EMatch(s, arms) => checkMatchExpr(env, fx, span, s, arms, exp),
    ENew(name, targs, args) => checkNew(env, fx, span, name, targs, args, exp),
    EThis => checkThis(fx, span),
    EArrow(ps, rte, body) => fx.cmode > 0
      ? Err(diag("E0416", span, "closures are not allowed in a contract expression"))
      : checkArrowExp(env, fx, span, ps, rte, body, exp)
  };
}

function checkArrowExp(
  env: Env, fx: FnCtx, span: Span, ps: ArrowParam[], rte: Option<TypeExpr>, body: ArrowBody, exp: Option<Type>
): Result<ExprOut, Diagnostic> {
  const noP: Option<Type[]> = None;
  const noR: Option<Type> = None;
  return match (exp) {
    Some(t) => match (t) {
      TyFn(eps, er) => checkArrow(env, fx, span, ps, rte, body, Some(eps), Some(er)),
      _ => checkArrow(env, fx, span, ps, rte, body, noP, noR)
    },
    None => checkArrow(env, fx, span, ps, rte, body, noP, noR)
  };
}

function checkMatchExpr(
  env: Env, fx: FnCtx, span: Span, scrut: Expr, arms: MatchArm[], exp: Option<Type>
): Result<ExprOut, Diagnostic> {
  const r = checkMatch(env, fx, span, scrut, arms, exp, false)?;
  return Ok(ExprOut { fx: r.fx, expr: r.expr });
}

function constKind(lit: ConstLit): HExprKind {
  return match (lit) {
    LitInt(n) => XInt(n),
    LitStr(s) => XStr(s),
    LitBool(b) => XBool(b),
    LitFloat(t) => XFloat(t)
  };
}

function checkIdent(env: Env, fx: FnCtx, id: Ident, exp: Option<Type>, span: Span): Result<ExprOut, Diagnostic> {
  const lv = lookupVar(fx, id.name);
  if (lv.id.isSome()) {
    const l = lv.id.unwrap();
    return done(lv.fx, XLocal(l), lv.fx.locals[l].ty, span);
  }
  const g = globalVal(env, fx.unit, id.name);
  if (g.isSome()) {
    return identVal(env, fx, g.unwrap(), id, span, exp);
  }
  if (id.name == "None") {
    return noneLit(env, fx, exp, span);
  }
  if (id.name == "Some" || id.name == "Ok" || id.name == "Err") {
    return Err(diag("E0404", span, "`" + id.name + "` must be called with arguments"));
  }
  return Err(unresolved(fx, id));
}

// E0300 for an unknown name; inside `const f = (..) => ..` the name `f` itself gets a hint.
function unresolved(fx: FnCtx, id: Ident): Diagnostic {
  if (fx.selfName != "" && id.name == fx.selfName) {
    return diag(
      "E0300",
      id.span,
      "a closure cannot refer to itself (`" + id.name + "` is not defined inside its own initialiser); use a top-level function for recursion"
    );
  }
  return diag("E0300", id.span, "unresolved name `" + id.name + "`");
}

// The parameter / result types of an expected function type, if `exp` is one.
function expFn(exp: Option<Type>): Option<Type> {
  return match (exp) {
    Some(t) => isFn(t) ? Some(t) : None,
    None => None
  };
}

function funcValueOf(env: Env, fx: FnCtx, ent: ValEnt, id: Ident, span: Span, exp: Option<Type>): Result<ExprOut, Diagnostic> {
  const noP: Option<Type[]> = None;
  const noR: Option<Type> = None;
  return match (expFn(exp)) {
    Some(t) => match (t) {
      TyFn(eps, er) => funcValue(env, fx, span, ent, id, Some(eps), Some(er)),
      _ => funcValue(env, fx, span, ent, id, noP, noR)
    },
    None => funcValue(env, fx, span, ent, id, noP, noR)
  };
}

function identVal(env: Env, fx: FnCtx, ent: ValEnt, id: Ident, span: Span, exp: Option<Type>): Result<ExprOut, Diagnostic> {
  return match (ent) {
    VConst(i) => done(fx, constKind(env.consts[i].lit), env.consts[i].ty, span),
    VVariant(u, tag) => {
      const def = fx.env.unions[u].variants[tag];
      if (def.payload.length > 0) {
        return Err(diag(
          "E0404",
          span,
          "variant `" + def.name + "` expects " + def.payload.length.toString() + " argument(s)"
        ));
      }
      return done(fx, XVariant(tag, noExprs()), TyUnion(u), span);
    },
    VGVariant(g, tag) => genericVariant(env, fx, span, g, tag, None, [], exp),
    VGFunc(_) => funcValueOf(env, fx, ent, id, span, exp),
    VFunc(_) => funcValueOf(env, fx, ent, id, span, exp),
    VStd(_) => Err(diag("E0400", span, "function `" + id.name + "` cannot be used as a value"))
  };
}

function noneLit(env: Env, fx: FnCtx, exp: Option<Type>, span: Span): Result<ExprOut, Diagnostic> {
  return match (exp) {
    Some(t) => match (t) {
      TyOption(inner) => done(fx, XVariant(1, noExprs()), TyOption(inner), span),
      _ => Err(diag("E0400", span, "expected `" + showType(fx.env, t) + "`, found an `Option`"))
    },
    None => Err(diag("E0407", span, "cannot infer the type of `None`; add a type annotation"))
  };
}

function checkUnary(
  env: Env, fx: FnCtx, span: Span, op: UnaryOp, inner: Expr, exp: Option<Type>
): Result<ExprOut, Diagnostic> {
  return match (op) {
    UNeg => checkNeg(env, fx, span, inner, exp),
    UNot => {
      const o = checkExpr(env, fx, inner, None)?;
      if (!isBool(o.expr.ty)) {
        return Err(diag("E0410", span, "`!` requires `bool`, found `" + showType(o.fx.env, o.expr.ty) + "`"));
      }
      return done(o.fx, XUnary(UnNot, o.expr), TyBool, span);
    }
  };
}

function intLitValue(e: Expr): Option<int> {
  return match (e.kind) {
    EInt(n) => Some(n),
    _ => None
  };
}

function isFloatHint(exp: Option<Type>): bool {
  return match (exp) {
    Some(t) => isFloatTy(t),
    None => false
  };
}

function checkNeg(env: Env, fx: FnCtx, span: Span, inner: Expr, exp: Option<Type>): Result<ExprOut, Diagnostic> {
  const lit = intLitValue(inner);
  if (lit.isSome()) {
    if (expIsUsize(exp)) {
      return Err(diag("E0400", span, "negative integer literal cannot have type `usize`"));
    }
    return done(fx, XInt(-lit.unwrap()), TyInt, span);
  }
  match (inner.kind) {
    EFloat(t) => {
      return done(fx, XFloat("-" + t), expIsF32(exp) ? TyF32 : TyFloat, span);
    },
    _ => {}
  }
  const o = checkExpr(env, fx, inner, (untypedInt(inner) && isFloatHint(exp)) ? exp : None)?;
  if (!isInt(o.expr.ty) && !isFloatTy(o.expr.ty)) {
    return Err(diag("E0410", span, "cannot negate a value of type `" + showType(o.fx.env, o.expr.ty) + "`"));
  }
  return done(o.fx, XUnary(UnNeg, o.expr), o.expr.ty, span);
}

function checkOperands(
  env: Env, fx: FnCtx, lhs: Expr, rhs: Expr, hint: Option<Type>
): Result<PairOut, Diagnostic> {
  if (untypedInt(lhs) && !untypedInt(rhs)) {
    const r = checkExpr(env, fx, rhs, hint)?;
    const l = checkExpr(env, r.fx, lhs, hintOf(r.expr.ty))?;
    return Ok(PairOut { fx: l.fx, l: l.expr, r: r.expr });
  }
  const l = checkExpr(env, fx, lhs, hint)?;
  const h: Option<Type> = untypedInt(rhs) ? hintOf(l.expr.ty) : None;
  const r = checkExpr(env, l.fx, rhs, h)?;
  return Ok(PairOut { fx: r.fx, l: l.expr, r: r.expr });
}

function checkBinary(
  env: Env, fx: FnCtx, span: Span, op: BinaryOp, lhs: Expr, rhs: Expr, exp: Option<Type>
): Result<ExprOut, Diagnostic> {
  const hop = toBinOp(op);
  const isImpl = match (op) { BImplies => true, _ => false };
  if (isImpl) {
    // `a ==> b` (ADR-0012) is `!a || b` (short-circuit); only valid inside contract expressions.
    if (fx.cmode == 0) {
      return Err(diag("E0415", span, "`==>` is only allowed inside contract expressions (@Requires, @Ensures, @Invariant, @Decreases)"));
    }
    const l = checkExpr(env, fx, lhs, None)?;
    const r = checkExpr(env, l.fx, rhs, None)?;
    if (!isBool(l.expr.ty) || !isBool(r.expr.ty)) {
      return Err(diag(
        "E0410",
        span,
        "`==>` requires `bool` operands, found `" + showType(r.fx.env, l.expr.ty) + "` and `"
          + showType(r.fx.env, r.expr.ty) + "`"
      ));
    }
    return done(r.fx, XBinary(OpOr, mk(XUnary(UnNot, l.expr), TyBool, lhs.span), r.expr), TyBool, span);
  }
  const isLogic = match (op) { BAnd => true, BOr => true, _ => false };
  if (isLogic) {
    const l = checkExpr(env, fx, lhs, None)?;
    const r = checkExpr(env, l.fx, rhs, None)?;
    if (r.fx.pre.length > l.fx.pre.length) {
      return Err(condHoistErr(rhs.span));
    }
    if (!isBool(l.expr.ty) || !isBool(r.expr.ty)) {
      return Err(diag(
        "E0410",
        span,
        "`&&`/`||` require `bool` operands, found `" + showType(r.fx.env, l.expr.ty) + "` and `"
          + showType(r.fx.env, r.expr.ty) + "`"
      ));
    }
    return done(r.fx, XBinary(hop, l.expr, r.expr), TyBool, span);
  }
  const arith = isArithOp(op);
  const hint: Option<Type> = arith ? intishHint(exp) : None;
  const p = checkOperands(env, fx, lhs, rhs, hint)?;
  const lt = p.l.ty;
  const rt = p.r.ty;
  if (!typeEq(lt, rt) && isNumeric(lt) && isNumeric(rt)) {
    return Err(diag(
      "E0400",
      span,
      "cannot mix `" + showType(p.fx.env, lt) + "` and `" + showType(p.fx.env, rt) + "`; convert explicitly"
    ));
  }
  if (!typeEq(lt, rt)) {
    return Err(diag(
      "E0410",
      span,
      "operands have different types `" + showType(p.fx.env, lt) + "` and `" + showType(p.fx.env, rt) + "`"
    ));
  }
  const ok = match (op) {
    BAdd => isIntish(lt) || isFloatTy(lt) || isString(lt),
    BSub => isIntish(lt) || isFloatTy(lt),
    BMul => isIntish(lt) || isFloatTy(lt),
    BDiv => isIntish(lt) || isFloatTy(lt),
    BRem => isIntish(lt),
    BEq => isIntish(lt) || isFloatTy(lt) || isBool(lt) || isString(lt),
    BNe => isIntish(lt) || isFloatTy(lt) || isBool(lt) || isString(lt),
    _ => isIntish(lt) || isFloatTy(lt)
  };
  if (!ok) {
    if (isFn(lt)) {
      return Err(diag("E0410", span, "function values cannot be compared (type `" + showType(p.fx.env, lt) + "`)"));
    }
    return Err(diag("E0410", span, "operator is not defined for type `" + showType(p.fx.env, lt) + "`"));
  }
  return done(p.fx, XBinary(hop, p.l, p.r), arith ? lt : TyBool, span);
}

// `t` is a Map instance and the code being checked is not the Map prelude itself (which owns the fields).
function outsideMapPrelude(fx: FnCtx, t: Type): bool {
  return fx.unit.toInt() != fx.env.mapUnit && mapOrigin(fx.env, t).isSome();
}

function checkMember(env: Env, fx: FnCtx, span: Span, base: Expr, name: Ident): Result<ExprOut, Diagnostic> {
  const b = checkExpr(env, fx, base, None)?;
  const t = b.expr.ty;
  if (name.name == "length") {
    if (isString(t)) {
      return done(b.fx, XBuiltin(BStrLength, [b.expr]), TyUsize, span);
    }
    if (isArrayTy(t)) {
      return done(b.fx, XBuiltin(BArrLength, [b.expr]), TyUsize, span);
    }
  }
  return match (t) {
    TyRecord(r) => {
      const def = b.fx.env.records[r];
      const io = fieldIndex(def.fields, name.name);
      if (io.isNone() || (name.name != "size" && outsideMapPrelude(b.fx, t))) {
        return Err(diag("E0405", name.span, "no field `" + name.name + "` on type `" + showType(b.fx.env, t) + "`"));
      }
      const i = io.unwrap();
      checkFieldAccess(b.fx, r, name)?;
      return done(b.fx, XField(b.expr, r, i), def.fields[i].ty, span);
    },
    _ => Err(noField(fx.env, name, t))
  };
}

function checkIndex(env: Env, fx: FnCtx, span: Span, base: Expr, index: Expr): Result<ExprOut, Diagnostic> {
  const b = checkExpr(env, fx, base, None)?;
  return match (b.expr.ty) {
    TyArray(t) => {
      const i = expect(env, b.fx, index, TyUsize)?;
      return done(i.fx, XIndex(b.expr, i.expr), t, span);
    },
    _ => Err(diag("E0400", span, "cannot index into type `" + showType(b.fx.env, b.expr.ty) + "`"))
  };
}

function checkTry(env: Env, fx: FnCtx, span: Span, inner: Expr): Result<ExprOut, Diagnostic> {
  const o = checkExpr(env, fx, inner, None)?;
  return match (o.expr.ty) {
    TyResult(t, et) => {
      match (fx.ret) {
        TyResult(_, e2) => {
          if (!typeEq(e2, et)) {
            return Err(diag(
              "E0406",
              span,
              "error type `" + showType(o.fx.env, et) + "` does not match the function's error type `"
                + showType(o.fx.env, e2) + "`"
            ));
          }
        },
        _ => {
          return Err(diag(
            "E0406",
            span,
            "`?` used in a function returning `" + showType(fx.env, fx.ret) + "`, not a `Result`"
          ));
        }
      }
      return done(o.fx, XTry(o.expr), t, span);
    },
    _ => Err(diag("E0406", span, "`?` requires a `Result`, found `" + showType(o.fx.env, o.expr.ty) + "`"))
  };
}

function checkCond(
  env: Env, fx: FnCtx, span: Span, cond: Expr, thenE: Expr, elsE: Expr, exp: Option<Type>
): Result<ExprOut, Diagnostic> {
  const c = expect(env, fx, cond, TyBool)?;
  let cur = c.fx;
  let t: HExpr = mk(XBool(false), TyBool, span);
  let f: HExpr = mk(XBool(false), TyBool, span);
  const npre = cur.pre.length;
  // An interface-typed context converts each branch (ADR-0019).
  match (exp) {
    Some(et) => {
      if (isIface(et)) {
        const tr = expect(env, cur, thenE, et)?;
        const fr = expect(env, tr.fx, elsE, et)?;
        if (fr.fx.pre.length > npre) {
          return Err(condHoistErr(span));
        }
        return done(fr.fx, XCond(c.expr, tr.expr, fr.expr), et, span);
      }
    },
    None => {}
  }
  if (untypedInt(thenE) && !untypedInt(elsE)) {
    const fr = checkExpr(env, cur, elsE, exp)?;
    const tr = checkExpr(env, fr.fx, thenE, hintOf(fr.expr.ty))?;
    cur = tr.fx;
    t = tr.expr;
    f = fr.expr;
  } else {
    const tr = checkExpr(env, cur, thenE, exp)?;
    const h = untypedInt(elsE) && isIntish(tr.expr.ty) ? Some(tr.expr.ty) : exp;
    const fr = checkExpr(env, tr.fx, elsE, h)?;
    cur = fr.fx;
    t = tr.expr;
    f = fr.expr;
  }
  if (cur.pre.length > npre) {
    return Err(condHoistErr(span));
  }
  if (!typeEq(t.ty, f.ty)) {
    return Err(diag(
      "E0400",
      elsE.span,
      "branches of conditional have different types `" + showType(fx.env, t.ty) + "` and `"
        + showType(fx.env, f.ty) + "`"
    ));
  }
  return done(cur, XCond(c.expr, t, f), t.ty, span);
}

function checkArray(
  env: Env, fx: FnCtx, span: Span, elems: Expr[], exp: Option<Type>
): Result<ExprOut, Diagnostic> {
  let cur = fx;
  let pre: Option<HExpr>[] = [];
  for (const _e of elems) {
    pre.push(None);
  }
  let elemTy: Type = TyInt;
  let fromExp = false;
  match (exp) {
    Some(t) => {
      match (t) {
        TyArray(et) => {
          elemTy = et;
          fromExp = true;
        },
        _ => {}
      }
    },
    None => {}
  }
  if (!fromExp) {
    if (elems.length == 0) {
      return Err(diag("E0407", span, "cannot infer the element type of `[]`; add a type annotation"));
    }
    let k: usize = 0;
    let found = false;
    while (k < elems.length && !found) {
      if (!untypedInt(elems[k])) {
        found = true;
      } else {
        k += 1;
      }
    }
    if (found) {
      const he = checkExpr(env, cur, elems[k], None)?;
      cur = he.fx;
      elemTy = he.expr.ty;
      pre[k] = Some(he.expr);
    } else {
      // only untyped literals: the first one decides (`int`, or `float` for a float literal)
      const he = checkExpr(env, cur, elems[0], None)?;
      cur = he.fx;
      elemTy = he.expr.ty;
      pre[0] = Some(he.expr);
    }
  }
  if (isVoid(elemTy)) {
    return Err(diag("E0400", span, "array elements cannot be `void`"));
  }
  let out: HExpr[] = [];
  let i: usize = 0;
  for (const e of elems) {
    match (pre[i]) {
      Some(he) => { out.push(he); },
      None => {
        const r = expect(env, cur, e, elemTy)?;
        cur = r.fx;
        out.push(r.expr);
      }
    }
    i += 1;
  }
  return done(cur, XArray(out), TyArray(elemTy), span);
}

function resolveFx(fx: FnCtx, te: TypeExpr, voidOk: bool): Result<TyFx, Diagnostic> {
  const sc = TScope { unit: fx.unit, names: fx.tpNames, tys: fx.tpTys, depth: 0 };
  const r = resolveType(fx.env, sc, te, voidOk)?;
  return Ok(TyFx { fx: withEnv(fx, r.env), ty: r.ty });
}

// `fx` with its environment replaced by `e` (instances only ever grow the tables).
function withEnv(fx: FnCtx, e: Env): FnCtx {
  if (e.insts.length == fx.env.insts.length && e.funcs.length == fx.env.funcs.length
    && e.records.length == fx.env.records.length && e.vtables.length == fx.env.vtables.length) {
    return fx;
  }
  let f = fx;
  f.env = e;
  return f;
}

// `Name<P1, ..., Pn>` for a generic declaration: the "return type" of its constructors.
function selfTypeExpr(d: TypeDecl): TypeExpr {
  let args: TypeExpr[] = [];
  for (const p of d.typeParams) {
    args.push(TypeExpr { kind: TNamed(p, []), span: p.span });
  }
  return TypeExpr { kind: TNamed(d.name, args), span: d.name.span };
}

function paramNameList(ps: Ident[]): string[] {
  let out: string[] = [];
  for (const p of ps) {
    out.push(p.name);
  }
  return out;
}

function checkRecord(
  env: Env, fx: FnCtx, span: Span, name: Ident, targs: Option<TypeExpr[]>, spread: Option<Expr>,
  fields: FieldInit[], exp: Option<Type>
): Result<ExprOut, Diagnostic> {
  if (indexOfName(fx.tpNames, name.name).isSome()) {
    return Err(diag("E0400", name.span, "`" + name.name + "` is a type parameter, not a record type"));
  }
  const found = findType(env.units[fx.unit].scope, name.name);
  if (found.isNone()) {
    return Err(diag("E0300", name.span, "unknown type `" + name.name + "`"));
  }
  let cur = fx;
  let t: Type = TyVoid;
  match (found.unwrap()) {
    EntGen(g) => {
      return checkGenericRecord(env, fx, span, g, name, targs, spread, fields, exp);
    },
    EntRecord(r) => { t = TyRecord(r); },
    EntUnion(u) => { t = TyUnion(u); },
    EntAlias(i) => {
      const none: int[] = [];
      const r = aliasType(cur.env, i, none)?;
      cur = withEnv(cur, r.env);
      t = r.ty;
    },
    EntIface(_) => {
      return Err(diag("E0400", name.span, "`" + name.name + "` is an interface, not a record type"));
    }
  }
  if (targs.isSome()) {
    return Err(diag("E0400", name.span, "type `" + name.name + "` is not generic"));
  }
  const rid = match (t) {
    TyRecord(r) => r,
    _ => {
      return Err(diag(
        "E0400",
        name.span,
        "`" + name.name + "` is not a record type (it is `" + showType(cur.env, t) + "`)"
      ));
    }
  };
  const co = classOfRec(cur.env, rid);
  if (co.isSome() && !inClass(cur, co.unwrap())) {
    return Err(diag(
      "E0408",
      name.span,
      "class `" + name.name + "` cannot be built with a record literal outside its own body; use `new " + name.name + "(..)`"
    ));
  }
  return checkRecordOf(env, cur, span, rid, spread, fields);
}

function fieldDeclIndex(fields: FieldDecl[], name: string): Option<usize> {
  let i: usize = 0;
  for (const f of fields) {
    if (f.name.name == name) {
      return Some(i);
    }
    i += 1;
  }
  return None;
}

// Record literal of a generic record type: the instance comes from the spread, the explicit type
// arguments, the expected type or the field values (in that order of authority).
function checkGenericRecord(
  env: Env, fx: FnCtx, span: Span, g: usize, name: Ident, targs: Option<TypeExpr[]>, spread: Option<Expr>,
  fields: FieldInit[], exp: Option<Type>
): Result<ExprOut, Diagnostic> {
  const gt = env.gtypes[g];
  const fdecls = match (gt.decl.body) {
    DRecord(fs) => fs,
    _ => {
      return Err(diag("E0400", name.span, "`" + name.name + "` is not a record type"));
    }
  };
  match (spread) {
    Some(se) => {
      const s = checkExpr(env, fx, se, None)?;
      const o = originOf(s.fx.env, s.expr.ty);
      let ok = false;
      let rid: usize = 0;
      match (o) {
        Some(inst) => {
          if (inst.kind == 0 && inst.gid == g) {
            ok = true;
            rid = inst.id;
          }
        },
        None => {}
      }
      if (!ok) {
        return Err(diag(
          "E0400", se.span,
          "spread of `" + name.name + "` literal must be an instance of `" + name.name + "`, found `"
            + showType(s.fx.env, s.expr.ty) + "`"
        ));
      }
      return checkRecordOf(env, s.fx, span, rid, spread, fields);
    },
    None => {}
  }
  let idxs: usize[] = [];
  let seen: bool[] = [];
  for (const _f of fdecls) {
    seen.push(false);
  }
  let ptes: TypeExpr[] = [];
  let vals: Expr[] = [];
  for (const f of fields) {
    const io = fieldDeclIndex(fdecls, f.name.name);
    if (io.isNone()) {
      return Err(diag("E0411", f.name.span, "record `" + name.name + "` has no field `" + f.name.name + "`"));
    }
    const idx = io.unwrap();
    if (seen[idx]) {
      return Err(diag("E0411", f.name.span, "field `" + f.name.name + "` given more than once"));
    }
    seen[idx] = true;
    idxs.push(idx);
    ptes.push(fdecls[idx].ty);
    vals.push(f.value);
  }
  let missing: string[] = [];
  let k: usize = 0;
  for (const fd of fdecls) {
    if (!seen[k]) {
      missing.push(fd.name.name);
    }
    k += 1;
  }
  if (missing.length > 0) {
    return Err(diag("E0411", span, "missing field(s) in record literal: " + missing.join(", ")));
  }
  const io = infer(
    env, fx, span, "record `" + name.name + "`", gt.unit, gt.decl.typeParams, ptes,
    Some(selfTypeExpr(gt.decl)), vals, exp, targs
  )?;
  const inst = instType(io.fx.env, g, io.tys, 0, span)?;
  const f2 = withEnv(io.fx, inst.env);
  const rid = match (inst.ty) {
    TyRecord(r) => r,
    _ => 0
  };
  let out: FieldInitH[] = [];
  let i: usize = 0;
  while (i < idxs.length) {
    out.push(FieldInitH { index: idxs[i], value: io.args[i] });
    i += 1;
  }
  return done(f2, XRecord(rid, None, out), TyRecord(rid), span);
}

function checkRecordOf(
  env: Env, fx: FnCtx, span: Span, rid: usize, spread: Option<Expr>, fields: FieldInit[]
): Result<ExprOut, Diagnostic> {
  const def = fx.env.records[rid];
  let cur = fx;
  let sp: Option<HExpr> = None;
  match (spread) {
    Some(s) => {
      const r = expect(env, cur, s, TyRecord(rid))?;
      cur = r.fx;
      sp = Some(r.expr);
    },
    None => {}
  }
  let seen: bool[] = [];
  for (const _f of def.fields) {
    seen.push(false);
  }
  let out: FieldInitH[] = [];
  for (const f of fields) {
    const io = fieldIndex(def.fields, f.name.name);
    if (io.isNone()) {
      return Err(diag("E0411", f.name.span, "record `" + def.name + "` has no field `" + f.name.name + "`"));
    }
    const idx = io.unwrap();
    if (seen[idx]) {
      return Err(diag("E0411", f.name.span, "field `" + f.name.name + "` given more than once"));
    }
    seen[idx] = true;
    const v = expect(env, cur, f.value, def.fields[idx].ty)?;
    cur = v.fx;
    out.push(FieldInitH { index: idx, value: v.expr });
  }
  if (sp.isNone()) {
    let missing: string[] = [];
    let i: usize = 0;
    for (const fd of def.fields) {
      if (!seen[i]) {
        missing.push(fd.name);
      }
      i += 1;
    }
    if (missing.length > 0) {
      return Err(diag("E0411", span, "missing field(s) in record literal: " + missing.join(", ")));
    }
  }
  return done(cur, XRecord(rid, sp, out), TyRecord(rid), span);
}

// ---------------------------------------------------------------------------
// Calls
// ---------------------------------------------------------------------------

function argsExpect(
  env: Env, fx: FnCtx, span: Span, what: string, args: Expr[], params: Type[]
): Result<ArgsOut, Diagnostic> {
  if (args.length != params.length) {
    return Err(diag(
      "E0404",
      span,
      what + " expects " + params.length.toString() + " argument(s), found " + args.length.toString()
    ));
  }
  let cur = fx;
  let out: HExpr[] = [];
  let i: usize = 0;
  for (const a of args) {
    const r = expect(env, cur, a, params[i])?;
    cur = r.fx;
    out.push(r.expr);
    i += 1;
  }
  return Ok(ArgsOut { fx: cur, args: out });
}

function checkCall(
  env: Env, fx: FnCtx, span: Span, callee: Expr, args: Expr[], exp: Option<Type>
): Result<ExprOut, Diagnostic> {
  if (fx.cmode > 0) {
    match (callee.kind) {
      EIdent(id) => {
        if (id.name == "old") {
          return checkOld(env, fx, span, args);
        }
      },
      _ => {}
    }
  }
  return match (callee.kind) {
    EIdent(id) => callIdent(env, fx, span, callee, id, args, exp),
    ETyApp(id, targs) => callTyApp(env, fx, span, callee, id, targs, args, exp),
    EMember(base, name) => callMember(env, fx, span, base, name, args, exp),
    _ => callValue(env, fx, span, callee, args)
  };
}

// `old(e)` in an `@Ensures` expression (ADR-0012): the value of `e` in the pre-state. Type checking
// treats it as `e` itself (the runtime-check expansion evaluates it at entry).
function checkOld(env: Env, fx: FnCtx, span: Span, args: Expr[]): Result<ExprOut, Diagnostic> {
  if (fx.cmode != 2) {
    return Err(diag(
      "E0415",
      span,
      fx.cmode == 3 ? "`old(..)` cannot be nested" : "`old(..)` is only allowed in an @Ensures expression"
    ));
  }
  if (args.length != 1) {
    return Err(diag("E0404", span, "`old` expects 1 argument, found " + args.length.toString()));
  }
  let inner = fx;
  inner.cmode = 3;
  const r = checkExpr(env, inner, args[0], None)?;
  let out = r.fx;
  out.cmode = 2;
  return Ok(ExprOut { fx: out, expr: r.expr });
}

// Call of a function value: `f(x)` with a local `f`, `fs[i](x)`, `g(1)(2)`, `(x => x)(3)`.
function callValue(env: Env, fx: FnCtx, span: Span, callee: Expr, args: Expr[]): Result<ExprOut, Diagnostic> {
  const c = checkExpr(env, fx, callee, None)?;
  return match (c.expr.ty) {
    TyFn(ps, r) => {
      const a = argsExpect(env, c.fx, span, "function value", args, ps)?;
      return done(a.fx, XCallIndirect(c.expr, a.args), r, span);
    },
    _ => match (callee.kind) {
      EIdent(id) => Err(diag("E0400", callee.span, "`" + id.name + "` is not a function")),
      _ => Err(diag("E0400", callee.span, "expression is not callable"))
    }
  };
}

function callIdent(
  env: Env, fx: FnCtx, span: Span, callee: Expr, id: Ident, args: Expr[], exp: Option<Type>
): Result<ExprOut, Diagnostic> {
  const lv = lookupVar(fx, id.name);
  if (lv.id.isSome()) {
    return callValue(env, lv.fx, span, callee, args);
  }
  const g = globalVal(env, fx.unit, id.name);
  if (g.isNone()) {
    if (id.name == "parseInt") {
      return callBuiltin(env, fx, span, "function `parseInt`", BParseInt, args);
    }
    if (id.name == "parseFloat") {
      return callBuiltin(env, fx, span, "function `parseFloat`", BParseFloat, args);
    }
    if (id.name == "Some" || id.name == "Ok" || id.name == "Err") {
      return builtinCtor(env, fx, span, id.name, args, exp);
    }
    return Err(unresolved(fx, id));
  }
  return match (g.unwrap()) {
    VGFunc(gi) => callGeneric(env, fx, span, gi, id, None, args, exp),
    VGVariant(gi, tag) => genericVariant(env, fx, span, gi, tag, None, args, exp),
    VFunc(fid) => {
      const f = fx.env.funcs[fid];
      const a = argsExpect(env, fx, span, "function `" + id.name + "`", args, f.params)?;
      return done(a.fx, XCall(fid, a.args), f.ret, span);
    },
    VVariant(u, tag) => {
      const v = fx.env.unions[u].variants[tag];
      const a = argsExpect(env, fx, span, "variant `" + v.name + "`", args, v.payload)?;
      return done(a.fx, XVariant(tag, a.args), TyUnion(u), span);
    },
    VStd(b) => callBuiltin(env, fx, span, "function `" + id.name + "`", b, args),
    VConst(_) => Err(diag("E0400", callee.span, "`" + id.name + "` is not a function"))
  };
}


// ---------------------------------------------------------------------------
// Generic calls (beyond Orin-B, ADR-0007)
// ---------------------------------------------------------------------------

function callTyApp(
  env: Env, fx: FnCtx, span: Span, callee: Expr, id: Ident, targs: TypeExpr[], args: Expr[], exp: Option<Type>
): Result<ExprOut, Diagnostic> {
  if (isVisibleVar(fx, id.name)) {
    return Err(diag("E0400", callee.span, "`" + id.name + "` is not generic and takes no type arguments"));
  }
  const g = globalVal(env, fx.unit, id.name);
  if (g.isNone()) {
    return Err(diag("E0300", id.span, "unresolved name `" + id.name + "`"));
  }
  return match (g.unwrap()) {
    VGFunc(gi) => callGeneric(env, fx, span, gi, id, Some(targs), args, exp),
    VGVariant(gi, tag) => genericVariant(env, fx, span, gi, tag, Some(targs), args, exp),
    _ => Err(diag("E0400", callee.span, "`" + id.name + "` is not generic and takes no type arguments"))
  };
}

// Resolves a parameter / result type expression of a generic callee with its type parameters
// bound to `tys` (only mentioned parameters need to be real).
function resolveBound(fx: FnCtx, unit: usize, tp: string[], tys: Type[], te: TypeExpr, voidOk: bool): Result<TyFx, Diagnostic> {
  const sc = TScope { unit: unit, names: tp, tys: tys, depth: 0 };
  const r = resolveType(fx.env, sc, te, voidOk)?;
  return Ok(TyFx { fx: withEnv(fx, r.env), ty: r.ty });
}

function bindsOrVoid(binds: Option<Type>[]): Type[] {
  let out: Type[] = [];
  for (const b of binds) {
    out.push(b.unwrapOr(TyVoid));
  }
  return out;
}

// Infers the type arguments of a call to a generic callee (function, variant constructor or
// record literal) and checks the arguments. Order of authority: explicit type arguments; else
// the expected type; then the arguments left to right (arguments that cannot be typed alone,
// such as `[]` or `None`, and bare integer literals are deferred until the others are known).
// Returns the type arguments and the checked arguments in source order.
function infer(
  env: Env, fx0: FnCtx, span: Span, what: string, unit: usize, tps: Ident[], paramTEs: TypeExpr[],
  retTE: Option<TypeExpr>, args: Expr[], exp: Option<Type>, explicit: Option<TypeExpr[]>
): Result<InferOut, Diagnostic> {
  let pre: Option<HExpr>[] = [];
  for (const _a of args) {
    pre.push(None);
  }
  return inferPre(env, fx0, span, what, unit, tps, paramTEs, retTE, args, exp, explicit, pre);
}

// An argument that is typed on its own because its parameter type still mentions unbound type
// parameters. An arrow function whose expected parameter types are all known (but not its result,
// e.g. `xs.map(x => x + 1)`) is checked against them; its type then binds the result parameter.
function checkLoose(
  env: Env, fx: FnCtx, a: Expr, te: TypeExpr, unit: usize, tp: string[], binds: Option<Type>[]
): Result<ExprOut, Diagnostic> {
  match (te.kind) {
    TFn(pts, _) => {
      match (a.kind) {
        EArrow(ps, rte, body) => {
          if (ps.length == pts.length) {
            // Parameter types: from the expected type where its type parameters are known, else
            // from the arrow's own annotation (an unannotated parameter then needs the fallback).
            let cur = fx;
            let tys: Type[] = [];
            let ok = true;
            let i: usize = 0;
            while (i < pts.length && ok) {
              if (!mentionsUnbound(pts[i].ty, tp, binds)) {
                const r = resolveBound(cur, unit, tp, bindsOrVoid(binds), pts[i].ty, false)?;
                cur = r.fx;
                tys.push(r.ty);
              } else {
                match (ps[i].ty) {
                  Some(ate) => {
                    const r = resolveFx(cur, ate, false)?;
                    cur = r.fx;
                    tys.push(r.ty);
                  },
                  None => {
                    ok = false;
                  }
                }
              }
              i += 1;
            }
            if (ok) {
              const noR: Option<Type> = None;
              return checkArrow(env, cur, a.span, ps, rte, body, Some(tys), noR);
            }
          }
        },
        EIdent(id) => {
          let known = true;
          for (const p of pts) {
            if (mentionsUnbound(p.ty, tp, binds)) {
              known = false;
            }
          }
          if (known && !isVisibleVar(fx, id.name)) {
            const g = globalVal(env, fx.unit, id.name);
            if (g.isSome()) {
              let cur = fx;
              let tys: Type[] = [];
              for (const p of pts) {
                const r = resolveBound(cur, unit, tp, bindsOrVoid(binds), p.ty, false)?;
                cur = r.fx;
                tys.push(r.ty);
              }
              const noR: Option<Type> = None;
              match (g.unwrap()) {
                VFunc(_) => { return funcValue(env, cur, a.span, g.unwrap(), id, Some(tys), noR); },
                VGFunc(_) => { return funcValue(env, cur, a.span, g.unwrap(), id, Some(tys), noR); },
                _ => {}
              }
            }
          }
        },
        _ => {}
      }
    },
    _ => {}
  }
  return checkExpr(env, fx, a, None);
}

// `infer` where some arguments are already checked (`pre[i]`, e.g. the receiver of a method call).
function inferPre(
  env: Env, fx0: FnCtx, span: Span, what: string, unit: usize, tps: Ident[], paramTEs: TypeExpr[],
  retTE: Option<TypeExpr>, args: Expr[], exp: Option<Type>, explicit: Option<TypeExpr[]>, pre: Option<HExpr>[]
): Result<InferOut, Diagnostic> {
  if (args.length != paramTEs.length) {
    return Err(diag(
      "E0404",
      span,
      what + " expects " + paramTEs.length.toString() + " argument(s), found " + args.length.toString()
    ));
  }
  const tp = paramNameList(tps);
  let fx = fx0;
  let binds = noBinds(tp.length);
  match (explicit) {
    Some(ts) => {
      if (ts.length != tp.length) {
        return Err(diag(
          "E0400",
          span,
          what + " expects " + tp.length.toString() + " type argument(s), found " + ts.length.toString()
        ));
      }
      let k: usize = 0;
      for (const t of ts) {
        const r = resolveFx(fx, t, false)?;
        fx = r.fx;
        binds[k] = Some(r.ty);
        k += 1;
      }
    },
    None => {
      match (exp) {
        Some(et) => {
          match (retTE) {
            Some(rt) => { binds = unify(fx.env, unit, rt, et, tp, binds); },
            None => {}
          }
        },
        None => {}
      }
    }
  }
  let outArgs: Option<HExpr>[] = [];
  for (const _a of args) {
    outArgs.push(None);
  }
  let pi: usize = 0;
  while (pi < args.length) {
    match (pre[pi]) {
      Some(h) => {
        outArgs[pi] = Some(h);
        binds = unify(fx.env, unit, paramTEs[pi], h.ty, tp, binds);
      },
      None => {}
    }
    pi += 1;
  }
  let deferred: usize[] = [];
  let i: usize = 0;
  while (i < args.length) {
    const te = paramTEs[i];
    if (outArgs[i].isSome()) {
      // already checked
    } else if (!mentionsUnbound(te, tp, binds)) {
      const pt = resolveBound(fx, unit, tp, bindsOrVoid(binds), te, false)?;
      const r = expect(env, pt.fx, args[i], pt.ty)?;
      fx = r.fx;
      outArgs[i] = Some(r.expr);
    } else if (untypedInt(args[i])) {
      deferred.push(i);
    } else {
      match (checkLoose(env, fx, args[i], te, unit, tp, binds)) {
        Ok(r) => {
          fx = r.fx;
          outArgs[i] = Some(r.expr);
          binds = unify(fx.env, unit, te, r.expr.ty, tp, binds);
        },
        Err(d) => {
          if (d.code == "E0407") {
            deferred.push(i);
          } else {
            return Err(d);
          }
        }
      }
    }
    i += 1;
  }
  // Deferred arguments: resolvable ones are checked against their parameter; others are typed on
  // their own. Bare integer literals (default `int`) go last, one at a time.
  let pending = deferred;
  while (pending.length > 0) {
    let progress = false;
    let rest: usize[] = [];
    let firstErr: Option<Diagnostic> = None;
    for (const di of pending) {
      const te = paramTEs[di];
      if (!mentionsUnbound(te, tp, binds)) {
        const pt = resolveBound(fx, unit, tp, bindsOrVoid(binds), te, false)?;
        const r = expect(env, pt.fx, args[di], pt.ty)?;
        fx = r.fx;
        outArgs[di] = Some(r.expr);
        progress = true;
      } else if (untypedInt(args[di])) {
        rest.push(di);
      } else {
        match (checkLoose(env, fx, args[di], te, unit, tp, binds)) {
          Ok(r) => {
            fx = r.fx;
            outArgs[di] = Some(r.expr);
            binds = unify(fx.env, unit, te, r.expr.ty, tp, binds);
            progress = true;
          },
          Err(d) => {
            if (d.code != "E0407") {
              return Err(d);
            }
            if (firstErr.isNone()) {
              firstErr = Some(d);
            }
            rest.push(di);
          }
        }
      }
    }
    if (!progress) {
      let lit: Option<usize> = None;
      for (const di of rest) {
        if (lit.isNone() && untypedInt(args[di])) {
          lit = Some(di);
        }
      }
      if (lit.isNone()) {
        return Err(firstErr.unwrap());
      }
      const li = lit.unwrap();
      const r = checkExpr(env, fx, args[li], None)?;
      fx = r.fx;
      outArgs[li] = Some(r.expr);
      binds = unify(fx.env, unit, paramTEs[li], r.expr.ty, tp, binds);
      let rest2: usize[] = [];
      for (const di of rest) {
        if (di != li) {
          rest2.push(di);
        }
      }
      rest = rest2;
    }
    pending = rest;
  }
  let tys: Type[] = [];
  let bi: usize = 0;
  for (const b of binds) {
    match (b) {
      Some(t) => {
        if (isVoid(t)) {
          return Err(diag("E0400", span, "type argument `" + tp[bi] + "` of " + what + " cannot be `void`"));
        }
        tys.push(t);
      },
      None => {
        return Err(diag(
          "E0407",
          span,
          "cannot infer type argument `" + tp[bi] + "` of " + what + "; add explicit type arguments or a type annotation"
        ));
      }
    }
    bi += 1;
  }
  let hargs: HExpr[] = [];
  let j: usize = 0;
  for (const oa of outArgs) {
    const he = oa.unwrap();
    const pt = resolveBound(fx, unit, tp, tys, paramTEs[j], false)?;
    fx = pt.fx;
    if (!typeEq(he.ty, pt.ty)) {
      return Err(mismatch(fx.env, args[j].span, pt.ty, he.ty));
    }
    hargs.push(he);
    j += 1;
  }
  return Ok(InferOut { fx: fx, tys: tys, args: hargs });
}

function callGeneric(
  env: Env, fx: FnCtx, span: Span, g: usize, id: Ident, explicit: Option<TypeExpr[]>, args: Expr[],
  exp: Option<Type>
): Result<ExprOut, Diagnostic> {
  const gf = env.gfuncs[g];
  let ptes: TypeExpr[] = [];
  for (const p of gf.decl.params) {
    ptes.push(p.ty);
  }
  const io = infer(
    env, fx, span, "function `" + id.name + "`", gf.unit, gf.decl.typeParams, ptes, gf.decl.ret, args, exp, explicit
  )?;
  let cur = io.fx;
  let ret: Type = TyVoid;
  match (gf.decl.ret) {
    Some(rte) => {
      const r = resolveBound(cur, gf.unit, paramNameList(gf.decl.typeParams), io.tys, rte, true)?;
      cur = r.fx;
      ret = r.ty;
    },
    None => {}
  }
  match (checkBounds(cur.env, gf.unit, gf.decl, io.tys, span)) {
    Some(d) => { return Err(d); },
    None => {}
  }
  let fid: usize = 0;
  if (!cur.abs) {
    const fo = instFunc(cur.env, g, io.tys, cur.depth + 1, span)?;
    cur = withEnv(cur, fo.env);
    fid = fo.fid;
  }
  return done(cur, XCall(fid, io.args), ret, span);
}

function genericVariant(
  env: Env, fx: FnCtx, span: Span, g: usize, tag: usize, explicit: Option<TypeExpr[]>, args: Expr[],
  exp: Option<Type>
): Result<ExprOut, Diagnostic> {
  const gt = env.gtypes[g];
  const vs = match (gt.decl.body) {
    DUnion(x) => x,
    _ => {
      return Err(diag("E0400", span, "not a variant constructor"));
    }
  };
  const v = vs[tag];
  const io = infer(
    env, fx, span, "variant `" + v.name.name + "`", gt.unit, gt.decl.typeParams, v.payload,
    Some(selfTypeExpr(gt.decl)), args, exp, explicit
  )?;
  const inst = instType(io.fx.env, g, io.tys, 0, span)?;
  return match (inst.ty) {
    TyUnion(u) => done(withEnv(io.fx, inst.env), XVariant(tag, io.args), TyUnion(u), span),
    _ => Err(diag("E0400", span, "not a variant constructor"))
  };
}

function callBuiltin(
  env: Env, fx: FnCtx, span: Span, what: string, b: Builtin, args: Expr[]
): Result<ExprOut, Diagnostic> {
  const sig = builtinSig(b);
  const a = argsExpect(env, fx, span, what, args, sig.params)?;
  return done(a.fx, XBuiltin(b, a.args), sig.ret, span);
}

function callMember(
  env: Env, fx: FnCtx, span: Span, base: Expr, name: Ident, args: Expr[], exp: Option<Type>
): Result<ExprOut, Diagnostic> {
  match (base.kind) {
    EIdent(bid) => {
      const special = (bid.name == "console" || bid.name == "String")
        && !isVisibleVar(fx, bid.name)
        && globalVal(env, fx.unit, bid.name).isNone();
      if (special) {
        let b: Option<Builtin> = None;
        if (bid.name == "console" && name.name == "log") {
          b = Some(BConsoleLog);
        } else if (bid.name == "console" && name.name == "error") {
          b = Some(BConsoleError);
        } else if (bid.name == "String" && name.name == "fromCharCode") {
          b = Some(BStringFromCharCode);
        }
        if (b.isNone()) {
          return Err(diag("E0405", name.span, "`" + bid.name + "` has no member `" + name.name + "`"));
        }
        return callBuiltin(env, fx, span, "`" + bid.name + "." + name.name + "`", b.unwrap(), args);
      }
      if (!isVisibleVar(fx, bid.name) && globalVal(env, fx.unit, bid.name).isNone()) {
        const te = findType(env.units[fx.unit].scope, bid.name);
        if (te.isSome()) {
          match (te.unwrap()) {
            EntRecord(r) => {
              const co = classOfRec(fx.env, r);
              if (co.isSome()) {
                return staticCall(env, fx, span, co.unwrap(), name, args);
              }
            },
            _ => {}
          }
        }
      }
    },
    _ => {}
  }
  return methodCall(env, fx, span, base, name, args, exp);
}

function builtinCtor(
  env: Env, fx: FnCtx, span: Span, name: string, args: Expr[], exp: Option<Type>
): Result<ExprOut, Diagnostic> {
  if (name == "Some") {
    return someCtor(env, fx, span, args, exp);
  }
  if (exp.isNone()) {
    // Ok(x) / Err(x) cannot infer the other type parameter.
    let cur = fx;
    for (const a of args) {
      const r = checkExpr(env, cur, a, None)?;
      cur = r.fx;
    }
    if (name == "Ok") {
      return Err(diag("E0407", span, "cannot infer the error type of `Ok(..)`; add a type annotation"));
    }
    return Err(diag("E0407", span, "cannot infer the success type of `Err(..)`; add a type annotation"));
  }
  const et = exp.unwrap();
  return match (et) {
    TyResult(t, e) => name == "Ok" ? okCtor(env, fx, span, args, t, e) : errCtor(env, fx, span, args, t, e),
    _ => Err(diag("E0400", span, "expected `" + showType(fx.env, et) + "`, found a `Result`"))
  };
}

function someCtor(env: Env, fx: FnCtx, span: Span, args: Expr[], exp: Option<Type>): Result<ExprOut, Diagnostic> {
  if (args.length != 1) {
    return Err(diag("E0404", span, "`Some` expects 1 argument, found " + args.length.toString()));
  }
  let inner: Option<Type> = None;
  match (exp) {
    Some(t) => {
      match (t) {
        TyOption(x) => { inner = Some(x); },
        _ => {}
      }
    },
    None => {}
  }
  const p = match (inner) {
    Some(x) => expect(env, fx, args[0], x)?,
    None => checkExpr(env, fx, args[0], None)?
  };
  if (isVoid(p.expr.ty)) {
    return Err(diag("E0400", args[0].span, "`Option<void>` is not allowed"));
  }
  return done(p.fx, XVariant(0, [p.expr]), TyOption(p.expr.ty), span);
}

function okCtor(
  env: Env, fx: FnCtx, span: Span, args: Expr[], t: Type, e: Type
): Result<ExprOut, Diagnostic> {
  const want: usize = isVoid(t) ? 0 : 1;
  if (args.length != want) {
    return Err(diag("E0404", span, "`Ok` expects " + want.toString() + " argument(s), found " + args.length.toString()));
  }
  if (want == 0) {
    return done(fx, XVariant(0, noExprs()), TyResult(t, e), span);
  }
  const p = expect(env, fx, args[0], t)?;
  return done(p.fx, XVariant(0, [p.expr]), TyResult(t, e), span);
}

function errCtor(
  env: Env, fx: FnCtx, span: Span, args: Expr[], t: Type, e: Type
): Result<ExprOut, Diagnostic> {
  if (args.length != 1) {
    return Err(diag("E0404", span, "`Err` expects 1 argument, found " + args.length.toString()));
  }
  const p = expect(env, fx, args[0], e)?;
  return done(p.fx, XVariant(1, [p.expr]), TyResult(t, e), span);
}

function isPlaceShaped(fx: FnCtx, base: Expr): bool {
  return match (base.kind) {
    EIdent(id) => isVisibleVar(fx, id.name),
    EThis => true,
    EMember(_, _) => true,
    EIndex(_, _) => true,
    _ => false
  };
}

function methodCall(
  env: Env, fx: FnCtx, span: Span, base: Expr, name: Ident, args: Expr[], exp: Option<Type>
): Result<ExprOut, Diagnostic> {
  const n = name.name;
  const bo = checkExpr(env, fx, base, None);
  if (bo.isOk()) {
    const b0 = bo.unwrap();
    match (b0.expr.ty) {
      TyRecord(r) => {
        const mo = mapOrigin(b0.fx.env, b0.expr.ty);
        if (mo.isSome()) {
          return mapMethodCall(env, b0, span, base, name, args, exp, mo.unwrap());
        }
        const co = classOfRec(b0.fx.env, r);
        if (co.isSome()) {
          const mo = findMethod(b0.fx.env.classes[co.unwrap()], n);
          if (mo.isSome() || !recordHasFnField(b0.fx.env, r, n)) {
            return classMethodCall(env, b0.fx, span, base, b0, co.unwrap(), name, args);
          }
        }
        const bd = boundOf(b0.fx.env, r);
        if (bd.isSome()) {
          return ifaceCall(env, b0, span, bd.unwrap(), name, args);
        }
        if (recordHasFnField(b0.fx.env, r, n)) {
          return callFieldValue(env, b0, span, r, name, args);
        }
      },
      TyArray(t) => {
        if (isArrayApi(n)) {
          return arrayApiCall(env, b0, span, t, name, args, exp);
        }
      },
      TyIface(i) => {
        return ifaceCall(env, b0, span, i, name, args);
      },
      _ => {}
    }
  }
  if (n == "push" || n == "pop") {
    return mutMethodCall(env, fx, span, base, name, args);
  }
  const b = bo?;
  const so = methodSig(b.expr.ty, n);
  if (so.isNone()) {
    return Err(diag("E0405", name.span, "no method `" + n + "` on type `" + showType(b.fx.env, b.expr.ty) + "`"));
  }
  const s = so.unwrap();
  const a = argsExpect(env, b.fx, span, "method `" + n + "`", args, s.params)?;
  let all: HExpr[] = [b.expr];
  for (const x of a.args) {
    all.push(x);
  }
  return done(a.fx, XBuiltin(s.op, all), s.ret, span);
}

function mutMethodCall(
  env: Env, fx: FnCtx, span: Span, base: Expr, name: Ident, args: Expr[]
): Result<ExprOut, Diagnostic> {
  const n = name.name;
  if (isPlaceShaped(fx, base)) {
    const pi = checkPlace(env, fx, base)?;
    return match (pi.place.ty) {
      TyArray(t) => {
        if (!pi.mutable) {
          return Err(diag(
            "E0401",
            base.span,
            "cannot call `" + n + "` on `" + pi.rootName + "`: it is not declared with `let`"
          ));
        }
        const isPush = n == "push";
        const params: Type[] = isPush ? [t] : [];
        const a = argsExpect(env, markMut(pi.fx, pi.place), span, "method `" + n + "`", args, params)?;
        const op: MutBuiltin = isPush ? MArrPush : MArrPop;
        const ret: Type = isPush ? TyVoid : TyOption(t);
        return done(a.fx, XMutMethod(op, pi.place, a.args), ret, span);
      },
      _ => Err(diag("E0405", name.span, "no method `" + n + "` on type `" + showType(pi.fx.env, pi.place.ty) + "`"))
    };
  }
  const b = checkExpr(env, fx, base, None)?;
  if (isArrayTy(b.expr.ty)) {
    return Err(diag("E0401", base.span, "receiver of `" + n + "` must be a mutable place"));
  }
  return Err(diag("E0405", name.span, "no method `" + n + "` on type `" + showType(b.fx.env, b.expr.ty) + "`"));
}

// ---------------------------------------------------------------------------
// Places
// ---------------------------------------------------------------------------

function extendPath(p: Place, elem: PlaceElem, ty: Type): Place {
  let path = p.path;
  path.push(elem);
  return Place { root: p.root, path: path, ty: ty };
}

function checkPlace(env: Env, fx: FnCtx, e: Expr): Result<PlaceOut, Diagnostic> {
  return match (e.kind) {
    EIdent(id) => {
      const lv = lookupVar(fx, id.name);
      if (lv.id.isSome() && isCapturedLocal(lv.fx, lv.id.unwrap())) {
        return Err(capturedErr(e.span, id.name));
      }
      if (lv.id.isSome()) {
        const l = lv.id.unwrap();
        const loc = fx.locals[l];
        const path: PlaceElem[] = [];
        return Ok(PlaceOut {
          fx: fx,
          place: Place { root: l, path: path, ty: loc.ty },
          mutable: loc.mutable,
          rootName: id.name
        });
      }
      if (globalVal(env, fx.unit, id.name).isSome()) {
        return Err(diag("E0401", e.span, "cannot assign to `" + id.name + "`"));
      }
      return Err(diag("E0300", id.span, "unresolved name `" + id.name + "`"));
    },
    EThis => {
      const lv = lookupVar(fx, "this");
      if (lv.id.isNone()) {
        return Err(thisErr(fx, e.span));
      }
      if (isCapturedLocal(lv.fx, lv.id.unwrap())) {
        return Err(capturedErr(e.span, "this"));
      }
      const l = lv.id.unwrap();
      const path: PlaceElem[] = [];
      return Ok(PlaceOut {
        fx: fx,
        place: Place { root: l, path: path, ty: fx.locals[l].ty },
        mutable: fx.locals[l].mutable,
        rootName: "this"
      });
    },
    EMember(base, name) => {
      const p = checkPlace(env, fx, base)?;
      return match (p.place.ty) {
        TyRecord(r) => {
          if (outsideMapPrelude(p.fx, p.place.ty)) {
            return Err(diag("E0401", e.span, "`" + name.name + "` is read-only: a `Map` changes only through `set` and `delete`"));
          }
          const def = p.fx.env.records[r];
          const io = fieldIndex(def.fields, name.name);
          if (io.isNone()) {
            return Err(diag("E0405", name.span, "no field `" + name.name + "` on type `" + def.name + "`"));
          }
          checkFieldAccess(p.fx, r, name)?;
          const i = io.unwrap();
          return Ok(PlaceOut {
            fx: p.fx,
            place: extendPath(p.place, PField(r, i), def.fields[i].ty),
            mutable: p.mutable,
            rootName: p.rootName
          });
        },
        TyString => name.name == "length"
          ? Err(diag("E0401", e.span, "`length` is read-only"))
          : Err(noField(fx.env, name, p.place.ty)),
        TyArray(_) => name.name == "length"
          ? Err(diag("E0401", e.span, "`length` is read-only"))
          : Err(noField(fx.env, name, p.place.ty)),
        _ => Err(noField(fx.env, name, p.place.ty))
      };
    },
    EIndex(base, index) => {
      const p = checkPlace(env, fx, base)?;
      return match (p.place.ty) {
        TyArray(t) => {
          const idx = expect(env, p.fx, index, TyUsize)?;
          return Ok(PlaceOut {
            fx: idx.fx,
            place: extendPath(p.place, PIndex(idx.expr), t),
            mutable: p.mutable,
            rootName: p.rootName
          });
        },
        _ => Err(diag("E0400", e.span, "cannot index into type `" + showType(p.fx.env, p.place.ty) + "`"))
      };
    },
    _ => Err(diag("E0401", e.span, "expression is not an assignable place"))
  };
}

// ---------------------------------------------------------------------------
// Match
// ---------------------------------------------------------------------------

function variantsOf(env: Env, t: Type): Option<VariantDef[]> {
  return match (t) {
    TyUnion(u) => Some(env.unions[u].variants),
    TyOption(x) => Some([VariantDef { name: "Some", payload: [x] }, VariantDef { name: "None", payload: noTypes() }]),
    TyResult(a, b) => Some([
      VariantDef { name: "Ok", payload: isVoid(a) ? noTypes() : [a] },
      VariantDef { name: "Err", payload: [b] }
    ]),
    _ => None
  };
}

function noTypes(): Type[] {
  const xs: Type[] = [];
  return xs;
}

function isLiteralScrut(t: Type): bool {
  return isIntish(t) || isString(t) || isBool(t);
}

function exprAsMatch(e: Expr): Option<Expr> {
  return match (e.kind) {
    EMatch(_, _) => Some(e),
    _ => None
  };
}

// One match arm: returns the arm plus whether it diverges and the (possibly inferred) target type.
type ArmOut = { fx: FnCtx; arm: HArm; div: bool; target: Option<Type>; covered: bool[]; wild: bool; };

function checkArm(
  env: Env, fx0: FnCtx, arm: MatchArm, sty: Type, variants: Option<VariantDef[]>, covered: bool[],
  wild: bool, target: Option<Type>, stmtPos: bool
): Result<ArmOut, Diagnostic> {
  const fx1 = pushScope(fx0);
  const po = checkPattern(env, fx1, arm.pattern, sty, variants, covered, wild)?;
  let cur = po.fx;
  const outerPre = cur.pre;
  const noPre: HStmt[] = [];
  cur.pre = noPre;
  let body: HBlock = HBlock { stmts: [] };
  let value: Option<HExpr> = None;
  let div = false;
  let tgt = target;
  match (arm.body) {
    BExpr(e) => {
      if (stmtPos) {
        let he: HExpr = mk(XBool(false), TyBool, e.span);
        match (e.kind) {
          EMatch(sc, inner) => {
            const m = checkMatch(env, cur, e.span, sc, inner, None, true)?;
            cur = m.fx;
            he = m.expr;
            div = m.div;
          },
          _ => {
            const r = checkExpr(env, cur, e, None)?;
            cur = r.fx;
            he = r.expr;
          }
        }
        body = isNop(he) ? HBlock { stmts: [] } : HBlock { stmts: [HExprStmt(he)] };
      } else {
        match (tgt) {
          Some(t) => {
            const r = expect(env, cur, e, t)?;
            cur = r.fx;
            value = Some(r.expr);
          },
          None => {
            const r = checkExpr(env, cur, e, None)?;
            cur = r.fx;
            tgt = Some(r.expr.ty);
            value = Some(r.expr);
          }
        }
      }
    },
    BBlock(b) => {
      const bo = checkBlock(env, cur, b)?;
      cur = bo.fx;
      if (!stmtPos && !bo.div) {
        let d = diag(
          "E0400",
          b.span,
          "block arm of a match used as an expression must end in `return`, `break` or `continue`"
        );
        d.notes.push("a block arm has no value; use an expression arm to produce a value");
        return Err(d);
      }
      body = bo.block;
      div = bo.div;
    }
  }
  if (cur.pre.length > 0) {
    let all: HStmt[] = [];
    for (const h of cur.pre) {
      all.push(h);
    }
    for (const h of body.stmts) {
      all.push(h);
    }
    body = HBlock { stmts: all };
  }
  cur.pre = outerPre;
  cur = popScope(cur);
  return Ok(ArmOut {
    fx: cur,
    arm: HArm { pattern: po.pat, body: body, value: value },
    div: div,
    target: tgt,
    covered: po.covered,
    wild: po.wild
  });
}

function checkMatch(
  env: Env, fx: FnCtx, span: Span, scrut: Expr, arms: MatchArm[], exp: Option<Type>, stmtPos: bool
): Result<MatchOut, Diagnostic> {
  const s = checkExpr(env, fx, scrut, None)?;
  const sty = s.expr.ty;
  const variants = variantsOf(s.fx.env, sty);
  if (variants.isNone() && !isLiteralScrut(sty)) {
    return Err(diag("E0402", scrut.span, "cannot match on a value of type `" + showType(fx.env, sty) + "`"));
  }
  let covered: bool[] = [];
  if (variants.isSome()) {
    for (const _v of variants.unwrap()) {
      covered.push(false);
    }
  }
  let wild = false;
  let target: Option<Type> = stmtPos ? Some(TyVoid) : exp;
  let cur = s.fx;
  let harms: HArm[] = [];
  let allDiv = true;
  for (const arm of arms) {
    const r = checkArm(env, cur, arm, sty, variants, covered, wild, target, stmtPos)?;
    cur = r.fx;
    target = r.target;
    allDiv = allDiv && r.div;
    harms.push(r.arm);
    covered = r.covered;
    wild = r.wild;
  }
  if (!wild) {
    if (variants.isSome()) {
      let missing: string[] = [];
      let i: usize = 0;
      for (const v of variants.unwrap()) {
        if (!covered[i]) {
          missing.push(v.name);
        }
        i += 1;
      }
      if (missing.length > 0) {
        return Err(diag("E0402", span, "non-exhaustive match: missing " + missing.join(", ")));
      }
    } else {
      return Err(diag("E0402", span, "match on a scalar value requires a `_` arm"));
    }
  }
  if (target.isNone()) {
    return Err(diag("E0407", span, "cannot infer the type of a match whose arms all diverge"));
  }
  const ty = target.unwrap();
  const div = stmtPos && arms.length > 0 && allDiv;
  return Ok(MatchOut { fx: cur, expr: mk(XMatch(s.expr, harms), ty, span), div: div });
}

// ---------------------------------------------------------------------------
// Statements
// ---------------------------------------------------------------------------

export function checkBlock(env: Env, fx: FnCtx, b: Block): Result<BlockOut, Diagnostic> {
  let cur = pushScope(fx);
  let stmts: HStmt[] = [];
  let div = false;
  for (const s of b.stmts) {
    // Loop contract clauses (ADR-0012) are checked in the current scope and erased.
    const isClause = match (s.kind) {
      SContract(_) => true,
      _ => false
    };
    if (isClause) {
      match (s.kind) {
        SContract(c) => {
          const co = checkClause(env, cur, c, 1)?;
          cur.env = co.env;
          match (co.expr) {
            Some(x) => { cur.cexprs.push(x); },
            None => {}
          }
        },
        _ => {}
      }
      continue;
    }
    // Statements hoisted out of this statement's expressions (mutating method calls) go first;
    // the pending list of an enclosing statement is set aside meanwhile.
    const outer = cur.pre;
    const none: HStmt[] = [];
    cur.pre = none;
    const r = checkStmt(env, cur, s)?;
    cur = r.fx;
    for (const h of cur.pre) {
      stmts.push(h);
    }
    cur.pre = outer;
    stmts.push(r.stmt);
    div = r.div;
  }
  cur = popScope(cur);
  return Ok(BlockOut { fx: cur, block: HBlock { stmts: stmts }, div: div });
}

function sout(fx: FnCtx, stmt: HStmt, div: bool): Result<StmtOut, Diagnostic> {
  return Ok(StmtOut { fx: fx, stmt: stmt, div: div });
}

function checkStmt(env: Env, fx: FnCtx, s: Stmt): Result<StmtOut, Diagnostic> {
  return match (s.kind) {
    SLet(mutable, name, ty, init) => stmtLet(env, fx, mutable, name, ty, init),
    SAssign(target, op, value) => stmtAssign(env, fx, target, op, value),
    SExpr(e) => stmtExpr(env, fx, e),
    SReturn(v) => stmtReturn(env, fx, s.span, v),
    SIf(c, thenB, els) => stmtIf(env, fx, c, thenB, els),
    SWhile(c, body) => stmtWhile(env, fx, c, body),
    SForOf(name, iter, body) => stmtForOf(env, fx, name, iter, body),
    SBreak => {
      if (fx.loops.length == 0) {
        return Err(diag("E0409", s.span, "`break` outside of a loop"));
      }
      return sout(markBreak(fx), HBreak, true);
    },
    SContinue => {
      if (fx.loops.length == 0) {
        return Err(diag("E0409", s.span, "`continue` outside of a loop"));
      }
      return sout(fx, HContinue, true);
    },
    SBlock(b) => {
      const r = checkBlock(env, fx, b)?;
      return sout(r.fx, HBlockStmt(r.block), r.div);
    },
    SContract(_) => Err(diag("E0200", s.span, "contract clause outside a loop context"))
  };
}

export type ClauseOut = { env: Env; expr: Option<HExpr>; };

// Type-checks one contract clause (ADR-0012, spec 15 §4.2a) in the (forked) context `fx` and
// discards the result, so contracts never reach the generated code. `cmode`: 1 `@Requires`,
// `@Invariant`, `@Decreases`, loop clauses; 2 `@Ensures`. The expression must be `bool`
// (`@Decreases`: `int` or `usize`, E0414); mutating method calls are rejected (E0416). The returned
// HIR is only used by the purity pass (purity.or). Environment growth (generic instances requested
// by the clause) is kept so function ids stay consistent.
export function checkClause(env: Env, fx: FnCtx, c: ContractClause, cmode: int): Result<ClauseOut, Diagnostic> {
  const none: Option<HExpr> = None;
  return match (c.expr) {
    None => Ok(ClauseOut { env: fx.env, expr: none }),
    Some(e) => {
      let f = fx;
      f.cmode = cmode;
      const isDec = match (c.kind) {
        CDecreases => true,
        _ => false
      };
      const hint: Option<Type> = isDec ? None : Some(TyBool);
      const lifted0 = fx.env.lifted.length;
      const r = checkExpr(env, f, e, hint)?;
      if (isDec) {
        if (!isIntish(r.expr.ty)) {
          return Err(diag("E0414", e.span, "@Decreases expects an `int` or `usize` measure, found `" + showType(r.fx.env, r.expr.ty) + "`"));
        }
      } else if (!isBool(r.expr.ty)) {
        return Err(diag("E0414", e.span, "contract expression must be `bool`, found `" + showType(r.fx.env, r.expr.ty) + "`"));
      }
      if (r.fx.pre.length > fx.pre.length) {
        return Err(diag("E0416", e.span, "a call that mutates its receiver is not allowed in a contract expression"));
      }
      if (r.fx.env.lifted.length != lifted0) {
        return Err(diag("E0416", e.span, "closures are not allowed in a contract expression"));
      }
      return Ok(ClauseOut { env: r.fx.env, expr: Some(r.expr) });
    }
  };
}

function letInit(env: Env, fx: FnCtx, ty: Option<TypeExpr>, init: Expr): Result<LetInit, Diagnostic> {
  return match (ty) {
    Some(te) => {
      const tr = resolveFx(fx, te, false)?;
      const t = tr.ty;
      const e = expect(env, tr.fx, init, t)?;
      return Ok(LetInit { fx: e.fx, expr: e.expr, ty: t });
    },
    None => {
      const e = checkExpr(env, fx, init, None)?;
      return Ok(LetInit { fx: e.fx, expr: e.expr, ty: e.expr.ty });
    }
  };
}

function isArrowExpr(e: Expr): bool {
  return match (e.kind) {
    EArrow(_, _, _) => true,
    _ => false
  };
}

function stmtLet(
  env: Env, fx0: FnCtx, mutable: bool, name: Ident, ty: Option<TypeExpr>, init: Expr
): Result<StmtOut, Diagnostic> {
  let fx = fx0;
  if (isArrowExpr(init)) {
    fx.pendLet = name.name;
  }
  const li0 = letInit(env, fx, ty, init)?;
  let li = li0;
  li.fx.pendLet = "";
  if (isVoid(li.ty)) {
    return Err(diag("E0400", init.span, "cannot bind a `void` value to a variable"));
  }
  if (declaredInScope(li.fx, name.name)) {
    return Err(diag("E0304", name.span, "`" + name.name + "` is already declared in this block"));
  }
  const nl = newLocal(li.fx, name.name, li.ty, mutable);
  const f2 = declare(nl.fx, name, nl.id)?;
  return sout(f2, HLet(nl.id, li.expr), false);
}

function assignOpOf(op: AssignOp): Option<BinOp> {
  return match (op) {
    OpAssign => None,
    OpAddAssign => Some(OpAdd),
    OpSubAssign => Some(OpSub),
    OpMulAssign => Some(OpMul),
    OpDivAssign => Some(OpDiv),
    OpRemAssign => Some(OpRem)
  };
}

function isRemOp(o: BinOp): bool {
  return match (o) { OpRem => true, _ => false };
}

function isAddOp(o: BinOp): bool {
  return match (o) { OpAdd => true, _ => false };
}

function stmtAssign(env: Env, fx: FnCtx, target: Expr, op: AssignOp, value: Expr): Result<StmtOut, Diagnostic> {
  const pi = checkPlace(env, fx, target)?;
  if (!pi.mutable) {
    return Err(diag(
      "E0401",
      target.span,
      "cannot assign to `" + pi.rootName + "`: it is not declared with `let`"
    ));
  }
  const pty = pi.place.ty;
  const hop = assignOpOf(op);
  if (hop.isSome()) {
    const o = hop.unwrap();
    const ok = isIntish(pty) || (isFloatTy(pty) && !isRemOp(o)) || (isAddOp(o) && isString(pty));
    if (!ok) {
      return Err(diag(
        "E0410",
        target.span,
        "compound assignment is not defined for type `" + showType(fx.env, pty) + "`"
      ));
    }
  }
  const v = expect(env, markMut(pi.fx, pi.place), value, pty)?;
  return sout(v.fx, HAssign(pi.place, hop, v.expr), false);
}

function stmtExpr(env: Env, fx: FnCtx, e: Expr): Result<StmtOut, Diagnostic> {
  return match (e.kind) {
    EMatch(sc, arms) => {
      const m = checkMatch(env, fx, e.span, sc, arms, None, true)?;
      return sout(m.fx, HExprStmt(m.expr), m.div);
    },
    _ => {
      const r = checkExpr(env, fx, e, None)?;
      if (isNop(r.expr)) {
        return sout(r.fx, HBlockStmt(HBlock { stmts: [] }), false);
      }
      return sout(r.fx, HExprStmt(r.expr), false);
    }
  };
}

// `return` in an arrow function block body whose result type is still to be inferred (the first
// `return` fixes it; later ones must agree).
function returnInfer(env: Env, fx: FnCtx, span: Span, v: Option<Expr>): Result<StmtOut, Diagnostic> {
  return match (v) {
    None => {
      match (fx.retSeen) {
        Some(t) => {
          if (!isVoid(t)) {
            return Err(diag("E0400", span, "`return;` in a closure returning `" + showType(fx.env, t) + "`"));
          }
        },
        None => {}
      }
      let f = fx;
      f.retSeen = Some(TyVoid);
      return sout(f, HReturn(None), true);
    },
    Some(e) => {
      const r = match (fx.retSeen) {
        Some(t) => expect(env, fx, e, t)?,
        None => checkExpr(env, fx, e, None)?
      };
      if (isVoid(r.expr.ty)) {
        return Err(diag("E0400", e.span, "cannot return a value of type `void`"));
      }
      let f = r.fx;
      f.retSeen = Some(r.expr.ty);
      return sout(f, HReturn(Some(r.expr)), true);
    }
  };
}

function stmtReturn(env: Env, fx: FnCtx, span: Span, v: Option<Expr>): Result<StmtOut, Diagnostic> {
  if (fx.retInfer) {
    return returnInfer(env, fx, span, v);
  }
  return match (v) {
    None => {
      if (!isVoid(fx.ret)) {
        return Err(diag("E0400", span, "`return;` in a function returning `" + showType(fx.env, fx.ret) + "`"));
      }
      if (fx.fmode == 1 || fx.fmode == 3) {
        return sout(fx, HReturn(Some(thisRead(fx, span))), true);
      }
      return sout(fx, HReturn(None), true);
    },
    Some(e) => {
      if (isVoid(fx.ret)) {
        return Err(diag("E0400", e.span, "cannot return a value from a function returning `void`"));
      }
      const r = expect(env, fx, e, fx.ret)?;
      if (fx.fmode == 4) {
        const rid = match (fx.lret) { TyRecord(x) => x, _ => 0 };
        // The result is computed first (it may mutate `this`), then `this` is read.
        let f1 = r.fx;
        const nl = newLocal(f1, "$v" + f1.tmps.toString(), r.expr.ty, false);
        f1 = nl.fx;
        f1.tmps += 1;
        f1.pre.push(HLet(nl.id, r.expr));
        const val = mk(XLocal(nl.id), r.expr.ty, span);
        const wrapped = mk(
          XRecord(rid, None, [FieldInitH { index: 0, value: thisRead(f1, span) }, FieldInitH { index: 1, value: val }]),
          fx.lret,
          span
        );
        return sout(f1, HReturn(Some(wrapped)), true);
      }
      return sout(r.fx, HReturn(Some(r.expr)), true);
    }
  };
}

function elseBranch(env: Env, fx: FnCtx, els: Option<Stmt>): Result<ElseOut, Diagnostic> {
  return match (els) {
    None => Ok(ElseOut { fx: fx, block: None, div: false }),
    Some(es) => match (es.kind) {
      SBlock(b) => {
        const r = checkBlock(env, fx, b)?;
        return Ok(ElseOut { fx: r.fx, block: Some(r.block), div: r.div });
      },
      _ => {
        const outer = fx.pre;
        let f0 = fx;
        const none: HStmt[] = [];
        f0.pre = none;
        const r = checkStmt(env, f0, es)?;
        let stmts: HStmt[] = [];
        for (const h of r.fx.pre) {
          stmts.push(h);
        }
        stmts.push(r.stmt);
        let f1 = r.fx;
        f1.pre = outer;
        return Ok(ElseOut { fx: f1, block: Some(HBlock { stmts: stmts }), div: r.div });
      }
    }
  };
}

function stmtIf(env: Env, fx: FnCtx, cond: Expr, thenB: Block, els: Option<Stmt>): Result<StmtOut, Diagnostic> {
  const c = expect(env, fx, cond, TyBool)?;
  const t = checkBlock(env, c.fx, thenB)?;
  const e = elseBranch(env, t.fx, els)?;
  const div = t.div && els.isSome() && e.div;
  return sout(e.fx, HIf(c.expr, t.block, e.block), div);
}

function isTrueLit(e: HExpr): bool {
  return match (e.kind) {
    XBool(b) => b,
    _ => false
  };
}

function stmtWhile(env: Env, fx: FnCtx, cond: Expr, body: Block): Result<StmtOut, Diagnostic> {
  const c = expect(env, fx, cond, TyBool)?;
  if (c.fx.pre.length > fx.pre.length) {
    return Err(condHoistErr(cond.span));
  }
  const b = checkBlock(env, pushLoop(c.fx), body)?;
  const lp = popLoop(b.fx);
  return sout(lp.fx, HWhile(c.expr, b.block), isTrueLit(c.expr) && !lp.broke);
}

function stmtForOf(env: Env, fx: FnCtx, name: Ident, iter: Expr, body: Block): Result<StmtOut, Diagnostic> {
  const it = checkExpr(env, fx, iter, None)?;
  return match (it.expr.ty) {
    TyArray(elem) => {
      const nl = newLocal(pushScope(it.fx), name.name, elem, false);
      const f2 = declare(nl.fx, name, nl.id)?;
      const b = checkBlock(env, pushLoop(f2), body)?;
      const lp = popLoop(b.fx);
      return sout(popScope(lp.fx), HForOf(nl.id, it.expr, b.block), false);
    },
    _ => Err(diag(
      "E0400",
      iter.span,
      "`for ... of` requires an array, found `" + showType(it.fx.env, it.expr.ty) + "`"
    ))
  };
}

// ---------------------------------------------------------------------------
// Classes (beyond Orin-B, ADR-0009)
// ---------------------------------------------------------------------------

// The void marker returned for a hoisted mutating call: the statement `p = C.m(p, ..)` is already in
// `fx.pre`; a statement whose expression is this marker emits nothing more.
function isNop(e: HExpr): bool {
  return match (e.kind) {
    XBool(_) => isVoid(e.ty),
    _ => false
  };
}

function nopExpr(span: Span): HExpr {
  return mk(XBool(false), TyVoid, span);
}

function condHoistErr(span: Span): Diagnostic {
  return diag(
    "E0408",
    span,
    "a call to a mutating method is not allowed in a conditionally evaluated expression (`&&`/`||` operand, `?:` branch, `while` condition); move it into its own statement"
  );
}

// True inside the constructor / methods of class `c` (private members are visible there).
function inClass(fx: FnCtx, c: usize): bool {
  return fx.clsAcc == c.toInt();
}

function thisErr(fx: FnCtx, span: Span): Diagnostic {
  if (fx.fmode == 1) {
    return diag("E0300", span, "`this` cannot be used before every field is initialized by the leading `this.f = e;` statements of the constructor");
  }
  if (fx.fmode == 5) {
    return diag("E0300", span, "`this` is not available in a static method");
  }
  return diag("E0300", span, "`this` can only be used inside a class constructor or method");
}

function thisRead(fx: FnCtx, span: Span): HExpr {
  const l = lookupLocal(fx, "this").unwrapOr(0);
  return mk(XLocal(l), fx.locals[l].ty, span);
}

function checkThis(fx: FnCtx, span: Span): Result<ExprOut, Diagnostic> {
  const lv = lookupVar(fx, "this");
  if (lv.id.isNone()) {
    return Err(thisErr(fx, span));
  }
  const l = lv.id.unwrap();
  return done(lv.fx, XLocal(l), lv.fx.locals[l].ty, span);
}

function checkFieldAccess(fx: FnCtx, r: usize, name: Ident): Result<bool, Diagnostic> {
  const co = classOfRec(fx.env, r);
  if (co.isSome()) {
    const c = co.unwrap();
    const ci = fx.env.classes[c];
    if (fieldIsPrivate(ci, name.name) && !inClass(fx, c)) {
      return Err(diag("E0405", name.span, "field `" + name.name + "` of class `" + ci.name + "` is private"));
    }
  }
  return Ok(true);
}

// Records that the `this` of the method being analysed is mutated through `place`.
function markMut(fx: FnCtx, place: Place): FnCtx {
  const t = lookupLocal(fx, "this");
  if (t.isSome() && t.unwrap() == place.root) {
    let f = fx;
    f.mutThis = true;
    return f;
  }
  return fx;
}

function checkNew(
  env: Env, fx: FnCtx, span: Span, name: Ident, targs: TypeExpr[], args: Expr[], exp: Option<Type>
): Result<ExprOut, Diagnostic> {
  if (name.name == "Map" && findType(env.units[fx.unit].scope, "Map").isNone() && env.mapUnit >= 0) {
    return newMap(env, fx, span, targs, args, exp);
  }
  if (targs.length > 0) {
    return Err(diag("E0408", name.span, "generic classes are not supported yet (ADR-0009)"));
  }
  const found = findType(env.units[fx.unit].scope, name.name);
  if (found.isNone()) {
    return Err(diag("E0300", name.span, "unknown class `" + name.name + "`"));
  }
  const co = match (found.unwrap()) {
    EntRecord(r) => classOfRec(fx.env, r),
    _ => None
  };
  if (co.isNone()) {
    return Err(diag("E0400", name.span, "`" + name.name + "` is not a class"));
  }
  const ci = fx.env.classes[co.unwrap()];
  const f = fx.env.funcs[ci.ctor];
  const a = argsExpect(env, fx, span, "constructor of `" + name.name + "`", args, f.params)?;
  return done(a.fx, XCall(ci.ctor, a.args), TyRecord(ci.rec), span);
}

function tailTypes(ts: Type[]): Type[] {
  let out: Type[] = [];
  let i: usize = 1;
  while (i < ts.length) {
    out.push(ts[i]);
    i += 1;
  }
  return out;
}

function staticCall(
  env: Env, fx: FnCtx, span: Span, c: usize, name: Ident, args: Expr[]
): Result<ExprOut, Diagnostic> {
  const ci = fx.env.classes[c];
  const mo = findMethod(ci, name.name);
  if (mo.isNone()) {
    return Err(diag("E0405", name.span, "class `" + ci.name + "` has no static method `" + name.name + "`"));
  }
  const mi = ci.methods[mo.unwrap()];
  if (mi.priv && !inClass(fx, c)) {
    return Err(diag("E0405", name.span, "method `" + name.name + "` of class `" + ci.name + "` is private"));
  }
  if (!mi.isStatic) {
    return Err(diag("E0405", name.span, "`" + name.name + "` is an instance method of `" + ci.name + "`; call it on a value"));
  }
  const f = fx.env.funcs[mi.fid];
  const a = argsExpect(env, fx, span, "method `" + name.name + "`", args, f.params)?;
  return done(a.fx, XCall(mi.fid, a.args), f.ret, span);
}

// Receiver index expressions are evaluated twice by the lowering `p = C.m(p, ..)`; only
// side-effect-free ones are accepted.
function pureH(e: HExpr): bool {
  return match (e.kind) {
    XInt(_) => true,
    XBool(_) => true,
    XStr(_) => true,
    XLocal(_) => true,
    XField(b, _, _) => pureH(b),
    XIndex(a, i) => pureH(a) && pureH(i),
    XUnary(_, a) => pureH(a),
    XBinary(_, a, b) => pureH(a) && pureH(b),
    XBuiltin(b, xs) => {
      let ok = match (b) {
        BArrLength => true,
        BStrLength => true,
        BIntToUsize => true,
        BUsizeToInt => true,
        _ => false
      };
      for (const x of xs) {
        ok = ok && pureH(x);
      }
      return ok;
    },
    _ => false
  };
}

function purePlace(p: Place): bool {
  for (const el of p.path) {
    match (el) {
      PIndex(ix) => {
        if (!pureH(ix)) {
          return false;
        }
      },
      PField(_, _) => {}
    }
  }
  return true;
}

// `recv.m(args)` where the receiver has class type `c` (already checked as `b`).
function classMethodCall(
  env: Env, fx0: FnCtx, span: Span, base: Expr, b: ExprOut, c: usize, name: Ident, args: Expr[]
): Result<ExprOut, Diagnostic> {
  const ci = fx0.env.classes[c];
  const mo = findMethod(ci, name.name);
  if (mo.isNone()) {
    return Err(diag("E0405", name.span, "no method `" + name.name + "` on class `" + ci.name + "`"));
  }
  const mi = ci.methods[mo.unwrap()];
  if (mi.priv && !inClass(fx0, c)) {
    return Err(diag("E0405", name.span, "method `" + name.name + "` of class `" + ci.name + "` is private"));
  }
  if (mi.isStatic) {
    return Err(diag("E0405", name.span, "`" + name.name + "` is a static method; call it as `" + ci.name + "." + name.name + "(..)`"));
  }
  const f = fx0.env.funcs[mi.fid];
  const a = argsExpect(env, fx0, span, "method `" + name.name + "`", args, tailTypes(f.params))?;
  let all: HExpr[] = [b.expr];
  for (const x of a.args) {
    all.push(x);
  }
  if (!mi.mutating) {
    return done(a.fx, XCall(mi.fid, all), f.srcRet, span);
  }
  if (!isPlaceShaped(a.fx, base)) {
    return Err(diag(
      "E0401",
      base.span,
      "receiver of mutating method `" + name.name + "` must be a mutable place (a `let` variable, field or element)"
    ));
  }
  const pi = checkPlace(env, a.fx, base)?;
  if (!pi.mutable) {
    return Err(diag(
      "E0401",
      base.span,
      "cannot call mutating method `" + name.name + "` on `" + pi.rootName + "`: it is not declared with `let`"
    ));
  }
  let fx = markMut(pi.fx, pi.place);
  if (fx.probe) {
    if (mi.hasRet) {
      return done(fx, XCall(mi.fid, noExprs()), f.srcRet, span);
    }
    return Ok(ExprOut { fx: fx, expr: nopExpr(span) });
  }
  if (!purePlace(pi.place)) {
    return Err(diag(
      "E0408",
      base.span,
      "the receiver of mutating method `" + name.name + "` must not contain index expressions with side effects"
    ));
  }
  const call = mk(XCall(mi.fid, all), f.ret, span);
  if (!mi.hasRet) {
    fx.pre.push(HAssign(pi.place, None, call));
    return Ok(ExprOut { fx: fx, expr: nopExpr(span) });
  }
  const tmpName = "$r" + fx.tmps.toString();
  fx.tmps += 1;
  const nl = newLocal(fx, tmpName, f.ret, false);
  fx = nl.fx;
  const tmp = mk(XLocal(nl.id), f.ret, span);
  fx.pre.push(HLet(nl.id, call));
  const selfTy = TyRecord(ci.rec);
  fx.pre.push(HAssign(pi.place, None, mk(XField(tmp, mi.retRec, 0), selfTy, span)));
  return done(fx, XField(tmp, mi.retRec, 1), f.srcRet, span);
}

// ---------------------------------------------------------------------------
// Closures and function values (beyond Orin-B, ADR-0011)
// ---------------------------------------------------------------------------

function capturedErr(span: Span, name: string): Diagnostic {
  return diag(
    "E0401",
    span,
    "cannot modify `" + name + "`: it is captured by a closure, and closures capture variables by value (a snapshot taken when the closure is created)"
  );
}

function dummyDecl(name: string, span: Span): FunctionDecl {
  const noTps: Ident[] = [];
  const noParams: Param[] = [];
  const noRet: Option<TypeExpr> = None;
  const noStmts: Stmt[] = [];
  return FunctionDecl {
    exported: false,
    name: Ident { name: name, span: span },
    typeParams: noTps,
    bounds: [],
    params: noParams,
    ret: noRet,
    body: Block { stmts: noStmts, span: span },
    contracts: [],
    span: span
  };
}

type LiftOut = { env: Env; fid: usize; };

// Registers the HIR of a lifted function (an arrow body or a function-value wrapper) in the
// environment, as function `fid` (FuncInfo.mode 6: its HIR is already checked).
function registerLifted(fx: FnCtx, env0: Env, fn: Function, ptys: Type[], span: Span): LiftOut {
  let e = env0;
  const lid = e.lifted.length;
  e.lifted.push(fn);
  const fid = e.funcs.length;
  let pl: Local[] = [];
  let k: usize = 0;
  while (k < fn.paramCount) {
    pl.push(fn.locals[k]);
    k += 1;
  }
  e.funcs.push(FuncInfo {
    unit: fx.unit,
    qname: fn.name,
    decl: dummyDecl(fn.name, span),
    params: ptys,
    paramLocals: pl,
    ret: fn.ret,
    tpNames: fx.tpNames,
    tpTys: fx.tpTys,
    depth: fx.depth,
    mode: 6,
    cls: lid,
    srcRet: TyVoid
  });
  return LiftOut { env: e, fid: fid };
}

// `fx` with its environment replaced (closure conversion adds records and functions).
function setEnv(fx: FnCtx, e: Env): FnCtx {
  let f = fx;
  f.env = e;
  return f;
}

// An arrow function: `expP` / `expR` are the parameter and result types of the expected function
// type, when known. The body is checked as a new function (closure conversion): its first parameter
// is the environment record holding the captured variables, which are bound to immutable locals
// at entry. The result is `XClosure(lifted, captures)`.
function checkArrow(
  env: Env, fx: FnCtx, span: Span, ps: ArrowParam[], retTE: Option<TypeExpr>, body: ArrowBody,
  expP: Option<Type[]>, expR: Option<Type>
): Result<ExprOut, Diagnostic> {
  let cur = fx;
  match (expP) {
    Some(eps) => {
      if (eps.length != ps.length) {
        return Err(diag(
          "E0404",
          span,
          "this function value is expected to take " + eps.length.toString() + " argument(s), the arrow function has "
            + ps.length.toString() + " parameter(s)"
        ));
      }
    },
    None => {}
  }
  let ptys: Type[] = [];
  let names: string[] = [];
  let i: usize = 0;
  for (const p of ps) {
    for (const n of names) {
      if (n == p.name.name) {
        return Err(diag("E0304", p.name.span, "duplicate parameter `" + p.name.name + "`"));
      }
    }
    let t: Type = TyInt;
    match (p.ty) {
      Some(te) => {
        const r = resolveFx(cur, te, false)?;
        cur = r.fx;
        t = r.ty;
        match (expP) {
          Some(eps) => {
            if (!typeEq(eps[i], t)) {
              return Err(mismatch(cur.env, p.span, eps[i], t));
            }
          },
          None => {}
        }
      },
      None => {
        match (expP) {
          Some(eps) => {
            t = eps[i];
          },
          None => {
            return Err(diag(
              "E0407",
              p.name.span,
              "cannot infer the type of parameter `" + p.name.name + "`; add a type annotation"
            ));
          }
        }
      }
    }
    ptys.push(t);
    names.push(p.name.name);
    i += 1;
  }
  let ret: Type = TyVoid;
  let known = false;
  match (retTE) {
    Some(te) => {
      const r = resolveFx(cur, te, true)?;
      cur = r.fx;
      ret = r.ty;
      known = true;
    },
    None => {
      match (expR) {
        Some(t) => {
          ret = t;
          known = true;
        },
        None => {}
      }
    }
  }
  const isBlock = match (body) {
    ABlock(_) => true,
    AExpr(_) => false
  };
  const lname = cur.qname + "$closure" + cur.ncl.toString();
  let inner = newClosureCtx(cur, lname, names, ptys, ret, !known && isBlock);
  let stmts: HStmt[] = [];
  let finalRet = ret;
  match (body) {
    AExpr(e) => {
      if (known && isVoid(ret)) {
        const so = stmtExpr(env, inner, e)?;
        inner = so.fx;
        stmts = [so.stmt];
      } else {
        const r = known ? expect(env, inner, e, ret)? : checkExpr(env, inner, e, None)?;
        inner = r.fx;
        if (isVoid(r.expr.ty)) {
          finalRet = TyVoid;
          stmts = isNop(r.expr) ? [] : [HExprStmt(r.expr)];
        } else {
          finalRet = r.expr.ty;
          stmts = [HReturn(Some(r.expr))];
        }
      }
      if (inner.pre.length > 0) {
        let all: HStmt[] = [];
        for (const h of inner.pre) {
          all.push(h);
        }
        for (const h of stmts) {
          all.push(h);
        }
        stmts = all;
        const none: HStmt[] = [];
        inner.pre = none;
      }
    },
    ABlock(b) => {
      const bo = checkBlock(env, inner, b)?;
      inner = bo.fx;
      stmts = bo.block.stmts;
      if (!known) {
        finalRet = inner.retSeen.unwrapOr(TyVoid);
      }
      if (!isVoid(finalRet) && !bo.div) {
        return Err(diag("E0403", span, "the closure does not return a value on every path"));
      }
    }
  }
  // Environment record, entry prologue, lifted function.
  let e = inner.env;
  const rid = e.records.length;
  let fields: FieldDef[] = [];
  let k: usize = 0;
  while (k < inner.capNames.length) {
    fields.push(FieldDef { name: inner.capNames[k], ty: inner.capTys[k] });
    k += 1;
  }
  e.records.push(RecordDef { name: lname + "$env", fields: fields });
  const envTy = TyRecord(rid);
  let all: HStmt[] = [];
  k = 0;
  while (k < inner.capNames.length) {
    const base = mk(XLocal(0), envTy, span);
    all.push(HLet(inner.capIds[k], mk(XField(base, rid, k), inner.capTys[k], span)));
    k += 1;
  }
  for (const h of stmts) {
    all.push(h);
  }
  let locals = inner.locals;
  locals[0] = Local { name: "env$", ty: envTy, mutable: false };
  const fn = Function {
    name: lname,
    paramCount: 1 + ps.length,
    locals: locals,
    ret: finalRet,
    body: HBlock { stmts: all },
    span: span
  };
  let pfull: Type[] = [envTy];
  for (const t of ptys) {
    pfull.push(t);
  }
  const lo = registerLifted(inner, e, fn, pfull, span);
  // Back in the enclosing function: evaluate the captured variables there.
  let out = setEnv(cur, lo.env);
  out.ncl += 1;
  let caps: HExpr[] = [];
  for (const nm of inner.capNames) {
    const v = lookupVar(out, nm);
    out = v.fx;
    const id = v.id.unwrap();
    caps.push(mk(XLocal(id), out.locals[id].ty, span));
  }
  return done(out, XClosure(lo.fid, caps), TyFn(ptys, finalRet), span);
}

// The lifted wrapper `f$closure(env, a, ..) { return f(a, ..); }` of function `fid`, so that the
// function can be used as a value. Created once per function.
function wrapFunc(fx: FnCtx, span: Span, fid: usize): Result<ExprOut, Diagnostic> {
  const f = fx.env.funcs[fid];
  if (f.mode != 0) {
    return Err(diag("E0400", span, "function `" + f.decl.name.name + "` cannot be used as a value"));
  }
  const wname = f.qname + "$closure";
  let wid: usize = 0;
  let found = false;
  let k: usize = 0;
  while (k < fx.env.funcs.length && !found) {
    if (fx.env.funcs[k].mode == 6 && fx.env.funcs[k].qname == wname) {
      wid = k;
      found = true;
    }
    k += 1;
  }
  let cur = fx;
  if (!found) {
    let e = cur.env;
    const rid = e.records.length;
    const none: FieldDef[] = [];
    e.records.push(RecordDef { name: wname + "$env", fields: none });
    const envTy = TyRecord(rid);
    let locals: Local[] = [Local { name: "env$", ty: envTy, mutable: false }];
    let args: HExpr[] = [];
    let pfull: Type[] = [envTy];
    let i: usize = 0;
    while (i < f.params.length) {
      locals.push(Local { name: "a" + i.toString(), ty: f.params[i], mutable: false });
      args.push(mk(XLocal(i + 1), f.params[i], span));
      pfull.push(f.params[i]);
      i += 1;
    }
    const call = mk(XCall(fid, args), f.ret, span);
    const st: HStmt = isVoid(f.ret) ? HExprStmt(call) : HReturn(Some(call));
    const fn = Function {
      name: wname,
      paramCount: 1 + f.params.length,
      locals: locals,
      ret: f.ret,
      body: HBlock { stmts: [st] },
      span: span
    };
    const lo = registerLifted(cur, e, fn, pfull, span);
    cur = setEnv(cur, lo.env);
    wid = lo.fid;
  }
  const noCaps: HExpr[] = [];
  return done(cur, XClosure(wid, noCaps), TyFn(f.params, f.ret), span);
}

// A top-level function used as a value. A generic function needs its type arguments from the
// expected function type: `expP` / `expR` (parameter types, and the result type when known).
function funcValue(
  env: Env, fx: FnCtx, span: Span, ent: ValEnt, id: Ident, expP: Option<Type[]>, expR: Option<Type>
): Result<ExprOut, Diagnostic> {
  return match (ent) {
    VFunc(fid) => wrapFunc(fx, span, fid),
    VGFunc(g) => {
      const gf = env.gfuncs[g];
      const tp = paramNameList(gf.decl.typeParams);
      let binds = noBinds(tp.length);
      match (expP) {
        Some(eps) => {
          if (eps.length != gf.decl.params.length) {
            return Err(diag(
              "E0404",
              span,
              "function `" + id.name + "` takes " + gf.decl.params.length.toString() + " argument(s), the expected function type has "
                + eps.length.toString()
            ));
          }
          let i: usize = 0;
          while (i < eps.length) {
            binds = unify(fx.env, gf.unit, gf.decl.params[i].ty, eps[i], tp, binds);
            i += 1;
          }
        },
        None => {}
      }
      match (expR) {
        Some(er) => {
          match (gf.decl.ret) {
            Some(rt) => {
              binds = unify(fx.env, gf.unit, rt, er, tp, binds);
            },
            None => {}
          }
        },
        None => {}
      }
      let tys: Type[] = [];
      let bi: usize = 0;
      for (const b of binds) {
        match (b) {
          Some(t) => {
            tys.push(t);
          },
          None => {
            return Err(diag(
              "E0407",
              span,
              "cannot infer type argument `" + tp[bi] + "` of function `" + id.name
                + "` used as a value; its type arguments come from the expected function type, add a type annotation"
            ));
          }
        }
        bi += 1;
      }
      let cur = fx;
      let ptys: Type[] = [];
      for (const p of gf.decl.params) {
        const r = resolveBound(cur, gf.unit, tp, tys, p.ty, false)?;
        cur = r.fx;
        ptys.push(r.ty);
      }
      let ret: Type = TyVoid;
      match (gf.decl.ret) {
        Some(rte) => {
          const r = resolveBound(cur, gf.unit, tp, tys, rte, true)?;
          cur = r.fx;
          ret = r.ty;
        },
        None => {}
      }
      match (checkBounds(cur.env, gf.unit, gf.decl, tys, span)) {
        Some(d) => { return Err(d); },
        None => {}
      }
      if (cur.abs) {
        const noCaps: HExpr[] = [];
        return done(cur, XClosure(0, noCaps), TyFn(ptys, ret), span);
      }
      const fo = instFunc(cur.env, g, tys, cur.depth + 1, span)?;
      cur = withEnv(cur, fo.env);
      return wrapFunc(cur, span, fo.fid);
    },
    _ => Err(diag("E0400", span, "function `" + id.name + "` cannot be used as a value"))
  };
}

function recordHasFnField(env: Env, r: usize, name: string): bool {
  const io = fieldIndex(env.records[r].fields, name);
  if (io.isNone()) {
    return false;
  }
  return isFn(env.records[r].fields[io.unwrap()].ty);
}

// `r.f(args)` where field `f` of record `r` has a function type.
function callFieldValue(
  env: Env, b: ExprOut, span: Span, r: usize, name: Ident, args: Expr[]
): Result<ExprOut, Diagnostic> {
  const def = b.fx.env.records[r];
  const i = fieldIndex(def.fields, name.name).unwrap();
  checkFieldAccess(b.fx, r, name)?;
  const callee = mk(XField(b.expr, r, i), def.fields[i].ty, span);
  return match (def.fields[i].ty) {
    TyFn(ps, ret) => {
      const a = argsExpect(env, b.fx, span, "function value `" + name.name + "`", args, ps)?;
      return done(a.fx, XCallIndirect(callee, a.args), ret, span);
    },
    _ => Err(diag("E0400", span, "`" + name.name + "` is not a function"))
  };
}

// ---------------------------------------------------------------------------
// Array API (spec 08): methods implemented as functions of the injected prelude
// (array/array.or, unit `$array/array`), called with the receiver as first argument.
// ---------------------------------------------------------------------------

function isArrayApi(n: string): bool {
  return n == "map" || n == "filter" || n == "find" || n == "findIndex" || n == "some" || n == "every"
    || n == "reduce" || n == "forEach" || n == "sort" || n == "indexOf" || n == "includes";
}

function elemSuffix(elem: Type): string {
  return match (elem) {
    TyInt => "Int",
    TyUsize => "Usize",
    TyBool => "Bool",
    TyString => "Str",
    _ => ""
  };
}

function arrayApiCall(
  env: Env, b: ExprOut, span: Span, elem: Type, name: Ident, args: Expr[], exp: Option<Type>
): Result<ExprOut, Diagnostic> {
  const n = name.name;
  let fname = n;
  if (n == "indexOf" || n == "includes") {
    const suffix = elemSuffix(elem);
    if (suffix == "") {
      return Err(diag(
        "E0405",
        name.span,
        "method `" + n + "` is only available on arrays of `int`, `usize`, `bool` or `string`, not `"
          + showType(b.fx.env, TyArray(elem)) + "`"
      ));
    }
    fname = n + suffix;
  }
  const noMethod = diag("E0405", name.span, "no method `" + n + "` on type `" + showType(b.fx.env, TyArray(elem)) + "`");
  if (env.prelude < 0) {
    return Err(noMethod);
  }
  return preludeCall(env, b, span, env.prelude.toUsize(), fname, n, noMethod, args, noPre(args.length), exp);
}

function noPre(n: usize): Option<HExpr>[] {
  let out: Option<HExpr>[] = [];
  let i: usize = 0;
  while (i < n) {
    out.push(None);
    i += 1;
  }
  return out;
}

// Call of the prelude function `fname` of unit `unit` with the checked receiver `b` as first argument and
// `args` as the others (`argPre[i]` may hold an already checked argument). Generic functions get their type
// arguments inferred; non-generic ones are called directly.
function preludeCall(
  env: Env, b: ExprOut, span: Span, unit: usize, fname: string, n: string, noMethod: Diagnostic,
  args: Expr[], argPre: Option<HExpr>[], exp: Option<Type>
): Result<ExprOut, Diagnostic> {
  const ent = findVal(env.units[unit].scope, fname);
  if (ent.isNone()) {
    return Err(noMethod);
  }
  return match (ent.unwrap()) {
    VGFunc(g) => {
      const gf = env.gfuncs[g];
      if (args.length + 1 != gf.decl.params.length) {
        return Err(diag(
          "E0404",
          span,
          "method `" + n + "` expects " + (gf.decl.params.length - 1).toString() + " argument(s), found " + args.length.toString()
        ));
      }
      let ptes: TypeExpr[] = [];
      for (const p of gf.decl.params) {
        ptes.push(p.ty);
      }
      // The receiver is argument 0 (already checked; its source expression is not used).
      let all: Expr[] = [Expr { kind: EIdent(Ident { name: n, span: span }), span: b.expr.span }];
      let pre: Option<HExpr>[] = [Some(b.expr)];
      let ai: usize = 0;
      for (const a of args) {
        all.push(a);
        pre.push(argPre[ai]);
        ai += 1;
      }
      const noExplicit: Option<TypeExpr[]> = None;
      const io = inferPre(
        env, b.fx, span, "method `" + n + "`", gf.unit, gf.decl.typeParams, ptes, gf.decl.ret, all, exp,
        noExplicit, pre
      )?;
      let cur = io.fx;
      let ret: Type = TyVoid;
      match (gf.decl.ret) {
        Some(rte) => {
          const r = resolveBound(cur, gf.unit, paramNameList(gf.decl.typeParams), io.tys, rte, true)?;
          cur = r.fx;
          ret = r.ty;
        },
        None => {}
      }
      let fid: usize = 0;
      if (!cur.abs) {
        const fo = instFunc(cur.env, g, io.tys, cur.depth + 1, span)?;
        cur = withEnv(cur, fo.env);
        fid = fo.fid;
      }
      return done(cur, XCall(fid, io.args), ret, span);
    },
    VFunc(fid) => {
      const f = b.fx.env.funcs[fid];
      const a = argsExpect(env, b.fx, span, "method `" + n + "`", args, tailTypes(f.params))?;
      let all: HExpr[] = [b.expr];
      for (const x of a.args) {
        all.push(x);
      }
      return done(a.fx, XCall(fid, all), f.ret, span);
    },
    _ => Err(noMethod)
  };
}

// ---------------------------------------------------------------------------
// Map<K, V> (spec 08 std:map, ADR-0018): methods are functions of the Map prelude (array/map.or).
// ---------------------------------------------------------------------------

type FidFx = { fx: FnCtx; fid: usize; };

// Instance of the generic Map-prelude function `fname` at `tys` (a dummy id in an abstract check).
function mapFunc(fx: FnCtx, span: Span, fname: string, tys: Type[]): Result<FidFx, Diagnostic> {
  if (fx.abs) {
    return Ok(FidFx { fx: fx, fid: 0 });
  }
  const ent = findVal(fx.env.units[fx.env.mapUnit.toUsize()].scope, fname);
  if (ent.isSome()) {
    match (ent.unwrap()) {
      VGFunc(g) => {
        const fo = instFunc(fx.env, g, tys, fx.depth + 1, span)?;
        return Ok(FidFx { fx: withEnv(fx, fo.env), fid: fo.fid });
      },
      _ => {}
    }
  }
  return Err(diag("E0405", span, "internal error: the Map prelude has no function `" + fname + "`"));
}

function mapKeyErr(env: Env, span: Span, kt: Type): Diagnostic {
  return diag("E0400", span, "`Map` keys must be `int`, `usize`, `bool` or `string`, found `" + showType(env, kt) + "`");
}

// `new Map<K, V>()`; the type arguments may be omitted when the expected type is a Map.
function newMap(
  env: Env, fx: FnCtx, span: Span, targs: TypeExpr[], args: Expr[], exp: Option<Type>
): Result<ExprOut, Diagnostic> {
  if (args.length != 0) {
    return Err(diag("E0404", span, "`new Map` takes no arguments, found " + args.length.toString()));
  }
  let cur = fx;
  let kt: Type = TyVoid;
  let vt: Type = TyVoid;
  if (targs.length == 2) {
    const k = resolveFx(cur, targs[0], false)?;
    cur = k.fx;
    kt = k.ty;
    const v = resolveFx(cur, targs[1], false)?;
    cur = v.fx;
    vt = v.ty;
  } else if (targs.length == 0) {
    let found = false;
    match (exp) {
      Some(t) => {
        const mo = mapOrigin(cur.env, t);
        if (mo.isSome()) {
          kt = mo.unwrap().args[0];
          vt = mo.unwrap().args[1];
          found = true;
        }
      },
      None => {}
    }
    if (!found) {
      return Err(diag(
        "E0407", span,
        "cannot infer the type arguments of `new Map()`; write `new Map<K, V>()` or add a type annotation"
      ));
    }
  } else {
    return Err(diag("E0400", span, "`Map` takes exactly two type arguments"));
  }
  if (!isMapKeyType(kt)) {
    return Err(mapKeyErr(cur.env, span, kt));
  }
  const gm = mapGenType(cur.env, "Map").unwrap();
  const inst = instType(cur.env, gm, [kt, vt], 0, span)?;
  cur = withEnv(cur, inst.env);
  const fo = mapFunc(cur, span, "mapNew", [kt, vt])?;
  return done(fo.fx, XCall(fo.fid, noExprs()), inst.ty, span);
}

function mapMethodCall(
  env: Env, b: ExprOut, span: Span, base: Expr, name: Ident, args: Expr[], exp: Option<Type>, inst: Inst
): Result<ExprOut, Diagnostic> {
  const n = name.name;
  const unit = b.fx.env.mapUnit.toUsize();
  const noMethod = diag("E0405", name.span, "no method `" + n + "` on type `" + showType(b.fx.env, b.expr.ty) + "`");
  let fname = "";
  if (n == "get") {
    fname = "mapGet";
  } else if (n == "has") {
    fname = "mapHas";
  } else if (n == "keys") {
    fname = "mapKeys";
  } else if (n == "values") {
    fname = "mapValues";
  } else if (n == "entries") {
    fname = "mapEntries";
  }
  if (fname != "") {
    return preludeCall(env, b, span, unit, fname, n, noMethod, args, noPre(args.length), exp);
  }
  if (n == "set" || n == "delete") {
    return mapMutCall(env, b, span, base, name, args, inst);
  }
  return Err(noMethod);
}

// `m.set(k, v)` / `m.delete(k)`: the receiver is a mutable place; the call becomes `m = mapSet(m, k, v)`
// (a statement hoisted before the current one, like mutating class methods, ADR-0009).
function mapMutCall(
  env: Env, b: ExprOut, span: Span, base: Expr, name: Ident, args: Expr[], inst: Inst
): Result<ExprOut, Diagnostic> {
  const n = name.name;
  const isSet = n == "set";
  const kt = inst.args[0];
  const vt = inst.args[1];
  const params: Type[] = isSet ? [kt, vt] : [kt];
  if (!isPlaceShaped(b.fx, base)) {
    return Err(diag(
      "E0401",
      base.span,
      "receiver of `" + n + "` must be a mutable place (a `let` variable, field or element)"
    ));
  }
  const pi = checkPlace(env, b.fx, base)?;
  if (!pi.mutable) {
    return Err(diag(
      "E0401",
      base.span,
      "cannot call `" + n + "` on `" + pi.rootName + "`: it is not declared with `let`"
    ));
  }
  const a = argsExpect(env, markMut(pi.fx, pi.place), span, "method `" + n + "`", args, params)?;
  let fx = a.fx;
  if (fx.probe) {
    if (isSet) {
      return Ok(ExprOut { fx: fx, expr: nopExpr(span) });
    }
    return done(fx, XBool(false), TyBool, span);
  }
  if (!purePlace(pi.place)) {
    return Err(diag(
      "E0408",
      base.span,
      "the receiver of `" + n + "` must not contain index expressions with side effects"
    ));
  }
  const mapTy = b.expr.ty;
  const kv: Type[] = [kt, vt];
  if (isSet) {
    const fo = mapFunc(fx, span, "mapSet", kv)?;
    fx = fo.fx;
    const call = mk(XCall(fo.fid, [b.expr, a.args[0], a.args[1]]), mapTy, span);
    fx.pre.push(HAssign(pi.place, None, call));
    return Ok(ExprOut { fx: fx, expr: nopExpr(span) });
  }
  // delete: the key is evaluated once into a temporary; the result is `has` taken before the removal.
  const hasF = mapFunc(fx, span, "mapHas", kv)?;
  const delF = mapFunc(hasF.fx, span, "mapDelete", kv)?;
  fx = delF.fx;
  const kl = newLocal(fx, "$k" + fx.tmps.toString(), kt, false);
  fx = kl.fx;
  fx.tmps += 1;
  const rl = newLocal(fx, "$r" + fx.tmps.toString(), TyBool, false);
  fx = rl.fx;
  fx.tmps += 1;
  const kx = mk(XLocal(kl.id), kt, span);
  fx.pre.push(HLet(kl.id, a.args[0]));
  fx.pre.push(HLet(rl.id, mk(XCall(hasF.fid, [b.expr, kx]), TyBool, span)));
  fx.pre.push(HAssign(pi.place, None, mk(XCall(delF.fid, [b.expr, kx]), mapTy, span)));
  return done(fx, XLocal(rl.id), TyBool, span);
}
