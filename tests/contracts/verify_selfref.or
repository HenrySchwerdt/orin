// Inputs for tools/test_verify_contracts.py (orin verify --contracts). Expected statuses are in the
// `// expect:` lines: `function kind status`.
// A contract that calls its own function (directly or through another function) used to unfold forever and crash the
// verifier (stack overflow in the instantiation of the callee's @Ensures). The inner call is now an uninterpreted
// application with no facts, so the clause cannot be proved (UNKNOWN, never a counterexample), the other clauses of
// the function and its callers are unaffected.
// expect: joinLike ensures VERIFIED
// expect: joinLike ensures UNKNOWN
// expect: joinLike ensures VERIFIED
// expect: useJoinLike ensures VERIFIED
// expect: useJoinLike call-precondition VERIFIED
// expect: ping ensures UNKNOWN
// expect: pong ensures UNKNOWN

@Requires(a >= 0 && b >= 0)
@Ensures(result >= 0)
@Ensures(result == joinLike(b, a))
@Ensures(result >= a && result >= b)
function joinLike(a: int, b: int): int {
  if (a < b) {
    return b;
  }
  return a;
}

@Requires(x >= 0 && y >= 0)
@Ensures(result >= 0)
function useJoinLike(x: int, y: int): int {
  return joinLike(x, y);
}

@Ensures(result == pong(n))
function ping(n: int): int {
  return n;
}

@Ensures(result == ping(n))
function pong(n: int): int {
  return n;
}

function main(): void {}
