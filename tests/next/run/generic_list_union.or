type List<T> = Nil | Cons(T, List<T>);

function length<T>(xs: List<T>): int {
  return match (xs) {
    Nil => 0,
    Cons(_, rest) => 1 + length(rest),
  };
}

function toArray<T>(xs: List<T>): T[] {
  return match (xs) {
    Nil => [],
    Cons(h, t) => [h].concat(toArray(t)),
  };
}

function fromArray<T>(xs: T[]): List<T> {
  let out: List<T> = Nil;
  let i = xs.length;
  while (i > 0) {
    i -= 1;
    out = Cons(xs[i], out);
  }
  return out;
}

function append<T>(a: List<T>, b: List<T>): List<T> {
  return match (a) {
    Nil => b,
    Cons(h, t) => Cons(h, append(t, b)),
  };
}

function main(): void {
  const a = fromArray([1, 2, 3]);
  const b = fromArray([4, 5]);
  const c = append(a, b);
  console.log(length(c).toString());
  console.log(toArray(c).length.toString());
  console.log(toArray(fromArray(["x", "y"])).join(""));
  const n: List<string> = Nil;
  console.log(length(n).toString());
  console.log(length(Cons(1, Nil)).toString());
}
