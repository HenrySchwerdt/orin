// flags: --strict-contracts
// warns: W0470 W0471 W0471 W0471
// Strict contract coverage (ADR-0028, opt-in): a class with state and no @Invariant (W0470) and public
// methods that mutate `this` without an @Ensures (W0471), also through a call of another mutating method
// and through `push`.
import { exit } from "std:process";

class Bare {
  v: int = 0;
  items: int[] = [];

  bump(): void {
    this.v += 1;
  }

  twice(): void {
    this.bump();
    this.bump();
  }

  add(x: int): void {
    this.items.push(x);
  }

  // negatives: private, read-only, and with an @Ensures
  private hidden(): void {
    this.v += 1;
  }

  peek(): int {
    return this.v;
  }

  @Ensures(this.v == old(this.v) + 2)
  bumpTwice(): void {
    this.v += 2;
  }
}

@Invariant(this.v >= 0)
class Covered {
  v: int = 0;

  @Ensures(this.v == old(this.v) + 1)
  bump(): void {
    this.v += 1;
  }
}

// stateless class: nothing to say
class Empty {
  hello(): int {
    return 1;
  }
}

function main(): void {
  let b = new Bare();
  b.bump();
  b.twice();
  b.add(1);
  b.bumpTwice();
  let c = new Covered();
  c.bump();
  console.log((b.peek() + c.v + new Empty().hello()).toString());
  exit(0);
}
