// A static route table generated from `@Route` annotations on methods.
import { routeTable, matchRoute } from "./handlers.gen";

function main(): void {
  for (const line of routeTable()) {
    console.log(line);
  }
  console.log(matchRoute("GET", "/users/7"));
  console.log(matchRoute("POST", "/users"));
  console.log(matchRoute("GET", "/users/7/posts/3"));
  console.log("[" + matchRoute("DELETE", "/users/7") + "]");
  console.log("[" + matchRoute("GET", "/nope") + "]");
}
