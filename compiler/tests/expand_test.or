// Unit tests of compiler/meta and compiler/expand (ADR-0046 S4): the companion placeholders of the loader, snapshot
// extraction, the conversion of a recorded Output into syntax trees, hygiene and the note on generated code.
// Run: `orin test compiler/tests/expand_test.or`. The loader is driven through the overlay with virtual paths below /virt.

import { Host, useFs } from "std:host";
import { assert, assertEqString, assertEqUsize, assertEqBool } from "std:test";
import { SourceFile, SourceMap, Diagnostic, span, diag, render } from "../diag";
import { loadWithOverlay, LoadOutcome, LoadedProgram } from "../loader";
import { Item } from "../syntax";
import { findRuns, buildSnapshot, outputItems, hygieneDiags, RunItems, boundNames, isUserUnit } from "../meta";
import { sidecarPath, noteGenerated, Cause } from "../expand";

function file(path: string, text: string): SourceFile {
  return SourceFile { path: path, text: text };
}

function userUnits(o: LoadOutcome): string {
  return match (o.program) {
    Some(p) => p.units.filter(u => !u.name.startsWith("$")).map(u => u.name).join(" "),
    None => "failed",
  };
}

function firstDiag(o: LoadOutcome): string {
  return o.diags.length == 0 ? "" : render(o.sm, o.diags[0]);
}

const ANNOS: string = "@Annotation(type, function)\nexport type Json = { };\n@Annotation(field)\nexport type Name = { value: string; limit: Option<int>; };\n";

const MODELS: string = "import { Json, Name } from \"./annos\";\n\n/** A user. */\n@Json\nexport type User = { id: int; @Name(\"n\") name: string; tags: string[]; };\n";

function emptySpanProgram(): LoadedProgram {
  return LoadedProgram { units: [], entry: 0, manifest: None };
}

// ---- loader: companion placeholders ----------------------------------------------------------------------------

@Test
function companionIsAPlaceholderRightAfterItsSource(host: Host): void {
  useFs(
    host,
    fs => {
      const o = loadWithOverlay(
        fs,
        "/virt/main.or",
        [
          file("/virt/main.or", "import { f } from \"./models.gen\";\nimport { u } from \"./models\";\n"),
          file("/virt/annos.or", ANNOS),
          file("/virt/models.or", MODELS),
        ],
      );
      assertEqUsize(o.diags.length, 0, "no diagnostics");
      assertEqString(userUnits(o), "annos models models.gen main", "the placeholder follows the source module");
      const p = o.program.unwrap();
      const gen = p.units[p.units.length - 2];
      assertEqString(gen.path, "/virt/models.gen", "virtual path: .gen instead of .or");
      assertEqUsize(gen.ast.items.length, 0, "no items yet");
      assertEqUsize(gen.imports.length, 0, "no imports yet");
      assertEqString(o.sm.files[gen.file].text, "", "no source text");
    },
  );
}

@Test
function companionOfAnUnknownModule(host: Host): void {
  useFs(
    host,
    fs => {
      const o = loadWithOverlay(fs, "/virt/main.or", [file("/virt/main.or", "import { f } from \"./nope.gen\";\n")]);
      assertEqString(
        firstDiag(o),
        "/virt/main.or:1:19: error[E0301]: cannot find module `./nope` (tried `/virt/nope.or` and `/virt/nope/module.or`)",
        "the source module must exist",
      );
    },
  );
}

@Test
function companionImportedByItsSourceIsACycle(host: Host): void {
  useFs(
    host,
    fs => {
      const o = loadWithOverlay(
        fs,
        "/virt/main.or",
        [
          file("/virt/main.or", "import { a } from \"./a\";\n"),
          file("/virt/a.or", "import { b } from \"./b\";\nexport const a = 1;\n"),
          file("/virt/b.or", "import { x } from \"./a.gen\";\nexport const b = 2;\n"),
        ],
      );
      const d = firstDiag(o);
      assert(d.includes("error[E0521]: generated module `./a.gen` is imported while its source module is still being loaded: a -> b -> a.gen"), d);
    },
  );
}

@Test
function companionShared(host: Host): void {
  useFs(
    host,
    fs => {
      const o = loadWithOverlay(
        fs,
        "/virt/main.or",
        [
          file("/virt/main.or", "import { x } from \"./m.gen\";\nimport { y } from \"./b\";\n"),
          file("/virt/b.or", "import { x } from \"./m.gen\";\nexport const y = 1;\n"),
          file("/virt/m.or", "export const m = 1;\n"),
        ],
      );
      assertEqUsize(o.diags.length, 0, "no diagnostics");
      assertEqString(userUnits(o), "m m.gen b main", "one placeholder for both importers");
    },
  );
}

@Test
function sidecarNames(): void {
  assertEqString(sidecarPath("a/models.or", "Json"), "a/models.gen.Json.json", "file module");
  assertEqString(sidecarPath("a/module.or", "Route"), "a/module.gen.Route.json", "directory module");
}

// ---- snapshot ------------------------------------------------------------------------------------------------------

@Test
function snapshotOfAModule(host: Host): void {
  useFs(
    host,
    fs => {
      const o = loadWithOverlay(
        fs,
        "/virt/main.or",
        [
          file("/virt/main.or", "import { User } from \"./models\";\n"),
          file("/virt/annos.or", ANNOS),
          file("/virt/models.or", MODELS),
        ],
      );
      assertEqUsize(o.diags.length, 0, "no diagnostics");
      const p = o.program.unwrap();
      let mi: usize = 0;
      while (p.units[mi].name != "models") {
        mi += 1;
      }
      assertBool(isUserUnit(p, mi), "models is a user unit");
      const runs = findRuns(p, mi);
      assertEqUsize(runs.length, 2, "Json on the type, Name on a field");
      assertEqString(runs[0].annoName, "Json", "first use first");
      assertEqString(runs[1].annoName, "Name", "second annotation");
      assertEqUsize(runs[1].items.length, 1, "the declaration that holds the annotated field");
      const s = buildSnapshot(p, o.sm, runs[0], 7000);
      assert(s.isOk(), "snapshot builds");
      const t = s.unwrap().text;
      assert(t.startsWith("{\"format\":\"orin.meta.input\",\"version\":1,\"modulePath\":\"./models\",\"annotation\":\"Json\",\"freshBase\":7000,"), t);
      assert(t.includes("\"doc\":\"A user.\""), "doc comment: " + t);
      assert(t.includes("{\"source\":\"./annos\",\"name\":\"Name\",\"args\":[{\"name\":\"value\",\"value\":{\"k\":\"string\",\"v\":\"n\"}},{\"name\":\"limit\",\"value\":{\"k\":\"none\"}}]}"), "omitted Option is none: " + t);
      assertEqUsize(s.unwrap().refs.length, 4, "declaration, three fields");
      assertEqString(
        o.sm.files[s.unwrap().refs[0].file].text.substring(s.unwrap().refs[0].start, s.unwrap().refs[0].end),
        "User",
        "ref 0 is the name of the declaration",
      );
      assertEqString(
        o.sm.files[s.unwrap().refs[2].file].text.substring(s.unwrap().refs[2].start, s.unwrap().refs[2].end),
        "name",
        "ref 2 is the field",
      );
    },
  );
}

function assertBool(b: bool, msg: string): void {
  assert(b, msg);
}

// ---- recorded outputs -> syntax trees -------------------------------------------------------------------------

const HEAD: string = "{\"format\":\"orin.meta.output\",\"version\":1,";

function decl(kind: string, body: string): string {
  return "{\"k\":\"" + kind + "\",\"decl\":" + body + "}";
}

function fnDecl(name: string, body: string): string {
  return fnDeclX(name, body, true);
}

function fnDeclX(name: string, body: string, exported: bool): string {
  return "{\"name\":\"" + name + "\",\"exported\":" + (exported ? "true" : "false") + ",\"typeParams\":[],\"params\":[],\"returns\":{\"k\":\"named\",\"name\":\"int\",\"args\":[]},\"body\":[" + body + "],\"doc\":\"\"}";
}

function errOf(text: string): string {
  const r = outputItems(text, span(0, 0, 2));
  return r.isErr() ? r.unwrapErr() : "ok";
}

@Test
function outputConversion(): void {
  const ok = outputItems(
    HEAD + "\"imports\":[{\"names\":[\"a\"],\"source\":\"./x\"}],\"decls\":[" + decl("fn", fnDecl("f", "{\"k\":\"return\",\"value\":{\"k\":\"int\",\"v\":-5}}"))
        + "],\"diagnostics\":[{\"severity\":\"warning\",\"message\":\"w\",\"at\":3}]}",
    span(0, 4, 9),
  );
  assert(ok.isOk(), "decodes");
  assertEqUsize(ok.unwrap().items.length, 1, "one declaration");
  assertEqUsize(ok.unwrap().imports.length, 1, "one import");
  assertEqString(ok.unwrap().imports[0].path, "./x", "import source");
  assertEqUsize(ok.unwrap().diags.length, 1, "one diagnostic");
  assertEqBool(ok.unwrap().diags[0].error, false, "a warning");
  assert(ok.unwrap().diags[0].at == 3, "ref");
  assertEqUsize(ok.unwrap().docs.length, 1, "docs parallel to items");
}

@Test
function outputErrors(): void {
  assert(errOf("nope").startsWith("invalid JSON: "), "not json: " + errOf("nope"));
  assertEqString(errOf("{\"format\":\"x\",\"version\":1}"), "format: expected \"orin.meta.output\", found \"x\"", "format");
  assertEqString(errOf("{\"format\":\"orin.meta.output\",\"version\":3}"), "version: unsupported 3 (this compiler reads 1)", "version");
  assertEqString(errOf(HEAD + "\"decls\":[],\"diagnostics\":[]}"), "missing key `imports`", "missing key");
  assertEqString(
    errOf(HEAD + "\"imports\":[],\"decls\":[{\"k\":\"zip\",\"decl\":{}}],\"diagnostics\":[]}"),
    ".decls[0]: unknown declaration kind \"zip\"",
    "unknown declaration kind",
  );
  assertEqString(
    errOf(HEAD + "\"imports\":[],\"decls\":[" + decl("fn", fnDecl("f", "{\"k\":\"expr\",\"expr\":{\"k\":\"bogus\"}}")) + "],\"diagnostics\":[]}"),
    ".decls[0].decl.body[0].expr: unknown expression kind \"bogus\"",
    "path of a nested value",
  );
  assertEqString(
    errOf(HEAD + "\"imports\":[],\"decls\":[" + decl("fn", fnDecl("f", "{\"k\":\"expr\",\"expr\":{\"k\":\"binary\",\"op\":\"<<\",\"left\":{\"k\":\"int\",\"v\":1},\"right\":{\"k\":\"int\",\"v\":1}}}")) + "],\"diagnostics\":[]}"),
    ".decls[0].decl.body[0].expr.op: the bit operators are not supported in generated code",
    "bit operators",
  );
  assert(
    errOf(HEAD + "\"imports\":[],\"decls\":[" + decl("fn", fnDecl("while", "")) + "],\"diagnostics\":[]}").includes("`while` is not an identifier"),
    "keyword as a name",
  );
  assertEqString(
    errOf(HEAD + "\"imports\":[],\"decls\":[" + decl("fn", fnDecl("__g10000_tmp", "")) + "],\"diagnostics\":[]}"),
    "ok",
    "generated names are identifiers",
  );
}

// ---- hygiene -------------------------------------------------------------------------------------------------------

function itemsOf(names: string[], exported: bool): Item[] {
  let body = "";
  for (const n of names) {
    body += (body == "" ? "" : ",") + decl("fn", fnDeclX(n, "", exported));
  }
  return outputItems(HEAD + "\"imports\":[],\"decls\":[" + body + "],\"diagnostics\":[]}", span(0, 0, 2)).unwrap().items;
}

@Test
function hygieneNames(): void {
  const a = RunItems { label: "`@A` on `X`", cause: span(0, 1, 3), items: itemsOf(["f", "g"], true) };
  const b = RunItems { label: "`@B` on `X`", cause: span(0, 5, 7), items: itemsOf(["g", "h"], true) };
  const c = RunItems { label: "`@C` on `X`", cause: span(0, 9, 11), items: itemsOf(["f"], false) };
  assertEqUsize(hygieneDiags("./m.gen", [a]).length, 0, "a run alone");
  const ds = hygieneDiags("./m.gen", [a, b]);
  assertEqUsize(ds.length, 1, "g is exported twice");
  assertEqString(ds[0].code, "E0449", "code");
  assertEqUsize(ds[0].span.start, 5, "at the later annotation use");
  assertEqUsize(hygieneDiags("./m.gen", [a, c]).length, 1, "exported and private");
  const priv = RunItems { label: "`@D` on `X`", cause: span(0, 9, 11), items: itemsOf(["f"], false) };
  assertEqUsize(hygieneDiags("./m.gen", [priv, c]).length, 0, "two private names are the checker's business (E0304)");
  assertEqUsize(boundNames(itemsOf(["f"], true)[0]).length, 1, "a function binds its name");
}

// ---- notes on generated code -------------------------------------------------------------------------------------------

@Test
function noteOnlyAtTheCause(): void {
  const causes = [Cause { span: span(0, 4, 9), note: "generated" }];
  const ds = noteGenerated(causes, [diag("E0400", span(0, 4, 9), "m1"), diag("E0400", span(0, 4, 8), "m2")]);
  assertEqUsize(ds[0].notes.length, 1, "a diagnostic at the annotation use gets the note");
  assertEqString(ds[0].notes[0], "generated", "the note");
  assertEqUsize(ds[1].notes.length, 0, "any other does not");
  assertEqUsize(noteGenerated([], [diag("E0400", span(0, 4, 9), "m1")])[0].notes.length, 0, "no causes, no notes");
}
