export function embeddedArrayFiles(): SourceFile[] {
  let out: SourceFile[] = [];
  out.push(SourceFile { path: "$array/array.or", text: "// Array API prelude (spec 08, ADR-0011): the non-mutating array methods, written in Orin.\n//\n// This file is a prelude root (`$array`, spec 19 R1 mechanism: compiler/loader/prelude.or; embedded by\n// tools/embed_prelude.py) loaded with every program as unit `$array/array`. Its names are not in scope\n// of user code (nothing imports them): the\n// checker rewrites `xs.map(f)` to a call of the generic function `map` below with the receiver as\n// first argument. Generic functions are checked once abstractly and instantiated per use, so a\n// program that never calls an array method pays nothing but the (small) abstract check.\n//\n// Every function returns a new value; none mutates its arguments (value semantics, spec 03).\n\nexport function map<T, U>(xs: T[], f: (x: T) => U): U[] {\n  let out: U[] = [];\n  for (const x of xs) {\n    out.push(f(x));\n  }\n  return out;\n}\n\nexport function filter<T>(xs: T[], pred: (x: T) => bool): T[] {\n  let out: T[] = [];\n  for (const x of xs) {\n    if (pred(x)) {\n      out.push(x);\n    }\n  }\n  return out;\n}\n\nexport function find<T>(xs: T[], pred: (x: T) => bool): Option<T> {\n  for (const x of xs) {\n    if (pred(x)) {\n      return Some(x);\n    }\n  }\n  return None;\n}\n\nexport function findIndex<T>(xs: T[], pred: (x: T) => bool): Option<usize> {\n  let i: usize = 0;\n  for (const x of xs) {\n    if (pred(x)) {\n      return Some(i);\n    }\n    i += 1;\n  }\n  return None;\n}\n\nexport function some<T>(xs: T[], pred: (x: T) => bool): bool {\n  for (const x of xs) {\n    if (pred(x)) {\n      return true;\n    }\n  }\n  return false;\n}\n\nexport function every<T>(xs: T[], pred: (x: T) => bool): bool {\n  for (const x of xs) {\n    if (!pred(x)) {\n      return false;\n    }\n  }\n  return true;\n}\n\nexport function reduce<T, U>(xs: T[], f: (acc: U, x: T) => U, init: U): U {\n  let acc = init;\n  for (const x of xs) {\n    acc = f(acc, x);\n  }\n  return acc;\n}\n\nexport function forEach<T>(xs: T[], f: (x: T) => void): void {\n  for (const x of xs) {\n    f(x);\n  }\n}\n\n// Stable merge sort; `cmp(a, b)` is negative, zero or positive as `a` sorts before, with or after `b`.\nexport function sort<T>(xs: T[], cmp: (a: T, b: T) => int): T[] {\n  const n = xs.length;\n  if (n <= 1) {\n    return xs;\n  }\n  const mid = n / 2;\n  const left = sort(xs.slice(0, mid), cmp);\n  const right = sort(xs.slice(mid, n), cmp);\n  let out: T[] = [];\n  let i: usize = 0;\n  let j: usize = 0;\n  while (i < left.length && j < right.length) {\n    if (cmp(right[j], left[i]) < 0) {\n      out.push(right[j]);\n      j += 1;\n    } else {\n      out.push(left[i]);\n      i += 1;\n    }\n  }\n  while (i < left.length) {\n    out.push(left[i]);\n    i += 1;\n  }\n  while (j < right.length) {\n    out.push(right[j]);\n    j += 1;\n  }\n  return out;\n}\n\n// `indexOf` / `includes` need `==`, which a generic body cannot use, so they exist once per\n// element type that has equality; the checker picks the function from the receiver's element type.\nexport function indexOfInt(xs: int[], v: int): Option<usize> {\n  let i: usize = 0;\n  for (const x of xs) {\n    if (x == v) {\n      return Some(i);\n    }\n    i += 1;\n  }\n  return None;\n}\n\nexport function indexOfUsize(xs: usize[], v: usize): Option<usize> {\n  let i: usize = 0;\n  for (const x of xs) {\n    if (x == v) {\n      return Some(i);\n    }\n    i += 1;\n  }\n  return None;\n}\n\nexport function indexOfBool(xs: bool[], v: bool): Option<usize> {\n  let i: usize = 0;\n  for (const x of xs) {\n    if (x == v) {\n      return Some(i);\n    }\n    i += 1;\n  }\n  return None;\n}\n\nexport function indexOfStr(xs: string[], v: string): Option<usize> {\n  let i: usize = 0;\n  for (const x of xs) {\n    if (x == v) {\n      return Some(i);\n    }\n    i += 1;\n  }\n  return None;\n}\n\nexport function includesInt(xs: int[], v: int): bool {\n  return indexOfInt(xs, v).isSome();\n}\n\nexport function includesUsize(xs: usize[], v: usize): bool {\n  return indexOfUsize(xs, v).isSome();\n}\n\nexport function includesBool(xs: bool[], v: bool): bool {\n  return indexOfBool(xs, v).isSome();\n}\n\nexport function includesStr(xs: string[], v: string): bool {\n  return indexOfStr(xs, v).isSome();\n}\n" });
  out.push(SourceFile { path: "$array/map.or", text: "// Map<K, V> prelude (spec 08 std:map, ADR-0018): a value-semantics hash map written in Orin.\n//\n// This file is part of the `$array` prelude root (unit `$array/map`, always loaded; see library/collections/module.or).\n// User code never imports it: the checker maps the type names `Map` / `MapEntry` to the generic records\n// below, `new Map<K, V>()` to `mapNew`, and `m.get(k)` etc. to the functions below with the receiver as\n// first argument (check/body.or, mapMethodCall). Keys are `int`, `usize`, `bool` or `string` (validated by the\n// checker when the type is written, E0400).\n//\n// Representation (copy-on-write like every record/array): insertion-ordered entry arrays plus an\n// open-addressing index table of entry numbers with linear probing.\n//   _keys / _vals / _live   entry i: its key, value and whether it is still present (deleted entries stay\n//                           as tombstones until the next rebuild, so `_keys.length - size` entries are dead)\n//   _tab                    index table (length 0 or a power of two >= 8): entry number or -1 (empty);\n//                           the entry count (incl. dead ones) never exceeds half of its length\n//   size                    number of live entries\n// Mutating operations take the map and return the updated map (the caller assigns it back, ADR-0009 style\n// lowering `m = mapSet(m, k, v)`); with owned parameters (ADR-0010) a unique map is updated in place.\n// Expected O(1) get/has/set/delete; keys/values/entries O(n); a rebuild (growth, or compaction when more\n// than half of the entries are dead) is amortised O(1) per insertion.\n\nexport type Map<K, V> = {\n  size: usize;\n  _keys: K[];\n  _vals: V[];\n  _live: bool[];\n  _tab: int[];\n};\n\nexport type MapEntry<K, V> = { key: K; value: V; };\n\n// ---------------------------------------------------------------- key classes\n// `keyHash` / `keyEq` are placeholders: a generic body cannot compare or hash a `K`, so the checker\n// replaces an instance `keyHash<int>` by `hashInt`, `keyHash<string>` by `hashStr`, ... (check/types.or,\n// instFunc). The bodies below are only ever type-checked (abstractly), never run.\nexport function keyHash<K>(k: K): usize {\n  return 0;\n}\n\nexport function keyEq<K>(a: K, b: K): bool {\n  return false;\n}\n\n// Hashes are < 2^32 and never trap: all intermediate products stay below 2^64.\nexport function hashInt(k: int): usize {\n  let r = k % 2147483647;\n  if (r < 0) {\n    r += 2147483647;\n  }\n  return (r.toUsize() * 2654435761) % 4294967291;\n}\n\nexport function hashUsize(k: usize): usize {\n  return ((k % 2147483647) * 2654435761) % 4294967291;\n}\n\nexport function hashBool(k: bool): usize {\n  return k ? 1 : 0;\n}\n\nexport function hashStr(s: string): usize {\n  let h: usize = 5381;\n  const n = s.length;\n  let i: usize = 0;\n  while (i < n) {\n    h = (h * 131 + s.charCodeAt(i).toUsize()) % 1000000007;\n    i += 1;\n  }\n  return h;\n}\n\nexport function eqInt(a: int, b: int): bool {\n  return a == b;\n}\n\nexport function eqUsize(a: usize, b: usize): bool {\n  return a == b;\n}\n\nexport function eqBool(a: bool, b: bool): bool {\n  return a == b;\n}\n\nexport function eqStr(a: string, b: string): bool {\n  return a == b;\n}\n\n// ---------------------------------------------------------------- table\n// Entry number of the live entry with key `k`, or -1.\nfunction findEntry<K, V>(m: Map<K, V>, k: K): int {\n  const cap = m._tab.length;\n  if (cap == 0) {\n    return -1;\n  }\n  let i = keyHash(k) % cap;\n  while (true) {\n    const e = m._tab[i];\n    if (e < 0) {\n      return -1;\n    }\n    const u = e.toUsize();\n    if (m._live[u] && keyEq(m._keys[u], k)) {\n      return e;\n    }\n    i += 1;\n    if (i == cap) {\n      i = 0;\n    }\n  }\n  return -1;\n}\n\n// Index table of the live entries of `ks` / `live` with `cap` slots (a power of two, load <= 1/2).\nfunction buildTab<K>(ks: K[], live: bool[], cap: usize): int[] {\n  let tab: int[] = [];\n  let j: usize = 0;\n  while (j < cap) {\n    tab.push(-1);\n    j += 1;\n  }\n  let e: usize = 0;\n  while (e < ks.length) {\n    if (live[e]) {\n      let i = keyHash(ks[e]) % cap;\n      while (tab[i] >= 0) {\n        i += 1;\n        if (i == cap) {\n          i = 0;\n        }\n      }\n      tab[i] = e.toInt();\n    }\n    e += 1;\n  }\n  return tab;\n}\n\nfunction tabCapFor(entries: usize): usize {\n  let cap: usize = 8;\n  while (cap < entries * 4) {\n    cap = cap * 2;\n  }\n  return cap;\n}\n\n// The map with dead entries dropped (insertion order kept) and an index table sized for `extra` more\n// entries. Returns `m` itself (updated in place when unique) when there is nothing to compact.\nfunction rebuild<K, V>(m: Map<K, V>, extra: usize): Map<K, V> {\n  let r = m;\n  if (r._keys.length == r.size) {\n    r._tab = buildTab(r._keys, r._live, tabCapFor(r.size + extra));\n    return r;\n  }\n  let ks: K[] = [];\n  let vs: V[] = [];\n  let lv: bool[] = [];\n  let i: usize = 0;\n  while (i < r._keys.length) {\n    if (r._live[i]) {\n      ks.push(r._keys[i]);\n      vs.push(r._vals[i]);\n      lv.push(true);\n    }\n    i += 1;\n  }\n  const tab = buildTab(ks, lv, tabCapFor(ks.length + extra));\n  return Map { size: ks.length, _keys: ks, _vals: vs, _live: lv, _tab: tab };\n}\n\n// ---------------------------------------------------------------- API\nexport function mapNew<K, V>(): Map<K, V> {\n  return Map { size: 0, _keys: [], _vals: [], _live: [], _tab: [] };\n}\n\nexport function mapGet<K, V>(m: Map<K, V>, k: K): Option<V> {\n  const e = findEntry(m, k);\n  if (e < 0) {\n    return None;\n  }\n  return Some(m._vals[e.toUsize()]);\n}\n\nexport function mapHas<K, V>(m: Map<K, V>, k: K): bool {\n  return findEntry(m, k) >= 0;\n}\n\nexport function mapSet<K, V>(m: Map<K, V>, k: K, v: V): Map<K, V> {\n  let r = m;\n  const at = findEntry(r, k);\n  if (at >= 0) {\n    r._vals[at.toUsize()] = v;\n    return r;\n  }\n  if ((r._keys.length + 1) * 2 > r._tab.length) {\n    r = rebuild(r, 1);\n  }\n  const cap = r._tab.length;\n  let i = keyHash(k) % cap;\n  while (r._tab[i] >= 0) {\n    i += 1;\n    if (i == cap) {\n      i = 0;\n    }\n  }\n  r._tab[i] = r._keys.length.toInt();\n  r._keys.push(k);\n  r._vals.push(v);\n  r._live.push(true);\n  r.size += 1;\n  return r;\n}\n\nexport function mapDelete<K, V>(m: Map<K, V>, k: K): Map<K, V> {\n  let r = m;\n  const at = findEntry(r, k);\n  if (at < 0) {\n    return r;\n  }\n  r._live[at.toUsize()] = false;\n  r.size -= 1;\n  if (r._keys.length > 16 && r.size * 2 < r._keys.length) {\n    r = rebuild(r, 0);\n  }\n  return r;\n}\n\nexport function mapKeys<K, V>(m: Map<K, V>): K[] {\n  let out: K[] = [];\n  let i: usize = 0;\n  while (i < m._keys.length) {\n    if (m._live[i]) {\n      out.push(m._keys[i]);\n    }\n    i += 1;\n  }\n  return out;\n}\n\nexport function mapValues<K, V>(m: Map<K, V>): V[] {\n  let out: V[] = [];\n  let i: usize = 0;\n  while (i < m._keys.length) {\n    if (m._live[i]) {\n      out.push(m._vals[i]);\n    }\n    i += 1;\n  }\n  return out;\n}\n\nexport function mapEntries<K, V>(m: Map<K, V>): MapEntry<K, V>[] {\n  let out: MapEntry<K, V>[] = [];\n  let i: usize = 0;\n  while (i < m._keys.length) {\n    if (m._live[i]) {\n      out.push(MapEntry { key: m._keys[i], value: m._vals[i] });\n    }\n    i += 1;\n  }\n  return out;\n}\n" });
  out.push(SourceFile { path: "$array/math.or", text: "// std:math (spec 08, ADR-0018), written in Orin on top of the `float` methods (libm / LLVM intrinsics).\n//\n// `import { sqrt, PI } from \"std:math\";` resolves to this file (loader/loader.or, unit `$array/math`); the file is\n// part of the always-embedded `$array` prelude root but is only *loaded* when a program imports it.\n// All functions work on `float`. Edge cases are defined (IEEE-754):\n//   sqrt(x)      NaN for x < 0 and NaN; sqrt(-0.0) = -0.0; sqrt(Infinity) = Infinity\n//   abs(x)       |x|; abs(-0.0) = 0.0; abs(NaN) = NaN\n//   min / max    NaN if either argument is NaN; min(-0.0, 0.0) = -0.0, max(-0.0, 0.0) = 0.0\n//   pow(x, y)    C `pow` (pow(1.0, NaN) = 1.0, pow(x, 0.0) = 1.0)\n//   floor/ceil   results stay floats (use `.toInt()` for an integer); round is half away from zero\n\nexport const PI: float = 3.141592653589793;\nexport const E: float = 2.718281828459045;\n\nexport function sqrt(x: float): float {\n  return x.sqrt();\n}\n\nexport function abs(x: float): float {\n  return x.abs();\n}\n\nexport function floor(x: float): float {\n  return x.floor();\n}\n\nexport function ceil(x: float): float {\n  return x.ceil();\n}\n\nexport function round(x: float): float {\n  return x.round();\n}\n\nexport function pow(x: float, y: float): float {\n  return x.pow(y);\n}\n\nexport function min(a: float, b: float): float {\n  if (a != a) {\n    return a;\n  }\n  if (b != b) {\n    return b;\n  }\n  if (a == b) {\n    return 1.0 / a < 0.0 ? a : b;\n  }\n  return a < b ? a : b;\n}\n\nexport function max(a: float, b: float): float {\n  if (a != a) {\n    return a;\n  }\n  if (b != b) {\n    return b;\n  }\n  if (a == b) {\n    return 1.0 / a > 0.0 ? a : b;\n  }\n  return a > b ? a : b;\n}\n" });
  out.push(SourceFile { path: "$array/module.or", text: "// Array API prelude (spec 08, ADR-0011): entry of the `$array` prelude root. The functions live in\n// array.or; the checker rewrites `xs.map(f)` etc. to calls of them (check/body.or, arrayApiCall).\nexport { map, filter, find, findIndex, some, every, reduce, forEach, sort } from \"./array\";\nexport { indexOfInt, indexOfUsize, indexOfBool, indexOfStr } from \"./array\";\nexport { includesInt, includesUsize, includesBool, includesStr } from \"./array\";\n// Map<K, V> (ADR-0018): the checker maps `Map`, `MapEntry`, `new Map<K, V>()` and the map methods to map.or.\nexport { Map, MapEntry, keyHash, keyEq, hashInt, hashUsize, hashBool, hashStr, eqInt, eqUsize, eqBool, eqStr } from \"./map\";\nexport { mapNew, mapGet, mapHas, mapSet, mapDelete, mapKeys, mapValues, mapEntries } from \"./map\";\n" });
  out.push(SourceFile { path: "$array/parallel.or", text: "// Parallel array pipelines (ADR-0039): `parallel()` on an array `xs` and the operations of the view it returns.\n//\n// This file is part of the `$array` prelude root but is only LOADED for a unit whose source mentions `.parallel`\n// (compiler/loader/loader.or adds the import), so other programs neither check nor compile it. The checker rewrites\n// `parallel()` on an array `xs` to `parallel(xs)` and `p.map(f)` on a `Parallel<T>` to `parMap(p, f)` and so on (check/expr.or); the\n// restrictions of ADR-0039 \xc2\xa73-4 are checked on the calls (check/parallel.or): every closure is a pure closure literal (or\n// a named function), a reducer is a built-in associative operator, and the input element type is a scalar or a flat record\n// of scalars. The optimiser fuses a chain into one loop per chunk (compiler/fuse) and calls the `run*` functions below with\n// the fused body; without it every operation below runs on its own, with the same result.\n//\n// SEMANTICS (the same result as the sequential chain on the same array):\n// * `parallel()` on an array `xs` splits `xs` into chunks of CHUNK consecutive elements (the last one may be shorter). Every operation\n//   keeps this grouping: `map` maps each chunk, `filter` filters each chunk (a chunk may become empty), the elements stay\n//   in order.\n// * `reduce(f, init)` folds every chunk from left to right, then folds `init` with the chunk results from left to right\n//   (empty chunks are skipped). For an associative `f` this is the sequential result; the grouping is fixed, so even a\n//   float `reduce` gives the same bits on every machine and with every number of threads (but possibly not the bits of\n//   the sequential `reduce`: warning W0480).\n// * `some`, `every`, `find`, `findIndex` give what the sequential chain gives: chunks after the first hit are cancelled,\n//   chunks before it always run.\n// * `toArray()` is the array of the elements.\n// * Inputs below SEQUENTIAL_BELOW elements, and every input when only one thread is available (ORIN_THREADS=1), run on the\n//   calling task, chunk by chunk, so the result is the same either way.\n// * A trap in a closure traps the program with the closure's message, as in the sequential chain; which element traps\n//   first is not defined when several would.\n//\n// MEMORY (ADR-0039 \xc2\xa74). The input array is LENT to the worker tasks: it is pinned (its counts frozen) while they run and\n// shared, not copied (runtime/orin_runtime.c \"lending\"). Results are built by the workers and moved back. Captured\n// values of the closures are copied to every worker like any task body.\n\nimport { forkJoin, forkJoinUntil, parallelism } from \"std:task\";\nimport { lendPut, transitDrop } from \"std:fsraw\";\n\nconst CHUNK: usize = 4096;\nconst SEQUENTIAL_BELOW: usize = 8192;\n\n// A parallel view: the elements and, for each chunk, the index in `xs` where it ends. Built by `parallel(xs)` and by the\n// operations; not meant to be built by hand.\nexport type Parallel<T> = { xs: T[]; ends: usize[]; };\n\n// What a chunk contributes to `findIndex`: how many elements it has and where in it the first match is.\nexport type ChunkIndex = { count: usize; at: Option<usize>; };\n\n// The record a lend is made from (two slots: see runtime/orin_runtime.c \"lending\").\ntype Lent<A> = { v: A; spare: usize; };\n\n// ------------------------------------------------------------------------------------------------ chunks\n\n// The number of chunks of an array of n elements.\n@Ensures(result * CHUNK >= n && (result == 0 || (result - 1) * CHUNK < n))\nexport function chunkCount(n: usize): usize {\n  return (n + CHUNK - 1) / CHUNK;\n}\n\n// First index of chunk k of an array of n elements, and one past its last.\nexport function chunkStart(k: usize): usize {\n  return k * CHUNK;\n}\n\n@Ensures(result <= n)\nexport function chunkEnd(k: usize, n: usize): usize {\n  const e = (k + 1) * CHUNK;\n  return e < n ? e : n;\n}\n\n// How many worker tasks a pipeline over n elements in `chunks` chunks uses: 1 (the calling task) below the threshold.\n@Ensures(result >= 1)\nexport function workersFor(n: usize, chunks: usize): usize {\n  if (n < SEQUENTIAL_BELOW || chunks <= 1) {\n    return 1;\n  }\n  const t = parallelism();\n  return t < chunks ? t : chunks;\n}\n\n// Lends `v` to the worker tasks when there are any (0: nothing lent).\nfunction lendIf<A>(workers: usize, v: A): usize {\n  if (workers <= 1) {\n    return 0;\n  }\n  return lendPut(Lent<A> { v: v, spare: 0 });\n}\n\nfunction endLend(tok: usize): void {\n  if (tok != 0) {\n    transitDrop(tok);\n  }\n}\n\nfunction startOf(ends: usize[], k: usize): usize {\n  return k == 0 ? 0 : ends[k - 1];\n}\n\n// ------------------------------------------------------------------------------------------------ the operations\n\n// parallel() on an array xs\n@Ensures(result.xs.length == xs.length)\nexport function parallel<T>(xs: T[]): Parallel<T> {\n  const n = xs.length;\n  let ends: usize[] = [];\n  let k: usize = 0;\n  while (k < chunkCount(n)) {\n    ends.push(chunkEnd(k, n));\n    k += 1;\n  }\n  return Parallel<T> { xs: xs, ends: ends };\n}\n\n// The chunk results of map / filter, concatenated in order, with the chunk boundaries kept.\nexport function runCollect<U>(chunks: usize, workers: usize, body: (k: usize) => U[]): Parallel<U> {\n  const parts = forkJoin(chunks, workers, body);\n  let xs: U[] = [];\n  let ends: usize[] = [];\n  for (const p of parts) {\n    for (const x of p) {\n      xs.push(x);\n    }\n    ends.push(xs.length);\n  }\n  return Parallel<U> { xs: xs, ends: ends };\n}\n\n// `init` folded with the chunk results in order.\nexport function runReduce<U>(\n  chunks: usize,\n  workers: usize,\n  body: (k: usize) => Option<U>,\n  f: (acc: U, x: U) => U,\n  init: U,\n): U {\n  const parts = forkJoin(chunks, workers, body);\n  let acc = init;\n  for (const o of parts) {\n    match (o) {\n      Some(v) => {\n        acc = f(acc, v);\n      },\n      None => {},\n    }\n  }\n  return acc;\n}\n\n// Is any chunk a hit? (`some`; `every` asks whether any chunk has a counterexample.)\nexport function runAny(chunks: usize, workers: usize, body: (k: usize) => bool): bool {\n  const rs = forkJoinUntil(chunks, workers, body, (h: bool) => h);\n  return rs.length > 0 && rs[rs.length - 1];\n}\n\n// The first hit of the first chunk that has one.\nexport function runFind<U>(\n  chunks: usize,\n  workers: usize,\n  body: (k: usize) => Option<U>,\n): Option<U> {\n  const rs = forkJoinUntil(chunks, workers, body, (o: Option<U>) => o.isSome());\n  if (rs.length == 0) {\n    return None;\n  }\n  return rs[rs.length - 1];\n}\n\n// The index of the first match: the sizes of the chunks before the first chunk with a match, plus its place in that chunk.\nexport function runFindIndex(\n  chunks: usize,\n  workers: usize,\n  body: (k: usize) => ChunkIndex,\n): Option<usize> {\n  const rs = forkJoinUntil(chunks, workers, body, (c: ChunkIndex) => c.at.isSome());\n  let base: usize = 0;\n  for (const c of rs) {\n    match (c.at) {\n      Some(j) => {\n        return Some(base + j);\n      },\n      None => {\n        base += c.count;\n      },\n    }\n  }\n  return None;\n}\n\nfunction mapRange<T, U>(xs: T[], lo: usize, hi: usize, f: (x: T) => U): U[] {\n  let out: U[] = [];\n  let i = lo;\n  while (i < hi) {\n    out.push(f(xs[i]));\n    i += 1;\n  }\n  return out;\n}\n\nfunction filterRange<T>(xs: T[], lo: usize, hi: usize, pred: (x: T) => bool): T[] {\n  let out: T[] = [];\n  let i = lo;\n  while (i < hi) {\n    if (pred(xs[i])) {\n      out.push(xs[i]);\n    }\n    i += 1;\n  }\n  return out;\n}\n\nfunction foldRange<T>(xs: T[], lo: usize, hi: usize, f: (acc: T, x: T) => T): Option<T> {\n  if (lo >= hi) {\n    return None;\n  }\n  let acc = xs[lo];\n  let i = lo + 1;\n  while (i < hi) {\n    acc = f(acc, xs[i]);\n    i += 1;\n  }\n  return Some(acc);\n}\n\nfunction findRange<T>(xs: T[], lo: usize, hi: usize, pred: (x: T) => bool): Option<T> {\n  let i = lo;\n  while (i < hi) {\n    if (pred(xs[i])) {\n      return Some(xs[i]);\n    }\n    i += 1;\n  }\n  return None;\n}\n\nfunction indexRange<T>(xs: T[], lo: usize, hi: usize, pred: (x: T) => bool): ChunkIndex {\n  let i = lo;\n  while (i < hi) {\n    if (pred(xs[i])) {\n      return ChunkIndex { count: hi - lo, at: Some(i - lo) };\n    }\n    i += 1;\n  }\n  return ChunkIndex { count: hi - lo, at: None };\n}\n\n// p.map(f)\n@Ensures(result.xs.length == p.xs.length)\nexport function parMap<T, U>(p: Parallel<T>, f: (x: T) => U): Parallel<U> {\n  const xs = p.xs;\n  const ends = p.ends;\n  const w = workersFor(xs.length, ends.length);\n  const tok = lendIf(w, xs);\n  const r = runCollect(ends.length, w, k => mapRange(xs, startOf(ends, k), ends[k], f));\n  endLend(tok);\n  return r;\n}\n\n// p.filter(pred)\n@Ensures(result.xs.length <= p.xs.length)\nexport function parFilter<T>(p: Parallel<T>, pred: (x: T) => bool): Parallel<T> {\n  const xs = p.xs;\n  const ends = p.ends;\n  const w = workersFor(xs.length, ends.length);\n  const tok = lendIf(w, xs);\n  const r = runCollect(ends.length, w, k => filterRange(xs, startOf(ends, k), ends[k], pred));\n  endLend(tok);\n  return r;\n}\n\n// p.reduce(f, init): `f` must be associative (E0485 otherwise).\nexport function parReduce<T>(p: Parallel<T>, f: (acc: T, x: T) => T, init: T): T {\n  const xs = p.xs;\n  const ends = p.ends;\n  const w = workersFor(xs.length, ends.length);\n  const tok = lendIf(w, xs);\n  const r = runReduce(ends.length, w, k => foldRange(xs, startOf(ends, k), ends[k], f), f, init);\n  endLend(tok);\n  return r;\n}\n\n// p.some(pred)\nexport function parSome<T>(p: Parallel<T>, pred: (x: T) => bool): bool {\n  const xs = p.xs;\n  const ends = p.ends;\n  const w = workersFor(xs.length, ends.length);\n  const tok = lendIf(w, xs);\n  const r = runAny(ends.length, w, k => findRange(xs, startOf(ends, k), ends[k], pred).isSome());\n  endLend(tok);\n  return r;\n}\n\n// p.every(pred)\nexport function parEvery<T>(p: Parallel<T>, pred: (x: T) => bool): bool {\n  const xs = p.xs;\n  const ends = p.ends;\n  const w = workersFor(xs.length, ends.length);\n  const tok = lendIf(w, xs);\n  const r = runAny(\n    ends.length,\n    w,\n    k => findRange(xs, startOf(ends, k), ends[k], x => !pred(x)).isSome(),\n  );\n  endLend(tok);\n  return !r;\n}\n\n// p.find(pred)\nexport function parFind<T>(p: Parallel<T>, pred: (x: T) => bool): Option<T> {\n  const xs = p.xs;\n  const ends = p.ends;\n  const w = workersFor(xs.length, ends.length);\n  const tok = lendIf(w, xs);\n  const r = runFind(ends.length, w, k => findRange(xs, startOf(ends, k), ends[k], pred));\n  endLend(tok);\n  return r;\n}\n\n// p.findIndex(pred): the index in `p.toArray()`.\nexport function parFindIndex<T>(p: Parallel<T>, pred: (x: T) => bool): Option<usize> {\n  const xs = p.xs;\n  const ends = p.ends;\n  const w = workersFor(xs.length, ends.length);\n  const tok = lendIf(w, xs);\n  const r = runFindIndex(ends.length, w, k => indexRange(xs, startOf(ends, k), ends[k], pred));\n  endLend(tok);\n  return r;\n}\n\n// p.toArray()\n@Ensures(result.length == p.xs.length)\nexport function parToArray<T>(p: Parallel<T>): T[] {\n  return p.xs;\n}\n" });
  return out;
}
