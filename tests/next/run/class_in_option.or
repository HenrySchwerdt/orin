// Classes inside Option and Result; mutating a matched binding needs a rebinding.
class Box {
  constructor(public n: int) {}
  grow(): void {
    this.n += 10;
  }
  show(): string {
    return "Box(" + this.n.toString() + ")";
  }
}

function find(xs: Box[], n: int): Option<Box> {
  for (const b of xs) {
    if (b.n == n) {
      return Some(b);
    }
  }
  return None;
}

function parse(s: string): Result<Box, string> {
  match (parseInt(s)) {
    Some(n) => { return Ok(new Box(n)); },
    None => { return Err("bad " + s); }
  }
}

function main(): void {
  const xs = [new Box(1), new Box(2)];
  match (find(xs, 2)) {
    Some(b) => {
      let c = b;
      c.grow();
      console.log(c.show() + " " + b.show());
    },
    None => { console.log("none"); }
  }
  console.log(find(xs, 9).isNone().toString());
  match (parse("41")) {
    Ok(b) => { console.log(b.show()); },
    Err(e) => { console.log(e); }
  }
  match (parse("x")) {
    Ok(b) => { console.log(b.show()); },
    Err(e) => { console.log(e); }
  }
}
