// exit: 101
// stderr: trap: usize underflow
// Range facts for constant-length arrays (ADR-0038 lever 2 T6): `i - 1` at 0 traps before the access, as it always did (the
// subtraction keeps its overflow check; a path that always traps leaves no interval state).
function main(): void {
  const a: int[] = [1, 2, 3];
  let i: usize = 3;
  let s = 0;
  while (i < 4) {
    s += a[i - 1];
    console.log(s.toString());
    i -= 1;
  }
  console.log("unreachable");
}
