// OX with a second `Markup` provider (ADR-0044 §6): XML rules instead of HTML rules, in a user module.
import ox from "./xml";
import { Xml, render, document } from "./xml";

// A component: `id` is a number attribute, `href` a computed string attribute with the rule of `href` (spaces become
// %20), tags map to an Xml[] child, `item-ref` is a void tag of this provider.
function Entry(id: int, title: string, link: string, tags: string[]): Xml {
  return <entry id={id} href={link}>
    <title>{title}</title>
    {tags.map(t => <tag>{t}</tag>)}
    <item-ref />
  </entry>;
}

function main(): void {
  // static text and attributes are encoded at compile time with the table of the provider (the apostrophe stays)
  console.log(render(<note kind="a&b" lang='x"y'>{"5 < 6 & 'ok'"}</note>));
  // computed strings are encoded by the provider's own functions
  const who = "<Tom & \"Jerry\" 'n>";
  console.log(render(<p who={who}>{who}</p>));
  // numbers are decimal text, never encoded; a space between two children on one line is kept
  console.log(render(<m i={42} f={0.5} neg={-3}>{7} {1.5}</m>));
  // void tags of this provider end with "/>" (there are no children); <br> is one of them, <hr> is not
  console.log(render(<doc><br /><item-ref ref="x y" /><hr></hr></doc>));
  // `script-*` attributes are static only, written with the static encoding; `ref` is a URL-like rule (computed only)
  console.log(render(<s script-run="a<b" Script-X="1" ref="static value" />));
  // raw text elements of this provider: static text, not encoded
  console.log(render(<cdata>{"a < b && c"}</cdata>));
  // Xml and Xml[] children
  const entries = [Entry(1, "First <post>", "/a b", ["x", "y&z"]), Entry(2, "Second", "http://x.org/?q=1&r=2", [])];
  const feed = <feed version={2}>
    <title>{"Tom & Jerry's <feed>"}</title>
    {entries}
    {entries[0]}
    <count>{entries.length.toInt()}</count>
  </feed>;
  console.log(document(feed));
  // the compile-time encoding and the run-time encoding agree
  const d = "a&b<c>d\"e'f";
  const same = render(<p>{d}</p>) == render(<p>{"a&b<c>d\"e'f"}</p>);
  console.log(same ? "equal" : "DIFFERENT");
}
