// The typed report model. A report producer (benchmarks, conformance, mutation coverage, ...) builds a `Report` from its own
// data and hands it to `renderReport` (components.or); it never builds HTML. Every string in the model is plain text:
// it reaches the page only through OX, which escapes it.

import { SvgDoc } from "./canvas";

// Closed set of status semantics shared by every report family. `Unproven` and `Timeout` are for verification results
// (never present unproven as proved); `Regression` and `Improvement` are for comparisons.
export type Status = Passed | Failed | Regression | Improvement | Unproven | Timeout | Skipped | Info;

export function statusLabel(s: Status): string {
  return match (s) {
    Passed => "Passed",
    Failed => "Failed",
    Regression => "Regression",
    Improvement => "Improvement",
    Unproven => "Unproven",
    Timeout => "Timeout",
    Skipped => "Skipped",
    Info => "Info",
  };
}

// Stable lower-case token: the CSS class suffix (`r-badge-<token>`) and the key used in golden files.
export function statusToken(s: Status): string {
  return match (s) {
    Passed => "passed",
    Failed => "failed",
    Regression => "regression",
    Improvement => "improvement",
    Unproven => "unproven",
    Timeout => "timeout",
    Skipped => "skipped",
    Info => "info",
  };
}

// A mark that carries the meaning without colour (decorative, hidden from assistive technology next to the label).
export function statusIcon(s: Status): string {
  return match (s) {
    Passed => "✓",
    Failed => "✗",
    Regression => "▲",
    Improvement => "▼",
    Unproven => "?",
    Timeout => "⏱",
    Skipped => "–",
    Info => "i",
  };
}

export type Align = AlignLeft | AlignRight;

export type Column = { header: string; align: Align; };

// One table cell: plain text, an optional status badge after it, optionally set in the monospace face.
export type Cell = { text: string; status: Option<Status>; mono: bool; };

export type Table = {
  caption: string;
  columns: Column[];
  rows: Cell[][];
  emptyText: string;      // shown instead of the body when there are no rows
};

export type Card = { label: string; value: string; note: Option<string>; status: Option<Status>; };

export type DiffKind = DiffAdded | DiffRemoved | DiffChanged | DiffSame;

// One row of a before/after comparison (benchmarks between commits, API snapshots, doc comments, call-graph edges, ...).
export type DiffRow = { kind: DiffKind; label: string; before: string; after: string; };

export type DiffTable = { caption: string; labelHeader: string; beforeHeader: string; afterHeader: string; rows: DiffRow[]; emptyText: string; };

export type Block =
  Cards(Card[])
  | Diff(DiffTable)
  | Paragraph(string)
  | Notice(Status, string)
  | Heading(string)
  | Data(Table)
  | Figure(string, string, SvgDoc)      // caption, alt text (the chart's own title/desc carry the detail), chart
  | Details(string, string);            // summary line, preformatted body (e.g. tool versions)

export type Section = { id: string; title: string; intro: Option<string>; blocks: Block[]; };

export type MetaItem = { label: string; value: string; };

export type Report = {
  title: string;          // also the <title> of the page
  subtitle: string;
  meta: MetaItem[];
  sections: Section[];
  footer: string;
};

export function cell(text: string): Cell {
  return Cell { text: text, status: None, mono: false };
}

export function monoCell(text: string): Cell {
  return Cell { text: text, status: None, mono: true };
}

export function statusCell(text: string, s: Status): Cell {
  return Cell { text: text, status: Some(s), mono: false };
}

export function left(header: string): Column {
  return Column { header: header, align: AlignLeft };
}

export function right(header: string): Column {
  return Column { header: header, align: AlignRight };
}

export function card(label: string, value: string, note: Option<string>, status: Option<Status>): Card {
  return Card { label: label, value: value, note: note, status: status };
}

export function section(id: string, title: string, intro: Option<string>, blocks: Block[]): Section {
  return Section { id: id, title: title, intro: intro, blocks: blocks };
}
