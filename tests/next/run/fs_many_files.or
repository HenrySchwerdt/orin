// The runtime keeps at most 256 files open; the 257th open fails with an Err (EMFILE) and everything that was
// opened is closed again on the way out.
import { withFile, useFile, Read, Write, File } from "std:fs";

const PATH: string = "build/tests/fs_many_files.txt";

// nests `depth` more scopes; returns the number of scopes that could be opened
function nest(depth: int, opened: int): int {
  if (depth == 0) {
    return opened;
  }
  const r = withFile(PATH, Read, f => nest(depth - 1, opened + 1));
  return match (r) {
    Ok(inner) => inner,
    Err(e) => opened
  };
}

function main(): void {
  useFile(PATH, Write, f => { f.writeLine("x"); }).unwrap();
  console.log("nest 10: " + nest(10, 0).toString());
  console.log("nest 256: " + nest(256, 0).toString());
  console.log("nest 300: " + nest(300, 0).toString());
  // after all of that the table is empty again
  console.log("reopen 256: " + nest(256, 0).toString());
  console.log("read: " + withFile(PATH, Read, f => f.readLine().unwrapOr("")).unwrap());
}
