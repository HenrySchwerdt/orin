type Pair<A, B> = { first: A; second: B; };
type Tree<T> = Leaf | Node(Tree<T>, T, Tree<T>);

function empty<T>(): T[] {
  return [];
}

function none<T>(): Option<T> {
  return None;
}

function idOf<T>(x: T): T {
  return x;
}

function leafOf<T>(): Tree<T> {
  return Leaf;
}

function main(): void {
  const a: int[] = empty();
  console.log(a.length.toString());
  const b: Option<string> = none();
  console.log(b.isNone().toString());
  const c: Pair<int[], string[]> = Pair { first: [], second: [] };
  console.log(c.first.length.toString() + c.second.length.toString());
  const d: Pair<Option<int>, int> = Pair { first: None, second: 4 };
  console.log(d.first.isNone().toString() + d.second.toString());
  const e: usize = idOf(5);
  console.log(e.toString());
  const t: Tree<string> = Leaf;
  const u: Tree<int> = Node(Leaf, 1, Leaf);
  console.log(match (t) { Leaf => "leaf", Node(_, _, _) => "node" });
  console.log(match (u) { Leaf => "leaf", Node(_, v, _) => v.toString() });
  const l: Tree<bool> = leafOf();
  console.log(match (l) { Leaf => "leaf", Node(_, _, _) => "node" });
  const f: Option<int[]> = Some(empty());
  console.log(f.unwrap().length.toString());
  const g: Result<int[], string> = Ok(empty());
  console.log(g.unwrap().length.toString());
}
