// Text helpers of the protocol harness: shell quoting, ASCII `strip`, byte search. Pure functions, no I/O
// (tests/text_test.or).

export function isSpace(c: int): bool {
  return c == 32 || (c >= 9 && c <= 13);
}

export function strip(s: string): string {
  let a: usize = 0;
  let b = s.length;
  while (a < b && isSpace(s.charCodeAt(a))) {
    a += 1;
  }
  while (b > a && isSpace(s.charCodeAt(b - 1))) {
    b -= 1;
  }
  return s.substring(a, b);
}

// POSIX shell quoting of one word.
export function shq(s: string): string {
  return "'" + s.split("'").join("'\\''") + "'";
}

// ASCII lower case (the header names of a protocol frame).
export function lower(s: string): string {
  let out = "";
  let i: usize = 0;
  while (i < s.length) {
    const c = s.charCodeAt(i);
    out += (c >= 65 && c <= 90) ? String.fromCharCode(c + 32) : s.charAt(i);
    i += 1;
  }
  return out;
}

// The index of the first byte `c` at or after `start`, or `s.length` when there is none.
export function findByte(s: string, start: usize, c: int): usize {
  let i = start;
  while (i < s.length && s.charCodeAt(i) != c) {
    i += 1;
  }
  return i;
}

// The index of the first occurrence of `needle` at or after `start`, -1 when there is none (Python's `str.find`).
export function findFrom(s: string, needle: string, start: usize): int {
  if (needle.length == 0) {
    return start <= s.length ? start.toInt() : -1;
  }
  let i = start;
  while (i + needle.length <= s.length) {
    if (s.charCodeAt(i) == needle.charCodeAt(0) && s.substring(i, i + needle.length) == needle) {
      return i.toInt();
    }
    i += 1;
  }
  return -1;
}

// Number of "\n" in s[0, end).
export function countNewlines(s: string, end: usize): int {
  let n = 0;
  let i: usize = 0;
  while (i < end) {
    if (s.charCodeAt(i) == 10) {
      n += 1;
    }
    i += 1;
  }
  return n;
}

// Replaces every occurrence of `old` by `rep` (Python's str.replace; `old` must not be empty).
export function replaceAll(s: string, old: string, rep: string): string {
  return s.split(old).join(rep);
}

// Quoted form used in failure messages.
export function reprStr(s: string): string {
  let out = "'";
  let i: usize = 0;
  while (i < s.length) {
    const c = s.charCodeAt(i);
    if (c == 10) {
      out += "\\n";
    } else if (c == 13) {
      out += "\\r";
    } else if (c == 9) {
      out += "\\t";
    } else if (c == 92) {
      out += "\\\\";
    } else if (c == 39) {
      out += "\\'";
    } else {
      out += s.charAt(i);
    }
    i += 1;
  }
  return out + "'";
}

// Byte-order comparison (Python's `<` on ASCII/UTF-8 text).
export function lessThan(a: string, b: string): bool {
  const n = a.length < b.length ? a.length : b.length;
  let i: usize = 0;
  while (i < n) {
    const x = a.charCodeAt(i);
    const y = b.charCodeAt(i);
    if (x != y) {
      return x < y;
    }
    i += 1;
  }
  return a.length < b.length;
}

// Sorted copy (insertion sort; the lists of the checks are short).
export function sortedStrs(xs: string[]): string[] {
  let out: string[] = [];
  for (const x of xs) {
    out.push(x);
  }
  let i: usize = 1;
  while (i < out.length) {
    let k = i;
    while (k > 0 && lessThan(out[k], out[k - 1])) {
      const t = out[k - 1];
      out[k - 1] = out[k];
      out[k] = t;
      k -= 1;
    }
    i += 1;
  }
  return out;
}
