// flags: --check-contracts
// A parameter named `result` is fine when only @Requires mention it; early `?` returns are checked.
@Requires(result > 0)
function f(result: int): int {
  return result + 1;
}

function parse(s: string): Result<int, string> {
  const n = parseInt(s);
  if (n.isNone()) {
    return Err("bad");
  }
  return Ok(n.unwrap());
}

@Ensures(result.isOk() ==> result.unwrap() >= 0)
function twice(s: string): Result<int, string> {
  const n = parse(s)?;
  return Ok(n * 2);
}

function main(): void {
  console.log(f(1).toString());
  console.log(twice("4").unwrap().toString());
  console.log(twice("x").isErr().toString());
}
