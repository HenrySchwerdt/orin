// std:host -- the root of authority (ADR-0021 Stage A, ADR-0027).
//
// UNSTABLE (ADR-0016 two-stage freeze): std I/O stays unstable until the project owner confirms the freeze.
//
// A program that performs I/O declares `function main(host: Host): void`. `Host` is the program's handle on the
// machine it runs on: a RESOURCE HANDLE (ADR-0025 rules: it can only be passed as an argument; it cannot be stored in
// a variable, record, class or array, returned, captured by a closure, copied or compared) that only the runtime
// can create. `main()` without the parameter has NO I/O authority: every std I/O function takes a grant as its first
// argument, so such a program cannot call one (compile error E0470).
//
// From the Host a program derives grants, one per family of operation (the "root operation families"):
//   FsGrant       std:fs       open / read / write / list files (further narrowed by `withUnder`, `withReadOnly`)
//   ProcessGrant  std:io       `shell`, `shellTimeout`; std:process `args` (further narrowed by `withArgsOnly`: no spawning)
//   StdioGrant    std:io       read stdin, `writeStdout`
//   ClockGrant    std:time     `nowMillis`
//   NetGrant      std:net      listen / connect / resolve (`useNet`; narrowed by `useListen`, `useConnect`)
// (`useHost` hands out the first four only: take the network grant with `useNet`.) `console.log` / `console.error` and
// `exit` need no grant (ADR-0027, "ambient output"); they are still recorded as primitive OUTPUT / CONTROL events by
// the OSIG.
//
// A grant is obtained only through a SCOPE function: it creates the grant, calls `body` with the grant as the body's
// PARAMETER and revokes it when `body` returns, on every path. Because a handle cannot be captured, a nested scope
// cannot use the outer grant: take every grant you need at once with `withHost` / `useHost`, or pass grants on as
// arguments. Two flavours, as in std:fs: `with*` returns the body's value, `use*` takes a body that returns nothing.
//
// The host policy decides what the OS process may give: by default everything the process has; the environment
// variable ORIN_DENY (a comma-separated list of: fs, process, stdio, clock, net, all) denies families. A denied family is
// still handed out (the program type-checks and runs); every operation then reports an `Err` (FsError kind Denied, ...)
// if it returns a Result, and traps ("capability denied: ...") otherwise.
//
// The raw primitives (grantFs, grantRevoke ... of the internal module std:fsraw) can only be used by the std
// library: user code cannot name them (E0301), so it cannot create, copy or forge a grant.

import {
  Host, FsGrant, ProcessGrant, StdioGrant, ClockGrant, NetGrant, grantNet, grantFs, grantProcess, grantStdio, grantClock, grantArgsOnly, grantRevoke
} from "std:fsraw";

export { Host } from "std:fsraw";

// withFs<T>(host, body: (fs: FsGrant) => T): T
// The file-system grant of the host policy (the whole file system, unless the policy denies `fs`). Revoked when `body`
// returns.
export function withFs<T>(host: Host, body: (fs: FsGrant) => T): T {
  const g = grantFs(host);
  const r = body(g);
  grantRevoke(g);
  return r;
}

// useFs(host, body: (fs: FsGrant) => void): void -- `withFs` for a body that returns nothing.
export function useFs(host: Host, body: (fs: FsGrant) => void): void {
  const g = grantFs(host);
  body(g);
  grantRevoke(g);
}

// withProcess<T>(host, body: (proc: ProcessGrant) => T): T
// The process grant (`shell`, `shellTimeout` of std:io, `args` of std:process). Revoked when `body` returns.
export function withProcess<T>(host: Host, body: (proc: ProcessGrant) => T): T {
  const g = grantProcess(host);
  const r = body(g);
  grantRevoke(g);
  return r;
}

// useProcess(host, body: (proc: ProcessGrant) => void): void -- `withProcess` for a body that returns nothing.
export function useProcess(host: Host, body: (proc: ProcessGrant) => void): void {
  const g = grantProcess(host);
  body(g);
  grantRevoke(g);
}

// withStdio<T>(host, body: (stdio: StdioGrant) => T): T
// The standard input / output grant of std:io (`readLine`, `readBytes`, `writeStdout`). Revoked when `body` returns.
export function withStdio<T>(host: Host, body: (stdio: StdioGrant) => T): T {
  const g = grantStdio(host);
  const r = body(g);
  grantRevoke(g);
  return r;
}

// useStdio(host, body: (stdio: StdioGrant) => void): void -- `withStdio` for a body that returns nothing.
export function useStdio(host: Host, body: (stdio: StdioGrant) => void): void {
  const g = grantStdio(host);
  body(g);
  grantRevoke(g);
}

// withClock<T>(host, body: (clock: ClockGrant) => T): T
// The clock grant of std:time (`nowMillis`, `monotonicNow`). Revoked when `body` returns.
export function withClock<T>(host: Host, body: (clock: ClockGrant) => T): T {
  const g = grantClock(host);
  const r = body(g);
  grantRevoke(g);
  return r;
}

// useClock(host, body: (clock: ClockGrant) => void): void -- `withClock` for a body that returns nothing.
export function useClock(host: Host, body: (clock: ClockGrant) => void): void {
  const g = grantClock(host);
  body(g);
  grantRevoke(g);
}

// withNet<T>(host, body: (net: NetGrant) => T): T
// The network grant (std:net, ADR-0033): may listen and connect anywhere the host policy allows (unless the policy denies
// `net`: then every network operation is refused). Narrow it with `useListen` / `useConnect` of std:net. Revoked when
// `body` returns.
export function withNet<T>(host: Host, body: (net: NetGrant) => T): T {
  const g = grantNet(host);
  const r = body(g);
  grantRevoke(g);
  return r;
}

// useNet(host, body: (net: NetGrant) => void): void -- `withNet` for a body that returns nothing.
export function useNet(host: Host, body: (net: NetGrant) => void): void {
  const g = grantNet(host);
  body(g);
  grantRevoke(g);
}

// withHost<T>(host, body: (fs, proc, stdio, clock) => T): T
// All four grants at once (the usual shape of a command line program's main); the network grant is taken with `withNet`.
// Revoked in reverse order when `body` returns.
export function withHost<T>(
  host: Host, body: (fs: FsGrant, proc: ProcessGrant, stdio: StdioGrant, clock: ClockGrant) => T
): T {
  const f = grantFs(host);
  const p = grantProcess(host);
  const s = grantStdio(host);
  const c = grantClock(host);
  const r = body(f, p, s, c);
  grantRevoke(c);
  grantRevoke(s);
  grantRevoke(p);
  grantRevoke(f);
  return r;
}

// useHost(host, body: (fs, proc, stdio, clock) => void): void -- `withHost` for a body that returns nothing.
export function useHost(
  host: Host, body: (fs: FsGrant, proc: ProcessGrant, stdio: StdioGrant, clock: ClockGrant) => void
): void {
  const f = grantFs(host);
  const p = grantProcess(host);
  const s = grantStdio(host);
  const c = grantClock(host);
  body(f, p, s, c);
  grantRevoke(c);
  grantRevoke(s);
  grantRevoke(p);
  grantRevoke(f);
}

// withArgsOnly<T>(proc, body: (p: ProcessGrant) => T): T
// A process grant that can read `args` but not spawn (`shell` and `shellTimeout` trap with "capability denied").
// Narrowing only restricts: the new grant never has more authority than `proc`.
export function withArgsOnly<T>(proc: ProcessGrant, body: (p: ProcessGrant) => T): T {
  const g = grantArgsOnly(proc);
  const r = body(g);
  grantRevoke(g);
  return r;
}

// useArgsOnly(proc, body: (p: ProcessGrant) => void): void -- `withArgsOnly` for a body that returns nothing.
export function useArgsOnly(proc: ProcessGrant, body: (p: ProcessGrant) => void): void {
  const g = grantArgsOnly(proc);
  body(g);
  grantRevoke(g);
}
