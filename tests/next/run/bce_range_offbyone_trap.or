// exit: 101
// stderr: trap: index out of bounds
// Range facts for constant-length arrays (ADR-0038 lever 2 T6): `<=` against the length is off by one. The check of the last
// access must stay (it traps); the sums printed before it come from accesses that may be unchecked.
function main(): void {
  const a: int[] = [1, 2, 3, 4];
  let s = 0;
  let i: usize = 0;
  while (i < 4) {
    s += a[i];
    i += 1;
  }
  console.log(s.toString());
  s = 0;
  i = 0;
  while (i <= 3) {
    s += a[i];
    i += 1;
  }
  console.log(s.toString());
  s = 0;
  i = 0;
  while (i <= 4) {
    s += a[i];
    console.log(s.toString());
    i += 1;
  }
  console.log("unreachable");
}
