// More text helpers of the CLI test harness: Python-style list `repr`, sets of strings, absolute paths, cutting. Pure
// functions, no I/O (tests/strs_test.or).

import { reprStr, sortedStrs, lessThan } from "./text";

// Python's repr of a list of strings: ['a', 'b'].
export function reprList(xs: string[]): string {
  let parts: string[] = [];
  for (const x of xs) {
    parts.push(reprStr(x));
  }
  return "[" + parts.join(", ") + "]";
}

// Python's repr of a list of lists of strings.
export function reprList2(xss: string[][]): string {
  let parts: string[] = [];
  for (const xs of xss) {
    parts.push(reprList(xs));
  }
  return "[" + parts.join(", ") + "]";
}

// The absolute form of a path given relative to the directory `cwd`.
export function absolute(cwd: string, p: string): string {
  return p.startsWith("/") ? p : cwd + "/" + p;
}

// True when every element of `want` is in `have` (`want <= have` for sets).
export function containsAll(have: string[], want: string[]): bool {
  for (const w of want) {
    if (!have.includes(w)) {
      return false;
    }
  }
  return true;
}

// The sorted distinct elements (a Python set, sorted).
export function uniqueSorted(xs: string[]): string[] {
  let out: string[] = [];
  for (const x of sortedStrs(xs)) {
    if (out.length == 0 || out[out.length - 1] != x) {
      out.push(x);
    }
  }
  return out;
}

// True when the list is in byte order (`xs == sorted(xs)`).
export function isSorted(xs: string[]): bool {
  let i: usize = 1;
  while (i < xs.length) {
    if (lessThan(xs[i], xs[i - 1])) {
      return false;
    }
    i += 1;
  }
  return true;
}

// True when no element occurs twice.
export function isDistinct(xs: string[]): bool {
  return uniqueSorted(xs).length == xs.length;
}

// Two lists of strings are equal.
export function sameList(a: string[], b: string[]): bool {
  if (a.length != b.length) {
    return false;
  }
  let i: usize = 0;
  while (i < a.length) {
    if (a[i] != b[i]) {
      return false;
    }
    i += 1;
  }
  return true;
}

// The elements of `a` that are not in `b` and of `b` that are not in `a` (`a ^ b`), sorted.
export function symmetricDiff(a: string[], b: string[]): string[] {
  let out: string[] = [];
  for (const x of a) {
    if (!b.includes(x)) {
      out.push(x);
    }
  }
  for (const y of b) {
    if (!a.includes(y)) {
      out.push(y);
    }
  }
  return uniqueSorted(out);
}

// The last element of `s.split(sep)` (`s.split(sep)[-1]`).
export function lastPart(s: string, sep: string): string {
  const parts = s.split(sep);
  return parts[parts.length - 1];
}

// The first `n` bytes of `s` (`s[:n]`), without splitting a UTF-8 sequence.
export function head(s: string, n: usize): string {
  if (s.length <= n) {
    return s;
  }
  let e = n;
  while (e > 0 && s.charCodeAt(e) >= 128 && s.charCodeAt(e) < 192) {
    e -= 1;
  }
  return s.substring(0, e);
}

// The last `n` bytes of `s` (`s[-n:]`), without splitting a UTF-8 sequence.
export function tail(s: string, n: usize): string {
  if (s.length <= n) {
    return s;
  }
  let b = s.length - n;
  while (b < s.length && s.charCodeAt(b) >= 128 && s.charCodeAt(b) < 192) {
    b += 1;
  }
  return s.substring(b, s.length);
}
