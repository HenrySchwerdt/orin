// error: E0400
// Interfaces do not convert into each other (no interface inheritance, no structural conformance).
interface A {
  a(): int;
}

interface B {
  a(): int;
}

class C implements A {
  a(): int { return 1; }
}

function main(): void {
  const x: A = new C();
  const y: B = x;
  console.log(y.a().toString());
}
