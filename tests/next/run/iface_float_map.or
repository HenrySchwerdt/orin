// Interfaces combined with floats, std:math and Map<K,V> (ADR-0018 x ADR-0019).
import { sqrt } from "std:math";
interface Shape { area(): float; name(): string; }
class Circle implements Shape {
  r: float;
  constructor(r: float) { this.r = r; }
  area(): float { return 3.14159 * this.r * this.r; }
  name(): string { return "circle"; }
}
class Sq implements Shape {
  s: float;
  constructor(s: float) { this.s = s; }
  area(): float { return this.s * this.s; }
  name(): string { return "sq"; }
}
function total<T extends Shape>(xs: T[]): float {
  let t = 0.0;
  for (const x of xs) { t = t + x.area(); }
  return t;
}
function main(): void {
  const shapes: Shape[] = [new Circle(1.5), new Sq(2.0)];
  let m = new Map<string, float>();
  for (const s of shapes) { m.set(s.name(), s.area()); console.log(s.name() + " " + s.area().toString()); }
  console.log(total([new Sq(3.0), new Sq(sqrt(2.0))]).toString());
  console.log(m.size.toString());
}
