// Closures capture arrays by reference (snapshot semantics, no copy). Run with ORIN_STATS=1 on a build with -DORIN_STATS_ENABLED:
// cow_copies stays at 1 (the single copy made by the `push` after the capture), not one per closure
// creation or call.
function main(): void {
  let data: int[] = [];
  let i = 0;
  while (i < 100000) {
    data.push(i);
    i += 1;
  }
  const sum = () => {
    let s = 0;
    for (const x of data) {
      s += x;
    }
    return s;
  };
  const at = (k: usize) => data[k];
  const size = () => data.length;
  const fs = [sum, sum, sum];
  let t = 0;
  for (const f of fs) {
    t += f();
  }
  console.log(t.toString());
  console.log(at(99999).toString() + " " + size().toString());
  const ks: usize[] = [1, 2, 3];
  const wrapped = ks.map(k => () => data[k] + at(0));
  console.log(wrapped[2]().toString());
  data.push(7);
  console.log(size().toString() + " " + data.length.toString());
}
