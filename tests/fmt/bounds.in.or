// Type parameter bounds, one and several (ADR-0019, ADR-0034).
interface Shape { area(): int; }
function one<T extends Ord>(a:T,b:T):T{return a<b?a:b;}
function two<T   extends  Ord&Hash>(a:T):usize{return a.hash();}
function many<K extends Hash&Ord & Eq,V,   W extends Shape&Ord>(k:K,v:V,w:W):int{return w.area();}
class Index<K extends Hash&Ord> {
  keys: K[] = [];
  heaviest<V extends Shape  &  Hash>(vs: V[]): V { return vs[0]; }
  static clamp<N extends Ord&Eq>(x: N): N { return x; }
  plain<A, B extends Eq>(a: A, b: B): A { return a; }
}
function main(): void {
  console.log(two(3).toString());
}
