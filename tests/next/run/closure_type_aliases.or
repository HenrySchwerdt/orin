type Pred<T> = (x: T) => bool;
type Mapper = (s: string) => string;
type Handler = { name: string; run: Mapper; };

function all<T>(xs: T[], p: Pred<T>): bool {
  for (const x of xs) {
    if (!p(x)) {
      return false;
    }
  }
  return true;
}

function both<T>(p: Pred<T>, q: Pred<T>): Pred<T> {
  return x => p(x) && q(x);
}

function chain(ms: Mapper[]): Mapper {
  return s => {
    let r = s;
    for (const m of ms) {
      r = m(r);
    }
    return r;
  };
}

function main(): void {
  const positive: Pred<int> = x => x > 0;
  const small: Pred<int> = x => x < 10;
  console.log(all([1, 5, 9], both(positive, small)).toString());
  console.log(all([1, 50], both(positive, small)).toString());
  const f = chain([s => s + "a", s => s + "b", (s: string) => s + "c"]);
  console.log(f("x"));
  const h = Handler { name: "up", run: s => "<" + s + ">" };
  console.log(h.name + h.run("z"));
}
