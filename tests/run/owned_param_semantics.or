// ADR-0010 semantic checks: owned parameters, last-use moves and aliasing must keep value
// semantics (callers that still use a value after a call must not observe callee mutation).
type Box = { xs: int[]; tag: int; };

function bump(b: Box, x: int): Box {
  let t = b;
  t.xs.push(x);
  return t;
}

function maybe(b: Box, flag: bool): Box {
  if (flag) {
    let t = b;
    t.tag = t.tag + 100;
    return t;
  }
  return Box { xs: [], tag: b.tag };
}

function unused(b: Box, x: int): int {
  return x + 1;
}

function sumWith(b: Box, extra: int[]): int {
  let total = 0;
  let i: usize = 0;
  while (i < b.xs.length) {
    total += b.xs[i];
    i += 1;
  }
  let j: usize = 0;
  while (j < extra.length) {
    total += extra[j];
    j += 1;
  }
  return total;
}

function twice(b: Box): Box {
  return bump(bump(b, 1), 2);
}

function thread(b: Box, n: int): Box {
  if (n == 0) {
    return b;
  }
  return thread(bump(b, n), n - 1);
}

function show(b: Box): string {
  let s = b.tag.toString() + ":";
  let i: usize = 0;
  while (i < b.xs.length) {
    s = s + b.xs[i].toString() + ",";
    i += 1;
  }
  return s;
}

function main(): void {
  const base = Box { xs: [10, 20], tag: 1 };
  // caller keeps using `base`: the callee must copy, not mutate it
  const a = bump(base, 30);
  console.log(show(base));
  console.log(show(a));
  // moved on last use
  let c = Box { xs: [1], tag: 2 };
  c = bump(c, 5);
  c = bump(c, 6);
  console.log(show(c));
  console.log(show(maybe(c, true)));
  console.log(show(c));
  console.log(show(maybe(c, false)));
  console.log(unused(c, 41).toString());
  console.log(show(c));
  // an alias of the argument passed in a borrowed position
  console.log(sumWith(c, c.xs).toString());
  console.log(show(twice(c)));
  console.log(show(c));
  console.log(show(thread(Box { xs: [], tag: 9 }, 4)));
  // loop with a value that is used again on the next iteration
  let acc = Box { xs: [], tag: 0 };
  let keep = acc;
  let i = 0;
  while (i < 3) {
    keep = bump(acc, i);
    acc = bump(keep, i * 10);
    i += 1;
  }
  console.log(show(acc));
  console.log(show(keep));
}
