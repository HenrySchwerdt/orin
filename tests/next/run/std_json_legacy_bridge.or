import { parse, stringify, at, path, formatError, getIndex, getPath, jsonErrorMessage, toValue, fromValue } from "std:json/legacy";
import { parseDocument, writeDocument, defaultReadOptions, defaultLimits, defaultJsonLimits, jsonParseErrorMessage } from "std:json";

function main(): void {
  // Deprecated spellings still work and agree with the new names.
  const j = parse("{\"a\":[1,{\"b\":-9223372036854775807}]}").unwrap();
  const old = at(path(j, ["a"]).unwrap(), 0).unwrap();
  const now = getIndex(getPath(j, ["a"]).unwrap(), 0).unwrap();
  console.log(stringify(old) == stringify(now) ? "same" : "differ");
  console.log(defaultJsonLimits().maxDepth == defaultLimits().maxDepth ? "same" : "differ");
  const e = parse("[1,").unwrapErr();
  console.log(formatError(e) == jsonErrorMessage(e) ? "same" : "differ");
  console.log(jsonErrorMessage(e));
  // Legacy -> exact model -> text.
  const v = toValue(j);
  console.log(writeDocument(v, defaultLimits()).unwrap());
  console.log(stringify(fromValue(v).unwrap()));
  // Exact model -> legacy: integral tokens convert, others fail.
  const wide = parseDocument("[1.0,1e3,-0]", defaultReadOptions()).unwrap();
  console.log(stringify(fromValue(wide).unwrap()));
  const frac = parseDocument("{\"x\":1.5}", defaultReadOptions()).unwrap();
  console.log(fromValue(frac).isErr().toString());
  const big = parseDocument("[18446744073709551616]", defaultReadOptions()).unwrap();
  console.log(fromValue(big).isErr().toString());
  // Typed renderer of the exact model.
  const bad = parseDocument("[1,\n,2]", defaultReadOptions());
  console.log(jsonParseErrorMessage(bad.unwrapErr()));
}
