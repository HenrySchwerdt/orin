// error: E0484
// The function of a parallel operation must be an arrow function or a named function: the effects of a function value
// (here a parameter) are unknown.
function apply(xs: int[], f: (x: int) => int): int[] {
  return xs.parallel().map(f).toArray();
}

function main(): void {
  const ys = apply([1, 2], x => x + 1);
}
