// User-defined annotations (ADR-0046): one per line above the declaration, a field annotation on the field's line.
type Verb=Get|Post;

   @Annotation( function,method )
type Route={path:string;verb:Verb;auth:Option<string>;};

@Annotation(field)
type JsonName={name:string;};

@Annotation(type, class)
type Json={};

@Annotation(const)
type Limit={max:int;scale:float;names:string[];};

@Json   @Deprecated("old")
export type User={id:int;   @JsonName("display_name")   name:string;
  // keeps working
  @JsonName(  "t" ) tags:string[];};

@Limit(  -5,-1.5, ["a","b"]  )
const LIMIT:int=7;

@Route( "/users/:id" , Get )   @Requires(id>=0)
function find(id:int):int{return id;}

class Users {
  @JsonName("n")   n:int;
  @JsonName("p") private p: int = 1;
  @Route("/x",Post,Some("a"))
  get():int{return this.n;}
  constructor(){this.n=0;}
}

interface Store {
  @Route("/s",Get)
  find(id:int):int;
}

function main(): void {
  console.log(find(1).toString());
}
