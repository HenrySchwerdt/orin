// Static methods are plain functions in the class namespace; no `this`.
class Vec {
  constructor(public x: int, public y: int) {}
  static zero(): Vec {
    return new Vec(0, 0);
  }
  static make(x: int, y: int): Vec {
    return new Vec(x, y);
  }
  static dot(a: Vec, b: Vec): int {
    return a.x * b.x + a.y * b.y;
  }
  scaled(k: int): Vec {
    return Vec.make(this.x * k, this.y * k);
  }
}

function main(): void {
  const z = Vec.zero();
  const v = Vec.make(2, 3);
  console.log(Vec.dot(v, v).toString());
  console.log(Vec.dot(z, v).toString());
  const w = v.scaled(4);
  console.log(w.x.toString() + " " + w.y.toString());
}
