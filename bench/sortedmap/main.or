// std:collections SortedMap<int> (B-tree, minimum degree 16, the recommended degree): 200,000 random inserts, 200,000
// lookups (half of them hits), 100,000 floor queries, then 100,000 removals and an ordered drain. Orin only: Go has no
// ordered map in its standard library (a sorted slice would be a different algorithm with O(n) inserts).
import { SortedMap, SortedEntry } from "std:collections";

// Linear congruential generator; all products stay below 2^63.
function nextRand(s: int): int {
  return (s * 1103515245 + 12345) % 2147483648;
}

function main(): void {
  let m = new SortedMap<int>(16);
  let seed = 42;
  let i = 0;
  let fresh = 0;
  while (i < 200000) {
    seed = nextRand(seed);
    if (m.put(seed % 1000000, i)) {
      fresh += 1;
    }
    i += 1;
  }
  console.log("inserted " + fresh.toString() + " size " + m.size().toString() + " height " + m.height().toString());
  let hits = 0;
  let sum = 0;
  seed = 7;
  i = 0;
  while (i < 200000) {
    seed = nextRand(seed);
    const k = seed % 1000000;
    match (m.get(k)) {
      Some(v) => {
        hits += 1;
        sum += v;
      },
      None => {}
    };
    i += 1;
  }
  console.log("hits " + hits.toString() + " sum " + sum.toString());
  let floors = 0;
  seed = 99;
  i = 0;
  while (i < 100000) {
    seed = nextRand(seed);
    match (m.floorKey(seed % 1000000)) {
      Some(k) => {
        floors += k % 1000;
      },
      None => {}
    };
    i += 1;
  }
  console.log("floors " + floors.toString());
  let removed = 0;
  seed = 42;
  i = 0;
  while (i < 100000) {
    seed = nextRand(seed);
    match (m.remove(seed % 1000000)) {
      Some(v) => {
        removed += 1;
      },
      None => {}
    };
    i += 1;
  }
  console.log("removed " + removed.toString() + " size " + m.size().toString());
  let drained = 0;
  let last = -1;
  let ordered = true;
  while (!m.isEmpty()) {
    match (m.popFirst()) {
      Some(e) => {
        if (e.key <= last) {
          ordered = false;
        }
        last = e.key;
        drained += 1;
      },
      None => {}
    };
  }
  console.log("drained " + drained.toString() + " ordered " + ordered.toString() + " last " + last.toString());
}
