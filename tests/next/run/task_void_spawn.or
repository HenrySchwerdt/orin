// std:task with void (ADR-0040): s.spawn accepts a void body (TaskHandle<void>), scope accepts a void body.
import { scope } from "std:task";

function fib(n: int): int {
  if (n < 2) {
    return n;
  }
  return fib(n - 1) + fib(n - 2);
}

function main(): void {
  const total = scope(s => {
    const a = s.spawn(() => fib(15));
    const b = s.spawn(() => fib(16));
    return a.join() + b.join();
  });
  console.log(total.toString());
  scope(s => {
    const h = s.spawn(() => console.log("a task with no result"));
    h.join();
    console.log("joined");
  });
}
