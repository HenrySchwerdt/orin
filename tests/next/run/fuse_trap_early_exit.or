// exit: 101
// stderr: trap: integer overflow
// Fusion must not hide a trap (ADR-0038 §2, compiler/fuse "TRAPS"): the unfused chain maps EVERY element before `some` looks
// at the first one, so the overflow of the last element traps even though `some` would stop at the second. The fused loop
// keeps running the stage that may trap after the hit.
function main(): void {
  const xs = [1, 2, 9223372036854775807];
  console.log("start");
  const hit = xs.map(x => x + 1).some(x => x == 3);
  console.log(hit.toString());
}
