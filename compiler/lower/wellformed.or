// Well-formedness predicates of lowered MIR. They are used in the `@Requires` / `@Ensures` / `@Invariant` clauses of the
// lowering (builder.or, state.or, lowerer.or, lower.or) and in its tests. The structural ones (locals, targets, strings,
// reachability, spans) are the shared predicates of compiler/mir (mir/wellformed.or, also used by the verifier); the ones
// here are about what only the lowering guarantees: HIR locals first, operands typed like their HIR expression.

import { Type, Local } from "../hir";
import {
  MType, MLocal, Operand, MFunction, MProgram, blocksLocalsBelow, blocksStrsBelow, blockTargetsInRange, allReachable,
  spansComplete,
} from "../mir";
import { mty, isVoidTy, mtyEq, mtyIsRef } from "./util";

// The first locals of `ml` are the HIR locals, with the MIR type of their HIR type.
export function localsMatchHir(hl: Local[], ml: MLocal[]): bool {
  if (ml.length < hl.length) {
    return false;
  }
  let i: usize = 0;
  while (i < hl.length) {
    if (!mtyEq(ml[i].ty, mty(hl[i].ty))) {
      return false;
    }
    i += 1;
  }
  return true;
}

// `op` can stand for a value of the HIR type `ty` in the locals `ls`: a local has the MIR type of `ty`, a constant is of the
// right scalar class, a string literal is a reference. A `void` value has no operand to check.
export function operandMatches(ls: MLocal[], op: Operand, ty: Type): bool {
  if (isVoidTy(ty)) {
    return true;
  }
  const want = mty(ty);
  return match (op) {
    OLocal(l) => l < ls.length && mtyEq(ls[l].ty, want),
    OInt(_) => mtyEq(want, MInt),
    OUsize(_) => mtyEq(want, MUsize),
    OBool(_) => mtyEq(want, MBool),
    OFloat(_) => mtyEq(want, MFloat),
    OStr(_) => mtyIsRef(want),
  };
}

// What the lowering guarantees about one function: locals declared, branch targets in range, no unreachable block,
// every string literal in the table, a source position everywhere.
export function fnWellLowered(f: MFunction, nStrs: usize): bool {
  return blocksLocalsBelow(f.blocks, f.locals.length)
      && blockTargetsInRange(f.blocks)
      && allReachable(f.blocks)
      && blocksStrsBelow(f.blocks, nStrs)
      && spansComplete(f.blocks);
}

export function progWellLowered(p: MProgram): bool {
  return p.functions.every(f => fnWellLowered(f, p.strings.length));
}
