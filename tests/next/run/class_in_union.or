// Classes as union payloads, and a tree built from class nodes.
class Leaf {
  constructor(public v: int) {}
  double(): int {
    return this.v * 2;
  }
}

type Shape = Dot(Leaf) | Line(Leaf, Leaf) | Empty;

function size(s: Shape): int {
  return match (s) {
    Dot(a) => a.double(),
    Line(a, b) => a.double() + b.double(),
    Empty => 0
  };
}

function main(): void {
  const shapes = [Dot(new Leaf(1)), Line(new Leaf(2), new Leaf(3)), Empty];
  let total = 0;
  for (const s of shapes) {
    total += size(s);
  }
  console.log(total.toString());
}
