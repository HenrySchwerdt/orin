// HTML rendering, hand-written: a 2000-row product table rendered 400 times by plain string concatenation into one
// accumulating string (`out += ...`, appended in place while the string is unique), escaping with the same std:html
// functions JSX uses. Orin only: the JSX version is bench/html/main.or, the C / Go baselines bench/html/main.c and
// main.go; all print the same output (ADR-0043).
import { escape, safeUrl } from "std:html";

const ROWS: int = 2000;
const PAGES: int = 400;

function render(names: string[], urls: string[], prices: int[]): string {
  let out = "<html><head><title>Products</title></head><body><h1 class=\"title\">Catalog &amp; Prices</h1><table class=\"products\">";
  let i = 0;
  while (i < ROWS) {
    out += "<tr data-id=\"" + i.toString() + "\" class=\"row " + (i % 2 == 0 ? "even" : "odd") + "\">";
    out += "<td class=\"name\">" + escape(names[i.toUsize()]) + "</td>";
    out += "<td class=\"price\">" + prices[i.toUsize()].toString() + "</td>";
    out += "<td><a href=\"" + escape(safeUrl(urls[i.toUsize()])) + "\">details</a></td>";
    out += "<td><input type=\"checkbox\"" + (i % 3 == 0 ? " disabled" : "") + "></td></tr>";
    i += 1;
  }
  out += "</table><p>" + ROWS.toString() + " items</p></body></html>";
  return out;
}

function main(): void {
  let names: string[] = [];
  let urls: string[] = [];
  let prices: int[] = [];
  let i = 0;
  while (i < ROWS) {
    let n = "Item " + i.toString();
    if (i % 7 == 0) {
      n += " <b>&\"sale\"</b> it's";
    }
    names.push(n);
    urls.push(i % 11 == 0 ? "javascript:alert(" + i.toString() + ")" : "/item/" + i.toString());
    prices.push((i * 37) % 1000);
    i += 1;
  }
  let total = 0;
  let last = "";
  let p = 0;
  while (p < PAGES) {
    last = render(names, urls, prices);
    total += last.length.toInt();
    p += 1;
  }
  let h = 0;
  let k: usize = 0;
  while (k < last.length) {
    h = (h * 31 + last.charCodeAt(k)) % 1000000007;
    k += 1;
  }
  console.log("bytes " + total.toString());
  console.log("hash " + h.toString());
  console.log("head " + last.substring(0, 120));
}
