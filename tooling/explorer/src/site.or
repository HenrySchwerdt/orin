// The whole site as a list of (path, text) files, in a fixed order. Pure: no file access, so the tests render it in memory.

import { THEME_CSS } from "orin-reports";
import { Snap, Diff } from "./model";
import { buildIx, Ix, NONE } from "./index";
import { Ctx } from "./components";
import { OverviewPage, GraphPage, SymbolsPage, ModulePage, SymbolPage } from "./pages";
import { ProcessesPage, DiffPage } from "./pages2";
import { EXPLORER_CSS } from "./explorer_css";
import { EXPLORER_JS } from "./explorer_js";
import { BUSINESS_CSS } from "./business_css";
import { RUNS_CSS } from "./runs_css";
import { Run } from "./runs";
import { buildBiz, behaviourChanges, BChange } from "./business";
import { BusinessPage, UseCasesPage, UseCasePage, RulesPage, CapabilitiesPage, BehaviourPage } from "./business_pages";

export type OutFile = { path: string; text: string; };

export function buildSite(snap: Snap, diff: Option<Diff>): OutFile[] {
  return buildSiteWith(snap, diff, []);
}

// `runs`: the run history, oldest first (runs.or); with an empty list the site is the one without history.
export function buildSiteWith(snap: Snap, diff: Option<Diff>, runs: Run[]): OutFile[] {
  const ix = buildIx(snap);
  const top = Ctx { ix: ix, diff: diff, root: "" };
  const sub = Ctx { ix: ix, diff: diff, root: "../" };
  let files: OutFile[] = [
    OutFile { path: "index.html", text: OverviewPage(top) },
    OutFile { path: "graph.html", text: GraphPage(top) },
    OutFile { path: "symbols.html", text: SymbolsPage(top) },
    OutFile { path: "processes.html", text: ProcessesPage(top, runs) },
  ];
  if (diff.isSome()) {
    files.push(OutFile { path: "diff.html", text: DiffPage(top, diff.unwrap()) });
  }
  // the business view (ADR-0051)
  const biz = buildBiz(ix);
  const changes: BChange[] = diff.isSome() ? behaviourChanges(ix, diff.unwrap()) : [];
  files.push(OutFile { path: "business.html", text: BusinessPage(top, biz, changes) });
  files.push(OutFile { path: "usecases.html", text: UseCasesPage(top, biz) });
  files.push(OutFile { path: "rules.html", text: RulesPage(top, biz) });
  files.push(OutFile { path: "capabilities.html", text: CapabilitiesPage(top, biz) });
  if (diff.isSome()) {
    files.push(OutFile { path: "behaviour.html", text: BehaviourPage(top, diff.unwrap(), changes) });
  }
  let u: usize = 0;
  while (u < biz.usecases.length) {
    files.push(OutFile { path: "u/" + ix.slug[biz.usecases[u].node] + ".html", text: UseCasePage(sub, biz, u) });
    u += 1;
  }
  let m: usize = 0;
  while (m < ix.mods.length) {
    files.push(OutFile { path: "m/" + ix.mods[m].slug + ".html", text: ModulePage(sub, m) });
    m += 1;
  }
  let i: usize = 0;
  while (i < snap.nodes.length) {
    if (ix.page[i] == i) {
      files.push(OutFile { path: "s/" + ix.slug[i] + ".html", text: SymbolPage(sub, i) });
    }
    i += 1;
  }
  files.push(OutFile { path: "assets/explorer.css", text: THEME_CSS + EXPLORER_CSS });
  files.push(OutFile { path: "assets/explorer.js", text: EXPLORER_JS });
  files.push(OutFile { path: "assets/business.css", text: BUSINESS_CSS });
  if (runs.length > 0) {
    files.push(OutFile { path: "assets/runs.css", text: RUNS_CSS });
  }
  return files;
}
