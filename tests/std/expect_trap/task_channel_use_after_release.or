// `orin test` must report this test as FAILED (a trap) in every build: once both ends of a channel are closed its monitor is
// freed, and any further use traps (a stale handle is refused by the platform layer, never dereferenced).
import { channel } from "std:task";

@Test
function useAfterBothEndsClosedTraps(): void {
  const ch = channel<int>(2);
  ch.tx.close();
  ch.rx.close();
  ch.tx.send(1);
}
