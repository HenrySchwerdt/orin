// Orin for TypeScript developers: closures capture values, not variables.
function main(): void {
  let n = 1;
  const addN = (x: int): int => x + n;
  n = 10;
  console.log(`${addN(1)}`);
  console.log(`${n}`);

  let total = 0;
  for (const x of [1, 2, 3]) { total += x; }
  console.log(`${total}`);
}
