// A generic class implementing a (non-generic) interface (ADR-0026 + ADR-0019): one vtable per instance,
// interface-typed values hold a snapshot, instances of one class mix freely with other implementors.
interface Shape {
  area(): int;
  describe(): string;
}

class Sq implements Shape {
  s: int;
  constructor(s: int) {
    this.s = s;
  }
  area(): int {
    return this.s * this.s;
  }
  describe(): string {
    return "sq";
  }
}

// area() does not depend on T; describe() uses T through its own methods only
class Tagged<T> implements Shape {
  tag: T;
  n: int;
  constructor(tag: T, n: int) {
    this.tag = tag;
    this.n = n;
  }
  area(): int {
    return this.n;
  }
  describe(): string {
    return "tagged" + this.n.toString();
  }
  tagValue(): T {
    return this.tag;
  }
  grow(): void {
    this.n += 1;
  }
}

class Both<A, B> implements Shape {
  a: A;
  b: B;
  constructor(a: A, b: B) {
    this.a = a;
    this.b = b;
  }
  area(): int {
    return 100;
  }
  describe(): string {
    return "both";
  }
}

function total(xs: Shape[]): int {
  let t = 0;
  for (const x of xs) {
    t += x.area();
  }
  return t;
}

function describeAll<T extends Shape>(xs: T[]): string {
  let parts: string[] = [];
  for (const x of xs) {
    parts.push(x.describe());
  }
  return parts.join(",");
}

function main(): void {
  const t1 = new Tagged<string>("a", 5);
  const t2 = new Tagged<int>(7, 6);
  const shapes: Shape[] = [new Sq(2), t1, t2, new Both<int, string>(1, "x")];
  console.log(total(shapes).toString());
  const s: Shape = t2;
  console.log(s.describe() + " " + s.area().toString());
  // an interface value is a snapshot: later changes of the original are not visible
  let g = new Tagged<bool>(true, 1);
  const snap: Shape = g;
  g.grow();
  console.log(snap.area().toString() + " " + g.area().toString());
  // a generic class as the argument of a function bounded by the interface
  console.log(describeAll([t1, new Tagged<string>("b", 9)]));
  console.log(describeAll(shapes));
  // return position and Option
  const o: Option<Shape> = Some(new Tagged<float>(1.5, 3));
  console.log(o.unwrap().describe());
  console.log(t1.tagValue() + t2.tagValue().toString());
}
