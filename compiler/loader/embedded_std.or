  out.push(SourceFile { path: "$std/numbers.or", text: "// std prelude: number <-> string conversions (spec 19, R1). See module.or for the rules.\n// Replaces orin_parse_int / orin_int_to_string / orin_usize_to_string / orin_bool_to_string.\n\n// Decimal digits with no sign, no leading zeros (`0` for zero).\nexport function usizeToString(u: usize): string {\n  if (u < 10) {\n    return String.fromCharCode(48 + u.toInt());\n  }\n  let p: usize = 1;\n  while (u / p >= 10) {\n    p = p * 10;\n  }\n  let out = \"\";\n  let r = u;\n  while (p > 0) {\n    out += String.fromCharCode(48 + (r / p).toInt());\n    r = r % p;\n    p = p / 10;\n  }\n  return out;\n}\n\nexport function intToString(v: int): string {\n  if (v >= 0) {\n    return usizeToString(v.toUsize());\n  }\n  if (v == -9223372036854775807 - 1) {\n    return \"-9223372036854775808\";\n  }\n  return \"-\" + usizeToString((-v).toUsize());\n}\n\nexport function boolToString(v: bool): string {\n  return v ? \"true\" : \"false\";\n}\n\n// Optional `-`, then one or more ASCII digits; None on anything else or when the value does not\n// fit in an int. (No `+` sign, no whitespace.)\nexport function strParseInt(s: string): Option<int> {\n  const n = s.length;\n  let i: usize = 0;\n  let neg = false;\n  if (n > 0 && s.charCodeAt(0) == 45) {\n    neg = true;\n    i = 1;\n  }\n  if (i >= n) {\n    return None;\n  }\n  const lo = -9223372036854775807 - 1;\n  const hi = 9223372036854775807;\n  let acc: int = 0;\n  while (i < n) {\n    const c = s.charCodeAt(i);\n    if (c < 48 || c > 57) {\n      return None;\n    }\n    const d = c - 48;\n    if (neg) {\n      if (acc < (lo + d) / 10) {\n        return None;\n      }\n      acc = acc * 10 - d;\n    } else {\n      if (acc > (hi - d) / 10) {\n        return None;\n      }\n      acc = acc * 10 + d;\n    }\n    i += 1;\n  }\n  return Some(acc);\n}\n" });
  out.push(SourceFile { path: "$std/strings.or", text: "// std prelude: string utilities (spec 19, R1). See module.or for the rules.\n// Replaces orin_str_index_of / includes / starts_with / ends_with / split / trim and\n// orin_array_join of runtime/core/orin_runtime.c. Behaviour is identical, including the trap\n// message of `split` with an empty separator.\n\nimport { exit } from \"std:process\";\n\n// Same observable behaviour as orin_trap: flush stdout, `trap: <msg>` on stderr, exit status 101.\nfunction trap(msg: string): void {\n  console.error(\"trap: \" + msg);\n  exit(101);\n}\n\n// True when `n` occurs in `s` at byte offset `at` (requires at + n.length <= s.length).\nfunction matchAt(s: string, n: string, at: usize): bool {\n  let k: usize = 0;\n  while (k < n.length) {\n    if (s.charCodeAt(at + k) != n.charCodeAt(k)) {\n      return false;\n    }\n    k += 1;\n  }\n  return true;\n}\n\n// First offset >= `begin` (<= s.length) at which `n` occurs in `s`; `s.length + 1` when there is none.\n// An empty needle is found at `begin`.\nfunction findFrom(s: string, n: string, begin: usize): usize {\n  const nl = n.length;\n  const sl = s.length;\n  if (nl == 0) {\n    return begin;\n  }\n  if (nl > sl) {\n    return sl + 1;\n  }\n  const last = sl - nl;\n  const c0 = n.charCodeAt(0);\n  let i = begin;\n  while (i <= last) {\n    if (s.charCodeAt(i) == c0 && matchAt(s, n, i)) {\n      return i;\n    }\n    i += 1;\n  }\n  return sl + 1;\n}\n\nexport function strIndexOf(s: string, needle: string): Option<usize> {\n  const p = findFrom(s, needle, 0);\n  if (p > s.length) {\n    return None;\n  }\n  return Some(p);\n}\n\nexport function strIncludes(s: string, needle: string): bool {\n  return findFrom(s, needle, 0) <= s.length;\n}\n\nexport function strStartsWith(s: string, p: string): bool {\n  if (p.length > s.length) {\n    return false;\n  }\n  return matchAt(s, p, 0);\n}\n\nexport function strEndsWith(s: string, p: string): bool {\n  if (p.length > s.length) {\n    return false;\n  }\n  return matchAt(s, p, s.length - p.length);\n}\n\nexport function strSplit(s: string, sep: string): string[] {\n  let out: string[] = [];\n  if (sep.length == 0) {\n    trap(\"split with empty separator\");\n    return out;\n  }\n  let start: usize = 0;\n  while (true) {\n    const p = findFrom(s, sep, start);\n    if (p > s.length) {\n      break;\n    }\n    out.push(s.substring(start, p));\n    start = p + sep.length;\n  }\n  out.push(s.substring(start, s.length));\n  return out;\n}\n\nfunction isSpace(c: int): bool {\n  return c == 32 || (c >= 9 && c <= 13);\n}\n\nexport function strTrim(s: string): string {\n  let a: usize = 0;\n  let b = s.length;\n  while (a < b && isSpace(s.charCodeAt(a))) {\n    a += 1;\n  }\n  while (b > a && isSpace(s.charCodeAt(b - 1))) {\n    b -= 1;\n  }\n  return s.substring(a, b);\n}\n\nexport function strJoin(a: string[], sep: string): string {\n  let out = \"\";\n  let i: usize = 0;\n  while (i < a.length) {\n    if (i > 0) {\n      out += sep;\n    }\n    out += a[i];\n    i += 1;\n  }\n  return out;\n}\n" });
  return out;
