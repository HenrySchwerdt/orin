// Built-in API entries for `inspect("Type.member")` (spec 10 "Introspection"): signature, purity,
// complexity, allocation, failure semantics and a minimal example. Derived from
// docs/bootstrap-subset.md §6 and the runtime (runtime/orin_runtime.c); `Array.find` is a
// spec-level entry that the self-hosted compiler does not implement yet (status "planned").

import { Json, JStr, JObj, JField, jField, getStr } from "../json";

type Api = {
  name: string;
  sig: string;
  fails: string;
  pure: bool;
  cost: string;
  alloc: string;
  example: string;
  status: string;
};

function api(
  name: string,
  sig: string,
  fails: string,
  cost: string,
  alloc: string,
  example: string,
): Api {
  return Api {
    name: name,
    sig: sig,
    fails: fails,
    pure: true,
    cost: cost,
    alloc: alloc,
    example: example,
    status: "implemented",
  };
}

function mutating(a: Api): Api {
  return Api { ...a, pure: false };
}

// The built-in API table. Names are unique (`apiLookup` answers the first match).
@Ensures(namesDistinct(result))
function table(): Api[] {
  return [
    mutating(api("std:io.shellTimeout", "shellTimeout(proc: ProcessGrant, cmd: string, seconds: int): int [unstable]", "0..255 exit status; -2 timeout; -1 invalid duration, spawn, signal or OS error; requires spawn-capable ProcessGrant", "O(command bytes + elapsed time / 10ms); sleeps between checks", "O(command bytes), one child process and process group", "shellTimeout(proc, \"printf hello\", 1)")),

    api("std:encoding.hexEncode", "hexEncode(src: Bytes): string", "never fails; lowercase ASCII hex", "O(n)", "O(n) output/storage", "import { hexEncode } from \"std:encoding\";"),
    api("std:encoding.hexDecode", "hexDecode(src: Bytes): Result<Bytes, EncodingError>", "Err with kind and byte position; no partial output; strict hex; either case", "O(n)", "O(n) output/storage", "import { hexDecode } from \"std:encoding\";"),
    api("std:encoding.base64Encode", "base64Encode(src: Bytes, padded: bool): string", "never fails; RFC 4648 standard alphabet; padded=true emits padding, false omits it", "O(n)", "O(n) output/storage", "import { base64Encode } from \"std:encoding\";"),
    api("std:encoding.base64Decode", "base64Decode(src: Bytes, padded: bool): Result<Bytes, EncodingError>", "Err with kind and byte position; no partial output; strict standard alphabet and canonical bits; padded=true requires padding, false forbids it", "O(n)", "O(n) output/storage", "import { base64Decode } from \"std:encoding\";"),
    api("std:encoding.base64UrlEncode", "base64UrlEncode(src: Bytes, padded: bool): string", "never fails; RFC 4648 URL alphabet; padded=true emits padding, false omits it", "O(n)", "O(n) output/storage", "import { base64UrlEncode } from \"std:encoding\";"),
    api("std:encoding.base64UrlDecode", "base64UrlDecode(src: Bytes, padded: bool): Result<Bytes, EncodingError>", "Err with kind and byte position; no partial output; strict URL alphabet and canonical bits; padded=true requires padding, false forbids it", "O(n)", "O(n) output/storage", "import { base64UrlDecode } from \"std:encoding\";"),
    api("std:encoding.encodingErrorMessage", "encodingErrorMessage(e: EncodingError): string", "never fails", "O(1)", "allocates message", "encodingErrorMessage(e)"),
    api("string.length", "length: usize", "never fails", "O(1)", "none", "\"abc\".length // 3"),
    api(
      "string.charCodeAt",
      "charCodeAt(i: usize): int",
      "traps if i >= length",
      "O(1)",
      "none",
      "\"A\".charCodeAt(0) // 65",
    ),
    api(
      "string.charAt",
      "charAt(i: usize): string",
      "traps if i >= length",
      "O(1)",
      "allocates 1-byte string",
      "\"abc\".charAt(1) // \"b\"",
    ),
    api(
      "string.substring",
      "substring(a: usize, b: usize): string",
      "traps unless a <= b <= length",
      "O(b-a)",
      "allocates result",
      "\"hello\".substring(1, 3) // \"el\"",
    ),
    api(
      "string.indexOf",
      "indexOf(s: string): Option<usize>",
      "None when absent",
      "O(n*m)",
      "allocates Option",
      "\"abc\".indexOf(\"c\") // Some(2)",
    ),
    api(
      "string.includes",
      "includes(s: string): bool",
      "never fails",
      "O(n*m)",
      "none",
      "\"abc\".includes(\"b\") // true",
    ),
    api(
      "string.startsWith",
      "startsWith(s: string): bool",
      "never fails",
      "O(m)",
      "none",
      "\"abc\".startsWith(\"a\")",
    ),
    api(
      "string.endsWith",
      "endsWith(s: string): bool",
      "never fails",
      "O(m)",
      "none",
      "\"abc\".endsWith(\"c\")",
    ),
    api(
      "string.split",
      "split(sep: string): string[]",
      "traps if sep is empty",
      "O(n)",
      "allocates array + parts",
      "\"a,b\".split(\",\") // [\"a\",\"b\"]",
    ),
    api(
      "string.trim",
      "trim(): string",
      "never fails",
      "O(n)",
      "allocates result",
      "\"  x \".trim() // \"x\"",
    ),
    api("Array.length", "length: usize", "never fails", "O(1)", "none", "xs.length"),
    api(
      "Array.get",
      "get(i: usize): Option<T>",
      "None when out of range",
      "O(1)",
      "allocates Option",
      "xs.get(0).unwrapOr(d)",
    ),
    mutating(
      api(
        "Array.push",
        "push(v: T): void",
        "receiver must be a mutable place (E0401)",
        "amortized O(1)",
        "may reallocate the array",
        "xs.push(1)",
      ),
    ),
    mutating(
      api(
        "Array.pop",
        "pop(): Option<T>",
        "None when empty; receiver must be a mutable place (E0401)",
        "O(1)",
        "allocates Option",
        "xs.pop()",
      ),
    ),
    api(
      "Array.slice",
      "slice(a: usize, b: usize): T[]",
      "traps unless a <= b <= length",
      "O(b-a)",
      "allocates result",
      "xs.slice(1, 3)",
    ),
    api(
      "Array.concat",
      "concat(ys: T[]): T[]",
      "never fails",
      "O(n+m)",
      "allocates result",
      "xs.concat(ys)",
    ),
    api(
      "Array.join",
      "join(sep: string): string  (receiver string[])",
      "never fails",
      "O(total bytes)",
      "allocates result",
      "[\"a\",\"b\"].join(\"-\") // \"a-b\"",
    ),
    Api {
      name: "Array.find",
      sig: "find(pred: (T) => bool): Option<T>",
      fails: "None when no element matches; never traps",
      pure: true,
      cost: "O(n), short-circuits",
      alloc: "allocates Option",
      example: "xs.find((x) => x > 2)",
      status: "planned (spec 08; not implemented in the self-hosted compiler: use a loop)",
    },
    api(
      "int.toString",
      "toString(): string",
      "never fails",
      "O(digits)",
      "allocates result",
      "(42).toString()",
    ),
    api(
      "int.toUsize",
      "toUsize(): usize  (also toI8, toI16, toI32, toI64/toInt, toIsize, toU8, toU16, toU32, toU64: any integer type to any other)",
      "traps if the value does not fit the target type",
      "O(1)",
      "none",
      "n.toUsize()",
    ),
    api(
      "int.wrappingAdd",
      "wrappingAdd(b: T): T  (also wrappingSub, wrappingMul; receiver any integer type T)",
      "never fails (two's complement wrap-around)",
      "O(1)",
      "none",
      "x.wrappingAdd(100) // 44 for x: u8 = 200 (x + 100 would trap)",
    ),
    api(
      "int.saturatingAdd",
      "saturatingAdd(b: T): T  (also saturatingSub, saturatingMul)",
      "never fails (clamps to the type's range)",
      "O(1)",
      "none",
      "x.saturatingAdd(100) // 255 for u8",
    ),
    api(
      "int.checkedAdd",
      "checkedAdd(b: T): Option<T>  (also checkedSub, checkedMul)",
      "None on overflow",
      "O(1)",
      "allocates Option",
      "x.checkedAdd(100).unwrapOr(0)",
    ),
    api(
      "parseI32",
      "parseI32(s: string): Option<i32>  (also parseI8, parseI16, parseI64, parseIsize, parseU8, parseU16, parseU32, parseU64, parseUsize; parseInt = parseI64)",
      "None unless the whole string is an optionally negated decimal that fits the type",
      "O(n)",
      "allocates Option",
      "parseI32(\"-42\")",
    ),
    api(
      "usize.toString",
      "toString(): string",
      "never fails",
      "O(digits)",
      "allocates result",
      "n.toString()",
    ),
    api("usize.toInt", "toInt(): int", "traps if > i64 max", "O(1)", "none", "n.toInt()"),
    api("bool.toString", "toString(): string", "never fails", "O(1)", "none", "true.toString()"),
    api("Option.isSome", "isSome(): bool", "never fails", "O(1)", "none", "o.isSome()"),
    api("Option.isNone", "isNone(): bool", "never fails", "O(1)", "none", "o.isNone()"),
    api("Option.unwrap", "unwrap(): T", "traps on None", "O(1)", "none", "o.unwrap()"),
    api("Option.unwrapOr", "unwrapOr(d: T): T", "never fails", "O(1)", "none", "o.unwrapOr(0)"),
    api("Result.isOk", "isOk(): bool", "never fails", "O(1)", "none", "r.isOk()"),
    api("Result.isErr", "isErr(): bool", "never fails", "O(1)", "none", "r.isErr()"),
    api("Result.unwrap", "unwrap(): T", "traps on Err", "O(1)", "none", "r.unwrap()"),
    api("Result.unwrapErr", "unwrapErr(): E", "traps on Ok", "O(1)", "none", "r.unwrapErr()"),
    api(
      "Result.?",
      "expr?  (in a function returning Result<_, E>)",
      "returns Err(e) early",
      "O(1)",
      "none",
      "const n = parse(s)?;",
    ),
    api(
      "float.toString",
      "toString(): string",
      "never fails",
      "O(1)",
      "allocates result",
      "(0.1 + 0.2).toString() // \"0.30000000000000004\"",
    ),
    api(
      "float.toInt",
      "toInt(): int",
      "traps on NaN, Infinity or a value outside int; truncates toward zero",
      "O(1)",
      "none",
      "(3.99).toInt() // 3",
    ),
    api(
      "float.round",
      "round(): float  (also floor, ceil, sqrt, abs; pow(y))",
      "never fails (IEEE: NaN/Infinity propagate)",
      "O(1)",
      "none",
      "(2.5).round() // 3.0",
    ),
    api(
      "float.isNaN",
      "isNaN(): bool  (also isFinite)",
      "never fails",
      "O(1)",
      "none",
      "x.isNaN()",
    ),
    api(
      "int.toFloat",
      "toFloat(): float  (also toF32; usize likewise)",
      "never fails",
      "O(1)",
      "none",
      "n.toFloat()",
    ),
    api(
      "bytesToString",
      "bytesToString(a: u8[], start: usize, len: usize): string",
      "traps (\"slice out of range\") unless start + len <= a.length; one byte per character, no decoding",
      "O(len), one allocation",
      "allocates result",
      "bytesToString(buf, 0, 4)",
    ),
    api(
      "stringToBytes",
      "stringToBytes(s: string): u8[]",
      "never fails; one u8 per string byte, no decoding",
      "O(n), one allocation",
      "allocates result",
      "stringToBytes(\"abc\") // [97, 98, 99]",
    ),
    api(
      "parseFloat",
      "parseFloat(s: string): Option<float>",
      "None unless the whole string is a float literal, Infinity or NaN",
      "O(n)",
      "allocates Option",
      "parseFloat(\"1.5e3\")",
    ),
    api(
      "Map.get",
      "get(k: K): Option<V>  (Map<K, V>, K in int/usize/bool/string)",
      "None when absent",
      "expected O(1)",
      "allocates Option",
      "m.get(\"a\").unwrapOr(0)",
    ),
    api("bytesToString", "bytesToString(a: u8[], start: usize, len: usize): string", "traps (\"slice out of range\") unless start + len <= a.length; one byte per character, no decoding", "O(len), one allocation", "allocates result", "bytesToString(buf, 0, 4)"),
    api("stringToBytes", "stringToBytes(s: string): u8[]", "never fails; one u8 per string byte, no decoding", "O(n), one allocation", "allocates result", "stringToBytes(\"abc\") // [97, 98, 99]"),
    api("Map.has", "has(k: K): bool", "never fails", "expected O(1)", "none", "m.has(\"a\")"),
    mutating(
      api(
        "Map.set",
        "set(k: K, v: V): void",
        "receiver must be a mutable place (E0401)",
        "expected O(1); O(n) first write of a shared map",
        "may reallocate tables",
        "m.set(\"a\", 1)",
      ),
    ),
    mutating(
      api(
        "Map.delete",
        "delete(k: K): bool",
        "false when absent; receiver must be a mutable place (E0401)",
        "expected O(1)",
        "may rebuild tables",
        "m.delete(\"a\")",
      ),
    ),
    api("Map.size", "size: usize", "never fails", "O(1)", "none", "m.size"),
    api(
      "Map.keys",
      "keys(): K[]  (also values(): V[], entries(): MapEntry<K, V>[]; insertion order)",
      "never fails",
      "O(n)",
      "allocates result",
      "m.keys()",
    ),
  ].concat(
    stdTable(),
  );
}

// Std modules written in Orin (stdlib/, docs/std.md): `inspect("std:path.join")` etc. The full doc
// comments live in the module sources; this is the signature/failure/cost summary.
function stdTable(): Api[] {
  return [
    api(
      "std:url.percentEncode",
      "percentEncode(s: string, spaceAsPlus: bool): string",
      "never fails; encodes raw bytes, only ALPHA/DIGIT/-._~ pass through",
      "O(n)",
      "allocates buffer and result",
      "percentEncode(\"a +\", true) // a+%2B",
    ),
    api(
      "std:url.percentEncodeBytes",
      "percentEncodeBytes(b: Bytes, spaceAsPlus: bool): string",
      "never fails; arbitrary Bytes view",
      "O(n)",
      "allocates temporary string, buffer and result",
      "percentEncodeBytes(b, false)",
    ),
    api(
      "std:url.percentDecode",
      "percentDecode(s: string, plusAsSpace: bool): Result<string, UrlError>",
      "Err {kind, offset} for malformed %HH or invalid UTF-8; original byte offset",
      "O(n)",
      "allocates buffer and result",
      "percentDecode(\"caf%C3%A9\", false)",
    ),
    api(
      "std:url.percentDecodeBytes",
      "percentDecodeBytes(s: string, plusAsSpace: bool): Result<Bytes, UrlError>",
      "Err {kind, offset} for malformed %HH; accepts arbitrary decoded bytes",
      "O(n)",
      "allocates buffer, temporary string and Bytes",
      "percentDecodeBytes(\"%FF\", false)",
    ),
    api(
      "std:url.parseQuery",
      "parseQuery(s: string, plusAsSpace: bool): Result<QueryPair[], UrlError>",
      "strict UTF-8; original byte offsets; skips empty fields; preserves duplicate order; bare key has empty value",
      "O(n)",
      "allocates pairs and component buffers/strings",
      "parseQuery(\"a=1&a=2\", true)",
    ),
    api(
      "std:url.stringifyQuery",
      "stringifyQuery(pairs: QueryPair[], spaceAsPlus: bool): Result<string, QueryEncodeError>",
      "Err {pairIndex, inValue, offset} for invalid UTF-8; emits key=value in source order",
      "O(bytes + pairs)",
      "allocates component buffers/strings and result buffer/string",
      "stringifyQuery(pairs, true)",
    ),
    api(
      "std:url.urlErrorMessage",
      "urlErrorMessage(e: UrlError): string",
      "never fails",
      "O(1)",
      "allocates message",
      "urlErrorMessage(e)",
    ),
    api(
      "std:path.join",
      "join(parts: string[]): string",
      "never fails",
      "O(n)",
      "allocates result",
      "join([\"/a\", \"b\", \"../c\"]) // \"/a/c\"",
    ),
    api(
      "std:path.normalize",
      "normalize(p: string): string",
      "never fails",
      "O(n)",
      "allocates result",
      "normalize(\"a//b/./c/..\") // \"a/b\"",
    ),
    api(
      "std:path.dirname",
      "dirname(p: string): string",
      "never fails",
      "O(n)",
      "allocates result",
      "dirname(\"/a/b.txt\") // \"/a\"",
    ),
    api(
      "std:path.basename",
      "basename(p: string): string",
      "never fails",
      "O(n)",
      "allocates result",
      "basename(\"/a/b.txt\") // \"b.txt\"",
    ),
    api(
      "std:path.extension",
      "extension(p: string): string",
      "\"\" when there is no extension",
      "O(n)",
      "allocates result",
      "extension(\"b.txt\") // \".txt\"",
    ),
    api(
      "std:json.parse",
      "parse(text: string): Result<Json, JsonError>",
      "Err(JsonError{message, offset, line, column}) on syntax errors, floats, int overflow, nesting > 200",
      "O(n)",
      "allocates the value",
      "parse(\"[1,2]\")",
    ),
    api(
      "std:json.stringify",
      "stringify(j: Json): string",
      "never fails",
      "O(n)",
      "allocates result",
      "stringify(JArr([JNum(1)])) // \"[1]\"",
    ),
    api(
      "std:json.pretty",
      "pretty(j: Json, indent: usize): string",
      "never fails",
      "O(n)",
      "allocates result",
      "pretty(j, 2)",
    ),
    api(
      "std:json.get",
      "get(j: Json, key: string): Option<Json>",
      "None for a missing key or a non-object",
      "O(fields)",
      "allocates Option",
      "get(j, \"name\")",
    ),
    api(
      "std:json.asString",
      "asString(j: Json): Option<string>",
      "None unless JStr",
      "O(1)",
      "allocates Option",
      "asString(v)",
    ),
    api(
      "std:json.asInt",
      "asInt(j: Json): Option<int>",
      "None unless JNum",
      "O(1)",
      "allocates Option",
      "asInt(v)",
    ),
    api(
      "std:json.asArray",
      "asArray(j: Json): Option<Json[]>",
      "None unless JArr",
      "O(1)",
      "allocates Option",
      "asArray(v)",
    ),
    api(
      "std:time.nowMillis",
      "nowMillis(clock: ClockGrant): int  [unstable]",
      "never fails; traps if the host policy denies the clock",
      "O(1)",
      "none",
      "const t0 = nowMillis(clock);",
    ),
    api(
      "std:net.useListener",
      "useListener(net: NetGrant, addr: string, port: int, backlog: int, body: (ln: Listener) => void): Result<void, NetError>  [unstable]",
      "Err if the grant's scope or ORIN_DENY=net refuses, the port is in use or an argument is invalid; body is not called then",
      "O(1)",
      "a socket, closed when body returns",
      "useListener(net, \"127.0.0.1\", 8080, 64, ln => { ... });",
    ),
    api(
      "std:net.useAccepted",
      "useAccepted(ln: Listener, timeoutMs: int, body: (s: Stream, peer: Peer) => void): Result<void, NetError>  [unstable]",
      "Err(timeout) (isTimeout) if nobody connected within timeoutMs; other Err on failure",
      "waits up to timeoutMs",
      "a socket, closed when body returns",
      "useAccepted(ln, 1000, (s, peer) => { ... });",
    ),
    api(
      "std:net.useConnection",
      "useConnection(net: NetGrant, host: string, port: int, timeoutMs: int, body: (s: Stream) => void): Result<void, NetError>  [unstable]",
      "Err if refused by the scope (isDenied), unreachable or timed out; a name is resolved by the OS first (not bounded by timeoutMs)",
      "waits up to timeoutMs",
      "a socket, closed when body returns",
      "useConnection(net, \"127.0.0.1\", 80, 2000, s => { ... });",
    ),
    api(
      "std:net.recv",
      "recv(s: Stream, maxBytes: usize, timeoutMs: int): RecvResult  [unstable]",
      "RecvEof, RecvTimeout, RecvReset, RecvError; never traps; maxBytes 0 is an error",
      "waits up to timeoutMs; O(n) copy of n <= 65536 bytes",
      "allocates the bytes",
      "match (recv(s, 4096, 1000)) { RecvData(b) => ..., _ => ... }",
    ),
    api(
      "std:net.sendAll",
      "sendAll(s: Stream, data: Bytes, timeoutMs: int): Result<void, NetError>  [unstable]",
      "Err(timeout) if the peer does not read fast enough (a deadline for the whole call), Err(reset) if it is gone",
      "O(n); at most timeoutMs",
      "copies data once",
      "sendAll(s, bytesFromString(\"hi\"), 1000)",
    ),
    api(
      "std:net.useConnect",
      "useConnect(net: NetGrant, hostPattern: string, portLo: int, portHi: int, body: (c: NetGrant) => void): void  [unstable]",
      "never fails; a pattern or range outside net's scope gives a grant that reaches nothing",
      "O(1)",
      "none",
      "useConnect(net, \"*.example.com\", 443, 443, c => { ... });",
    ),
    api(
      "std:time.formatIso",
      "formatIso(instant: int): string",
      "never fails",
      "O(1)",
      "allocates result",
      "formatIso(0) // \"1970-01-01T00:00:00.000Z\"",
    ),
    api(
      "std:time.fromMillis",
      "fromMillis(instant: int): DateTime",
      "never fails (UTC)",
      "O(1)",
      "allocates record",
      "fromMillis(nowMillis()).year",
    ),
    mutating(
      api(
        "std:test.assert",
        "assert(cond: bool, msg: string): void",
        "traps with \"assertion failed: <msg>\" (exit 101) when cond is false",
        "O(1)",
        "none",
        "assert(xs.length == 2, \"two items\");",
      ),
    ),
    mutating(
      api(
        "std:test.assertEq",
        "assertEq(actual: int, expected: int, msg: string): void",
        "traps with expected/got when the ints differ; also assertEqUsize, assertEqString, assertEqBool",
        "O(1)",
        "none",
        "assertEq(add(1, 2), 3, \"sum\");",
      ),
    ),
    mutating(
      api(
        "std:test.assertNear",
        "assertNear(actual: float, expected: float, tolerance: float, msg: string): void",
        "traps unless |actual - expected| <= tolerance",
        "O(1)",
        "none",
        "assertNear(0.1 + 0.2, 0.3, 0.000001, \"float\");",
      ),
    ),
    mutating(
      api(
        "std:test.fail",
        "fail(msg: string): void",
        "always traps with msg (exit 101)",
        "O(1)",
        "none",
        "fail(\"unreachable\");",
      ),
    ),
    mutating(
      api(
        "std:fs.withFile",
        "withFile<T>(fs: FsGrant, path: string, mode: FileMode, body: (file: File) => T): Result<T, FsError>  [unstable]",
        "Err when the file cannot be opened (body not run) or any read/write/flush/close on it failed; the file is closed on every path",
        "O(1) + body",
        "allocates Result",
        "withFile(fs, \"a.txt\", Read, f => f.readAll())",
      ),
    ),
    mutating(
      api(
        "std:fs.useFile",
        "useFile(fs: FsGrant, path: string, mode: FileMode, body: (file: File) => void): Result<void, FsError>  [unstable]",
        "as withFile",
        "O(1) + body",
        "allocates Result",
        "useFile(fs, \"a.txt\", Write, f => { f.writeLine(\"hi\"); })",
      ),
    ),
    mutating(
      api(
        "std:fs.withFiles",
        "withFiles<T>(fs: FsGrant, pathA, modeA, pathB, modeB, body: (a: File, b: File) => T): Result<T, FsError>  [unstable]",
        "as withFile; if B cannot be opened A is closed again",
        "O(1) + body",
        "allocates Result",
        "withFiles(fs, src, Read, dst, Write, (a, b) => copy(a, b))",
      ),
    ),
    api(
      "std:host.useHost",
      "useHost(host: Host, body: (fs: FsGrant, proc: ProcessGrant, stdio: StdioGrant, clock: ClockGrant) => void): void  [unstable]",
      "the four root grants of the host policy (ORIN_DENY removes families); revoked when body returns; a grant cannot be captured by a closure (E0452)",
      "O(1) + body",
      "none",
      "useHost(host, (fs, proc, stdio, clock) => { run(fs); })",
    ),
    api(
      "std:host.useFs",
      "useFs(host: Host, body: (fs: FsGrant) => void): void  [unstable]",
      "as useHost for the file system family only (also withFs<T>, useProcess, useStdio, useClock and their with* forms)",
      "O(1) + body",
      "none",
      "useFs(host, fs => { run(fs); })",
    ),
    api(
      "std:fs.useUnder",
      "useUnder(fs: FsGrant, dir: string, body: (sub: FsGrant) => void): void  [unstable]",
      "a grant that reaches only paths inside dir (absolute, normalised, symbolic links resolved); never widens: a dir outside the parent's scope reaches nothing (also withUnder<T>)",
      "O(1) + body",
      "none",
      "useUnder(fs, \"data\", sub => { read(sub); })",
    ),
    api(
      "std:fs.useReadOnly",
      "useReadOnly(fs: FsGrant, body: (ro: FsGrant) => void): void  [unstable]",
      "a grant that cannot create, write or truncate (also withReadOnly<T>)",
      "O(1) + body",
      "none",
      "useReadOnly(fs, ro => { read(ro); })",
    ),
    api(
      "std:fs.readFile",
      "readFile(fs: FsGrant, path: string): Result<string, string>  [unstable]",
      "Err when the file cannot be read or the grant refuses it (host policy, scope)",
      "O(size)",
      "allocates string",
      "readFile(fs, \"a.txt\")",
    ),
    api(
      "std:fs.writeFile",
      "writeFile(fs: FsGrant, path: string, data: string): Result<void, string>  [unstable]",
      "Err when the file cannot be written or the grant refuses it (read-only, scope, policy)",
      "O(size)",
      "none",
      "writeFile(fs, \"a.txt\", \"x\")",
    ),
    mutating(
      api(
        "std:fs.File.readLine",
        "readLine(): Option<string>  (File handle, resource: only a parameter)",
        "None at end of file or after a read error (reported when the scope ends); strips \"\\n\" / \"\\r\\n\"",
        "O(line)",
        "allocates result",
        "f.readLine()",
      ),
    ),
    mutating(
      api(
        "std:fs.File.read",
        "read(n: usize): Option<string>",
        "None only at end of file (n > 0); up to n bytes",
        "O(n)",
        "allocates result",
        "f.read(4096)",
      ),
    ),
    mutating(
      api(
        "std:fs.File.readAll",
        "readAll(): string",
        "\"\" at end of file; read errors are reported when the scope ends",
        "O(rest)",
        "allocates result",
        "f.readAll()",
      ),
    ),
    mutating(
      api(
        "std:fs.File.write",
        "write(s: string): void",
        "an error (disk full, read-only handle) is reported when the scope ends",
        "O(len), buffered",
        "none",
        "f.write(\"x\")",
      ),
    ),
    mutating(
      api(
        "std:fs.File.writeLine",
        "writeLine(s: string): void",
        "as write",
        "O(len), buffered",
        "none",
        "f.writeLine(\"x\")",
      ),
    ),
    mutating(
      api(
        "std:fs.File.flush",
        "flush(): void",
        "an error is reported when the scope ends",
        "O(buffered)",
        "none",
        "f.flush()",
      ),
    ),
    api(
      "std:graph.newGraph",
      "newGraph<T>(tag: int): Graph<T>",
      "never fails",
      "O(1)",
      "allocates graph",
      "const g = newGraph<string>(1);",
    ),
    api(
      "std:graph.add",
      "add<T>(g: Graph<T>, value: T): Added<T>",
      "never fails",
      "O(nodes)",
      "allocates new graph",
      "const r = add(g, \"x\"); // r.graph, r.id",
    ),
    api(
      "std:graph.get",
      "get<T>(g: Graph<T>, id: GraphId<T>): Result<T, GraphError>",
      "Err(StaleId) for a removed node, Err(ForeignId) for another graph",
      "O(1)",
      "allocates Result",
      "get(g, id)?",
    ),
    api(
      "std:graph.set",
      "set<T>(g: Graph<T>, id: GraphId<T>, v: T): Result<Graph<T>, GraphError>",
      "Err(StaleId | ForeignId)",
      "O(nodes)",
      "allocates new graph",
      "g = set(g, id, v)?;",
    ),
    api(
      "std:graph.remove",
      "remove<T>(g: Graph<T>, id: GraphId<T>): Result<Graph<T>, GraphError>",
      "Err(StaleId | ForeignId); invalidates id",
      "O(nodes)",
      "allocates new graph",
      "g = remove(g, id)?;",
    ),
    api(
      "std:graph.addEdge",
      "addEdge<T>(g: Graph<T>, a: GraphId<T>, b: GraphId<T>): Result<Graph<T>, GraphError>",
      "Err(StaleId | ForeignId) for either id",
      "O(nodes)",
      "allocates new graph",
      "g = addEdge(g, a, b)?;",
    ),
    api(
      "std:graph.neighbors",
      "neighbors<T>(g: Graph<T>, id: GraphId<T>): Result<GraphId<T>[], GraphError>",
      "Err(StaleId | ForeignId); dangling edges are skipped",
      "O(out-degree)",
      "allocates array",
      "neighbors(g, id)?",
    ),
  ];
}

// Case-insensitive on the receiver ("array.find" == "Array.find"); `String.` aliases `string.`.
function canon(q: string): string {
  const dot = q.indexOf(".");
  if (dot.isNone()) {
    return q;
  }
  const recv = q.substring(0, dot.unwrap());
  const rest = q.substring(dot.unwrap(), q.length);
  const known: string[] = [
    "string",
    "Array",
    "int",
    "usize",
    "bool",
    "Option",
    "Result",
    "float",
    "Map",
  ];
  // every fixed-width integer type shares the entries of `int` (ADR-0022)
  const intNames: string[] = ["i8", "i16", "i32", "i64", "isize", "u8", "u16", "u32", "u64"];
  for (const k of intNames) {
    if (recvEq(recv, k)) {
      return "int" + rest;
    }
  }
  for (const k of known) {
    if (recvEq(recv, k)) {
      return k + rest;
    }
  }
  return q;
}

function lowerAscii(s: string): string {
  let out = "";
  let i: usize = 0;
  while (i < s.length) {
    const c = s.charCodeAt(i);
    if (c >= 65 && c <= 90) {
      out += String.fromCharCode(c + 32);
    } else {
      out += s.charAt(i);
    }
    i += 1;
  }
  return out;
}

function recvEq(a: string, b: string): bool {
  return lowerAscii(a) == lowerAscii(b);
}

// No two entries of the table share a name (a lookup would silently answer the first).
export function namesDistinct(t: Api[]): bool {
  let i: usize = 0;
  while (i < t.length) {
    let j: usize = 0;
    while (j < i) {
      if (t[i].name == t[j].name) {
        return false;
      }
      j += 1;
    }
    i += 1;
  }
  return true;
}

// The entry for `q`, as compact JSON fields.
@Ensures(result.isSome() ==> getStr(result.unwrap(), "builtin").unwrapOr("") == canon(q))
export function apiLookup(q: string): Option<Json> {
  const c = canon(q);
  for (const a of table()) {
    if (a.name == c) {
      let fs: JField[] = [
        jField("builtin", JStr(a.name)),
        jField("sig", JStr(a.sig)),
        jField("fails", JStr(a.fails)),
        jField("mutates", JStr(a.pure ? "no" : "yes")),
        jField("cost", JStr(a.cost)),
        jField("alloc", JStr(a.alloc)),
        jField("example", JStr(a.example)),
      ];
      if (a.status != "implemented") {
        fs.push(jField("status", JStr(a.status)));
      }
      return Some(JObj(fs));
    }
  }
  return None;
}
