// Generic classes across modules: import, instantiate with local types, bounds from the other module,
// re-exports, instantiations created in both modules are the same type.
import { Ordered, Registry, mk } from "./lib";
import { Box, Ranked } from "./reexport";

class Task implements Ordered {
  prio: int;
  constructor(prio: int) {
    this.prio = prio;
  }
  rank(): int {
    return this.prio;
  }
}

function describe(b: Box<int>): string {
  return "box " + b.get().toString();
}

function main(): void {
  // an instance made by the library function is the same type as one made here
  let b = mk(1);
  console.log(b.put(10).toString() + " " + b.get().toString() + " " + b.count.toString());
  console.log(describe(b) + " / " + describe(new Box(5)));
  console.log(b.reveal().toString());
  // a bound from the library, satisfied by a local class
  let r = new Ranked<Task>();
  r.add(new Task(5));
  r.add(new Task(1));
  r.add(new Task(3));
  console.log(r.size().toString() + " " + r.first().unwrap().rank().toString());
  // generic classes of the library nested in each other and in local types
  const bb = new Box<Ranked<Task>>(r);
  console.log(bb.get().size().toString());
  let reg = new Registry<string, Task>();
  reg.register("a", new Task(7));
  reg.register("b", new Task(8));
  console.log(reg.at(1).rank().toString() + " " + reg.keys.length.toString());
}
