// Interfaces (ADR-0019): declarations, implements lists, bounded type parameters.
export   interface   Shape{
area( ):int ;
   name():string;   // trailing comment
  // a comment before a method
  scale(k:int,other : Shape):Shape;
describeVeryLongSignatureName(firstArgument: string, secondArgument: string, thirdArgument: string): string;
}
interface Empty {}
class Circle   implements Shape,Named{
  constructor(public r: int) {}
  area(): int { return this.r; }
}

export function total<T   extends Shape,U>(xs: T[], u: U): int {
  let t = 0;
  for (const x of xs) { t += x.area(); }
  return t;
}

function main(): void {
  const s: Shape = new Circle(1);
  console.log(s.area().toString());
}
