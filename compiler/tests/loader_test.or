// Unit tests of compiler/diag and compiler/loader (run: `orin test compiler/tests/loader_test.or`).
// `orin test` runs with runtime contract checking, so the contracts of both modules are exercised too.
// The loader is driven through the overlay with virtual paths below /virt (nothing is read from disk).

import { Host, useFs } from "std:host";
import { assert, assertEqString, assertEqUsize, assertEqBool } from "std:test";
import {
  SourceFile, Diagnostic, SourceMap, span, spanTo, diag, render, isValidCode,
} from "../diag";
import {
  loadWithOverlay, LoadOutcome, normalizePath, dirname, joinPath, relativeTo, isInside,
} from "../loader";

function file(path: string, text: string): SourceFile {
  return SourceFile { path: path, text: text };
}

// Names of the user units in load order (the implicit `$array` prelude units are left out).
function userUnits(o: LoadOutcome): string {
  return match (o.program) {
    Some(p) => p.units.filter(u => !u.name.startsWith("$")).map(u => u.name).join(" "),
    None => "failed",
  };
}

function firstDiag(o: LoadOutcome): string {
  return o.diags.length == 0 ? "" : render(o.sm, o.diags[0]);
}

// ---- diag ----------------------------------------------------------------------------------

@Test
function diagCodes(): void {
  assertEqBool(isValidCode("E0400"), true, "E0400");
  assertEqBool(isValidCode("W0440"), true, "W0440");
  assertEqBool(isValidCode("X0440"), false, "letter");
  assertEqBool(isValidCode("E040"), false, "short");
  assertEqBool(isValidCode("E04000"), false, "long");
  assertEqBool(isValidCode("E04a0"), false, "digit");
}

@Test
function renderLineAndColumn(): void {
  const sm = SourceMap { files: [file("a.or", "let x;\n  let y;\n")] };
  assertEqString(
    render(sm, diag("E0300", span(0, 0, 3), "first")),
    "a.or:1:1: error[E0300]: first",
    "start",
  );
  assertEqString(
    render(sm, diag("E0300", span(0, 9, 12), "second")),
    "a.or:2:3: error[E0300]: second",
    "line 2",
  );
  assertEqString(
    render(sm, diag("W0440", span(0, 16, 16), "end")),
    "a.or:3:1: warning[W0440]: end",
    "end of text",
  );
  let d = diag("E0300", span(0, 0, 0), "msg");
  d.notes.push("one");
  d.notes.push("two");
  assertEqString(render(sm, d), "a.or:1:1: error[E0300]: msg\n  note: one\n  note: two", "notes");
}

@Test
function spanToCoversBoth(): void {
  const s = spanTo(span(2, 10, 20), span(2, 5, 12));
  assertEqUsize(s.start, 5, "start");
  assertEqUsize(s.end, 20, "end");
  assertEqUsize(s.file, 2, "file");
}

// ---- paths ---------------------------------------------------------------------------------

@Test
function pathProperties(): void {
  const samples = [
    "",
    ".",
    "a/./b/../c",
    "./a//b/",
    "../a/../../b",
    "/",
    "/a/../..",
    "/a//b/./c/..",
    "a/..",
    "../..",
    "x/y/z.or",
  ];
  for (const s of samples) {
    const n = normalizePath(s);
    assertEqString(normalizePath(n), n, "idempotent " + s);
    assertEqString(dirname(joinPath(n, "q.or")), n, "dirname of join " + s);
    assert(isInside(n, n), "reflexive " + s);
    assert(isInside(n, joinPath(n, "deeper/x.or")) || n.startsWith(".."), "contains children " + s);
  }
  assertEqString(relativeTo("/a/b", "/a/c/d"), "../c/d", "relative");
  assertEqString(joinPath("/a/b", relativeTo("/a/b", "/a/c/d")), "/a/c/d", "round trip");
}

// ---- loader --------------------------------------------------------------------------------

@Test
function dependenciesComeFirst(host: Host): void {
  useFs(
    host,
    fs => {
      const o = loadWithOverlay(
        fs,
        "/virt/main.or",
        [
          file("/virt/main.or", "import { a } from \"./a\";\nimport { b } from \"./b\";\n"),
          file("/virt/a.or", "import { c } from \"./c\";\nexport const a = 1;\n"),
          file("/virt/b.or", "import { c } from \"./c\";\nexport const b = 2;\n"),
          file("/virt/c.or", "export const c = 3;\n"),
        ],
      );
      assertEqUsize(o.diags.length, 0, "no diagnostics");
      assertEqString(userUnits(o), "c a b main", "order: shared dependency once, entry last");
      assertEqString(o.sm.files[0].path, "/virt/main.or", "the entry keeps file id 0");
    },
  );
}

@Test
function overlayShadowsAndFirstWins(host: Host): void {
  useFs(
    host,
    fs => {
      const o = loadWithOverlay(
        fs,
        "/virt/main.or",
        [file("/virt/main.or", "const x = 1;\n"), file("/virt/./main.or", "const x = 2;\n")],
      );
      assertEqString(
        o.sm.files[0].text,
        "const x = 1;\n",
        "first entry for a normalized path wins",
      );
    },
  );
}

@Test
function missingModule(host: Host): void {
  useFs(
    host,
    fs => {
      const o = loadWithOverlay(
        fs,
        "/virt/main.or",
        [file("/virt/main.or", "import { a } from \"./nope\";\n")],
      );
      assertEqString(
        firstDiag(o),
        "/virt/main.or:1:19: error[E0301]: cannot find module `./nope` (tried `/virt/nope.or` and `/virt/nope/module.or`)",
        "E0301",
      );
      assertEqString(
        o.sm.files[0].path,
        "/virt/main.or",
        "the files read so far are in the source map",
      );
    },
  );
}

@Test
function unknownStdModule(host: Host): void {
  useFs(
    host,
    fs => {
      const o = loadWithOverlay(
        fs,
        "/virt/main.or",
        [file("/virt/main.or", "import { x } from \"std:nope\";\n")],
      );
      assert(firstDiag(o).includes("error[E0301]: unknown standard module `std:nope`"), "E0301");
    },
  );
}

@Test
function importCycle(host: Host): void {
  useFs(
    host,
    fs => {
      const o = loadWithOverlay(
        fs,
        "/virt/main.or",
        [
          file("/virt/main.or", "import { a } from \"./a\";\n"),
          file("/virt/a.or", "import { b } from \"./b\";\n"),
          file("/virt/b.or", "import { a } from \"./a\";\n"),
        ],
      );
      assert(
        firstDiag(o).includes("error[E0303]: import cycle: a -> b -> a"),
        "E0303: " + firstDiag(o),
      );
      assertEqUsize(o.diags.length, 1, "one diagnostic");
    },
  );
}

@Test
function privateFileOfModule(host: Host): void {
  useFs(
    host,
    fs => {
      const o = loadWithOverlay(
        fs,
        "/virt/main.or",
        [
          file("/virt/main.or", "import { s } from \"./lib/secret\";\n"),
          file("/virt/lib/module.or", "export { s } from \"./secret\";\n"),
          file("/virt/lib/secret.or", "export const s = 1;\n"),
        ],
      );
      assert(
        firstDiag(o).includes(
          "error[E0302]: cannot import private file `lib/secret` of module `lib`; import the module itself",
        ),
        "E0302: " + firstDiag(o),
      );
      const ok = loadWithOverlay(
        fs,
        "/virt/main.or",
        [
          file("/virt/main.or", "import { s } from \"./lib\";\n"),
          file("/virt/lib/module.or", "export { s } from \"./secret\";\n"),
          file("/virt/lib/secret.or", "export const s = 1;\n"),
        ],
      );
      assertEqString(
        userUnits(ok),
        "lib/secret lib/module main",
        "the module itself may be imported",
      );
    },
  );
}

@Test
function syntaxErrorKeepsFile(host: Host): void {
  useFs(
    host,
    fs => {
      const o = loadWithOverlay(fs, "/virt/main.or", [file("/virt/main.or", "const = ;\n")]);
      assertEqUsize(o.diags.length, 1, "diagnostic");
      assertEqUsize(o.sm.files.length, 1, "the unparsable file is in the source map");
      assert(o.program.isNone(), "no program");
    },
  );
}

const TOML: string = "[package]\nname = \"p\"\nentry = \"main.or\"\n\n[modules.a]\nallowed_dependencies = [\"b\"]\n";

@Test
function packageRules(host: Host): void {
  useFs(
    host,
    fs => {
      const base = [
        file("/virt/orin.toml", TOML),
        file("/virt/main.or", "import { a } from \"./a\";\n"),
        file("/virt/a/module.or", "import { c } from \"../c\";\nexport const a = 1;\n"),
        file("/virt/b/module.or", "export const b = 1;\n"),
        file("/virt/c/module.or", "export const c = 1;\n"),
      ];
      const o = loadWithOverlay(fs, "/virt", base);
      assert(
        firstDiag(o).includes("error[E0501]: module `a` must not import module `c`"),
        "E0501: " + firstDiag(o),
      );
      const unknown = loadWithOverlay(
        fs,
        "/virt",
        [file("/virt/orin.toml", TOML), file("/virt/main.or", "")],
      );
      assert(
        firstDiag(unknown).includes("error[E0502]: unknown module `a` in [modules.a]"),
        "E0502: " + firstDiag(unknown),
      );
      const fine = loadWithOverlay(
        fs,
        "/virt",
        [
          file("/virt/orin.toml", TOML),
          file("/virt/main.or", "import { a } from \"./a\";\n"),
          file("/virt/a/module.or", "import { b } from \"../b\";\nexport const a = 1;\n"),
          file("/virt/b/module.or", "export const b = 1;\n"),
          file("/virt/c/module.or", ""),
        ],
      );
      assertEqUsize(fine.diags.length, 0, "allowed edge");
      assertEqString(
        userUnits(fine),
        "b/module a/module main",
        "unit names relative to the entry directory",
      );
      assert(fine.program.unwrap().manifest.isSome(), "manifest recorded");
    },
  );
}

@Test
function moduleCycle(host: Host): void {
  useFs(
    host,
    fs => {
      const toml = "[package]\nname = \"p\"\nentry = \"main.or\"\n\n[modules.a]\nallowed_dependencies = [\"b\"]\n\n[modules.b]\nallowed_dependencies = [\"a\"]\n";
      const o = loadWithOverlay(
        fs,
        "/virt",
        [
          file("/virt/orin.toml", toml),
          file("/virt/main.or", "import { a } from \"./a\";\n"),
          file(
            "/virt/a/module.or",
            "import { x } from \"./impl\";\nimport { b } from \"../b\";\nexport const a = 1;\n",
          ),
          file("/virt/a/impl.or", "export const x = 1;\n"),
          file("/virt/b/module.or", "import { a } from \"../a/module\";\nexport const b = 1;\n"),
        ],
      );
      assert(o.diags.length == 1 && o.diags[0].code == "E0303", "one E0303: " + firstDiag(o));
    },
  );
}
