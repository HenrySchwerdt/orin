// Several bounds on one type parameter, `T extends Ord & Hash` (ADR-0034 limit lifted, ADR-0040 addendum): the operators and
// the methods of every bound work on the parameter, and a type argument has to satisfy all of them.
type Version = { major: int; minor: int; };
type Tag = Plain(string) | Numbered(int);

// equality, order and hash look at `id` only: the label is not part of the identity (tier 2, explicit instances)
class Name {
  constructor(public id: int, public text: string) {}
  equals(other: Name): bool { return this.id == other.id; }
  compare(other: Name): int { return this.id < other.id ? -1 : (this.id > other.id ? 1 : 0); }
  hash(): usize { return this.id.toUsize(); }
}

// a sorted set of distinct values: ordered by `<`, deduplicated through a `Map` (needs `Hash`)
class OrderedSet<T extends Ord & Hash> {
  items: T[] = [];
  seen: Map<T, bool> = new Map<T, bool>();
  add(x: T): bool {
    if (this.seen.has(x)) {
      return false;
    }
    this.seen.set(x, true);
    let i: usize = 0;
    while (i < this.items.length && this.items[i] < x) {
      i += 1;
    }
    this.items = this.items.slice(0, i).concat([x]).concat(this.items.slice(i, this.items.length));
    return true;
  }
  size(): usize { return this.items.length; }
  at(i: usize): T { return this.items[i]; }
  first(): T { return this.items[0]; }
  last(): T { return this.items[this.items.length - 1]; }
}

function uniqueSorted<T extends Ord & Hash>(xs: T[]): T[] {
  let s = new OrderedSet<T>();
  for (const x of xs) {
    s.add(x);
  }
  return s.items;
}

function bucket<K extends Hash & Ord>(a: K, b: K, buckets: usize): usize {
  return a.compare(b) <= 0 ? a.hash() % buckets : b.hash() % buckets;
}

function sameHash<T extends Ord & Hash>(a: T, b: T): bool {
  return a == b && a.hash() == b.hash() && a.compare(b) == 0;
}

function largest<T extends Eq & Ord & Hash>(xs: T[]): T {
  let best = xs[0];
  for (const x of xs) {
    if (x > best) {
      best = x;
    }
  }
  return best;
}

function main(): void {
  console.log(uniqueSorted([5, 3, 5, 1, 3, 9]).map(x => x.toString()).join(","));
  console.log(uniqueSorted(["pear", "apple", "pear", "fig"]).join(","));
  const vs = uniqueSorted([
    Version { major: 1, minor: 10 },
    Version { major: 1, minor: 4 },
    Version { major: 2, minor: 0 },
    Version { major: 1, minor: 4 },
  ]);
  console.log(vs.map(v => `${v.major}.${v.minor}`).join(" "));
  let tags = new OrderedSet<Tag>();
  tags.add(Numbered(7));
  tags.add(Plain("b"));
  tags.add(Plain("a"));
  tags.add(Numbered(7));
  console.log(tags.size().toString());
  match (tags.first()) {
    Plain(s) => { console.log("first plain " + s); },
    Numbered(n) => { console.log("first numbered " + n.toString()); },
  }
  match (tags.last()) {
    Plain(s) => { console.log("last plain " + s); },
    Numbered(n) => { console.log("last numbered " + n.toString()); },
  }
  let names = new OrderedSet<Name>();
  console.log(names.add(new Name(2, "Bob")).toString());
  console.log(names.add(new Name(1, "alice")).toString());
  console.log(names.add(new Name(2, "BOB")).toString());
  console.log(names.at(0).text + " " + names.at(1).text);
  console.log(sameHash(3, 3).toString());
  console.log(sameHash("a", "b").toString());
  console.log(sameHash(new Name(5, "Zed"), new Name(5, "zED")).toString());
  console.log(largest([2, 8, 4]).toString());
  console.log((bucket(10, 20, 7) < 7).toString());
  console.log((bucket("x", "y", 1)).toString());
  console.log((new OrderedSet<int>()).size().toString());
}
