import { newGraph, add, get, set, remove, neighbors, addEdge, graphErrorMessage, GraphError } from "std:graph";

function msg<T>(r: Result<T, GraphError>): string {
  return match (r) {
    Ok(v) => "ok",
    Err(e) => graphErrorMessage(e)
  };
}

function main(): void {
  const g1 = newGraph<int>(1);
  const g2 = newGraph<int>(2);
  const a1 = add(g1, 100);
  const a2 = add(g2, 200);
  console.log(msg(get(a2.graph, a1.id)));
  console.log(msg(get(a1.graph, a2.id)));
  console.log(msg(set(a2.graph, a1.id, 1)));
  console.log(msg(remove(a2.graph, a1.id)));
  console.log(msg(neighbors(a2.graph, a1.id)));
  console.log(msg(addEdge(a1.graph, a1.id, a2.id)));
  console.log(msg(get(a1.graph, a1.id)));
  // Same tag but an id naming a slot beyond the (empty) graph is foreign as well.
  const g3 = newGraph<int>(1);
  console.log(msg(get(g3, a1.id)));
}
