type Pair<A, B> = { first: A; second: B; };

function swap<A, B>(p: Pair<A, B>): Pair<B, A> {
  return Pair<B, A> { first: p.second, second: p.first };
}

function firstOr<T>(xs: T[], fallback: T): T {
  return xs.get(0).unwrapOr(fallback);
}

function main(): void {
  const p = Pair<int, string> { first: 1, second: "one" };
  const q = swap(p);
  console.log(q.first + " / " + q.second.toString());
  const empty: string[] = [];
  console.log(firstOr(empty, "nothing here"));
}
