import { Graph } from "std:graph";

function main(): void {
  let g = new Graph<int>(4);
  const a = g.add(1);
  const g1 = g;
  const b = g.add(2);
  const g2 = g;
  // g2 is a different value from g1; changing g never changes a copy taken earlier.
  g.set(a, 99).unwrap();
  const g3 = g;
  console.log(g2.get(a).unwrap().toString() + " " + g3.get(a).unwrap().toString());
  g.remove(a).unwrap();
  const g4 = g;
  console.log(g1.size().toString() + g2.size().toString() + g3.size().toString() + g4.size().toString());
  // The old version still holds the node; the new one rejects the id.
  console.log(g3.get(a).isOk().toString() + " " + g4.get(a).isErr().toString());
  console.log(g1.get(b).isErr().toString() + " " + g2.get(b).isOk().toString());
  // a graph passed to a function is not changed by the callee's copy
  console.log(grow(g4).toString() + " " + g4.size().toString());
}

function grow(g0: Graph<int>): usize {
  let g = g0;
  g.add(7);
  g.add(8);
  return g.size();
}
