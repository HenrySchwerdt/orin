// Program-level C generation: string-literal table, declarations, bodies, main().
// Port of `generate` in bootstrap/src/codegen.rs.

import {
  Type, Program, Function, HBlock, HStmt, Place, PlaceElem, HExpr, HExprKind, FieldInitH, HArm,
  HPattern
} from "../hir";
import { Lits, newLits, findLit, litBucket, cty, sanitize, cString, commentSafe } from "./cutil";
import { Env, genFunction } from "./cexpr";

// ---------------------------------------------------------------- literal collection
// Stage 0 interns literals while generating. Orin-B has no mutable state, so all string
// literals (expressions and patterns) are collected up front, in a fixed traversal order;
// the table is deterministic for a given HIR.

function lexprs(xs: HExpr[]): string[] {
  let out: string[] = [];
  for (const x of xs) {
    out = out.concat(lexpr(x));
  }
  return out;
}

function lblock(b: HBlock): string[] {
  let out: string[] = [];
  for (const s of b.stmts) {
    out = out.concat(lstmt(s));
  }
  return out;
}

function lplace(p: Place): string[] {
  let out: string[] = [];
  for (const el of p.path) {
    match (el) {
      PIndex(ix) => {
        out = out.concat(lexpr(ix));
      },
      PField(_, _) => {}
    }
  }
  return out;
}

function lopt(o: Option<HExpr>): string[] {
  return match (o) {
    Some(x) => lexpr(x),
    None => []
  };
}

function lstmt(s: HStmt): string[] {
  return match (s) {
    HLet(_, e) => lexpr(e),
    HAssign(p, _, e) => lplace(p).concat(lexpr(e)),
    HExprStmt(e) => lexpr(e),
    HIf(c, t, el) => lexpr(c).concat(lblock(t)).concat(lblockOpt(el)),
    HWhile(c, b) => lexpr(c).concat(lblock(b)),
    HForOf(_, it, b) => lexpr(it).concat(lblock(b)),
    HBreak => [],
    HContinue => [],
    HReturn(e) => lopt(e),
    HBlockStmt(b) => lblock(b)
  };
}

function lblockOpt(b: Option<HBlock>): string[] {
  return match (b) {
    Some(x) => lblock(x),
    None => []
  };
}

function larm(a: HArm): string[] {
  const pat: string[] = match (a.pattern) {
    HPStr(s) => [s],
    _ => []
  };
  return pat.concat(lblock(a.body)).concat(lopt(a.value));
}

function lexpr(e: HExpr): string[] {
  return match (e.kind) {
    XInt(_) => [],
    XBool(_) => [],
    XStr(s) => [s],
    XLocal(_) => [],
    XUnary(_, x) => lexpr(x),
    XBinary(_, a, b) => lexpr(a).concat(lexpr(b)),
    XCall(_, args) => lexprs(args),
    XBuiltin(_, args) => lexprs(args),
    XMutMethod(_, p, args) => lplace(p).concat(lexprs(args)),
    XField(b, _, _) => lexpr(b),
    XIndex(b, i) => lexpr(b).concat(lexpr(i)),
    XRecord(_, sp, fields) => lopt(sp).concat(lfields(fields)),
    XVariant(_, payload) => lexprs(payload),
    XArray(xs) => lexprs(xs),
    XTry(x) => lexpr(x),
    XCond(c, a, b) => lexpr(c).concat(lexpr(a)).concat(lexpr(b)),
    XMatch(s, arms) => lexpr(s).concat(larms(arms)),
    XClosure(_, caps) => lexprs(caps),
    XCallIndirect(f, args) => lexpr(f).concat(lexprs(args))
  };
}

function lfields(fs: FieldInitH[]): string[] {
  let out: string[] = [];
  for (const f of fs) {
    out = out.concat(lexpr(f.value));
  }
  return out;
}

function larms(arms: HArm[]): string[] {
  let out: string[] = [];
  for (const a of arms) {
    out = out.concat(larm(a));
  }
  return out;
}

function collectLits(prog: Program): Lits {
  let lits = newLits();
  for (const f of prog.functions) {
    for (const s of lblock(f.body)) {
      if (findLit(lits, s).isNone()) {
        const id = lits.strs.length;
        lits.strs.push(s);
        lits.buckets[litBucket(s)].push(id);
      }
    }
  }
  return lits;
}

// ---------------------------------------------------------------- signatures

function signature(name: string, f: Function): string {
  let s = cty(f.ret) + " " + name + "(";
  if (f.paramCount == 0) {
    s += "void";
  }
  let i: usize = 0;
  while (i < f.paramCount) {
    if (i > 0) {
      s += ", ";
    }
    s += cty(f.locals[i].ty) + " l" + i.toString();
    i += 1;
  }
  s += ")";
  return s;
}

// The legacy backend (--legacy-codegen) predates closures (ADR-0011) and does not implement them.
// Lifted closure functions (arrow bodies, function-value wrappers) are named `...$closure<N>` /
// `...$closure`; a program that has one is rejected by the driver with an internal-error message.
export function supportsLegacy(prog: Program): bool {
  for (const f of prog.functions) {
    if (f.name.includes("$closure")) {
      return false;
    }
  }
  return true;
}

export function generate(prog: Program): string {
  const lits = collectLits(prog);
  let names: string[] = [];
  let i: usize = 0;
  for (const f of prog.functions) {
    names.push("orin_fn_" + i.toString() + "_" + sanitize(f.name));
    i += 1;
  }
  let sigs: string[] = [];
  i = 0;
  while (i < prog.functions.length) {
    sigs.push(signature(names[i], prog.functions[i]));
    i += 1;
  }
  let out: string[] = [];
  out.push("/* Generated by orinc (Orin Stage 1). Do not edit. */\n#include \"orin_runtime.h\"\n#include \"orin_runtime_io.h\"\n\n");
  i = 0;
  while (i < lits.strs.length) {
    const s = lits.strs[i];
    out.push("ORIN_STRING_LIT(orin_s" + i.toString() + ", " + s.length.toString() + ", " + cString(s) + ");\n");
    i += 1;
  }
  out.push("\n");
  for (const sg of sigs) {
    out.push(sg + ";\n");
  }
  out.push("\n");
  i = 0;
  while (i < prog.functions.length) {
    const env = Env { prog: prog, names: names, func: prog.functions[i], lits: lits };
    out.push(genFunction(env, sigs[i]));
    out.push("\n");
    i += 1;
  }
  out.push("int main(int argc, char **argv) {\n  orin_init(argc, argv);\n  " + names[prog.main]
    + "();\n  orin_flush();\n  return 0;\n}\n");
  return out.join("");
}
