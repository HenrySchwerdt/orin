// ADR-0040: generic methods on classes and on generic classes. A method declares type parameters of its own, inferred
// from the arguments (or the expected type) or given explicitly, `obj.m<int>(..)`. An instance is keyed by
// (class instance, method, type arguments).
interface Named {
  name(): string;
}

class Dog implements Named {
  n: string;
  count: int = 0;

  constructor(n: string) {
    this.n = n;
  }

  name(): string {
    return this.n;
  }

  // a class may implement an interface and have additional generic methods
  id<T>(x: T): T {
    return x;
  }

  first<A, B>(a: A, b: B): A {
    return a;
  }

  // a type parameter that only the result mentions has to be explicit (or come from the expected type)
  empty<T>(): T[] {
    return [];
  }

  // a bound of the method's own parameter
  bump<T extends Named>(o: T): int {
    this.count += 1;
    return this.count + o.name().length.toInt();
  }

  larger<K extends Ord>(a: K, b: K): K {
    return a < b ? b : a;
  }

  same<K extends Eq>(a: K, b: K): bool {
    return a == b;
  }

  static wrap<T>(x: T): T[] {
    return [x, x];
  }
}

class Box<T> {
  v: T;

  constructor(v: T) {
    this.v = v;
  }

  // the method's parameters come after the class's; the class's are fixed by the receiver
  map<U>(f: (x: T) => U): Box<U> {
    return new Box<U>(f(this.v));
  }

  zip<U>(u: U): Box<U[]> {
    return new Box<U[]>([u]);
  }

  setIf<U>(x: T, tag: U): int {
    this.v = x;
    return 1;
  }
}

function main(): void {
  const d = new Dog("rex");
  console.log(d.id(5).toString());
  console.log(d.id<string>("hi"));
  console.log(d.first(1, "a").toString());
  const e: int[] = d.empty();
  console.log(e.length.toString());
  console.log(d.empty<string>().length.toString());
  let m = new Dog("ab");
  console.log(m.bump(d).toString());
  console.log(m.bump(m).toString());
  console.log(d.larger(3, 9).toString());
  console.log(d.larger("pear", "apple"));
  console.log(d.same("x", "x").toString());
  console.log(Dog.wrap(7).length.toString());
  console.log(Dog.wrap<string>("q")[1]);

  const b = new Box<int>(4);
  const c = b.map(x => x + 1);
  console.log(c.v.toString());
  const s = b.map<string>(x => "s" + x.toString());
  console.log(s.v);
  console.log(b.zip(true).v.length.toString());
  let mb = new Box<int>(1);
  console.log(mb.setIf(9, "t").toString());
  console.log(mb.v.toString());
  // the same method at two instances of the class
  const bs = new Box<string>("z");
  console.log(bs.map(x => x + "!").v);
}
