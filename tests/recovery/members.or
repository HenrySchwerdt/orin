// Class and interface members recover at the next member.
interface Shape {
  area(): int { return 0; }
  name(: string): string;
  sides(): int;
}

class Square implements Shape {
  private s: int = ;
  constructor(s: int) { this.s = s; }
  area(): int { return this.s * this.s }
  name(p: string): string { return p; }
  sides(): int { return 4; }
}

function main(): void {}
