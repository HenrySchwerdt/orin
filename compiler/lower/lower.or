// HIR -> MIR lowering entry point (see body.or).

import { Program } from "../hir";
import { MProgram, MFunction, MVTable } from "../mir";
import { collectLits } from "./util";
import { lowerFunction } from "./body";
import { preludeIds } from "./prelude";

export function lower(prog: Program): MProgram {
  let lits = collectLits(prog);
  lits.pre = preludeIds(prog);
  let fns: MFunction[] = [];
  let i: usize = 0;
  while (i < prog.functions.length) {
    fns.push(lowerFunction(prog, i, lits));
    i += 1;
  }
  let vts: MVTable[] = [];
  for (const v of prog.vtables) {
    vts.push(MVTable { name: v.name, funcs: v.funcs });
  }
  return MProgram { functions: fns, strings: lits.strs, main: prog.main, vtables: vts, inlineFns: prog.inlineFns };
}
