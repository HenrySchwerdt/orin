class Counter {
  private counts: Map<string, int> = new Map<string, int>();
  constructor() {
  }
  add(key: string): void {
    this.counts.set(key, this.counts.get(key).unwrapOr(0) + 1);
  }
  count(key: string): int {
    return this.counts.get(key).unwrapOr(0);
  }
  distinct(): usize {
    return this.counts.size;
  }
  forget(key: string): bool {
    return this.counts.delete(key);
  }
}

function main(): void {
  let c = new Counter();
  c.add("a");
  c.add("b");
  c.add("a");
  console.log(c.count("a").toString() + " " + c.count("b").toString() + " " + c.count("z").toString());
  console.log(c.distinct().toString());
  const snapshot = c;
  c.add("c");
  console.log(snapshot.distinct().toString() + " " + c.distinct().toString());
  console.log(c.forget("a").toString());
  console.log(c.forget("a").toString());
  console.log(c.distinct().toString());
}
