// GENERATED by tooling/explorer/gen_assets.sh from theme/runs.css. Do not edit; edit the source and regenerate.

export const RUNS_CSS: string = "/* Styles of the run history on the Processes page (ADR-0050, step Processes with data). Source of truth for src/runs_css.or\n   (tooling/explorer/gen_assets.sh). Written to assets/runs.css and linked only when the explorer is given --runs, so a\n   site without a history is byte-identical to one made before runs existed. Colours come from the page tokens, so the\n   SVG charts follow light and dark mode. */\n:root {\n  --rn-bar: #2a6fd6;\n  --rn-bar-bg: #e4ecf8;\n  --rn-line: #2a6fd6;\n  --rn-up: #a9561a;\n  --rn-down: #1a7a45;\n}\n@media (prefers-color-scheme: dark) {\n  :root {\n    --rn-bar: #6aa4ff;\n    --rn-bar-bg: #1b2a44;\n    --rn-line: #6aa4ff;\n    --rn-up: #f0a468;\n    --rn-down: #7fd6a0;\n  }\n}\n.rn-svg { display: block; max-width: 100%; height: auto; margin: 0 auto; font-family: var(--r-sans); }\n.rn-t { fill: var(--r-ink); }\n.rn-t2 { fill: var(--r-ink-2); }\n.rn-track { fill: var(--rn-bar-bg); stroke: none; }\n.rn-bar { fill: var(--rn-bar); stroke: none; }\n.rn-spark { fill: none; stroke: var(--rn-line); stroke-linecap: round; stroke-linejoin: round; }\n.rn-axis { stroke: var(--r-line); stroke-width: 1; }\n.rn-dot { fill: var(--r-surface); stroke: var(--rn-line); stroke-width: 2; }\n.rn-dot-last { fill: var(--rn-line); stroke: var(--rn-line); stroke-width: 2; }\n.rn-up { fill: var(--rn-up); }\n.rn-down { fill: var(--rn-down); }\n.rn-build { margin-top: 1.6rem; }\n.rn-build > h3 { text-transform: none; letter-spacing: 0; font-size: 1rem; color: var(--r-ink); }\n.rn-meta { margin: 0 0 0.5rem; color: var(--r-ink-2); font-size: 0.88rem; }\n.rn-commit { font-family: var(--r-mono); font-size: 0.88em; }\n.rn-was { color: var(--r-ink-2); font-size: 0.85rem; }\n";
