// ADR-0010: a function that returns an updated version of its argument (`st = add(st, i)`) must
// run in linear time: the argument is passed by move and the callee owns it, so the in-place
// push never copies (ORIN_STATS cow_copies stays ~0; it was one full copy per call before).
type State = { items: int[]; n: int; };

function add(s: State, x: int): State {
  let t = s;
  t.items.push(x);
  t.n += 1;
  return t;
}

function main(): void {
  let st = State { items: [], n: 0 };
  let i = 0;
  while (i < 200000) {
    st = add(st, i);
    i += 1;
  }
  console.log(st.n.toString());
  console.log(st.items.length.toString());
  console.log(st.items[199999].toString());
}
