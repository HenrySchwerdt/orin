type Stack<T> = { items: T[]; };

function pushAll<T>(xs: T[], ys: T[]): T[] {
  let out = xs;
  for (const y of ys) {
    out.push(y);
  }
  return out;
}

function setAt<T>(xs: T[], i: usize, v: T): T[] {
  let out = xs;
  out[i] = v;
  return out;
}

function popTop<T>(s: Stack<T>): Option<T> {
  let st = s;
  return st.items.pop();
}

function swapEnds<T>(xs: T[]): T[] {
  if (xs.length < 2) {
    return xs;
  }
  let out = xs;
  const a = out[0];
  out[0] = out[out.length - 1];
  out[out.length - 1] = a;
  return out;
}

function main(): void {
  const xs = [1, 2];
  const ys = pushAll(xs, [3, 4]);
  console.log(xs.length.toString() + ys.length.toString());
  const zs = setAt(["a", "b", "c"], 1, "X");
  console.log(zs.join(""));
  const s = Stack { items: [1, 2, 3] };
  console.log(popTop(s).unwrap().toString());
  console.log(s.items.length.toString());
  console.log(swapEnds(["l", "m", "r"]).join(""));
}
