// Renderers of an OSIG diff (ADR-0023): text, JSON ("osig-diff/0.2") and one self-contained HTML file.
// All of them list exactly what `diffOsig` found; nothing is added or upgraded here.

import { OsigGraph, ONode, OEdge, OSpan } from "./osig";
import {
  OsigDiff, SymChange, PathStep, ImpactPath, Reach, EdgeFinding, Rename, EffectChange, ModuleEffectChange, hasDifferences, MAX_FINDINGS
} from "./osigdiff";
import { Json, JBool, JNum, JStr, JArr, JObj, jField, stringifyJson } from "../json";

// 0.2: adds the effect sections (`effectsComparable`, `effectChanges`, `moduleEffects`).
export const DIFF_SCHEMA: string = "osig-diff/0.2";

function loc(s: OSpan): string {
  return s.file == "" ? "-" : s.file + ":" + s.line.toString();
}

function plural(n: usize, one: string, many: string): string {
  return n.toString() + " " + (n == 1 ? one : many);
}

function summaryLine(d: OsigDiff): string {
  return plural(d.addedSyms.length, "symbol", "symbols") + " added, " + plural(d.removedSyms.length, "symbol", "symbols")
    + " removed, " + plural(d.changed.length, "symbol", "symbols") + " changed; " + plural(d.addedEdges.length, "edge", "edges")
    + " added, " + plural(d.removedEdges.length, "edge", "edges") + " removed; " + plural(d.renames.length, "possible rename", "possible renames")
    + " (heuristic); " + plural(countKind(d, "added"), "effect", "effects") + " added, " + plural(countKind(d, "removed"), "effect", "effects")
    + " removed";
}

function countKind(d: OsigDiff, kind: string): usize {
  let n: usize = 0;
  for (const c of d.effectChanges) {
    if (c.kind == kind) {
      n += 1;
    }
  }
  return n;
}

function effLabel(c: EffectChange): string {
  return c.op + (c.dir == "" ? "" : " " + c.dir);
}

// The effect section: per module, then per function with the explanation path.
function effectLines(d: OsigDiff): string[] {
  let out: string[] = [];
  if (!d.effectsComparable) {
    out.push("");
    out.push("effect changes: not compared (a snapshot has no effect summaries; they exist from osig/0.2 on)");
    return out;
  }
  if (d.effectChanges.length == 0 && d.moduleEffects.length == 0) {
    return out;
  }
  out.push("");
  out.push("effect changes (transitive primitive effects; new or removed per module and function):");
  for (const m of d.moduleEffects) {
    out.push("  module " + m.module + ":");
    for (const a of m.added) {
      out.push("    + " + a);
    }
    for (const r of m.removed) {
      out.push("    - " + r);
    }
  }
  for (const c of d.effectChanges) {
    const mark = c.kind == "added" ? "+" : (c.kind == "removed" ? "-" : "~");
    out.push("  " + mark + " " + c.fn + "  " + effLabel(c) + " [" + c.ev + "]" + (c.kind == "evidence" ? " (was " + c.was + ")" : "")
      + (c.kind == "removed" ? "  (in base)" : ""));
    let k: usize = 0;
    while (k < c.path.length) {
      out.push("      " + (k == 0 ? "" : "-> ") + c.path[k].node + "  (" + loc(c.path[k].span) + ")");
      k += 1;
    }
    for (const p of c.reach.paths) {
      out.push("      reached from entry point " + p.steps[0].node + " [" + p.ev + "]");
    }
  }
  return out;
}

// ---- text ------------------------------------------------------------------------------------------------

function pathLines(p: ImpactPath, indent: string, last: string): string[] {
  let out: string[] = [];
  let i: usize = 0;
  while (i < p.steps.length) {
    const s = p.steps[i];
    if (i == 0) {
      out.push(indent + "entry " + s.node + "  (" + loc(s.span) + ")");
    } else {
      out.push(indent + "  -> " + s.via + " [" + s.ev + "] " + s.node + "  (" + loc(s.span) + ")");
    }
    i += 1;
  }
  if (last != "") {
    out.push(indent + "  -> " + last);
  }
  return out;
}

function reachLines(r: Reach, indent: string, last: string, none: string): string[] {
  let out: string[] = [];
  if (r.paths.length == 0) {
    out.push(indent + none);
    return out;
  }
  for (const p of r.paths) {
    out.push(indent + "path [" + p.ev + "]:");
    for (const l of pathLines(p, indent + "  ", last)) {
      out.push(l);
    }
  }
  if (r.truncated) {
    out.push(indent + "(more entry points not listed)");
  }
  return out;
}

function edgeText(e: OEdge): string {
  return e.kind + " [" + e.ev + "]" + (e.via == "" ? "" : " (" + e.via + ")") + " " + e.src + " -> " + e.dst + "  (" + loc(e.span) + ")";
}

export function diffText(d: OsigDiff): string {
  let out: string[] = [];
  out.push("OSIG diff (" + DIFF_SCHEMA + ")");
  out.push("base: " + d.base.package + " " + d.base.hash);
  out.push("head: " + d.head.package + " " + d.head.hash);
  if (!hasDifferences(d)) {
    out.push("no differences");
    return out.join("\n") + "\n";
  }
  out.push("summary: " + summaryLine(d));
  if (d.changed.length > 0) {
    out.push("");
    out.push("changed symbols:");
    for (const c of d.changed) {
      out.push("  [" + c.aspects.join(", ") + "] " + c.kind + " " + c.id + "  (" + loc(c.node.span) + ")");
      if (c.before != c.after) {
        out.push("      - " + c.before);
        out.push("      + " + c.after);
      }
    }
  }
  if (d.addedSyms.length > 0) {
    out.push("");
    out.push("added symbols:");
    for (const n of d.addedSyms) {
      out.push("  + " + n.kind + " " + n.id + "  (" + loc(n.span) + ")" + (n.sig != "" ? "  " + n.sig : ""));
    }
  }
  if (d.removedSyms.length > 0) {
    out.push("");
    out.push("removed symbols:");
    for (const n of d.removedSyms) {
      out.push("  - " + n.kind + " " + n.id + "  (" + loc(n.span) + ")" + (n.sig != "" ? "  " + n.sig : ""));
    }
  }
  if (d.renames.length > 0) {
    out.push("");
    out.push("possible renames (HEURISTIC, not proven identity; the symbols above are listed as removed and added):");
    for (const r of d.renames) {
      out.push("  ? " + r.kind + " " + r.was + " => " + r.now + "  confidence " + r.confidence + (r.ambiguous ? ", ambiguous" : "")
        + "; basis: " + r.basis.join(", "));
    }
  }
  if (d.addedEdges.length > 0) {
    out.push("");
    out.push("added edges:");
    for (const e of d.addedEdges) {
      out.push("  + " + edgeText(e));
    }
  }
  if (d.removedEdges.length > 0) {
    out.push("");
    out.push("removed edges:");
    for (const e of d.removedEdges) {
      out.push("  - " + edgeText(e));
    }
  }
  for (const l of effectLines(d)) {
    out.push(l);
  }
  if (d.newPaths.length > 0) {
    out.push("");
    out.push("new call paths (entry points of head that reach the new call):");
    for (const f of d.newPaths) {
      out.push("  " + f.edge.kind + " [" + f.edge.ev + "] " + f.edge.src + " -> " + f.edge.dst + "  (" + loc(f.edge.span) + ")");
      for (const l of reachLines(f.reach, "    ", f.edge.kind + (f.edge.via == "" ? "" : "/" + f.edge.via) + " [" + f.edge.ev + "] "
          + f.edge.dst + "  (" + loc(f.edge.span) + ")  <- NEW", "no entry point reaches the caller (in the analysed edges)")) {
        out.push(l);
      }
    }
  }
  if (d.goneCalls.length > 0) {
    out.push("");
    out.push("removed call paths (entry points of base that reached the removed call):");
    for (const f of d.goneCalls) {
      out.push("  " + f.edge.kind + " [" + f.edge.ev + "] " + f.edge.src + " -> " + f.edge.dst + "  (" + loc(f.edge.span) + " in base)");
      for (const l of reachLines(f.reach, "    ", f.edge.kind + " [" + f.edge.ev + "] " + f.edge.dst + "  <- REMOVED",
          "no entry point reached the caller (in the analysed edges)")) {
        out.push(l);
      }
    }
  }
  if (d.impact.length > 0) {
    out.push("");
    out.push("impact of changed symbols on entry points:");
    for (const r of d.impact) {
      out.push("  " + r.target);
      for (const l of reachLines(r, "    ", "", "no entry point reaches it (in the analysed edges)")) {
        out.push(l);
      }
    }
  }
  if (d.truncated) {
    out.push("");
    out.push("note: findings capped at " + MAX_FINDINGS.toString() + " per section");
  }
  out.push("");
  out.push("note: absence of an edge or path is not proof of absence; calls through function values are MAY / UNKNOWN edges");
  return out.join("\n") + "\n";
}

// ---- JSON ------------------------------------------------------------------------------------------------

function spanJ(s: OSpan): Json {
  return JObj([
    jField("file", JStr(s.file)), jField("line", JNum(s.line.toInt())), jField("col", JNum(s.col.toInt())),
    jField("endLine", JNum(s.endLine.toInt())), jField("endCol", JNum(s.endCol.toInt()))
  ]);
}

function strsJ(xs: string[]): Json {
  let out: Json[] = [];
  for (const x of xs) {
    out.push(JStr(x));
  }
  return JArr(out);
}

function nodeJ(n: ONode): Json {
  return JObj([
    jField("id", JStr(n.id)), jField("kind", JStr(n.kind)), jField("sig", JStr(n.sig)), jField("exported", JBool(n.exported)),
    jField("entry", JBool(n.entry)), jField("span", spanJ(n.span))
  ]);
}

function edgeJ(e: OEdge): Json {
  return JObj([
    jField("kind", JStr(e.kind)), jField("src", JStr(e.src)), jField("dst", JStr(e.dst)), jField("evidence", JStr(e.ev)),
    jField("via", JStr(e.via)), jField("span", spanJ(e.span))
  ]);
}

function stepJ(s: PathStep): Json {
  return JObj([jField("node", JStr(s.node)), jField("via", JStr(s.via)), jField("evidence", JStr(s.ev)), jField("span", spanJ(s.span))]);
}

function reachJ(r: Reach): Json {
  let ps: Json[] = [];
  for (const p of r.paths) {
    let ss: Json[] = [];
    for (const s of p.steps) {
      ss.push(stepJ(s));
    }
    ps.push(JObj([jField("evidence", JStr(p.ev)), jField("steps", JArr(ss))]));
  }
  return JObj([jField("target", JStr(r.target)), jField("truncated", JBool(r.truncated)), jField("entryPaths", JArr(ps))]);
}

function findingJ(f: EdgeFinding): Json {
  return JObj([jField("edge", edgeJ(f.edge)), jField("reach", reachJ(f.reach))]);
}

function effectJ(c: EffectChange): Json {
  let ps: Json[] = [];
  for (const p of c.path) {
    ps.push(JObj([jField("function", JStr(p.node)), jField("evidence", JStr(p.ev)), jField("span", spanJ(p.span))]));
  }
  return JObj([
    jField("kind", JStr(c.kind)), jField("function", JStr(c.fn)), jField("module", JStr(c.module)), jField("operation", JStr(c.op)),
    jField("direction", JStr(c.dir)), jField("evidence", JStr(c.ev)), jField("was", JStr(c.was)), jField("span", spanJ(c.span)),
    jField("path", JArr(ps)), jField("reach", reachJ(c.reach))
  ]);
}

function listLines(key: string, items: Json[], last: bool): string[] {
  let out: string[] = ["\"" + key + "\": ["];
  let i: usize = 0;
  while (i < items.length) {
    out.push("  " + stringifyJson(items[i]) + (i + 1 < items.length ? "," : ""));
    i += 1;
  }
  out.push(last ? "]" : "],");
  return out;
}

export function diffJson(d: OsigDiff): string {
  let lines: string[] = ["{"];
  lines.push("\"schema\": " + stringifyJson(JStr(DIFF_SCHEMA)) + ",");
  lines.push("\"base\": " + stringifyJson(JObj([jField("package", JStr(d.base.package)), jField("hash", JStr(d.base.hash))])) + ",");
  lines.push("\"head\": " + stringifyJson(JObj([jField("package", JStr(d.head.package)), jField("hash", JStr(d.head.hash))])) + ",");
  lines.push("\"differences\": " + stringifyJson(JBool(hasDifferences(d))) + ",");
  lines.push("\"effectsComparable\": " + stringifyJson(JBool(d.effectsComparable)) + ",");
  lines.push("\"summary\": " + stringifyJson(JObj([
    jField("added", JNum(d.addedSyms.length.toInt())), jField("removed", JNum(d.removedSyms.length.toInt())),
    jField("changed", JNum(d.changed.length.toInt())), jField("addedEdges", JNum(d.addedEdges.length.toInt())),
    jField("removedEdges", JNum(d.removedEdges.length.toInt())), jField("possibleRenames", JNum(d.renames.length.toInt())),
    jField("truncated", JBool(d.truncated)), jField("effectsAdded", JNum(countKind(d, "added").toInt())),
    jField("effectsRemoved", JNum(countKind(d, "removed").toInt()))
  ])) + ",");
  let ch: Json[] = [];
  for (const c of d.changed) {
    ch.push(JObj([
      jField("id", JStr(c.id)), jField("kind", JStr(c.kind)), jField("aspects", strsJ(c.aspects)), jField("before", JStr(c.before)),
      jField("after", JStr(c.after)), jField("span", spanJ(c.node.span))
    ]));
  }
  for (const l of listLines("changedSymbols", ch, false)) {
    lines.push(l);
  }
  let ad: Json[] = [];
  for (const n of d.addedSyms) {
    ad.push(nodeJ(n));
  }
  for (const l of listLines("addedSymbols", ad, false)) {
    lines.push(l);
  }
  let rm: Json[] = [];
  for (const n of d.removedSyms) {
    rm.push(nodeJ(n));
  }
  for (const l of listLines("removedSymbols", rm, false)) {
    lines.push(l);
  }
  let rn: Json[] = [];
  for (const r of d.renames) {
    rn.push(JObj([
      jField("heuristic", JBool(true)), jField("kind", JStr(r.kind)), jField("from", JStr(r.was)), jField("to", JStr(r.now)),
      jField("confidence", JStr(r.confidence)), jField("ambiguous", JBool(r.ambiguous)), jField("basis", strsJ(r.basis))
    ]));
  }
  for (const l of listLines("possibleRenames", rn, false)) {
    lines.push(l);
  }
  let ae: Json[] = [];
  for (const e of d.addedEdges) {
    ae.push(edgeJ(e));
  }
  for (const l of listLines("addedEdges", ae, false)) {
    lines.push(l);
  }
  let re: Json[] = [];
  for (const e of d.removedEdges) {
    re.push(edgeJ(e));
  }
  for (const l of listLines("removedEdges", re, false)) {
    lines.push(l);
  }
  let ec: Json[] = [];
  for (const c of d.effectChanges) {
    ec.push(effectJ(c));
  }
  for (const l of listLines("effectChanges", ec, false)) {
    lines.push(l);
  }
  let me: Json[] = [];
  for (const m of d.moduleEffects) {
    me.push(JObj([jField("module", JStr(m.module)), jField("added", strsJ(m.added)), jField("removed", strsJ(m.removed))]));
  }
  for (const l of listLines("moduleEffects", me, false)) {
    lines.push(l);
  }
  let np: Json[] = [];
  for (const f of d.newPaths) {
    np.push(findingJ(f));
  }
  for (const l of listLines("newCallPaths", np, false)) {
    lines.push(l);
  }
  let gp: Json[] = [];
  for (const f of d.goneCalls) {
    gp.push(findingJ(f));
  }
  for (const l of listLines("removedCallPaths", gp, false)) {
    lines.push(l);
  }
  let im: Json[] = [];
  for (const r of d.impact) {
    im.push(reachJ(r));
  }
  for (const l of listLines("impact", im, true)) {
    lines.push(l);
  }
  lines.push("}");
  return lines.join("\n") + "\n";
}

// ---- HTML ------------------------------------------------------------------------------------------------

function esc(s: string): string {
  return s.split("&").join("&amp;").split("<").join("&lt;").split(">").join("&gt;").split("\"").join("&quot;");
}

function link(s: OSpan, base: string): string {
  if (s.file == "") {
    return "";
  }
  const text = esc(s.file + ":" + s.line.toString());
  if (base == "") {
    return "<span class=\"loc\">" + text + "</span>";
  }
  return "<a class=\"loc\" href=\"" + esc(base) + "/" + esc(s.file) + "#L" + s.line.toString() + "\">" + text + "</a>";
}

function evTag(ev: string): string {
  return "<span class=\"ev ev-" + esc(ev == "MUST" ? "must" : (ev == "MAY" ? "may" : "unknown")) + "\">" + esc(ev) + "</span>";
}

function htmlPath(p: ImpactPath, last: string, base: string): string {
  let out: string[] = ["<ol class=\"path\">"];
  let i: usize = 0;
  while (i < p.steps.length) {
    const s = p.steps[i];
    if (i == 0) {
      out.push("<li><span class=\"tag\">entry</span> <code>" + esc(s.node) + "</code> " + link(s.span, base) + "</li>");
    } else {
      out.push("<li><span class=\"via\">" + esc(s.via) + "</span> " + evTag(s.ev) + " <code>" + esc(s.node) + "</code> " + link(s.span, base) + "</li>");
    }
    i += 1;
  }
  if (last != "") {
    out.push(last);
  }
  out.push("</ol>");
  return out.join("\n");
}

function htmlReach(r: Reach, lastOf: string, base: string, none: string): string {
  if (r.paths.length == 0) {
    return "<p class=\"muted\">" + esc(none) + "</p>";
  }
  let out: string[] = [];
  for (const p of r.paths) {
    out.push("<div class=\"pathbox\"><div class=\"muted\">path, overall " + evTag(p.ev) + "</div>" + htmlPath(p, lastOf, base) + "</div>");
  }
  if (r.truncated) {
    out.push("<p class=\"muted\">more entry points not listed</p>");
  }
  return out.join("\n");
}

function newStep(e: OEdge, base: string, mark: string): string {
  return "<li class=\"new\"><span class=\"via\">" + esc(e.kind + (e.via == "" ? "" : "/" + e.via)) + "</span> " + evTag(e.ev) + " <code>" + esc(e.dst)
    + "</code> " + link(e.span, base) + " <span class=\"tag " + mark + "\">" + (mark == "tag-new" ? "new" : "removed") + "</span></li>";
}

function symTable(title: string, ns: ONode[], base: string): string {
  if (ns.length == 0) {
    return "";
  }
  let out: string[] = ["<h3>" + esc(title) + "</h3>", "<table><tr><th>kind</th><th>symbol</th><th>signature</th><th>at</th></tr>"];
  for (const n of ns) {
    out.push("<tr><td>" + esc(n.kind) + "</td><td><code>" + esc(n.id) + "</code></td><td><code>" + esc(n.sig) + "</code></td><td>" + link(n.span, base) + "</td></tr>");
  }
  out.push("</table>");
  return out.join("\n");
}

function edgeTable(ec: OEdge[], base: string): string {
  let out: string[] = ["<table><tr><th>edge</th><th>evidence</th><th>from</th><th>to</th><th>at</th></tr>"];
  for (const e of ec) {
    out.push("<tr><td>" + esc(e.kind + (e.via == "" ? "" : "/" + e.via)) + "</td><td>" + evTag(e.ev) + "</td><td><code>" + esc(e.src)
      + "</code></td><td><code>" + esc(e.dst) + "</code></td><td>" + link(e.span, base) + "</td></tr>");
  }
  out.push("</table>");
  return out.join("\n");
}

function css(): string {
  return ":root{--bg:#fff;--fg:#1f2328;--muted:#656d76;--line:#d0d7de;--card:#f6f8fa;--new:#1a7f37;--gone:#cf222e;--warn:#9a6700;--link:#0969da}"
  + "@media (prefers-color-scheme:dark){:root:not([data-theme=light]){--bg:#0d1117;--fg:#e6edf3;--muted:#8d96a0;--line:#30363d;--card:#161b22;--new:#3fb950;--gone:#f85149;--warn:#d29922;--link:#58a6ff}}"
  + "body{margin:0;background:var(--bg);color:var(--fg);font:15px/1.5 system-ui,-apple-system,Segoe UI,sans-serif}"
  + "main{max-width:1100px;margin:0 auto;padding:16px}h1{font-size:1.5rem;margin:.2em 0}h2{font-size:1.2rem;margin-top:2em;border-bottom:1px solid var(--line);padding-bottom:.2em}h3{font-size:1rem;margin-top:1.4em}"
  + "code{font:13px ui-monospace,SFMono-Regular,Menlo,monospace;word-break:break-all}table{border-collapse:collapse;width:100%;display:block;overflow-x:auto}th,td{border:1px solid var(--line);padding:4px 8px;text-align:left;vertical-align:top}"
  + "th{background:var(--card)}.muted{color:var(--muted)}.loc{font:12px ui-monospace,monospace;color:var(--link)}.cards{display:flex;flex-wrap:wrap;gap:8px}.card{background:var(--card);border:1px solid var(--line);border-radius:6px;padding:8px 12px;min-width:110px}"
  + ".card b{display:block;font-size:1.4rem}.ev{font:11px ui-monospace,monospace;border:1px solid var(--line);border-radius:3px;padding:0 4px}.ev-may{color:var(--warn)}.ev-unknown{color:var(--gone)}"
  + ".tag{font:11px ui-monospace,monospace;background:var(--card);border:1px solid var(--line);border-radius:3px;padding:0 4px}.tag-new{color:var(--new)}.tag-gone{color:var(--gone)}.via{color:var(--muted)}"
  + ".pathbox{border-left:3px solid var(--line);padding-left:10px;margin:8px 0}ol.path{margin:4px 0;padding-left:1.4em}li.new{color:var(--new)}.warn{background:var(--card);border:1px solid var(--warn);border-radius:6px;padding:8px 12px}"
  + "del{color:var(--gone)}ins{color:var(--new);text-decoration:none}";
}

// One self-contained HTML page (no external assets). `linkBase` (optional) makes `path:line` links.
export function diffHtml(d: OsigDiff, linkBase: string): string {
  let o: string[] = [];
  o.push("<!doctype html>");
  o.push("<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">");
  o.push("<title>OSIG diff report</title><style>" + css() + "</style></head><body><main>");
  o.push("<h1>OSIG diff report</h1>");
  o.push("<p class=\"muted\">schema " + esc(DIFF_SCHEMA) + " &middot; base <code>" + esc(d.base.package) + " " + esc(d.base.hash) + "</code> &middot; head <code>"
    + esc(d.head.package) + " " + esc(d.head.hash) + "</code></p>");
  o.push("<h2>Summary</h2>");
  if (!hasDifferences(d)) {
    o.push("<p>No differences.</p>");
  } else {
    o.push("<div class=\"cards\">");
    o.push("<div class=\"card\"><b>" + d.changed.length.toString() + "</b>changed symbols</div>");
    o.push("<div class=\"card\"><b>" + d.addedSyms.length.toString() + "</b>added symbols</div>");
    o.push("<div class=\"card\"><b>" + d.removedSyms.length.toString() + "</b>removed symbols</div>");
    o.push("<div class=\"card\"><b>" + d.addedEdges.length.toString() + "</b>added edges</div>");
    o.push("<div class=\"card\"><b>" + d.removedEdges.length.toString() + "</b>removed edges</div>");
    o.push("<div class=\"card\"><b>" + d.renames.length.toString() + "</b>possible renames (heuristic)</div>");
    o.push("<div class=\"card\"><b>" + countKind(d, "added").toString() + "</b>new effects</div>");
    o.push("<div class=\"card\"><b>" + countKind(d, "removed").toString() + "</b>removed effects</div>");
    o.push("</div>");
    o.push("<p class=\"warn\">The graph is a static over-approximation: calls through function values are MAY / UNKNOWN edges, and the absence of an edge or path is not proof that none exists.</p>");
  }
  if (d.changed.length > 0) {
    o.push("<h2>Changed symbols</h2>");
    o.push("<table><tr><th>aspect</th><th>symbol</th><th>before</th><th>after</th><th>at</th></tr>");
    for (const c of d.changed) {
      o.push("<tr><td>" + esc(c.aspects.join(", ")) + "</td><td>" + esc(c.kind) + " <code>" + esc(c.id) + "</code></td><td><del><code>" + esc(c.before)
        + "</code></del></td><td><ins><code>" + esc(c.after) + "</code></ins></td><td>" + link(c.node.span, linkBase) + "</td></tr>");
    }
    o.push("</table>");
  }
  const sy = symTable("Added symbols", d.addedSyms, linkBase) + symTable("Removed symbols", d.removedSyms, linkBase);
  if (sy != "") {
    o.push("<h2>Added and removed symbols</h2>");
    o.push(sy);
  }
  if (d.renames.length > 0) {
    o.push("<h2>Possible renames</h2>");
    o.push("<p class=\"warn\">Heuristic matches, never proven identity. The symbols are also listed above as removed and added.</p>");
    o.push("<table><tr><th>kind</th><th>from</th><th>to</th><th>confidence</th><th>basis</th></tr>");
    for (const r of d.renames) {
      o.push("<tr><td>" + esc(r.kind) + "</td><td><code>" + esc(r.was) + "</code></td><td><code>" + esc(r.now) + "</code></td><td>" + esc(r.confidence)
        + (r.ambiguous ? " (ambiguous)" : "") + "</td><td>" + esc(r.basis.join("; ")) + "</td></tr>");
    }
    o.push("</table>");
  }
  if (!d.effectsComparable) {
    o.push("<h2>Effect changes</h2>");
    o.push("<p class=\"muted\">Not compared: a snapshot has no effect summaries (they exist from osig/0.2 on).</p>");
  } else if (d.effectChanges.length > 0 || d.moduleEffects.length > 0) {
    o.push("<h2>Effect changes</h2>");
    o.push("<p class=\"muted\">Transitive primitive effects (ADR-0037 D2): what each function and module may perform, new or removed. MUST: a primitive call in the body; MAY: inherited or in a closure; UNKNOWN: the target is not known.</p>");
    if (d.moduleEffects.length > 0) {
      o.push("<table><tr><th>module</th><th>new effects</th><th>removed effects</th></tr>");
      for (const m of d.moduleEffects) {
        o.push("<tr><td><code>" + esc(m.module) + "</code></td><td><ins>" + esc(m.added.join(", ")) + "</ins></td><td><del>" + esc(m.removed.join(", ")) + "</del></td></tr>");
      }
      o.push("</table>");
    }
    for (const c of d.effectChanges) {
      const tag = c.kind == "added" ? "<span class=\"tag tag-new\">new</span>" : (c.kind == "removed" ? "<span class=\"tag tag-gone\">removed</span>" : "<span class=\"tag\">evidence</span>");
      o.push("<h3>" + tag + " <code>" + esc(effLabel(c)) + "</code> " + evTag(c.ev) + " in <code>" + esc(c.fn) + "</code> " + link(c.span, c.kind == "removed" ? "" : linkBase) + "</h3>");
      let items: string[] = ["<ol class=\"path\">"];
      let k: usize = 0;
      while (k < c.path.length) {
        items.push("<li>" + (k == 0 ? "" : "<span class=\"via\">calls</span> ") + "<code>" + esc(c.path[k].node) + "</code> " + link(c.path[k].span, c.kind == "removed" ? "" : linkBase) + "</li>");
        k += 1;
      }
      items.push("</ol>");
      o.push(items.join("\n"));
      for (const p of c.reach.paths) {
        o.push("<p class=\"muted\">reached from entry point <code>" + esc(p.steps[0].node) + "</code> (" + esc(p.ev) + ")</p>");
      }
    }
  }
  if (d.newPaths.length > 0 || d.goneCalls.length > 0) {
    o.push("<h2>New and removed call paths</h2>");
    for (const f of d.newPaths) {
      o.push("<h3>New call <code>" + esc(f.edge.src) + "</code> &rarr; <code>" + esc(f.edge.dst) + "</code> " + evTag(f.edge.ev) + " " + link(f.edge.span, linkBase) + "</h3>");
      o.push(htmlReach(f.reach, newStep(f.edge, linkBase, "tag-new"), linkBase, "No entry point reaches the caller (in the analysed edges)."));
    }
    for (const f of d.goneCalls) {
      o.push("<h3>Removed call <code>" + esc(f.edge.src) + "</code> &rarr; <code>" + esc(f.edge.dst) + "</code> " + evTag(f.edge.ev) + " " + link(f.edge.span, "") + " (base)</h3>");
      o.push(htmlReach(f.reach, newStep(f.edge, "", "tag-gone"), "", "No entry point reached the caller (in the analysed edges)."));
    }
  }
  if (d.addedEdges.length > 0) {
    o.push("<h2>Added edges</h2>");
    o.push(edgeTable(d.addedEdges, linkBase));
  }
  if (d.removedEdges.length > 0) {
    o.push("<h2>Removed edges</h2>");
    o.push(edgeTable(d.removedEdges, ""));
  }
  if (d.impact.length > 0) {
    o.push("<h2>Impact on entry points</h2>");
    for (const r of d.impact) {
      o.push("<h3><code>" + esc(r.target) + "</code></h3>");
      o.push(htmlReach(r, "", linkBase, "No entry point reaches it (in the analysed edges)."));
    }
  }
  if (d.truncated) {
    o.push("<p class=\"muted\">Findings are capped at " + MAX_FINDINGS.toString() + " per section.</p>");
  }
  o.push("</main></body></html>");
  return o.join("\n") + "\n";
}
