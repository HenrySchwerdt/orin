// error: E0475
// `Hash` does not give an order: a class that only declares `equals` and `hash` is not `Ord`.
class Name {
  text: string;
  constructor(text: string) {
    this.text = text;
  }
  equals(other: Name): bool {
    return this.text == other.text;
  }
  hash(): usize {
    return this.text.length;
  }
}

function biggest<T extends Ord>(a: T, b: T): T {
  return a > b ? a : b;
}

function main(): void {
  console.log(biggest(new Name("a"), new Name("b")).text);
}
