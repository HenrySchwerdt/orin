// A mutating method returning a Result, used with `?` in a Result-returning function.
class Wallet {
  constructor(public coins: int) {}
  spend(n: int): Result<int, string> {
    if (n > this.coins) {
      return Err("insufficient: " + this.coins.toString());
    }
    this.coins -= n;
    return Ok(this.coins);
  }
}

function shop(prices: int[]): Result<int, string> {
  let w = new Wallet(10);
  let left = 0;
  for (const p of prices) {
    left = w.spend(p)?;
  }
  return Ok(left);
}

function main(): void {
  match (shop([3, 4])) {
    Ok(n) => { console.log("left " + n.toString()); },
    Err(e) => { console.log(e); }
  }
  match (shop([3, 4, 5])) {
    Ok(n) => { console.log("left " + n.toString()); },
    Err(e) => { console.log(e); }
  }
}
