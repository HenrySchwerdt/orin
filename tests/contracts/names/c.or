// Unit `c` of the qualified-names fixture (main.or): calls the `mk` and uses the `Scope` of unit `b`.
import { mk, Scope, count } from "./b";

@Ensures(result == 14)
export function useB(): int {
  return mk(7);
}

// `b.mk(7)` is 14, not 8: the verifier must not take the `mk` of unit `a`.
@Ensures(result == 8)
export function wrongB(): int {
  return mk(7);
}

@Ensures(result == s.names.length)
export function sizeB(s: Scope): usize {
  return count(s);
}
