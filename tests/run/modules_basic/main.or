import { add, mul, scaled, SCALE } from "./math";
import { greet, shout, wrap, twice } from "./text";

function main(): void {
  console.log(add(2, 3).toString());
  console.log(mul(4, 5).toString());
  console.log(scaled(4).toString());
  console.log(SCALE.toString());
  console.log(greet("Orin"));
  console.log(shout("hey"));
  console.log(wrap("x"));
  console.log(twice(21).toString());
}
