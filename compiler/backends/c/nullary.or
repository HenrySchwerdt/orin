// The immortal payload-less variants of a C unit (ADR-0052 Addendum A section 3, step R3d.2): one static object per tag the
// program uses, `orin_nz<tag>`, in place of `orin_nullary(tag)` (a table, an acquire load and a compare-and-swap in the C
// runtime). The object has the layout of an `OrinStruct` without slots and rc -1 (immortal: never counted, never freed, never
// written), like `ORIN_STRING_LIT`. Every unit that uses it declares it (a split program has the same declarations in the
// header and in the data unit; the objects are then distinct per unit, which nothing observes: a variant is compared by its
// tag). A program without the L1 entries (`--c-builtins`) has none and calls the runtime.

import { MProgram, nullaryTags } from "../../mir";
import { u } from "./text";
import { CSymbols } from "./symbols";

// The definitions, one line each ("" when the program has no L1 entries or no payload-less variant).
export function nullaryDecls(prog: MProgram, syms: CSymbols): string {
  if (!syms.l1Loaded()) {
    return "";
  }
  let out = "";
  for (const t of nullaryTags(prog)) {
    out += "static struct { OrinObj h; uint32_t nslots; uint32_t pad; uint64_t refmask; } orin_nz" + u(t)
        + " = {{-1, ORIN_K_STRUCT, " + u(t) + "}, 0, 0, 0};\n";
  }
  return out;
}
