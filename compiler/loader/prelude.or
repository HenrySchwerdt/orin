// Implicit prelude roots (spec 19 R1; docs/architecture.md "Preludes").
//
// A prelude root is a directory of Orin sources that is compiled into the compiler
// (tools/embed_prelude.py generates `embedded_<name>.or`) and loaded implicitly into every
// program: the loader serves its files through the overlay under virtual paths `$<name>/...` and
// adds an empty import of `entry` to the program's entry file, so its units sort before the entry.
// Unit names of prelude files are their virtual path without `.or` ("$std/strings"); the leading
// `$` is the marker used by lowering and pruning (compiler/lower/prelude.or, compiler/opt/prune.or).
//
// To add a prelude (e.g. the closure / array-API prelude): generate its embedded file, import it
// here and append one PreludeRoot to `preludeRoots()`. Order = load order = unit order.

import { SourceFile } from "../diag";
import { embeddedStdFiles } from "./embedded_std";
import { embeddedArrayFiles } from "./embedded_array";
import { embeddedStdlibFiles } from "./embedded_stdlib";

export type PreludeRoot = { entry: string; files: SourceFile[]; };

export function preludeRoots(): PreludeRoot[] {
  let out: PreludeRoot[] = [];
  out.push(PreludeRoot { entry: "$std/module.or", files: embeddedStdFiles() });
  // The array API (closures, ADR-0011): `xs.map(f)` etc. are calls of its functions (check/body.or).
  out.push(PreludeRoot { entry: "$array/module.or", files: embeddedArrayFiles() });
  // Std modules written in Orin (std:path, std:json, std:time, std:graph): a library root without an
  // implicit import (entry ""); the loader resolves `import ... from "std:path"` to "$stdlib/path.or".
  out.push(PreludeRoot { entry: "", files: embeddedStdlibFiles() });
  return out;
}

// The roots loaded even without the std prelude (--c-builtins, `check`, the language server): the
// array API is part of the language (ADR-0011), not a library implementation detail.
export function noPreludeRoots(): PreludeRoot[] {
  let out: PreludeRoot[] = [];
  out.push(PreludeRoot { entry: "$array/module.or", files: embeddedArrayFiles() });
  out.push(PreludeRoot { entry: "", files: embeddedStdlibFiles() });
  return out;
}
