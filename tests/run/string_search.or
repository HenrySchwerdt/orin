function show(b: bool): void {
  console.log(b.toString());
}

function showIdx(o: Option<usize>): void {
  match (o) {
    Some(i) => { console.log(i.toString()); },
    None => { console.log("none"); },
  }
}

function main(): void {
  const s = "the quick brown fox";
  showIdx(s.indexOf("quick"));
  showIdx(s.indexOf("cat"));
  showIdx(s.indexOf("o"));
  show(s.includes("brown"));
  show(s.includes("cat"));
  show(s.startsWith("the"));
  show(s.startsWith("quick"));
  show(s.endsWith("fox"));
  show(s.endsWith("the"));
  show(s.indexOf("fox").isSome());
}
