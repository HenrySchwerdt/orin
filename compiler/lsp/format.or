// Formatter hook for `textDocument/formatting`: the canonical formatter of `compiler/fmt`.
//
// The server advertises `documentFormattingProvider` when `formatAvailable()` is true.
// `Err(msg)` (the file has syntax errors; fmt leaves such files untouched) becomes a
// `RequestFailed` error response.

import { format } from "../fmt";

export function formatAvailable(): bool {
  return true;
}

export function formatDocument(text: string): Result<string, string> {
  const r = format(0, text);
  return match (r) {
    Ok(s) => Ok(s),
    Err(d) => Err(d.code + ": " + d.message)
  };
}
