import { Shape, Circle, Square, totalArea, describeFirst, Bag } from "./shapes";
import { mapAll, firstOr, Stack } from "./util";
import { Ledger } from "./ledger";

function scale(k: int): (x: int) => int {
  return x => double(x) * k;
}

function double(x: int): int {
  return x * 2;
}

function main(): void {
  const shapes: Shape[] = [new Circle(2), new Square(3)];
  console.log(totalArea(shapes).toString());
  console.log(describeFirst(shapes));
  const f = scale(3);
  console.log(f(14).toString());
  const doubled = mapAll([1, 2, 3], double);
  console.log(firstOr(doubled, 0).toString());
  let ledger = new Ledger(10);
  ledger.deposit(5);
  console.log(ledger.balance().toString());
  let ints = new Stack<int>();
  ints.push(1);
  let names = new Stack<string>();
  names.push("a");
  console.log(ints.size().toString() + names.size().toString());
  let bag = new Bag<Circle>();
  bag.add(new Circle(1));
  console.log(bag.total().toString());
}
