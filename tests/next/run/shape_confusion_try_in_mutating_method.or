// Regression for a real lowering bug: `?` inside a mutating class method returning Result returned a bare
// Result where the caller expected the { receiver, result } pair, and the caller read a slot past the end of
// the struct. The ownership verifier does not check value shapes (docs/assurance.md, C3); the runtime's
// field bounds check turned the confusion into a trap. The checker is fixed (ADR-0026 PR), so the program
// now prints "bad"; runtime/tests/runtime_test.c keeps covering the shape check directly.
class Wallet {
  coins: int;
  constructor(coins: int) { this.coins = coins; }
  validate(n: int): Result<int, string> { if (n <= 0) { return Err("bad"); } return Ok(n); }
  spend(n: int): Result<int, string> { const a = this.validate(n)?; this.coins -= a; return Ok(this.coins); }
}
function main(): void {
  let w = new Wallet(10);
  console.log(match (w.spend(0)) { Ok(n) => n.toString(), Err(e) => e });
}
