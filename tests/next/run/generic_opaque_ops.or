type Box<T> = { value: T; };
type Wrap<T> = Empty | Full(T);

function keep<T>(a: T, b: T): T {
  const x = a;
  const y: T = b;
  let z = x;
  z = y;
  return z;
}

function store<T>(x: T): Box<T[]> {
  const arr: T[] = [x, x];
  return Box { value: arr };
}

function unwrapWrap<T>(w: Wrap<T>, d: T): T {
  return match (w) {
    Empty => d,
    Full(v) => v,
  };
}

function viaResult<T>(x: T): Result<T, string> {
  if (false) {
    return Err("never");
  }
  return Ok(x);
}

function chain<T>(x: T): Result<Option<T>, string> {
  const r = viaResult(x)?;
  return Ok(Some(r));
}

function wrapChain<T>(x: T): Result<Wrap<T>, string> {
  const v = viaResult(x)?;
  return Ok(Full(v));
}

function main(): void {
  console.log(keep(1, 2).toString());
  console.log(keep("a", "b"));
  console.log(store("s").value.join(""));
  console.log(unwrapWrap(Empty, 3).toString());
  console.log(unwrapWrap(Full("f"), "d"));
  console.log(chain(5).unwrap().unwrap().toString());
  console.log(unwrapWrap(wrapChain("w").unwrap(), "d"));
  console.log("done");
}
