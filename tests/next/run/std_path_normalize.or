import { normalize } from "std:path";

function main(): void {
  const cases = ["", ".", "./", "/", "//", "a//b", "/a/./b/../c", "a/..", "a/../..", "../a", "/..", "/../a",
    "a/b/", "a/b//", "./a/", "../..", "a/./", "/a/b/../../.."];
  for (const c of cases) {
    console.log("[" + c + "] -> [" + normalize(c) + "]");
  }
}
