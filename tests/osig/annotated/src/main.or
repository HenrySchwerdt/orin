import { Verb, Route, Doc, Json, JsonName } from "./meta";

@Json
@Doc("A user of the service")
export type User = {
  id: int;
  @JsonName("display_name") name: string;
};

@Doc("The limit")
export const LIMIT: int = 7;

class Handlers {
  @Route("/users",
    Get, Some("admin"))
  list(): int {
    return LIMIT;
  }
}

@Route("/users/:id", Post)
@Doc("Creates a user")
export function create(id: int): User {
  return User { id: id, name: "n" };
}

function main(): void {
  const h = new Handlers();
  console.log((h.list() + create(1).id).toString());
}
