// The constraints are checked while declarations are still being resolved: a class used before its methods are resolved is accepted
// there and checked again when the map or class instance is used.
type R = { w: Box<Money>; m: Map<Money, int>; };

class Money {
  amount: int;
  constructor(amount: int) { this.amount = amount; }
  equals(other: Money): bool { return this.amount == other.amount; }
  hash(): usize { return this.amount.toUsize(); }
}

class Box<T extends Hash> {
  v: T;
  constructor(v: T) { this.v = v; }
}

function main(): void {
  const r = R { w: new Box<Money>(new Money(1)), m: new Map<Money, int>() };
  console.log(r.w.v.amount.toString());
}
