import { assertEqString, assertEqUsize, assertEqBool } from "std:test";
import { oxMutants } from "../src/mutants_ox";
import { selectOx, listLine, resultLine, summaryLine, failDetail } from "../src/ox_check";

@Test
function theTableHasTheMutantsOfTheOxFiles(): void {
  const all = oxMutants();
  assertEqUsize(all.length, 33, "mutants");
  assertEqString(all[0].name, "static-encoding-ignored", "first");
  assertEqString(all[0].rel, "check/ox.or", "first file");
  assertEqString(all[32].name, "member-static-class-ignored", "last");
  let seen: string[] = [];
  for (const m of all) {
    assertEqBool(m.oldText.length > 0 && m.oldText != m.newText, true, "a change in " + m.name);
    assertEqBool(seen.includes(m.name), false, "unique name " + m.name);
    seen.push(m.name);
  }
}

@Test
function onlySelectsByName(): void {
  const all = oxMutants();
  assertEqUsize(selectOx(all, "").length, 33, "no filter");
  const two = selectOx(all, "void-tags-ignored,static-encoding-ignored,nonexistent");
  assertEqUsize(two.length, 2, "two names, a third that does not exist");
  assertEqString(two[0].name, "static-encoding-ignored", "table order, not the order of the names");
  assertEqUsize(selectOx(all, "nonexistent").length, 0, "nothing");
}

@Test
function linesHaveTheFixedFormat(): void {
  const m = oxMutants()[0];
  assertEqString(listLine(m), "static-encoding-ignored              check/ox.or", "--list");
  assertEqString(resultLine("void-tags-ignored", "SURVIVED", ""), "[mutate_ox] void-tags-ignored                    SURVIVED ", "trailing blank");
  assertEqString(resultLine("a", "killed", "x, y"), "[mutate_ox] a                                    killed x, y", "killed");
  assertEqString(summaryLine(33, 32, 1), "[mutate_ox] 33 mutants, 32 killed, 1 not killed", "summary");
}

@Test
function failDetailIsTheFirstThreeFailingTests(): void {
  const out = "FAIL next/run/ox_a\n    expected x\nFAIL next/errors/ox_b\nFAIL next/run/ox_c\nFAIL next/run/ox_d\nTOTAL 1 passed, 4 failed\n";
  assertEqString(failDetail(out), "next/run/ox_a, next/errors/ox_b, next/run/ox_c", "three");
  assertEqString(failDetail("TOTAL 5 passed, 0 failed\n"), "", "none");
}
