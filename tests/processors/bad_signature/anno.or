import { Input, Output, output } from "std:meta";
import { Other } from "./other";

@Annotation(type)
export type NotExported = { };

@Annotation(type)
export type WrongParam = { };

@Annotation(type)
export type Generic = { };

@Annotation(type)
export type Twice = { };

@Annotation(type)
export type OnType = { };

@Processor(NotExported)
function notExportedProc(input: Input): Output {
  return output([]);
}

@Processor(WrongParam)
export function wrongParamProc(input: string): Output {
  return output([]);
}

@Processor(Generic)
export function genericProc<T>(input: Input): Output {
  return output([]);
}

@Processor(Twice)
export function twiceProc(input: Input): Output {
  return output([]);
}

@Processor(Twice)
export function twiceAgainProc(input: Input): Output {
  return output([]);
}

@Processor(Other)
export function otherProc(input: Input): Output {
  return output([]);
}

@Processor(Missing)
export function missingProc(input: Input): Output {
  return output([]);
}

@Processor(OnType)
export type Wrong = { id: int; };

@Processor
export function noArgProc(input: Input): Output {
  return output([]);
}
