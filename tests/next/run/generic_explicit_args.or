type Tree<T> = Leaf | Node(Tree<T>, T, Tree<T>);

function id<T>(x: T): T {
  return x;
}

function first<T>(xs: T[]): Option<T> {
  return xs.get(0);
}

function empty<T>(): T[] {
  return [];
}

function pick<A, B>(a: A, b: B): B {
  return b;
}

function count<T>(t: Tree<T>): int {
  return match (t) {
    Leaf => 0,
    Node(l, _, r) => count(l) + 1 + count(r),
  };
}

function main(): void {
  console.log(id<int>(1).toString());
  console.log(id<usize>(2).toString());
  console.log(first<string>(["q"]).unwrap());
  console.log(empty<int>().length.toString());
  console.log(empty<string[]>().length.toString());
  console.log(pick<string, int>("x", 3).toString());
  console.log(count(Node<int>(Leaf, 1, Node<int>(Leaf, 2, Leaf))).toString());
  const xs = empty<Option<int>>();
  console.log(xs.length.toString());
  const u: usize = id<usize>(5) + 1;
  console.log(u.toString());
}
