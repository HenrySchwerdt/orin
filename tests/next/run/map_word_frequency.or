function main(): void {
  const text = "the quick brown fox jumps over the lazy dog the fox barks and the dog runs away from the fox";
  const words = text.split(" ");
  let freq = new Map<string, int>();
  for (const w of words) {
    freq.set(w, freq.get(w).unwrapOr(0) + 1);
  }
  console.log(freq.size.toString());
  const entries = freq.entries();
  const sorted = entries.sort((a, b) => b.value - a.value);
  let i: usize = 0;
  while (i < 5) {
    console.log(sorted[i].key + " " + sorted[i].value.toString());
    i += 1;
  }
}
