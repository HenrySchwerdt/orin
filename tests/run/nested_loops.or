function main(): void {
  let i = 1;
  while (i <= 3) {
    let row = "";
    let j = 1;
    while (j <= 3) {
      if (j > 1) { row = row + " "; }
      row = row + (i * j).toString();
      j += 1;
    }
    console.log(row);
    i += 1;
  }
  for (const a of [1, 2, 3]) {
    let row = "";
    for (const b of [1, 2, 3]) {
      if (b > a) { break; }
      row = row + b.toString();
    }
    console.log(row);
  }
  let count = 0;
  for (const a of [1, 2, 3]) {
    for (const b of [1, 2, 3]) {
      if (a == b) { continue; }
      count += 1;
    }
  }
  console.log(count.toString());
}
