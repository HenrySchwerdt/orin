// std:seq -- pure aggregates over arrays, for contracts and code (ADR-0035, ADR-0031 C11-C13).
//
// `range(lo, hi)` is the index array `[lo, lo + 1, .., hi - 1]` (empty when `hi <= lo`), so that a bounded
// quantifier over indices is written with the array API: `range(0, xs.length).every(i => xs[i] > 0)` is "for all
// `i` in `0 .. xs.length`", and `range(1, xs.length).every(i => xs[i - 1] <= xs[i])` says `xs` is sorted.
// `sum(xs)` and `sumBy(xs, f)` add up the elements (or `f` of them): `sumBy(this.items, it => it.price * it.qty)`.
//
// These are ordinary, pure functions: contracts may call them (ADR-0031 A4; `sumBy` is pure relative to its
// function argument, like `every`), and the contract-checked build runs them as written. `orin verify
// --contracts` does not run them: it reads `range(a, b).every(..)` / `.some(..)` as a bounded quantifier over
// the indices and `sum` / `sumBy` as the recursive sum `sum(xs, n) = sum(xs, n - 1) + f(xs[n - 1])` (docs/contracts.md,
// "Quantifiers and sums"). The loop bodies below are the reference semantics: the runtime meaning is the one of
// the code, the solver's is the same by construction (and tests/contracts/ checks they agree on examples).
//
// Overflow: `+` on `int` traps on overflow, so a sum that does not fit traps in the contract-checked build; the
// verifier reasons over unbounded integers and assumes the paths that return did not overflow (A-INT).

// range(lo, hi): the indices `lo`, `lo + 1`, .., `hi - 1`; no element when `hi <= lo`.
@Ensures(result.length == (hi > lo ? hi - lo : 0))
export function range(lo: usize, hi: usize): usize[] {
  let out: usize[] = [];
  let i = lo;
  while (i < hi) {
    out.push(i);
    i += 1;
  }
  return out;
}

// sum(xs): the sum of the elements; 0 for the empty array.
@Ensures(xs.length == 0 ==> result == 0)
export function sum(xs: int[]): int {
  let s: int = 0;
  for (const x of xs) {
    s += x;
  }
  return s;
}

// sumBy(xs, f): the sum of `f(x)` over the elements; 0 for the empty array.
@Ensures(xs.length == 0 ==> result == 0)
export function sumBy<T>(xs: T[], f: (x: T) => int): int {
  let s: int = 0;
  for (const x of xs) {
    s += f(x);
  }
  return s;
}
