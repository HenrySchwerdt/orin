// `orin test` must report this test as FAILED (a trap) in every build: a panic in a task is a trap of the task that joins it.
import { scope, spawn } from "std:task";

function fail(n: int): int {
  const empty: int[] = [];
  return empty[n.toUsize()];
}

@Test
function panicInTaskTrapsTheJoiner(): void {
  const r = scope(s => spawn(s, () => fail(3)).join());
  r + 1;
}
