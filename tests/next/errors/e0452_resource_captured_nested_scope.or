// error: E0452
// in particular a nested scope cannot use the handle of the outer one
import { withFile, useFile, Read, Write, File } from "std:fs";
function main(): void {
  const r = useFile("build/tests/x.txt", Read, f => {
    const q = useFile("build/tests/y.txt", Write, g => { g.write(f.readAll()); });
  });
}
