// flags: --check-contracts
// exit: 101
// stderr: contract violated: @Requires(amount > 0 && amount <= this.bal)
// Contract clauses on a class that implements an interface, called directly, through an
// interface value and through a bounded generic (ADR-0012 x ADR-0019).
interface Account { balance(): int; }
@Invariant(this.bal >= 0)
class Wallet implements Account {
  bal: int;
  constructor(b: int) { this.bal = b; }
  @Ensures(result == this.bal)
  balance(): int { return this.bal; }
  @Requires(amount > 0 && amount <= this.bal)
  @Ensures(this.bal == old(this.bal) - amount)
  withdraw(amount: int): void { this.bal = this.bal - amount; }
}
@Ensures(result >= 0)
function total<T extends Account>(xs: T[]): int {
  let t = 0;
  for (const x of xs) { t = t + x.balance(); }
  return t;
}
function main(): void {
  let w = new Wallet(10);
  w.withdraw(3);
  const a: Account = w;
  console.log(a.balance().toString());
  console.log(total([w, new Wallet(5)]).toString());
  w.withdraw(20);
}
