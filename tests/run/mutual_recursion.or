type Tree = Node(Forest) | Leaf(int);
type Forest = Cons(Tree, Forest) | Nil;

function main(): void {
  console.log(isEven(10).toString());
  console.log(isOdd(7).toString());
  console.log(isEven(7).toString());
  console.log(isOdd(0).toString());
  const t = Node(Cons(Leaf(1), Cons(Node(Cons(Leaf(2), Cons(Leaf(3), Nil))), Nil)));
  console.log(leavesT(t).toString());
}

function isEven(n: int): bool {
  if (n == 0) { return true; }
  return isOdd(n - 1);
}

function isOdd(n: int): bool {
  if (n == 0) { return false; }
  return isEven(n - 1);
}

function leavesT(t: Tree): int {
  return match (t) {
    Leaf(_) => 1,
    Node(f) => leavesF(f),
  };
}

function leavesF(f: Forest): int {
  return match (f) {
    Nil => 0,
    Cons(t, rest) => leavesT(t) + leavesF(rest),
  };
}
