// GENERATED by tools/embed_prelude.py from runtime/core/ -- do not edit; run the script after changing the sources.

import { SourceFile } from "../diag";

export function embeddedRtFiles(): SourceFile[] {
  let out: SourceFile[] = [];
  out.push(SourceFile { path: "$rt/coreprobe.or", text: "// std:coreprobe -- self-test of the core operations (ADR-0052 step R3a, spec 19 section 4; hir/coreops.or).\n//\n// INTERNAL. The core operations (raw loads / stores at a usize address, platform memory functions, the object address of a\n// reference) are reachable only through the internal module std:core, which only the modules of the embedded `$rt` root\n// (runtime/core/) can import, so a test of them has to live here. It is reached as `std:coreprobe` (loader/resolve.or). `coreProbe()` runs every operation on memory it allocates itself and returns one line per\n// check; `tests/run/core_ops.or` prints it and the conformance suite compares the output on both backends (C and LLVM). It\n// touches no memory but its own allocations. Delete it when the runtime modules of R3b+ exercise the operations for real.\n\nimport {\n  load8, load32, load64, loadF64, store8, store32, store64, storeF64, memAlloc, memFree, memCopy, memSet, addrOf,\n  and, or, xor, shl, shr, expect, cfg, heapBase, memRealloc, memMove, memCmp, wadd, wsub, wmul\n} from \"std:core\";\n\ntype Pair = { x: int; y: int; };\n\nfunction line(name: string, ok: bool): string {\n  return name + (ok ? \" ok\" : \" FAIL\") + \"\\n\";\n}\n\n// One line per operation: \"<name> ok\" or \"<name> FAIL\".\nexport function coreProbe(): string {\n  let out = \"\";\n  const a = memAlloc(64);\n  out += line(\"memAlloc\", a != 0);\n\n  // memSet / load8: every byte of the block, and only the low 8 bits of the value are used\n  memSet(a, 0, 64);\n  out += line(\"memSet zero\", load64(a) == 0 && load64(a + 56) == 0);\n  memSet(a, 0x1AB, 16);\n  out += line(\"memSet byte\", load8(a) == 0xAB && load8(a + 15) == 0xAB && load8(a + 16) == 0);\n  out += line(\"load8 zero-extends\", load8(a) == 171);\n\n  // store8 / store32 / store64 and the loads, at unaligned addresses too\n  memSet(a, 0, 64);\n  store8(a, 0x1FF);\n  out += line(\"store8 low byte\", load8(a) == 255 && load8(a + 1) == 0);\n  store32(a + 4, 0x1DEADBEEF);\n  out += line(\"store32 low word\", load32(a + 4) == 0xDEADBEEF && load32(a + 8) == 0);\n  out += line(\"load32 zero-extends\", load32(a + 4) == 3735928559);\n  store64(a + 8, 0x0123456789ABCDEF);\n  out += line(\"store64\", load64(a + 8) == 0x0123456789ABCDEF);\n  store64(a + 17, 18446744073709551615);\n  out += line(\"load64 unaligned\", load64(a + 17) == 18446744073709551615 && load8(a + 16) == 0 && load8(a + 25) == 0);\n  store32(a + 33, 1);\n  out += line(\"load32 unaligned\", load32(a + 33) == 1);\n  out += line(\"native order\", load8(a + 8) == load64(a + 8) - (load64(a + 8) / 256) * 256);\n\n  // floats\n  storeF64(a + 40, 1.5);\n  out += line(\"storeF64 / loadF64\", loadF64(a + 40) == 1.5);\n  storeF64(a + 41, -0.25);\n  out += line(\"loadF64 unaligned\", loadF64(a + 41) == -0.25);\n  store64(a + 48, 0x3FF0000000000000);\n  out += line(\"loadF64 bits\", loadF64(a + 48) == 1.0);\n  storeF64(a + 48, 2.0);\n  out += line(\"storeF64 bits\", load64(a + 48) == 0x4000000000000000);\n\n  // memCopy\n  const b = memAlloc(64);\n  memSet(b, 7, 64);\n  memCopy(b + 3, a + 8, 8);\n  out += line(\"memCopy\", load64(b + 3) == 0x0123456789ABCDEF && load8(b + 2) == 7 && load8(b + 11) == 7);\n  memCopy(b, a, 0);\n  out += line(\"memCopy zero length\", load8(b) == 7);\n\n  // memAlloc(0) is a valid block of one byte, never address 0\n  const z = memAlloc(0);\n  out += line(\"memAlloc zero\", z != 0);\n  store8(z, 9);\n  out += line(\"memAlloc zero usable\", load8(z) == 9);\n\n  // addrOf: the object address of a reference; stable, distinct per object, and it leaves the object alone\n  const s = \"core\";\n  const t = \"dore\";\n  const xs: int[] = [1, 2, 3];\n  out += line(\"addrOf string\", addrOf(s) != 0 && addrOf(s) == addrOf(s) && addrOf(s) != addrOf(t));\n  out += line(\"addrOf array\", addrOf(xs) != 0 && addrOf(xs) == addrOf(xs) && addrOf(xs) != addrOf(s));\n  out += line(\"addrOf aligned\", addrOf(s) / 8 * 8 == addrOf(s) && addrOf(xs) / 8 * 8 == addrOf(xs));\n  out += line(\"addrOf leaves value\", s == \"core\" && xs.length == 3 && xs[2] == 3);\n\n  // addrOf needs the real object (ADR-0052 Addendum A, rule 2): the optimiser must not unbox the record or scalar-replace the\n  // array, so the layout is there: string len@16 data@32, array len@16 items@40 (a pointer to the buffer), struct nslots@16 slots@32\n  const u = \"wxyz\";\n  const pr = Pair { x: 7, y: 9 };\n  const ys: int[] = [4, 5, 6];\n  out += line(\"addrOf string layout\", load64(addrOf(u) + 16) == 4 && load8(addrOf(u) + 32) == 119 && load8(addrOf(u) + 35) == 122);\n  out += line(\"addrOf array layout\", load64(addrOf(ys) + 16) == 3 && load64(load64(addrOf(ys) + 40)) == 4 && load64(load64(addrOf(ys) + 40) + 16) == 6);\n  out += line(\"addrOf record layout\", load64(addrOf(pr) + 16) == 2 && load64(addrOf(pr) + 32) == 7 && load64(addrOf(pr) + 40) == 9);\n\n  // bit operations on usize\n  out += line(\"and\", and(0xF0F0, 0xFF00) == 0xF000 && and(18446744073709551615, 5) == 5);\n  out += line(\"or\", or(0xF0F0, 0x0F0F) == 0xFFFF && or(0, 0) == 0);\n  out += line(\"xor\", xor(0xFF, 0x0F) == 0xF0 && xor(18446744073709551615, 18446744073709551615) == 0);\n  out += line(\"shl\", shl(1, 3) == 8 && shl(1, 63) == 9223372036854775808 && shl(3, 63) == 9223372036854775808);\n  out += line(\"shl 64 or more\", shl(1, 64) == 0 && shl(18446744073709551615, 200) == 0);\n  out += line(\"shr\", shr(256, 4) == 16 && shr(18446744073709551615, 63) == 1 && shr(5, 0) == 5);\n  out += line(\"shr 64 or more\", shr(18446744073709551615, 64) == 0 && shr(1, 1000) == 0);\n  out += line(\"shr is logical\", shr(9223372036854775808, 62) == 2);\n  const refmask: usize = 5;\n  out += line(\"bit test\", and(shr(refmask, 2), 1) == 1 && and(shr(refmask, 1), 1) == 0);\n\n  // wrapping arithmetic on usize: no overflow trap\n  out += line(\"wadd\", wadd(1, 2) == 3 && wadd(18446744073709551615, 2) == 1 && wadd(18446744073709551615, 1) == 0);\n  out += line(\"wsub\", wsub(5, 3) == 2 && wsub(0, 1) == 18446744073709551615 && wsub(3, 3) == 0);\n  out += line(\"wmul\", wmul(6, 7) == 42 && wmul(9223372036854775808, 2) == 0 && wmul(4294967296, 4294967296) == 0);\n\n  // expect is the identity on its first argument\n  const yes = a != 0;\n  out += line(\"expect\", expect(yes, true) && !expect(!yes, true) && expect(yes, false) && !expect(!yes, false));\n\n  // cfg: 0 or 1 for the three switches, 0 for an unknown number\n  out += line(\"cfg\", cfg(0) <= 1 && cfg(1) <= 1 && cfg(2) <= 1 && cfg(3) == 0 && cfg(100) == 0);\n\n  // heapBase: a stable 8-aligned address; word 63 (byte 504) is ours (`probe` of OrinHeap) (zero at first, then what we store)\n  const h = heapBase();\n  out += line(\"heapBase\", h != 0 && h == heapBase() && h / 8 * 8 == h);\n  out += line(\"heapBase zeroed\", load64(h + 504) == 0);\n  store64(h + 504, 77);\n  out += line(\"heapBase usable\", load64(h + 504) == 77 && load64(heapBase() + 504) == 77);\n  store64(h + 504, 0);\n\n  // memRealloc keeps the contents, grows and shrinks, and a size of 0 is one byte\n  const c = memAlloc(16);\n  store64(c, 0x1122334455667788);\n  store64(c + 8, 0x99AABBCCDDEEFF00);\n  const c2 = memRealloc(c, 4096);\n  out += line(\"memRealloc grow\", c2 != 0 && load64(c2) == 0x1122334455667788 && load64(c2 + 8) == 0x99AABBCCDDEEFF00);\n  store8(c2 + 4095, 5);\n  out += line(\"memRealloc usable\", load8(c2 + 4095) == 5);\n  const c3 = memRealloc(c2, 8);\n  out += line(\"memRealloc shrink\", c3 != 0 && load64(c3) == 0x1122334455667788);\n  const c4 = memRealloc(c3, 0);\n  out += line(\"memRealloc zero\", c4 != 0 && load8(c4) == 0x88);\n\n  // memMove: overlapping ranges in both directions\n  memSet(b, 0, 64);\n  store64(b, 0x0807060504030201);\n  memMove(b + 2, b, 8);\n  out += line(\"memMove up\", load8(b) == 1 && load8(b + 1) == 2 && load8(b + 2) == 1 && load8(b + 9) == 8);\n  memMove(b, b + 2, 8);\n  out += line(\"memMove down\", load8(b) == 1 && load8(b + 7) == 8);\n  memMove(b, a, 0);\n  out += line(\"memMove zero length\", load8(b) == 1);\n\n  // memCmp: -1, 0, 1 by the first differing byte, bytes compare unsigned\n  const x = memAlloc(8);\n  const y = memAlloc(8);\n  memSet(x, 3, 8);\n  memSet(y, 3, 8);\n  out += line(\"memCmp equal\", memCmp(x, y, 8) == 0 && memCmp(x, y, 0) == 0);\n  store8(y + 5, 4);\n  out += line(\"memCmp less\", memCmp(x, y, 8) == -1 && memCmp(x, y, 5) == 0);\n  out += line(\"memCmp greater\", memCmp(y, x, 8) == 1);\n  store8(y + 1, 200);\n  out += line(\"memCmp unsigned\", memCmp(x, y, 8) == -1 && memCmp(y, x, 8) == 1);\n  memFree(y);\n  memFree(x);\n\n  memFree(c4);\n  memFree(z);\n  memFree(b);\n  memFree(a);\n  out += line(\"memFree\", true);\n  return out;\n}\n\n// A failed allocation traps \"out of memory\" (exit 101) instead of returning 0: `tests/run/core_oom_trap.or`.\nexport function coreOom(): usize {\n  return memAlloc(18446744073709551600);\n}\n\n// The same for memRealloc.\nexport function coreOomRealloc(): usize {\n  const p = memAlloc(8);\n  return memRealloc(p, 18446744073709551600);\n}\n" });
  out.push(SourceFile { path: "$rt/heap.or", text: "// $rt/heap -- the per-thread heap block and the small-block cache, written in Orin (ADR-0052 Addendum A, step R3d.3).\n//\n// Every task / thread has one zero-initialised block (`OrinHeap`, 1024 bytes, `heapBase()`): the free lists of struct objects and\n// array headers, the live-object balance, the work stack of `destroy`, the counters (`OrinStats`) and the small-block cache. The\n// offsets are the ones pinned by the _Static_asserts of runtime/core/orin_runtime.h (spec 19 \"R3d.1\"). A block is plain malloc\n// memory, so a node that came from another thread's heap joins this one's list (capped by FL_CAP / SB_CAP).\n//\n// Address arithmetic uses the wrapping core operations `wadd`, `wsub`, `wmul` (hir/coreops.or): the checked `+` of the language\n// would add a trap path to every access. The free lists and the small-block cache exist only when `cfg(0) == 1` (off under\n// ASan / MSan and with -DORIN_NO_FREELIST: then every block goes straight to the allocator, as before), the counters only when\n// `cfg(1) == 1` (-DORIN_STATS_ENABLED). The configuration is a constant, so the dead code folds away.\n//\n// Object layout (frozen, spec 19): header rc@0 kind@8 tag@12 (16 bytes); string len@16 cap@24 data@32; array len@16 cap@24\n// is_ref@32 items@40; struct nslots@16 refmask@24 slots@32; kinds string 1, array 2, struct 3.\n\nimport { load64, store64, memAlloc, heapBase, cfg, wadd, wsub, shl, shr, xor } from \"std:core\";\n\n// ---------------------------------------------------------------- offsets in the heap block\n\nexport const FL_STRUCT: usize = 0;   // free struct objects by nslots 0..8, 8 bytes each\nexport const FL_ARRAY: usize = 72;   // free array headers\nexport const FL_N: usize = 80;       // list lengths: [nslots] for structs, [9] (@152) for the array headers\nexport const LIVE: usize = 160;      // live objects of this heap (signed)\nexport const DSTACK: usize = 168;    // the work stack of destroy (0 until first use)\nexport const DCAP: usize = 176;      // its capacity in entries\nexport const S_ALLOC_STRING: usize = 192;\nexport const S_ALLOC_ARRAY: usize = 200;\nexport const S_ALLOC_STRUCT: usize = 208;\nexport const S_FREES: usize = 216;\nexport const S_RETAINS: usize = 224;\nexport const S_RELEASES: usize = 232;\nexport const S_COW_COPIES: usize = 240;\nexport const S_COW_INPLACE: usize = 248;\nexport const S_ARRAY_GROWS: usize = 256;\nexport const S_PEAK_LIVE_OBJS: usize = 272;\nexport const S_PEAK_LIVE_BYTES: usize = 280;\nexport const S_LIVE_BYTES: usize = 288;\nexport const SB: usize = 512;        // small-block cache: 17 classes of {head, length}, 16 bytes each\n\nexport const FL_CAP: usize = 262144;  // 2^18 objects per free list\nexport const SB_CAP: usize = 32768;   // 2^15 blocks per small-block class\nexport const SB_MAX: usize = 256;     // the largest cached block\n\nconst SIGN: usize = 9223372036854775808;\n\n// ---------------------------------------------------------------- word helpers\n\n// word at `p` += d (wrapping)\n@Inline\nexport function addAt(p: usize, d: usize): void {\n  store64(p, wadd(load64(p), d));\n}\n\n// word at `p` -= d (wrapping)\n@Inline\nexport function subAt(p: usize, d: usize): void {\n  store64(p, wsub(load64(p), d));\n}\n\n// ---------------------------------------------------------------- accounting (the static counters, hot path under cfg(1))\n\n// One more object, `bytes` more live bytes, and the peaks. `counter` is the offset of the kind's allocation counter.\n@Inline\nexport function statAlloc(counter: usize, bytes: usize): void {\n  if (cfg(1) == 1) {\n    const h = heapBase();\n    addAt(wadd(h, counter), 1);\n    const lb = wadd(load64(wadd(h, S_LIVE_BYTES)), bytes);\n    store64(wadd(h, S_LIVE_BYTES), lb);\n    if (xor(lb, SIGN) > xor(load64(wadd(h, S_PEAK_LIVE_BYTES)), SIGN)) {\n      store64(wadd(h, S_PEAK_LIVE_BYTES), lb);\n    }\n    const lv = load64(wadd(h, LIVE));\n    if (xor(lv, SIGN) > xor(load64(wadd(h, S_PEAK_LIVE_OBJS)), SIGN)) {\n      store64(wadd(h, S_PEAK_LIVE_OBJS), lv);\n    }\n  }\n}\n\n// One more live object (the balance may go negative on a task that frees what another allocated: it is signed).\n@Inline\nexport function liveInc(): void {\n  addAt(wadd(heapBase(), LIVE), 1);\n}\n\n// ---------------------------------------------------------------- small-block cache (variable-size buffers <= SB_MAX)\n\n// A buffer of `n` bytes: string objects (sizeof(OrinString) + cap + 1) and array item buffers (cap * 8). Blocks of at most\n// SB_MAX bytes are rounded up to a 16-byte class and taken from the class list when it has one; a block can sit on any thread's\n// list and needs no header, because its free passes the same size.\n@Inline\nexport function sbAlloc(n: usize): usize {\n  if (cfg(0) == 1 && n <= 256) {\n    const c = shr(wadd(n, 15), 4);\n    const q = wadd(wadd(heapBase(), SB), shl(c, 4));\n    const f = load64(q);\n    if (f != 0) {\n      store64(q, load64(f));\n      subAt(wadd(q, 8), 1);\n      return f;\n    }\n    return memAlloc(shl(c, 4));\n  }\n  return memAlloc(n);\n}\n" });
  out.push(SourceFile { path: "$rt/leaf.or", text: "// $rt/leaf -- the leaves of the object model without allocator state, written in Orin (ADR-0052 Addendum A, step R3d.2).\n//\n// The backends call these functions by name (compiler/mir/rt.or lists them; opt/prune.or keeps them) in place of the C runtime\n// functions of the same name (`orin_opt_unwrap`, `orin_res_unwrap`, `orin_res_unwrap_err`, `orin_v_unwrap`, `orin_trap_shape`,\n// `orin_assert_fact`, `orin_assert_array`), which the frozen snapshot bootstrap/seed/runtime/ keeps for the seed and `--c-builtins`.\n// An object is its address as a `usize`: the emitted call casts the pointer (the language cannot forge a reference). The\n// layout is the frozen one (spec 19, rule 3 of Addendum A section 2): kind@8 tag@12; struct nslots@16 slots@32; array len@16\n// items@40; kinds string 1, array 2, struct 3. A trap is `taskTrap`: the message of the C `orin_trap` (stdout flushed,\n// `trap: <msg>` on stderr, exit 101, and a trap on a task ends that task only).\n\nimport { load32, load64 } from \"std:core\";\nimport { taskTrap } from \"std:fsraw\";\nimport { exit } from \"std:process\";\n\n// The trap of every checked field or element access on an object of the wrong shape (docs/assurance.md \"shape confusion\").\nexport function trapShape(): void {\n  taskTrap(\"field access on a value of the wrong shape (compiler bug)\");\n}\n\n// Slot 0 of the struct at `o`: a struct with at least one slot, else the shape trap.\n@Inline\nfunction slot0(o: usize): usize {\n  if (load32(o + 8) != 3 || load32(o + 16) == 0) {\n    trapShape();\n  }\n  return load64(o + 32);\n}\n\n// `opt.unwrap()`: the payload slot of Some (tag 0).\n@Inline\nexport function optUnwrap(o: usize): usize {\n  if (load32(o + 12) != 0) {\n    taskTrap(\"unwrap on None\");\n  }\n  return slot0(o);\n}\n\n// `res.unwrap()`: the payload slot of Ok (tag 0), 0 for an Ok without payload.\n@Inline\nexport function resUnwrap(o: usize): usize {\n  if (load32(o + 12) != 0) {\n    taskTrap(\"unwrap on Err\");\n  }\n  if (load32(o + 8) == 3 && load32(o + 16) == 0) {\n    return 0;\n  }\n  return slot0(o);\n}\n\n// `res.unwrapErr()`: the payload slot of Err (tag 1).\n@Inline\nexport function resUnwrapErr(o: usize): usize {\n  if (load32(o + 12) != 1) {\n    taskTrap(\"unwrapErr on Ok\");\n  }\n  return slot0(o);\n}\n\n// The unboxed Option / Result (docs/mir.md v2.2): `word` when `tag` is the expected one, else the trap of the boxed builtin.\n// what: 0 = Option.unwrap (tag 0), 1 = Result.unwrap (tag 0), 2 = Result.unwrapErr (tag 1).\n@Inline\nexport function vUnwrap(tag: usize, word: usize, what: int): usize {\n  if (what == 0 && tag != 0) {\n    taskTrap(\"unwrap on None\");\n  }\n  if (what == 1 && tag != 0) {\n    taskTrap(\"unwrap on Err\");\n  }\n  if (what == 2 && tag != 1) {\n    taskTrap(\"unwrapErr on Ok\");\n  }\n  return word;\n}\n\n// `orin2 compile --assert-facts` (docs/mir.md v2.4): the dynamic check of a forwarded load. `got` is the value an IForward\n// claimed for slot `key` of `o` (a field index or an array index); the slot itself is read here, as the original getfield /\n// arrayget would have. A difference is an optimiser or verifier bug, not a program error: exit 70 (internal error).\nexport function assertFact(o: usize, key: usize, got: usize): void {\n  const kind = load32(o + 8);\n  let want: usize = 0;\n  let why = \"\";\n  if (kind == 3 && key < load32(o + 16)) {\n    want = load64(o + 32 + key * 8);\n  } else if (kind == 2 && key < load64(o + 16)) {\n    want = load64(load64(o + 40) + key * 8);\n  } else {\n    why = \"internal error: --assert-facts: a forwarded load names a slot that does not exist\";\n  }\n  if (why == \"\" && want != got) {\n    why = \"internal error: --assert-facts: a forwarded load differs from the slot it was forwarded from\";\n  }\n  if (why != \"\") {\n    console.error(why);\n    exit(70);\n  }\n}\n\n// `orin2 compile --assert-facts` (docs/mir.md v2.6, rule U1): the kind check and the bounds check that an IArrayGetU /\n// IArraySetU leaves out, executed before it. A failure is a verifier or optimiser bug: exit 70 (internal error).\nexport function assertArray(o: usize, i: usize): void {\n  let why = \"\";\n  if (load32(o + 8) != 2) {\n    why = \"internal error: --assert-facts: an unchecked array access on an object that is not an array\";\n  } else if (i >= load64(o + 16)) {\n    why = \"internal error: --assert-facts: an unchecked array access is out of bounds\";\n  }\n  if (why != \"\") {\n    console.error(why);\n    exit(70);\n  }\n}\n" });
  out.push(SourceFile { path: "$rt/module.or", text: "// $rt entry: the runtime core written in Orin (ADR-0052 Addendum A). Loaded implicitly into every program.\nexport { rtLayoutVersion } from \"./rt\";\nexport { trapShape, optUnwrap, resUnwrap, resUnwrapErr, vUnwrap, assertFact, assertArray } from \"./leaf\";\nexport { structNew, variant1, arrayNew } from \"./object\";\n" });
  out.push(SourceFile { path: "$rt/object.or", text: "// $rt/object -- allocation of structs and arrays, written in Orin (ADR-0052 Addendum A, step R3d.3 (a)).\n//\n// The backends call these functions by name (compiler/mir/rt.or lists them; opt/prune.or keeps them) in place of the C runtime\n// functions `orin_struct_new`, `orin_variant1` and `orin_array_new`; the C shells of the runtime reach them through the\n// exported wrappers of the same names that the emitted code defines. An object is its address as a `usize`. The layout and the\n// heap block are described in heap.or. A failed allocation traps \"out of memory\" in `memAlloc` itself. Counters and the\n// live-object balance are updated exactly as the C versions did (the ORIN_STATS=1 report is the equivalence oracle).\n\nimport { load64, store32, store64, memAlloc, memSet, heapBase, cfg, expect, wadd, shl, and } from \"std:core\";\nimport { taskTrap } from \"std:fsraw\";\nimport { sbAlloc, subAt, liveInc, statAlloc, S_ALLOC_STRUCT, S_ALLOC_ARRAY, FL_ARRAY, FL_N } from \"./heap\";\n\n// A new struct with all slots zero (null refs): `nslots` slots of 8 bytes behind the 32-byte header, rc 1. `refmask` bit i set:\n// slot i is a reference (at most 64 slots).\n@Inline\nexport function structNew(tag: usize, nslots: usize, refmask: usize): usize {\n  if (nslots > 64) {\n    taskTrap(\"struct has more than 64 slots\");\n  }\n  let s: usize = 0;\n  if (cfg(0) == 1 && nslots < 9) {\n    // the free list of this size: the next pointer is word 0 of a free object\n    const lp = wadd(heapBase(), shl(nslots, 3));\n    const head = load64(lp);\n    if (expect(head != 0, true)) {\n      store64(lp, load64(head));\n      subAt(wadd(wadd(heapBase(), FL_N), shl(nslots, 3)), 1);\n      s = head;\n    }\n  }\n  if (s == 0) {\n    s = memAlloc(wadd(32, shl(nslots, 3)));\n  }\n  store64(s, 1);\n  store32(wadd(s, 8), 3);\n  store32(wadd(s, 12), tag);\n  store32(wadd(s, 16), nslots);\n  store32(wadd(s, 20), 0);\n  store64(wadd(s, 24), refmask);\n  // small records dominate: plain stores, no loop and no call\n  if (nslots > 4) {\n    memSet(wadd(s, 32), 0, shl(nslots, 3));\n  } else {\n    if (nslots >= 1) {\n      store64(wadd(s, 32), 0);\n    }\n    if (nslots >= 2) {\n      store64(wadd(s, 40), 0);\n    }\n    if (nslots >= 3) {\n      store64(wadd(s, 48), 0);\n    }\n    if (nslots >= 4) {\n      store64(wadd(s, 56), 0);\n    }\n  }\n  liveInc();\n  statAlloc(S_ALLOC_STRUCT, wadd(32, shl(nslots, 3)));\n  return s;\n}\n\n// A variant with one slot; consumes the slot's reference if the slot is a ref (`refmask` 0 or 1).\n@Inline\nexport function variant1(tag: usize, refmask: usize, slot: usize): usize {\n  const o = structNew(tag, 1, and(refmask, 1));\n  store64(wadd(o, 32), slot);\n  return o;\n}\n\n// A new empty array of capacity `cap`; `isRef` != 0: the elements are references (retained / released).\n@Inline\nexport function arrayNew(cap: usize, isRef: usize): usize {\n  if (cap > 1099511627776) {\n    taskTrap(\"array too large\");\n  }\n  let a: usize = 0;\n  if (cfg(0) == 1) {\n    const lp = wadd(heapBase(), FL_ARRAY);\n    const head = load64(lp);\n    if (head != 0) {\n      store64(lp, load64(head));\n      subAt(wadd(wadd(heapBase(), FL_N), 72), 1);\n      a = head;\n    }\n  }\n  if (a == 0) {\n    a = memAlloc(48);\n  }\n  store64(a, 1);\n  store32(wadd(a, 8), 2);\n  store32(wadd(a, 12), 0);\n  store64(wadd(a, 16), 0);\n  store64(wadd(a, 24), cap);\n  store64(wadd(a, 32), isRef != 0 ? 1 : 0);\n  store64(wadd(a, 40), cap != 0 ? sbAlloc(shl(cap, 3)) : 0);\n  liveInc();\n  statAlloc(S_ALLOC_ARRAY, wadd(48, shl(cap, 3)));\n  return a;\n}\n" });
  out.push(SourceFile { path: "$rt/rt.or", text: "// $rt/rt -- the first module of the runtime core written in Orin (ADR-0052 Addendum A, step R3d.0; spec 19 section 3).\n//\n// `runtime/core/*.or` is the embedded root `$rt` (tools/embed_prelude.py, compiler/loader/prelude.or). Its entry\n// `$rt/module.or` is loaded into every compiled program like `$std`; unreferenced functions are pruned (compiler/opt/prune.or),\n// so a program that does not call into it is unchanged. Only modules of this root may import the internal module `std:core`\n// (the core operations of hir/coreops.or). The L1 object-model modules (layout, heap, object, rc, stats) of R3d.1..R3d.5 land here.\n\n// The version of the object layout that the L1 modules assume (spec 19; rule 3 of Addendum A section 2). It changes with the\n// frozen offsets, never otherwise.\nexport function rtLayoutVersion(): usize {\n  return 1;\n}\n" });
  return out;
}
