type Shape = Circle(int) | Rect(int, int) | Dot;

function main(): void {
  const area = (s: Shape): int => match (s) {
    Circle(r) => r * r * 3,
    Rect(w, h) => w * h,
    Dot => 0,
  };
  const name = (s: Shape): string => {
    return match (s) {
      Circle(_) => "circle",
      Rect(_, _) => "rect",
      Dot => "dot",
    };
  };
  const shapes = [Circle(2), Rect(3, 4), Dot];
  for (const s of shapes) {
    console.log(name(s) + " " + area(s).toString());
  }
  const total = shapes.map(area).reduce((a, b) => a + b, 0);
  console.log(total.toString());
  const describe = (n: int) => match (n) {
    0 => "zero",
    1 => "one",
    _ => "many",
  };
  console.log(describe(0) + describe(1) + describe(2));
  const classify = (o: Option<int>): string => match (o) {
    Some(v) => v > 10 ? "big" : "small",
    None => "none",
  };
  console.log(classify(Some(50)) + classify(Some(1)) + classify(None));
}
