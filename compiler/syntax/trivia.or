// Comment trivia scanner (spec 18 §1: comments are preserved for the formatter).
// The lexer discards comments; this scanner finds them again from the source text.
// It is string-literal aware, so `//` inside a string is not a comment.
// Only meaningful for source text that lexes successfully.

// A `//` or `/* */` comment. `[start, end)` is its byte span; `text` is the raw source text
// (for line comments without trailing whitespace). `ownLine`: only whitespace precedes it on its
// line. `blankBefore`: a blank line separates it from the previous token or comment.
export type Comment = {
  start: usize;
  end: usize;
  text: string;
  isLine: bool;
  ownLine: bool;
  blankBefore: bool;
};

function isSpace(c: int): bool {
  return c == 32 || c == 9 || c == 13 || c == 11 || c == 12;
}

function mkComment(src: string, start: usize, end: usize, isLine: bool, ownLine: bool, blank: bool): Comment {
  return Comment {
    start: start,
    end: end,
    text: src.substring(start, end),
    isLine: isLine,
    ownLine: ownLine,
    blankBefore: blank
  };
}

export function scanComments(src: string): Comment[] {
  let out: Comment[] = [];
  const n = src.length;
  let i: usize = 0;
  let nl: int = 0;
  let lineStart = true;
  while (i < n) {
    const c = src.charCodeAt(i);
    if (c == 10) {
      nl += 1;
      lineStart = true;
      i += 1;
    } else if (isSpace(c)) {
      i += 1;
    } else if (c == 34) {
      i += 1;
      while (i < n) {
        const d = src.charCodeAt(i);
        if (d == 92) {
          i += 2;
        } else if (d == 34) {
          i += 1;
          break;
        } else if (d == 10) {
          break;
        } else {
          i += 1;
        }
      }
      nl = 0;
      lineStart = false;
    } else if (c == 47 && i + 1 < n && src.charCodeAt(i + 1) == 47) {
      const s = i;
      while (i < n && src.charCodeAt(i) != 10) {
        i += 1;
      }
      let e = i;
      while (e > s && isSpace(src.charCodeAt(e - 1))) {
        e -= 1;
      }
      out.push(mkComment(src, s, e, true, lineStart, nl >= 2));
      nl = 0;
      lineStart = false;
    } else if (c == 47 && i + 1 < n && src.charCodeAt(i + 1) == 42) {
      const s = i;
      i += 2;
      let closed = false;
      while (i < n && !closed) {
        if (src.charCodeAt(i) == 42 && i + 1 < n && src.charCodeAt(i + 1) == 47) {
          closed = true;
          i += 2;
        } else {
          i += 1;
        }
      }
      out.push(mkComment(src, s, i, false, lineStart, nl >= 2));
      nl = 0;
      lineStart = false;
    } else {
      nl = 0;
      lineStart = false;
      i += 1;
    }
  }
  return out;
}
