import { assert, assertEq, assertEqUsize, assertEqString, assertEqBool } from "std:test";
import {
  Input, Output, MDecl, MDeclView, MFieldView, MMethodView, MAnnotation, MArg, MContract,
  MTypeShape, MRef, MCBool, MCInt, MCFloat, MCString, MCTag, MCArray, MCNone, MCSome, MConst,
  MNamed, MArray, MOption, MResult, MFn, MUnion, MType, MVariant, MKRecord, MKUnion, MKAlias,
  MKClass, MKInterface, MKFunction, MKConst, MRequires, MEnsures, MInvariant, MDecreases, MRule,
  MSRecord, MSUnion, MSAlias, MSOpaque, MDFn, MDConst, MDRecord, MDUnion, MDClass, MStmt, OpNeg,
  OpNot, OpBitNot, OpAdd, OpSub, OpMul, OpDiv, OpRem, OpEq, OpNe, OpLt, OpLe, OpGt, OpGe, OpAnd,
  OpOr, OpBitAnd, OpBitOr, OpBitXor, OpShl, OpShr, fresh, nameGen, ref, annotationArg,
  findAnnotation, constString, constInt, constBool, emptyInput, named, generic, arrayOf, optionOf,
  resultOf, fnOf, unionOf, variant, param, cInt, cStr, cBool, pWild, pBind, pVariant, pLit, intLit,
  floatLit, str, boolLit, name, call, callExpr, callGeneric, method, dot, index, initField, record,
  arrayLit, unary, binary, neg, not, add, sub, mul, div, rem, eq, ne, lt, le, gt, ge, andAlso,
  orElse, tryOp, cond, arm, armStmts, matchExpr, constS, constT, letS, letT, assign, ret, retVoid,
  exprS, ifS, whileS, forOf, matchS, fn, constant, recordType, unionType, classField, ctor,
  methodDecl, classType, declName, declExported, exportDecl, withTypeParams, withDoc, importFrom,
  diagError, diagWarning, emptyOutput, output, withImports, withDiagnostics, hasErrors, encodeInput,
  decodeInput, encodeOutput, decodeOutput, inputToJson, outputToJson,
} from "std:meta";
import { parse, stringify } from "std:json/legacy";

function sampleAnnotation(): MAnnotation {
  return MAnnotation {
    source: "./route",
    name: "Route",
    args: [
      MArg { name: "path", value: MCString("/users/:id \"q\"\n") },
      MArg { name: "verb", value: MCTag("Get") },
      MArg { name: "auth", value: MCNone },
      MArg { name: "limit", value: MCSome(MCInt(-7)) },
      MArg { name: "ratio", value: MCFloat("1.5e3") },
      MArg { name: "on", value: MCBool(true) },
      MArg { name: "tags", value: MCArray([MCString("a"), MCString("b")]) },
    ],
  };
}

function sampleInput(): Input {
  const userTy = named("User");
  const field1 = MFieldView {
    ref: ref(2),
    name: "id",
    ty: named("int"),
    exported: true,
    annotations: [],
  };
  const field2 = MFieldView {
    ref: ref(3),
    name: "name",
    ty: optionOf(arrayOf(generic("Pair", [named("string"), named("int")]))),
    exported: true,
    annotations: [
      MAnnotation {
        source: "std:json/legacy",
        name: "JsonName",
        args: [MArg { name: "name", value: MCString("display_name") }],
      },
    ],
  };
  const method1 = MMethodView {
    ref: ref(5),
    name: "find",
    exported: true,
    typeParams: ["T"],
    params: [
      param("id", named("int")),
      param("cb", fnOf([named("T")], resultOf(userTy, named("string")))),
    ],
    returns: resultOf(userTy, named("string")),
    doc: "Finds a user.",
    annotations: [sampleAnnotation()],
    contracts: [
      MContract { kind: MRequires, text: "id > 0" },
      MContract { kind: MEnsures, text: "result.isOk()" },
    ],
  };
  const recordDecl = MDeclView {
    ref: ref(1),
    kind: MKRecord,
    name: "User",
    exported: true,
    typeParams: [],
    doc: "A user.\nSecond line.",
    annotations: [MAnnotation { source: "std:json/legacy", name: "Json", args: [] }],
    contracts: [MContract { kind: MInvariant, text: "this.id >= 0" }],
    fields: [field1, field2],
    ctorParams: [],
    methods: [],
    variants: [],
    params: [],
    ty: None,
  };
  const classDecl = MDeclView {
    ref: ref(4),
    kind: MKClass,
    name: "Users",
    exported: false,
    typeParams: ["K", "V"],
    doc: "",
    annotations: [],
    contracts: [],
    fields: [field1],
    ctorParams: [param("cap", named("usize"))],
    methods: [method1],
    variants: [],
    params: [],
    ty: None,
  };
  const unionDecl = MDeclView {
    ref: ref(6),
    kind: MKUnion,
    name: "Verb",
    exported: true,
    typeParams: [],
    doc: "",
    annotations: [],
    contracts: [],
    fields: [],
    ctorParams: [],
    methods: [],
    variants: [variant("Get", []), variant("Post", [named("string"), MUnion([variant("A", [])])])],
    params: [],
    ty: None,
  };
  const fnDecl = MDeclView {
    ref: ref(7),
    kind: MKFunction,
    name: "main2",
    exported: true,
    typeParams: [],
    doc: "",
    annotations: [],
    contracts: [MContract { kind: MDecreases, text: "n" }, MContract { kind: MRule, text: "r" }],
    fields: [],
    ctorParams: [],
    methods: [],
    variants: [],
    params: [param("n", named("int"))],
    ty: Some(named("void")),
  };
  const aliasDecl = MDeclView {
    ref: ref(8),
    kind: MKAlias,
    name: "Id",
    exported: false,
    typeParams: [],
    doc: "",
    annotations: [],
    contracts: [],
    fields: [],
    ctorParams: [],
    methods: [],
    variants: [],
    params: [],
    ty: Some(named("int")),
  };
  const ifaceDecl = MDeclView {
    ref: ref(9),
    kind: MKInterface,
    name: "Shape",
    exported: true,
    typeParams: [],
    doc: "",
    annotations: [],
    contracts: [],
    fields: [],
    ctorParams: [],
    methods: [],
    variants: [],
    params: [],
    ty: None,
  };
  const constDecl = MDeclView {
    ref: ref(10),
    kind: MKConst,
    name: "LIMIT",
    exported: true,
    typeParams: [],
    doc: "",
    annotations: [],
    contracts: [],
    fields: [],
    ctorParams: [],
    methods: [],
    variants: [],
    params: [],
    ty: Some(named("int")),
  };
  return Input {
    modulePath: "models",
    annotation: "Json",
    freshBase: 4000,
    decls: [recordDecl, classDecl, unionDecl, fnDecl, aliasDecl, ifaceDecl, constDecl],
    types: [
      MTypeShape { name: "User", source: "models", typeParams: [], shape: MSRecord([field1]) },
      MTypeShape {
        name: "Verb",
        source: "./route",
        typeParams: [],
        shape: MSUnion([variant("Get", [])]),
      },
      MTypeShape { name: "Id", source: "models", typeParams: [], shape: MSAlias(named("int")) },
      MTypeShape {
        name: "Map",
        source: "std:collections",
        typeParams: ["K", "V"],
        shape: MSOpaque,
      },
    ],
  };
}

function sampleBody(): MStmt[] {
  return [
    constS("a", intLit(1)),
    constT("b", named("int"), neg(intLit(2))),
    letS("c", floatLit("0.5")),
    letT("d", arrayOf(named("string")), arrayLit([str("x\ty"), str("")])),
    assign(name("c"), add(name("a"), mul(name("b"), intLit(3)))),
    assign(index(name("xs"), intLit(0)), dot(name("u"), "id")),
    exprS(method(name("xs"), "push", [boolLit(false)])),
    ifS(
      andAlso(lt(name("a"), name("b")), not(eq(name("a"), intLit(0)))),
      [retVoid()],
      [ret(callGeneric("f", [named("T")], []))],
    ),
    whileS(
      orElse(le(name("a"), intLit(9)), ge(name("a"), intLit(1))),
      [assign(name("a"), sub(name("a"), intLit(1)))],
    ),
    forOf(
      "x",
      name("xs"),
      [exprS(call("g", [name("x"), div(intLit(1), intLit(2)), rem(intLit(1), intLit(2))]))],
    ),
    matchS(
      name("o"),
      [
        armStmts(pVariant("Some", [pBind("v")]), [exprS(call("h", [name("v")]))], None),
        arm(pVariant("None", []), intLit(0)),
        arm(pWild(), intLit(1)),
      ],
    ),
    ret(
      matchExpr(
        name("r"),
        [
          arm(
            pVariant("Ok", [pBind("v")]),
            cond(gt(name("v"), intLit(0)), name("v"), tryOp(call("k", []))),
          ),
          arm(
            pVariant("Err", [pWild()]),
            record("User", [initField("id", intLit(0)), initField("name", str("n"))]),
          ),
          arm(pLit(cInt(3)), callExpr(dot(name("o"), "f"), [binary(OpNe, name("a"), name("b"))])),
          arm(pLit(cStr("s")), unary(OpBitNot, name("a"))),
          arm(
            pLit(cBool(true)),
            binary(
              OpShl,
              binary(OpBitAnd, name("a"), name("b")),
              binary(
                OpBitXor,
                name("a"),
                binary(OpBitOr, name("a"), binary(OpShr, name("a"), intLit(1))),
              ),
            ),
          ),
        ],
      ),
    ),
  ];
}

function sampleOutput(): Output {
  const body = sampleBody();
  const classD = classType(
    "Box",
    [classField("v", named("int"), false), classField("w", generic("Option", [named("T")]), true)],
    Some(ctor([param("v", named("int"))], [assign(dot(name("this"), "v"), name("v"))])),
    [methodDecl("get", true, [], named("int"), [ret(dot(name("this"), "v"))])],
  );
  const decls: MDecl[] = [
    exportDecl(fn("encodeUser", [param("u", named("User"))], named("Json"), body), true),
    withDoc(constant("LIMIT", named("int"), intLit(10)), "doc\nlines"),
    withTypeParams(
      recordType("Pair", [param("a", named("A")), param("b", named("B"))]),
      ["A", "B"],
    ),
    unionType("Shape", [variant("Circle", [named("float")]), variant("Dot", [])]),
    withTypeParams(exportDecl(classD, true), ["T"]),
  ];
  const o = output(decls);
  const o2 = withImports(o, [importFrom(["Json", "JNull"], "std:json/legacy")]);
  return withDiagnostics(o2, [diagError(ref(5), "bad \"thing\""), diagWarning(ref(2), "careful")]);
}

@Test
function builtExpressionShape(): void {
  const d = fn(
    "encodeUser",
    [param("u", named("User"))],
    named("Json"),
    [ret(call("x", [name("u")]))],
  );
  assertEqString(declName(d), "encodeUser", "name");
  assertEqBool(declExported(d), false, "private by default");
  const e = exportDecl(d, true);
  assertEqBool(declExported(e), true, "exported");
  assertEqBool(declExported(exportDecl(e, false)), false, "unexported");
  assertEqString(declName(e), "encodeUser", "name kept");
  match (e) {
    MDFn(f) => {
      assertEqUsize(f.params.length, 1, "one param");
      assertEqString(f.params[0].name, "u", "param name");
      assertEqUsize(f.body.length, 1, "one statement");
      assertEqString(f.doc, "", "no doc");
    },
    _ => assert(false, "a function"),
  }
  assertEqString(declName(constant("K", named("int"), intLit(1))), "K", "const name");
  assertEqString(declName(recordType("R", [])), "R", "record name");
  assertEqString(declName(unionType("U", [])), "U", "union name");
  assertEqString(declName(classType("C", [], None, [])), "C", "class name");
  match (withDoc(constant("K", named("int"), intLit(1)), "hello")) {
    MDConst(c) => assertEqString(c.doc, "hello", "doc"),
    _ => assert(false, "a const"),
  }
  match (withTypeParams(unionType("U", []), ["T"])) {
    MDUnion(u) => assertEqUsize(u.typeParams.length, 1, "type params"),
    _ => assert(false, "a union"),
  }
}

@Test
function freshNamesAreDeterministic(): void {
  assertEqString(fresh("tmp", 0), "__g0_tmp", "zero");
  assertEqString(fresh("tmp", 12), "__g12_tmp", "twelve");
  assertEqString(fresh("tmp", 12), fresh("tmp", 12), "pure");
  assert(fresh("a", 1) != fresh("a", 2), "different counters differ");
  let g = nameGen(7);
  assertEqString(g.fresh("x"), "__g7_x", "first");
  assertEqString(g.fresh("x"), "__g8_x", "second differs");
  assertEqString(g.fresh("y"), "__g9_y", "third");
  assertEq(g.peek(), 10, "peek");
  let h = nameGen(7);
  assertEqString(h.fresh("x"), "__g7_x", "an independent generator repeats");
}

@Test
function inputHelpers(): void {
  const a = sampleAnnotation();
  assertEqString(
    constString(annotationArg(a, "path").unwrap()).unwrap(),
    "/users/:id \"q\"\n",
    "string arg",
  );
  assert(annotationArg(a, "nope").isNone(), "missing arg");
  assert(constInt(annotationArg(a, "path").unwrap()).isNone(), "wrong kind");
  assertEqBool(constBool(annotationArg(a, "on").unwrap()).unwrap(), true, "bool arg");
  assert(findAnnotation([a], "Route").isSome(), "found");
  assert(findAnnotation([a], "Other").isNone(), "not found");
  const e = emptyInput("m", "A");
  assertEqUsize(e.decls.length, 0, "empty");
}

@Test
function inputRoundTrips(): void {
  const i = sampleInput();
  const text = encodeInput(i);
  const back = decodeInput(text);
  assert(back.isOk(), "decodes: " + (back.isErr() ? back.unwrapErr() : ""));
  assertEqString(encodeInput(back.unwrap()), text, "encode(decode(encode(x))) == encode(x)");
  const j = back.unwrap();
  assertEqString(j.modulePath, "models", "module");
  assertEq(j.freshBase, 4000, "base");
  assertEqUsize(j.decls.length, 7, "decls");
  assertEqUsize(j.types.length, 4, "types");
  assertEqString(j.decls[0].doc, "A user.\nSecond line.", "doc with newline");
  assertEqString(
    j.decls[1].methods[0].annotations[0].args[0].name,
    "path",
    "nested annotation arg",
  );
}

@Test
function inputEncodingIsStable(): void {
  const text = encodeInput(emptyInput("m", "A"));
  assertEqString(
    text,
    "{\"format\":\"orin.meta.input\",\"version\":1,\"modulePath\":\"m\",\"annotation\":\"A\",\"freshBase\":0,\"decls\":[],\"types\":[]}",
    "golden empty input",
  );
  assertEqString(encodeInput(sampleInput()), encodeInput(sampleInput()), "same value, same bytes");
  assertEqString(
    stringify(inputToJson(sampleInput())),
    encodeInput(sampleInput()),
    "json view agrees",
  );
  const one = Input {
    modulePath: "m",
    annotation: "A",
    freshBase: 1,
    decls: [],
    types: [
      MTypeShape {
        name: "T",
        source: "m",
        typeParams: [],
        shape: MSAlias(MResult(MOption(MArray(named("a"))), MFn([named("b")], named("c")))),
      },
    ],
  };
  assertEqString(
    encodeInput(one),
    "{\"format\":\"orin.meta.input\",\"version\":1,\"modulePath\":\"m\",\"annotation\":\"A\",\"freshBase\":1,\"decls\":[],\"types\":[{\"name\":\"T\",\"source\":\"m\",\"typeParams\":[],\"shape\":{\"k\":\"alias\",\"ty\":{\"k\":\"result\",\"ok\":{\"k\":\"option\",\"elem\":{\"k\":\"array\",\"elem\":{\"k\":\"named\",\"name\":\"a\",\"args\":[]}}},\"err\":{\"k\":\"fn\",\"params\":[{\"k\":\"named\",\"name\":\"b\",\"args\":[]}],\"returns\":{\"k\":\"named\",\"name\":\"c\",\"args\":[]}}}}}]}",
    "golden type tree",
  );
}

@Test
function outputRoundTrips(): void {
  const o = sampleOutput();
  const text = encodeOutput(o);
  const back = decodeOutput(text);
  assert(back.isOk(), "decodes: " + (back.isErr() ? back.unwrapErr() : ""));
  assertEqString(encodeOutput(back.unwrap()), text, "stable round trip");
  const r = back.unwrap();
  assertEqUsize(r.decls.length, 5, "decls");
  assertEqUsize(r.imports.length, 1, "imports");
  assertEqUsize(r.diagnostics.length, 2, "diagnostics");
  assertEqBool(hasErrors(r), true, "has errors");
  assertEq(r.diagnostics[0].at.id, 5, "span ref kept");
  assertEqString(declName(r.decls[4]), "Box", "class kept");
  assertEqBool(declExported(r.decls[0]), true, "export flag kept");
  assertEqBool(hasErrors(withDiagnostics(r, [diagWarning(ref(1), "w")])), false, "warnings only");
  assertEqBool(hasErrors(emptyOutput()), false, "empty");
}

@Test
function outputEncodingIsStable(): void {
  assertEqString(
    encodeOutput(emptyOutput()),
    "{\"format\":\"orin.meta.output\",\"version\":1,\"imports\":[],\"decls\":[],\"diagnostics\":[]}",
    "golden empty output",
  );
  const o = output([
    exportDecl(
      fn("f", [param("x", named("int"))], named("int"), [ret(add(name("x"), intLit(1)))]),
      true,
    ),
  ]);
  assertEqString(
    encodeOutput(o),
    "{\"format\":\"orin.meta.output\",\"version\":1,\"imports\":[],\"decls\":[{\"k\":\"fn\",\"decl\":{\"name\":\"f\",\"exported\":true,\"typeParams\":[],\"params\":[{\"name\":\"x\",\"ty\":{\"k\":\"named\",\"name\":\"int\",\"args\":[]}}],\"returns\":{\"k\":\"named\",\"name\":\"int\",\"args\":[]},\"body\":[{\"k\":\"return\",\"value\":{\"k\":\"binary\",\"op\":\"+\",\"left\":{\"k\":\"name\",\"name\":\"x\"},\"right\":{\"k\":\"int\",\"v\":1}}}],\"doc\":\"\"}}],\"diagnostics\":[]}",
    "golden function",
  );
  assertEqString(stringify(outputToJson(o)), encodeOutput(o), "json view agrees");
}

@Test
function everyOperatorRoundTrips(): void {
  const ops = [
    OpAdd,
    OpSub,
    OpMul,
    OpDiv,
    OpRem,
    OpEq,
    OpNe,
    OpLt,
    OpLe,
    OpGt,
    OpGe,
    OpAnd,
    OpOr,
    OpBitAnd,
    OpBitOr,
    OpBitXor,
    OpShl,
    OpShr,
  ];
  let body: MStmt[] = [];
  for (const op of ops) {
    body.push(exprS(binary(op, name("a"), name("b"))));
  }
  for (const op of [OpNeg, OpNot, OpBitNot]) {
    body.push(exprS(unary(op, name("a"))));
  }
  const text = encodeOutput(output([fn("f", [], named("void"), body)]));
  const back = decodeOutput(text);
  assert(back.isOk(), "decodes");
  assertEqString(encodeOutput(back.unwrap()), text, "all operators survive");
}

function rejects(text: string, fragment: string, what: string): void {
  const r = decodeInput(text);
  assert(r.isErr(), what + ": input rejected");
  assert(
    r.unwrapErr().indexOf(fragment).isSome(),
    what + ": message mentions `" + fragment + "`, got: " + r.unwrapErr(),
  );
}

function rejectsOutput(text: string, fragment: string, what: string): void {
  const r = decodeOutput(text);
  assert(r.isErr(), what + ": output rejected");
  assert(
    r.unwrapErr().indexOf(fragment).isSome(),
    what + ": message mentions `" + fragment + "`, got: " + r.unwrapErr(),
  );
}

@Test
function malformedInputIsAnErrorNotATrap(): void {
  rejects("", "invalid JSON", "empty");
  rejects("{", "invalid JSON", "truncated");
  rejects("[1,2", "invalid JSON", "array");
  rejects("null", "expected an object", "null");
  rejects("{}", "missing key `format`", "no format");
  rejects("{\"format\":\"nope\",\"version\":1}", "expected \"orin.meta.input\"", "wrong format");
  rejects(
    "{\"format\":\"orin.meta.output\",\"version\":1}",
    "expected \"orin.meta.input\"",
    "output as input",
  );
  rejects("{\"format\":\"orin.meta.input\",\"version\":2}", "unsupported 2", "version");
  rejects(
    "{\"format\":\"orin.meta.input\",\"version\":\"1\"}",
    "version: expected an integer",
    "version type",
  );
  rejects(
    "{\"format\":\"orin.meta.input\",\"version\":1}",
    "missing key `modulePath`",
    "no module",
  );
  rejects(
    "{\"format\":\"orin.meta.input\",\"version\":1,\"modulePath\":\"m\",\"annotation\":\"A\",\"freshBase\":0,\"decls\":{},\"types\":[]}",
    ".decls: expected an array",
    "decls not an array",
  );
  rejects(
    "{\"format\":\"orin.meta.input\",\"version\":1,\"modulePath\":\"m\",\"annotation\":\"A\",\"freshBase\":0,\"decls\":[],\"types\":[{\"name\":\"T\",\"source\":\"m\",\"typeParams\":[],\"shape\":{\"k\":\"alias\",\"ty\":{\"k\":\"bogus\"}}}]}",
    ".types[0].shape.ty: unknown type kind \"bogus\"",
    "unknown type kind with path",
  );
  rejects(
    "{\"format\":\"orin.meta.input\",\"version\":1,\"modulePath\":\"m\",\"annotation\":\"A\",\"freshBase\":0,\"decls\":[],\"types\":[{\"name\":1,\"source\":\"m\",\"typeParams\":[],\"shape\":{\"k\":\"opaque\"}}]}",
    ".types[0].name: expected a string",
    "wrong member type",
  );
}

@Test
function malformedOutputIsAnErrorNotATrap(): void {
  rejectsOutput("[]", "expected an object", "array");
  rejectsOutput(
    "{\"format\":\"orin.meta.output\",\"version\":1}",
    "missing key `imports`",
    "no imports",
  );
  const head = "{\"format\":\"orin.meta.output\",\"version\":1,\"imports\":[],\"diagnostics\":[],\"decls\":";
  rejectsOutput(
    head + "[{\"k\":\"enum\",\"decl\":{}}]}",
    ".decls[0]: unknown declaration kind \"enum\"",
    "decl kind",
  );
  rejectsOutput(head + "[{\"k\":\"fn\"}]}", ".decls[0]: missing key `decl`", "no decl");
  rejectsOutput(
    head
        + "[{\"k\":\"const\",\"decl\":{\"name\":\"K\",\"exported\":false,\"ty\":{\"k\":\"named\",\"name\":\"int\",\"args\":[]},\"value\":{\"k\":\"binary\",\"op\":\"**\",\"left\":{\"k\":\"int\",\"v\":1},\"right\":{\"k\":\"int\",\"v\":2}},\"doc\":\"\"}}]}",
    "unknown binary operator \"**\"",
    "operator",
  );
  rejectsOutput(
    "{\"format\":\"orin.meta.output\",\"version\":1,\"imports\":[],\"decls\":[],\"diagnostics\":[{\"severity\":\"fatal\",\"message\":\"m\",\"at\":1}]}",
    "unknown severity \"fatal\"",
    "severity",
  );
  rejectsOutput(
    "{\"format\":\"orin.meta.output\",\"version\":1,\"imports\":[],\"decls\":[],\"diagnostics\":[{\"severity\":\"error\",\"message\":\"m\",\"at\":1.5}]}",
    "floats are not supported",
    "float where an int is expected is a JSON error",
  );
}

@Test
function deepNestingIsAnErrorNotATrap(): void {
  let text = "{\"k\":\"named\",\"name\":\"x\",\"args\":[]}";
  let i = 0;
  while (i < 300) {
    text = "{\"k\":\"array\",\"elem\":" + text + "}";
    i += 1;
  }
  const doc = "{\"format\":\"orin.meta.input\",\"version\":1,\"modulePath\":\"m\",\"annotation\":\"A\",\"freshBase\":0,\"decls\":[],\"types\":[{\"name\":\"T\",\"source\":\"m\",\"typeParams\":[],\"shape\":{\"k\":\"alias\",\"ty\":"
      + text + "}}]}";
  const r = decodeInput(doc);
  assert(r.isErr(), "300 levels are refused by the JSON limit");
}

@Test
function keyOrderOnInputIsFree(): void {
  const doc = "{\"types\":[],\"decls\":[],\"freshBase\":3,\"annotation\":\"A\",\"modulePath\":\"m\",\"version\":1,\"format\":\"orin.meta.input\",\"extra\":true}";
  const r = decodeInput(doc);
  assert(r.isOk(), "any key order, unknown keys ignored");
  assertEq(r.unwrap().freshBase, 3, "value read");
  assert(parse(encodeInput(r.unwrap())).isOk(), "re-encoded is valid JSON");
}
