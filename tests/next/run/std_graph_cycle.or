import { newGraph, add, addEdge, neighbors, get, GraphId, Graph } from "std:graph";

// A cyclic structure (ring of 5 nodes) built from checked ids, walked without owning cycles.
function main(): void {
  let g = newGraph<int>(11);
  let ids: GraphId<int>[] = [];
  let i: usize = 0;
  while (i < 5) {
    const r = add(g, i.toInt() * i.toInt());
    g = r.graph;
    ids.push(r.id);
    i += 1;
  }
  i = 0;
  while (i < 5) {
    g = addEdge(g, ids[i], ids[(i + 1) % 5]).unwrap();
    i += 1;
  }
  let cur = ids[0];
  let trail: string[] = [];
  let steps = 0;
  while (steps < 7) {
    trail.push(get(g, cur).unwrap().toString());
    cur = neighbors(g, cur).unwrap()[0];
    steps += 1;
  }
  console.log(trail.join(" -> "));
}
