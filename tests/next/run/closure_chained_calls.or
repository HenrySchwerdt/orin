function mk(n: int): (m: int) => int {
  return m => n * m;
}

function main(): void {
  console.log(mk(6)(7).toString());
  console.log(((x: int) => x + 1)(2).toString());
  console.log(((a: int, b: int) => a - b)(10, 4).toString());
  const fs = [mk(2), mk(3)];
  console.log(fs[0](5).toString() + fs[1](5).toString());
  const nested = [[mk(1)], [mk(2), mk(3)]];
  console.log(nested[1][1](10).toString());
  const cur = (a: int) => (b: int) => (c: int) => a + b * c;
  console.log(cur(1)(2)(3).toString());
}
