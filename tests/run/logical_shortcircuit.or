function t(name: string): bool {
  console.log("t:" + name);
  return true;
}

function f(name: string): bool {
  console.log("f:" + name);
  return false;
}

function main(): void {
  const a = f("1") && t("2");
  const b = t("3") || f("4");
  const c = t("5") && f("6");
  const d = f("7") || t("8");
  console.log(a.toString());
  console.log(b.toString());
  console.log(c.toString());
  console.log(d.toString());
  const e = t("9") ? t("10") : f("11");
  const g = f("12") ? t("13") : f("14");
  console.log(e.toString());
  console.log(g.toString());
  if (f("15") && t("16")) { console.log("no"); }
  if (t("17") || t("18")) { console.log("yes"); }
  const z = 0;
  const safe = z != 0 && 10 / z > 1;
  const safe2 = z == 0 || 10 / z > 1;
  console.log(safe.toString());
  console.log(safe2.toString());
}
