type Tree<T> = Leaf | Node(Tree<T>, T, Tree<T>);

function size<T>(t: Tree<T>): int {
  return match (t) {
    Leaf => 0,
    Node(l, _, r) => size(l) + 1 + size(r),
  };
}

function height<T>(t: Tree<T>): int {
  return match (t) {
    Leaf => 0,
    Node(l, _, r) => {
      const a = height(l);
      const b = height(r);
      return 1 + (a > b ? a : b);
    },
  };
}

function inorder<T>(t: Tree<T>): T[] {
  return match (t) {
    Leaf => [],
    Node(l, v, r) => inorder(l).concat([v]).concat(inorder(r)),
  };
}

function singleton<T>(v: T): Tree<T> {
  return Node(Leaf, v, Leaf);
}

function insertInt(t: Tree<int>, v: int): Tree<int> {
  return match (t) {
    Leaf => singleton(v),
    Node(l, x, r) => v < x ? Node(insertInt(l, v), x, r) : Node(l, x, insertInt(r, v)),
  };
}

function main(): void {
  let t: Tree<int> = Leaf;
  for (const v of [5, 2, 8, 1, 9, 3]) {
    t = insertInt(t, v);
  }
  console.log(size(t).toString());
  console.log(height(t).toString());
  let parts: string[] = [];
  for (const v of inorder(t)) {
    parts.push(v.toString());
  }
  console.log(parts.join(" "));
  const s = Node(singleton("a"), "b", singleton("c"));
  console.log(inorder(s).join(""));
  console.log(size(s).toString());
  const e: Tree<string> = Leaf;
  console.log(size(e).toString());
}
