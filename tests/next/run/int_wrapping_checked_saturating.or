// wrapping*, saturating* and checked* Add / Sub / Mul on every integer type.
function show(o: Option<i64>): string {
  return match (o) {
    Some(v) => "Some(" + v.toString() + ")",
    None => "None"
  };
}

function main(): void {
  // u8
  const a: u8 = 200;
  console.log(a.wrappingAdd(100).toString());
  console.log(a.wrappingSub(201).toString());
  console.log(a.wrappingMul(2).toString());
  console.log(a.saturatingAdd(100).toString());
  console.log(a.saturatingSub(250).toString());
  console.log(a.saturatingMul(2).toString());
  console.log(a.checkedAdd(55).unwrap().toString());
  console.log(a.checkedAdd(56).isNone().toString());
  console.log(a.checkedSub(200).unwrap().toString());
  console.log(a.checkedSub(201).isNone().toString());
  console.log(a.checkedMul(1).unwrap().toString());
  console.log(a.checkedMul(2).isNone().toString());

  // i8: wrapping around both ends
  const b: i8 = 127;
  const c: i8 = -128;
  console.log(b.wrappingAdd(1).toString());
  console.log(c.wrappingSub(1).toString());
  console.log(c.wrappingMul(-1).toString());
  console.log(b.wrappingMul(b).toString());
  console.log(b.saturatingAdd(1).toString());
  console.log(c.saturatingSub(1).toString());
  console.log(c.saturatingMul(-1).toString());
  console.log(b.saturatingMul(-2).toString());
  console.log(b.checkedAdd(1).isNone().toString());
  console.log(c.checkedMul(-1).isNone().toString());
  console.log(c.checkedSub(-1).unwrap().toString());

  // i16, u16, i32, u32
  const d: i16 = 32767;
  console.log(d.wrappingAdd(2).toString());
  const e: u16 = 0;
  console.log(e.wrappingSub(1).toString());
  const f: i32 = 2147483647;
  console.log(f.wrappingAdd(f).toString());
  console.log(f.wrappingMul(f).toString());
  const g: u32 = 4294967295;
  console.log(g.wrappingAdd(2).toString());
  console.log(g.wrappingMul(g).toString());
  console.log(g.saturatingMul(g).toString());
  console.log(f.saturatingAdd(1).toString());

  // 64-bit types
  const h: i64 = 9223372036854775807;
  console.log(h.wrappingAdd(1).toString());
  console.log(h.wrappingMul(2).toString());
  console.log(h.saturatingAdd(5).toString());
  console.log(show(h.checkedAdd(1)));
  console.log(show(h.checkedSub(1)));
  const i: i64 = -9223372036854775808;
  console.log(i.wrappingSub(1).toString());
  console.log(i.saturatingSub(1).toString());
  console.log(show(i.checkedMul(-1)));
  const j: u64 = 18446744073709551615;
  console.log(j.wrappingAdd(2).toString());
  console.log(j.wrappingMul(j).toString());
  console.log(j.saturatingAdd(1).toString());
  console.log(j.checkedAdd(0).unwrap().toString());
  console.log(j.checkedAdd(1).isNone().toString());
  const k: u64 = 0;
  console.log(k.wrappingSub(1).toString());
  console.log(k.saturatingSub(1).toString());
  console.log(k.checkedSub(1).isNone().toString());
  const l: usize = 0;
  console.log(l.wrappingSub(1).toString());
  const m: isize = 9223372036854775807;
  console.log(m.wrappingAdd(1).toString());
  console.log(m.checkedMul(2).isNone().toString());

  // FNV-1a style hash: 64-bit wrapping multiplication
  let hash: u64 = 14695981039346656037;
  for (const byte of [104, 101, 108, 108, 111]) {
    hash = hash.wrappingMul(1099511628211).wrappingAdd(byte.toU64());
  }
  console.log(hash.toString());

  // the results are ordinary values of the receiver type
  const sum: u8 = a.wrappingAdd(100) + 1;
  console.log(sum.toString());
  const maybe: Option<u8> = a.checkedAdd(10);
  console.log(maybe.unwrapOr(0).toString());
}
