import { readFile } from "std:fs";

export type Shape = Circle(int) | Rect(int, int) | Empty;
export type Point = { x: int; y: int; };
type Name = string;

export const MAX: int = 10;

export function area(s: Shape): int {
  return match (s) {
    Circle(r) => r * r * 3,
    Rect(w, h) => w * h,
    Empty => 0,
  };
}

function move(p: Point, dx: int): Point {
  return Point { ...p, x: p.x + dx };
}

export function main(): void {
  let total = 0;
  const shapes: Shape[] = [Circle(2), Rect(3, 4), Empty];
  for (const s of shapes) {
    total += area(s);
  }
  const p = move(Point { x: 1, y: 2 }, 5);
  console.log(total > 10 ? "big" : "small");
  console.log(p.x.toString());
}
