// Word frequency over 1,000,000 generated words using a hand-written bucketed table
// (1024 buckets, each an array of records, linear probing inside a bucket). No maps.
type Entry = { word: string; count: int; };

function lcg(x: int): int {
  return (x * 1103515245 + 12345) % 2147483648;
}

function hash(w: string): usize {
  let h: usize = 0;
  let i: usize = 0;
  while (i < w.length) {
    h = (h * 31 + w.charCodeAt(i).toUsize()) % 1024;
    i += 1;
  }
  return h;
}

function findIdx(buckets: Entry[][], h: usize, w: string): int {
  const b = buckets[h];
  let j: usize = 0;
  while (j < b.length) {
    if (b[j].word == w) { return j.toInt(); }
    j += 1;
  }
  return -1;
}

function main(): void {
  let buckets: Entry[][] = [];
  let i = 0;
  while (i < 1024) {
    const empty: Entry[] = [];
    buckets.push(empty);
    i += 1;
  }
  let x = 42;
  let n = 0;
  while (n < 1000000) {
    x = lcg(x);
    const w = "w" + ((x / 65536) % 5000).toString();
    const h = hash(w);
    const idx = findIdx(buckets, h, w);
    if (idx >= 0) {
      buckets[h][idx.toUsize()].count += 1;
    } else {
      buckets[h].push(Entry { word: w, count: 1 });
    }
    n += 1;
  }
  let distinct = 0;
  let weighted = 0;
  let maxCount = 0;
  for (const b of buckets) {
    for (const e of b) {
      distinct += 1;
      weighted += e.count * e.word.length.toInt();
      if (e.count > maxCount) { maxCount = e.count; }
    }
  }
  console.log("distinct " + distinct.toString());
  console.log("weighted " + weighted.toString());
  console.log("max " + maxCount.toString());
}
