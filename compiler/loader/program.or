// Loader output types — Stage 1 shared contract (v1). Mirrors the interface section of
// bootstrap/src/loader.rs. Owned by the lead architect.

import { Module } from "../syntax";
import { Manifest } from "../package";

// StdFs = "std:fsraw" (internal: the primitives behind std:fs, stdlib/fs.or), StdProcess = "std:process", StdIo = "std:io", StdClock = "std:clock" (internal; std:time wraps it)
export type ImportTarget = ImportUnit(usize) | ImportStd(StdModule);
export type StdModule = StdFs | StdProcess | StdIo | StdClock;

export type Unit = {
  file: usize;            // index into SourceMap.files
  path: string;           // normalized path (as opened)
  name: string;           // relative to the entry file's directory, "/"-separated, no ".or"
  module: string;         // module id: directory of the nearest enclosing `module.or` relative to the src root ("." = root; "" = prelude/outside the src root)
  ast: Module;
  imports: ImportTarget[];  // one per IImport / IReExport item, in item order
};

// units are topologically sorted (dependencies first, entry last); entry = index of entry.
// `manifest` is Some when an orin.toml governs the load (its rules were enforced by the loader).
export type LoadedProgram = { units: Unit[]; entry: usize; manifest: Option<Manifest>; };
