.length;\n    if (kk > 0 && kk != kc + 1) {\n      return false;\n    }\n    let c: usize = 0;\n    while (c < kk) {\n      if (nodes[id].kids[c] >= nodes.length) {\n        return false;\n      }\n      ids.push(nodes[id].kids[c]);\n      if (c == 0) {\n        loFlags.push(hasLo);\n        los.push(lo);\n      } else {\n        loFlags.push(true);\n        los.push(nodes[id].keys[c - 1]);\n      }\n      if (c == kc) {\n        hiFlags.push(hasHi);\n        his.push(hi);\n      } else {\n        hiFlags.push(true);\n        his.push(nodes[id].keys[c]);\n      }\n      c += 1;\n    }\n  }\n  return true;\n}\n\n// The number of keys stored in the tree below `root` (iterative; a revisit or bad id stops the walk early).\nexport function btreeIntKeyCount<V>(nodes: IntNode<V>[], root: usize): usize {\n  if (root >= nodes.length) {\n    return 0;\n  }\n  let ids: usize[] = [root];\n  let total: usize = 0;\n  let visited: usize = 0;\n  while (ids.length > 0) {\n    visited += 1;\n    if (visited > nodes.length) {\n      return total;\n    }\n    const id = ids.pop().unwrap();\n    total += nodes[id].keys.length;\n    let c: usize = 0;\n    while (c < nodes[id].kids.length) {\n      if (nodes[id].kids[c] < nodes.length) {\n        ids.push(nodes[id].kids[c]);\n      }\n      c += 1;\n    }\n  }\n  return total;\n}\n\n// Height of the tree: the number of levels (1 for a single leaf root). Follows the first child down. O(height).\nexport function btreeIntHeight<V>(nodes: IntNode<V>[], root: usize): usize {\n  let h: usize = 1;\n  let id = root;\n  while (id < nodes.length && nodes[id].kids.length > 0 && h <= nodes.length) {\n    id = nodes[id].kids[0];\n    h += 1;\n  }\n  return h;\n}\n\n// The fewest keys a tree of minimum degree t and the given height can hold: the root has 1 key, every other node\n// at least t-1, so level d >= 1 has >= 2 t^(d-1) nodes and the total is 2 t^(h-1) - 1 (height 1: 1 key, but the\n// root leaf may also be empty, so 0 is returned for an empty tree by the caller). This is why height is O(log_t n).\n@Requires(t >= 2 && h >= 1)\nexport function btreeMinKeysInt(h: usize, t: usize): usize {\n  let p: usize = 1;\n  let d: usize = 1;\n  while (d < h) {\n    p *= t;\n    d += 1;\n  }\n  return 2 * p - 1;\n}\n\n// All keys in order, by an explicit-stack in-order walk (the stack holds a node id and how many of its children\n// were visited). O(n).\nexport function btreeIntKeys<V>(nodes: IntNode<V>[], root: usize): int[] {\n  let out: int[] = [];\n  let ids: usize[] = [root];\n  let js: usize[] = [0];\n  while (ids.length > 0) {\n    const top = ids.length - 1;\n    const id = ids[top];\n    const j = js[top];\n    const kc = nodes[id].keys.length;\n    if (nodes[id].kids.length == 0) {\n      let a: usize = 0;\n      while (a < kc) {\n        out.push(nodes[id].keys[a]);\n        a += 1;\n      }\n      ids.pop();\n      js.pop();\n    } else {\n      if (j > 0 && j - 1 < kc) {\n        out.push(nodes[id].keys[j - 1]);\n      }\n      if (j <= kc) {\n        js[top] = j + 1;\n        ids.push(nodes[id].kids[j]);\n        js.push(0);\n      } else {\n        ids.pop();\n        js.pop();\n      }\n    }\n  }\n  return out;\n}\n\n// All values in key order (same walk as `btreeIntKeys`). O(n).\nexport function btreeIntVals<V>(nodes: IntNode<V>[], root: usize): V[] {\n  let out: V[] = [];\n  let ids: usize[] = [root];\n  let js: usize[] = [0];\n  while (ids.length > 0) {\n    const top = ids.length - 1;\n    const id = ids[top];\n    const j = js[top];\n    const kc = nodes[id].keys.length;\n    if (nodes[id].kids.length == 0) {\n      let a: usize = 0;\n      while (a < kc) {\n        out.push(nodes[id].vals[a]);\n        a += 1;\n      }\n      ids.pop();\n      js.pop();\n    } else {\n      if (j > 0 && j - 1 < kc) {\n        out.push(nodes[id].vals[j - 1]);\n      }\n      if (j <= kc) {\n        js[top] = j + 1;\n        ids.push(nodes[id].kids[j]);\n        js.push(0);\n      } else {\n        ids.pop();\n        js.pop();\n      }\n    }\n  }\n  return out;\n}\n\n// An ordered map from int keys to values of type V: a B-tree of minimum degree t (every node but the root holds\n// t-1 .. 2t-1 keys, all leaves at the same depth) whose nodes live in an arena (`nodes`) and refer to each other\n// by index, so the structure is a plain value (copy-on-write arrays, no pointers, no parent links). `free` lists\n// the arena slots of merged-away nodes for reuse. Insertion splits full nodes on the way down and deletion makes\n// every node it enters hold at least t keys (borrow from a sibling or merge), so both run in one root-to-leaf pass.\n//\n// Invariants (`@Invariant`, checked after every public method by `orin test` / `--check-contracts`): the arena is a\n// valid B-tree of degree t (shape, occupancy, equal leaf depth, no dangling or shared ids, consistent free list),\n// keys are ordered (sorted within nodes and bounded by the separators above them) and the stored count equals the\n// number of keys. Complexity: has/get/put/remove/floorKey/ceilKey/firstKey/lastKey/popFirst/popLast O(t log_t n)\n// (a binary search of O(log t) in each of O(log_t n) nodes, plus O(t) to shift keys inside one node per level on\n// updates); size/isEmpty O(1); keyArray/valueArray O(n); `height()` <= 1 + log_t((n+1)/2). Use t = 16 unless you\n// have measured otherwise; `minDegree` 2 gives the smallest nodes and deepest trees (useful for tests).\n@Invariant(this.t >= 2)\n@Invariant(btreeIntShapeOk(this.nodes, this.root, this.t, this.free))\n@Invariant(btreeIntOrderOk(this.nodes, this.root))\n@Invariant(btreeIntKeyCount(this.nodes, this.root) == this.count)\nexport class SortedMap<V> {\n  private t: usize;\n  private nodes: IntNode<V>[] = [IntNode<V> { keys: [], vals: [], kids: [] }];\n  private root: usize = 0;\n  private free: usize[] = [];\n  private count: usize = 0;\n\n  // new SortedMap<V>(minDegree): an empty map; every node but the root keeps minDegree-1 .. 2*minDegree-1 keys.\n  @Requires(minDegree >= 2)\n  constructor(minDegree: usize) {\n    this.t = minDegree;\n  }\n\n  // size(): number of entries. O(1).\n  @Ensures(result == this.count)\n  size(): usize {\n    return this.count;\n  }\n\n  // isEmpty(): no entries. O(1).\n  @Ensures(result == (this.size() == 0))\n  isEmpty(): bool {\n    return this.count == 0;\n  }\n\n  // height(): number of levels of the tree (1 for the root leaf). It is logarithmic: a tree with this many levels\n  // holds at least 2 t^(h-1) - 1 keys, so n keys need at most about log_t(n/2) + 1 levels. O(height).\n  @Ensures(result >= 1)\n  @Ensures(this.count > 0 ==> btreeMinKeysInt(result, this.t) <= this.count)\n  height(): usize {\n    return btreeIntHeight(this.nodes, this.root);\n  }\n\n  // has(k): is there an entry for k? O(t log_t n).\n  @Ensures(result ==> this.size() > 0)\n  has(k: int): bool {\n    let x = this.root;\n    while (true) {\n      const i = lowerBoundInt(this.nodes[x].keys, k);\n      if (i < this.nodes[x].keys.length && (this.nodes[x].keys[i] == k)) {\n        return true;\n      }\n      if (this.nodes[x].kids.length == 0) {\n        return false;\n      }\n      x = this.nodes[x].kids[i];\n    }\n    return false;\n  }\n\n  // get(k): the value for k, None when absent. O(t log_t n).\n  @Ensures(result.isSome() == this.has(k))\n  get(k: int): Option<V> {\n    let x = this.root;\n    while (true) {\n      const i = lowerBoundInt(this.nodes[x].keys, k);\n      if (i < this.nodes[x].keys.length && (this.nodes[x].keys[i] == k)) {\n        return Some(this.nodes[x].vals[i]);\n      }\n      if (this.nodes[x].kids.length == 0) {\n        return None;\n      }\n      x = this.nodes[x].kids[i];\n    }\n    return None;\n  }\n\n  // A fresh arena slot (reusing a freed one) holding the given node contents.\n  private alloc(keys: int[], vals: V[], kids: usize[]): usize {\n    if (this.free.length > 0) {\n      const id = this.free.pop().unwrap();\n      this.nodes[id] = IntNode<V> { keys: keys, vals: vals, kids: