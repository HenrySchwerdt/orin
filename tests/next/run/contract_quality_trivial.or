// warns: W0452 W0452 W0452 W0452 W0452 W0452 W0452 W0452
// W0452 (ADR-0028): a contract expression that is syntactically trivially true. Every use below warns;
// the negatives (non-trivial clauses) are in contract_quality_clean.or.
import { exit } from "std:process";

@Requires(x == x)
function reflexive(x: int): int {
  return x;
}

@Requires(x <= x)
@Requires(x >= x)
function reflexive2(x: int): int {
  return x;
}

@Requires(a.length >= 0)
function arrayLength(a: int[]): int {
  return 1;
}

@Requires(s.length >= 0 && s.length < 100)
function stringLength(s: string): int {
  return 1;
}

@Requires(m.size >= 0)
function mapSize(m: Map<string, int>): int {
  return 1;
}

@Ensures(result > 0 ==> true)
function impliesTrue(x: int): int {
  return 1;
}

function loopy(n: int): int {
  let i = 0;
  @Invariant(true && i >= 0)
  while (i < n) {
    i += 1;
  }
  return i;
}

function main(): void {
  console.log((reflexive(1) + reflexive2(2) + arrayLength([1]) + stringLength("a") + impliesTrue(1) + loopy(2)).toString());
  exit(0);
}
