import { Graph, GraphId } from "std:graph";

// A cyclic structure (ring of 5 nodes) built from checked ids, walked without owning cycles.
function main(): void {
  let g = new Graph<int>(11);
  let ids: GraphId<int>[] = [];
  let i: usize = 0;
  while (i < 5) {
    ids.push(g.add(i.toInt() * i.toInt()));
    i += 1;
  }
  i = 0;
  while (i < 5) {
    g.addEdge(ids[i], ids[(i + 1) % 5]).unwrap();
    i += 1;
  }
  let cur = ids[0];
  let trail: string[] = [];
  let steps = 0;
  while (steps < 7) {
    trail.push(g.get(cur).unwrap().toString());
    cur = g.neighbors(cur).unwrap()[0];
    steps += 1;
  }
  console.log(trail.join(" -> "));
}
