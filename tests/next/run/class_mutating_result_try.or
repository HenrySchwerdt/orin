// `?` inside a mutating method that returns a Result: the early `Err` return carries the receiver
// (with the changes made before the `?`), like every other return of a mutating method (ADR-0009).
class Wallet {
  coins: int;
  log: string[] = [];
  constructor(coins: int) {
    this.coins = coins;
  }
  validate(n: int): Result<int, string> {
    if (n <= 0) {
      return Err("bad amount");
    }
    return Ok(n);
  }
  spend(n: int): Result<int, string> {
    this.log.push("try " + n.toString());
    const amount = this.validate(n)?;
    if (amount > this.coins) {
      return Err("insufficient");
    }
    this.coins -= amount;
    return Ok(this.coins);
  }
  spendAll(xs: int[]): Result<void, string> {
    for (const x of xs) {
      this.spend(x)?;
    }
    return Ok();
  }
}

function main(): void {
  let w = new Wallet(10);
  console.log(match (w.spend(3)) { Ok(n) => "left " + n.toString(), Err(e) => e });
  console.log(match (w.spend(0)) { Ok(n) => "left " + n.toString(), Err(e) => e });
  console.log(match (w.spend(50)) { Ok(n) => "left " + n.toString(), Err(e) => e });
  console.log(w.coins.toString() + " " + w.log.join(","));
  console.log(match (w.spendAll([2, 2, 0, 2])) { Ok => "all", Err(e) => e });
  console.log(w.coins.toString() + " " + w.log.length.toString());
}
