// Several type parameters, methods returning other instantiations, static methods, defaults for the
// inference of each parameter from the constructor.
class Pair<A, B> {
  first: A;
  second: B;
  constructor(first: A, second: B) {
    this.first = first;
    this.second = second;
  }
  swapped(): Pair<B, A> {
    return new Pair(this.second, this.first);
  }
  withFirst(a: A): Pair<A, B> {
    return new Pair(a, this.second);
  }
  mapSecond(f: (b: B) => B): Pair<A, B> {
    return new Pair(this.first, f(this.second));
  }
  static origin(): Pair<int, int> {
    return new Pair<int, int>(0, 0);
  }
  static make(n: int): Pair<int, string> {
    return new Pair(n, n.toString());
  }
}

class Triple<A, B, C> {
  a: A;
  b: B;
  c: C;
  constructor(a: A, b: B, c: C) {
    this.a = a;
    this.b = b;
    this.c = c;
  }
  rotate(): Triple<B, C, A> {
    return new Triple(this.b, this.c, this.a);
  }
  last(): C {
    return this.c;
  }
}

// a type parameter that no constructor argument mentions: given explicitly or by the expected type
class Tagged<Tag, V> {
  value: V;
  constructor(value: V) {
    this.value = value;
  }
  get(): V {
    return this.value;
  }
}

class Meters {
  n: int;
  constructor(n: int) {
    this.n = n;
  }
}

class Feet {
  n: int;
  constructor(n: int) {
    this.n = n;
  }
}

function lengthOf(m: Tagged<Meters, int>): int {
  return m.get();
}

function main(): void {
  const p = new Pair(1, "one");
  const q = p.swapped();
  console.log(q.first + " " + q.second.toString());
  const r = p.withFirst(2).mapSecond(s => s + "!");
  console.log(r.first.toString() + r.second);
  console.log(Pair.origin().first.toString() + Pair.make(7).second);
  const t = new Triple(1, "b", true);
  const u = t.rotate().rotate();
  console.log(u.a.toString() + " " + u.b.toString() + " " + u.c);
  console.log(t.last().toString());
  const m: Tagged<Meters, int> = new Tagged(5);
  const f = new Tagged<Feet, int>(5);
  console.log(lengthOf(m).toString() + " " + f.get().toString());
  console.log(lengthOf(new Tagged(9)).toString());
  const nested = new Pair(new Pair(1, 2), new Pair("a", new Triple(1, 2, 3)));
  console.log(nested.second.second.last().toString() + nested.first.swapped().first.toString());
}
