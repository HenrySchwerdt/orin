// Command line of the protocol harness: `orin-protocol lsp|mcp [--orin PATH] [--orin2 PATH] [--root DIR]`.
// `--orin` and `--orin2` are the flags of tools/test_lsp.py and tools/test_mcp.py (the compiler binary to test, or
// the bootstrapped compiler that builds it); `--root` is the repository root (the Python scripts derive it from the
// location of the script). `--opt=value` is accepted. Errors exit with status 2 and print `usage` and `error:` to
// stderr, like argparse. Pure functions: tests/cli_test.or.

export type Options = {
  suite: string;     // lsp | mcp
  orin: string;      // "": build one with orin2
  orin2: string;
  root: string;
  help: bool;
};

export type Parsed = { ok: bool; options: Options; error: string; };

export function defaultOptions(): Options {
  return Options { suite: "", orin: "", orin2: "build/bootstrap/orin2", root: ".", help: false };
}

export function usage(): string {
  return "usage: orin-protocol [-h] [--orin2 ORIN2] [--orin ORIN] [--root ROOT] {lsp,mcp}";
}

export function helpText(): string {
  return usage() + "\n\n"
  + "End-to-end tests of `orin lsp` and `orin mcp` over stdio (the Orin port of tools/test_lsp.py and tools/test_mcp.py)\n\n"
  + "positional arguments:\n"
  + "  {lsp,mcp}      the protocol to test\n\n"
  + "options:\n"
  + "  -h, --help     show this help message and exit\n"
  + "  --orin2 ORIN2  bootstrapped compiler that builds the compiler under test (default: build/bootstrap/orin2)\n"
  + "  --orin ORIN    use this orin binary instead of building one\n"
  + "  --root ROOT    repository root holding compiler/ and runtime/ (default: the current directory)";
}

function fail(msg: string): Parsed {
  return Parsed { ok: false, options: defaultOptions(), error: msg };
}

function isValueOption(a: string): bool {
  return a == "--orin" || a == "--orin2" || a == "--root";
}

function apply(o: Options, name: string, value: string): Options {
  if (name == "--orin") {
    return Options { ...o, orin: value };
  }
  if (name == "--orin2") {
    return Options { ...o, orin2: value };
  }
  return Options { ...o, root: value };
}

export function parseArgs(argv: string[]): Parsed {
  let o = defaultOptions();
  let i: usize = 0;
  while (i < argv.length) {
    const a = argv[i];
    if (a == "-h" || a == "--help") {
      return Parsed { ok: true, options: Options { ...o, help: true }, error: "" };
    }
    const eqAt = a.indexOf("=");
    if (a.startsWith("--") && eqAt.isSome()) {
      const name = a.substring(0, eqAt.unwrap());
      if (!isValueOption(name)) {
        return fail("unrecognized arguments: " + a);
      }
      o = apply(o, name, a.substring(eqAt.unwrap() + 1, a.length));
    } else if (isValueOption(a)) {
      if (i + 1 >= argv.length || argv[i + 1].startsWith("-")) {
        return fail("argument " + a + ": expected one argument");
      }
      o = apply(o, a, argv[i + 1]);
      i += 1;
    } else if (a == "lsp" || a == "mcp") {
      if (o.suite != "") {
        return fail("unrecognized arguments: " + a);
      }
      o = Options { ...o, suite: a };
    } else if (a.startsWith("-")) {
      return fail("unrecognized arguments: " + a);
    } else {
      return fail("argument suite: invalid choice: '" + a + "' (choose from 'lsp', 'mcp')");
    }
    i += 1;
  }
  if (o.suite == "") {
    return fail("the following arguments are required: suite");
  }
  return Parsed { ok: true, options: o, error: "" };
}
