// Comment placement for the formatter.
//
// Printing functions return plain strings (multi-line, absolutely indented). Comments are
// re-inserted by *source position*: `Layout.seq` lays out a list of elements (statements, items,
// arguments, ...) and places the comments found in the gaps between them (leading comments on
// their own lines, a same-line comment as trailing). Every comment emitted carries an invisible
// marker (\x01 index \x02) so that enclosing constructs can tell which comments were already
// placed; unplaced ("stray") comments inside an element are hoisted above it. Markers are
// stripped at the very end (`stripMarkers`).
//
// `Layout` is the source text with its comments in source order: the queue the printer consumes. Its invariant
// (`commentsOrdered`) is what the binary search `firstAtOrAfter` relies on. The printer has no output buffer on purpose:
// it renders an element, measures it against the line width and renders it again broken over lines when it does not
// fit, so its results are values (strings), not appends to a shared buffer. The comment rule is a contract: `seq`
// places every comment of its range (`allPlaced`), and `format` (format.or) keeps the multiset of comment texts.

import { Comment } from "../syntax";
import { pad } from "./text";
import { hasUsize } from "../util";

// Comments sorted by position, not overlapping, inside the text.
export function commentsOrdered(cs: Comment[], n: usize): bool {
  let prev: usize = 0;
  for (const c of cs) {
    if (c.start < prev || c.end < c.start || c.end > n) {
      return false;
    }
    prev = c.end;
  }
  return true;
}

// The placement marker of comment `k`.
function marker(k: usize): string {
  return "\x01" + k.toString() + "\x02";
}

// Every comment whose start lies in [lo, hi) is placed in `text` (its marker occurs there).
export function allPlaced(cs: Comment[], lo: usize, hi: usize, text: string): bool {
  let k = firstAtOrAfter(cs, lo);
  while (k < cs.length && cs[k].start < hi) {
    if (!text.includes(marker(k))) {
      return false;
    }
    k += 1;
  }
  return true;
}

// Index of the first comment whose start is >= pos.
export function firstAtOrAfter(cs: Comment[], pos: usize): usize {
  let lo: usize = 0;
  let hi = cs.length;
  while (lo < hi) {
    const mid = lo + (hi - lo) / 2;
    if (cs[mid].start < pos) {
      lo = mid + 1;
    } else {
      hi = mid;
    }
  }
  return lo;
}

// True if src[a, b) holds a blank line (two newlines with only whitespace between them).
export function blankIn(src: string, a: usize, b: usize): bool {
  let nl: int = 0;
  let i = a;
  while (i < b && i < src.length) {
    const ch = src.charCodeAt(i);
    if (ch == 10) {
      nl += 1;
      if (nl >= 2) {
        return true;
      }
    } else if (ch != 32 && ch != 9 && ch != 13) {
      nl = 0;
    }
    i += 1;
  }
  return false;
}

export function hasNewline(src: string, a: usize, b: usize): bool {
  let i = a;
  while (i < b && i < src.length) {
    if (src.charCodeAt(i) == 10) {
      return true;
    }
    i += 1;
  }
  return false;
}

function commentLine(i: usize, cm: Comment): string {
  return "\x01" + i.toString() + "\x02" + cm.text;
}

// Remove the placement markers.
export function stripMarkers(s: string): string {
  if (!s.includes("\x01")) {
    return s;
  }
  const parts = s.split("\x01");
  let out: string[] = [parts[0]];
  let i: usize = 1;
  while (i < parts.length) {
    const pt = parts[i];
    match (pt.indexOf("\x02")) {
      Some(k) => {
        out.push(pt.substring(k + 1, pt.length));
      },
      None => {
        out.push(pt);
      },
    }
    i += 1;
  }
  return out.join("");
}

function markedIndices(text: string): usize[] {
  let r: usize[] = [];
  if (!text.includes("\x01")) {
    return r;
  }
  const parts = text.split("\x01");
  let i: usize = 1;
  while (i < parts.length) {
    const pt = parts[i];
    match (pt.indexOf("\x02")) {
      Some(k) => {
        match (parseInt(pt.substring(0, k))) {
          Some(v) => {
            r.push(v.toUsize());
          },
          None => {},
        }
      },
      None => {},
    }
    i += 1;
  }
  return r;
}

// The source text being formatted and its comments in source order (the comment queue of the printer).
@Invariant(commentsOrdered(this.cs, this.src.length))
export class Layout {
  src: string;
  cs: Comment[];

  constructor(src: string, cs: Comment[]) {
    this.src = src;
    this.cs = cs;
  }

  // True if a comment starts in [lo, hi).
  hasCommentIn(lo: usize, hi: usize): bool {
    const i = firstAtOrAfter(this.cs, lo);
    return i < this.cs.length && this.cs[i].start < hi;
  }

  // Position of the first `ch` at or after `from` that is not inside a comment.
  @Ensures(result == this.src.length || result >= begin && this.src.charCodeAt(result) == ch)
  findChar(begin: usize, ch: int): usize {
    const n = this.src.length;
    let i = begin;
    let ci = firstAtOrAfter(this.cs, begin);
    while (i < n) {
      if (ci < this.cs.length && this.cs[ci].start == i) {
        i = this.cs[ci].end;
        ci += 1;
      } else if (this.src.charCodeAt(i) == ch) {
        return i;
      } else {
        i += 1;
      }
    }
    return n;
  }

  // Comments inside [s, e) that the rendered `text` of that element did not place.
  private strays(s: usize, e: usize, text: string): usize[] {
    let r: usize[] = [];
    let k = firstAtOrAfter(this.cs, s);
    if (k >= this.cs.length || this.cs[k].start >= e) {
      return r;
    }
    const claimed = markedIndices(text);
    while (k < this.cs.length && this.cs[k].start < e) {
      if (!hasUsize(claimed, k)) {
        r.push(k);
      }
      k += 1;
    }
    return r;
  }

  // True if a comment lies in a gap between elements (or before the first / after the last
  // element) of a list spanning [lo, hi).
  gapsHave(starts: usize[], ends: usize[], lo: usize, hi: usize): bool {
    let prev = lo;
    let i: usize = 0;
    while (i < starts.length) {
      if (this.hasCommentIn(prev, starts[i])) {
        return true;
      }
      prev = ends[i];
      i += 1;
    }
    return this.hasCommentIn(prev, hi);
  }

  // Lay out elements one per line at indent `ind`, each followed by `sep`, with the comments of the
  // gaps (between `lo` and the first element, between elements, and up to `hi`) placed around them.
  // A comment on the same source line after an element becomes its trailing comment. A single blank
  // source line between elements (or comments) is preserved. Returns "" if there is nothing.
  @Requires(starts.length == ends.length && ends.length == texts.length)
  @Ensures(allPlaced(this.cs, lo, hi, result))
  seq(
    starts: usize[],
    ends: usize[],
    texts: string[],
    lo: usize,
    hi: usize,
    ind: usize,
    sep: string,
  ): string {
    const p = pad(ind);
    const cs = this.cs;
    const n = texts.length;
    let out: string[] = [];
    let prev = lo;
    let first = true;
    let i: usize = 0;
    while (i < n) {
      const s = starts[i];
      const e = ends[i];
      let limit = hi;
      if (i + 1 < n) {
        limit = starts[i + 1];
      }
      let ci = firstAtOrAfter(cs, prev);
      let q = prev;
      while (ci < cs.length && cs[ci].start < s) {
        if (!first && blankIn(this.src, q, cs[ci].start)) {
          out.push("");
        }
        out.push(p + commentLine(ci, cs[ci]));
        q = cs[ci].end;
        first = false;
        ci += 1;
      }
      const st = this.strays(s, e, texts[i]);
      for (const k of st) {
        out.push(p + commentLine(k, cs[k]));
        first = false;
      }
      if (st.length == 0 && !first && blankIn(this.src, q, s)) {
        out.push("");
      }
      let line = p + texts[i] + sep;
      prev = e;
      const ti = firstAtOrAfter(cs, e);
      if (ti < cs.length && cs[ti].start < limit && !hasNewline(this.src, e, cs[ti].start)) {
        line += " " + commentLine(ti, cs[ti]);
        prev = cs[ti].end;
      }
      out.push(line);
      first = false;
      i += 1;
    }
    let ci = firstAtOrAfter(cs, prev);
    let q = prev;
    while (ci < cs.length && cs[ci].start < hi) {
      if (!first && blankIn(this.src, q, cs[ci].start)) {
        out.push("");
      }
      out.push(p + commentLine(ci, cs[ci]));
      q = cs[ci].end;
      first = false;
      ci += 1;
    }
    return out.join("\n");
  }

  // `open` + one element per line (indent ind + 2) + `close`; `lo` is the position just after the
  // opening token, `hi` the position of the closing token. A comment on the opening line stays
  // there. With nothing inside, `open` + `close` directly.
  @Requires(starts.length == ends.length && ends.length == texts.length)
  @Ensures(allPlaced(this.cs, lo, hi, result))
  @Ensures(result.startsWith(open) && result.endsWith(close))
  bracketed(
    open: string,
    close: string,
    lo: usize,
    hi: usize,
    starts: usize[],
    ends: usize[],
    texts: string[],
    ind: usize,
    sep: string,
  ): string {
    let head = open;
    let begin = lo;
    const k = firstAtOrAfter(this.cs, lo);
    let limit = hi;
    if (starts.length > 0) {
      limit = starts[0];
    }
    if (k < this.cs.length
        && this.cs[k].start < limit
        && !hasNewline(this.src, lo, this.cs[k].start)) {
      head += " " + commentLine(k, this.cs[k]);
      begin = this.cs[k].end;
    }
    const body = this.seq(starts, ends, texts, begin, hi, ind + 2, sep);
    if (body == "") {
      if (begin == lo) {
        return open + close;
      }
      return head + "\n" + pad(ind) + close;
    }
    return head + "\n" + body + "\n" + pad(ind) + close;
  }
}
