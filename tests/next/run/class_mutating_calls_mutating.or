// A method that calls a mutating method on `this` is itself mutating (inferred by fixpoint over the class).
class Tally {
  constructor(public n: int, public calls: int) {}
  bump(): void {
    this.n += 1;
    this.calls += 1;
  }
  bumpTwice(): void {
    this.bump();
    this.bump();
  }
  bumpMany(k: int): void {
    let i = 0;
    while (i < k) {
      this.bumpTwice();
      i += 1;
    }
  }
  peek(): int {
    return this.n;
  }
}

function main(): void {
  let t = new Tally(0, 0);
  t.bumpMany(3);
  console.log(t.n.toString() + " " + t.calls.toString());
  const snapshot = t;
  t.bumpTwice();
  console.log(snapshot.peek().toString() + " " + t.peek().toString());
}
