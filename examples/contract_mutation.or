// Demo for the contract-strength tool (ADR-0028):
//
//   python3 tools/contract_mutation.py examples/contract_mutation.or
//
// The tool mutates the function bodies (operators, literals, dropped statements), builds each mutant with
// runtime contract checking, runs the @Test functions and reports per function how many mutants were killed
// (by a contract or by a test) and which survived. Here `clamp` and `Counter` have strong contracts, `weakAbs`
// has a weak one and `unchecked` has none: the survivors point at what the specification does not say.
import { assertEq } from "std:test";

@Requires(lo <= hi)
@Ensures(result >= lo && result <= hi)
@Ensures(x >= lo && x <= hi ==> result == x)
function clamp(x: int, lo: int, hi: int): int {
  if (x < lo) {
    return lo;
  }
  if (x > hi) {
    return hi;
  }
  return x;
}

// Weak: `result >= 0` does not say the result is `|x|`; wrong results like 0 pass.
@Ensures(result >= 0)
function weakAbs(x: int): int {
  if (x < 0) {
    return 0 - x;
  }
  return x;
}

function unchecked(a: int, b: int): int {
  return a * 2 + b;
}

@Invariant(this.n >= 0)
class Counter {
  n: int;

  constructor() {
    this.n = 0;
  }

  @Ensures(this.n == old(this.n) + 1)
  bump(): void {
    this.n += 1;
  }

  @Ensures(this.n == 0)
  reset(): void {
    this.n = 0;
  }
}

@Test
function clampWorks(): void {
  assertEq(clamp(5, 0, 10), 5, "inside");
  assertEq(clamp(-3, 0, 10), 0, "below");
  assertEq(clamp(42, 0, 10), 10, "above");
}

@Test
function weakAbsIsNonNegative(): void {
  assertEq(weakAbs(-4) >= 0 ? 1 : 0, 1, "negative input");
  assertEq(weakAbs(4) >= 0 ? 1 : 0, 1, "positive input");
}

@Test
function counterCounts(): void {
  let c = new Counter();
  c.bump();
  c.bump();
  c.reset();
  c.bump();
  assertEq(unchecked(1, 2) > 0 ? 1 : 0, 1, "positive");
}

function main(): void {
  console.log(clamp(15, 0, 10).toString());
}
