// Array API prelude (spec 08, ADR-0011): the non-mutating array methods, written in Orin.
//
// This file is a prelude root (`$array`, spec 19 R1 mechanism: compiler/loader/prelude.or; embedded by
// tools/embed_prelude.py) loaded with every program as unit `$array/array`. Its names are not in scope
// of user code (nothing imports them): the
// checker rewrites `xs.map(f)` to a call of the generic function `map` below with the receiver as
// first argument. Generic functions are checked once abstractly and instantiated per use, so a
// program that never calls an array method pays nothing but the (small) abstract check.
//
// Every function returns a new value; none mutates its arguments (value semantics, spec 03).

// Array methods (user code writes `xs.map(f)`; this file is the implementation the checker calls). Every function
// returns a new value and never mutates `xs`; none fails or traps unless the callback does.
//
// map(f): U[] -- `f` applied to every element, in order. O(n) calls of `f`; allocates the result.
export function map<T, U>(xs: T[], f: (x: T) => U): U[] {
  let out: U[] = [];
  for (const x of xs) {
    out.push(f(x));
  }
  return out;
}

// filter(pred): T[] -- the elements for which `pred` is true, in order. O(n) calls of `pred`; allocates the result.
export function filter<T>(xs: T[], pred: (x: T) => bool): T[] {
  let out: T[] = [];
  for (const x of xs) {
    if (pred(x)) {
      out.push(x);
    }
  }
  return out;
}

// find(pred): Option<T> -- the first element for which `pred` is true, or None. O(n) calls of `pred`, stops at the first hit.
export function find<T>(xs: T[], pred: (x: T) => bool): Option<T> {
  for (const x of xs) {
    if (pred(x)) {
      return Some(x);
    }
  }
  return None;
}

// findIndex(pred): Option<usize> -- the index of the first element for which `pred` is true, or None. O(n) calls of
// `pred`, stops at the first hit.
export function findIndex<T>(xs: T[], pred: (x: T) => bool): Option<usize> {
  let i: usize = 0;
  for (const x of xs) {
    if (pred(x)) {
      return Some(i);
    }
    i += 1;
  }
  return None;
}

// some(pred): bool -- is `pred` true for at least one element? False for the empty array. O(n) calls of `pred`, stops at
// the first hit.
export function some<T>(xs: T[], pred: (x: T) => bool): bool {
  for (const x of xs) {
    if (pred(x)) {
      return true;
    }
  }
  return false;
}

// every(pred): bool -- is `pred` true for all elements? True for the empty array. O(n) calls of `pred`, stops at the
// first miss.
export function every<T>(xs: T[], pred: (x: T) => bool): bool {
  for (const x of xs) {
    if (!pred(x)) {
      return false;
    }
  }
  return true;
}

// reduce(f, init): U -- folds the elements left to right: `f(f(init, x0), x1)` ... `init` for the empty array. O(n)
// calls of `f`.
export function reduce<T, U>(xs: T[], f: (acc: U, x: T) => U, init: U): U {
  let acc = init;
  for (const x of xs) {
    acc = f(acc, x);
  }
  return acc;
}

// forEach(f): void -- calls `f` on every element, in order. O(n) calls of `f`.
export function forEach<T>(xs: T[], f: (x: T) => void): void {
  for (const x of xs) {
    f(x);
  }
}

// Stable merge sort; `cmp(a, b)` is negative, zero or positive as `a` sorts before, with or after `b`.
export function sort<T>(xs: T[], cmp: (a: T, b: T) => int): T[] {
  const n = xs.length;
  if (n <= 1) {
    return xs;
  }
  const mid = n / 2;
  const left = sort(xs.slice(0, mid), cmp);
  const right = sort(xs.slice(mid, n), cmp);
  let out: T[] = [];
  let i: usize = 0;
  let j: usize = 0;
  while (i < left.length && j < right.length) {
    if (cmp(right[j], left[i]) < 0) {
      out.push(right[j]);
      j += 1;
    } else {
      out.push(left[i]);
      i += 1;
    }
  }
  while (i < left.length) {
    out.push(left[i]);
    i += 1;
  }
  while (j < right.length) {
    out.push(right[j]);
    j += 1;
  }
  return out;
}

// `indexOf` / `includes` need `==`, which a generic body cannot use, so they exist once per
// element type that has equality; the checker picks the function from the receiver's element type.
// indexOf(v): Option<usize> -- the index of the first element equal to `v`, or None. The checker picks the function
// of the element class: `indexOfInt` (every integer type held in an `int`), `indexOfUsize` (u64 and usize), `indexOfBool`,
// `indexOfString`. These are implementation hooks, not API. O(n), no allocation.
export function indexOfInt(xs: int[], v: int): Option<usize> {
  let i: usize = 0;
  for (const x of xs) {
    if (x == v) {
      return Some(i);
    }
    i += 1;
  }
  return None;
}

export function indexOfUsize(xs: usize[], v: usize): Option<usize> {
  let i: usize = 0;
  for (const x of xs) {
    if (x == v) {
      return Some(i);
    }
    i += 1;
  }
  return None;
}

export function indexOfBool(xs: bool[], v: bool): Option<usize> {
  let i: usize = 0;
  for (const x of xs) {
    if (x == v) {
      return Some(i);
    }
    i += 1;
  }
  return None;
}

export function indexOfString(xs: string[], v: string): Option<usize> {
  let i: usize = 0;
  for (const x of xs) {
    if (x == v) {
      return Some(i);
    }
    i += 1;
  }
  return None;
}

// includes(v): bool -- is some element equal to `v`? One function per element class like `indexOf` above
// (`includesInt`, `includesUsize`, `includesBool`, `includesString`). Implementation hooks, not API. O(n), no allocation.
export function includesInt(xs: int[], v: int): bool {
  return indexOfInt(xs, v).isSome();
}

export function includesUsize(xs: usize[], v: usize): bool {
  return indexOfUsize(xs, v).isSome();
}

export function includesBool(xs: bool[], v: bool): bool {
  return indexOfBool(xs, v).isSome();
}

export function includesString(xs: string[], v: string): bool {
  return indexOfString(xs, v).isSome();
}
