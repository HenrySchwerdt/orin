// Unit `b` of the qualified-names fixture (main.or): the same names as unit `a`, a different meaning.
export type Scope = { names: string[]; };

@Requires(x >= 0 && x < 1000)
@Ensures(result == x * 2)
export function mk(x: int): int {
  return x * 2;
}

@Ensures(result == s.names.length)
export function count(s: Scope): usize {
  return s.names.length;
}
