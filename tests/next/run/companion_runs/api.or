import { Http, Name, Doc, Get, Post } from "./web";

const ROOT: string = "/root";

/** Lists the users. */
@Http(Get, "/users", ["a", "b"])
export function listUsers(): string[] {
  return ["ann", "bob"];
}

@Http(Post, ROOT, [], 25)
@Doc("creates an order")
export function createOrder(id: int): int {
  return id + 1;
}

export type Profile = { id: int; @Name("display_name") name: string; @Name("mail") email: Option<string>; };

export class Service {
  hits: int = 0;

  @Http(Get, "/hits", ["svc"], Some(3))
  count(): int {
    return this.hits;
  }
}

export function internalOnly(): int {
  return 1;
}
