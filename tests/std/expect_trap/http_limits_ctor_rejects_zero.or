// `orin test` must report this test as FAILED (a trap): Limits validates its parameters in every build (a parser
// with a zero header-line limit could never make progress).
import { Limits } from "std:http";

@Test
function constructorTrapsOnZeroLimits(): void {
  const l = new Limits(0, 0, 0, 0, 0, 0);
  l.maxBody();
}
