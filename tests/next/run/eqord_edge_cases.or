type List<T> = Nil | Cons(T, List<T>);
type Unit = {};
type Mode = A | B | C;

class Tagged<T extends Eq> {
  tag: string;
  value: T;
  constructor(tag: string, value: T) {
    this.tag = tag;
    this.value = value;
  }
  equals(other: Tagged<T>): bool {
    return this.tag == other.tag && this.value == other.value;
  }
  hash(): usize {
    return this.tag.length;
  }
}

function len<T>(l: List<T>): int {
  return match (l) {
    Nil => 0,
    Cons(_, rest) => 1 + len(rest),
  };
}

function main(): void {
  const l1 = Cons(1, Cons(2, Nil));
  const l2 = Cons(1, Cons(2, Nil));
  const l3 = Cons(1, Cons(3, Nil));
  console.log((l1 == l2).toString());
  console.log((l1 == l3).toString());
  console.log((l1 < l3).toString());
  console.log(len(l1).toString());
  console.log((Unit {} == Unit {}).toString());
  console.log(Unit {}.compare(Unit {}).toString());
  const r1: Result<void, string> = Ok();
  const r2: Result<void, string> = Err("x");
  console.log((r1 == r2).toString());
  console.log((r1 < r2).toString());
  console.log((r1 == r1).toString());
  const e: int[] = [];
  console.log((e == []).toString());
  console.log((e < [1]).toString());
  console.log((A < B && B < C && !(C < A)).toString());
  const big1: u64 = 18446744073709551615;
  const big2: u64 = 5;
  console.log((big1 > big2).toString());
  console.log(big1.compare(big2).toString());
  console.log((big1.hash() == big1.hash()).toString());
  const neg: i64 = -3;
  console.log(neg.compare(2).toString());
  const t1 = new Tagged<int>("a", 1);
  const t2 = new Tagged<int>("a", 1);
  const t3 = new Tagged<int>("a", 2);
  console.log((t1 == t2).toString());
  console.log((t1 == t3).toString());
  let m = new Map<Tagged<int>, string>();
  m.set(t1, "one");
  console.log(m.get(t2).unwrapOr("-"));
  console.log(m.get(t3).unwrapOr("-"));
  const eq = (x: List<int>, y: List<int>): bool => x == y;
  console.log(eq(l1, l2).toString());
  const pairs: (Mode)[] = [C, A, B];
  console.log((pairs == [C, A, B]).toString());
}
