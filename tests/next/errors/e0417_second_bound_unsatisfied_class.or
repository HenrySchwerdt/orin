// error: E0417
// stderr: of class `Registry`: class `Plain` does not declare `implements Named`
interface Named {
  name(): string;
}

class Plain implements Hash {
  constructor(public n: int) {}
  hash(): usize { return this.n.toUsize(); }
  equals(other: Plain): bool { return this.n == other.n; }
}

class Registry<T extends Hash & Named> {
  items: T[] = [];
  add(x: T): void { this.items.push(x); }
}

function main(): void {
  const r = new Registry<Plain>();
  r.add(new Plain(1));
}
