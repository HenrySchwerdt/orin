import { formatIso } from "std:time";

function main(): void {
  console.log(formatIso(0));
  console.log(formatIso(1709211845006));
  console.log(formatIso(951782400000));
  console.log(formatIso(-1));
  console.log(formatIso(-86400000));
  console.log(formatIso(4102444800000));
  console.log(formatIso(253402300799999));
  console.log(formatIso(-62135596800000));
}
