// `orin.toml` manifest (spec 04, ADR-0016): typed view over the TOML subset in toml.or.
//
//   [package]
//   name = "shop"                  # required
//   version = "0.1.0"              # default "0.0.0"
//   entry = "src/main.or"          # default; relative to the package root
//
//   [architecture]
//   acyclic_modules = true         # always enforced; `false` is rejected (E0503)
//   private_by_default = true      # always enforced; `false` is rejected (E0503)
//   explicit_public_api = true     # always enforced; `false` is rejected (E0503)
//
//   [contracts]
//   strict = true                  # default false; enables the strict contract-coverage warnings (ADR-0028)
//
//   [modules.users]                # module = directory relative to the entry file's directory
//   allowed_dependencies = ["database", "logging"]
//
//   [effects]                      # capability policy (ADR-0037 D4, docs/capabilities.md): the primitive effects the code of a
//   allowed = ["Fs.Read"]          # module may perform; this table is the package default, absent = no restriction
//   [effects.loader]               # per module (same naming as [modules.x]); a module without a table gets the default
//   allowed = ["Fs", "Console.Write"]
//
// `[modules.a.b]` and `[modules."a/b"]` both name module `a/b`; `.` names the root module (the
// directory of the entry file). Diagnostics: E0500 syntax, E0503 invalid manifest (the effect names of an `allowed` list are
// checked against the compiler's list by compiler/analysis/effectpolicy.or: E0473, E0474).

import { Span, Diagnostic, diag, span, SourceFile } from "../diag";
import { TomlValue, TomlEntry, TomlTable, TomlDoc, parseToml } from "./toml";

export type ModuleRule = {
  module: string;          // "users", "users/internal", "." (root)
  allowed: string[];
  span: Span;              // the `[modules.x]` header
  allowedSpans: Span[];    // one per entry of `allowed`
};

// `[effects]` (module "") or `[effects.<module>]`: the effects the module's code may perform. `allowed` entries are operation
// names ("Fs.ReadFile"), families ("Fs"), family wildcards ("Fs.*"), "Unknown" (calls whose target is not known) or "*".
export type EffectRule = {
  module: string;          // "" = the package default, else a module id as in ModuleRule
  allowed: string[];
  span: Span;              // the table header
  allowedSpans: Span[];    // one per entry of `allowed`
};

export type Dependency = { name: string; path: string; git: string; tag: string; rev: string; dev: bool; };

export type Manifest = {
  dependencies: Dependency[];
  file: usize;             // file id of the manifest in the diagnostics' SourceMap (set by the loader)
  name: string;
  version: string;
  entry: string;           // relative to the package root
  rules: ModuleRule[];
  strictContracts: bool;   // `[contracts] strict = true` (ADR-0028): strict contract-coverage warnings
  effects: EffectRule[];   // `[effects]` / `[effects.<module>]` (ADR-0037 D4); empty = no restriction
  // The manifest file itself (the loader sets the path): the spans above point into it. A diagnostic about a table that
  // is found after loading (the effect policy, compiler/analysis/effectpolicy.or) is rendered against it.
  source: SourceFile;
};

export const DEFAULT_ENTRY: string = "src/main.or";

function invalid(file: usize, sp: Span, msg: string): Diagnostic {
  return diag("E0503", span(file, sp.start, sp.end), "orin.toml: " + msg);
}

@Requires(e.start <= e.end)
function entrySpan(file: usize, e: TomlEntry): Span {
  return span(file, e.start, e.end);
}

function strOf(file: usize, e: TomlEntry): Result<string, Diagnostic> {
  return match (e.value) {
    TStr(s) => Ok(s),
    _ => Err(invalid(file, entrySpan(file, e), "`" + e.key + "` must be a string"))
  };
}

function boolOf(file: usize, e: TomlEntry): Result<bool, Diagnostic> {
  return match (e.value) {
    TBool(b) => Ok(b),
    _ => Err(invalid(file, entrySpan(file, e), "`" + e.key + "` must be a boolean"))
  };
}

function packageTable(file: usize, t: TomlTable, m: Manifest): Result<Manifest, Diagnostic> {
  let out = m;
  let haveName = false;
  for (const e of t.entries) {
    if (e.key == "name") {
      const r = strOf(file, e);
      if (r.isErr()) {
        return Err(r.unwrapErr());
      }
      if (r.unwrap().length == 0) {
        return Err(invalid(file, entrySpan(file, e), "`name` must not be empty"));
      }
      out = Manifest { ...out, name: r.unwrap() };
      haveName = true;
    } else if (e.key == "version") {
      const r = strOf(file, e);
      if (r.isErr()) {
        return Err(r.unwrapErr());
      }
      out = Manifest { ...out, version: r.unwrap() };
    } else if (e.key == "entry") {
      const r = strOf(file, e);
      if (r.isErr()) {
        return Err(r.unwrapErr());
      }
      if (!r.unwrap().endsWith(".or")) {
        return Err(invalid(file, entrySpan(file, e), "`entry` must be a path to an `.or` file"));
      }
      out = Manifest { ...out, entry: r.unwrap() };
    } else {
      return Err(invalid(file, entrySpan(file, e), "unknown key `" + e.key + "` in [package] (expected name, version, entry)"));
    }
  }
  if (!haveName) {
    return Err(invalid(file, span(file, t.start, t.end), "[package] requires a `name`"));
  }
  return Ok(out);
}

function architectureTable(file: usize, t: TomlTable): Result<bool, Diagnostic> {
  for (const e of t.entries) {
    if (e.key == "acyclic_modules" || e.key == "private_by_default" || e.key == "explicit_public_api") {
      const r = boolOf(file, e);
      if (r.isErr()) {
        return Err(r.unwrapErr());
      }
      if (!r.unwrap()) {
        return Err(invalid(file, entrySpan(file, e), "`" + e.key + " = false` is not allowed: Orin always enforces it"));
      }
    } else {
      return Err(invalid(file, entrySpan(file, e),
        "unknown key `" + e.key + "` in [architecture] (expected acyclic_modules, private_by_default, explicit_public_api)"));
    }
  }
  return Ok(true);
}

function contractsTable(file: usize, t: TomlTable): Result<bool, Diagnostic> {
  let strict = false;
  for (const e of t.entries) {
    if (e.key != "strict") {
      return Err(invalid(file, entrySpan(file, e), "unknown key `" + e.key + "` in [contracts] (expected strict)"));
    }
    const r = boolOf(file, e);
    if (r.isErr()) {
      return Err(r.unwrapErr());
    }
    strict = r.unwrap();
  }
  return Ok(strict);
}

// `[effects]` or `[effects.<module path>]`: one key, `allowed`, an array of strings.
function effectRule(file: usize, t: TomlTable): Result<EffectRule, Diagnostic> {
  const mname = t.path.slice(1, t.path.length).join("/");
  const hs = span(file, t.start, t.end);
  let allowed: string[] = [];
  let spans: Span[] = [];
  for (const e of t.entries) {
    if (e.key != "allowed") {
      return Err(invalid(file, entrySpan(file, e), "unknown key `" + e.key + "` in [" + t.path.join(".") + "] (expected allowed)"));
    }
    match (e.value) {
      TArr(xs) => {
        allowed = xs;
        spans = e.elems;
      },
      _ => {
        return Err(invalid(file, entrySpan(file, e), "`allowed` must be an array of strings"));
      }
    }
  }
  return Ok(EffectRule { module: mname, allowed: allowed, span: hs, allowedSpans: spans });
}

function moduleRule(file: usize, t: TomlTable): Result<ModuleRule, Diagnostic> {
  const mname = t.path.slice(1, t.path.length).join("/");
  const hs = span(file, t.start, t.end);
  let allowed: string[] = [];
  let spans: Span[] = [];
  for (const e of t.entries) {
    if (e.key != "allowed_dependencies") {
      return Err(invalid(file, entrySpan(file, e), "unknown key `" + e.key + "` in [modules." + mname + "] (expected allowed_dependencies)"));
    }
    match (e.value) {
      TArr(xs) => {
        allowed = xs;
        spans = e.elems;
      },
      _ => {
        return Err(invalid(file, entrySpan(file, e), "`allowed_dependencies` must be an array of strings"));
      }
    }
  }
  return Ok(ModuleRule { module: mname, allowed: allowed, span: hs, allowedSpans: spans });
}

// `file` is the file id of the manifest text in the SourceMap used to render the diagnostics.
export function parseManifest(file: usize, text: string): Result<Manifest, Diagnostic> {
  const pr = parseToml(file, text);
  if (pr.isErr()) {
    return Err(pr.unwrapErr());
  }
  const doc = pr.unwrap();
  const noRules: ModuleRule[] = [];
  const noEffects: EffectRule[] = [];
  let m = Manifest {
    dependencies: [], file: file, name: "", version: "0.0.0", entry: DEFAULT_ENTRY, rules: noRules, strictContracts: false, effects: noEffects,
    source: SourceFile { path: "orin.toml", text: text }
  };
  let havePackage = false;
  for (const t of doc.tables) {
    if (t.path.length == 0) {
      if (t.entries.length > 0) {
        const e = t.entries[0];
        return Err(invalid(file, entrySpan(file, e), "key `" + e.key + "` outside any table (expected [package], [architecture] or [modules.<path>])"));
      }
      continue;
    }
    const head = t.path[0];
    if (head == "package" && t.path.length == 1) {
      const r = packageTable(file, t, m);
      if (r.isErr()) {
        return Err(r.unwrapErr());
      }
      m = r.unwrap();
      havePackage = true;
    } else if (head == "dependencies" || head == "dev-dependencies") {
      if (t.path.length != 1) { return Err(invalid(file, span(file, t.start, t.end), "dependencies use inline tables: name = { path = \"...\" }")); }
      for (const e of t.entries) {
        const dep = dependencyEntry(file, e, head == "dev-dependencies")?;
        for (const prior of m.dependencies) { if (prior.name == dep.name) { return Err(invalid(file, entrySpan(file, e), "duplicate dependency `" + dep.name + "`")); } }
        m.dependencies.push(dep);
      }
    } else if (head == "architecture" && t.path.length == 1) {
      const r = architectureTable(file, t);
      if (r.isErr()) {
        return Err(r.unwrapErr());
      }
    } else if (head == "contracts" && t.path.length == 1) {
      const r = contractsTable(file, t);
      if (r.isErr()) {
        return Err(r.unwrapErr());
      }
      m = Manifest { ...m, strictContracts: r.unwrap() };
    } else if (head == "effects") {
      const r = effectRule(file, t);
      if (r.isErr()) {
        return Err(r.unwrapErr());
      }
      let effs = m.effects;
      for (const x of effs) {
        if (x.module == r.unwrap().module) {
          return Err(invalid(file, span(file, t.start, t.end), "duplicate [effects] table for " + (x.module == "" ? "the package default" : "module `" + x.module + "`")));
        }
      }
      effs.push(r.unwrap());
      m = Manifest { ...m, effects: effs };
    } else if (head == "modules" && t.path.length >= 2) {
      const r = moduleRule(file, t);
      if (r.isErr()) {
        return Err(r.unwrapErr());
      }
      let rules = m.rules;
      for (const x of rules) {
        if (x.module == r.unwrap().module) {
          return Err(invalid(file, span(file, t.start, t.end), "duplicate rule for module `" + x.module + "`"));
        }
      }
      rules.push(r.unwrap());
      m = Manifest { ...m, rules: rules };
    } else {
      return Err(invalid(file, span(file, t.start, t.end),
        "unknown table `[" + t.path.join(".") + "]` (expected [package], [architecture], [contracts], [effects] or [modules.<path>])"));
    }
  }
  if (!havePackage) {
    return Err(invalid(file, span(file, 0, 0), "missing [package] table"));
  }
  return Ok(m);
}

// Index of the rule for `module`, if the manifest has one.
export function ruleIndex(m: Manifest, module: string): Option<usize> {
  let i: usize = 0;
  while (i < m.rules.length) {
    if (m.rules[i].module == module) {
      return Some(i);
    }
    i += 1;
  }
  return None;
}

// Index of the `[effects]` table for `module` ("" = the package default), if the manifest has one.
export function effectRuleIndex(m: Manifest, module: string): Option<usize> {
  let i: usize = 0;
  while (i < m.effects.length) {
    if (m.effects[i].module == module) {
      return Some(i);
    }
    i += 1;
  }
  return None;
}

export function validPackageName(s: string): bool {
  if (s.length == 0 || s == "." || s == ".." || s.startsWith("-")) { return false; }
  let i: usize = 0;
  while (i < s.length) {
    const c = s.charCodeAt(i);
    if (!(c >= 97 && c <= 122 || c >= 65 && c <= 90 || c >= 48 && c <= 57 || c == 45 || c == 95)) { return false; }
    i += 1;
  }
  return true;
}

function dependencyEntry(file: usize, e: TomlEntry, dev: bool): Result<Dependency, Diagnostic> {
  let dep = Dependency { name: e.key, path: "", git: "", tag: "", rev: "", dev: dev };
  if (!validPackageName(e.key)) { return Err(invalid(file, entrySpan(file, e), "invalid dependency name")); }
  match (e.value) {
    TInline(keys, values) => {
      let i: usize = 0;
      while (i < keys.length) {
        const key = keys[i]; const value = values[i];
        if (value.length == 0 || value.includes("\n") || value.includes("\r") || value.includes("\t") || value.includes("|")) { return Err(invalid(file, entrySpan(file, e), "invalid dependency value")); }
        if (key == "path") { dep.path = value; }
        else if (key == "git") { dep.git = value; }
        else if (key == "tag") { dep.tag = value; }
        else if (key == "rev") { dep.rev = value; }
        else { return Err(invalid(file, entrySpan(file, e), "unknown dependency key `" + key + "`")); }
        i += 1;
      }
    },
    _ => { return Err(invalid(file, entrySpan(file, e), "dependency must be an inline table")); }
  }
  if ((dep.path == "") == (dep.git == "") || dep.tag != "" && dep.rev != "" || dep.path != "" && (dep.tag != "" || dep.rev != "")) {
    return Err(invalid(file, entrySpan(file, e), "choose one dependency source: path or git (with tag or rev)"));
  }
  return Ok(dep);
}
