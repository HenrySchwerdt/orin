// std:test -- assertions for `@Test` functions (ADR-0024, docs/testing.md).
//
// A failed assertion TRAPS: it writes `trap: <message>` to stderr and exits with status 101, exactly
// like any other trap (array bounds, `unwrap` of `None`, a violated contract). `orin test` runs
// every test in its own process, so one failing test never stops the others. The functions work in
// ordinary programs too (they are not tied to `orin test`).
//
//   * Every function is total apart from the trap it exists for; none returns a value.
//   * `msg` describes what was being checked ("" is allowed); it is part of the trap message.
//   * Orin has no generic equality, so there is one function per type: `assertEq` (int),
//     `assertEqUsize`, `assertEqString`, `assertEqBool`, `assertNear` (float with a tolerance).
//   * Complexity: O(1) (string equality: O(n)); no allocation unless the assertion fails.

import { exit } from "std:process";

// fail(msg: string): void
// Traps with `msg` unconditionally (a test that reached a place it must not reach).
export function fail(msg: string): void {
  console.error("trap: " + msg);
  exit(101);
}

// assert(cond: bool, msg: string): void
// Traps with "assertion failed: <msg>" when `cond` is false.
export function assert(cond: bool, msg: string): void {
  if (!cond) {
    fail("assertion failed: " + msg);
  }
}

function label(msg: string): string {
  return msg.length > 0 ? msg + ": " : "";
}

// assertEq(actual: int, expected: int, msg: string): void
// Traps with "assertEq failed: <msg>: expected <expected>, got <actual>" when the ints differ.
export function assertEq(actual: int, expected: int, msg: string): void {
  if (actual != expected) {
    fail("assertEq failed: " + label(msg) + "expected " + expected.toString() + ", got " + actual.toString());
  }
}

// assertEqUsize(actual: usize, expected: usize, msg: string): void
// Like `assertEq` for `usize` (lengths, indices).
export function assertEqUsize(actual: usize, expected: usize, msg: string): void {
  if (actual != expected) {
    fail("assertEq failed: " + label(msg) + "expected " + expected.toString() + ", got " + actual.toString());
  }
}

// assertEqString(actual: string, expected: string, msg: string): void
// Like `assertEq` for strings; the values are shown in double quotes.
export function assertEqString(actual: string, expected: string, msg: string): void {
  if (actual != expected) {
    fail("assertEq failed: " + label(msg) + "expected \"" + expected + "\", got \"" + actual + "\"");
  }
}

// assertEqBool(actual: bool, expected: bool, msg: string): void
// Like `assertEq` for bools.
export function assertEqBool(actual: bool, expected: bool, msg: string): void {
  if (actual != expected) {
    fail("assertEq failed: " + label(msg) + "expected " + expected.toString() + ", got " + actual.toString());
  }
}

// assertNear(actual: float, expected: float, tolerance: float, msg: string): void
// Traps unless |actual - expected| <= tolerance (a NaN on either side always fails).
export function assertNear(actual: float, expected: float, tolerance: float, msg: string): void {
  const d = actual > expected ? actual - expected : expected - actual;
  if (!(d <= tolerance)) {
    fail("assertNear failed: " + label(msg) + "expected " + expected.toString() + " +/- " + tolerance.toString() + ", got " + actual.toString());
  }
}
