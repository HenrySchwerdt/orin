// std:bytes -- immutable byte sequences, a byte builder and a bounds-checked byte reader (ADR-0030 §3,
// layer "bytes and text"). Pure safe Orin: no C, no new built-ins.
//
// Representation. A byte is a `u8`. `Bytes` is a view `data[start .. start + len)` of a `u8[]`; arrays are
// copy-on-write values, so a `Bytes` never changes and `slice` is O(1) (the storage is shared, nothing is
// copied until somebody mutates it, and nobody can: the fields are private and `Bytes` has no mutating
// method). The runtime stores a `u8` array element in 8 bytes (ADR-0022); strings are the compact form and
// `toRawString` / `fromString` convert byte for byte in O(n).
//
// Contract standard (ADR-0030 §3). Every class carries an `@Invariant` that the checked build
// (`orin test`, `--check-contracts`) verifies after every public method; every public method states
// `@Requires` / `@Ensures`; helpers used in contracts are loops, not closures, and never call themselves.
// Reads never trap: `ByteReader` returns `Err(BytesError)` when fewer bytes remain than requested, and the
// cursor is left where it was.
//
// Names follow ADR-0048 section 1: `length()` for the element count of a sequence, `get(i)` the checked read and
// `at(i)` the contract read, `fromX(..)` build a `Bytes` (call them as `bytes.fromString(s)` after `import * as bytes`),
// `toX()` copies out. Hex has one home, `std:encoding` (`hexEncode` / `hexDecode` / `hexDecodeText`); `Bytes.toHex()`
// stays as the implementation `hexEncode` calls, `bytesFromHex` is a deprecated leftover (std:bytes cannot import
// std:encoding: that would be an import cycle).
//
// Complexity: n = number of bytes involved. `length`, `get`, `at`, `slice`, `trySlice` O(1); `concat`, `equals`,
// `startsWith`, `indexOf`, `indexOfBytes`, `toArray`, `toRawString`, `toHex` O(n); `ByteBuilder.append*` amortised O(1) per byte;
// `ByteReader.read*` O(1) per byte read (`readExact` O(n): it copies nothing, it slices).

// ---------------------------------------------------------------------------------------------- Bytes

// Is every element of `xs` a valid byte (0..255)? Loop-based so that contracts can use it.
export function allBytes(xs: int[]): bool {
  let i: usize = 0;
  while (i < xs.length) {
    if (xs[i] < 0 || xs[i] > 255) {
      return false;
    }
    i += 1;
  }
  return true;
}

// An immutable sequence of bytes: the view data[start .. start + len).
@Invariant(this.start + this.len <= this.data.length)
export class Bytes {
  private data: u8[];
  private start: usize;
  private len: usize;

  // new Bytes(data, start, len): the view of `len` bytes of `data` from `start`. Most code uses
  // `bytesFromArray` / `bytesFromString` / `emptyBytes` instead.
  @Requires(start + len <= data.length)
  constructor(data: u8[], start: usize, len: usize) {
    this.data = data;
    this.start = start;
    this.len = len;
  }

  // length(): usize -- number of bytes. O(1).
  @Ensures(result == this.len)
  length(): usize {
    return this.len;
  }

  // isEmpty(): bool -- true when there are no bytes. O(1).
  @Ensures(result == (this.length() == 0))
  isEmpty(): bool {
    return this.len == 0;
  }

  // get(i): Option<u8> -- the byte at index i, or None when i >= length(). Never traps. O(1).
  @Ensures(result.isSome() == (i < this.len))
  get(i: usize): Option<u8> {
    if (i >= this.len) {
      return None;
    }
    return Some(this.data[this.start + i]);
  }

  // at(i): u8 -- the byte at index i. Precondition i < length(). O(1).
  @Requires(i < this.len)
  at(i: usize): u8 {
    return this.data[this.start + i];
  }

  // slice(lo, hi): Bytes -- the bytes [lo, hi). Shares storage with the receiver. O(1).
  @Requires(lo <= hi && hi <= this.len)
  @Ensures(result.length() == hi - lo)
  @Ensures(hi > lo ==> result.at(0) == this.at(lo) && result.at(hi - lo - 1) == this.at(hi - 1))
  slice(lo: usize, hi: usize): Bytes {
    return new Bytes(this.data, this.start + lo, hi - lo);
  }

  // trySlice(lo, hi): Option<Bytes> -- `slice` that answers None instead of requiring lo <= hi <= length(). O(1).
  @Ensures(result.isSome() == (lo <= hi && hi <= this.len))
  @Ensures(result.isSome() ==> result.unwrap().length() == hi - lo)
  trySlice(lo: usize, hi: usize): Option<Bytes> {
    if (lo > hi || hi > this.len) {
      return None;
    }
    return Some(this.slice(lo, hi));
  }

  // concat(other): Bytes -- this followed by other. O(length() + other.length()).
  @Ensures(result.length() == this.len + other.length())
  @Ensures(this.len > 0 ==> result.at(0) == this.at(0))
  @Ensures(other.length() > 0 ==> result.at(this.len) == other.at(0))
  @Ensures(other.length() > 0 ==> result.at(this.len + other.length() - 1) == other.at(other.length() - 1))
  concat(other: Bytes): Bytes {
    let out: u8[] = [];
    let i: usize = 0;
    while (i < this.len) {
      out.push(this.data[this.start + i]);
      i += 1;
    }
    let j: usize = 0;
    while (j < other.length()) {
      out.push(other.at(j));
      j += 1;
    }
    return new Bytes(out, 0, out.length);
  }

  // equals(other): bool -- same length and same bytes. O(n).
  @Ensures(result ==> this.len == other.length())
  @Ensures(this.len != other.length() ==> !result)
  equals(other: Bytes): bool {
    if (this.len != other.length()) {
      return false;
    }
    let i: usize = 0;
    while (i < this.len) {
      if (this.data[this.start + i] != other.at(i)) {
        return false;
      }
      i += 1;
    }
    return true;
  }

  // startsWith(prefix): bool -- the first prefix.length() bytes equal `prefix`. O(prefix.length()).
  @Ensures(result ==> prefix.length() <= this.len)
  @Ensures(prefix.length() == 0 ==> result)
  startsWith(prefix: Bytes): bool {
    if (prefix.length() > this.len) {
      return false;
    }
    let i: usize = 0;
    while (i < prefix.length()) {
      if (this.data[this.start + i] != prefix.at(i)) {
        return false;
      }
      i += 1;
    }
    return true;
  }

  // indexOf(b): Option<usize> -- the first index holding byte b, or None. Never traps. O(n).
  @Ensures(result.isSome() ==> result.unwrap() < this.len && this.at(result.unwrap()) == b)
  indexOf(b: u8): Option<usize> {
    let i: usize = 0;
    while (i < this.len) {
      if (this.data[this.start + i] == b) {
        return Some(i);
      }
      i += 1;
    }
    return None;
  }

  // includes(b): bool -- is byte b present? Never traps. O(n).
  @Ensures(result == this.indexOf(b).isSome())
  includes(b: u8): bool {
    return this.indexOf(b).isSome();
  }

  // indexOfBytes(needle, begin): Option<usize> -- the first index i >= begin where the bytes of `needle` occur, or None.
  // An empty needle matches at `begin` when begin <= length(). None when begin > length() or the needle does not fit.
  // Never traps. O(length() * needle.length()) worst case, O(length()) typical.
  @Ensures(result.isSome() ==> result.unwrap() >= begin && result.unwrap() + needle.length() <= this.len)
  @Ensures(needle.length() == 0 ==> result.isSome() == (begin <= this.len))
  indexOfBytes(needle: Bytes, begin: usize): Option<usize> {
    const m = needle.length();
    if (begin > this.len || m > this.len - begin) {
      return None;
    }
    let i = begin;
    while (i + m <= this.len) {
      let k: usize = 0;
      while (k < m && this.data[this.start + i + k] == needle.at(k)) {
        k += 1;
      }
      if (k == m) {
        return Some(i);
      }
      i += 1;
    }
    return None;
  }

  // toArray(): u8[] -- a copy of the bytes. O(n).
  @Ensures(result.length == this.len)
  toArray(): u8[] {
    return this.data.slice(this.start, this.start + this.len);
  }

  // storage(): u8[] -- the array the view reads, without a copy: byte i of the view is `storage()[storageStart() + i]`. For
  // byte loops that would otherwise call `at` per byte (a call and a reference count each) or copy with `toArray`.
  // Arrays are values, so the caller cannot change the view through it. O(1).
  @Ensures(result.length >= this.start + this.len)
  @Ensures(this.len > 0 ==> result[this.start] == this.at(0) && result[this.start + this.len - 1] == this.at(this.len - 1))
  storage(): u8[] {
    return this.data;
  }

  // storageStart(): usize -- the index in `storage()` of the first byte of the view. O(1).
  @Ensures(result == this.start && result + this.len <= this.storage().length)
  storageStart(): usize {
    return this.start;
  }

  // toRawString(): string -- the same bytes as a string. No validation: the string holds arbitrary bytes (use
  // `std:utf8` to get text). Inverse of `bytesFromString`. O(n).
  @Ensures(result.length == this.len)
  toRawString(): string {
    return bytesToString(this.data, this.start, this.len);
  }

  // toHex(): string -- lower-case hexadecimal, two digits per byte; `std:encoding.hexEncode` calls this. Never fails. O(n).
  @Ensures(result.length == 2 * this.len)
  toHex(): string {
    const digits = "0123456789abcdef";
    let out: u8[] = [];
    let i: usize = 0;
    while (i < this.len) {
      const b = this.data[this.start + i].toInt();
      out.push(digits.charCodeAt((b / 16).toUsize()).toU8());
      out.push(digits.charCodeAt((b % 16).toUsize()).toU8());
      i += 1;
    }
    return bytesToString(out, 0, out.length);
  }
}

// The value of a hexadecimal digit character code, or -1.
@Ensures(result >= -1 && result < 16)
function hexValue(c: int): int {
  if (c >= 48 && c <= 57) {
    return c - 48;
  }
  if (c >= 97 && c <= 102) {
    return c - 87;
  }
  if (c >= 65 && c <= 70) {
    return c - 55;
  }
  return -1;
}

// empty(): Bytes -- no bytes. Never fails. O(1).
@Ensures(result.length() == 0)
export function empty(): Bytes {
  return new Bytes([], 0, 0);
}

@Deprecated("use empty() (ADR-0048)")
export function emptyBytes(): Bytes {
  return empty();
}

// fromArray(xs): Bytes -- the bytes of `xs` (the array is shared, not copied). Never fails. O(1).
@Ensures(result.length() == xs.length)
export function fromArray(xs: u8[]): Bytes {
  return new Bytes(xs, 0, xs.length);
}

@Deprecated("use fromArray(xs) (ADR-0048)")
export function bytesFromArray(xs: u8[]): Bytes {
  return fromArray(xs);
}

// fromInts(xs): Bytes -- bytes from integers. Traps unless every element lies in 0..255. O(n).
@Requires(allBytes(xs))
@Ensures(result.length() == xs.length)
export function fromInts(xs: int[]): Bytes {
  let out: u8[] = [];
  let i: usize = 0;
  while (i < xs.length) {
    out.push(xs[i].toU8());
    i += 1;
  }
  return new Bytes(out, 0, out.length);
}

@Deprecated("use fromInts(xs) (ADR-0048)")
@Requires(allBytes(xs))
export function bytesFromInts(xs: int[]): Bytes {
  return fromInts(xs);
}

// fromString(s): Bytes -- the bytes of a string, one per string byte (no encoding step). Never fails. O(n).
@Ensures(result.length() == s.length)
export function fromString(s: string): Bytes {
  const out = stringToBytes(s);
  return new Bytes(out, 0, out.length);
}

@Deprecated("use fromString(s) (ADR-0048)")
export function bytesFromString(s: string): Bytes {
  return fromString(s);
}

// bytesFromHex(s): Option<Bytes> -- DEPRECATED, use `std:encoding.hexDecodeText(s)`, which reports why a text is not hex.
// Decodes pairs of hex digits (either case); None for an odd length or a non-hex character. O(n). Kept with its own
// code for one release because std:bytes cannot import std:encoding (import cycle).
@Deprecated("use hexDecodeText(s) of std:encoding, which returns a Result (ADR-0048)")
@Ensures(result.isSome() ==> result.unwrap().length() * 2 == s.length)
@Ensures(s.length % 2 == 1 ==> result.isNone())
export function bytesFromHex(s: string): Option<Bytes> {
  if (s.length % 2 == 1) {
    return None;
  }
  let out: u8[] = [];
  let i: usize = 0;
  while (i < s.length) {
    const hi = hexValue(s.charCodeAt(i));
    const lo = hexValue(s.charCodeAt(i + 1));
    if (hi < 0 || lo < 0) {
      return None;
    }
    out.push((hi * 16 + lo).toU8());
    i += 2;
  }
  return Some(new Bytes(out, 0, out.length));
}

// ----------------------------------------------------------------------------------------- ByteBuilder

// Strings up to this length are appended by `ByteBuilder.appendString` byte by byte; longer ones in one block.
const SHORT_STRING: usize = 64;

// A growable byte buffer. `cap` (read by `capacity()`) is bookkeeping for `reserve` (the runtime has no array reserve: the array
// still grows geometrically on `push`); the invariant ties it to the length.
@Invariant(this.cap >= this.data.length)
export class ByteBuilder {
  private data: u8[] = [];
  private cap: usize = 0;

  // length(): usize -- number of bytes appended so far. O(1).
  @Ensures(result == this.data.length)
  length(): usize {
    return this.data.length;
  }

  // isEmpty(): bool -- no byte appended yet. O(1).
  @Ensures(result == (this.length() == 0))
  isEmpty(): bool {
    return this.data.length == 0;
  }

  // capacity(): usize -- the number of bytes that fit without a reservation being exceeded; never below length(). O(1).
  @Ensures(result == this.cap)
  capacity(): usize {
    return this.cap;
  }

  @Deprecated("use capacity() (ADR-0048)")
  @Ensures(result == this.cap)
  reserved(): usize {
    return this.cap;
  }

  // byteAt(i): u8 -- the byte at index i. Precondition i < length(). O(1).
  @Requires(i < this.data.length)
  byteAt(i: usize): u8 {
    return this.data[i];
  }

  // reserve(extra): void -- room for `extra` more bytes. The contents do not change. O(1).
  @Ensures(this.length() == old(this.length()))
  @Ensures(this.capacity() >= this.length() + extra)
  reserve(extra: usize): void {
    if (this.cap < this.data.length + extra) {
      this.cap = this.data.length + extra;
    }
  }

  private grew(): void {
    if (this.cap < this.data.length) {
      this.cap = this.data.length;
    }
  }

  // appendU8(v): void -- one byte. Amortised O(1).
  @Ensures(this.length() == old(this.length()) + 1)
  @Ensures(this.byteAt(this.length() - 1) == v)
  appendU8(v: u8): void {
    this.data.push(v);
    this.grew();
  }

  // appendU16Be(v): void -- two bytes, most significant first. O(1).
  @Ensures(this.length() == old(this.length()) + 2)
  @Ensures(this.byteAt(this.length() - 2).toInt() == v.toInt() / 256)
  @Ensures(this.byteAt(this.length() - 1).toInt() == v.toInt() % 256)
  appendU16Be(v: u16): void {
    const n = v.toInt();
    this.data.push((n / 256).toU8());
    this.data.push((n % 256).toU8());
    this.grew();
  }

  // appendU16Le(v): void -- two bytes, least significant first. O(1).
  @Ensures(this.length() == old(this.length()) + 2)
  @Ensures(this.byteAt(this.length() - 2).toInt() == v.toInt() % 256)
  @Ensures(this.byteAt(this.length() - 1).toInt() == v.toInt() / 256)
  appendU16Le(v: u16): void {
    const n = v.toInt();
    this.data.push((n % 256).toU8());
    this.data.push((n / 256).toU8());
    this.grew();
  }

  // appendU32Be(v): void -- four bytes, most significant first. O(1).
  @Ensures(this.length() == old(this.length()) + 4)
  @Ensures(this.byteAt(this.length() - 4).toInt() == v.toInt() / 16777216)
  @Ensures(this.byteAt(this.length() - 1).toInt() == v.toInt() % 256)
  appendU32Be(v: u32): void {
    const n = v.toInt();
    this.data.push((n / 16777216).toU8());
    this.data.push(((n / 65536) % 256).toU8());
    this.data.push(((n / 256) % 256).toU8());
    this.data.push((n % 256).toU8());
    this.grew();
  }

  // appendU32Le(v): void -- four bytes, least significant first. O(1).
  @Ensures(this.length() == old(this.length()) + 4)
  @Ensures(this.byteAt(this.length() - 4).toInt() == v.toInt() % 256)
  @Ensures(this.byteAt(this.length() - 1).toInt() == v.toInt() / 16777216)
  appendU32Le(v: u32): void {
    const n = v.toInt();
    this.data.push((n % 256).toU8());
    this.data.push(((n / 256) % 256).toU8());
    this.data.push(((n / 65536) % 256).toU8());
    this.data.push((n / 16777216).toU8());
    this.grew();
  }

  @Deprecated("use appendU16Be(v) (ADR-0048)")
  appendU16be(v: u16): void {
    this.appendU16Be(v);
  }

  @Deprecated("use appendU16Le(v) (ADR-0048)")
  appendU16le(v: u16): void {
    this.appendU16Le(v);
  }

  @Deprecated("use appendU32Be(v) (ADR-0048)")
  appendU32be(v: u32): void {
    this.appendU32Be(v);
  }

  @Deprecated("use appendU32Le(v) (ADR-0048)")
  appendU32le(v: u32): void {
    this.appendU32Le(v);
  }

  // appendBytes(b): void -- all bytes of `b`. O(b.length()). A view of a whole array is appended in one step (the buffer is
  // extended in place); a partial view is copied from its storage in a plain loop: no call and no reference count per
  // byte, no temporary array.
  @Ensures(this.length() == old(this.length()) + b.length())
  @Ensures(b.length() > 0 ==> this.byteAt(this.length() - b.length()) == b.at(0))
  @Ensures(b.length() > 0 ==> this.byteAt(this.length() - 1) == b.at(b.length() - 1))
  appendBytes(b: Bytes): void {
    const src = b.storage();
    const s0 = b.storageStart();
    const n = b.length();
    if (s0 == 0 && n == src.length) {
      this.data = this.data.concat(src);
    } else {
      let i: usize = 0;
      while (i < n) {
        this.data.push(src[s0 + i]);
        i += 1;
      }
    }
    this.grew();
  }

  // appendString(s): void -- the bytes of `s` (no encoding step). O(s.length). A short string is appended byte by byte (no
  // temporary array); a long one through one temporary array and an in-place extension.
  @Ensures(this.length() == old(this.length()) + s.length)
  @Ensures(s.length > 0 ==> this.byteAt(this.length() - s.length).toInt() == s.charCodeAt(0))
  @Ensures(s.length > 0 ==> this.byteAt(this.length() - 1).toInt() == s.charCodeAt(s.length - 1))
  appendString(s: string): void {
    if (s.length <= SHORT_STRING) {
      let i: usize = 0;
      while (i < s.length) {
        this.data.push(s.charCodeAt(i).toU8());
        i += 1;
      }
    } else {
      this.data = this.data.concat(stringToBytes(s));
    }
    this.grew();
  }

  // clear(): void -- remove all bytes; the reservation stays. O(1).
  @Ensures(this.length() == 0)
  @Ensures(this.capacity() == old(this.capacity()))
  clear(): void {
    this.data = [];
  }

  // build(): Bytes -- the bytes appended so far as an immutable `Bytes`; the builder stays usable. O(1) (shares storage).
  @Ensures(result.length() == this.data.length)
  build(): Bytes {
    return new Bytes(this.data, 0, this.data.length);
  }
}

// ----------------------------------------------------------------------------------------- ByteReader

// Why a read failed (ADR-0048 rule 3.1): at byte `offset` the reader needed `needed` bytes but only `remaining` were
// left. Running off the end is the only failure of std:bytes, so the record has no `kind` field (a one-variant
// `BytesErrorKind` is not expressible: a union needs two variants).
export type BytesError = { offset: usize; needed: usize; remaining: usize; };

// bytesErrorMessage(e): string -- "unexpected end of input at byte 3: needed 4 bytes, 1 remaining". Never fails; O(1),
// allocates the message.
@Ensures(result.length > 0)
export function bytesErrorMessage(e: BytesError): string {
  return `unexpected end of input at byte ${e.offset.toString()}: needed ${e.needed.toString()} bytes, ${e.remaining.toString()} remaining`;
}

// ReadError: the old name of `BytesError` (a type alias cannot carry a @Deprecated; the field `position` is now `offset`).
export type ReadError = BytesError;

@Deprecated("use bytesErrorMessage(e) (ADR-0048)")
export function readErrorMessage(e: BytesError): string {
  return bytesErrorMessage(e);
}

// A cursor over a `Bytes`. Invariant: the cursor never passes the end, so `remaining()` cannot underflow and
// every successful read is in bounds. A failed read changes nothing.
@Invariant(this.pos <= this.src.length())
export class ByteReader {
  private src: Bytes;
  private pos: usize = 0;

  constructor(src: Bytes) {
    this.src = src;
  }

  // position(): usize -- index of the next byte to read. O(1).
  @Ensures(result <= this.src.length())
  position(): usize {
    return this.pos;
  }

  // remaining(): usize -- number of unread bytes. O(1).
  @Ensures(result + this.pos == this.src.length())
  remaining(): usize {
    return this.src.length() - this.pos;
  }

  // isAtEnd(): bool -- no unread bytes. O(1).
  @Ensures(result == (this.remaining() == 0))
  isAtEnd(): bool {
    return this.pos == this.src.length();
  }

  // peekAt(offset): Option<u8> -- the unread byte `offset` positions ahead (0 = next), without moving. None past the end. O(1).
  @Ensures(result.isSome() == (offset < this.remaining()))
  peekAt(offset: usize): Option<u8> {
    return this.src.get(this.pos + offset);
  }

  private shortRead(n: usize): BytesError {
    return BytesError { offset: this.pos, needed: n, remaining: this.src.length() - this.pos };
  }

  // readU8(): Result<u8, BytesError> -- the next byte. Err when no byte is left (cursor unchanged). O(1).
  @Ensures(result.isOk() == (old(this.remaining()) >= 1))
  @Ensures(result.isOk() ==> this.position() == old(this.position()) + 1)
  @Ensures(result.isErr() ==> this.position() == old(this.position()))
  @Ensures(result.isOk() ==> result.unwrap() == old(this.peekAt(0).unwrapOr(0)))
  @Ensures(result.isErr() ==> result.unwrapErr().needed == 1 && result.unwrapErr().remaining == old(this.remaining()))
  readU8(): Result<u8, BytesError> {
    if (this.src.length() - this.pos < 1) {
      return Err(this.shortRead(1));
    }
    const v = this.src.at(this.pos);
    this.pos += 1;
    return Ok(v);
  }

  // readU16Be(): Result<u16, BytesError> -- the next two bytes as a big-endian u16. Err when fewer than 2 remain (cursor unchanged). O(1).
  @Ensures(result.isOk() == (old(this.remaining()) >= 2))
  @Ensures(result.isOk() ==> this.position() == old(this.position()) + 2)
  @Ensures(result.isErr() ==> this.position() == old(this.position()))
  @Ensures(result.isOk() ==> result.unwrap().toInt() == old(this.peekAt(0).unwrapOr(0)).toInt() * 256 + old(this.peekAt(1).unwrapOr(0)).toInt())
  readU16Be(): Result<u16, BytesError> {
    if (this.src.length() - this.pos < 2) {
      return Err(this.shortRead(2));
    }
    const a = this.src.at(this.pos).toInt();
    const b = this.src.at(this.pos + 1).toInt();
    this.pos += 2;
    return Ok((a * 256 + b).toU16());
  }

  // readU16Le(): Result<u16, BytesError> -- the next two bytes as a little-endian u16. Err when fewer than 2 remain (cursor unchanged). O(1).
  @Ensures(result.isOk() == (old(this.remaining()) >= 2))
  @Ensures(result.isOk() ==> this.position() == old(this.position()) + 2)
  @Ensures(result.isErr() ==> this.position() == old(this.position()))
  @Ensures(result.isOk() ==> result.unwrap().toInt() == old(this.peekAt(1).unwrapOr(0)).toInt() * 256 + old(this.peekAt(0).unwrapOr(0)).toInt())
  readU16Le(): Result<u16, BytesError> {
    if (this.src.length() - this.pos < 2) {
      return Err(this.shortRead(2));
    }
    const a = this.src.at(this.pos).toInt();
    const b = this.src.at(this.pos + 1).toInt();
    this.pos += 2;
    return Ok((b * 256 + a).toU16());
  }

  // readU32Be(): Result<u32, BytesError> -- the next four bytes as a big-endian u32. Err when fewer than 4 remain (cursor unchanged). O(1).
  @Ensures(result.isOk() == (old(this.remaining()) >= 4))
  @Ensures(result.isOk() ==> this.position() == old(this.position()) + 4)
  @Ensures(result.isErr() ==> this.position() == old(this.position()))
  @Ensures(result.isOk() ==> result.unwrap().toInt() / 16777216 == old(this.peekAt(0).unwrapOr(0)).toInt())
  @Ensures(result.isOk() ==> result.unwrap().toInt() % 256 == old(this.peekAt(3).unwrapOr(0)).toInt())
  readU32Be(): Result<u32, BytesError> {
    if (this.src.length() - this.pos < 4) {
      return Err(this.shortRead(4));
    }
    const a = this.src.at(this.pos).toInt();
    const b = this.src.at(this.pos + 1).toInt();
    const c = this.src.at(this.pos + 2).toInt();
    const d = this.src.at(this.pos + 3).toInt();
    this.pos += 4;
    return Ok((((a * 256 + b) * 256 + c) * 256 + d).toU32());
  }

  // readU32Le(): Result<u32, BytesError> -- the next four bytes as a little-endian u32. Err when fewer than 4 remain (cursor unchanged). O(1).
  @Ensures(result.isOk() == (old(this.remaining()) >= 4))
  @Ensures(result.isOk() ==> this.position() == old(this.position()) + 4)
  @Ensures(result.isErr() ==> this.position() == old(this.position()))
  @Ensures(result.isOk() ==> result.unwrap().toInt() / 16777216 == old(this.peekAt(3).unwrapOr(0)).toInt())
  @Ensures(result.isOk() ==> result.unwrap().toInt() % 256 == old(this.peekAt(0).unwrapOr(0)).toInt())
  readU32Le(): Result<u32, BytesError> {
    if (this.src.length() - this.pos < 4) {
      return Err(this.shortRead(4));
    }
    const a = this.src.at(this.pos).toInt();
    const b = this.src.at(this.pos + 1).toInt();
    const c = this.src.at(this.pos + 2).toInt();
    const d = this.src.at(this.pos + 3).toInt();
    this.pos += 4;
    return Ok((((d * 256 + c) * 256 + b) * 256 + a).toU32());
  }

  @Deprecated("use readU16Be() (ADR-0048)")
  readU16be(): Result<u16, BytesError> {
    return this.readU16Be();
  }

  @Deprecated("use readU16Le() (ADR-0048)")
  readU16le(): Result<u16, BytesError> {
    return this.readU16Le();
  }

  @Deprecated("use readU32Be() (ADR-0048)")
  readU32be(): Result<u32, BytesError> {
    return this.readU32Be();
  }

  @Deprecated("use readU32Le() (ADR-0048)")
  readU32le(): Result<u32, BytesError> {
    return this.readU32Le();
  }

  // readExact(n): Result<Bytes, BytesError> -- the next n bytes (a slice sharing storage, no copy). Err when fewer than n remain (cursor
  // unchanged). O(1).
  @Ensures(result.isOk() == (old(this.remaining()) >= n))
  @Ensures(result.isOk() ==> result.unwrap().length() == n && this.position() == old(this.position()) + n)
  @Ensures(result.isErr() ==> this.position() == old(this.position()))
  readExact(n: usize): Result<Bytes, BytesError> {
    if (this.src.length() - this.pos < n) {
      return Err(this.shortRead(n));
    }
    const out = this.src.slice(this.pos, this.pos + n);
    this.pos += n;
    return Ok(out);
  }

  // skip(n): Result<void, BytesError> -- advance n bytes. Err when fewer than n remain (cursor unchanged). O(1).
  @Ensures(result.isOk() == (old(this.remaining()) >= n))
  @Ensures(result.isOk() ==> this.position() == old(this.position()) + n)
  @Ensures(result.isErr() ==> this.position() == old(this.position()))
  skip(n: usize): Result<void, BytesError> {
    if (this.src.length() - this.pos < n) {
      return Err(this.shortRead(n));
    }
    this.pos += n;
    return Ok();
  }

  // takeRest(): Bytes -- all unread bytes as a slice (no copy); the cursor moves to the end. Never fails. O(1).
  @Ensures(this.isAtEnd() && result.length() == old(this.remaining()))
  takeRest(): Bytes {
    const out = this.src.slice(this.pos, this.src.length());
    this.pos = this.src.length();
    return out;
  }

  @Deprecated("use takeRest(), which says that the cursor moves (ADR-0048)")
  @Ensures(this.isAtEnd() && result.length() == old(this.remaining()))
  rest(): Bytes {
    return this.takeRest();
  }
}
