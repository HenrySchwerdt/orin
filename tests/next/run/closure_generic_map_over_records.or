type Person = { name: string; age: int; };
type Pair<A, B> = { first: A; second: B; };

function mapPair<A, B, C>(p: Pair<A, B>, f: (a: A) => C): Pair<C, B> {
  return Pair { first: f(p.first), second: p.second };
}

function main(): void {
  const people = [
    Person { name: "ann", age: 31 },
    Person { name: "bob", age: 25 },
    Person { name: "cy", age: 40 },
  ];
  const names = people.map(p => p.name);
  console.log(names.join(","));
  const ages = people.map(p => p.age);
  console.log(ages.reduce((a, b) => a + b, 0).toString());
  const older = people.map(p => Person { ...p, age: p.age + 1 });
  console.log(older[1].age.toString());
  const pairs = people.map(p => Pair { first: p.name, second: p.age });
  const lens = pairs.map(q => mapPair(q, s => s.length));
  console.log(lens[2].first.toString() + ":" + lens[2].second.toString());
  const adults = people.filter(p => p.age >= 30).map(p => p.name + "!");
  console.log(adults.join(" "));
}
