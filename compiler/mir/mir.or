// MIR — explicit-ownership control-flow IR. Shared contract (v1), owned by the lead architect.
// Pipeline: HIR --lower--> MIR --verify--> MIR --emit--> C (later also LLVM IR, ADR-0006).
// Semantics, ownership rules and verifier obligations: docs/mir.md (normative for this file).
//
// Every heap value is a reference (`MRef`) to an RC'd object (docs/architecture.md). Ownership is
// explicit: a local holding a reference is, at each program point, Owned (counts one reference),
// Borrowed (an alias valid while its source is unchanged) or Dead. The verifier
// (compiler/verify) checks these states by dataflow; codegen trusts a verified MIR.

import { Builtin, UnOp, BinOp } from "../hir";
import { Span } from "../diag";

// MFloat (v1.4, ADR-0018): an IEEE-754 binary64 scalar; an `f32` is an MFloat holding a value exactly
// representable in binary32 (lowering rounds with `IBuiltin(BF32Round)` after every f32 operation).
//
// MHandle (v1.8, ADR-0025; grants v1.9, ADR-0027): a resource handle (an open file or a capability grant). A scalar at
// run time, but NOT a plain scalar for the verifier: it can only be defined by an opener `IBuiltin(.., BFileOpen | BGrant*, ..)`
// (whose first argument is the authorising handle), passed as a call argument, and closed by
// `IBuiltin(.., BFileClose | BGrantRevoke, [h])` exactly once on every path; it is never copied, moved, stored, returned,
// compared or captured (compiler/verify, docs/mir.md "Resource handles").
export type MType = MInt | MUsize | MBool | MFloat | MHandle | MRef | MVoid;

// A local slot. Parameters are the first `paramCount` locals; a borrowed parameter is Borrowed for
// the whole function and must never be released, moved or mutated; an owned parameter starts Owned.
export type MLocal = { name: string; ty: MType; };

export type Operand =
  OLocal(usize)
  | OInt(int)          // int constant (type MInt)
  | OUsize(int)        // usize / u64 constant: the 64-bit pattern (a negative int is a value above 2^63-1, v1.6)
  | OBool(bool)
  | OFloat(string)     // float constant (type MFloat): canonical decimal text, e.g. "1.5", "-2.0e-3"
  | OStr(usize);       // immortal string literal: index into MProgram.strings; behaves as Owned
                       // when consumed and as Borrowed when read (never needs release)

export type Instr =
  // --- moves, copies, reference counting ---
  ICopy(usize, Operand)                 // dst = scalar operand (or OStr constant)
  | IMove(usize, usize)                 // dst = src; ownership transfers; src becomes Dead
  | IBorrow(usize, usize)               // dst = borrowed alias of src (no RC change)
  | IDup(usize, Operand)                // dst = retain(src): dst Owned (+1)
  | IRelease(usize)                     // release Owned local; it becomes Dead
  // --- scalars (checked; overflow/div-by-zero trap) ---
  | IUnary(usize, UnOp, Operand)
  | IBinary(usize, BinOp, Operand, Operand)   // int/usize/bool ops; Eq/Ne on strings allowed
  // --- calls: arguments in borrowed positions are borrowed for the call's duration, arguments in
  //     owned positions (callee.paramOwned[i]) are CONSUMED; the result is Owned ---
  | ICall(Option<usize>, usize, Operand[])          // dst, function index, args
  | IBuiltin(Option<usize>, Builtin, Operand[])     // non-mutating builtins (hir.Builtin)
  | IStrAppend(usize, Operand)          // x = x + y in place when x unique; x must be Owned
  | IStrPrepend(usize, Operand)         // x = y + x (v2.3): the consuming form of `y + x` for a dying x; in place when x
                                        // is unique; x must be Owned (the runtime may reallocate or replace it)
  | IArrayExtend(usize, Operand)        // x = x ++ y (array concatenation; v1.10) in place when x unique; x must be
                                        // Owned (the runtime may reallocate or replace it), y is only read; elements
                                        // of y that are references are retained
  // --- structs (records, variants, Option, Result) ---
  | IStructNew(usize, usize, Operand[]) // dst, tag, slots: ref slot operands are CONSUMED
                                        // (Owned locals become Dead; OStr allowed)
  | INullary(usize, usize)              // dst = immortal payload-less variant with tag
  | ITag(usize, Operand)                // dst (MInt) = tag of a struct
  | IGetField(usize, Operand, usize)    // dst = obj.slot[i]; ref result is Borrowed from obj
  | ISetField(usize, usize, Operand)    // obj.slot[i] = v; obj must be Unique; v consumed;
                                        // old slot value released
  | ITakeField(usize, usize, usize)     // dst = take obj.slot[i] (Owned); obj must be Unique;
                                        // slot becomes a hole until IPutField
  | IPutField(usize, usize, usize)      // obj.slot[i] = src (fills a hole); src consumed
  | IMakeUnique(usize)                  // x Owned -> Owned+Unique (copies if shared)
  // --- arrays ---
  | IArrayNew(usize, bool, Operand[])   // dst, elemIsRef, elements (ref elements consumed)
  | IArrayGet(usize, Operand, Operand)  // dst = arr[i] (trap if OOB); ref result Borrowed
  | IArraySet(usize, Operand, Operand)  // arr[i] = v; arr Unique; v consumed; old released
  | IArrayTake(usize, usize, Operand)   // dst = take arr[i] (Owned); arr Unique; hole
  | IArrayPut(usize, Operand, usize)    // arr[i] = src (fills hole); src consumed
  | IArrayPush(usize, Operand)          // arr Owned (COW inside runtime); v consumed
  | IArrayPop(usize, usize)             // dst (Owned Option) = pop arr; arr Owned
  // --- closures (v1.3, ADR-0011) ---
  | IClosure(usize, usize, Operand[])   // dst, lifted function, captured values: ref captures are
                                        // CONSUMED like IStructNew slots; dst Unique. The lifted
                                        // function's first parameter is the environment record
                                        // (holding the captures in order); all its parameters are borrowed
  | ICallIndirect(Option<usize>, Operand, Operand[])  // dst, closure (borrowed), args (borrowed);
                                        // result Owned. The callee gets (env, args..)
  // --- interfaces (v1.5, ADR-0019) ---
  | IIface(usize, usize, Operand)       // dst, vtable index (MProgram.vtables), boxed value: a reference
                                        // CONSUMED like an IStructNew slot (OStr allowed); dst Unique.
                                        // Runtime layout: struct { vtable pointer (scalar slot 0), value (reference slot 1) }
  | ICallVirtual(Option<usize>, Operand, usize, Operand[]);  // dst, interface value (borrowed), method slot,
                                        // args (borrowed); result Owned. Calls vtable[slot](value, args..)

export type SwitchCase = { value: int; target: usize; };

export type Terminator =
  TGoto(usize)
  | TBranch(Operand, usize, usize)              // bool cond, then-block, else-block
  | TSwitch(Operand, SwitchCase[], usize)       // int scrutinee (e.g. a tag), cases, default
  | TReturn(Option<Operand>)                    // ref result must be Owned (consumed) or OStr
  | TTrap(string);                              // defined trap: "trap: <msg>", exit 101

// A basic block. `spans[i]` is the source span of the HIR node `instrs[i]` was lowered from and `termSpan` that of the
// terminator (v2.0, ADR-0020 D3); `noSpan()` marks code with no source (hand-written MIR, instructions the optimiser
// invents). The spans never reach the C / LLVM output; the verifier reports them in its messages.
@Invariant(this.spans.length == this.instrs.length)
export type MBlock = { instrs: Instr[]; spans: Span[]; term: Terminator; termSpan: Span; };

// The span of code that has no source position.
@Ensures(!hasSpan(result))
export function noSpan(): Span {
  return Span { file: 4294967295, start: 0, end: 0 };
}

// True when `s` names a source position (anything but `noSpan()`).
export function hasSpan(s: Span): bool {
  return s.file != 4294967295;
}

// A block without source positions (hand-written MIR in tests and tools).
@Ensures(result.instrs.length == instrs.length && result.spans.length == instrs.length)
@Ensures(result.spans.every(s => !hasSpan(s)) && !hasSpan(result.termSpan))
export function plainBlock(instrs: Instr[], term: Terminator): MBlock {
  const spans: Span[] = instrs.map(i => noSpan());
  return MBlock { instrs: instrs, spans: spans, term: term, termSpan: noSpan() };
}

// The span of instruction `i` of block `blk`; `i == blk.instrs.length` is the terminator.
@Requires(i <= blk.instrs.length)
export function spanAt(blk: MBlock, i: usize): Span {
  return i < blk.instrs.length ? blk.spans[i] : blk.termSpan;
}

export type MFunction = {
  name: string;            // qualified, unique, deterministic (same as HIR)
  paramCount: usize;
  paramOwned: bool[];      // one per parameter (length == paramCount): false = borrowed (the
                           // default), true = owned: the callee receives one counted reference and
                           // must consume, return or release it (v1.2, ADR-0010)
  inout: bool;             // v1.10: parameter 0 (an owned reference) is also an OUTPUT: the value that
                           // local 0 holds at each `TReturn` is handed back to the caller's argument
                           // local (docs/mir.md "In/out receiver"). The function's own result (`ret`) is
                           // returned as usual. Produced only by the optimiser (opt/pairs.or) from
                           // functions that return a freshly built two-slot record.
  locals: MLocal[];
  ret: MType;
  blocks: MBlock[];        // blocks[0] is the entry
};

// A vtable (v1.5): functions in interface-method order. Every function takes the boxed value (a
// reference) as its first parameter and has only borrowed parameters.
export type MVTable = { name: string; funcs: usize[]; };

export type MProgram = {
  functions: MFunction[];  // same indices as HIR functions
  strings: string[];       // deduplicated string literals, in first-use order
  main: usize;
  vtables: MVTable[];      // referenced by `IIface` (v1.5)
  inlineFns: string[];     // names of the `@Inline` functions (v1.7, ADR-0024): a backend hint with no semantic effect
};

// True when the function called `name` is marked `@Inline`.
export function isInlineFn(p: MProgram, name: string): bool {
  for (const n of p.inlineFns) {
    if (n == name) {
      return true;
    }
  }
  return false;
}
