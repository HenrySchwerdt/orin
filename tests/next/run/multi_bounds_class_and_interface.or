// A bound list that mixes declared interfaces and the built-in ones: the members of each bound are available on the parameter,
// and the parameter converts to every bound interface. Order of the bounds does not matter.
interface Shape {
  area(): int;
  name(): string;
}

interface Scaled {
  scale(k: int): int;
  name(): string;
}

class Square implements Shape, Scaled, Ord {
  constructor(public side: int) {}
  area(): int { return this.side * this.side; }
  name(): string { return "square"; }
  scale(k: int): int { return this.side * k; }
  compare(other: Square): int { return this.side - other.side; }
  equals(other: Square): bool { return this.side == other.side; }
}

class Rect implements Shape, Scaled {
  constructor(public w: int, public h: int) {}
  area(): int { return this.w * this.h; }
  name(): string { return "rect"; }
  scale(k: int): int { return this.w * this.h * k; }
}

class Disc implements Shape {
  constructor(public r: int) {}
  area(): int { return 3 * this.r * this.r; }
  name(): string { return "disc"; }
}

// both interfaces declare `name(): string`: the same signature is fine
function describe<T extends Shape & Scaled>(x: T): string {
  return x.name() + " " + x.area().toString() + " " + x.scale(2).toString();
}

function describeFlipped<T extends Scaled & Shape>(x: T): string {
  return x.name() + "/" + x.scale(3).toString() + "/" + x.area().toString();
}

function biggest<T extends Shape & Ord>(xs: T[]): T {
  let best = xs[0];
  for (const x of xs) {
    if (x > best) {
      best = x;
    }
  }
  return best;
}

function asShape<T extends Ord & Shape>(x: T): Shape {
  return x;
}

function both<T extends Shape & Scaled & Eq>(a: T, b: T): string {
  const s: Scaled = b;
  return a.name() + (a == b ? " same " : " different ") + s.scale(1).toString();
}

class Gallery<T extends Shape & Scaled> {
  items: T[] = [];
  add(x: T): void { this.items.push(x); }
  total(): int {
    let t = 0;
    for (const x of this.items) {
      t += x.area() + x.scale(1);
    }
    return t;
  }
  names(): string {
    return this.items.map(x => x.name()).join(",");
  }
}

function main(): void {
  console.log(describe(new Square(3)));
  console.log(describe(new Rect(2, 5)));
  console.log(describeFlipped(new Rect(2, 5)));
  console.log(biggest([new Square(2), new Square(7), new Square(4)]).side.toString());
  console.log(asShape(new Square(6)).area().toString());
  console.log(both(new Square(2), new Square(2)));
  console.log(both(new Square(2), new Square(3)));
  let g = new Gallery<Rect>();
  g.add(new Rect(1, 2));
  g.add(new Rect(3, 4));
  console.log(g.total().toString());
  console.log(g.names());
}
