function main(): void {
  console.log((1 + 2).toString());
  console.log((10 - 15).toString());
  console.log((6 * 7).toString());
  console.log((17 / 5).toString());
  console.log((17 % 5).toString());
  console.log((-17 / 5).toString());
  console.log((-17 % 5).toString());
  console.log((-(3 + 4)).toString());
  let x = 10;
  x += 5;
  x -= 3;
  x *= 4;
  x /= 5;
  x %= 7;
  console.log(x.toString());
}
