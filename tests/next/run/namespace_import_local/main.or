// Namespace and alias imports of a local module: values, constants, types in type positions, record and variant
// constructors, generic functions and types, classes, and qualified variants in match patterns.
import * as sh from "./shapes";
import { area as areaOf, Shape as S } from "./shapes";

function describe(s: sh.Shape): string {
  return match (s) {
    sh.Circle(r) => "circle " + r.toString(),
    sh.Rect(w, h) => "rect " + w.toString() + "x" + h.toString(),
  };
}

function main(): void {
  const s: sh.Shape = sh.Circle(2);
  const r: S = sh.Rect(2, 3);
  console.log(sh.area(s).toString());
  console.log(areaOf(r).toString());
  console.log(describe(s));
  console.log(describe(r));
  const p: sh.Pt = sh.Pt { x: 1, y: 2 };
  console.log((p.x + sh.ORIGIN_X).toString());
  console.log(sh.first<int>([5, 6]).toString());
  const b: sh.Box<int> = sh.Box<int> { v: 4 };
  console.log(b.v.toString());
  console.log(sh.unwrap<int>(sh.Mk(3), 0).toString());
  console.log(sh.unwrap(sh.Nil, 9).toString());
  const c = new sh.Counter(5);
  console.log(c.get().toString());
}
