import { total, rebate } from "../pricing";

/** A shopping cart; the item count never goes negative. */
@Invariant(this.items >= 0)
export class Cart {
  items: int;
  unit: int;
  constructor(unit: int) { this.items = 0; this.unit = unit; }

  /** Adds `n` items. */
  @Requires(n > 0)
  add(n: int): void { this.items = this.items + n; }

  /** The amount to pay after a discount. */
  due(percent: int): int {
    this.audit("due");
    return rebate(total(this.items, this.unit), percent);
  }

  /** Logs what happened to the cart (a console effect). */
  audit(what: string): void { console.log("cart: " + what); }
}
