import { fromMillis, toInstant, isLeapYear, daysInMonth, DateTime } from "std:time";

function describe(t: int): string {
  const d = fromMillis(t);
  return d.year.toString() + "-" + d.month.toString() + "-" + d.day.toString() + " "
    + d.hour.toString() + ":" + d.minute.toString() + ":" + d.second.toString() + "." + d.millisecond.toString()
    + " wd" + d.weekday.toString();
}

function main(): void {
  console.log(describe(0));
  console.log(describe(1709211845006));
  console.log(describe(-1));
  console.log(isLeapYear(1900).toString() + isLeapYear(2000).toString() + isLeapYear(2024).toString() + isLeapYear(2023).toString());
  console.log(daysInMonth(2024, 2).unwrap().toString() + " " + daysInMonth(2023, 2).unwrap().toString() + " " + daysInMonth(2023, 4).unwrap().toString());
  console.log(daysInMonth(2023, 13).isNone().toString());
  // Round trip over a range of instants including negatives and leap days.
  let ok = true;
  let t = -3000000000000;
  while (t < 5000000000000) {
    const d = fromMillis(t);
    const back = toInstant(d);
    if (back.isNone() || back.unwrap() != t) {
      ok = false;
    }
    t += 86399999999;
  }
  console.log(ok.toString());
  const d1 = DateTime { year: 2024, month: 2, day: 30, hour: 0, minute: 0, second: 0, millisecond: 0, weekday: 0 };
  console.log(toInstant(d1).isNone().toString());
  const d2 = DateTime { year: 2024, month: 2, day: 29, hour: 24, minute: 0, second: 0, millisecond: 0, weekday: 0 };
  console.log(toInstant(d2).isNone().toString());
  const d3 = DateTime { year: 2000, month: 3, day: 1, hour: 0, minute: 0, second: 0, millisecond: 0, weekday: 0 };
  console.log(toInstant(d3).unwrap().toString());
}
