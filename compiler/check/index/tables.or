// Name tables of the semantic index: the per-unit scope and export tables and what kind of HIR function a name maps to.
// Part of the semantic index (check/index/build.or).


// ---- tables ---------------------------------------------------------------------------------

// Name tables of one unit: type namespace (records, unions, aliases) and value namespace
// (functions, consts, variants), the unit's scope and its exports; plus the def of each item.
export type UnitTab = {
  tNames: string[]; tDefs: usize[];
  vNames: string[]; vDefs: usize[];
  xtNames: string[]; xtDefs: usize[];
  xvNames: string[]; xvDefs: usize[];
  itemDefs: usize[];
};

// What a HIR function is: FkOrdinary an ordinary function or generic instance, FkClosure a lifted closure body,
// FkWrapper a function-value wrapper (`f$closure`).
export type FnKind = FkOrdinary | FkClosure | FkWrapper;

export function fnKindNos(ks: FnKind[]): usize[] {
  let out: usize[] = [];
  for (const k of ks) {
    out.push(fnKindNo(k));
  }
  return out;
}

export function isOrdinaryKind(k: FnKind): bool {
  return match (k) {
    FkOrdinary => true,
    _ => false,
  };
}

export function isClosureKind(k: FnKind): bool {
  return match (k) {
    FkClosure => true,
    _ => false,
  };
}

export function isWrapperKind(k: FnKind): bool {
  return match (k) {
    FkWrapper => true,
    _ => false,
  };
}

// The kind as the number `SemanticIndex.fnKinds` stores (0 ordinary, 1 closure, 2 wrapper).
function fnKindNo(k: FnKind): usize {
  return match (k) {
    FkOrdinary => 0,
    FkClosure => 1,
    FkWrapper => 2,
  };
}

export function emptyTab(): UnitTab {
  const s: string[] = [];
  const d: usize[] = [];
  return UnitTab {
    tNames: s, tDefs: d, vNames: s, vDefs: d, xtNames: s, xtDefs: d, xvNames: s, xvDefs: d, itemDefs: d
  };
}

export function findName(names: string[], defs: usize[], name: string): Option<usize> {
  let i: usize = 0;
  while (i < names.length) {
    if (names[i] == name) {
      return Some(defs[i]);
    }
    i += 1;
  }
  return None;
}

// ---- pass 1: declarations, imports, exports ------------------------------------------------------

export function addT(t: UnitTab, name: string, def: usize, exported: bool): UnitTab {
  let x = t;
  x.tNames.push(name);
  x.tDefs.push(def);
  if (exported) {
    x.xtNames.push(name);
    x.xtDefs.push(def);
  }
  return x;
}

export function addV(t: UnitTab, name: string, def: usize, exported: bool): UnitTab {
  let x = t;
  x.vNames.push(name);
  x.vDefs.push(def);
  if (exported) {
    x.xvNames.push(name);
    x.xvDefs.push(def);
  }
  return x;
}

// A re-export adds to the exports only: undo the scope entry that `addT` / `addV` made last.
export function dropScopeT(t: UnitTab): UnitTab {
  let x = t;
  x.tNames.pop();
  x.tDefs.pop();
  return x;
}

export function dropScopeV(t: UnitTab): UnitTab {
  let x = t;
  x.vNames.pop();
  x.vDefs.pop();
  return x;
}
