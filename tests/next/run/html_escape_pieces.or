// std:html escape appends the runs between the special characters straight into the result (no substring objects). The
// text must be exactly what the substring version produced: nothing special, all special, specials at the ends, empty.
import { escape, needsEscape } from "std:html";

function show(s: string): void {
  console.log("[" + s + "] -> [" + escape(s) + "] " + needsEscape(s).toString());
}

function main(): void {
  show("");
  show("plain text 123");
  show("&");
  show("<");
  show(">");
  show("\"");
  show("'");
  show("&<>\"'");
  show("&&&&");
  show("<<a>>");
  show("a&b");
  show("&b");
  show("a&");
  show("x < y && y > z");
  show("say \"it's\" <b>bold</b> & more");
  show("café <b>");
  let long = "";
  let i = 0;
  while (i < 200) {
    long += "ab" + i.toString() + (i % 5 == 0 ? "<&>" : "") + " ";
    i += 1;
  }
  const e = escape(long);
  console.log(e.length.toString());
  console.log(e.substring(0, 60));
  console.log(e.substring(e.length - 60, e.length));
  const same = escape("keep");
  console.log(same);
}
