import { assertEq, assertEqString, assertEqUsize, assertEqBool } from "std:test";
import { parseArgs, parseIntLoose } from "../src/cli";

@Test
function defaults(): void {
  const p = parseArgs([]);
  assertEqBool(p.ok, true, "ok");
  assertEqString(p.options.orinc, "build/bootstrap/orin2", "orinc");
  assertEqString(p.options.cc, "cc", "cc");
  assertEqString(p.options.suite, "default", "suite");
  assertEqString(p.options.backend, "c", "backend");
  assertEq(p.options.jobs, 0, "jobs not given");
  assertEqBool(p.options.sanitize, false, "sanitize");
  assertEqBool(p.options.assertFacts, false, "assert-facts");
  assertEqString(p.options.root, ".", "root");
}

@Test
function everyFlag(): void {
  const p = parseArgs(["--orinc", "/x/orin", "--cc", "clang", "--filter", "ox", "-j", "3", "--sanitize", "--suite", "all", "--backend", "llvm", "--assert-facts", "--root", "/r"]);
  assertEqBool(p.ok, true, "ok");
  assertEqString(p.options.orinc, "/x/orin", "orinc");
  assertEqString(p.options.cc, "clang", "cc");
  assertEqString(p.options.filter, "ox", "filter");
  assertEq(p.options.jobs, 3, "jobs");
  assertEqBool(p.options.sanitize, true, "sanitize");
  assertEqString(p.options.suite, "all", "suite");
  assertEqString(p.options.backend, "llvm", "backend");
  assertEqBool(p.options.assertFacts, true, "assert-facts");
  assertEqString(p.options.root, "/r", "root");
}

@Test
function argparseConventions(): void {
  assertEqString(parseArgs(["--filter=a=b"]).options.filter, "a=b", "inline value keeps later =");
  assertEq(parseArgs(["-j4"]).options.jobs, 4, "-jN");
  assertEq(parseArgs(["--jobs=2"]).options.jobs, 2, "--jobs=N");
  assertEqString(parseArgs(["--orin", "c"]).options.orinc, "c", "unambiguous prefix");
  assertEqString(parseArgs(["--filter", "a", "--filter", "b"]).options.filter, "b", "the last one wins");
  assertEq(parseArgs(["-j", "0"]).options.jobs, 1, "0 jobs is sequential");
  assertEqBool(parseArgs(["-h"]).options.help, true, "-h");
}

@Test
function errorsAreUsageErrors(): void {
  assertEqBool(parseArgs(["--bogus"]).ok, false, "unknown option");
  assertEqBool(parseArgs(["stray"]).ok, false, "positional argument");
  assertEqBool(parseArgs(["--suite", "x"]).ok, false, "bad suite");
  assertEqBool(parseArgs(["--backend", "x"]).ok, false, "bad backend");
  assertEqBool(parseArgs(["-j", "many"]).ok, false, "bad jobs");
  assertEqBool(parseArgs(["--filter"]).ok, false, "missing value");
  assertEqBool(parseArgs(["--filter", "--sanitize"]).ok, false, "an option is not a value");
  assertEqBool(parseArgs(["--s"]).ok, false, "ambiguous prefix (--sanitize, --suite)");
  assertEqBool(parseArgs(["--sanitize=1"]).ok, false, "flag with a value");
  assertEqString(parseArgs(["--suite", "x"]).error, "argument --suite: invalid choice: 'x' (choose from 'default', 'next', 'all')", "message");
}

@Test
function looseIntegers(): void {
  assertEq(parseIntLoose(" 12 ").unwrap(), 12, "blanks");
  assertEq(parseIntLoose("+7").unwrap(), 7, "plus");
  assertEq(parseIntLoose("-3").unwrap(), -3, "minus");
  assertEqBool(parseIntLoose("1.5").isNone(), true, "float");
  assertEqBool(parseIntLoose("").isNone(), true, "empty");
  assertEqBool(parseIntLoose("+").isNone(), true, "sign only");
}
