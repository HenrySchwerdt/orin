// Semantic index producer (hir/index.or contract; spec 18 §1, ADR-0008).
//
// `buildIndex(prog, sm, hir)` computes definitions, references and expression types for the
// whole loaded program. It is a separate, additive pass next to the checker:
//
//   - definitions and references come from the AST with the module-level scope rules of
//     `collect.or` (declarations, imports with union variants, re-exports) and lexical scopes
//     for parameters, `const`/`let`, `for ... of` and pattern bindings. This needs no type
//     information, so locals, functions, types, variants and import-list names resolve even
//     when the program has type errors.
//   - field references (`a.b` reads, `p.x = ...` writes, record literal field names) and the
//     `types` table come from the typed HIR when checking succeeded (`hir` is Some): reads use
//     the checker's resolved record/field ids, writes are resolved through the declared types
//     of locals. With type errors these are absent (the index is then partial).
//
// Determinism: defs are numbered per unit (units in loader order): top-level declarations (with
// their fields / variants right behind them) first, then locals and parameters in source order
// per function. `refs` and `types` are sorted by position; duplicates are removed.

import { Span, SourceMap } from "../diag";
import {
  Ident, Item, FunctionDecl, TypeDecl, ConstDecl, TypeExpr, Param, Block, Stmt, Expr, FieldInit, MatchArm,
  ArmBody, Pattern, ClassDecl, ClassMember, CtorParam, ArrowBody
} from "../syntax";
import { LoadedProgram, ImportTarget } from "../loader";
import {
  Type, Program, Function, HBlock, HStmt, HExpr, Place, SymbolKind, SymbolDef, SymbolRef, TypeAt, SemanticIndex,
  SkFunction, SkRecord, SkUnion, SkVariant, SkAlias, SkConst, SkLocal, SkParam, SkField
} from "../hir";

// ---- tables ---------------------------------------------------------------------------------

// Name tables of one unit: type namespace (records, unions, aliases) and value namespace
// (functions, consts, variants), the unit's scope and its exports; plus the def of each item.
type UnitTab = {
  tNames: string[]; tDefs: usize[];
  vNames: string[]; vDefs: usize[];
  xtNames: string[]; xtDefs: usize[];
  xvNames: string[]; xvDefs: usize[];
  itemDefs: usize[];
};

// Read-only context of pass 2.
type Ctx = {
  prog: LoadedProgram;
  sm: SourceMap;
  tabs: UnitTab[];
  hir: Option<Program>;
  recDef: Option<usize>[];     // HIR record id -> its SkRecord def
  tq: string[];                // qualified type name ("unit.Name") -> def, for classes' method references
  tqDefs: usize[];
};

// Mutable walker state.
type W = {
  defs: SymbolDef[];
  refs: SymbolRef[];
  types: TypeAt[];
  lNames: string[];            // flat scope stack of visible locals: name, def id, HIR type
  lIds: usize[];
  lTys: Option<Type>[];
  marks: usize[];
  tps: string[];               // type parameters in scope
  unit: usize;
  fn: Option<usize>;           // enclosing function def
  hl: string[];                // HIR local names of the current function ...
  hlTy: Type[];                // ... and their types
  hk: usize;                   // cursor into hl
};

function emptyTab(): UnitTab {
  const s: string[] = [];
  const d: usize[] = [];
  return UnitTab {
    tNames: s, tDefs: d, vNames: s, vDefs: d, xtNames: s, xtDefs: d, xvNames: s, xvDefs: d, itemDefs: d
  };
}

function findName(names: string[], defs: usize[], name: string): Option<usize> {
  let i: usize = 0;
  while (i < names.length) {
    if (names[i] == name) {
      return Some(defs[i]);
    }
    i += 1;
  }
  return None;
}

// ---- rendering --------------------------------------------------------------------------------

function renderTE(t: TypeExpr): string {
  return match (t.kind) {
    TNamed(id, args) => {
      if (args.length == 0) {
        return id.name;
      }
      let parts: string[] = [];
      for (const a of args) {
        parts.push(renderTE(a));
      }
      return id.name + "<" + parts.join(", ") + ">";
    },
    TArray(e) => {
      const inner = renderTE(e);
      return match (e.kind) {
        TFn(_, _) => "(" + inner + ")[]",
        _ => inner + "[]"
      };
    },
    TFn(ps, ret) => {
      let parts: string[] = [];
      for (const p of ps) {
        parts.push(p.name.name + ": " + renderTE(p.ty));
      }
      return "(" + parts.join(", ") + ") => " + renderTE(ret);
    }
  };
}

function tpList(ps: Ident[]): string {
  if (ps.length == 0) {
    return "";
  }
  let parts: string[] = [];
  for (const p of ps) {
    parts.push(p.name);
  }
  return "<" + parts.join(", ") + ">";
}

function funcDetail(f: FunctionDecl): string {
  let ps: string[] = [];
  for (const p of f.params) {
    ps.push(p.name.name + ": " + renderTE(p.ty));
  }
  let s = "function " + f.name.name + tpList(f.typeParams) + "(" + ps.join(", ") + ")";
  match (f.ret) {
    Some(t) => { s += ": " + renderTE(t); },
    None => {}
  }
  return s;
}

// "users/user.User<int,string>" -> "User<int,string>"
function shortName(q: string): string {
  let end = q.length;
  const lt = q.indexOf("<");
  if (lt.isSome()) {
    end = lt.unwrap();
  }
  let start: usize = 0;
  let i: usize = 0;
  while (i < end) {
    if (q.charCodeAt(i) == 46) {
      start = i + 1;
    }
    i += 1;
  }
  return q.substring(start, q.length);
}

function renderTy(p: Program, t: Type): string {
  return match (t) {
    TyInt => "int",
    TyUsize => "usize",
    TyBool => "bool",
    TyString => "string",
    TyVoid => "void",
    TyArray(e) => renderTy(p, e) + "[]",
    TyOption(e) => "Option<" + renderTy(p, e) + ">",
    TyResult(a, b) => "Result<" + renderTy(p, a) + ", " + renderTy(p, b) + ">",
    TyRecord(r) => r < p.records.length ? shortName(p.records[r].name) : "?",
    TyUnion(u) => u < p.unions.length ? shortName(p.unions[u].name) : "?",
    TyFn(ps, r) => {
      let parts: string[] = [];
      for (const t of ps) {
        parts.push(renderTy(p, t));
      }
      return "(" + parts.join(", ") + ") => " + renderTy(p, r);
    }
  };
}

// ---- state helpers ------------------------------------------------------------------------------

function addDef(w: W, name: string, kind: SymbolKind, nameSpan: Span, declSpan: Span, container: Option<usize>,
    exported: bool, detail: string): W {
  let x = w;
  const id = x.defs.length;
  x.defs.push(SymbolDef {
    id: id, name: name, kind: kind, nameSpan: nameSpan, declSpan: declSpan, unit: x.unit,
    container: container, exported: exported, detail: detail
  });
  return x;
}

function addRef(w: W, sp: Span, def: usize): W {
  let x = w;
  x.refs.push(SymbolRef { span: sp, def: def });
  return x;
}

function pushScope(w: W): W {
  let x = w;
  x.marks.push(x.lNames.length);
  return x;
}

function popScope(w: W): W {
  let x = w;
  const m = x.marks.pop();
  const k = m.unwrapOr(0);
  while (x.lNames.length > k) {
    x.lNames.pop();
    x.lIds.pop();
    x.lTys.pop();
  }
  return x;
}

function lookupLocal(w: W, name: string): Option<usize> {
  let i = w.lNames.length;
  while (i > 0) {
    i -= 1;
    if (w.lNames[i] == name) {
      return Some(i);
    }
  }
  return None;
}

function children(defs: SymbolDef[], parent: usize): usize[] {
  let out: usize[] = [];
  let i = parent + 1;
  while (i < defs.length) {
    const hit = match (defs[i].container) {
      Some(c) => c == parent,
      None => false
    };
    if (!hit) {
      break;
    }
    out.push(i);
    i += 1;
  }
  return out;
}

function fieldDef(w: W, rec: usize, name: string): Option<usize> {
  for (const k of children(w.defs, rec)) {
    if (w.defs[k].name == name) {
      return Some(k);
    }
  }
  return None;
}

// Declares a local or parameter: new def, scope entry, and its HIR type (matched by name along
// the HIR locals of the current function, which the checker allocates in declaration order).
function declare(w: W, c: Ctx, id: Ident, declSpan: Span, kind: SymbolKind, label: string, annot: Option<TypeExpr>): W {
  let x = w;
  let ty: Option<Type> = None;
  let k = x.hk;
  while (k < x.hl.length) {
    if (x.hl[k] == id.name) {
      ty = Some(x.hlTy[k]);
      x.hk = k + 1;
      break;
    }
    k += 1;
  }
  let text = "";
  match (annot) {
    Some(t) => { text = renderTE(t); },
    None => {
      match (ty) {
        Some(t) => {
          match (c.hir) {
            Some(p) => { text = renderTy(p, t); },
            None => {}
          }
        },
        None => {}
      }
    }
  }
  let detail = label + " " + id.name;
  if (text.length > 0) {
    detail += ": " + text;
  }
  const did = x.defs.length;
  x = addDef(x, id.name, kind, id.span, declSpan, x.fn, false, detail);
  x.lNames.push(id.name);
  x.lIds.push(did);
  x.lTys.push(ty);
  return x;
}

function isTypeParam(w: W, name: string): bool {
  for (const t of w.tps) {
    if (t == name) {
      return true;
    }
  }
  return false;
}

// ---- pass 1: declarations, imports, exports ------------------------------------------------------

function addT(t: UnitTab, name: string, def: usize, exported: bool): UnitTab {
  let x = t;
  x.tNames.push(name);
  x.tDefs.push(def);
  if (exported) {
    x.xtNames.push(name);
    x.xtDefs.push(def);
  }
  return x;
}

function addV(t: UnitTab, name: string, def: usize, exported: bool): UnitTab {
  let x = t;
  x.vNames.push(name);
  x.vDefs.push(def);
  if (exported) {
    x.xvNames.push(name);
    x.xvDefs.push(def);
  }
  return x;
}

type P1 = { w: W; tab: UnitTab; tq: string[]; tqDefs: usize[]; };

function constDetail(k: ConstDecl): string {
  let ty = "";
  match (k.ty) {
    Some(t) => { ty = renderTE(t); },
    None => {
      ty = match (k.value.kind) {
        EInt(_) => "int",
        EStr(_) => "string",
        EBool(_) => "bool",
        _ => ""
      };
    }
  }
  return ty.length > 0 ? "const " + k.name.name + ": " + ty : "const " + k.name.name;
}

function declareType(p: P1, unitName: string, t: TypeDecl): P1 {
  let w = p.w;
  let tab = p.tab;
  let tq = p.tq;
  let tqDefs = p.tqDefs;
  const id = w.defs.length;
  const head = "type " + t.name.name + tpList(t.typeParams);
  match (t.body) {
    DAlias(te) => {
      w = addDef(w, t.name.name, SkAlias, t.name.span, t.span, None, t.exported, head + " = " + renderTE(te));
    },
    DRecord(fs) => {
      let parts: string[] = [];
      for (const f of fs) {
        parts.push(f.name.name + ": " + renderTE(f.ty));
      }
      w = addDef(w, t.name.name, SkRecord, t.name.span, t.span, None, t.exported,
        head + " = { " + parts.join("; ") + " }");
      for (const f of fs) {
        w = addDef(w, f.name.name, SkField, f.name.span, f.span, Some(id), t.exported,
          f.name.name + ": " + renderTE(f.ty));
      }
    },
    DUnion(vs) => {
      let parts: string[] = [];
      for (const v of vs) {
        parts.push(variantText(v.name.name, v.payload));
      }
      w = addDef(w, t.name.name, SkUnion, t.name.span, t.span, None, t.exported,
        head + " = " + parts.join(" | "));
      for (const v of vs) {
        w = addDef(w, v.name.name, SkVariant, v.name.span, v.span, Some(id), t.exported,
          variantText(v.name.name, v.payload) + ": " + t.name.name + tpList(t.typeParams));
      }
    }
  }
  tab = addT(tab, t.name.name, id, t.exported);
  tq.push(unitName + "." + t.name.name);
  tqDefs.push(id);
  match (t.body) {
    DUnion(vs) => {
      let k: usize = 0;
      for (const v of vs) {
        k += 1;
        tab = addV(tab, v.name.name, id + k, t.exported);
      }
    },
    _ => {}
  }
  return P1 { w: w, tab: tab, tq: tq, tqDefs: tqDefs };
}

// Classes (ADR-0009): the class is an SkRecord def ("class C"), followed by its fields (parameter
// properties first, then declared fields; SkField) and then the constructor / methods in member
// order (SkFunction, container = the class).
function classFieldCount(c: ClassDecl): usize {
  let n: usize = 0;
  for (const m of c.members) {
    match (m) {
      MField(_) => { n += 1; },
      MCtor(k) => {
        for (const p of k.params) {
          if (p.access > 0) {
            n += 1;
          }
        }
      },
      MMethod(_) => {}
    }
  }
  return n;
}

function paramsText(ps: Param[]): string {
  let parts: string[] = [];
  for (const p of ps) {
    parts.push(p.name.name + ": " + renderTE(p.ty));
  }
  return parts.join(", ");
}

// Inferred mutability of a method (ADR-0009): the lowered HIR function of an instance method
// returns the updated receiver (declared `void`) or a `$ret` record.
function methodMutating(hir: Option<Program>, qname: string, declRet: Option<TypeExpr>): bool {
  match (hir) {
    Some(h) => {
      for (const f of h.functions) {
        if (f.name == qname && f.paramCount > 0 && f.locals[0].name == "this$") {
          match (f.ret) {
            TyVoid => { return false; },
            TyRecord(r) => {
              if (h.records[r].name.endsWith("$ret")) {
                return true;
              }
              const isVoidDecl = match (declRet) {
                None => true,
                Some(t) => match (t.kind) {
                  TNamed(id, _) => id.name == "void",
                  _ => false
                }
              };
              return isVoidDecl;
            },
            _ => { return false; }
          }
        }
      }
    },
    None => {}
  }
  return false;
}

function declareClass(p: P1, unitName: string, c: ClassDecl, hir: Option<Program>): P1 {
  let w = p.w;
  let tab = p.tab;
  let tq = p.tq;
  let tqDefs = p.tqDefs;
  const id = w.defs.length;
  w = addDef(w, c.name.name, SkRecord, c.name.span, c.span, None, c.exported, "class " + c.name.name);
  for (const m of c.members) {
    match (m) {
      MCtor(k) => {
        for (const cp of k.params) {
          if (cp.access > 0) {
            w = addDef(w, cp.name.name, SkField, cp.name.span, cp.span, Some(id), c.exported,
              (cp.access == 2 ? "private " : "") + cp.name.name + ": " + renderTE(cp.ty));
          }
        }
      },
      _ => {}
    }
  }
  for (const m of c.members) {
    match (m) {
      MField(f) => {
        w = addDef(w, f.name.name, SkField, f.name.span, f.span, Some(id), c.exported,
          (f.priv ? "private " : "") + f.name.name + ": " + renderTE(f.ty));
      },
      _ => {}
    }
  }
  for (const m of c.members) {
    match (m) {
      MCtor(k) => {
        const nsp = Span { file: k.span.file, start: k.span.start, end: k.span.start + 11 };
        let ps: string[] = [];
        for (const cp of k.params) {
          ps.push(cp.name.name + ": " + renderTE(cp.ty));
        }
        w = addDef(w, "constructor", SkFunction, nsp, k.span, Some(id), c.exported,
          "constructor(" + ps.join(", ") + ")");
      },
      MMethod(md) => {
        const mutating = !md.isStatic && methodMutating(hir, unitName + "." + c.name.name + "." + md.name.name, md.ret);
        let d = (md.priv ? "private " : "") + (md.isStatic ? "static " : "") + (mutating ? "mut method " : "method ")
          + md.name.name + "(" + paramsText(md.params) + ")";
        match (md.ret) {
          Some(t) => { d += ": " + renderTE(t); },
          None => {}
        }
        w = addDef(w, md.name.name, SkFunction, md.name.span, md.span, Some(id), c.exported, d);
      },
      MField(_) => {}
    }
  }
  tab = addT(tab, c.name.name, id, c.exported);
  tq.push(unitName + "." + c.name.name);
  tqDefs.push(id);
  return P1 { w: w, tab: tab, tq: tq, tqDefs: tqDefs };
}

function variantText(name: string, payload: TypeExpr[]): string {
  if (payload.length == 0) {
    return name;
  }
  let parts: string[] = [];
  for (const t of payload) {
    parts.push(renderTE(t));
  }
  return name + "(" + parts.join(", ") + ")";
}

function importOf(item: Item): Option<ImportDeclRe> {
  return match (item) {
    IImport(d) => Some(ImportDeclRe { names: d.names, reexport: false }),
    IReExport(d) => Some(ImportDeclRe { names: d.names, reexport: true }),
    _ => None
  };
}

type ImportDeclRe = { names: Ident[]; reexport: bool; };

function isUnionDef(w: W, d: usize): bool {
  return match (w.defs[d].kind) {
    SkUnion => true,
    _ => false
  };
}

function resolveImports(p: P1, unit: usize, prog: LoadedProgram, tabs: UnitTab[]): P1 {
  let w = p.w;
  let tab = p.tab;
  const u = prog.units[unit];
  let imp: usize = 0;
  for (const item of u.ast.items) {
    const io = importOf(item);
    if (io.isNone()) {
      continue;
    }
    const d = io.unwrap();
    const target: ImportTarget = u.imports[imp];
    imp += 1;
    match (target) {
      ImportUnit(j) => {
        if (j >= tabs.length) {
          continue;
        }
        const src = tabs[j];
        for (const n of d.names) {
          const td = findName(src.xtNames, src.xtDefs, n.name);
          const vd = findName(src.xvNames, src.xvDefs, n.name);
          if (td.isSome()) {
            w = addRef(w, n.span, td.unwrap());
          } else if (vd.isSome()) {
            w = addRef(w, n.span, vd.unwrap());
          }
          if (td.isSome()) {
            tab = addT(tab, n.name, td.unwrap(), d.reexport);
            if (d.reexport) {
              // addT already exported; the scope must not gain it.
              tab = dropScopeT(tab);
            }
            if (isUnionDef(w, td.unwrap())) {
              for (const k of children(w.defs, td.unwrap())) {
                tab = addV(tab, w.defs[k].name, k, d.reexport);
                if (d.reexport) {
                  tab = dropScopeV(tab);
                }
              }
            }
          }
          if (vd.isSome()) {
            tab = addV(tab, n.name, vd.unwrap(), d.reexport);
            if (d.reexport) {
              tab = dropScopeV(tab);
            }
          }
        }
      },
      ImportStd(_) => {}
    }
  }
  return P1 { w: w, tab: tab, tq: p.tq, tqDefs: p.tqDefs };
}

// A re-export adds to the exports only: undo the scope entry that `addT` / `addV` made last.
function dropScopeT(t: UnitTab): UnitTab {
  let x = t;
  x.tNames.pop();
  x.tDefs.pop();
  return x;
}

function dropScopeV(t: UnitTab): UnitTab {
  let x = t;
  x.vNames.pop();
  x.vDefs.pop();
  return x;
}

function newW(): W {
  const d: SymbolDef[] = [];
  const r: SymbolRef[] = [];
  const t: TypeAt[] = [];
  const s: string[] = [];
  const ids: usize[] = [];
  const tys: Option<Type>[] = [];
  const tt: Type[] = [];
  return W {
    defs: d, refs: r, types: t, lNames: s, lIds: ids, lTys: tys, marks: ids, tps: s, unit: 0, fn: None,
    hl: s, hlTy: tt, hk: 0
  };
}

// ---- pass 2: bodies ---------------------------------------------------------------------------------

function lookupVal(w: W, c: Ctx, name: string): Option<usize> {
  const t = c.tabs[w.unit];
  return findName(t.vNames, t.vDefs, name);
}

function lookupType(w: W, c: Ctx, name: string): Option<usize> {
  const t = c.tabs[w.unit];
  return findName(t.tNames, t.tDefs, name);
}

function typeRefs(w: W, c: Ctx, te: TypeExpr): W {
  let x = w;
  match (te.kind) {
    TNamed(id, args) => {
      if (!isTypeParam(x, id.name)) {
        const d = lookupType(x, c, id.name);
        if (d.isSome()) {
          x = addRef(x, id.span, d.unwrap());
        }
      }
      for (const a of args) {
        x = typeRefs(x, c, a);
      }
    },
    TArray(e) => { x = typeRefs(x, c, e); },
    TFn(ps, ret) => {
      for (const p of ps) {
        x = typeRefs(x, c, p.ty);
      }
      x = typeRefs(x, c, ret);
    }
  }
  return x;
}

function optTypeRefs(w: W, c: Ctx, t: Option<TypeExpr>): W {
  return match (t) {
    Some(te) => typeRefs(w, c, te),
    None => w
  };
}

function walkExprs(w: W, c: Ctx, es: Expr[]): W {
  let x = w;
  for (const e of es) {
    x = walkExpr(x, c, e);
  }
  return x;
}

function walkRecordInits(w: W, c: Ctx, tname: Ident, spread: Option<Expr>, fields: FieldInit[]): W {
  let x = w;
  const td = lookupType(x, c, tname.name);
  let rec: Option<usize> = None;
  if (td.isSome()) {
    x = addRef(x, tname.span, td.unwrap());
    const isRec = match (x.defs[td.unwrap()].kind) {
      SkRecord => true,
      _ => false
    };
    if (isRec) {
      rec = td;
    }
  }
  match (spread) {
    Some(s) => { x = walkExpr(x, c, s); },
    None => {}
  }
  for (const f of fields) {
    if (rec.isSome()) {
      const fd = fieldDef(x, rec.unwrap(), f.name.name);
      if (fd.isSome()) {
        x = addRef(x, f.name.span, fd.unwrap());
      }
    }
    x = walkExpr(x, c, f.value);
  }
  return x;
}

function walkExpr(w: W, c: Ctx, e: Expr): W {
  let x = w;
  match (e.kind) {
    EIdent(id) => {
      const lo = lookupLocal(x, id.name);
      if (lo.isSome()) {
        x = addRef(x, id.span, x.lIds[lo.unwrap()]);
      } else {
        const d = lookupVal(x, c, id.name);
        if (d.isSome()) {
          x = addRef(x, id.span, d.unwrap());
        }
      }
    },
    EUnary(_, a) => { x = walkExpr(x, c, a); },
    EBinary(_, a, b) => {
      x = walkExpr(x, c, a);
      x = walkExpr(x, c, b);
    },
    ECall(f, args) => {
      x = walkExpr(x, c, f);
      x = walkExprs(x, c, args);
    },
    EMember(b, _) => {
      // `C.m(..)`: a class name used as a receiver refers to the class.
      match (b.kind) {
        EIdent(bid) => {
          if (lookupLocal(x, bid.name).isNone() && lookupVal(x, c, bid.name).isNone()) {
            const td = lookupType(x, c, bid.name);
            if (td.isSome()) {
              x = addRef(x, bid.span, td.unwrap());
            }
          }
        },
        _ => {}
      }
      x = walkExpr(x, c, b);
    },
    ENew(id, targs, args) => {
      const td = lookupType(x, c, id.name);
      if (td.isSome()) {
        x = addRef(x, id.span, td.unwrap());
      }
      for (const t of targs) {
        x = typeRefs(x, c, t);
      }
      x = walkExprs(x, c, args);
    },
    EIndex(a, b) => {
      x = walkExpr(x, c, a);
      x = walkExpr(x, c, b);
    },
    ETry(a) => { x = walkExpr(x, c, a); },
    ECond(a, b, d) => {
      x = walkExpr(x, c, a);
      x = walkExpr(x, c, b);
      x = walkExpr(x, c, d);
    },
    EArray(es) => { x = walkExprs(x, c, es); },
    ERecord(tn, sp, fs) => { x = walkRecordInits(x, c, tn, sp, fs); },
    ETyApp(id, targs) => {
      const d = lookupVal(x, c, id.name);
      if (d.isSome()) {
        x = addRef(x, id.span, d.unwrap());
      }
      for (const t of targs) {
        x = typeRefs(x, c, t);
      }
    },
    ERecordT(tn, targs, sp, fs) => {
      for (const t of targs) {
        x = typeRefs(x, c, t);
      }
      x = walkRecordInits(x, c, tn, sp, fs);
    },
    EMatch(s, arms) => {
      x = walkExpr(x, c, s);
      for (const a of arms) {
        x = walkArm(x, c, a);
      }
    },
    EArrow(ps, rte, body) => {
      // The arrow's parameters and locals belong to a lifted HIR function, not to the enclosing one:
      // walk it with its own (empty) HIR local table so the enclosing function's cursor is untouched.
      const sHl = x.hl;
      const sTy = x.hlTy;
      const sK = x.hk;
      const noNames: string[] = [];
      const noTys: Type[] = [];
      x.hl = noNames;
      x.hlTy = noTys;
      x.hk = 0;
      x = pushScope(x);
      for (const p of ps) {
        x = optTypeRefs(x, c, p.ty);
        x = declare(x, c, p.name, p.span, SkParam, "(parameter)", p.ty);
      }
      x = optTypeRefs(x, c, rte);
      match (body) {
        AExpr(b) => { x = walkExpr(x, c, b); },
        ABlock(b) => { x = walkBlock(x, c, b); }
      }
      x = popScope(x);
      x.hl = sHl;
      x.hlTy = sTy;
      x.hk = sK;
    },
    _ => {}
  }
  return x;
}

function walkArm(w: W, c: Ctx, a: MatchArm): W {
  let x = pushScope(w);
  x = walkPattern(x, c, a.pattern, false);
  match (a.body) {
    BExpr(e) => { x = walkExpr(x, c, e); },
    BBlock(b) => { x = walkBlock(x, c, b); }
  }
  return popScope(x);
}

// `nested`: a sub-pattern of a variant pattern, where an identifier is always a binding.
function walkPattern(w: W, c: Ctx, p: Pattern, nested: bool): W {
  let x = w;
  match (p.kind) {
    PIdent(id) => {
      if (nested) {
        x = declare(x, c, id, p.span, SkLocal, "const", None);
      } else {
        const d = lookupVal(x, c, id.name);
        if (d.isSome()) {
          x = addRef(x, id.span, d.unwrap());
        }
      }
    },
    PVariant(id, subs) => {
      const d = lookupVal(x, c, id.name);
      if (d.isSome()) {
        x = addRef(x, id.span, d.unwrap());
      }
      for (const s of subs) {
        x = walkPattern(x, c, s, true);
      }
    },
    _ => {}
  }
  return x;
}

function walkBlock(w: W, c: Ctx, b: Block): W {
  let x = pushScope(w);
  for (const s of b.stmts) {
    x = walkStmt(x, c, s);
  }
  return popScope(x);
}

type TyW = { w: W; ty: Option<Type>; };

// Resolves the fields of an assignment target (`p.x`, `a.b[i].c`) through the declared types of
// locals, recording a field reference for each; returns the type of the place.
function placeFields(w: W, c: Ctx, e: Expr): TyW {
  let x = w;
  return match (e.kind) {
    EIdent(id) => {
      const lo = lookupLocal(x, id.name);
      if (lo.isSome()) {
        return TyW { w: x, ty: x.lTys[lo.unwrap()] };
      }
      return TyW { w: x, ty: None };
    },
    EThis => {
      // The lowered `this` local of the enclosing method / constructor.
      let k: usize = 0;
      while (k < x.hl.length) {
        if (x.hl[k] == "this") {
          return TyW { w: x, ty: Some(x.hlTy[k]) };
        }
        k += 1;
      }
      return TyW { w: x, ty: None };
    },
    EMember(b, name) => {
      const r = placeFields(x, c, b);
      x = r.w;
      match (r.ty) {
        Some(t) => {
          match (t) {
            TyRecord(rid) => {
              match (c.hir) {
                Some(p) => {
                  if (rid < p.records.length && rid < c.recDef.length) {
                    for (const f of p.records[rid].fields) {
                      if (f.name == name.name) {
                        match (c.recDef[rid]) {
                          Some(rd) => {
                            const fd = fieldDef(x, rd, name.name);
                            if (fd.isSome()) {
                              x = addRef(x, name.span, fd.unwrap());
                            }
                          },
                          None => {}
                        }
                        return TyW { w: x, ty: Some(f.ty) };
                      }
                    }
                  }
                },
                None => {}
              }
            },
            _ => {}
          }
        },
        None => {}
      }
      return TyW { w: x, ty: None };
    },
    EIndex(b, _) => {
      const r = placeFields(x, c, b);
      match (r.ty) {
        Some(t) => {
          match (t) {
            TyArray(el) => { return TyW { w: r.w, ty: Some(el) }; },
            _ => {}
          }
        },
        None => {}
      }
      return TyW { w: r.w, ty: None };
    },
    _ => TyW { w: x, ty: None }
  };
}

function walkStmt(w: W, c: Ctx, s: Stmt): W {
  let x = w;
  match (s.kind) {
    SLet(mutable, name, ty, init) => {
      x = optTypeRefs(x, c, ty);
      x = walkExpr(x, c, init);
      x = declare(x, c, name, s.span, SkLocal, mutable ? "let" : "const", ty);
    },
    SAssign(t, _, v) => {
      x = walkExpr(x, c, t);
      x = walkExpr(x, c, v);
      const r = placeFields(x, c, t);
      x = r.w;
    },
    SExpr(e) => { x = walkExpr(x, c, e); },
    SReturn(o) => {
      match (o) {
        Some(e) => { x = walkExpr(x, c, e); },
        None => {}
      }
    },
    SIf(cond, b, els) => {
      x = walkExpr(x, c, cond);
      x = walkBlock(x, c, b);
      match (els) {
        Some(st) => { x = walkStmt(x, c, st); },
        None => {}
      }
    },
    SWhile(cond, b) => {
      x = walkExpr(x, c, cond);
      x = walkBlock(x, c, b);
    },
    SForOf(id, it, b) => {
      x = walkExpr(x, c, it);
      x = pushScope(x);
      x = declare(x, c, id, id.span, SkLocal, "const", None);
      x = walkBlock(x, c, b);
      x = popScope(x);
    },
    SBlock(b) => { x = walkBlock(x, c, b); },
    _ => {}
  }
  return x;
}

// HIR local names/types of function `hf`, for `declare`.
function loadHirLocals(w: W, hf: Option<Function>): W {
  let x = w;
  let names: string[] = [];
  let tys: Type[] = [];
  match (hf) {
    Some(f) => {
      for (const l of f.locals) {
        names.push(l.name);
        tys.push(l.ty);
      }
    },
    None => {}
  }
  x.hl = names;
  x.hlTy = tys;
  x.hk = 0;
  return x;
}

function walkFunction(w: W, c: Ctx, f: FunctionDecl, fnDef: usize, hf: Option<Function>): W {
  let x = loadHirLocals(w, hf);
  x.fn = Some(fnDef);
  let tps: string[] = [];
  for (const t of f.typeParams) {
    tps.push(t.name);
  }
  x.tps = tps;
  x = pushScope(x);
  for (const p of f.params) {
    x = typeRefs(x, c, p.ty);
    x = declare(x, c, p.name, p.span, SkParam, "(parameter)", Some(p.ty));
  }
  x = optTypeRefs(x, c, f.ret);
  x = walkBlock(x, c, f.body);
  x = popScope(x);
  x.fn = None;
  const none: string[] = [];
  x.tps = none;
  return x;
}

function walkTypeDecl(w: W, c: Ctx, t: TypeDecl): W {
  let x = w;
  let tps: string[] = [];
  for (const p of t.typeParams) {
    tps.push(p.name);
  }
  x.tps = tps;
  match (t.body) {
    DAlias(te) => { x = typeRefs(x, c, te); },
    DRecord(fs) => {
      for (const f of fs) {
        x = typeRefs(x, c, f.ty);
      }
    },
    DUnion(vs) => {
      for (const v of vs) {
        for (const te of v.payload) {
          x = typeRefs(x, c, te);
        }
      }
    }
  }
  const none: string[] = [];
  x.tps = none;
  return x;
}

// ---- HIR walk: field references and expression types ----------------------------------------------

// A call of a lowered method (`unit.C.m`): reference to the method's def at the method name in the
// source text (after the receiver, or after `C.` for a static method).
function methodRef(w: W, c: Ctx, e: HExpr, fid: usize, args: HExpr[]): W {
  let x = w;
  match (c.hir) {
    Some(p) => {
      if (fid >= p.functions.length) {
        return x;
      }
      const f = p.functions[fid];
      let dot: Option<usize> = None;
      let di: usize = 0;
      while (di < f.name.length) {
        if (f.name.charCodeAt(di) == 46) {
          dot = Some(di);
        }
        di += 1;
      }
      if (dot.isNone()) {
        return x;
      }
      const mname = f.name.substring(dot.unwrap() + 1, f.name.length);
      const cname = f.name.substring(0, dot.unwrap());
      if (mname == "constructor") {
        return x;
      }
      const cd = findName(c.tq, c.tqDefs, cname);
      if (cd.isNone()) {
        return x;
      }
      let md: Option<usize> = None;
      for (const k of children(x.defs, cd.unwrap())) {
        const isFn = match (x.defs[k].kind) { SkFunction => true, _ => false };
        if (isFn && x.defs[k].name == mname && md.isNone()) {
          md = Some(k);
        }
      }
      if (md.isNone()) {
        return x;
      }
      const instance = f.paramCount > 0 && f.locals[0].name == "this$";
      const sp = e.span;
      const text = c.sm.files[sp.file].text;
      let pos = sp.start;
      if (instance) {
        if (args.length == 0) {
          return x;
        }
        pos = args[0].span.end;
      }
      while (pos < sp.end && pos < text.length && (text.charCodeAt(pos) != 46)) {
        pos += 1;
      }
      pos += 1;
      while (pos < sp.end && pos < text.length && (text.charCodeAt(pos) == 32 || text.charCodeAt(pos) == 10)) {
        pos += 1;
      }
      const end = pos + mname.length;
      if (end <= sp.end && end <= text.length && text.substring(pos, end) == mname) {
        x = addRef(x, Span { file: sp.file, start: pos, end: end }, md.unwrap());
      }
    },
    None => {}
  }
  return x;
}

function litKind(e: HExpr): bool {
  return match (e.kind) {
    XInt(_) => true,
    XBool(_) => true,
    XStr(_) => true,
    _ => false
  };
}

function hExprs(w: W, c: Ctx, es: HExpr[], ty: bool): W {
  let x = w;
  for (const e of es) {
    x = hExpr(x, c, e, ty);
  }
  return x;
}

function hBlock(w: W, c: Ctx, b: HBlock, ty: bool): W {
  let x = w;
  for (const s of b.stmts) {
    x = hStmt(x, c, s, ty);
  }
  return x;
}

function hPlace(w: W, c: Ctx, p: Place, ty: bool): W {
  let x = w;
  for (const el of p.path) {
    match (el) {
      PIndex(e) => { x = hExpr(x, c, e, ty); },
      _ => {}
    }
  }
  return x;
}

function hStmt(w: W, c: Ctx, s: HStmt, ty: bool): W {
  let x = w;
  match (s) {
    HLet(_, e) => { x = hExpr(x, c, e, ty); },
    HAssign(p, _, e) => {
      x = hPlace(x, c, p, ty);
      x = hExpr(x, c, e, ty);
    },
    HExprStmt(e) => { x = hExpr(x, c, e, ty); },
    HIf(cond, a, b) => {
      x = hExpr(x, c, cond, ty);
      x = hBlock(x, c, a, ty);
      match (b) {
        Some(blk) => { x = hBlock(x, c, blk, ty); },
        None => {}
      }
    },
    HWhile(cond, b) => {
      x = hExpr(x, c, cond, ty);
      x = hBlock(x, c, b, ty);
    },
    HForOf(_, e, b) => {
      x = hExpr(x, c, e, ty);
      x = hBlock(x, c, b, ty);
    },
    HReturn(o) => {
      match (o) {
        Some(e) => { x = hExpr(x, c, e, ty); },
        None => {}
      }
    },
    HBlockStmt(b) => { x = hBlock(x, c, b, ty); },
    _ => {}
  }
  return x;
}

function hExpr(w: W, c: Ctx, e: HExpr, ty: bool): W {
  let x = w;
  if (ty && !litKind(e)) {
    match (c.hir) {
      Some(p) => { x.types.push(TypeAt { span: e.span, ty: renderTy(p, e.ty) }); },
      None => {}
    }
  }
  match (e.kind) {
    XUnary(_, a) => { x = hExpr(x, c, a, ty); },
    XBinary(_, a, b) => {
      x = hExpr(x, c, a, ty);
      x = hExpr(x, c, b, ty);
    },
    XCall(fid, args) => {
      x = hExprs(x, c, args, ty);
      x = methodRef(x, c, e, fid, args);
    },
    XBuiltin(_, args) => { x = hExprs(x, c, args, ty); },
    XMutMethod(_, p, args) => {
      x = hPlace(x, c, p, ty);
      x = hExprs(x, c, args, ty);
    },
    XField(b, rid, fi) => {
      x = hExpr(x, c, b, ty);
      match (c.hir) {
        Some(p) => {
          if (rid < p.records.length && rid < c.recDef.length && fi < p.records[rid].fields.length) {
            const name = p.records[rid].fields[fi].name;
            const sp = e.span;
            if (sp.file < c.sm.files.length && sp.end >= name.length && sp.end - name.length >= sp.start) {
              const start = sp.end - name.length;
              const text = c.sm.files[sp.file].text;
              if (sp.end <= text.length && text.substring(start, sp.end) == name) {
                match (c.recDef[rid]) {
                  Some(rd) => {
                    const fd = fieldDef(x, rd, name);
                    if (fd.isSome()) {
                      x = addRef(x, Span { file: sp.file, start: start, end: sp.end }, fd.unwrap());
                    }
                  },
                  None => {}
                }
              }
            }
          }
        },
        None => {}
      }
    },
    XIndex(a, b) => {
      x = hExpr(x, c, a, ty);
      x = hExpr(x, c, b, ty);
    },
    XRecord(_, sp, inits) => {
      match (sp) {
        Some(s) => { x = hExpr(x, c, s, ty); },
        None => {}
      }
      for (const fi of inits) {
        x = hExpr(x, c, fi.value, ty);
      }
    },
    XVariant(_, args) => { x = hExprs(x, c, args, ty); },
    XArray(es) => { x = hExprs(x, c, es, ty); },
    XTry(a) => { x = hExpr(x, c, a, ty); },
    XCond(a, b, d) => {
      x = hExpr(x, c, a, ty);
      x = hExpr(x, c, b, ty);
      x = hExpr(x, c, d, ty);
    },
    XMatch(s, arms) => {
      x = hExpr(x, c, s, ty);
      for (const a of arms) {
        x = hBlock(x, c, a.body, ty);
        match (a.value) {
          Some(v) => { x = hExpr(x, c, v, ty); },
          None => {}
        }
      }
    },
    XClosure(_, caps) => { x = hExprs(x, c, caps, ty); },
    XCallIndirect(f, args) => {
      x = hExpr(x, c, f, ty);
      x = hExprs(x, c, args, ty);
    },
    _ => {}
  }
  return x;
}

// ---- sorting ----------------------------------------------------------------------------------------

function spanLess(a: Span, b: Span): bool {
  if (a.file != b.file) {
    return a.file < b.file;
  }
  if (a.start != b.start) {
    return a.start < b.start;
  }
  return a.end < b.end;
}

function sortRefs(xs: SymbolRef[]): SymbolRef[] {
  if (xs.length < 2) {
    return xs;
  }
  const mid = xs.length / 2;
  const l = sortRefs(xs.slice(0, mid));
  const r = sortRefs(xs.slice(mid, xs.length));
  let out: SymbolRef[] = [];
  let i: usize = 0;
  let j: usize = 0;
  while (i < l.length && j < r.length) {
    if (spanLess(r[j].span, l[i].span)) {
      out.push(r[j]);
      j += 1;
    } else {
      out.push(l[i]);
      i += 1;
    }
  }
  while (i < l.length) {
    out.push(l[i]);
    i += 1;
  }
  while (j < r.length) {
    out.push(r[j]);
    j += 1;
  }
  return out;
}

function sortTypes(xs: TypeAt[]): TypeAt[] {
  if (xs.length < 2) {
    return xs;
  }
  const mid = xs.length / 2;
  const l = sortTypes(xs.slice(0, mid));
  const r = sortTypes(xs.slice(mid, xs.length));
  let out: TypeAt[] = [];
  let i: usize = 0;
  let j: usize = 0;
  while (i < l.length && j < r.length) {
    if (spanLess(r[j].span, l[i].span)) {
      out.push(r[j]);
      j += 1;
    } else {
      out.push(l[i]);
      i += 1;
    }
  }
  while (i < l.length) {
    out.push(l[i]);
    i += 1;
  }
  while (j < r.length) {
    out.push(r[j]);
    j += 1;
  }
  return out;
}

function sameSpan(a: Span, b: Span): bool {
  return a.file == b.file && a.start == b.start && a.end == b.end;
}

function dedupRefs(xs: SymbolRef[]): SymbolRef[] {
  let out: SymbolRef[] = [];
  for (const r of xs) {
    if (out.length > 0 && sameSpan(out[out.length - 1].span, r.span) && out[out.length - 1].def == r.def) {
      continue;
    }
    out.push(r);
  }
  return out;
}

function dedupTypes(xs: TypeAt[]): TypeAt[] {
  let out: TypeAt[] = [];
  for (const t of xs) {
    if (out.length > 0 && sameSpan(out[out.length - 1].span, t.span)) {
      continue;
    }
    out.push(t);
  }
  return out;
}

// ---- driver -------------------------------------------------------------------------------------------

export function buildIndex(prog: LoadedProgram, sm: SourceMap, hir: Option<Program>): SemanticIndex {
  // Pass 1: top-level definitions, imports and exports, units in loader order.
  let w = newW();
  let tabs: UnitTab[] = [];
  let tq: string[] = [];
  let tqDefs: usize[] = [];
  let ui: usize = 0;
  for (const u of prog.units) {
    w.unit = ui;
    let tab = emptyTab();
    let itemDefs: usize[] = [];
    let p = P1 { w: w, tab: tab, tq: tq, tqDefs: tqDefs };
    for (const item of u.ast.items) {
      let did: usize = 0;
      match (item) {
        IFunction(f) => {
          did = p.w.defs.length;
          p.w = addDef(p.w, f.name.name, SkFunction, f.name.span, f.span, None, f.exported, funcDetail(f));
          p.tab = addV(p.tab, f.name.name, did, f.exported);
        },
        IConst(k) => {
          did = p.w.defs.length;
          p.w = addDef(p.w, k.name.name, SkConst, k.name.span, k.span, None, k.exported, constDetail(k));
          p.tab = addV(p.tab, k.name.name, did, k.exported);
        },
        IType(t) => {
          did = p.w.defs.length;
          p = declareType(p, u.name, t);
        },
        IClass(cd) => {
          did = p.w.defs.length;
          p = declareClass(p, u.name, cd, hir);
        },
        _ => {}
      }
      itemDefs.push(did);
    }
    p = resolveImports(p, ui, prog, tabs);
    p.tab.itemDefs = itemDefs;
    w = p.w;
    tabs.push(p.tab);
    tq = p.tq;
    tqDefs = p.tqDefs;
    ui += 1;
  }
  // HIR record id -> SkRecord def (generic instances map to their generic declaration).
  let recDef: Option<usize>[] = [];
  match (hir) {
    Some(h) => {
      for (const r of h.records) {
        let base = r.name;
        const lt = base.indexOf("<");
        if (lt.isSome()) {
          base = base.substring(0, lt.unwrap());
        }
        recDef.push(findName(tq, tqDefs, base));
      }
    },
    None => {}
  }
  const c = Ctx { prog: prog, sm: sm, tabs: tabs, hir: hir, recDef: recDef, tq: tq, tqDefs: tqDefs };
  // Pass 2: bodies.
  let hn: usize = 0;     // next ordinary (non-generic) HIR function
  ui = 0;
  for (const u of prog.units) {
    w.unit = ui;
    let k: usize = 0;
    for (const item of u.ast.items) {
      const did = tabs[ui].itemDefs[k];
      k += 1;
      match (item) {
        IFunction(f) => {
          let hf: Option<Function> = None;
          if (f.typeParams.length == 0) {
            match (hir) {
              Some(h) => {
                if (hn < h.functions.length && h.functions[hn].name == u.name + "." + f.name.name) {
                  hf = Some(h.functions[hn]);
                  w = hBlock(w, c, h.functions[hn].body, true);
                }
              },
              None => {}
            }
            hn += 1;
          }
          w = walkFunction(w, c, f, did, hf);
        },
        IConst(kd) => {
          const none: string[] = [];
          w.tps = none;
          w = optTypeRefs(w, c, kd.ty);
          w = walkExpr(w, c, kd.value);
        },
        IType(t) => { w = walkTypeDecl(w, c, t); },
        IClass(cd) => {
          // HIR functions of a class: the constructor, then the methods in member order.
          let ctorHf: Option<Function> = None;
          let explicitCtor = false;
          match (hir) {
            Some(h) => {
              if (hn < h.functions.length && h.functions[hn].name == u.name + "." + cd.name.name + ".constructor") {
                ctorHf = Some(h.functions[hn]);
              }
            },
            None => {}
          }
          hn += 1;
          for (const m of cd.members) {
            match (m) {
              MCtor(_) => { explicitCtor = true; },
              _ => {}
            }
          }
          let dk = did + 1 + classFieldCount(cd);
          const none: string[] = [];
          w.tps = none;
          for (const m of cd.members) {
            match (m) {
              MField(f) => {
                w = typeRefs(w, c, f.ty);
                match (f.init) {
                  Some(ie) => { w = walkExpr(w, c, ie); },
                  None => {}
                }
              },
              MCtor(k) => {
                let ps: Param[] = [];
                for (const cp of k.params) {
                  w = typeRefs(w, c, cp.ty);
                  ps.push(Param { name: cp.name, ty: cp.ty, span: cp.span });
                }
                const fd = FunctionDecl {
                  exported: false, name: cd.name, typeParams: [], params: ps,
                  ret: None, body: k.body, span: k.span
                };
                match (ctorHf) {
                  Some(hf) => { w = hBlock(w, c, hf.body, true); },
                  None => {}
                }
                w = walkFunction(w, c, fd, dk, ctorHf);
                dk += 1;
              },
              MMethod(md) => {
                let hf: Option<Function> = None;
                match (hir) {
                  Some(h) => {
                    if (hn < h.functions.length && h.functions[hn].name == u.name + "." + cd.name.name + "." + md.name.name) {
                      hf = Some(h.functions[hn]);
                      w = hBlock(w, c, h.functions[hn].body, true);
                    }
                  },
                  None => {}
                }
                hn += 1;
                const fd = FunctionDecl {
                  exported: false, name: md.name, typeParams: [], params: md.params, ret: md.ret, body: md.body,
                  span: md.span
                };
                w = walkFunction(w, c, fd, dk, hf);
                dk += 1;
              }
            }
          }
          if (!explicitCtor) {
            match (ctorHf) {
              Some(hf) => { w = hBlock(w, c, hf.body, false); },
              None => {}
            }
          }
        },
        _ => {}
      }
    }
    ui += 1;
  }
  // Generic function instances (after the ordinary functions): field references only.
  match (hir) {
    Some(h) => {
      while (hn < h.functions.length) {
        // Lifted closure bodies (arrow functions, ADR-0011) also contribute expression types.
        w = hBlock(w, c, h.functions[hn].body, h.functions[hn].name.includes("$closure"));
        hn += 1;
      }
    },
    None => {}
  }
  return SemanticIndex {
    defs: w.defs,
    refs: dedupRefs(sortRefs(w.refs)),
    types: dedupTypes(sortTypes(w.types))
  };
}
