// Match patterns. Port of `FnCx::pattern` from bootstrap/src/checker/mod.rs.

import { Span, Diagnostic, diag } from "../diag";
import { Ident, Pattern, PWildcard, PIdent, PVariant, PInt, PStr, PBool } from "../syntax";
import { Type, VariantDef, HPattern, intKindOf, kindNarrow, kindSigned, kindLo, kindHi } from "../hir";
import { Env, showType, mismatch, isIntish, isString, isBool, isVoid } from "./env";
import { FnCtx } from "./fnctx";

export type PatOut = { fx: FnCtx; pat: HPattern; covered: bool[]; wild: bool; };

function findVariant(vs: VariantDef[], name: string): Option<usize> {
  let i: usize = 0;
  for (const v of vs) {
    if (v.name == name) {
      return Some(i);
    }
    i += 1;
  }
  return None;
}

function markCovered(covered: bool[], idx: usize): bool[] {
  let c = covered;
  c[idx] = true;
  return c;
}

// Literal pattern of the wrong type: E0402 on a variant scrutinee, else E0400.
function literalMismatch(env: Env, sp: Span, sty: Type, found: Type, isVariantScrut: bool): Diagnostic {
  if (isVariantScrut) {
    return diag("E0402", sp, "literal pattern on a variant scrutinee");
  }
  return mismatch(env, sp, sty, found);
}

// The variant name of a pattern name: `Circle`, or `Circle` for `shapes.Circle` (a namespace-qualified variant, ADR-0048 addendum).
function memberName(n: string): string {
  const at = n.indexOf(".");
  return at.isSome() ? n.substring(at.unwrap() + 1, n.length) : n;
}

export function checkPattern(
  env: Env,
  fx: FnCtx,
  p: Pattern,
  sty: Type,
  variants: Option<VariantDef[]>,
  covered: bool[],
  wild: bool
): Result<PatOut, Diagnostic> {
  const isVariantScrut = variants.isSome();
  return match (p.kind) {
    PWildcard => Ok(PatOut { fx: fx, pat: HPWildcard, covered: covered, wild: true }),
    PIdent(id) => {
      if (!isVariantScrut) {
        return Err(diag("E0402", p.span, "variant pattern used on a scalar scrutinee"));
      }
      const vs = variants.unwrap();
      const idxo = findVariant(vs, memberName(id.name));
      if (idxo.isNone()) {
        return Err(diag("E0405", id.span, "`" + id.name + "` is not a variant of `" + showType(fx.env, sty) + "`"));
      }
      const idx = idxo.unwrap();
      if (vs[idx].payload.length > 0) {
        return Err(diag(
          "E0402",
          p.span,
          "variant `" + id.name + "` has " + vs[idx].payload.length.toString() + " field(s); pattern binds none"
        ));
      }
      const none: Option<usize>[] = [];
      return Ok(PatOut { fx: fx, pat: HPVariant(idx, none), covered: markCovered(covered, idx), wild: wild });
    },
    PVariant(name, args) => checkVariantPattern(env, fx, p, name, args, sty, variants, covered, wild),
    PInt(n) => {
      if (isIntish(sty)) {
        const k = intKindOf(sty);
        if (n < 0 && !kindSigned(k)) {
          return Err(diag("E0400", p.span, "negative integer literal cannot have type `" + showType(fx.env, sty) + "`"));
        }
        if (kindNarrow(k) && (n < kindLo(k) || n > kindHi(k))) {
          return Err(diag(
            "E0430",
            p.span,
            "integer literal `" + n.toString() + "` does not fit in `" + showType(fx.env, sty) + "`"
          ));
        }
        return Ok(PatOut { fx: fx, pat: HPInt(n), covered: covered, wild: wild });
      }
      return Err(literalMismatch(fx.env, p.span, sty, TyInt, isVariantScrut));
    },
    PStr(s) => {
      if (isString(sty)) {
        return Ok(PatOut { fx: fx, pat: HPStr(s), covered: covered, wild: wild });
      }
      return Err(literalMismatch(fx.env, p.span, sty, TyString, isVariantScrut));
    },
    PBool(b) => {
      if (isBool(sty)) {
        return Ok(PatOut { fx: fx, pat: HPBool(b), covered: covered, wild: wild });
      }
      return Err(literalMismatch(fx.env, p.span, sty, TyBool, isVariantScrut));
    }
  };
}

function checkVariantPattern(
  env: Env,
  fx0: FnCtx,
  p: Pattern,
  name: Ident,
  args: Pattern[],
  sty: Type,
  variants: Option<VariantDef[]>,
  covered: bool[],
  wild: bool
): Result<PatOut, Diagnostic> {
  if (variants.isNone()) {
    return Err(diag("E0402", p.span, "variant pattern used on a scalar scrutinee"));
  }
  const vs = variants.unwrap();
  const idxo = findVariant(vs, memberName(name.name));
  if (idxo.isNone()) {
    return Err(diag("E0405", name.span, "`" + name.name + "` is not a variant of `" + showType(fx0.env, sty) + "`"));
  }
  const idx = idxo.unwrap();
  let payload = vs[idx].payload;
  const voidOk = match (sty) {
    TyResult(a, _) => isVoid(a),
    _ => false,
  };
  if (fx0.inst && voidOk && payload.length == 0 && args.length == 1 && name.name == "Ok") {
    // `Ok(v)` with `v: T` in an instance with `T = void` (ADR-0040): `v` is the unit value, it has no slot
    payload = [TyVoid];
  }
  if (payload.length != args.length) {
    return Err(diag(
      "E0402",
      p.span,
      "variant `" + name.name + "` has " + payload.length.toString() + " field(s), pattern has "
        + args.length.toString()
    ));
  }
  let fx = fx0;
  let bindings: Option<usize>[] = [];
  let i: usize = 0;
  for (const sub of args) {
    match (sub.kind) {
      PWildcard => {
        bindings.push(None);
      },
      PIdent(b) => {
        const id = fx.newLocal(b.name, payload[i], false);
        fx.declare(b, id)?;
        bindings.push(Some(id));
      },
      _ => {
        let d = diag("E0402", sub.span, "nested patterns are not supported; a variant pattern binds only names or `_`");
        d.notes.push("match the inner value in a second `match`");
        return Err(d);
      }
    }
    i += 1;
  }
  return Ok(PatOut { fx: fx, pat: HPVariant(idx, bindings), covered: markCovered(covered, idx), wild: wild });
}
