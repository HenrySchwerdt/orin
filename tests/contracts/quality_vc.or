// Inputs for tools/test_verify_contracts.py: contract-quality warnings of `orin verify --contracts`
// (ADR-0028, W0460-W0462). `// expect:` lines are results (function kind status), `// warn:` lines
// the quality warnings (function code). Functions without a `warn:` line must have no warning.
// expect: tautology_req ensures VERIFIED
// expect: tautology_ens ensures VERIFIED
// expect: unsat_req ensures VERIFIED
// expect: implied ensures VERIFIED
// expect: implied ensures VERIFIED
// expect: meaningful ensures VERIFIED
// expect: meaningful ensures VERIFIED
// expect: partial ensures REFUTED
// expect: syntactic ensures VERIFIED
// expect: with_loop ensures UNKNOWN
// expect: unsupported_clause ensures UNKNOWN
// warn: tautology_req W0460
// warn: tautology_ens W0460
// warn: unsat_req W0461
// warn: implied W0462
// warn: with_loop W0460

// The @Requires is valid for every int: it excludes no input.
@Requires(x >= 0 || x < 0)
@Ensures(result == x)
function tautology_req(x: int): int {
  return x;
}

// The @Ensures holds for every result (a disjunction of a comparison and its negation).
@Ensures(result >= 0 || result < 0)
function tautology_ens(x: int): int {
  return x;
}

@Requires(x > 0 && x < 0)
@Ensures(result == 1)
function unsat_req(x: int): int {
  return 1;
}

// The first @Ensures follows from @Requires alone; the second really constrains the result.
@Requires(x > 5)
@Ensures(x > 3)
@Ensures(result > x)
function implied(x: int): int {
  return x + 1;
}

// Negative: both clauses are meaningful.
@Requires(x > 0)
@Ensures(result >= 1)
@Ensures(result > x)
function meaningful(x: int): int {
  return x + 1;
}

// Negative: a refuted contract is not a quality finding.
@Requires(x > 0)
@Ensures(result > x)
function partial(x: int): int {
  return x;
}

// Negative for the solver warning: `true` is syntactically trivial (W0452 from `orin check`), the solver does
// not repeat it.
@Ensures(true)
function syntactic(x: int): int {
  return x;
}

// A loop is outside the supported fragment for the body, but the clause alone is still analysed.
@Ensures(result >= 0 || result < 0)
function with_loop(n: int): int {
  let i = 0;
  while (i < n) {
    i += 1;
  }
  return i;
}

// Negative: a clause with an unsupported construct is skipped silently (no warning).
@Requires(s.length > 0)
@Ensures(result >= 0 || result < 0)
function unsupported_clause(s: string): int {
  return 1;
}

function main(): void {}
