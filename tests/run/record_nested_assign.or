function show(xs: int[]): string {
  let s = "[";
  let i: usize = 0;
  while (i < xs.length) {
    if (i > 0) { s = s + ","; }
    s = s + xs[i].toString();
    i += 1;
  }
  return s + "]";
}

type Inner = { v: int; w: int; };
type Outer = { inner: Inner; tag: string; items: int[]; };

function main(): void {
  let o = Outer { inner: Inner { v: 1, w: 2 }, tag: "t", items: [1] };
  o.inner.v = 10;
  o.inner.w += 5;
  o.tag = o.tag + "!";
  o.items.push(2);
  o.items[0] = 100;
  console.log(o.inner.v.toString());
  console.log(o.inner.w.toString());
  console.log(o.tag);
  console.log(show(o.items));
  o.inner = Inner { v: 0, w: 0 };
  console.log(o.inner.v.toString());
  o.inner.v -= 3;
  o.inner.w = 7;
  o.inner.w *= 2;
  o.inner.w /= 7;
  o.inner.w %= 5;
  console.log(o.inner.v.toString());
  console.log(o.inner.w.toString());
}
