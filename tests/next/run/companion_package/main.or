// The companion of a package module (`./a.gen` is the companion of a/module.or); its generated code imports module b,
// which the manifest allows for a. (Generated code can import only modules the program loads: main loads b here.)
import { make } from "./a";
import { total } from "./a.gen";
import { triple } from "./b";

function main(): void {
  console.log(total(make()).toString());
  console.log(triple(1).toString());
}
