// std:meta -- types and builders for ADR-0046 annotation processors (slice S3): the immutable `Input` a processor
// receives, the `Output` tree (`MDecl` / `MStmt` / `MExpr` / `MType`) it builds, `fresh` / `NameGen` hygiene, and the
// stable JSON encoding of both. UNSTABLE until ADR-0046 is implemented (docs/std-meta.md).
//
// This file only re-exports: the definitions are in `std:metacore` (model and builders) and `std:metajson` (codec).
// Pure: no grants, no I/O.
export {
  MRef, MConst, MCBool, MCInt, MCFloat, MCString, MCTag, MCArray, MCNone, MCSome, MType, MNamed,
  MArray, MOption, MResult, MFn, MUnion, MVariant, MParam, MArg, MAnnotation, MContractKind,
  MRequires, MEnsures, MInvariant, MDecreases, MRule, MContract, MDeclKind, MKRecord, MKUnion,
  MKAlias, MKClass, MKInterface, MKFunction, MKConst, MFieldView, MMethodView, MDeclView, MShape,
  MSRecord, MSUnion, MSAlias, MSOpaque, MTypeShape, Input, MUnOp, OpNeg, OpNot, OpBitNot, MBinOp,
  OpAdd, OpSub, OpMul, OpDiv, OpRem, OpEq, OpNe, OpLt, OpLe, OpGt, OpGe, OpAnd, OpOr, OpBitAnd,
  OpBitOr, OpBitXor, OpShl, OpShr, MPattern, MPWild, MPBind, MPVariant, MPLit, MExpr, MEInt,
  MEFloat, MEString, MEBool, MEName, MECall, MEMethod, MEField, MEIndex, MERecord, MEArray, MEUnary,
  MEBinary, MEMatch, METry, MECond, MFieldInit, MArm, MStmt, MSConst, MSLet, MSAssign, MSReturn,
  MSExpr, MSIf, MSWhile, MSForOf, MSMatch, MFnDecl, MConstDecl, MRecordDecl, MUnionDecl,
  MClassField, MCtorDecl, MClassDecl, MDecl, MDFn, MDConst, MDRecord, MDUnion, MDClass, MImport,
  MSeverity, MError, MWarning, MDiagnostic, Output, fresh, NameGen, nameGen, ref, annotationArg,
  findAnnotation, constString, constInt, constBool, emptyInput, named, generic, arrayOf, optionOf,
  resultOf, fnOf, unionOf, variant, param, cInt, cStr, cBool, pWild, pBind, pVariant, pLit, intLit,
  floatLit, str, boolLit, name, call, callExpr, callGeneric, method, dot, index, initField, record,
  arrayLit, unary, binary, neg, not, add, sub, mul, div, rem, eq, ne, lt, le, gt, ge, andAlso,
  orElse, tryOp, cond, arm, armStmts, matchExpr, constS, constT, letS, letT, assign, ret, retVoid,
  exprS, ifS, whileS, forOf, matchS, fn, constant, recordType, unionType, classField, ctor,
  methodDecl, classType, declName, declExported, exportDecl, withTypeParams, withDoc, importFrom,
  diagError, diagWarning, emptyOutput, output, withImports, withDiagnostics, hasErrors,
} from "std:metacore";
