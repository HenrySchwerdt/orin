class Money {
  amount: int;
  currency: string;
  note: string;
  constructor(amount: int, currency: string, note: string) {
    this.amount = amount;
    this.currency = currency;
    this.note = note;
  }
  equals(other: Money): bool {
    return this.amount == other.amount && this.currency == other.currency;
  }
  compare(other: Money): int {
    if (this.amount < other.amount) { return -1; }
    if (this.amount > other.amount) { return 1; }
    return 0;
  }
  hash(): usize {
    return this.amount.toUsize();
  }
}

class Id implements Ord, Hash {
  n: int;
  tag: string;
  constructor(n: int, tag: string) {
    this.n = n;
    this.tag = tag;
  }
}

class Box<T extends Hash> {
  v: T;
  constructor(v: T) { this.v = v; }
  same(o: Box<T>): bool { return this.v == o.v; }
  h(): usize { return this.v.hash(); }
}

class Cache<K extends Hash, V> {
  m: Map<K, V>;
  constructor() { this.m = new Map<K, V>(); }
  put(k: K, v: V): void { this.m.set(k, v); }
  get(k: K): Option<V> { return this.m.get(k); }
}

function maxOf<T extends Ord>(xs: T[]): T {
  let best = xs[0];
  for (const x of xs) {
    if (x > best) { best = x; }
  }
  return best;
}

function main(): void {
  const a = new Money(5, "EUR", "x");
  const b = new Money(5, "EUR", "y");
  const c = new Money(7, "EUR", "z");
  console.log((a == b).toString());
  console.log((a < c).toString());
  console.log(a.equals(c).toString());
  console.log(a.hash().toString());
  const ids = [new Id(3, "c"), new Id(9, "a"), new Id(9, "b")];
  console.log(maxOf(ids).tag);
  console.log((new Id(1, "a") == new Id(1, "a")).toString());
  const bx = new Box<Money>(a);
  console.log(bx.same(new Box<Money>(b)).toString());
  console.log(bx.h().toString());
  let cache = new Cache<Id, int>();
  cache.put(new Id(1, "q"), 10);
  console.log(cache.get(new Id(1, "q")).unwrapOr(-1).toString());
  console.log(cache.get(new Id(2, "q")).unwrapOr(-1).toString());
  let mm = new Map<Money, string>();
  mm.set(a, "A");
  console.log(mm.get(b).unwrapOr("none"));
  console.log(maxOf([a, c, b]).amount.toString());
}
