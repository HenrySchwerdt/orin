// Human terminal rendering is deliberately separate from compact diagnostics and JSON/LSP data.
import { SourceMap, Diagnostic, isWarning } from "./diag";

export type TerminalOptions = { rich: bool; color: bool; ascii: bool; quiet: bool; verbose: bool; args: string[]; };

export function terminalOptions(args: string[]): TerminalOptions {
  let out = TerminalOptions { rich: false, color: false, ascii: false, quiet: false, verbose: false, args: [] };
  for (const a of args) {
    if (a == "--diagnostic-style=rich") { out.rich = true; }
    else if (a == "--diagnostic-style=compact") { out.rich = false; }
    else if (a == "--color=always") { out.color = true; }
    else if (a == "--color=never" || a == "--color=auto") { out.color = false; }
    else if (a == "--ascii") { out.ascii = true; }
    else if (a == "--quiet") { out.quiet = true; }
    else if (a == "--verbose") { out.verbose = true; }
    else { out.args.push(a); }
  }
  return out;
}

export function paint(s: string, code: string, color: bool): string {
  const esc = String.fromCharCode(27);
  return color ? esc + "[" + code + "m" + s + esc + "[0m" : s;
}

// Source and messages are untrusted terminal content. Preserve printable UTF-8, escape controls.
export function terminalSafe(s: string): string {
  const hex = "0123456789abcdef";
  let out = "";
  let i: usize = 0;
  while (i < s.length) {
    const c = s.charCodeAt(i);
    if (c < 32 || c == 127) {
      out += "\\x" + hex.charAt((c / 16).toUsize()) + hex.charAt((c % 16).toUsize());
    } else { out += s.charAt(i); }
    i += 1;
  }
  return out;
}

function repeat(s: string, n: usize): string {
  let out = "";
  let i: usize = 0;
  while (i < n) { out += s; i += 1; }
  return out;
}

// Decode a UTF-8 scalar only for terminal cell width; machine offsets remain byte-based.
function scalar(s: string, at: usize): int {
  const c = s.charCodeAt(at);
  if (c < 128) { return c; }
  let n: usize = c < 224 ? 2 : c < 240 ? 3 : 4;
  let v = c % (n == 2 ? 32 : n == 3 ? 16 : 8);
  let i: usize = 1;
  while (i < n && at + i < s.length) {
    v = v * 64 + s.charCodeAt(at + i) % 64;
    i += 1;
  }
  return v;
}

function cells(c: int): usize {
  if (c >= 768 && c <= 879 || c >= 65024 && c <= 65039 || c == 8205) { return 0; }
  if (c >= 4352 && c <= 4607 || c >= 11904 && c <= 42191 || c >= 44032 && c <= 55203
      || c >= 65281 && c <= 65376 || c >= 127744 && c <= 129791 || c >= 131072 && c <= 196605) { return 2; }
  return 1;
}

type Display = { text: string; width: usize; };

function display(s: string): Display {
  let out = "";
  let width: usize = 0;
  let i: usize = 0;
  while (i < s.length) {
    const c = s.charCodeAt(i);
    if (c == 9) {
      const n = 4 - width % 4;
      out += repeat(" ", n); width += n; i += 1;
    } else if (c < 32 || c == 127) {
      out += terminalSafe(s.charAt(i)); width += 4; i += 1;
    } else {
      const n: usize = c < 128 ? 1 : c < 224 ? 2 : c < 240 ? 3 : 4;
      const end = i + n < s.length ? i + n : s.length;
      out += s.substring(i, end); width += cells(scalar(s, i)); i = end;
    }
  }
  return Display { text: out, width: width };
}

function sourceRow(text: string, line: usize, start: usize, end: usize, digits: usize, gutter: string, tone: string, color: bool): string {
  const number = line.toString();
  const prefix = "  " + repeat(" ", digits - number.length) + number + " " + gutter + " ";
  const before = display(text.substring(0, start));
  const marked = display(text.substring(0, end));
  const n = marked.width > before.width ? marked.width - before.width : 1;
  return paint(prefix, "2", color) + display(text).text + "\n"
    + paint("  " + repeat(" ", digits) + " " + gutter + " ", "2", color)
    + repeat(" ", before.width) + paint(repeat("^", n), tone, color);
}

export function renderTerminal(sm: SourceMap, d: Diagnostic, color: bool, ascii: bool): string {
  const tone = isWarning(d) ? "33" : "31";
  const kind = isWarning(d) ? "warning" : "error";
  let out = paint(kind + "[" + d.code + "]: " + terminalSafe(d.message), "1;" + tone, color);
  if (d.span.file < sm.files.length) {
    const f = sm.files[d.span.file];
    const start = d.span.start < f.text.length ? d.span.start : f.text.length;
    const end = d.span.end < f.text.length ? d.span.end : f.text.length;
    let line: usize = 1;
    let begin: usize = 0;
    let i: usize = 0;
    while (i < start) {
      if (f.text.charCodeAt(i) == 10) { line += 1; begin = i + 1; }
      i += 1;
    }
    let stop = start;
    while (stop < f.text.length && f.text.charCodeAt(stop) != 10) { stop += 1; }
    if (stop > begin && f.text.charCodeAt(stop - 1) == 13) { stop -= 1; }
    const a = start < stop ? start - begin : stop - begin;
    const b = end < stop ? (end > begin ? end - begin : a) : stop - begin;
    out += "\n\n  " + terminalSafe(f.path) + ":" + line.toString() + ":" + (start - begin + 1).toString();
    out += "\n\n" + sourceRow(f.text.substring(begin, stop), line, a, b, line.toString().length, ascii ? "|" : "│", tone, color);
    if (end > stop + 1) { out += "\n  " + paint("... span continues on following lines", "2", color); }
  }
  for (const note of d.notes) { out += "\n\n  note: " + terminalSafe(note); }
  return out;
}
