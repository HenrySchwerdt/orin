e(\"memCmp greater\", memCmp(y, x, 8) == 1);\n  store8(y + 1, 200);\n  out += line(\"memCmp unsigned\", memCmp(x, y, 8) == -1 && memCmp(y, x, 8) == 1);\n  memFree(y);\n  memFree(x);\n\n  memFree(c4);\n  memFree(z);\n  memFree(b);\n  memFree(a);\n  out += line(\"memFree\", true);\n  return out;\n}\n\n// A failed allocation traps \"out of memory\" (exit 101) instead of returning 0: `tests/run/core_oom_trap.or`.\nexport function coreOom(): usize {\n  return memAlloc(18446744073709551600);\n}\n\n// The same for memRealloc.\nexport function coreOomRealloc(): usize {\n  const p = memAlloc(8);\n  return memRealloc(p, 18446744073709551600);\n}\n" });
