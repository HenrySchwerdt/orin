// Compile the staged adapter with the new builtin before it becomes reachable from main.or.
import { Host, useFs } from "std:host";
import { assertEqUsize } from "std:test";
import { runWorkspace } from "./wscli";

function main(host: Host): void {
  useFs(
    host,
    fs => {
      assertEqUsize(runWorkspace(fs, []), 2, "missing workspace subcommand");
      assertEqUsize(runWorkspace(fs, ["invalid"]), 2, "unknown workspace subcommand");
    },
  );
}
