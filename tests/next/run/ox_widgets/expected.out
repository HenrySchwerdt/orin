== named slots
dialog "Delete?"
  header:
    label "Really delete?"
  body:
    label "This cannot be undone."
    spacer 1
  footer:
    button "Delete"
press "Delete"
deleted
dialog "Notice"
  header:
    group
      text "Heads"
      spacer 0
  body:
    text "Plain body"
dialog "Empty"
  header:
    group
  body:
