// std:collections PriorityQueue<int> (4-ary implicit heap, struct of arrays, FIFO among equal priorities): 200,000 pushes
// of pseudo-random priorities, then an interleaved phase of 400,000 push+pop pairs, then a full drain. The checksums only
// depend on the popped priorities (ties between equal priorities are broken differently by the Go and C heaps).
import { PriorityQueue, PqEntry } from "std:collections";

// Linear congruential generator; all products stay below 2^63.
function nextRand(s: int): int {
  return (s * 1103515245 + 12345) % 2147483648;
}

function main(): void {
  let q = new PriorityQueue<int>();
  let seed = 1;
  let i = 0;
  while (i < 200000) {
    seed = nextRand(seed);
    q.push(seed % 1000003, i);
    i += 1;
  }
  console.log("size " + q.size().toString());
  let check = 0;
  i = 0;
  while (i < 400000) {
    seed = nextRand(seed);
    q.push(seed % 1000003, i);
    match (q.pop()) {
      Some(e) => {
        check = (check * 31 + e.priority) % 1000000007;
      },
      None => {}
    };
    i += 1;
  }
  console.log("interleaved " + check.toString() + " size " + q.size().toString());
  let n = 0;
  let sum = 0;
  let last = -1;
  let ordered = true;
  while (!q.isEmpty()) {
    match (q.pop()) {
      Some(e) => {
        if (e.priority < last) {
          ordered = false;
        }
        last = e.priority;
        n += 1;
        sum = (sum + e.priority * (n % 1000)) % 1000000007;
      },
      None => {}
    };
  }
  console.log("drained " + n.toString() + " ordered " + ordered.toString() + " sum " + sum.toString());
}
