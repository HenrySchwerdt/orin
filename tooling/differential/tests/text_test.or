import { assertEqString, assertEqUsize } from "std:test";
import { strip, shq, cutBytes, reprStr, reprBytes, sortedStrings } from "../src/text";

@Test
function stripAndQuote(): void {
  assertEqString(strip("  a b \t\r\n"), "a b", "strip");
  assertEqString(shq("it's"), "'it'\\''s'", "quote");
  assertEqString(shq(""), "''", "empty");
}

@Test
function cutsOnCharacterBoundary(): void {
  assertEqString(cutBytes("abcdef", 3), "abc", "ascii");
  assertEqString(cutBytes("abc", 10), "abc", "short");
}

@Test
function pythonReprOfStrings(): void {
  assertEqString(reprStr("a"), "'a'", "plain");
  assertEqString(reprStr("it's"), "\"it's\"", "single quote inside");
  assertEqString(reprStr("a\\b"), "'a\\\\b'", "backslash");
  assertEqString(reprStr("a\nb\tc\r"), "'a\\nb\\tc\\r'", "newline, tab, cr");
  assertEqString(reprStr("it's \"x\""), "'it\\'s \"x\"'", "both quotes");
}

@Test
function pythonReprOfBytes(): void {
  assertEqString(reprBytes(""), "b''", "empty");
  assertEqString(reprBytes("hi\n"), "b'hi\\n'", "newline");
  assertEqString(reprBytes("a\tb\rc"), "b'a\\tb\\rc'", "tab and cr");
  assertEqString(reprBytes("it's"), "b\"it's\"", "quote switch");
  assertEqString(reprBytes("it's \"x\""), "b'it\\'s \"x\"'", "both quotes");
  assertEqString(reprBytes("a\\b"), "b'a\\\\b'", "backslash");
}

@Test
function sortsByBytes(): void {
  const s = sortedStrings(["b", "B", "a", "ab", ""]);
  assertEqUsize(s.length, 5, "length");
  assertEqString(s.join(","), ",B,a,ab,b", "byte order");
}
