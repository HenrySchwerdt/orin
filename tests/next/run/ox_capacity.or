// OX roots start from a pre-sized buffer (ADR-0044, capacity hint): the output must not depend on the hint. Dynamic
// pieces far bigger than the hint, empty pieces, a root in a loop, nesting, and a root whose pieces are all empty.
import { render } from "std:html";
import ox from "std:html";

function repeat(s: string, n: int): string {
  let r = "";
  let i = 0;
  while (i < n) {
    r += s;
    i += 1;
  }
  return r;
}

function main(): void {
  const big = repeat("x<", 5000);
  const empty = "";
  const a = <p>{big}</p>;
  const out = render(a);
  console.log(out.length.toString());
  console.log(out.substring(0, 20));
  console.log(out.substring(out.length - 12, out.length));
  // empty dynamic pieces
  console.log(render(<p>{empty}</p>));
  console.log(render(<p class={empty}>{empty}{empty}</p>));
  console.log(render(<div>{empty}</div>));
  // a piece larger than the hint, then more static text and pieces
  const b = <div id={big}>a{big}b{empty}c</div>;
  const ob = render(b);
  console.log(ob.length.toString());
  console.log(ob.substring(0, 12));
  // a root in a loop: each iteration has its own buffer
  let total: usize = 0;
  let last = "";
  let i = 0;
  while (i < 200) {
    const row = <li data-i={i}>{repeat("y", i)}</li>;
    last = render(row);
    total += last.length;
    i += 1;
  }
  console.log(total.toString());
  console.log(last.length.toString());
  // nested elements share one buffer; the children list is rendered through it
  const items = ["a", "b<", repeat("c", 100)];
  const l = <ul>{items.map(s => <li>{s}</li>)}<li>{big.length}</li></ul>;
  const ol = render(l);
  console.log(ol.length.toString());
  console.log(ol.substring(0, 40));
}
