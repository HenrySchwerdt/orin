import { Graph } from "std:graph";

type City = { name: string; pop: int; };
class Counter {
  constructor(public n: int) {}
  bump(): void {
    this.n += 1;
  }
}

function main(): void {
  let g = new Graph<City>(21);
  const a = g.add(City { name: "Aachen", pop: 250 });
  const b = g.add(City { name: "Bonn", pop: 330 });
  g.addEdge(a, b).unwrap();
  const c = g.get(a).unwrap();
  console.log(c.name + " " + c.pop.toString());
  g.set(b, City { name: "Bonn", pop: 331 }).unwrap();
  console.log(g.get(g.neighbors(a).unwrap()[0]).unwrap().pop.toString());

  let cg = new Graph<Counter>(22);
  const k = cg.add(new Counter(1));
  let copy = cg.get(k).unwrap();
  copy.bump();
  console.log(cg.get(k).unwrap().n.toString() + " " + copy.n.toString());
}
