function adder(n: int): (x: int) => int {
  return x => x + n;
}

function counter(start: int, step: int): () => int {
  return () => start + step;
}

function curry(a: int): (b: int) => (c: int) => int {
  return b => c => a * 100 + b * 10 + c;
}

function pick(flag: bool): (x: int) => int {
  if (flag) {
    return x => x * 2;
  }
  return x => 0 - x;
}

function main(): void {
  const add5 = adder(5);
  const add7 = adder(7);
  console.log(add5(1).toString() + " " + add7(1).toString());
  console.log(counter(10, 3)().toString());
  console.log(curry(1)(2)(3).toString());
  const c2 = curry(4);
  const c24 = c2(5);
  console.log(c24(6).toString() + " " + c24(7).toString());
  console.log(pick(true)(21).toString() + " " + pick(false)(21).toString());
  console.log(adder(adder(1)(2))(3).toString());
}
