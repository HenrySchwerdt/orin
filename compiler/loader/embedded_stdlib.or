 root: usize = 0;\n  private free: usize[] = [];\n  private count: usize = 0;\n\n  // new SortedMap<V>(minDegree): an empty map; every node but the root keeps minDegree-1 .. 2*minDegree-1 keys.\n  @Requires(minDegree >= 2)\n  constructor(minDegree: usize) {\n    this.t = minDegree;\n  }\n\n  // size(): number of entries. O(1).\n  @Ensures(result == this.count)\n  size(): usize {\n    return this.count;\n  }\n\n  // isEmpty(): no entries. O(1).\n  @Ensures(result == (this.size() == 0))\n  isEmpty(): bool {\n    return this.count == 0;\n  }\n\n  // height(): number of levels of the tree (1 for the root leaf). It is logarithmic: a tree with this many levels\n  // holds at least 2 t^(h-1) - 1 keys, so n keys need at most about log_t(n/2) + 1 levels. O(height).\n  @Ensures(result >= 1)\n  @Ensures(this.count > 0 ==> btreeMinKeysInt(result, this.t) <= this.count)\n  height(): usize {\n    return btreeIntHeight(this.nodes, this.root);\n  }\n\n  // has(k): is there an entry for k? O(t log_t n).\n  @Ensures(result ==> this.size() > 0)\n  has(k: int): bool {\n    let x = this.root;\n    while (true) {\n      const i = lowerBoundInt(this.nodes[x].keys, k);\n      if (i < this.nodes[x].keys.length && (this.nodes[x].keys[i] == k)) {\n        return true;\n      }\n      if (this.nodes[x].kids.length == 0) {\n        return false;\n      }\n      x = this.nodes[x].kids[i];\n    }\n    return false;\n  }\n\n  // get(k): the value for k, None when absent. O(t log_t n).\n  @Ensures(result.isSome() == this.has(k))\n  get(k: int): Option<V> {\n    let x = this.root;\n    while (true) {\n      const i = lowerBoundInt(this.nodes[x].keys, k);\n      if (i < this.nodes[x].keys.length && (this.nodes[x].keys[i] == k)) {\n        return Some(this.nodes[x].vals[i]);\n      }\n      if (this.nodes[x].kids.length == 0) {\n        return None;\n      }\n      x = this.nodes[x].kids[i];\n    }\n    return None;\n  }\n\n  // A fresh arena slot (reusing a freed one) holding the given node contents.\n  private alloc(keys: int[], vals: V[], kids: usize[]): usize {\n    if (this.free.length > 0) {\n      const id = this.free.pop().unwrap();\n      this.nodes[id] = IntNode<V> { keys: keys, vals: vals, kids: kids };\n      return id;\n    }\n    this.nodes.push(IntNode<V> { keys: keys, vals: vals, kids: kids });\n    return this.nodes.length - 1;\n  }\n\n  // Empties an arena slot and puts it on the free list.\n  private release(id: usize): void {\n    this.nodes[id] = IntNode<V> { keys: [], vals: [], kids: [] };\n    this.free.push(id);\n  }\n\n  private insertKey(id: usize, pos: usize, k: int, v: V): void {\n    this.nodes[id].keys.push(k);\n    this.nodes[id].vals.push(v);\n    let j = this.nodes[id].keys.length - 1;\n    while (j > pos) {\n      this.nodes[id].keys[j] = this.nodes[id].keys[j - 1];\n      this.nodes[id].vals[j] = this.nodes[id].vals[j - 1];\n      j -= 1;\n    }\n    this.nodes[id].keys[pos] = k;\n    this.nodes[id].vals[pos] = v;\n  }\n\n  private removeKey(id: usize, pos: usize): void {\n    let j = pos;\n    while (j + 1 < this.nodes[id].keys.length) {\n      this.nodes[id].keys[j] = this.nodes[id].keys[j + 1];\n      this.nodes[id].vals[j] = this.nodes[id].vals[j + 1];\n      j += 1;\n    }\n    this.nodes[id].keys.pop();\n    this.nodes[id].vals.pop();\n  }\n\n  private insertKid(id: usize, pos: usize, kid: usize): void {\n    this.nodes[id].kids.push(kid);\n    let j = this.nodes[id].kids.length - 1;\n    while (j > pos) {\n      this.nodes[id].kids[j] = this.nodes[id].kids[j - 1];\n      j -= 1;\n    }\n    this.nodes[id].kids[pos] = kid;\n  }\n\n  private removeKid(id: usize, pos: usize): void {\n    let j = pos;\n    while (j + 1 < this.nodes[id].kids.length) {\n      this.nodes[id].kids[j] = this.nodes[id].kids[j + 1];\n      j += 1;\n    }\n    this.nodes[id].kids.pop();\n  }\n\n  // Splits the full child number i of node x around its median key, which moves up into x.\n  private splitChild(x: usize, i: usize): void {\n    const t = this.t;\n    const y = this.nodes[x].kids[i];\n    const yk = this.nodes[y].keys;\n    const yv = this.nodes[y].vals;\n    const yc = this.nodes[y].kids;\n    const med = yk[t - 1];\n    const medv = yv[t - 1];\n    let zc: usize[] = [];\n    if (yc.length > 0) {\n      zc = yc.slice(t, yc.length);\n      this.nodes[y].kids = yc.slice(0, t);\n    }\n    const z = this.alloc(yk.slice(t, yk.length), yv.slice(t, yv.length), zc);\n    this.nodes[y].keys = yk.slice(0, t - 1);\n    this.nodes[y].vals = yv.slice(0, t - 1);\n    this.insertKey(x, i, med, medv);\n    this.insertKid(x, i + 1, z);\n  }\n\n  // put(k, v): set the value for k; true when k was new (the size grows by 1), false when an existing value was\n  // replaced. One root-to-leaf pass that splits full nodes on the way down. O(t log_t n).\n  @Ensures(this.has(k) && this.get(k).isSome())\n  @Ensures(result == !old(this.has(k)))\n  @Ensures(result ==> this.size() == old(this.size()) + 1)\n  @Ensures(!result ==> this.size() == old(this.size()))\n  put(k: int, v: V): bool {\n    const maxKeys = 2 * this.t - 1;\n    if (this.nodes[this.root].keys.length == maxKeys) {\n      const nr = this.alloc([], [], [this.root]);\n      this.root = nr;\n      this.splitChild(nr, 0);\n    }\n    let x = this.root;\n    while (true) {\n      const i = lowerBoundInt(this.nodes[x].keys, k);\n      if (i < this.nodes[x].keys.length && (this.nodes[x].keys[i] == k)) {\n        this.nodes[x].vals[i] = v;\n        return false;\n      }\n      if (this.nodes[x].kids.length == 0) {\n        this.insertKey(x, i, k, v);\n        this.count += 1;\n        return true;\n      }\n      let ci = i;\n      if (this.nodes[this.nodes[x].kids[i]].keys.length == maxKeys) {\n        this.splitChild(x, i);\n        const m = this.nodes[x].keys[i];\n        if ((k == m)) {\n          this.nodes[x].vals[i] = v;\n          return false;\n        }\n        if ((k > m)) {\n          ci = i + 1;\n        }\n      }\n      x = this.nodes[x].kids[ci];\n    }\n    return false;\n  }\n\n  // Child number ci of x has t-1 keys: give it one more from a sibling (rotation through x) or merge it with a\n  // sibling. Returns the id of the child to descend into afterwards. May shrink the root.\n  private fill(x: usize, ci: usize): usize {\n    const t = this.t;\n    const len = this.nodes[x].keys.length;\n    const c = this.nodes[x].kids[ci];\n    if (ci > 0 && this.nodes[this.nodes[x].kids[ci - 1]].keys.length >= t) {\n      const l = this.nodes[x].kids[ci - 1];\n      const ll = this.nodes[l].keys.length;\n      this.insertKey(c, 0, this.nodes[x].keys[ci - 1], this.nodes[x].vals[ci - 1]);\n      this.nodes[x].keys[ci - 1] = this.nodes[l].keys[ll - 1];\n      this.nodes[x].vals[ci - 1] = this.nodes[l].vals[ll - 1];\n      if (this.nodes[l].kids.length > 0) {\n        this.insertKid(c, 0, this.nodes[l].kids[this.nodes[l].kids.length - 1]);\n        this.nodes[l].kids.pop();\n      }\n      this.nodes[l].keys.pop();\n      this.nodes[l].vals.pop();\n      return c;\n    }\n    if (ci < len && this.nodes[this.nodes[x].kids[ci + 1]].keys.length >= t) {\n      const r = this.nodes[x].kids[ci + 1];\n      this.insertKey(c, this.nodes[c].keys.length, this.nodes[x].keys[ci], this.nodes[x].vals[ci]);\n      this.nodes[x].keys[ci] = this.nodes[r].keys[0];\n      this.nodes[x].vals[ci] = this.nodes[r].vals[0];\n      this.removeKey(r, 0);\n      if (this.nodes[r].kids.length > 0) {\n        this.nodes[c].kids.push(this.nodes[r].kids[0]);\n        this.removeKid(r, 0);\n      }\n      return c;\n    }\n    if (ci < len) {\n      this.mergeChildren(x, ci);\n      return c;\n    }\n    const left = this.nodes[x].kids[ci - 1];\n    this.mergeChildren(x, ci - 1);\n    return left;\n  }\n\n  // Merges child i+1 of x and the separator key i into child i; releases child i+1. If x was the root and ends up\n  // without keys, its only child becomes the root.\n  private mergeChildren(x: usize, i: usize): void {\n    const y = this.nodes[x].kids[i];\n    const z = this.nodes[x].kids[i + 1];\n    this.nodes[y].keys.push(this.nodes[x].keys[i]);\n    this.nodes[y].vals.push(this.nodes[x].vals[i]);\n    let a: usize = 0;\n    while (a < this.nodes[z].keys.length) {\n      this.nodes[y].keys.push(this.nodes[z].keys[a]);\n      this.nodes[y].vals.push(this.nodes[z].vals[a]);\n      a += 1;\n    }\n    let b: usize = 0;\n    while (b < this.nodes[z].kids.length) {\n      this.nodes[y].kids.push(this.nodes[z].kids[b]);\n      b += 1;\n    }\n    this.removeKey(x, i);\n    this.removeKid(x, i + 1);\n    this.release(z);\n    if (x == this.root && this.nodes[x].keys.length == 0) {\n      this.root = y;\n      this.release(x);\n    }\n  }\n\n  // remove(k): delete the entry for k and return its value, None when absent. One root-to-leaf pass (CLRS\n  // top-down deletion): a node is only entered when it has at least t keys, so removing from a leaf never\n  // underflows. A key in an inner node is replaced by its predecessor or successor (or the children are merged) and\n  // that key is deleted further down. O(t log_t n).\n  @Ensures(!this.has(k))\n  @Ensures(result.isSome() == old(this.has(k)))\n  @Ensures(result.isSome() ==> this.size() == old(this.size()) - 1)\n  @Ensures(result.isNone() ==> this.size() == old(this.size()))\n  remove(k: int): Option<V> {\n    const t = this.t;\n    let x = this.root;\n    let target = k;\n    let removed: Option<V> = None;\n    let saved = false;\n    while (true) {\n      const len = this.nodes[x].keys.length;\n      const i = lowerBoundInt(this.nodes[x].keys, target);\n      const isLeaf = this.nodes[x].kids.length == 0;\n      if (i < len && (this.nodes[x].keys[i] == target)) {\n        if (isLeaf) {\n          if (!saved) {\n            removed = Some(this.nodes[x].vals[i]);\n          }\n          this.removeKey(x, i);\n          this.count -= 1;\n          return removed;\n        }\n        if (!saved) {\n          removed = Some(this.nodes[x].vals[i]);\n          saved = true;\n        }\n        const y = this.nodes[x].kids[i];\n        const z = this.nodes[x].kids[i + 1];\n        if (this.nodes[y].keys.length >= t) {\n          let w = y;\n          while (this.nodes[w].kids.length > 0) {\n            w = this.nodes[w].kids[this.nodes[w].kids.length - 1];\n          }\n          const last = this.nodes[w].keys.length - 1;\n          this.nodes[x].keys[i] = this.nodes[w].keys[last];\n          this.nodes[x].vals[i] = this.nodes[w].vals[last];\n          target = this.nodes[w].keys[last];\n          x = y;\n        } else if (this.nodes[z].keys.length >= t) {\n          let w = z;\n          while (this.nodes[w].kids.length > 0) {\n            w = this.nodes[w].kids[0];\n          }\n          this.nodes[x].keys[i] = this.nodes[w].keys[0];\n          this.nodes[x].vals[i] = this.nodes[w].vals[0];\n          target = this.nodes[w].keys[0];\n          x = z;\n        } else {\n          this.mergeChildren(x, i);\n          x = y;\n        }\n      } else {\n        if (isLeaf) {\n          return removed;\n        }\n        const c = this.nodes[x].kids[i];\n        if (this.nodes[c].keys.length < t) {\n          x = this.fill(x, i);\n        } else {\n          x = c;\n        }\n      }\n    }\n    return removed;\n  }\n\n  // firstKey(): the smallest key, None when empty. O(height).\n  @Ensures(result.isSome() == (this.size() > 0))\n  @Ensures(result.isSome() ==> this.has(result.unwrap()))\n  firstKey(): Option<int> {\n    if (this.count == 0) {\n      return None;\n    }\n    let x = this.root;\n    while (this.nodes[x].kids.length > 0) {\n      x = this.nodes[x].kids[0];\n    }\n    return Some(this.nodes[x].keys[0]);\n  }\n\n  // lastKey(): the largest key, None when empty. O(height).\n  @Ensures(result.isSome() == (this.size() > 0))\n  @Ensures(result.isSome() ==> this.has(result.unwrap()))\n  lastKey(): Option<int> {\n    if (this.count == 0) {\n      return None;\n    }\n    let x = this.root;\n    while (this.nodes[x].kids.length > 0) {\n      x = this.nodes[x].kids[this.nodes[x].kids.length - 1];\n    }\n    return Some(this.nodes[x].keys[this.nodes[x].keys.length - 1]);\n  }\n\n  // floorKey(k): the greatest key <= k, None when there is none. One descent. O(t log_t n).\n  @Ensures(result.isSome() ==> (result.unwrap() <= k) && this.has(result.unwrap()))\n  @Ensures(result.isNone() ==> this.firstKey().isNone() || (this.firstKey().unwrap() > k))\n  floorKey(k: int): Option<int> {\n    let best: Option<int> = None;\n    let x = this.root;\n    while (true) {\n      const i = lowerBoundInt(this.nodes[x].keys, k);\n      if (i < this.nodes[x].keys.length && (this.nodes[x].keys[i] == k)) {\n        return Some(k);\n      }\n      if (i > 0) {\n        best = Some(this.nodes[x].keys[i - 1]);\n      }\n      if (this.nodes[x].kids.length == 0) {\n        return best;\n      }\n      x = this.nodes[x].kids[i];\n    }\n    return best;\n  }\n\n  // ceilKey(k): the smallest key >= k, None when there is none. One descent. O(t log_t n).\n  @Ensures(result.isSome() ==> (result.unwrap() >= k) && this.has(result.unwrap()))\n  @Ensures(result.isNone() ==> this.lastKey().isNone() || (this.lastKey().unwrap() < k))\n  ceilKey(k: int): Option<int> {\n    let best: Option<int> = None;\n    let x = this.root;\n    while (true) {\n      const i = lowerBoundInt(this.nodes[x].keys, k);\n      if (i < this.nodes[x].keys.length) {\n        if ((this.nodes[x].keys[i] == k)) {\n          return Some(k);\n        }\n        best = Some(this.nodes[x].keys[i]);\n      }\n      if (this.nodes[x].kids.length == 0) {\n        return best;\n      }\n      x = this.nodes[x].kids[i];\n    }\n    return best;\n  }\n\n  // popFirst(): remove the entry with the smallest key and return it, None when empty. O(t log_t n).\n  @Ensures(result.isSome() == (old(this.size()) > 0))\n  @Ensures(result.isSome() ==> this.size() == old(this.size()) - 1 && !this.has(result.unwrap().key))\n  @Ensures(result.isSome() ==> (result.unwrap().key == old(this.firstKey().unwrapOr(0))))\n  @Ensures(result.isSome() && this.size() > 0 ==> (this.firstKey().unwrap() > result.unwrap().key))\n  popFirst(): Option<SortedEntry<V>> {\n    const f = this.firstKey();\n    if (f.isNone()) {\n      return None;\n    }\n    const v = this.remove(f.unwrap()).unwrap();\n    return Some(SortedEntry<V> { key: f.unwrap(), value: v });\n  }\n\n  // popLast(): remove the entry with the largest key and return it, None when empty. O(t log_t n).\n  @Ensures(result.isSome() == (old(this.size()) > 0))\n  @Ensures(result.isSome() ==> this.size() == old(this.size()) - 1 && !this.has(result.unwrap().key))\n  @Ensures(result.isSome() ==> (result.unwrap().key == old(this.lastKey().unwrapOr(0))))\n  @Ensures(result.isSome() && this.size() > 0 ==> (this.lastKey().unwrap() < result.unwrap().key))\n  popLast(): Option<SortedEntry<V>> {\n    const l = this.lastKey();\n    if (l.isNone()) {\n      return None;\n    }\n    const v = this.remove(l.unwrap()).unwrap();\n    return Some(SortedEntry<V> { key: l.unwrap(), value: v });\n  }\n\n  // keyArray(): all keys in increasing order. O(n).\n  @Ensures(result.length == this.size() && isStrictlyIncreasing(result))\n  keyArray(): int[] {\n    return btreeIntKeys(this.nodes, this.root);\n  }\n\n  // valueArray(): all values in key order. O(n).\n  @Ensures(result.length == this.size())\n  valueArray(): V[] {\n    return btreeIntVals(this.nodes, this.root);\n  }\n\n  // clear(): remove all entries. O(1).\n  @Ensures(this.size() == 0)\n  clear(): void {\n    this.nodes = [IntNode<V> { keys: [], vals: [], kids: [] }];\n    this.root = 0;\n    this.free = [];\n    this.count = 0;\n  }\n}\n\n// ------------------------------------------------------------------------------------------ SortedStringMap\n\n// One node of the B-tree: `keys` sorted, `vals` parallel to them, `kids` empty for a leaf, else keys.length + 1\n// child ids (indices into the arena `nodes` of the map).\nexport type StrNode<V> = { keys: string[]; vals: V[]; kids: usize[]; };\n\n// An entry returned by `SortedStringMap.popFirst` / `popLast`.\nexport type SortedStringEntry<V> = { key: string; value: V; };\n\n// The first index whose key is >= k (keys.length when there is none). Binary search, O(log keys.length).\n@Ensures(result <= keys.length)\n@Ensures(result < keys.length ==> (compareStrings(keys[result], k) >= 0))\n@Ensures(result > 0 ==> (compareStrings(keys[result - 1], k) < 0))\nexport function lowerBoundStr(keys: string[], k: string): usize {\n  let lo: usize = 0;\n  let hi: usize = keys.length;\n  while (lo < hi) {\n    const mid = lo + (hi - lo) / 2;\n    if ((compareStrings(keys[mid], k) < 0)) {\n      lo = mid + 1;\n    } else {\n      hi = mid;\n    }\n  }\n  return lo;\n}\n\n// Is `nodes` a well-formed B-tree arena of minimum degree t rooted at `root`, with free list `free`? Checked\n// iteratively with an explicit stack: every node id is in range and reached exactly once (no dangling or shared\n// ids, no cycles), keys and values have the same length, a leaf has no children and an inner node has one more\n// child than keys (and at least one key), every non-root node holds t-1 .. 2t-1 keys and the root at most 2t-1,\n// all leaves have the same depth, the free list holds distinct ids of unreachable nodes, and every arena slot is\n// either reachable or free.\nexport function btreeStrShapeOk<V>(nodes: StrNode<V>[], root: usize, t: usize, free: usize[]): bool {\n  const n = nodes.length;\n  if (t < 2 || root >= n) {\n    return false;\n  }\n  let seen: bool[] = [];\n  let i: usize = 0;\n  while (i < n) {\n    seen.push(false);\n    i += 1;\n  }\n  i = 0;\n  while (i < free.length) {\n    if (free[i] >= n || seen[free[i]]) {\n      return false;\n    }\n    seen[free[i]] = true;\n    i += 1;\n  }\n  let ids: usize[] = [root];\n  let depths: usize[] = [0];\n  let leafDepth: int = -1;\n  let reachable: usize = 0;\n  while (ids.length > 0) {\n    const id = ids.pop().unwrap();\n    const d = depths.pop().unwrap();\n    if (seen[id]) {\n      return false;\n    }\n    seen[id] = true;\n    reachable += 1;\n    const kc = nodes[id].keys.length;\n    if (nodes[id].vals.length != kc || kc > 2 * t - 1) {\n      return false;\n    }\n    if (id != root && kc < t - 1) {\n      return false;\n    }\n    const kk = nodes[id].kids.length;\n    if (kk == 0) {\n      if (leafDepth < 0) {\n        leafDepth = d.toInt();\n      } else if (leafDepth != d.toInt()) {\n        return false;\n      }\n    } else {\n      if (kk != kc + 1 || kc == 0) {\n        return false;\n      }\n      let c: usize = 0;\n      while (c < kk) {\n        if (nodes[id].kids[c] >= n) {\n          return false;\n        }\n        ids.push(nodes[id].kids[c]);\n        depths.push(d + 1);\n        c += 1;\n      }\n    }\n  }\n  return reachable + free.length == n;\n}\n\n// Are the keys ordered? Inside every node strictly increasing, and every key of a child lies strictly between the\n// separator keys around it in the parent (inherited bounds), which together say the in-order sequence is strictly\n// increasing. Iterative; tolerates a broken shape (out-of-range ids, revisits) by answering false.\nexport function btreeStrOrderOk<V>(nodes: StrNode<V>[], root: usize): bool {\n  if (root >= nodes.length) {\n    return false;\n  }\n  let ids: usize[] = [root];\n  let loFlags: bool[] = [false];\n  let los: string[] = [\"\"];\n  let hiFlags: bool[] = [false];\n  let his: string[] = [\"\"];\n  let visited: usize = 0;\n  while (ids.length > 0) {\n    visited += 1;\n    if (visited > nodes.length) {\n      return false;\n    }\n    const id = ids.pop().unwrap();\n    const hasLo = loFlags.pop().unwrap();\n    const lo = los.pop().unwrap();\n    const hasHi = hiFlags.pop().unwrap();\n    const hi = his.pop().unwrap();\n    const kc = nodes[id].keys.length;\n    let j: usize = 0;\n    while (j < kc) {\n      if (j > 0 && (compareStrings(nodes[id].keys[j - 1], nodes[id].keys[j]) >= 0)) {\n        return false;\n      }\n      j += 1;\n    }\n    if (kc > 0) {\n      if (hasLo && (compareStrings(nodes[id].keys[0], lo) <= 0)) {\n        return false;\n      }\n      if (hasHi && (compareStrings(nodes[id].keys[kc - 1], hi) >= 0)) {\n        return false;\n      }\n    }\n    const kk = nodes[id].kids.length;\n    if (kk > 0 && kk != kc + 1) {\n      return false;\n    }\n    let c: usize = 0;\n    while (c < kk) {\n      if (nodes[id].kids[c] >= nodes.length) {\n        return false;\n      }\n      ids.push(nodes[id].kids[c]);\n      if (c == 0) {\n        loFlags.push(hasLo);\n        los.push(lo);\n      } else {\n        loFlags.push(true);\n        los.push(nodes[id].keys[c - 1]);\n      }\n      if (c == kc) {\n        hiFlags.push(hasHi);\n        his.push(hi);\n      } else {\n        hiFlags.push(true);\n        his.push(nodes[id].keys[c]);\n      }\n      c += 1;\n    }\n  }\n  return true;\n}\n\n// The number of keys stored in the tree below `root` (iterative; a revisit or bad id stops the walk early).\nexport function btreeStrKeyCount<V>(nodes: StrNode<V>[], root: usize): usize {\n  if (root >= nodes.length) {\n    return 0;\n  }\n  let ids: usize[] = [root];\n  let total: usize = 0;\n  let visited: usize = 0;\n  while (ids.length > 0) {\n    visited += 1;\n    if (visited > nodes.length) {\n      return total;\n    }\n    const id = ids.pop().unwrap();\n    total += nodes[id].keys.length;\n    let c: usize = 0;\n    while (c < nodes[id].kids.length) {\n      if (nodes[id].kids[c] < nodes.length) {\n        ids.push(nodes[id].kids[c]);\n      }\n      c += 1;\n    }\n  }\n  return total;\n}\n\n// Height of the tree: the number of levels (1 for a single leaf root). Follows the first child down. O(height).\nexport function btreeStrHeight<V>(nodes: StrNode<V>[], root: usize): usize {\n  let h: usize = 1;\n  let id = root;\n  while (id < nodes.length && nodes[id].kids.length > 0 && h <= nodes.length) {\n    id = nodes[id].kids[0];\n    h += 1;\n  }\n  return h;\n}\n\n// The fewest keys a tree of minimum degree t and the given height can hold: the root has 1 key, every other node\n// at least t-1, so level d >= 1 has >= 2 t^(d-1) nodes and the total is 2 t^(h-1) - 1 (height 1: 1 key, but the\n// root leaf may also be empty, so 0 is returned for an empty tree by the caller). This is why height is O(log_t n).\n@Requires(t >= 2 && h >= 1)\nexport function btreeMinKeysStr(h: usize, t: usize): usize {\n  let p: usize = 1;\n  let d: usize = 1;\n  while (d < h) {\n    p *= t;\n    d += 1;\n  }\n  return 2 * p - 1;\n}\n\n// All keys in order, by an explicit-stack in-order walk (the stack holds a node id and how many of its children\n// were visited). O(n).\nexport function btreeStrKeys<V>(nodes: StrNode<V>[], root: usize): string[] {\n  let out: string[] = [];\n  let ids: usize[] = [root];\n  let js: usize[] = [0];\n  while (ids.length > 0) {\n    const top = ids.length - 1;\n    const id = ids[top];\n    const j = js[top];\n    const kc = nodes[id].keys.length;\n    if (nodes[id].kids.length == 0) {\n      let a: usize = 0;\n      while (a < kc) {\n        out.push(nodes[id].keys[a]);\n        a += 1;\n      }\n      ids.pop();\n      js.pop();\n    } else {\n      if (j > 0 && j - 1 < kc) {\n        out.push(nodes[id].keys[j - 1]);\n      }\n      if (j <= kc) {\n        js[top] = j + 1;\n        ids.push(nodes[id].kids[j]);\n        js.push(0);\n      } else {\n        ids.pop();\n        js.pop();\n      }\n    }\n  }\n  return out;\n}\n\n// All values in key order (same walk as `btreeStrKeys`). O(n).\nexport function btreeStrVals<V>(nodes: StrNode<V>[], root: usize): V[] {\n  let out: V[] = [];\n  let ids: usize[] = [root];\n  let js: usize[] = [0];\n  while (ids.length > 0) {\n    const top = ids.length - 1;\n    const id = ids[top];\n    const j = js[top];\n    const kc = nodes[id].keys.length;\n    if (nodes[id].kids.length == 0) {\n      let a: usize = 0;\n      while (a < kc) {\n        out.push(nodes[id].vals[a]);\n        a += 1;\n      }\n      ids.pop();\n      js.pop();\n    } else {\n      if (j > 0 && j - 1 < kc) {\n        out.push(nodes[id].vals[j - 1]);\n      }\n      if (j <= kc) {\n        js[top] = j + 1;\n        ids.push(nodes[id].kids[j]);\n        js.push(0);\n      } else {\n        ids.pop();\n        js.pop();\n      }\n    }\n  }\n  return out;\n}\n\n// An ordered map from string keys to values of type V: a B-tree of minimum degree t (every node but the root holds\n// t-1 .. 2t-1 keys, all leaves at the same depth) whose nodes live in an arena (`nodes`) and refer to each other\n// by index, so the structure is a plain value (copy-on-write arrays, no pointers, no parent links). `free` lists\n// the arena slots of merged-away nodes for reuse. Insertion splits full nodes on the way down and deletion makes\n// every node it enters hold at least t keys (borrow from a sibling or merge), so both run in one root-to-leaf pass.\n//\n// Invariants (`@Invariant`, checked after every public method by `orin test` / `--check-contracts`): the arena is a\n// valid B-tree of degree t (shape, occupancy, equal leaf depth, no dangling or shared ids, consistent free list),\n// keys are ordered (sorted within nodes and bounded by the separators above them) and the stored count equals the\n// number of keys. Complexity: has/get/put/remove/floorKey/ceilKey/firstKey/lastKey/popFirst/popLast O(t log_t n)\n// (a binary search of O(log t) in each of O(log_t n) nodes, plus O(t) to shift keys inside one node per level on\n// updates); size/isEmpty O(1); keyArray/valueArray O(n); `height()` <= 1 + log_t((n+1)/2). Use t = 16 unless you\n// have measured otherwise; `minDegree` 2 gives the smallest nodes and deepest trees (useful for tests).\n@Invariant(this.t >= 2)\n@Invariant(btreeStrShapeOk(this.nodes, this.root, this.t, this.free))\n@Invariant(btreeStrOrderOk(this.nodes, this.root))\n@Invariant(btreeStrKeyCount(this.nodes, this.root) == this.count)\nexport class SortedStringMap<V> {\n  private t: usize;\n  private nodes: StrNode<V>[] = [StrNode<V> { keys: [], vals: [], kids: [] }];\n  private root: usize = 0;\n  private free: usize[] = [];\n  private count: usize = 0;\n\n  // new SortedStringMap<V>(minDegree): an empty map; every node but the root keeps minDegree-1 .. 2*minDegree-1 keys.\n  @Requires(minDegree >= 2)\n  constructor(minDegree: usize) {\n    this.t = minDegree;\n  }\n\n  // size(): number of entries. O(1).\n  @Ensures(result == this.count)\n  size(): usize {\n    return this.count;\n  }\n\n  // isEmpty(): no entries. O(1).\n  @Ensures(result == (this.size() == 0))\n  isEmpty(): bool {\n    return this.count == 0;\n  }\n\n  // height(): number of levels of the tree (1 for the root leaf). It is logarithmic: a tree with this many levels\n  // holds at least 2 t^(h-1) - 1 keys, so n keys need at most about log_t(n/2) + 1 levels. O(height).\n  @Ensures(result >= 1)\n  @Ensures(this.count > 0 ==> btreeMinKeysStr(result, this.t) <= this.count)\n  height(): usize {\n    return btreeStrHeight(this.nodes, this.root);\n  }\n\n  // has(k): is there an entry for k? O(t log_t n).\n  @Ensures(result ==> this.size() > 0)\n  has(k: string): bool {\n    let x = this.root;\n    while (true) {\n      const i = lowerBoundStr(this.nodes[x].keys, k);\n      if (i < this.nodes[x].keys.length && (compareStrings(this.nodes[x].keys[i], k) == 0)) {\n        return true;\n      }\n      if (this.nodes[x].kids.length == 0) {\n        return false;\n      }\n      x = this.nodes[x].kids[i];\n    }\n    return false;\n  }\n\n  // get(k): the value for k, None when absent. O(t log_t n).\n  @Ensures(result.isSome() == this.has(k))\n  get(k: string): Option<V> {\n    let x = this.root;\n    while (true) {\n      const i = lowerBoundStr(this.nodes[x].keys, k);\n      if (i < this.nodes[x].keys.length && (compareStrings(this.nodes[x].keys[i], k) == 0)) {\n        return Some(this.nodes[x].vals[i]);\n      }\n      if (this.nodes[x].kids.length == 0) {\n        return None;\n      }\n      x = this.nodes[x].kids[i];\n    }\n    return None;\n  }\n\n  // A fresh arena slot (reusing a freed one) holding the given node contents.\n  private alloc(keys: string[], vals: V[], kids: usize[]): usize {\n    if (this.free.length > 0) {\n      const id = this.free.pop().unwrap();\n      this.nodes[id] = StrNode<V> { keys: keys, vals: vals, kids: kids };\n      return id;\n    }\n    this.nodes.push(StrNode<V> { keys: keys, vals: vals, kids: kids });\n    return this.nodes.length - 1;\n  }\n\n  // Empties an arena slot and puts it on the free list.\n  private release(id: usize): void {\n    this.nodes[id] = StrNode<V> { keys: [], vals: [], kids: [] };\n    this.free.push(id);\n  }\n\n  private insertKey(id: usize, pos: usize, k: string, v: V): void {\n    this.nodes[id].keys.push(k);\n    this.nodes[id].vals.push(v);\n    let j = this.nodes[id].keys.length - 1;\n    while (j > pos) {\n      this.nodes[id].keys[j] = this.nodes[id].keys[j - 1];\n      this.nodes[id].vals[j] = this.nodes[id].vals[j - 1];\n      j -= 1;\n    }\n    this.nodes[id].keys[pos] = k;\n    this.nodes[id].vals[pos] = v;\n  }\n\n  private removeKey(id: usize, pos: usize): void {\n    let j = pos;\n    while (j + 1 < this.nodes[id].keys.length) {\n      this.nodes[id].keys[j] = this.nodes[id].keys[j + 1];\n      this.nodes[id].vals[j] = this.nodes[id].vals[j + 1];\n      j += 1;\n    }\n    this.nodes[id].keys.pop();\n    this.nodes[id].vals.pop();\n  }\n\n  private insertKid(id: usize, pos: usize, kid: usize): void {\n    this.nodes[id].kids.push(kid);\n    let j = this.nodes[id].kids.length - 1;\n    while (j > pos) {\n      this.nodes[id].kids[j] = this.nodes[id].kids[j - 1];\n      j -= 1;\n    }\n    this.nodes[id].kids[pos] = kid;\n  }\n\n  private removeKid(id: usize, pos: usize): void {\n    let j = pos;\n    while (j + 1 < this.nodes[id].kids.length) {\n      this.nodes[id].kids[j] = this.nodes[id].kids[j + 1];\n      j += 1;\n    }\n    this.nodes[id].kids.pop();\n  }\n\n  // Splits the full child number i of node x around its median key, which moves up into x.\n  private splitChild(x: usize, i: usize): void {\n    const t = this.t;\n    const y = this.nodes[x].kids[i];\n    const yk = this.nodes[y].keys;\n    const yv = this.nodes[y].vals;\n    const yc = this.nodes[y].kids;\n    const med = yk[t - 1];\n    const medv = yv[t - 1];\n    let zc: usize[] = [];\n    if (yc.length > 0) {\n      zc = yc.slice(t, yc.length);\n      this.nodes[y].kids = yc.slice(0, t);\n    }\n    const z = this.alloc(yk.slice(t, yk.length), yv.slice(t, yv.length), zc);\n    this.nodes[y].keys = yk.slice(0, t - 1);\n    this.nodes[y].vals = yv.slice(0, t - 1);\n    this.insertKey(x, i, med, medv);\n    this.insertKid(x, i + 1, z);\n  }\n\n  // put(k, v): set the value for k; true when k was new (the size grows by 1), false when an existing value was\n  // replaced. One root-to-leaf pass that splits full nodes on the way down. O(t log_t n).\n  @Ensures(this.has(k) && this.get(k).isSome())\n  @Ensures(result == !old(this.has(k)))\n  @Ensures(result ==> this.size() == old(this.size()) + 1)\n  @Ensures(!result ==> this.size() == old(this.size()))\n  put(k: string, v: V): bool {\n    const maxKeys = 2 * this.t - 1;\n    if (this.nodes[this.root].keys.length == maxKeys) {\n      const nr = this.alloc([], [], [this.root]);\n      this.root = nr;\n      this.splitChild(nr, 0);\n    }\n    let x = this.root;\n    while (true) {\n      const i = lowerBoundStr(this.nodes[x].keys, k);\n      if (i < this.nodes[x].keys.length && (compareStrings(this.nodes[x].keys[i], k) == 0)) {\n        this.nodes[x].vals[i] = v;\n        return false;\n      }\n      if (this.nodes[x].kids.length == 0) {\n        this.insertKey(x, i, k, v);\n        this.count += 1;\n        return true;\n      }\n      let ci = i;\n      if (this.nodes[this.nodes[x].kids[i]].keys.length == maxKeys) {\n        this.splitChild(x, i);\n        const m = this.nodes[x].keys[i];\n        if ((compareStrings(k, m) == 0)) {\n          this.nodes[x].vals[i] = v;\n          return false;\n        }\n        if ((compareStrings(k, m) > 0)) {\n          ci = i + 1;\n        }\n      }\n      x = this.nodes[x].kids[ci];\n    }\n    return false;\n  }\n\n  // Child number ci of x has t-1 keys: give it one more from a sibling (rotation through x) or merge it with a\n  // sibling. Returns the id of the child to descend into afterwards. May shrink the root.\n  private fill(x: usize, ci: usize): usize {\n    const t = this.t;\n    const len = this.nodes[x].keys.length;\n    const c = this.nodes[x].kids[ci];\n    if (ci > 0 && this.nodes[this.nodes[x].kids[ci - 1]].keys.length >= t) {\n      const l = this.nodes[x].kids[ci - 1];\n      const ll = this.nodes[l].keys.length;\n      this.insertKey(c, 0, this.nodes[x].keys[ci - 1], this.nodes[x].vals[ci - 1]);\n      this.nodes[x].keys[ci - 1] = this.nodes[l].keys[ll - 1];\n      this.nodes[x].vals[ci - 1] = this.nodes[l].vals[ll - 1];\n      if (this.nodes[l].kids.length > 0) {\n        this.insertKid(c, 0, this.nodes[l].kids[this.nodes[l].kids.length - 1]);\n        this.nodes[l].kids.pop();\n      }\n      this.nodes[l].keys.pop();\n      this.nodes[l].vals.pop();\n      return c;\n    }\n    if (ci < len && this.nodes[this.nodes[x].kids[ci + 1]].keys.length >= t) {\n      const r = this.nodes[x].kids[ci + 1];\n      this.insertKey(c, this.nodes[c].keys.length, this.nodes[x].keys[ci], this.nodes[x].vals[ci]);\n      this.nodes[x].keys[ci] = this.nodes[r].keys[0];\n      this.nodes[x].vals[ci] = this.nodes[r].vals[0];\n      this.removeKey(r, 0);\n      if (this.nodes[r].kids.length > 0) {\n        this.nodes[c].kids.push(this.nodes[r].kids[0]);\n        this.removeKid(r, 0);\n      }\n      return c;\n    }\n    if (ci < len) {\n      this.mergeChildren(x, ci);\n      return c;\n    }\n    const left = this.nodes[x].kids[ci - 1];\n    this.mergeChildren(x, ci - 1);\n    return left;\n  }\n\n  // Merges child i+1 of x and the separator key i into child i; releases child i+1. If x was the root and ends up\n  // without keys, its only child becomes the root.\n  private mergeChildren(x: usize, i: usize): void {\n    const y = this.nodes[x].kids[i];\n    const z = this.nodes[x].kids[i + 1];\n    this.nodes[y].keys.push(this.nodes[x].keys[i]);\n    this.nodes[y].vals.push(this.nodes[x].vals[i]);\n    let a: usize = 0;\n    while (a < this.nodes[z].keys.length) {\n      this.nodes[y].keys.push(this.nodes[z].keys[a]);\n      this.nodes[y].vals.push(this.nodes[z].vals[a]);\n      a += 1;\n    }\n    let b: usize = 0;\n    while (b < this.nodes[z].kids.length) {\n      this.nodes[y].kids.push(this.nodes[z].kids[b]);\n      b += 1;\n    }\n    this.removeKey(x, i);\n    this.removeKid(x, i + 1);\n    this.release(z);\n    if (x == this.root && this.nodes[x].keys.length == 0) {\n      this.root = y;\n      this.release(x);\n    }\n  }\n\n  // remove(k): delete the entry for k and return its value, None when absent. One root-to-leaf pass (CLRS\n  // top-down deletion): a node is only entered when it has at least t keys, so removing from a leaf never\n  // underflows. A key in an inner node is replaced by its predecessor or successor (or the children are merged) and\n  // that key is deleted further down. O(t log_t n).\n  @Ensures(!this.has(k))\n  @Ensures(result.isSome() == old(this.has(k)))\n  @Ensures(result.isSome() ==> this.size() == old(this.size()) - 1)\n  @Ensures(result.isNone() ==> this.size() == old(this.size()))\n  remove(k: string): Option<V> {\n    const t = this.t;\n    let x = this.root;\n    let target = k;\n    let removed: Option<V> = None;\n    let saved = false;\n    while (true) {\n      const len = this.nodes[x].keys.length;\n      const i = lowerBoundStr(this.nodes[x].keys, target);\n      const isLeaf = this.nodes[x].kids.length == 0;\n      if (i < len && (compareStrings(this.nodes[x].keys[i], target) == 0)) {\n        if (isLeaf) {\n          if (!saved) {\n            removed = Some(this.nodes[x].vals[i]);\n          }\n          this.removeKey(x, i);\n          this.count -= 1;\n          return removed;\n        }\n        if (!saved) {\n          removed = Some(this.nodes[x].vals[i]);\n          saved = true;\n        }\n        const y = this.nodes[x].kids[i];\n        const z = this.nodes[x].kids[i + 1];\n        if (this.nodes[y].keys.length >= t) {\n          let w = y;\n          while (this.nodes[w].kids.length > 0) {\n            w = this.nodes[w].kids[this.nodes[w].kids.length - 1];\n          }\n          const last = this.nodes[w].keys.length - 1;\n          this.nodes[x].keys[i] = this.nodes[w].keys[last];\n          this.nodes[x].vals[i] = this.nodes[w].vals[last];\n          target = this.nodes[w].keys[last];\n          x = y;\n        } else if (this.nodes[z].keys.length >= t) {\n          let w = z;\n          while (this.nodes[w].kids.length > 0) {\n            w = this.nodes[w].kids[0];\n          }\n          this.nodes[x].keys[i] = this.nodes[w].keys[0];\n          this.nodes[x].vals[i] = this.nodes[w].vals[0];\n          target = this.nodes[w].keys[0];\n          x = z;\n        } else {\n          this.mergeChildren(x, i);\n          x = y;\n        }\n      } else {\n        if (isLeaf) {\n          return removed;\n        }\n        const c = this.nodes[x].kids[i];\n        if (this.nodes[c].keys.length < t) {\n          x = this.fill(x, i);\n        } else {\n          x = c;\n        }\n      }\n    }\n    return removed;\n  }\n\n  // firstKey(): the smallest key, None when empty. O(height).\n  @Ensures(result.isSome() == (this.size() > 0))\n  @Ensures(result.isSome() ==> this.has(result.unwrap()))\n  firstKey(): Option<string> {\n    if (this.count == 0) {\n      return None;\n    }\n    let x = this.root;\n    while (this.nodes[x].kids.length > 0) {\n      x = this.nodes[x].kids[0];\n    }\n    return Some(this.nodes[x].keys[0]);\n  }\n\n  // lastKey(): the largest key, None when empty. O(height).\n  @Ensures(result.isSome() == (this.size() > 0))\n  @Ensures(result.isSome() ==> this.has(result.unwrap()))\n  lastKey(): Option<string> {\n    if (this.count == 0) {\n      return None;\n    }\n    let x = this.root;\n    while (this.nodes[x].kids.length > 0) {\n      x = this.nodes[x].kids[this.nodes[x].kids.length - 1];\n    }\n    return Some(this.nodes[x].keys[this.nodes[x].keys.length - 1]);\n  }\n\n  // floorKey(k): the greatest key <= k, None when there is none. One descent. O(t log_t n).\n  @Ensures(result.isSome() ==> (compareStrings(result.unwrap(), k) <= 0) && this.has(result.unwrap()))\n  @Ensures(result.isNone() ==> this.firstKey().isNone() || (compareStrings(this.firstKey().unwrap(), k) > 0))\n  floorKey(k: string): Option<string> {\n    let best: Option<string> = None;\n    let x = this.root;\n    while (true) {\n      const i = lowerBoundStr(this.nodes[x].keys, k);\n      if (i < this.nodes[x].keys.length && (compareStrings(this.nodes[x].keys[i], k) == 0)) {\n        return Some(k);\n      }\n      if (i > 0) {\n        best = Some(this.nodes[x].keys[i - 1]);\n      }\n      if (this.nodes[x].kids.length == 0) {\n        return best;\n      }\n      x = this.nodes[x].kids[i];\n    }\n    return best;\n  }\n\n  // ceilKey(k): the smallest key >= k, None when there is none. One descent. O(t log_t n).\n  @Ensures(result.isSome() ==> (compareStrings(result.unwrap(), k) >= 0) && this.has(result.unwrap()))\n  @Ensures(result.isNone() ==> this.lastKey().isNone() || (compareStrings(this.lastKey().unwrap(), k) < 0))\n  ceilKey(k: string): Option<string> {\n    let best: Option<string> = None;\n    let x = this.root;\n    while (true) {\n      const i = lowerBoundStr(this.nodes[x].keys, k);\n      if (i < this.nodes[x].keys.length) {\n        if ((compareStrings(this.nodes[x].keys[i], k) == 0)) {\n          return Some(k);\n        }\n        best = Some(this.nodes[x].keys[i]);\n      }\n      if (this.nodes[x].kids.length == 0) {\n        return best;\n      }\n      x = this.nodes[x].kids[i];\n    }\n    return best;\n  }\n\n  // popFirst(): remove the entry with the smallest key and return it, None when empty. O(t log_t n).\n  @Ensures(result.isSome() == (old(this.size()) > 0))\n  @Ensures(result.isSome() ==> this.size() == old(this.size()) - 1 && !this.has(result.unwrap().key))\n  @Ensures(result.isSome() ==> (compareStrings(result.unwrap().key, old(this.firstKey().unwrapOr(\"\"))) == 0))\n  @Ensures(result.isSome() && this.size() > 0 ==> (compareStrings(this.firstKey().unwrap(), result.unwrap().key) > 0))\n  popFirst(): Option<SortedStringEntry<V>> {\n    const f = this.firstKey();\n    if (f.isNone()) {\n      return None;\n    }\n    const v = this.remove(f.unwrap()).unwrap();\n    return Some(SortedStringEntry<V> { key: f.unwrap(), value: v });\n  }\n\n  // popLast(): remove the entry with the largest key and return it, None when empty. O(t log_t n).\n  @Ensures(result.isSome() == (old(this.size()) > 0))\n  @Ensures(result.isSome() ==> this.size() == old(this.size()) - 1 && !this.has(result.unwrap().key))\n  @Ensures(result.isSome() ==> (compareStrings(result.unwrap().key, old(this.lastKey().unwrapOr(\"\"))) == 0))\n  @Ensures(result.isSome() && this.size() > 0 ==> (compareStrings(this.lastKey().unwrap(), result.unwrap().key) < 0))\n  popLast(): Option<SortedStringEntry<V>> {\n    const l = this.lastKey();\n    if (l.isNone()) {\n      return None;\n    }\n    const v = this.remove(l.unwrap()).unwrap();\n    return Some(SortedStringEntry<V> { key: l.unwrap(), value: v });\n  }\n\n  // keyArray(): all keys in increasing order. O(n).\n  @Ensures(result.length == this.size() && isStrictlyIncreasingStrings(result))\n  keyArray(): string[] {\n    return btreeStrKeys(this.nodes, this.root);\n  }\n\n  // valueArray(): all values in key order. O(n).\n  @Ensures(result.length == this.size())\n  valueArray(): V[] {\n    return btreeStrVals(this.nodes, this.root);\n  }\n\n  // clear(): remove all entries. O(1).\n  @Ensures(this.size() == 0)\n  clear(): void {\n    this.nodes = [StrNode<V> { keys: [], vals: [], kids: [] }];\n    this.root = 0;\n    this.free = [];\n    this.count = 0;\n  }\n}\n\n// END GENERATED\n\n// ------------------------------------------------------------------------------------- PriorityQueue\n\n// What `pop` and `peek` return.\nexport type PQEntry<T> = { priority: int; value: T; };\n\n// Does the entry (p1, s1) leave before (p2, s2)? Lower priority first; equal priorities by insertion number.\nfunction leavesBefore(p1: int, s1: int, p2: int, s2: int): bool {\n  return p1 < p2 || (p1 == p2 && s1 < s2);\n}\n\n// isMinHeap4(prios, seqs): every entry leaves strictly before its up to four children (children of i are\n// 4i+1 .. 4i+4, parent of i is (i-1)/4). Loop-based.\nexport function isMinHeap4(prios: int[], seqs: int[]): bool {\n  if (prios.length != seqs.length) {\n    return false;\n  }\n  let i: usize = 1;\n  while (i < prios.length) {\n    const p = (i - 1) / 4;\n    if (!leavesBefore(prios[p], seqs[p], prios[i], seqs[i])) {\n      return false;\n    }\n    i += 1;\n  }\n  return true;\n}\n\n// Are all insertion numbers in 0..bound-1?\nexport function seqsBelow(seqs: int[], bound: int): bool {\n  let i: usize = 0;\n  while (i < seqs.length) {\n    if (seqs[i] < 0 || seqs[i] >= bound) {\n      return false;\n    }\n    i += 1;\n  }\n  return true;\n}\n\nfunction minInt(a: int, b: int): int {\n  return a < b ? a : b;\n}\n\n// A min-priority queue on a 4-ary implicit heap. `push(priority, value)` adds a value; `pop` returns the entry\n// with the smallest priority, and among equal priorities the one pushed first. Storage is three parallel arrays\n// (priorities, insertion numbers, values: no per-entry allocation, and the comparison keys are contiguous), and\n// sifting moves a \"hole\" instead of swapping (one write per level instead of two). Measured on 200,000 random\n// pushes + pops: 4-ary 122 ms, binary with the same layout 164 ms, 8-ary 137 ms, the earlier binary heap of boxed\n// nodes with swaps 300 ms. Invariants: the three arrays have the same length, they form a heap (an entry leaves\n// strictly before its children) and every insertion number is below the counter `nextSeq`, which never decreases,\n// so insertion numbers are unique and the order is total.\n@Invariant(this.prios.length == this.seqs.length && this.prios.length == this.vals.length)\n@Invariant(isMinHeap4(this.prios, this.seqs))\n@Invariant(seqsBelow(this.seqs, this.nextSeq))\n@Invariant(this.nextSeq >= 0)\nexport class PriorityQueue<T> {\n  private prios: int[] = [];\n  private seqs: int[] = [];\n  private vals: T[] = [];\n  private nextSeq: int = 0;\n\n  // size(): number of queued entries. O(1).\n  @Ensures(result == this.prios.length)\n  size(): usize {\n    return this.prios.length;\n  }\n\n  // isEmpty(): nothing queued. O(1).\n  @Ensures(result == (this.size() == 0))\n  isEmpty(): bool {\n    return this.prios.length == 0;\n  }\n\n  // minPriority(): the smallest priority queued, None when empty. O(1).\n  @Ensures(result.isSome() == (this.size() > 0))\n  minPriority(): Option<int> {\n    if (this.prios.length == 0) {\n      return None;\n    }\n    return Some(this.prios[0]);\n  }\n\n  // allAtLeast(p): every queued priority is >= p. O(n).\n  @Ensures(this.size() == 0 ==> result)\n  @Ensures(result && this.size() > 0 ==> this.minPriority().unwrap() >= p)\n  allAtLeast(p: int): bool {\n    let i: usize = 0;\n    while (i < this.prios.length) {\n      if (this.prios[i] < p) {\n        return false;\n      }\n      i += 1;\n    }\n    return true;\n  }\n\n  // peek(): the entry `pop` would return, without removing it; None when empty. O(1).\n  @Ensures(result.isSome() == (this.size() > 0))\n  @Ensures(result.isSome() ==> result.unwrap().priority == this.minPriority().unwrap())\n  peek(): Option<PQEntry<T>> {\n    if (this.prios.length == 0) {\n      return None;\n    }\n    return Some(PQEntry<T> { priority: this.prios[0], value: this.vals[0] });\n  }\n\n  // push(priority, value): queue a value. O(log_4 n) comparisons, no allocation besides array growth.\n  @Ensures(this.size() == old(this.size()) + 1)\n  @Ensures(this.minPriority().unwrap() == minInt(priority, old(this.minPriority().unwrapOr(priority))))\n  @Ensures(this.allAtLeast(minInt(priority, old(this.minPriority().unwrapOr(priority)))))\n  push(priority: int, value: T): void {\n    const s = this.nextSeq;\n    this.nextSeq += 1;\n    let i = this.prios.length;\n    this.prios.push(priority);\n    this.seqs.push(s);\n    this.vals.push(value);\n    while (i > 0) {\n      const par = (i - 1) / 4;\n      if (!leavesBefore(priority, s, this.prios[par], this.seqs[par])) {\n        break;\n      }\n      this.prios[i] = this.prios[par];\n      this.seqs[i] = this.seqs[par];\n      this.vals[i] = this.vals[par];\n      i = par;\n    }\n    this.prios[i] = priority;\n    this.seqs[i] = s;\n    this.vals[i] = value;\n  }\n\n  // pop(): remove and return the entry with the smallest priority (the earliest pushed among equals); None when\n  // empty. The returned priority is <= every priority still queued. O(log_4 n) levels, up to 4 comparisons each.\n  @Ensures(result.isSome() == (old(this.size()) > 0))\n  @Ensures(result.isSome() ==> this.size() == old(this.size()) - 1)\n  @Ensures(result.isSome() ==> result.unwrap().priority == old(this.minPriority().unwrapOr(0)))\n  @Ensures(result.isSome() ==> this.allAtLeast(result.unwrap().priority))\n  @Ensures(result.isNone() ==> this.size() == 0)\n  pop(): Option<PQEntry<T>> {\n    if (this.prios.length == 0) {\n      return None;\n    }\n    const top = PQEntry<T> { priority: this.prios[0], value: this.vals[0] };\n    const lp = this.prios.pop().unwrap();\n    const ls = this.seqs.pop().unwrap();\n    const lv = this.vals.pop().unwrap();\n    const n = this.prios.length;\n    if (n > 0) {\n      let i: usize = 0;\n      while (true) {\n        const c = 4 * i + 1;\n        if (c >= n) {\n          break;\n        }\n        const end = c + 4 < n ? c + 4 : n;\n        let m = c;\n        let k = c + 1;\n        while (k < end) {\n          if (leavesBefore(this.prios[k], this.seqs[k], this.prios[m], this.seqs[m])) {\n            m = k;\n          }\n          k += 1;\n        }\n        if (!leavesBefore(this.prios[m], this.seqs[m], lp, ls)) {\n          break;\n        }\n        this.prios[i] = this.prios[m];\n        this.seqs[i] = this.seqs[m];\n        this.vals[i] = this.vals[m];\n        i = m;\n      }\n      this.prios[i] = lp;\n      this.seqs[i] = ls;\n      this.vals[i] = lv;\n    }\n    return Some(top);\n  }\n\n  // clear(): drop all entries. O(1).\n  @Ensures(this.size() == 0)\n  clear(): void {\n    this.prios = [];\n    this.seqs = [];\n    this.vals = [];\n  }\n}\n" });
  out.push(SourceFile { path: "$stdlib/fs.or", text: "// std:fs -- whole-file functions and streaming file access through the scope API (ADR-0025).\n//\n// UNSTABLE (ADR-0016 two-stage freeze): std I/O stays unstable until the project owner confirms the freeze. Every\n// function that touches the file system takes the FILE-SYSTEM GRANT (`FsGrant`, ADR-0027) as its first argument:\n// `readFile(fs, path)`, `withFile(fs, path, mode, body)`. A grant comes from `main(host: Host)` through std:host\n// (`useFs(host, fs => ...)`) and can be narrowed with `withUnder` / `withReadOnly` below; the scope shape and the `File`\n// methods did not change. The language rules for `File` and for grants are not unstable: see below.\n//\n// `File` is a RESOURCE HANDLE, not a value (spec 06): it can be passed to functions (borrowed) but not stored in a\n// record / class / array / Option / Result / Map, returned, assigned to another variable, captured by a closure,\n// compared or converted to string; those uses are compile errors E0450 / E0451 / E0452 (compiler/check/resources.or)\n// and, independently, MIR verifier errors (docs/mir.md, \"Resource handles\"). The only way to obtain one is a\n// scope function below: it opens the file, calls `body` with the handle as the body's PARAMETER, and closes the\n// file when `body` returns -- on every path, including when the result is later turned into an `Err`. A trap\n// inside `body` ends the process; the runtime flushes and closes open files in its exit hook, so bytes already\n// handed to `write` are not lost (a kill by signal still loses buffered bytes).\n//\n// Errors of reads/writes/flushes inside the scope are remembered by the file (the methods themselves stay\n// simple: `readLine(): Option<string>`, `write(s): void`); the scope function reports the first one as\n// `Err(FsError)` when it closes the file. A failed read looks like end of file to `body`.\n//\n// Why two flavours: a generic result `T` cannot be `void`; `withFile` returns the body's value, `useFile`\n// takes a body that returns nothing. Both exist for one file and for two files (`withFiles`, `useFiles`), which is how\n// you stream from one file to another: a handle cannot be captured by a nested scope's closure.\n//\n// Whole-file functions: readFile(fs, path): Result<string, string>, writeFile(fs, path, data):\n// Result<void, string>, exists(fs, path): bool. A refused operation (policy, scope, read-only) is an `Err` for the\n// functions that return a Result (and for the scope functions' open) and a trap for `exists`.\n//\n// Narrowing (ADR-0027): `withUnder(fs, dir, body)` runs `body` with a grant that only reaches paths inside `dir`\n// (compared after making both absolute and removing \".\" / \"..\" / repeated \"/\" -- and, for existing path prefixes,\n// after resolving symbolic links, so a link that leaves the scope does not work); `withReadOnly(fs, body)` with a\n// grant that cannot create, write or truncate. A narrowed grant never has more authority than its parent: asking for\n// a directory outside the parent's scope yields a grant that reaches nothing. Narrowed grants are handles like any\n// other (a scope parameter, no capture, no storing).\n\nimport { File, FsGrant, fileOpen, fileIsOpen, fileOpenError, fileClose, grantUnder, grantReadOnly, grantRevoke } from \"std:fsraw\";\n\nexport { readFile, writeFile, exists, File, FsGrant } from \"std:fsraw\";\n\n// Text of an error of this module (currently the human-readable message).\nexport type FsError = string;\n\n// How a file is opened: Read (the file must exist), Write (create or truncate), Append (create if missing,\n// every write goes to the end). A file opened with Read cannot be written and vice versa (the failed operation is\n// reported as an `Err` when the scope ends).\nexport type FileMode = Read | Write | Append;\n\nfunction modeCode(m: FileMode): int {\n  return match (m) {\n    Read => 0,\n    Write => 1,\n    Append => 2\n  };\n}\n\nfunction openMessage(path: string, h: File): string {\n  return \"cannot open '\" + path + \"': \" + fileOpenError(h);\n}\n\n// Close message of a handle: Some(error) if any operation failed.\nfunction firstError(a: Option<string>, b: Option<string>): Option<string> {\n  return match (a) {\n    Some(m) => Some(m),\n    None => b\n  };\n}\n\n// withFile<T>(fs, path, mode, body): Result<T, FsError>\n// Opens `path`, runs `body(file)`, closes the file, and returns `Ok(<body's value>)`; `Err(message)` if the file\n// cannot be opened (body is not called) or if any operation on it or the final flush/close failed (the body's\n// value is discarded). O(1) plus the work of `body`; at most 256 files can be open at once.\nexport function withFile<T>(fs: FsGrant, path: string, mode: FileMode, body: (file: File) => T): Result<T, FsError> {\n  const h = fileOpen(fs, path, modeCode(mode));\n  if (!fileIsOpen(h)) {\n    const msg = openMessage(path, h);\n    fileClose(h);\n    return Err(msg);\n  }\n  const r = body(h);\n  const e = fileClose(h);\n  return match (e) {\n    Some(m) => Err(m),\n    None => Ok(r)\n  };\n}\n\n// useFile(fs, path, mode, body): Result<void, FsError> -- `withFile` for a body that returns nothing.\nexport function useFile(fs: FsGrant, path: string, mode: FileMode, body: (file: File) => void): Result<void, FsError> {\n  const h = fileOpen(fs, path, modeCode(mode));\n  if (!fileIsOpen(h)) {\n    const msg = openMessage(path, h);\n    fileClose(h);\n    return Err(msg);\n  }\n  body(h);\n  const e = fileClose(h);\n  return match (e) {\n    Some(m) => Err(m),\n    None => Ok()\n  };\n}\n\n// withFiles<T>(fs, pathA, modeA, pathB, modeB, body): Result<T, FsError> -- two files open at the same time (for\n// example copying a file line by line). If the second cannot be opened the first is closed again.\nexport function withFiles<T>(\n  fs: FsGrant, pathA: string, modeA: FileMode, pathB: string, modeB: FileMode, body: (a: File, b: File) => T\n): Result<T, FsError> {\n  const a = fileOpen(fs, pathA, modeCode(modeA));\n  if (!fileIsOpen(a)) {\n    const msg = openMessage(pathA, a);\n    fileClose(a);\n    return Err(msg);\n  }\n  const b = fileOpen(fs, pathB, modeCode(modeB));\n  if (!fileIsOpen(b)) {\n    const msg = openMessage(pathB, b);\n    fileClose(b);\n    fileClose(a);\n    return Err(msg);\n  }\n  const r = body(a, b);\n  const eb = fileClose(b);\n  const ea = fileClose(a);\n  return match (firstError(ea, eb)) {\n    Some(m) => Err(m),\n    None => Ok(r)\n  };\n}\n\n// useFiles(fs, pathA, modeA, pathB, modeB, body): Result<void, FsError> -- `withFiles` for a body that returns nothing.\nexport function useFiles(\n  fs: FsGrant, pathA: string, modeA: FileMode, pathB: string, modeB: FileMode, body: (a: File, b: File) => void\n): Result<void, FsError> {\n  const a = fileOpen(fs, pathA, modeCode(modeA));\n  if (!fileIsOpen(a)) {\n    const msg = openMessage(pathA, a);\n    fileClose(a);\n    return Err(msg);\n  }\n  const b = fileOpen(fs, pathB, modeCode(modeB));\n  if (!fileIsOpen(b)) {\n    const msg = openMessage(pathB, b);\n    fileClose(b);\n    fileClose(a);\n    return Err(msg);\n  }\n  body(a, b);\n  const eb = fileClose(b);\n  const ea = fileClose(a);\n  return match (firstError(ea, eb)) {\n    Some(m) => Err(m),\n    None => Ok()\n  };\n}\n\n// withUnder<T>(fs, dir, body: (sub: FsGrant) => T): T -- a grant restricted to the directory `dir` (and below). `dir` may\n// be relative (to the working directory) or absolute. Not allowed to widen: if `dir` is not inside the scope of `fs`,\n// the result reaches nothing (every operation is refused). O(1) plus the work of `body`.\nexport function withUnder<T>(fs: FsGrant, dir: string, body: (sub: FsGrant) => T): T {\n  const g = grantUnder(fs, dir);\n  const r = body(g);\n  grantRevoke(g);\n  return r;\n}\n\n// useUnder(fs, dir, body) -- `withUnder` for a body that returns nothing.\nexport function useUnder(fs: FsGrant, dir: string, body: (sub: FsGrant) => void): void {\n  const g = grantUnder(fs, dir);\n  body(g);\n  grantRevoke(g);\n}\n\n// withReadOnly<T>(fs, body: (ro: FsGrant) => T): T -- a grant that can read but not create, write or truncate.\nexport function withReadOnly<T>(fs: FsGrant, body: (ro: FsGrant) => T): T {\n  const g = grantReadOnly(fs);\n  const r = body(g);\n  grantRevoke(g);\n  return r;\n}\n\n// useReadOnly(fs, body) -- `withReadOnly` for a body that returns nothing.\nexport function useReadOnly(fs: FsGrant, body: (ro: FsGrant) => void): void {\n  const g = grantReadOnly(fs);\n  body(g);\n  grantRevoke(g);\n}\n\n// withFileFs<T>(fs, path, mode, body: (file: File, fs: FsGrant) => T): Result<T, FsError> -- `withFile` whose body also\n// receives the SAME grant again as a parameter. A closure cannot capture a grant (the capture would let it outlive the\n// scope), so a body that must open further files (a nested scope, a recursive helper) gets the grant this way.\nexport function withFileFs<T>(fs: FsGrant, path: string, mode: FileMode, body: (file: File, fs: FsGrant) => T): Result<T, FsError> {\n  const h = fileOpen(fs, path, modeCode(mode));\n  if (!fileIsOpen(h)) {\n    const msg = openMessage(path, h);\n    fileClose(h);\n    return Err(msg);\n  }\n  const r = body(h, fs);\n  const e = fileClose(h);\n  return match (e) {\n    Some(m) => Err(m),\n    None => Ok(r)\n  };\n}\n" });
  out.push(SourceFile { path: "$stdlib/graph.or", text: "// std:graph -- Graph<T> with generational, graph-tagged node ids (spec 06 \"Cyclic graph\", ADR-0016, ADR-0026).\n//\n// Cyclic structures are not expressible with owning values (no owning cycles), so a graph owner\n// holds all nodes and edges are checked, non-owning `GraphId<T>` handles:\n//   * Each id carries the graph's tag, the slot index and the slot's generation. Removing a node\n//     bumps its slot's generation, so an id that outlived its node is STALE and every operation\n//     rejects it with `Err(StaleId)`; an id minted by a graph with a different tag is `Err(ForeignId)`.\n//     (An id whose index lies beyond the graph is also `ForeignId`.)\n//   * `Graph<T>` is a generic class (value semantics like every class): `let g = new Graph<string>(1);\n//     const a = g.add(\"alpha\");`. A copy (`const h = g`) is independent: later changes to `g` are not\n//     visible in `h` (an id removed in `g` is still valid in the older `h`: ids identify a node of one\n//     *tag*, generations track its history).\n//   * The tag is supplied by the caller: `new Graph<T>(tag)`. Use a different tag per logical graph.\n//     TODO(after global state): an automatic unique tag once the language has a process-wide counter.\n//   * Edges are directed and stored in the source slot as (index, generation) pairs. Removing a node\n//     does not touch edges pointing at it: they become dangling and `neighbors` silently skips them\n//     (an edge only counts while both ends are live with the generations recorded at addEdge time).\n//     Duplicate edges are allowed and reported once per addEdge call.\n//   * Complexity: `add`, `get`, `contains`, `size` are O(1) (freed slots are reused through a free list);\n//     `remove` is O(1); `neighbors` is O(out-degree), `ids` O(nodes). Mutating methods update the\n//     graph in place when it is not shared; a shared graph is copied on the first change (O(nodes)).\n//\n// TODO(after floats/map): `Map`-based index, edge weights.\n\n// Opaque handle of a node of a graph with value type T. `T` is only a phantom parameter that ties\n// the id to its graph's value type; obtain ids through `Graph.add`.\nexport type GraphId<T> = { tag: int; index: usize; gen: int; };\n\n// StaleId: the node was removed (the slot has a newer generation or is empty).\n// ForeignId: the id belongs to another graph (different tag) or does not name a slot at all.\nexport type GraphError = StaleId | ForeignId;\n\ntype Edge = { index: usize; gen: int; };\n\ntype Slot<T> = { gen: int; value: Option<T>; edges: Edge[]; };\n\n// graphErrorMessage(e: GraphError): string -- \"stale graph id\" / \"foreign graph id\". O(1).\nexport function graphErrorMessage(e: GraphError): string {\n  return match (e) {\n    StaleId => \"stale graph id\",\n    ForeignId => \"foreign graph id\"\n  };\n}\n\nexport class Graph<T> {\n  private tag: int;\n  private slots: Slot<T>[] = [];\n  private free: usize[] = [];\n  private live: usize = 0;\n\n  // new Graph<T>(tag): an empty graph. Ids minted by it are accepted only by graphs with the same `tag`.\n  constructor(tag: int) {\n    this.tag = tag;\n  }\n\n  // size(): usize -- number of live nodes. O(1).\n  size(): usize {\n    return this.live;\n  }\n\n  // Validates `id`: Ok(slot index) when it names a live node of this graph.\n  private lookup(id: GraphId<T>): Result<usize, GraphError> {\n    if (id.tag != this.tag || id.index >= this.slots.length) {\n      return Err(ForeignId);\n    }\n    if (this.slots[id.index].gen != id.gen || this.slots[id.index].value.isNone()) {\n      return Err(StaleId);\n    }\n    return Ok(id.index);\n  }\n\n  // contains(id): bool -- true when `id` names a live node of this graph. O(1).\n  contains(id: GraphId<T>): bool {\n    return this.lookup(id).isOk();\n  }\n\n  // add(value): GraphId<T>\n  // Adds a node (reusing a freed slot, whose generation `remove` already bumped) and returns its id.\n  // Never fails. O(1).\n  add(value: T): GraphId<T> {\n    if (this.free.length > 0) {\n      const i = this.free.pop().unwrap();\n      this.slots[i].value = Some(value);\n      this.live += 1;\n      return GraphId<T> { tag: this.tag, index: i, gen: this.slots[i].gen };\n    }\n    this.slots.push(Slot<T> { gen: 0, value: Some(value), edges: [] });\n    this.live += 1;\n    return GraphId<T> { tag: this.tag, index: this.slots.length - 1, gen: 0 };\n  }\n\n  // get(id): Result<T, GraphError>\n  // The value of a live node. Errors: StaleId (removed node), ForeignId (other graph). O(1).\n  get(id: GraphId<T>): Result<T, GraphError> {\n    const i = this.lookup(id)?;\n    return Ok(this.slots[i].value.unwrap());\n  }\n\n  // set(id, value): Result<void, GraphError>\n  // Replaces a live node's value (its edges and id stay). Errors as `get`. O(1).\n  set(id: GraphId<T>, value: T): Result<void, GraphError> {\n    const i = this.lookup(id)?;\n    this.slots[i].value = Some(value);\n    return Ok();\n  }\n\n  // remove(id): Result<T, GraphError>\n  // Removes a live node and its outgoing edges and returns its value. The slot generation is bumped\n  // (invalidating `id` and every copy of it) and the slot is freed for reuse. Edges of other nodes that\n  // pointed at it dangle and are skipped by `neighbors`. Errors as `get`. O(1).\n  remove(id: GraphId<T>): Result<T, GraphError> {\n    const i = this.lookup(id)?;\n    const old = this.slots[i].value.unwrap();\n    const gone: Option<T> = None;\n    this.slots[i].value = gone;\n    this.slots[i].gen += 1;\n    this.slots[i].edges = [];\n    this.free.push(i);\n    this.live -= 1;\n    return Ok(old);\n  }\n\n  // addEdge(a, b): Result<void, GraphError>\n  // Adds the directed edge a -> b (self loops and duplicates allowed). Both ids must be live in this\n  // graph; the first failing id's error is returned (`a` is checked first). O(1).\n  addEdge(a: GraphId<T>, b: GraphId<T>): Result<void, GraphError> {\n    const i = this.lookup(a)?;\n    const j = this.lookup(b)?;\n    this.slots[i].edges.push(Edge { index: j, gen: b.gen });\n    return Ok();\n  }\n\n  // neighbors(id): Result<GraphId<T>[], GraphError>\n  // The targets of the outgoing edges of a live node, in insertion order, skipping dangling edges\n  // (removed targets). Errors as `get`. O(out-degree).\n  neighbors(id: GraphId<T>): Result<GraphId<T>[], GraphError> {\n    const i = this.lookup(id)?;\n    let out: GraphId<T>[] = [];\n    for (const e of this.slots[i].edges) {\n      if (this.slots[e.index].gen == e.gen && this.slots[e.index].value.isSome()) {\n        out.push(GraphId<T> { tag: this.tag, index: e.index, gen: e.gen });\n      }\n    }\n    return Ok(out);\n  }\n\n  // ids(): GraphId<T>[] -- ids of all live nodes in slot order. O(nodes).\n  ids(): GraphId<T>[] {\n    let out: GraphId<T>[] = [];\n    let i: usize = 0;\n    while (i < this.slots.length) {\n      if (this.slots[i].value.isSome()) {\n        out.push(GraphId<T> { tag: this.tag, index: i, gen: this.slots[i].gen });\n      }\n      i += 1;\n    }\n    return out;\n  }\n}\n" });
  out.push(SourceFile { path: "$stdlib/host.or", text: "// std:host -- the root of authority (ADR-0021 Stage A, ADR-0027).\n//\n// UNSTABLE (ADR-0016 two-stage freeze): std I/O stays unstable until the project owner confirms the freeze.\n//\n// A program that performs I/O declares `function main(host: Host): void`. `Host` is the program's handle on the\n// machine it runs on: a RESOURCE HANDLE (ADR-0025 rules: it can only be passed as an argument; it cannot be stored in\n// a variable, record, class or array, returned, captured by a closure, copied or compared) that only the runtime\n// can create. `main()` without the parameter has NO I/O authority: every std I/O function takes a grant as its first\n// argument, so such a program cannot call one (compile error E0470).\n//\n// From the Host a program derives grants, one per family of operation (the \"root operation families\"):\n//   FsGrant       std:fs       open / read / write / exist files (further narrowed by `withUnder`, `withReadOnly`)\n//   ProcessGrant  std:process  `args`, `shell` (further narrowed by `withArgsOnly`: no spawning)\n//   StdioGrant    std:io       read stdin, `writeStdout`\n//   ClockGrant    std:time     `nowMillis`\n//   NetGrant      std:net      listen / connect / resolve (`useNet`; narrowed by `useListen`, `useConnect`)\n// (`useHost` hands out the first four only: take the network grant with `useNet`.) `console.log` / `console.error` and\n// `exit` need no grant (ADR-0027, \"ambient output\"); they are still recorded as primitive OUTPUT / CONTROL events by\n// the OSIG.\n//\n// A grant is obtained only through a SCOPE function: it creates the grant, calls `body` with the grant as the body's\n// PARAMETER and revokes it when `body` returns, on every path. Because a handle cannot be captured, a nested scope\n// cannot use the outer grant: take every grant you need at once with `withHost` / `useHost`, or pass grants on as\n// arguments. Two flavours, as in std:fs: `with*` returns the body's value, `use*` takes a body that returns nothing.\n//\n// The host policy decides what the OS process may give: by default everything the process has; the environment\n// variable ORIN_DENY (a comma-separated list of: fs, process, stdio, clock, net, all) denies families. A denied family is\n// still handed out (the program type-checks and runs); every operation then reports `Err(\"... denied by the host\n// policy (ORIN_DENY)\")` if it returns a Result, and traps (\"capability denied: ...\") otherwise.\n//\n// The raw primitives (grantFs, grantRevoke ... of the internal module std:fsraw) can only be used by the std\n// library: user code cannot name them (E0301), so it cannot create, copy or forge a grant.\n\nimport {\n  Host, FsGrant, ProcessGrant, StdioGrant, ClockGrant, NetGrant, grantNet, grantFs, grantProcess, grantStdio, grantClock, grantArgsOnly, grantRevoke\n} from \"std:fsraw\";\n\nexport { Host } from \"std:fsraw\";\n\n// withFs<T>(host, body: (fs: FsGrant) => T): T -- the file-system grant of the host policy (the whole file system,\n// unless the policy denies `fs`). Revoked when `body` returns.\nexport function withFs<T>(host: Host, body: (fs: FsGrant) => T): T {\n  const g = grantFs(host);\n  const r = body(g);\n  grantRevoke(g);\n  return r;\n}\n\n// useFs(host, body: (fs: FsGrant) => void): void -- `withFs` for a body that returns nothing.\nexport function useFs(host: Host, body: (fs: FsGrant) => void): void {\n  const g = grantFs(host);\n  body(g);\n  grantRevoke(g);\n}\n\n// withProcess / useProcess: the process grant (`args`, `shell`).\nexport function withProcess<T>(host: Host, body: (proc: ProcessGrant) => T): T {\n  const g = grantProcess(host);\n  const r = body(g);\n  grantRevoke(g);\n  return r;\n}\n\nexport function useProcess(host: Host, body: (proc: ProcessGrant) => void): void {\n  const g = grantProcess(host);\n  body(g);\n  grantRevoke(g);\n}\n\n// withStdio / useStdio: the stdin / stdout grant of std:io.\nexport function withStdio<T>(host: Host, body: (stdio: StdioGrant) => T): T {\n  const g = grantStdio(host);\n  const r = body(g);\n  grantRevoke(g);\n  return r;\n}\n\nexport function useStdio(host: Host, body: (stdio: StdioGrant) => void): void {\n  const g = grantStdio(host);\n  body(g);\n  grantRevoke(g);\n}\n\n// withClock / useClock: the clock grant of std:time.\nexport function withClock<T>(host: Host, body: (clock: ClockGrant) => T): T {\n  const g = grantClock(host);\n  const r = body(g);\n  grantRevoke(g);\n  return r;\n}\n\nexport function useClock(host: Host, body: (clock: ClockGrant) => void): void {\n  const g = grantClock(host);\n  body(g);\n  grantRevoke(g);\n}\n\n// withNet / useNet: the network grant (std:net, ADR-0033): may listen and connect anywhere the host policy allows (unless\n// the policy denies `net`: then every network operation is refused). Narrow it with `useListen` / `useConnect` of std:net.\nexport function withNet<T>(host: Host, body: (net: NetGrant) => T): T {\n  const g = grantNet(host);\n  const r = body(g);\n  grantRevoke(g);\n  return r;\n}\n\nexport function useNet(host: Host, body: (net: NetGrant) => void): void {\n  const g = grantNet(host);\n  body(g);\n  grantRevoke(g);\n}\n\n// withHost / useHost: all four grants at once (the usual shape of a command line program's main).\nexport function withHost<T>(\n  host: Host, body: (fs: FsGrant, proc: ProcessGrant, stdio: StdioGrant, clock: ClockGrant) => T\n): T {\n  const f = grantFs(host);\n  const p = grantProcess(host);\n  const s = grantStdio(host);\n  const c = grantClock(host);\n  const r = body(f, p, s, c);\n  grantRevoke(c);\n  grantRevoke(s);\n  grantRevoke(p);\n  grantRevoke(f);\n  return r;\n}\n\nexport function useHost(\n  host: Host, body: (fs: FsGrant, proc: ProcessGrant, stdio: StdioGrant, clock: ClockGrant) => void\n): void {\n  const f = grantFs(host);\n  const p = grantProcess(host);\n  const s = grantStdio(host);\n  const c = grantClock(host);\n  body(f, p, s, c);\n  grantRevoke(c);\n  grantRevoke(s);\n  grantRevoke(p);\n  grantRevoke(f);\n}\n\n// withArgsOnly(proc, body: (p: ProcessGrant) => T): T -- a process grant that can read `args` but not spawn (`shell`\n// traps with \"capability denied\"). Narrowing only restricts: the new grant never has more authority than `proc`.\nexport function withArgsOnly<T>(proc: ProcessGrant, body: (p: ProcessGrant) => T): T {\n  const g = grantArgsOnly(proc);\n  const r = body(g);\n  grantRevoke(g);\n  return r;\n}\n\nexport function useArgsOnly(proc: ProcessGrant, body: (p: ProcessGrant) => void): void {\n  const g = grantArgsOnly(proc);\n  body(g);\n  grantRevoke(g);\n}\n" });
  out.push(SourceFile { path: "$stdlib/http.or", text: "// std:http -- the pure part of HTTP/1.1 (RFC 9110, RFC 9112): message types, an incremental request and response\n// parser, and a serializer. Pure safe Orin over `std:bytes`: no sockets, no I/O, no grants, no C (ADR-0030 \xc2\xa73,\n// layer \"protocols\"). The network part (`std:net`, the server loop) comes later with ADR-0033.\n//\n// Why strict. Most HTTP request smuggling and response splitting attacks work because two parsers on one path\n// disagree about where a message ends or which header says what. This module therefore REJECTS every ambiguity\n// instead of guessing (RFC 9112 \xc2\xa76.3, \xc2\xa711.2 and \xc2\xa711.3):\n//\n//   * both `Content-Length` and `Transfer-Encoding`, a duplicate or non-numeric `Content-Length`, a duplicate\n//     `Transfer-Encoding`, any transfer coding other than `chunked`;\n//   * obs-fold (a header line that starts with SP or HTAB), whitespace between a field name and the colon, a bare\n//     LF or a bare CR where CRLF is required, any control character or NUL in a start line, field, chunk header\n//     or chunk extension, invalid token characters in a method or field name;\n//   * chunk sizes that are empty, not hexadecimal (`-1`, `0x10`, `+5`), or larger than the remaining body limit\n//     (so the size can never overflow); a chunk that is not followed by CRLF;\n//   * HTTP/1.1 requests without exactly one valid `Host` field, framing fields (Content-Length, Transfer-Encoding,\n//     Trailer, Host) in trailers.\n//\n// Limits are part of the parser (`Limits`, invariants below): request/status line length, header line length,\n// total header section size, header count, chunk header line length and body size. A message that exceeds a limit\n// is an error at the first byte over the limit, never a truncated parse.\n//\n// Incremental parsing. `RequestParser.feed(chunk)` takes bytes in arbitrary chunks (as `recv` delivers them) and\n// answers `NeedMore` (every byte of the chunk was consumed into the parser state), `Done(message, used)` (the\n// message is complete; `used` bytes of THIS chunk belonged to it, the rest `chunk[used..]` is the start of the next\n// pipelined message) or `Failed(HttpError)` (position = byte offset from the start of the message, reason, text).\n// A partial message is never returned as complete. The result for a message is independent of how the bytes are\n// split into chunks (tests: every split point, 1-byte chunks, random splits).\n//\n// The state machine (explicit: `S_*` constants, `edgeAllowed`, class invariants). A request starts in METHOD, a\n// response in VERSION:\n//\n//   request   METHOD -> TARGET -> VERSION -> START_LF\n//   response  VERSION -> CODE -> REASON -> START_LF\n//   START_LF -> HDR_LINE <-> (HDR_NAME -> HDR_OWS -> HDR_VALUE -> HDR_LF)     one cycle per header field\n//   HDR_LINE -> HEAD_END_LF          the empty line; then, decided by the framing rules (RFC 9112 \xc2\xa76.3):\n//        HEAD_END_LF -> DONE                          no body (or Content-Length 0, HEAD, 1xx, 204, 304)\n//        HEAD_END_LF -> BODY -> DONE                  Content-Length\n//        HEAD_END_LF -> BODY_CLOSE -> (atEof) DONE    responses only: the body ends when the connection closes\n//        HEAD_END_LF -> CHUNK_SIZE -> [CHUNK_BWS] -> [CHUNK_EXT] -> CHUNK_SIZE_LF        Transfer-Encoding: chunked\n//          CHUNK_SIZE_LF -> CHUNK_DATA -> CHUNK_CR -> CHUNK_LF -> CHUNK_SIZE              (size > 0)\n//          CHUNK_SIZE_LF -> HDR_LINE ... HEAD_END_LF -> DONE                               (size 0: the trailer section)\n//   any non-terminal state -> ERROR (sticky); DONE and ERROR are terminal until `reset()`.\n//\n// Algorithm. One forward pass, no backtracking, no regex, no look-ahead. Bytes are classified by a 256-entry table\n// (`HTTP_CLASS`: control, LF, CR, HTAB, SP, obs-text, other VCHAR, `:`, `;`, token symbol, letter, hex letter,\n// digit; ordered so that \"is a token character\" is `class >= 10` and \"may occur in a field value\" is `class >= 3`)\n// and `HTTP_HEXV` (hex digit value or 16). Orin has no constant arrays, so both are string constants read with\n// `charCodeAt` like the DFA tables of std:utf8. Runs of ordinary bytes (a method, a header name, a header value) are\n// scanned in a tight loop and handled once per run, not once per byte; the state changes once per token. The loops\n// index the chunk's storage array (`Bytes.storage`, no copy) instead of calling `Bytes.at` per byte; a body is a\n// slice of the chunk and is never scanned. Measured throughput and the cost model: docs/std.md.\n//\n// Contract standard (ADR-0030 \xc2\xa73): classes carry `@Invariant`s that `orin test` checks after every public method;\n// `Headers`, `Status`, `Request`, `Response` validate in their constructors in EVERY build (a header with CR/LF\n// cannot be built: header injection is impossible by construction), the guards that run in every build are loops\n// (`allTokens`, `allFieldValues`: no closure call per element on the hot path) while contract clauses may state the\n// same facts with `every` / `some` / `filter` (ADR-0031 A: `Headers.has`, `countOf`, `getAll`), and\n// `serializeRequest` / `serializeResponse` ENSURE that the parser accepts the output and reproduces the message\n// (the round-trip contract).\n//\n// Not covered: HTTP/2 and HTTP/3, TLS, sockets, content codings (gzip), `Expect: 100-continue` handling,\n// connection management, URI parsing beyond the shape checks of `isValidTarget`, cookies and any header semantics\n// other than the framing and `Host` rules above.\n\nimport { Bytes, ByteBuilder, bytesFromString, emptyBytes } from \"std:bytes\";\n\n// ------------------------------------------------------------------------------------ character classes\n\n// Class codes of `HTTP_CLASS` (see the algorithm note above). Generated from the RFC 9110 / 9112 character sets\n// by tools/gen_http_tables.py; tests/std/http_test.or recomputes every entry from the RFC definitions.\nconst C_CTL: int = 0;\nconst C_LF: int = 1;\nconst C_CR: int = 2;\nconst C_HTAB: int = 3;\nconst C_SP: int = 4;\nconst C_OBS: int = 5;\nconst C_COLON: int = 7;\nconst C_SEMI: int = 8;\nconst C_TOKEN: int = 10;\nconst C_HEXALPHA: int = 12;\nconst C_DIGIT: int = 13;\n\nconst HTTP_CLASS: string = \"\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x03\\x01\\x00\\x00\\x02\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x04\\x0a\\x06\\x0a\\x0a\\x0a\\x0a\\x0a\\x06\\x06\\x0a\\x0a\\x06\\x0a\\x0a\\x06\\x0d\\x0d\\x0d\\x0d\\x0d\\x0d\\x0d\\x0d\\x0d\\x0d\\x07\\x08\\x06\\x06\\x06\\x06\\x06\\x0c\\x0c\\x0c\\x0c\\x0c\\x0c\\x0b\\x0b\\x0b\\x0b\\x0b\\x0b\\x0b\\x0b\\x0b\\x0b\\x0b\\x0b\\x0b\\x0b\\x0b\\x0b\\x0b\\x0b\\x0b\\x0b\\x06\\x06\\x06\\x0a\\x0a\\x0a\\x0c\\x0c\\x0c\\x0c\\x0c\\x0c\\x0b\\x0b\\x0b\\x0b\\x0b\\x0b\\x0b\\x0b\\x0b\\x0b\\x0b\\x0b\\x0b\\x0b\\x0b\\x0b\\x0b\\x0b\\x0b\\x0b\\x06\\x0a\\x06\\x0a\\x00\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\";\nconst HTTP_HEXV: string = \"\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x00\\x01\\x02\\x03\\x04\\x05\\x06\\x07\\x08\\x09\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x0a\\x0b\\x0c\\x0d\\x0e\\x0f\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x0a\\x0b\\x0c\\x0d\\x0e\\x0f\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\";\n\n\n// charClass(c): the class code of byte value c (0..255). O(1).\n@Requires(c >= 0 && c <= 255)\n@Ensures(result >= 0 && result <= 13)\nexport function charClass(c: int): int {\n  return HTTP_CLASS.charCodeAt(c.toUsize());\n}\n\n// isTokenChar(c): c is a `tchar` (RFC 9110 \xc2\xa75.6.2): ALPHA, DIGIT or one of !#$%&'*+-.^_`|~. O(1).\n@Requires(c >= 0 && c <= 255)\nexport function isTokenChar(c: int): bool {\n  return HTTP_CLASS.charCodeAt(c.toUsize()) >= C_TOKEN;\n}\n\n// isFieldByte(c): c may occur inside a field value or a reason phrase: HTAB, SP, VCHAR or obs-text. O(1).\n@Requires(c >= 0 && c <= 255)\nexport function isFieldByte(c: int): bool {\n  return HTTP_CLASS.charCodeAt(c.toUsize()) >= C_HTAB;\n}\n\n// isOws(c): SP or HTAB. O(1).\nfunction isOws(c: int): bool {\n  return c == 32 || c == 9;\n}\n\n// lowerAscii(c): the lower-case form of an ASCII letter code, other codes unchanged. O(1).\nfunction lowerAscii(c: int): int {\n  if (c >= 65 && c <= 90) {\n    return c + 32;\n  }\n  return c;\n}\n\n// eqIgnoreCase(a, b): equal after ASCII lower-casing (header names, RFC 9110 \xc2\xa75.1). O(n).\n@Ensures(result ==> a.length == b.length)\nexport function eqIgnoreCase(a: string, b: string): bool {\n  if (a.length != b.length) {\n    return false;\n  }\n  let i: usize = 0;\n  while (i < a.length) {\n    if (lowerAscii(a.charCodeAt(i)) != lowerAscii(b.charCodeAt(i))) {\n      return false;\n    }\n    i += 1;\n  }\n  return true;\n}\n\n// toLowerAscii(s): s with ASCII letters lower-cased; other bytes (including obs-text) unchanged. O(n).\n@Ensures(result.length == s.length)\n@Ensures(s.length > 0 ==> result.charCodeAt(0) == lowerAscii(s.charCodeAt(0)))\n@Ensures(s.length > 0 ==> result.charCodeAt(s.length - 1) == lowerAscii(s.charCodeAt(s.length - 1)))\nexport function toLowerAscii(s: string): string {\n  let out = \"\";\n  let i: usize = 0;\n  while (i < s.length) {\n    out += String.fromCharCode(lowerAscii(s.charCodeAt(i)));\n    i += 1;\n  }\n  return out;\n}\n\n// isToken(s): a non-empty run of token characters (a method or a field name). O(n).\n@Ensures(result ==> s.length > 0)\nexport function isToken(s: string): bool {\n  if (s.length == 0) {\n    return false;\n  }\n  let i: usize = 0;\n  while (i < s.length) {\n    if (HTTP_CLASS.charCodeAt(s.charCodeAt(i).toUsize()) < C_TOKEN) {\n      return false;\n    }\n    i += 1;\n  }\n  return true;\n}\n\n// isFieldValue(s): a valid field value: only HTAB, SP, VCHAR and obs-text (so no CR, LF, NUL or other control\n// character), no leading or trailing SP/HTAB (the parser strips optional whitespace, so a stored value is\n// canonical). The empty string is valid. O(n).\n@Ensures(result ==> s.length == 0 || (!isOws(s.charCodeAt(0)) && !isOws(s.charCodeAt(s.length - 1))))\nexport function isFieldValue(s: string): bool {\n  if (s.length == 0) {\n    return true;\n  }\n  if (isOws(s.charCodeAt(0)) || isOws(s.charCodeAt(s.length - 1))) {\n    return false;\n  }\n  let i: usize = 0;\n  while (i < s.length) {\n    if (HTTP_CLASS.charCodeAt(s.charCodeAt(i).toUsize()) < C_HTAB) {\n      return false;\n    }\n    i += 1;\n  }\n  return true;\n}\n\n// isReasonPhrase(s): `*( HTAB / SP / VCHAR / obs-text )`; may be empty and may have leading or trailing blanks\n// (the status line keeps it byte for byte). O(n).\nexport function isReasonPhrase(s: string): bool {\n  let i: usize = 0;\n  while (i < s.length) {\n    if (HTTP_CLASS.charCodeAt(s.charCodeAt(i).toUsize()) < C_HTAB) {\n      return false;\n    }\n    i += 1;\n  }\n  return true;\n}\n\n// Characters of a `Host` value / authority (RFC 3986 reg-name, IP-literal and port, without userinfo):\n// unreserved, `%`, sub-delims, `:`, `[`, `]`.\nfunction isHostChar(c: int): bool {\n  if ((c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122)) {\n    return true;\n  }\n  return c == 45 || c == 46 || c == 95 || c == 126 || c == 37 || c == 33 || c == 36 || c == 38 || c == 39\n    || c == 40 || c == 41 || c == 42 || c == 43 || c == 44 || c == 59 || c == 61 || c == 58 || c == 91 || c == 93;\n}\n\n// isHostValue(s): a plausible `Host` field value or CONNECT authority: only host characters (no SP, `/`, `@`, `?`,\n// `#`). The empty string is allowed here (an empty authority is legal in `Host`). O(n).\nexport function isHostValue(s: string): bool {\n  let i: usize = 0;\n  while (i < s.length) {\n    if (!isHostChar(s.charCodeAt(i))) {\n      return false;\n    }\n    i += 1;\n  }\n  return true;\n}\n\n// parseContentLength(v): the value of a `Content-Length` field: 1 to 18 decimal digits (so it fits every integer\n// type; larger values are refused instead of overflowing). No sign, no blanks, no list. O(n).\n@Ensures(result.isSome() ==> v.length >= 1 && v.length <= 18)\nexport function parseContentLength(v: string): Option<usize> {\n  if (v.length == 0 || v.length > 18) {\n    return None;\n  }\n  let n: usize = 0;\n  let i: usize = 0;\n  while (i < v.length) {\n    const c = v.charCodeAt(i);\n    if (c < 48 || c > 57) {\n      return None;\n    }\n    n = n * 10 + (c - 48).toUsize();\n    i += 1;\n  }\n  return Some(n);\n}\n\n// A request-target may contain only 0x21..0x7E (everything else must be percent-encoded) and no fragment `#`.\nfunction isTargetChars(s: string): bool {\n  if (s.length == 0) {\n    return false;\n  }\n  let i: usize = 0;\n  while (i < s.length) {\n    const c = s.charCodeAt(i);\n    if (HTTP_CLASS.charCodeAt(c.toUsize()) < 6 || c == 35) {\n      return false;\n    }\n    i += 1;\n  }\n  return true;\n}\n\n// scheme \"://\" rest, scheme = ALPHA *( ALPHA / DIGIT / \"+\" / \"-\" / \".\" )  (absolute-form, RFC 9112 \xc2\xa73.2.2).\nfunction isAbsoluteForm(s: string): bool {\n  if (s.length < 4) {\n    return false;\n  }\n  const c0 = lowerAscii(s.charCodeAt(0));\n  if (c0 < 97 || c0 > 122) {\n    return false;\n  }\n  let i: usize = 1;\n  while (i < s.length) {\n    const c = s.charCodeAt(i);\n    const l = lowerAscii(c);\n    if (!((l >= 97 && l <= 122) || (c >= 48 && c <= 57) || c == 43 || c == 45 || c == 46)) {\n      break;\n    }\n    i += 1;\n  }\n  return i + 3 < s.length && s.charCodeAt(i) == 58 && s.charCodeAt(i + 1) == 47 && s.charCodeAt(i + 2) == 47;\n}\n\n// ----------------------------------------------------------------------------------------- small types\n\n// The protocol versions this module speaks. Other versions (`HTTP/0.9`, `HTTP/2.0`) are rejected by the parsers.\nexport type HttpVersion = Http10 | Http11;\n\n// versionText(v): \"HTTP/1.0\" or \"HTTP/1.1\". O(1).\n@Ensures(result.length == 8)\nexport function versionText(v: HttpVersion): string {\n  return match (v) {\n    Http10 => \"HTTP/1.0\",\n    Http11 => \"HTTP/1.1\"\n  };\n}\n\n// versionMinor(v): 0 or 1. O(1).\n@Ensures(result == 0 || result == 1)\nexport function versionMinor(v: HttpVersion): int {\n  return match (v) {\n    Http10 => 0,\n    Http11 => 1\n  };\n}\n\n// The request methods of RFC 9110 \xc2\xa79 plus RFC 5789 `PATCH`, and `Ext(token)` for any other token. The canonical\n// form (what the parser produces and the invariants of `Request` demand): a standard method is never an `Ext`.\nexport type Method = Get | Head | Post | Put | Delete | Connect | Options | Trace | Patch | Ext(string);\n\n// methodName(m): the method token, e.g. \"GET\". O(1).\n@Ensures(result.length > 0 || !isValidMethod(m))\nexport function methodName(m: Method): string {\n  return match (m) {\n    Get => \"GET\",\n    Head => \"HEAD\",\n    Post => \"POST\",\n    Put => \"PUT\",\n    Delete => \"DELETE\",\n    Connect => \"CONNECT\",\n    Options => \"OPTIONS\",\n    Trace => \"TRACE\",\n    Patch => \"PATCH\",\n    Ext(t) => t\n  };\n}\n\n// isStandardMethodName(t): t is the exact (case-sensitive) name of one of the nine standard methods. O(1).\nfunction isStandardMethodName(t: string): bool {\n  return t == \"GET\" || t == \"HEAD\" || t == \"POST\" || t == \"PUT\" || t == \"DELETE\" || t == \"CONNECT\" || t == \"OPTIONS\"\n    || t == \"TRACE\" || t == \"PATCH\";\n}\n\n// isValidMethod(m): canonical and well-formed: a standard method, or `Ext(t)` with a token `t` that is not a\n// standard method name. O(n).\nexport function isValidMethod(m: Method): bool {\n  return match (m) {\n    Ext(t) => isToken(t) && !isStandardMethodName(t),\n    _ => true\n  };\n}\n\n// methodFromToken(t): the method with name t; None when t is not a token. Method names are case-sensitive:\n// \"get\" is `Ext(\"get\")`. O(n).\n@Ensures(result.isSome() == isToken(t))\n@Ensures(result.isSome() ==> isValidMethod(result.unwrap()) && methodName(result.unwrap()) == t)\nexport function methodFromToken(t: string): Option<Method> {\n  if (!isToken(t)) {\n    return None;\n  }\n  return match (t) {\n    \"GET\" => Some(Get),\n    \"HEAD\" => Some(Head),\n    \"POST\" => Some(Post),\n    \"PUT\" => Some(Put),\n    \"DELETE\" => Some(Delete),\n    \"CONNECT\" => Some(Connect),\n    \"OPTIONS\" => Some(Options),\n    \"TRACE\" => Some(Trace),\n    \"PATCH\" => Some(Patch),\n    _ => Some(Ext(t))\n  };\n}\n\n// isConnect(m) / isOptions(m): used by the request-target rules.\nfunction isConnect(m: Method): bool {\n  return match (m) {\n    Connect => true,\n    _ => false\n  };\n}\n\nfunction isOptions(m: Method): bool {\n  return match (m) {\n    Options => true,\n    _ => false\n  };\n}\n\n// methodEquals(a, b): the same method. O(n).\nexport function methodEquals(a: Method, b: Method): bool {\n  return methodName(a) == methodName(b);\n}\n\n// isValidTarget(m, target): the request-target has a legal shape for the method (RFC 9112 \xc2\xa73.2): `CONNECT` takes an\n// authority (`host:port`); `OPTIONS` also takes `*`; every method takes origin-form (`/path?query`) or\n// absolute-form (`scheme://authority/path`). Only the characters 0x21..0x7E occur and there is no fragment. O(n).\n@Ensures(result ==> target.length > 0)\nexport function isValidTarget(m: Method, target: string): bool {\n  if (isConnect(m)) {\n    return target.length > 0 && isHostValue(target);\n  }\n  if (!isTargetChars(target)) {\n    return false;\n  }\n  if (target == \"*\") {\n    return isOptions(m);\n  }\n  return target.charCodeAt(0) == 47 || isAbsoluteForm(target);\n}\n\n// ----------------------------------------------------------------------------------------------- errors\n\n// Why a message was refused. One variant per rule, so that callers (and tests) can tell the cases apart.\nexport type HttpReason =\n  BadMethod | BadTarget | BadVersion | UnsupportedVersion | BadStatusCode | BadStatusLine\n  | BadHeaderName | MissingColon | SpaceBeforeColon | BadHeaderValue | ObsFold | BareLf | BareCr\n  | StartLineTooLong | HeaderLineTooLong | HeadersTooLarge | TooManyHeaders | BodyTooLarge | ChunkLineTooLong\n  | BadContentLength | DuplicateContentLength | ContentLengthWithTransferEncoding | DuplicateTransferEncoding\n  | UnsupportedTransferEncoding | ForbiddenFraming | MissingHost | DuplicateHost | BadHost\n  | BadChunkSize | BadChunkExtension | BadChunkTerminator | ForbiddenTrailer\n  | UnexpectedEof | ParserFinished;\n\n// reasonName(r): the variant name, stable (for logs and tests). O(1).\n@Ensures(result.length > 0)\nexport function reasonName(r: HttpReason): string {\n  return match (r) {\n    BadMethod => \"BadMethod\",\n    BadTarget => \"BadTarget\",\n    BadVersion => \"BadVersion\",\n    UnsupportedVersion => \"UnsupportedVersion\",\n    BadStatusCode => \"BadStatusCode\",\n    BadStatusLine => \"BadStatusLine\",\n    BadHeaderName => \"BadHeaderName\",\n    MissingColon => \"MissingColon\",\n    SpaceBeforeColon => \"SpaceBeforeColon\",\n    BadHeaderValue => \"BadHeaderValue\",\n    ObsFold => \"ObsFold\",\n    BareLf => \"BareLf\",\n    BareCr => \"BareCr\",\n    StartLineTooLong => \"StartLineTooLong\",\n    HeaderLineTooLong => \"HeaderLineTooLong\",\n    HeadersTooLarge => \"HeadersTooLarge\",\n    TooManyHeaders => \"TooManyHeaders\",\n    BodyTooLarge => \"BodyTooLarge\",\n    ChunkLineTooLong => \"ChunkLineTooLong\",\n    BadContentLength => \"BadContentLength\",\n    DuplicateContentLength => \"DuplicateContentLength\",\n    ContentLengthWithTransferEncoding => \"ContentLengthWithTransferEncoding\",\n    DuplicateTransferEncoding => \"DuplicateTransferEncoding\",\n    UnsupportedTransferEncoding => \"UnsupportedTransferEncoding\",\n    ForbiddenFraming => \"ForbiddenFraming\",\n    MissingHost => \"MissingHost\",\n    DuplicateHost => \"DuplicateHost\",\n    BadHost => \"BadHost\",\n    BadChunkSize => \"BadChunkSize\",\n    BadChunkExtension => \"BadChunkExtension\",\n    BadChunkTerminator => \"BadChunkTerminator\",\n    ForbiddenTrailer => \"ForbiddenTrailer\",\n    UnexpectedEof => \"UnexpectedEof\",\n    ParserFinished => \"ParserFinished\"\n  };\n}\n\n// reasonText(r): a sentence naming the violated rule. O(1).\n@Ensures(result.length > 0)\nexport function reasonText(r: HttpReason): string {\n  return match (r) {\n    BadMethod => \"invalid character in the method (not a token)\",\n    BadTarget => \"invalid request-target\",\n    BadVersion => \"malformed HTTP version\",\n    UnsupportedVersion => \"unsupported HTTP version (only HTTP/1.0 and HTTP/1.1)\",\n    BadStatusCode => \"the status code must be three digits in 100..599\",\n    BadStatusLine => \"malformed status line\",\n    BadHeaderName => \"invalid character in a field name (not a token)\",\n    MissingColon => \"a header line without a colon\",\n    SpaceBeforeColon => \"whitespace between the field name and the colon\",\n    BadHeaderValue => \"control character in a field value\",\n    ObsFold => \"obsolete line folding (a header line that starts with SP or HTAB)\",\n    BareLf => \"bare LF: a line must end with CRLF\",\n    BareCr => \"bare CR: a CR must be followed by LF\",\n    StartLineTooLong => \"the start line exceeds the limit\",\n    HeaderLineTooLong => \"a header line exceeds the limit\",\n    HeadersTooLarge => \"the header section exceeds the limit\",\n    TooManyHeaders => \"too many header fields\",\n    BodyTooLarge => \"the body exceeds the limit\",\n    ChunkLineTooLong => \"a chunk header line exceeds the limit\",\n    BadContentLength => \"invalid Content-Length (1 to 18 digits expected)\",\n    DuplicateContentLength => \"duplicate Content-Length\",\n    ContentLengthWithTransferEncoding => \"both Content-Length and Transfer-Encoding (request smuggling)\",\n    DuplicateTransferEncoding => \"duplicate Transfer-Encoding\",\n    UnsupportedTransferEncoding => \"unsupported Transfer-Encoding (only `chunked` on HTTP/1.1)\",\n    ForbiddenFraming => \"Content-Length or Transfer-Encoding is not allowed in this message\",\n    MissingHost => \"an HTTP/1.1 request needs a Host field\",\n    DuplicateHost => \"duplicate Host field\",\n    BadHost => \"invalid Host field value\",\n    BadChunkSize => \"invalid chunk size (hexadecimal digits expected)\",\n    BadChunkExtension => \"control character in a chunk extension\",\n    BadChunkTerminator => \"chunk data is not followed by CRLF\",\n    ForbiddenTrailer => \"a framing field is not allowed in the trailer section\",\n    UnexpectedEof => \"the input ended before the message was complete\",\n    ParserFinished => \"the parser already finished its message (call reset())\"\n  };\n}\n\n// The error of a parser: `position` is the 0-based byte offset (from the first byte of the message) of the byte\n// that violates the rule (for limits: the first byte over the limit; for end-of-headers rules such as\n// Content-Length + Transfer-Encoding: the CR of the empty line; for a duplicate field: the first byte of the\n// offending line; for `UnexpectedEof`: the number of bytes received).\nexport type HttpError = { position: usize; reason: HttpReason; message: string; };\n\n// httpError(position, reason): the error with its message \"<reason text> at byte <position>\". O(1).\n@Ensures(result.position == position && result.message.length > 0)\nexport function httpError(position: usize, reason: HttpReason): HttpError {\n  return HttpError { position: position, reason: reason, message: `${reasonText(reason)} at byte ${position.toString()}` };\n}\n\n// The answer of a parser: the message is incomplete, complete, or refused. `Done(message, used)`: `used` is the\n// number of bytes of the chunk just fed that belong to the message.\nexport type ParseResult<T> = NeedMore | Done(T, usize) | Failed(HttpError);\n\n\n// ---------------------------------------------------------------------------------------------- Headers\n\n// Why `Headers.add` refused a field.\nexport type HeaderError = InvalidHeaderName | InvalidHeaderValue;\n\n// headerErrorMessage(e): a sentence. O(1).\n@Ensures(result.length > 0)\nexport function headerErrorMessage(e: HeaderError): string {\n  return match (e) {\n    InvalidHeaderName => \"invalid field name: a non-empty token is required\",\n    InvalidHeaderValue => \"invalid field value: no control characters (CR, LF, NUL, ...) and no leading or trailing blanks\"\n  };\n}\n\n// Traps in every build (also without contract checking) when `ok` is false. The guard of the constructors that\n// make invalid values impossible: a failed `@Requires` is also a trap in a checked build, this keeps it so in\n// the unchecked one.\nfunction enforce(ok: bool, what: string): void {\n  if (!ok) {\n    const r: Result<int, string> = Err(what);\n    r.unwrap();\n  }\n}\n\n// allTokens(xs): every element is a token. Loop-based so that contracts can use it.\nexport function allTokens(xs: string[]): bool {\n  let i: usize = 0;\n  while (i < xs.length) {\n    if (!isToken(xs[i])) {\n      return false;\n    }\n    i += 1;\n  }\n  return true;\n}\n\n// allFieldValues(xs): every element is a valid field value.\nexport function allFieldValues(xs: string[]): bool {\n  let i: usize = 0;\n  while (i < xs.length) {\n    if (!isFieldValue(xs[i])) {\n      return false;\n    }\n    i += 1;\n  }\n  return true;\n}\n\n// An ordered list of header fields (also used for trailers). Names are case-insensitive for every lookup and are\n// stored as given (so a message serializes the way it was written); the same name may occur several times and the\n// order of all fields is kept. Invariants: as many values as names, every name is a token, every value is a\n// valid field value (no CR, LF, NUL or other control character, no leading or trailing blanks). They are checked\n// by the constructor in every build and cannot be broken afterwards: `add` and `set` validate before they change\n// anything, so a header value can never smuggle a line break into a serialized message.\n@Invariant(this.names.length == this.values.length)\n@Invariant(allTokens(this.names))\n@Invariant(allFieldValues(this.values))\nexport class Headers {\n  private names: string[];\n  private values: string[];\n\n  // new Headers(names, values): the fields (names[i], values[i]) in order. Traps (in every build) when the lists\n  // differ in length or an element is not a token / valid value; `headersFromLists` answers a Result instead.\n  @Requires(names.length == values.length && allTokens(names) && allFieldValues(values))\n  constructor(names: string[], values: string[]) {\n    this.names = names;\n    this.values = values;\n    enforce(names.length == values.length && allTokens(names) && allFieldValues(values), \"invalid Headers\");\n  }\n\n  // count(): number of fields. O(1).\n  @Ensures(result == this.names.length)\n  count(): usize {\n    return this.names.length;\n  }\n\n  // nameAt(i): the name of the i-th field, as written. O(1).\n  @Requires(i < this.names.length)\n  @Ensures(isToken(result))\n  nameAt(i: usize): string {\n    return this.names[i];\n  }\n\n  // valueAt(i): the value of the i-th field. O(1).\n  @Requires(i < this.names.length)\n  @Ensures(isFieldValue(result))\n  valueAt(i: usize): string {\n    return this.values[i];\n  }\n\n  // countOf(name): number of fields called `name` (case-insensitive). O(count).\n  @Ensures(result <= this.names.length)\n  @Ensures(result == this.names.filter(n => eqIgnoreCase(n, name)).length)\n  countOf(name: string): usize {\n    let n: usize = 0;\n    let i: usize = 0;\n    while (i < this.names.length) {\n      if (eqIgnoreCase(this.names[i], name)) {\n        n += 1;\n      }\n      i += 1;\n    }\n    return n;\n  }\n\n  // has(name): some field is called `name` (case-insensitive). O(count).\n  @Ensures(result == (this.countOf(name) > 0))\n  @Ensures(result == this.names.some(n => eqIgnoreCase(n, name)))\n  has(name: string): bool {\n    let i: usize = 0;\n    while (i < this.names.length) {\n      if (eqIgnoreCase(this.names[i], name)) {\n        return true;\n      }\n      i += 1;\n    }\n    return false;\n  }\n\n  // get(name): the value of the first field called `name`, or None. O(count).\n  @Ensures(result.isSome() == this.has(name))\n  @Ensures(result.isSome() ==> isFieldValue(result.unwrap()))\n  get(name: string): Option<string> {\n    let i: usize = 0;\n    while (i < this.names.length) {\n      if (eqIgnoreCase(this.names[i], name)) {\n        return Some(this.values[i]);\n      }\n      i += 1;\n    }\n    return None;\n  }\n\n  // getAll(name): the values of all fields called `name`, in order. O(count).\n  @Ensures(result.length == this.countOf(name))\n  @Ensures(result.every(v => isFieldValue(v)))\n  getAll(name: string): string[] {\n    let out: string[] = [];\n    let i: usize = 0;\n    while (i < this.names.length) {\n      if (eqIgnoreCase(this.names[i], name)) {\n        out.push(this.values[i]);\n      }\n      i += 1;\n    }\n    return out;\n  }\n\n  // add(name, value): appends a field. Err (and no change) when `name` is not a token or `value` is not a valid\n  // field value. O(name + value).\n  @Ensures(result.isOk() == (isToken(name) && isFieldValue(value)))\n  @Ensures(result.isOk() ==> this.count() == old(this.count()) + 1)\n  @Ensures(result.isOk() ==> this.nameAt(this.count() - 1) == name && this.valueAt(this.count() - 1) == value)\n  @Ensures(result.isErr() ==> this.count() == old(this.count()))\n  add(name: string, value: string): Result<void, HeaderError> {\n    if (!isToken(name)) {\n      return Err(InvalidHeaderName);\n    }\n    if (!isFieldValue(value)) {\n      return Err(InvalidHeaderValue);\n    }\n    this.names.push(name);\n    this.values.push(value);\n    return Ok();\n  }\n\n  // remove(name): deletes every field called `name`; the number removed. O(count).\n  @Ensures(this.countOf(name) == 0)\n  @Ensures(this.count() + result == old(this.count()))\n  @Ensures(result == old(this.countOf(name)))\n  remove(name: string): usize {\n    let ns: string[] = [];\n    let vs: string[] = [];\n    let i: usize = 0;\n    while (i < this.names.length) {\n      if (!eqIgnoreCase(this.names[i], name)) {\n        ns.push(this.names[i]);\n        vs.push(this.values[i]);\n      }\n      i += 1;\n    }\n    const removed = this.names.length - ns.length;\n    this.names = ns;\n    this.values = vs;\n    return removed;\n  }\n\n  // set(name, value): replaces every field called `name` by one field (appended at the end). Err (and no change)\n  // when the name or value is invalid. O(count).\n  @Ensures(result.isOk() == (isToken(name) && isFieldValue(value)))\n  @Ensures(result.isOk() ==> this.countOf(name) == 1 && this.get(name).unwrap() == value)\n  @Ensures(result.isErr() ==> this.count() == old(this.count()))\n  set(name: string, value: string): Result<void, HeaderError> {\n    if (!isToken(name)) {\n      return Err(InvalidHeaderName);\n    }\n    if (!isFieldValue(value)) {\n      return Err(InvalidHeaderValue);\n    }\n    this.remove(name);\n    this.names.push(name);\n    this.values.push(value);\n    return Ok();\n  }\n\n  // equals(other): the same fields in the same order, names compared as written (byte for byte). O(size).\n  @Ensures(result ==> this.count() == other.count())\n  equals(other: Headers): bool {\n    if (this.names.length != other.count()) {\n      return false;\n    }\n    let i: usize = 0;\n    while (i < this.names.length) {\n      if (this.names[i] != other.nameAt(i) || this.values[i] != other.valueAt(i)) {\n        return false;\n      }\n      i += 1;\n    }\n    return true;\n  }\n}\n\n// emptyHeaders(): no fields. O(1).\n@Ensures(result.count() == 0)\nexport function emptyHeaders(): Headers {\n  return new Headers([], []);\n}\n\n// headersFromLists(names, values): the fields as a Result instead of a trap. O(size).\n@Ensures(result.isOk() == (names.length == values.length && allTokens(names) && allFieldValues(values)))\nexport function headersFromLists(names: string[], values: string[]): Result<Headers, HeaderError> {\n  if (names.length != values.length) {\n    return Err(InvalidHeaderValue);\n  }\n  if (!allTokens(names)) {\n    return Err(InvalidHeaderName);\n  }\n  if (!allFieldValues(values)) {\n    return Err(InvalidHeaderValue);\n  }\n  return Ok(new Headers(names, values));\n}\n\n// ----------------------------------------------------------------------------------------------- Status\n\n// standardReason(code): the registered reason phrase of a status code (RFC 9110 \xc2\xa715), \"\" when unregistered. O(1).\nexport function standardReason(code: int): string {\n  return match (code) {\n    100 => \"Continue\",\n    101 => \"Switching Protocols\",\n    102 => \"Processing\",\n    103 => \"Early Hints\",\n    200 => \"OK\",\n    201 => \"Created\",\n    202 => \"Accepted\",\n    203 => \"Non-Authoritative Information\",\n    204 => \"No Content\",\n    205 => \"Reset Content\",\n    206 => \"Partial Content\",\n    207 => \"Multi-Status\",\n    300 => \"Multiple Choices\",\n    301 => \"Moved Permanently\",\n    302 => \"Found\",\n    303 => \"See Other\",\n    304 => \"Not Modified\",\n    305 => \"Use Proxy\",\n    307 => \"Temporary Redirect\",\n    308 => \"Permanent Redirect\",\n    400 => \"Bad Request\",\n    401 => \"Unauthorized\",\n    402 => \"Payment Required\",\n    403 => \"Forbidden\",\n    404 => \"Not Found\",\n    405 => \"Method Not Allowed\",\n    406 => \"Not Acceptable\",\n    407 => \"Proxy Authentication Required\",\n    408 => \"Request Timeout\",\n    409 => \"Conflict\",\n    410 => \"Gone\",\n    411 => \"Length Required\",\n    412 => \"Precondition Failed\",\n    413 => \"Content Too Large\",\n    414 => \"URI Too Long\",\n    415 => \"Unsupported Media Type\",\n    416 => \"Range Not Satisfiable\",\n    417 => \"Expectation Failed\",\n    418 => \"I'm a teapot\",\n    421 => \"Misdirected Request\",\n    422 => \"Unprocessable Content\",\n    426 => \"Upgrade Required\",\n    428 => \"Precondition Required\",\n    429 => \"Too Many Requests\",\n    431 => \"Request Header Fields Too Large\",\n    451 => \"Unavailable For Legal Reasons\",\n    500 => \"Internal Server Error\",\n    501 => \"Not Implemented\",\n    502 => \"Bad Gateway\",\n    503 => \"Service Unavailable\",\n    504 => \"Gateway Timeout\",\n    505 => \"HTTP Version Not Supported\",\n    _ => \"\"\n  };\n}\n\n// statusHasNoBody(code): a response with this status never has a message body: 1xx, 204 and 304 (RFC 9112 \xc2\xa76.3). O(1).\n@Ensures(result == (code < 200 || code == 204 || code == 304))\nexport function statusHasNoBody(code: int): bool {\n  return code < 200 || code == 204 || code == 304;\n}\n\n// A response status: the code (100..599, the invariant) and the reason phrase, which is kept byte for byte.\n@Invariant(this.statusCode >= 100 && this.statusCode <= 599)\n@Invariant(isReasonPhrase(this.phrase))\nexport class Status {\n  private statusCode: int;\n  private phrase: string;\n\n  // new Status(code, reason): traps (in every build) unless 100 <= code <= 599 and `reason` has only HTAB, SP,\n  // VCHAR and obs-text. `standardStatus(code)` picks the registered phrase.\n  @Requires(code >= 100 && code <= 599 && isReasonPhrase(reason))\n  constructor(code: int, reason: string) {\n    this.statusCode = code;\n    this.phrase = reason;\n    enforce(code >= 100 && code <= 599 && isReasonPhrase(reason), \"invalid Status\");\n  }\n\n  // code(): 100..599. O(1).\n  @Ensures(result >= 100 && result <= 599)\n  code(): int {\n    return this.statusCode;\n  }\n\n  // reason(): the reason phrase (may be empty). O(1).\n  @Ensures(isReasonPhrase(result))\n  reason(): string {\n    return this.phrase;\n  }\n\n  // hasNoBody(): see `statusHasNoBody`. O(1).\n  @Ensures(result == statusHasNoBody(this.statusCode))\n  hasNoBody(): bool {\n    return statusHasNoBody(this.statusCode);\n  }\n\n  // equals(other): same code and same phrase. O(n).\n  @Ensures(result ==> this.statusCode == other.code())\n  equals(other: Status): bool {\n    return this.statusCode == other.code() && this.phrase == other.reason();\n  }\n}\n\n// standardStatus(code): the status with the registered phrase of `code` (\"Unknown Status\" for an unregistered code).\n@Requires(code >= 100 && code <= 599)\n@Ensures(result.code() == code)\nexport function standardStatus(code: int): Status {\n  const r = standardReason(code);\n  return new Status(code, r == \"\" ? \"Unknown Status\" : r);\n}\n\n// makeStatus(code, reason): the status as a Result instead of a trap. O(n).\n@Ensures(result.isOk() == (code >= 100 && code <= 599 && isReasonPhrase(reason)))\nexport function makeStatus(code: int, reason: string): Result<Status, string> {\n  if (code < 100 || code > 599) {\n    return Err(\"status code out of range 100..599\");\n  }\n  if (!isReasonPhrase(reason)) {\n    return Err(\"invalid reason phrase\");\n  }\n  return Ok(new Status(code, reason));\n}\n\n// ------------------------------------------------------------------------------- message validity rules\n\nfunction isHttp11(v: HttpVersion): bool {\n  return match (v) {\n    Http11 => true,\n    Http10 => false\n  };\n}\n\n// Trailer fields must not be framing or routing fields (RFC 9110 \xc2\xa76.5.1).\nfunction isForbiddenTrailerName(n: string): bool {\n  return eqIgnoreCase(n, \"content-length\") || eqIgnoreCase(n, \"transfer-encoding\") || eqIgnoreCase(n, \"trailer\")\n    || eqIgnoreCase(n, \"host\");\n}\n\nfunction hasForbiddenTrailer(t: Headers): bool {\n  let i: usize = 0;\n  while (i < t.count()) {\n    if (isForbiddenTrailerName(t.nameAt(i))) {\n      return true;\n    }\n    i += 1;\n  }\n  return false;\n}\n\n// framingProblem(...): \"\" when the header fields frame the body unambiguously and consistently with `body` and\n// `trailers`, else the first violated rule. `bodyless`: the message never has a body (response to HEAD, 1xx, 204,\n// 304); `closeOk`: a body without Content-Length / Transfer-Encoding is allowed (a response: it ends at connection\n// close); `noFraming`: neither field may occur (1xx and 204 responses). The rules are exactly those of the parser.\nfunction framingProblem(h: Headers, trailers: Headers, body: Bytes, version: HttpVersion, bodyless: bool, closeOk: bool,\n    noFraming: bool): string {\n  const cl = h.countOf(\"content-length\");\n  const te = h.countOf(\"transfer-encoding\");\n  if (noFraming && (cl > 0 || te > 0)) {\n    return \"Content-Length or Transfer-Encoding is not allowed in this message\";\n  }\n  if (cl > 1) {\n    return \"duplicate Content-Length\";\n  }\n  if (te > 1) {\n    return \"duplicate Transfer-Encoding\";\n  }\n  if (cl == 1 && te == 1) {\n    return \"both Content-Length and Transfer-Encoding\";\n  }\n  let chunked = false;\n  if (te == 1) {\n    if (!eqIgnoreCase(h.get(\"transfer-encoding\").unwrap(), \"chunked\")) {\n      return \"unsupported Transfer-Encoding\";\n    }\n    if (!isHttp11(version)) {\n      return \"Transfer-Encoding needs HTTP/1.1\";\n    }\n    chunked = true;\n  }\n  let declared: usize = 0;\n  if (cl == 1) {\n    const p = parseContentLength(h.get(\"content-length\").unwrap());\n    if (p.isNone()) {\n      return \"invalid Content-Length\";\n    }\n    declared = p.unwrap();\n  }\n  if (bodyless) {\n    if (body.length() != 0) {\n      return \"a bodyless message has a body\";\n    }\n    if (trailers.count() != 0) {\n      return \"a bodyless message has trailers\";\n    }\n    return \"\";\n  }\n  if (trailers.count() > 0 && !chunked) {\n    return \"trailers without chunked Transfer-Encoding\";\n  }\n  if (hasForbiddenTrailer(trailers)) {\n    return \"framing field in the trailers\";\n  }\n  if (chunked) {\n    return \"\";\n  }\n  if (cl == 1) {\n    if (declared != body.length()) {\n      return \"Content-Length does not match the body\";\n    }\n    return \"\";\n  }\n  if (!closeOk && body.length() != 0) {\n    return \"a body needs Content-Length or Transfer-Encoding\";\n  }\n  return \"\";\n}\n\n// requestProblem(...): \"\" when the parts form a well-formed request, else the first violated rule. The class\n// invariant of `Request`, the check of its constructor and the rules of the parser. O(size).\nexport function requestProblem(method: Method, target: string, version: HttpVersion, headers: Headers, body: Bytes,\n    trailers: Headers): string {\n  if (!isValidMethod(method)) {\n    return \"invalid method\";\n  }\n  if (!isValidTarget(method, target)) {\n    return \"invalid request-target\";\n  }\n  const hosts = headers.countOf(\"host\");\n  if (hosts > 1) {\n    return \"duplicate Host\";\n  }\n  if (hosts == 0 && isHttp11(version)) {\n    return \"an HTTP/1.1 request needs a Host field\";\n  }\n  if (hosts == 1 && !isHostValue(headers.get(\"host\").unwrap())) {\n    return \"invalid Host\";\n  }\n  return framingProblem(headers, trailers, body, version, false, false, false);\n}\n\n// responseProblem(...): \"\" when the parts form a well-formed response. `forHead`: the response to a HEAD request\n// (its headers describe a body that is not sent). O(size).\nexport function responseProblem(status: Status, version: HttpVersion, headers: Headers, body: Bytes, trailers: Headers,\n    forHead: bool): string {\n  const code = status.code();\n  return framingProblem(headers, trailers, body, version, forHead || statusHasNoBody(code), true, code < 200 || code == 204);\n}\n\n// ---------------------------------------------------------------------------------- Request and Response\n\n// A parsed or to-be-serialized HTTP request: method, request-target, version, header fields, body, trailers.\n// Invariant: `requestProblem(...) == \"\"` (valid method and target, one Host on HTTP/1.1, unambiguous framing that\n// matches the body). The constructor enforces it in every build; there is no mutating method. A chunked request\n// stores the decoded body and its trailer fields (chunk boundaries and extensions are not kept); a request with\n// `Transfer-Encoding: chunked` has `isChunked()`.\n@Invariant(requestProblem(this.reqMethod, this.reqTarget, this.reqVersion, this.reqHeaders, this.reqBody, this.reqTrailers) == \"\")\nexport class Request {\n  private reqMethod: Method;\n  private reqTarget: string;\n  private reqVersion: HttpVersion;\n  private reqHeaders: Headers;\n  private reqBody: Bytes;\n  private reqTrailers: Headers;\n\n  // new Request(method, target, version, headers, body, trailers): traps (in every build) unless\n  // `requestProblem(...) == \"\"`; `makeRequest` answers a Result instead.\n  @Requires(requestProblem(method, target, version, headers, body, trailers) == \"\")\n  constructor(method: Method, target: string, version: HttpVersion, headers: Headers, body: Bytes, trailers: Headers) {\n    this.reqMethod = method;\n    this.reqTarget = target;\n    this.reqVersion = version;\n    this.reqHeaders = headers;\n    this.reqBody = body;\n    this.reqTrailers = trailers;\n    enforce(requestProblem(method, target, version, headers, body, trailers) == \"\", \"invalid Request\");\n  }\n\n  // method(): the request method. O(1).\n  @Ensures(isValidMethod(result))\n  method(): Method {\n    return this.reqMethod;\n  }\n\n  // target(): the request-target as sent. O(1).\n  @Ensures(isValidTarget(this.reqMethod, result))\n  target(): string {\n    return this.reqTarget;\n  }\n\n  // version(): HTTP/1.0 or HTTP/1.1. O(1).\n  version(): HttpVersion {\n    return this.reqVersion;\n  }\n\n  // headers(): the header fields in order. O(1).\n  headers(): Headers {\n    return this.reqHeaders;\n  }\n\n  // body(): the (decoded) message body. O(1).\n  body(): Bytes {\n    return this.reqBody;\n  }\n\n  // trailers(): the trailer fields of a chunked body (empty otherwise). O(1).\n  @Ensures(result.count() > 0 ==> this.isChunked())\n  trailers(): Headers {\n    return this.reqTrailers;\n  }\n\n  // isChunked(): the body is sent with `Transfer-Encoding: chunked`. O(count).\n  @Ensures(result == (this.reqHeaders.countOf(\"transfer-encoding\") == 1))\n  isChunked(): bool {\n    return this.reqHeaders.countOf(\"transfer-encoding\") == 1;\n  }\n\n  // equals(other): the same method, target, version, headers, body and trailers. O(size).\n  equals(other: Request): bool {\n    return methodEquals(this.reqMethod, other.method()) && this.reqTarget == other.target()\n      && versionMinor(this.reqVersion) == versionMinor(other.version()) && this.reqHeaders.equals(other.headers())\n      && this.reqBody.equals(other.body()) && this.reqTrailers.equals(other.trailers());\n  }\n}\n\n// makeRequest(...): the request, or the first violated rule (`requestProblem`), instead of a trap. O(size).\n@Ensures(result.isOk() == (requestProblem(method, target, version, headers, body, trailers) == \"\"))\nexport function makeRequest(method: Method, target: string, version: HttpVersion, headers: Headers, body: Bytes,\n    trailers: Headers): Result<Request, string> {\n  const p = requestProblem(method, target, version, headers, body, trailers);\n  if (p != \"\") {\n    return Err(p);\n  }\n  return Ok(new Request(method, target, version, headers, body, trailers));\n}\n\n// A parsed or to-be-serialized HTTP response. Invariant: `responseProblem(...) == \"\"`. `forHead`: the response to\n// a HEAD request, whose headers (Content-Length, Transfer-Encoding) describe a body that is not sent; 1xx, 204\n// and 304 responses are bodyless in any case (`isBodyless()`).\n@Invariant(responseProblem(this.resStatus, this.resVersion, this.resHeaders, this.resBody, this.resTrailers, this.resForHead) == \"\")\nexport class Response {\n  private resStatus: Status;\n  private resVersion: HttpVersion;\n  private resHeaders: Headers;\n  private resBody: Bytes;\n  private resTrailers: Headers;\n  private resForHead: bool;\n\n  // new Response(status, version, headers, body, trailers, forHead): traps (in every build) unless\n  // `responseProblem(...) == \"\"`; `makeResponse` answers a Result instead.\n  @Requires(responseProblem(status, version, headers, body, trailers, forHead) == \"\")\n  constructor(status: Status, version: HttpVersion, headers: Headers, body: Bytes, trailers: Headers, forHead: bool) {\n    this.resStatus = status;\n    this.resVersion = version;\n    this.resHeaders = headers;\n    this.resBody = body;\n    this.resTrailers = trailers;\n    this.resForHead = forHead;\n    enforce(responseProblem(status, version, headers, body, trailers, forHead) == \"\", \"invalid Response\");\n  }\n\n  // status(): code and reason phrase. O(1).\n  status(): Status {\n    return this.resStatus;\n  }\n\n  // version(): HTTP/1.0 or HTTP/1.1. O(1).\n  version(): HttpVersion {\n    return this.resVersion;\n  }\n\n  // headers(): the header fields in order. O(1).\n  headers(): Headers {\n    return this.resHeaders;\n  }\n\n  // body(): the (decoded) message body. O(1).\n  body(): Bytes {\n    return this.resBody;\n  }\n\n  // trailers(): the trailer fields of a chunked body (empty otherwise). O(1).\n  @Ensures(result.count() > 0 ==> this.isChunked())\n  trailers(): Headers {\n    return this.resTrailers;\n  }\n\n  // isBodyless(): no body is sent: response to HEAD, or status 1xx, 204, 304. O(1).\n  @Ensures(result == (this.resForHead || this.resStatus.hasNoBody()))\n  @Ensures(result ==> this.resBody.length() == 0)\n  isBodyless(): bool {\n    return this.resForHead || this.resStatus.hasNoBody();\n  }\n\n  // isForHead(): the response to a HEAD request. O(1).\n  @Ensures(result == this.resForHead)\n  isForHead(): bool {\n    return this.resForHead;\n  }\n\n  // isChunked(): the body is sent with `Transfer-Encoding: chunked` (never true for a bodyless message when\n  // serialized: no chunks are written). O(count).\n  @Ensures(result == (this.resHeaders.countOf(\"transfer-encoding\") == 1))\n  isChunked(): bool {\n    return this.resHeaders.countOf(\"transfer-encoding\") == 1;\n  }\n\n  // equals(other): the same status, version, headers, body, trailers and HEAD flag. O(size).\n  equals(other: Response): bool {\n    return this.resStatus.equals(other.status()) && versionMinor(this.resVersion) == versionMinor(other.version())\n      && this.resHeaders.equals(other.headers()) && this.resBody.equals(other.body())\n      && this.resTrailers.equals(other.trailers()) && this.resForHead == other.isForHead();\n  }\n}\n\n// makeResponse(...): the response, or the first violated rule (`responseProblem`), instead of a trap. O(size).\n@Ensures(result.isOk() == (responseProblem(status, version, headers, body, trailers, forHead) == \"\"))\nexport function makeResponse(status: Status, version: HttpVersion, headers: Headers, body: Bytes, trailers: Headers,\n    forHead: bool): Result<Response, string> {\n  const p = responseProblem(status, version, headers, body, trailers, forHead);\n  if (p != \"\") {\n    return Err(p);\n  }\n  return Ok(new Response(status, version, headers, body, trailers, forHead));\n}\n\n\n// -------------------------------------------------------------------------------------------------- Limits\n\n// The resource limits of a parser. Every message that exceeds one is refused at the first byte over the limit\n// (a request line, a header line, the header section, the header count, a chunk header line, the body). They are\n// the `@Requires` of the constructor and the invariants of the class, so a parser can never be built with a\n// limit that is zero, negative or large enough to overflow the chunk-size arithmetic.\n//   maxStartLine    bytes of the request line / status line without CRLF   (default 8192, RFC 9112 \xc2\xa73: at least 8000)\n//   maxHeaderCount  header fields (and, separately, trailer fields)         (default 100)\n//   maxHeaderLine   bytes of one header line without CRLF                   (default 8192)\n//   maxHeaderBytes  the whole header section (start line .. empty line), and separately the trailer section\n//                                                                           (default 65536)\n//   maxChunkLine    bytes of a chunk-size line (size and extension)         (default 1024)\n//   maxBody         bytes of the (decoded) body                             (default 1048576 = 1 MiB)\n@Invariant(this.startLine >= 16 && this.startLine <= 1048576)\n@Invariant(this.headerCount >= 1 && this.headerCount <= 65536)\n@Invariant(this.headerLine >= 16 && this.headerLine <= 1048576)\n@Invariant(this.headerBytes >= 64 && this.headerBytes <= 67108864)\n@Invariant(this.chunkLine >= 8 && this.chunkLine <= 65536)\n@Invariant(this.bodyBytes <= 1099511627776)\nexport class Limits {\n  private startLine: usize;\n  private headerCount: usize;\n  private headerLine: usize;\n  private headerBytes: usize;\n  private chunkLine: usize;\n  private bodyBytes: usize;\n\n  @Requires(maxStartLine >= 16 && maxStartLine <= 1048576)\n  @Requires(maxHeaderCount >= 1 && maxHeaderCount <= 65536)\n  @Requires(maxHeaderLine >= 16 && maxHeaderLine <= 1048576)\n  @Requires(maxHeaderBytes >= 64 && maxHeaderBytes <= 67108864)\n  @Requires(maxChunkLine >= 8 && maxChunkLine <= 65536)\n  @Requires(maxBody <= 1099511627776)\n  constructor(maxStartLine: usize, maxHeaderCount: usize, maxHeaderLine: usize, maxHeaderBytes: usize,\n      maxChunkLine: usize, maxBody: usize) {\n    this.startLine = maxStartLine;\n    this.headerCount = maxHeaderCount;\n    this.headerLine = maxHeaderLine;\n    this.headerBytes = maxHeaderBytes;\n    this.chunkLine = maxChunkLine;\n    this.bodyBytes = maxBody;\n    enforce(maxStartLine >= 16 && maxStartLine <= 1048576 && maxHeaderCount >= 1 && maxHeaderCount <= 65536\n      && maxHeaderLine >= 16 && maxHeaderLine <= 1048576 && maxHeaderBytes >= 64 && maxHeaderBytes <= 67108864\n      && maxChunkLine >= 8 && maxChunkLine <= 65536 && maxBody <= 1099511627776, \"invalid Limits\");\n  }\n\n  // maxStartLine(): the longest request line / status line (without CRLF). O(1).\n  @Ensures(result >= 16)\n  maxStartLine(): usize {\n    return this.startLine;\n  }\n\n  // maxHeaderCount(): the most header fields (also the most trailer fields). O(1).\n  @Ensures(result >= 1)\n  maxHeaderCount(): usize {\n    return this.headerCount;\n  }\n\n  // maxHeaderLine(): the longest header line (without CRLF). O(1).\n  @Ensures(result >= 16)\n  maxHeaderLine(): usize {\n    return this.headerLine;\n  }\n\n  // maxHeaderBytes(): the largest header section, including the empty line (also the largest trailer section). O(1).\n  @Ensures(result >= 64)\n  maxHeaderBytes(): usize {\n    return this.headerBytes;\n  }\n\n  // maxChunkLine(): the longest chunk-size line (hex digits, blanks and extension, without CRLF). O(1).\n  @Ensures(result >= 8)\n  maxChunkLine(): usize {\n    return this.chunkLine;\n  }\n\n  // maxBody(): the largest decoded body. O(1).\n  maxBody(): usize {\n    return this.bodyBytes;\n  }\n}\n\n// defaultLimits(): 8192 start line, 100 headers, 8192 header line, 65536 header section, 1024 chunk line, 1 MiB body. O(1).\n@Ensures(result.maxStartLine() == 8192 && result.maxHeaderCount() == 100 && result.maxBody() == 1048576)\nexport function defaultLimits(): Limits {\n  return new Limits(8192, 100, 8192, 65536, 1024, 1048576);\n}\n\n// ------------------------------------------------------------------------------------------ state machine\n\nconst S_METHOD: int = 0;\nconst S_TARGET: int = 1;\nconst S_VERSION: int = 2;\nconst S_CODE: int = 3;\nconst S_REASON: int = 4;\nconst S_START_LF: int = 5;\nconst S_HDR_LINE: int = 6;\nconst S_HDR_NAME: int = 7;\nconst S_HDR_OWS: int = 8;\nconst S_HDR_VALUE: int = 9;\nconst S_HDR_LF: int = 10;\nconst S_HEAD_END_LF: int = 11;\nconst S_BODY: int = 12;\nconst S_CHUNK_SIZE: int = 13;\nconst S_CHUNK_BWS: int = 14;\nconst S_CHUNK_EXT: int = 15;\nconst S_CHUNK_SIZE_LF: int = 16;\nconst S_CHUNK_DATA: int = 17;\nconst S_CHUNK_CR: int = 18;\nconst S_CHUNK_LF: int = 19;\nconst S_BODY_CLOSE: int = 20;\nconst S_DONE: int = 21;\nconst S_ERROR: int = 22;\n\n// stateName(s): the name of state s, for diagnostics and tests. O(1).\n@Ensures(result.length > 0)\nexport function stateName(s: int): string {\n  return match (s) {\n    0 => \"METHOD\",\n    1 => \"TARGET\",\n    2 => \"VERSION\",\n    3 => \"CODE\",\n    4 => \"REASON\",\n    5 => \"START_LF\",\n    6 => \"HDR_LINE\",\n    7 => \"HDR_NAME\",\n    8 => \"HDR_OWS\",\n    9 => \"HDR_VALUE\",\n    10 => \"HDR_LF\",\n    11 => \"HEAD_END_LF\",\n    12 => \"BODY\",\n    13 => \"CHUNK_SIZE\",\n    14 => \"CHUNK_BWS\",\n    15 => \"CHUNK_EXT\",\n    16 => \"CHUNK_SIZE_LF\",\n    17 => \"CHUNK_DATA\",\n    18 => \"CHUNK_CR\",\n    19 => \"CHUNK_LF\",\n    20 => \"BODY_CLOSE\",\n    21 => \"DONE\",\n    22 => \"ERROR\",\n    _ => \"?\"\n  };\n}\n\n// edgeAllowed(src, dst): the transition relation of the parser (the diagram at the top of this file). Every\n// state change goes through `MessageParser.go`, which requires it; `ERROR` is reachable from every non-terminal\n// state (through `fail`) and `DONE` / `ERROR` have no outgoing edge. O(1).\n@Ensures(src >= S_DONE ==> !result)\n@Ensures(result ==> src != dst)\nexport function edgeAllowed(src: int, dst: int): bool {\n  return match (src) {\n    0 => dst == S_TARGET,\n    1 => dst == S_VERSION,\n    2 => dst == S_START_LF || dst == S_CODE,\n    3 => dst == S_REASON,\n    4 => dst == S_START_LF,\n    5 => dst == S_HDR_LINE,\n    6 => dst == S_HDR_NAME || dst == S_HEAD_END_LF,\n    7 => dst == S_HDR_OWS,\n    8 => dst == S_HDR_VALUE || dst == S_HDR_LF,\n    9 => dst == S_HDR_LF,\n    10 => dst == S_HDR_LINE,\n    11 => dst == S_BODY || dst == S_CHUNK_SIZE || dst == S_BODY_CLOSE || dst == S_DONE,\n    12 => dst == S_DONE,\n    13 => dst == S_CHUNK_BWS || dst == S_CHUNK_EXT || dst == S_CHUNK_SIZE_LF,\n    14 => dst == S_CHUNK_EXT || dst == S_CHUNK_SIZE_LF,\n    15 => dst == S_CHUNK_SIZE_LF,\n    16 => dst == S_CHUNK_DATA || dst == S_HDR_LINE,\n    17 => dst == S_CHUNK_CR,\n    18 => dst == S_CHUNK_LF,\n    19 => dst == S_CHUNK_SIZE,\n    20 => dst == S_DONE,\n    _ => false\n  };\n}\n\n// The framing of the body, decided at the end of the header section.\nconst F_NONE: int = 0;\nconst F_LENGTH: int = 1;\nconst F_CHUNKED: int = 2;\nconst F_CLOSE: int = 3;\n\nfunction lineLimitReason(st: int): HttpReason {\n  if (st <= S_REASON) {\n    return StartLineTooLong;\n  }\n  if (st <= S_HDR_VALUE) {\n    return HeaderLineTooLong;\n  }\n  return ChunkLineTooLong;\n}\n\n// Is the state one whose bytes count toward `lineLen` (the start line, a header line, a chunk-size line)?\nfunction isLineState(st: int): bool {\n  return st <= S_REASON || (st >= S_HDR_NAME && st <= S_HDR_VALUE) || (st >= S_CHUNK_SIZE && st <= S_CHUNK_EXT);\n}\n\n\n// The bytes xs[a, b) as a string (one byte per character, no decoding): one allocation and a copy loop in the runtime\n// (`bytesToString`; the per-character `s += String.fromCharCode(..)` loop it replaced cost about 7 ns per byte).\n@Requires(a <= b && b <= xs.length)\n@Ensures(result.length == b - a)\nfunction sliceString(xs: u8[], a: usize, b: usize): string {\n  return bytesToString(xs, a, b - a);\n}\n\n// s without trailing SP / HTAB. O(trailing blanks).\n@Ensures(result.length <= s.length)\nfunction trimEndOws(s: string): string {\n  let e = s.length;\n  while (e > 0 && isOws(s.charCodeAt(e - 1))) {\n    e -= 1;\n  }\n  return e == s.length ? s : s.substring(0, e);\n}\n\nfunction resultKind<T>(r: ParseResult<T>): int {\n  return match (r) {\n    NeedMore => 0,\n    Done(v, used) => 1,\n    Failed(e) => 2\n  };\n}\n\nfunction resultUsed<T>(r: ParseResult<T>): usize {\n  return match (r) {\n    Done(v, used) => used,\n    _ => 0\n  };\n}\n\n// The scanners read the chunk's storage array directly (`Bytes.storage`, no copy), so that the byte loops index an\n// array instead of calling `Bytes.at` per byte (a call plus a reference count per byte). Their cursor `this.cur` is an\n// index into that array; the chunk starts at index `this.off` of it, which is stream offset `this.base`.\n\n// posAt(base, off, j): the stream offset of index j of a storage array whose index `off` is at stream offset `base`.\n@Requires(j >= off)\n@Ensures(result == base + (j - off))\nfunction posAt(base: usize, off: usize, j: usize): usize {\n  return base + (j - off);\n}\n\n// The incremental parser shared by `RequestParser` and `ResponseParser`: the state machine described at the top of\n// the file. `feed` consumes input in one forward pass; all state is in the fields, so the input may be split\n// anywhere. Invariants (checked after every public method in a checked build) tie the state to the data: the state\n// is one of the 23 states; a failed parser holds its error and only a failed parser does; the header lists are\n// parallel and within the count limit; the line counter is within the line limit; the header section never exceeds\n// its budget; counters of the framing fields never pass one (a second one is an error at once); pending body bytes\n// exist only in a body state; a response parser never visits the request-line states.\n@Invariant(this.state >= S_METHOD && this.state <= S_ERROR)\n@Invariant((this.state == S_ERROR) == this.err.isSome())\n@Invariant(this.hnames.length == this.hvals.length && this.tnames.length == this.tvals.length)\n@Invariant(this.hnames.length <= this.maxCount && this.tnames.length <= this.maxCount)\n@Invariant(this.lineLen <= this.lineMax)\n@Invariant(this.state > S_HEAD_END_LF || this.total <= this.sectionEnd)\n@Invariant(this.state == S_ERROR || (this.clCount <= 1 && this.teCount <= 1 && this.hostCount <= 1))\n@Invariant(this.bodyLen <= this.maxBody)\n@Invariant(this.remaining == 0 || this.state == S_BODY || this.state == S_CHUNK_DATA || this.state == S_ERROR)\n@Invariant(this.state != S_DONE || this.remaining == 0)\n@Invariant(!this.inTrailers || this.state >= S_HDR_LINE)\n@Invariant(this.isReq || (this.state != S_METHOD && this.state != S_TARGET))\n@Invariant(this.isReq || this.state != S_START_LF || this.vidx == 8)\n@Invariant(this.state != S_BODY_CLOSE || !this.isReq)\n@Invariant(this.state != S_BODY || this.framing == F_LENGTH)\n@Invariant(this.state != S_BODY_CLOSE || this.framing == F_CLOSE)\n@Invariant(this.vidx <= 8 && this.codeDigits <= 3)\n@Invariant(this.noBody.length() == 0)\n@Invariant(this.acc.length == 0 || this.state == S_METHOD || this.state == S_TARGET || this.state == S_REASON\n  || this.state == S_HDR_NAME || this.state == S_HDR_VALUE || this.state == S_ERROR)\nclass MessageParser {\n  private isReq: bool;\n  private forHead: bool;\n  private maxStart: usize;\n  private maxCount: usize;\n  private maxLine: usize;\n  private maxHead: usize;\n  private maxChunk: usize;\n  private maxBody: usize;\n  private state: int;\n  private err: Option<HttpError> = None;\n  private base0: usize = 0;\n  private base: usize = 0;\n  private off: usize = 0;\n  private cur: usize = 0;\n  private total: usize = 0;\n  private sectionEnd: usize;\n  private lineLen: usize = 0;\n  private lineMax: usize;\n  private lineStart: usize = 0;\n  private acc: string = \"\";\n  private meth: Method = Get;\n  private methodToken: string = \"\";\n  private target: string = \"\";\n  private targetPos: usize = 0;\n  private vidx: usize = 0;\n  private minor: int = 1;\n  private code: int = 0;\n  private codeDigits: usize = 0;\n  private reason: string = \"\";\n  private hnames: string[] = [];\n  private hvals: string[] = [];\n  private tnames: string[] = [];\n  private tvals: string[] = [];\n  private inTrailers: bool = false;\n  private curName: string = \"\";\n  private curValue: string = \"\";\n  private clCount: usize = 0;\n  private teCount: usize = 0;\n  private hostCount: usize = 0;\n  private clValue: usize = 0;\n  private framing: int = F_NONE;\n  private remaining: usize = 0;\n  private bodyLen: usize = 0;\n  private parts: Bytes[] = [];\n  private noBody: Bytes = emptyBytes();\n  private chunkSize: usize = 0;\n  private chunkDigits: usize = 0;\n\n  constructor(isReq: bool, forHead: bool, limits: Limits) {\n    this.isReq = isReq;\n    this.forHead = forHead;\n    this.maxStart = limits.maxStartLine();\n    this.maxCount = limits.maxHeaderCount();\n    this.maxLine = limits.maxHeaderLine();\n    this.maxHead = limits.maxHeaderBytes();\n    this.maxChunk = limits.maxChunkLine();\n    this.maxBody = limits.maxBody();\n    this.state = isReq ? S_METHOD : S_VERSION;\n    this.sectionEnd = limits.maxHeaderBytes();\n    this.lineMax = limits.maxStartLine();\n  }\n\n  // reset(): forget the message and start over (the next pipelined message, or after an error). O(1).\n  @Ensures(this.isIdle())\n  reset(): void {\n    this.state = this.isReq ? S_METHOD : S_VERSION;\n    this.err = None;\n    this.base0 = 0;\n    this.base = 0;\n    this.off = 0;\n    this.cur = 0;\n    this.total = 0;\n    this.sectionEnd = this.maxHead;\n    this.lineLen = 0;\n    this.lineMax = this.maxStart;\n    this.lineStart = 0;\n    this.acc = \"\";\n    this.meth = Get;\n    this.methodToken = \"\";\n    this.target = \"\";\n    this.targetPos = 0;\n    this.vidx = 0;\n    this.minor = 1;\n    this.code = 0;\n    this.codeDigits = 0;\n    this.reason = \"\";\n    this.hnames = [];\n    this.hvals = [];\n    this.tnames = [];\n    this.tvals = [];\n    this.inTrailers = false;\n    this.curName = \"\";\n    this.curValue = \"\";\n    this.clCount = 0;\n    this.teCount = 0;\n    this.hostCount = 0;\n    this.clValue = 0;\n    this.framing = F_NONE;\n    this.remaining = 0;\n    this.bodyLen = 0;\n    this.parts = [];\n    this.chunkSize = 0;\n    this.chunkDigits = 0;\n  }\n\n  // isIdle(): no byte of a message was consumed yet. O(1).\n  @Ensures(result == (this.total == 0 && this.state < S_DONE))\n  isIdle(): bool {\n    return this.total == 0 && this.state < S_DONE;\n  }\n\n  // isDone() / isFailed(): the message is complete / refused. O(1).\n  @Ensures(result == (this.state == S_DONE))\n  isDone(): bool {\n    return this.state == S_DONE;\n  }\n\n  @Ensures(result == (this.state == S_ERROR))\n  isFailed(): bool {\n    return this.state == S_ERROR;\n  }\n\n  // stateCode(): the current state (`stateName` gives its name). O(1).\n  @Ensures(result >= S_METHOD && result <= S_ERROR)\n  stateCode(): int {\n    return this.state;\n  }\n\n  // consumed(): bytes consumed since the start of the message (for a failed parser: the offset of the offending\n  // byte). O(1).\n  @Ensures(result == this.total)\n  consumed(): usize {\n    return this.total;\n  }\n\n  // The state change to `dst`; the only way the state changes besides `fail`, and only along `edgeAllowed`.\n  @Requires(edgeAllowed(this.state, dst))\n  @Ensures(this.state == dst)\n  private go(dst: int): void {\n    this.state = dst;\n  }\n\n  // fail(pos, reason): the parser fails at the absolute offset `pos`. Sticky until `reset`.\n  @Requires(this.state < S_DONE)\n  @Ensures(this.state == S_ERROR && this.err.isSome())\n  @Ensures(this.err.unwrap().position == pos)\n  private fail(pos: usize, reason: HttpReason): void {\n    this.err = Some(httpError(pos, reason));\n    this.state = S_ERROR;\n  }\n\n  // posOf(j): the stream offset of index j of the storage array the scanners read (index `this.off` is the first\n  // byte of the chunk, at stream offset `this.base`). Assignments to fields use `posAt` directly: a method call on\n  // `this` inside the right-hand side of a field store makes the lowering emit an extra `makeunique` of `this`.\n  @Requires(j >= this.off)\n  @Ensures(result == this.base + (j - this.off))\n  private posOf(j: usize): usize {\n    return posAt(this.base, this.off, j);\n  }\n\n  // feed(chunk): consumes bytes of the message. NeedMore: all of `chunk` was consumed. Done(_, used): the message is\n  // complete after `used` bytes of this chunk. Failed(e): refused. In a terminal state it answers Failed without\n  // consuming anything (the stored error, or `ParserFinished` after Done).\n  //\n  // The loop takes one token per step. A step handles the bytes at the cursor `this.cur` in the current state and\n  // moves the cursor; it consumes at least one byte or ends in ERROR, so the loop terminates in at most\n  // chunk.length() + 1 steps. Scanning states read the chunk's storage array (`xs`, the cursor an index\n  // into it); the body states copy nothing: they slice the chunk.\n  @Ensures(resultKind(result) == 0 ==> this.state < S_DONE && this.total == old(this.total) + chunk.length())\n  @Ensures(resultKind(result) == 1 ==> this.state == S_DONE && resultUsed(result) <= chunk.length())\n  @Ensures(resultKind(result) == 1 ==> this.total == old(this.total) + resultUsed(result))\n  @Ensures(resultKind(result) == 2 ==> this.state >= S_DONE)\n  @Ensures(old(this.state) >= S_DONE ==> this.state == old(this.state) && this.total == old(this.total))\n  feed(chunk: Bytes): ParseResult<int> {\n    if (this.state >= S_DONE) {\n      if (this.state == S_ERROR) {\n        return Failed(this.err.unwrap());\n      }\n      return Failed(httpError(this.total, ParserFinished));\n    }\n    this.base0 = this.total;\n    const n = chunk.length();\n    const xs = chunk.storage();\n    const off = chunk.storageStart();\n    this.base = this.base0;\n    this.off = off;\n    let i: usize = 0;\n    while (i < n && this.state < S_DONE) {\n      const st = this.state;\n      if (st == S_BODY) {\n        this.cur = i;\n        this.doBody(chunk, n);\n        i = this.cur;\n      } else if (st == S_CHUNK_DATA) {\n        this.cur = i;\n        this.doChunkData(chunk, n);\n        i = this.cur;\n      } else if (st == S_BODY_CLOSE) {\n        this.cur = i;\n        this.doBodyClose(chunk, n);\n        i = this.cur;\n      } else {\n        let end = n;\n        if (st <= S_HEAD_END_LF) {\n          const budget = this.sectionEnd - this.base0;\n          if (budget < end) {\n            end = budget;\n          }\n          if (i >= end) {\n            this.fail(this.base0 + i, HeadersTooLarge);\n            break;\n          }\n        }\n        const lim = off + end;\n        this.cur = off + i;\n        if (this.lineLen >= this.lineMax && isLineState(st) && HTTP_CLASS.charCodeAt(xs[this.cur].toUsize()) != C_CR) {\n          this.fail(this.posOf(this.cur), lineLimitReason(st));\n          break;\n        }\n        if (st == S_HDR_VALUE) {\n          this.doValue(xs, lim);\n        } else if (st == S_HDR_NAME) {\n          this.doName(xs, lim);\n        } else if (st == S_HDR_LINE) {\n          this.doLineStart(xs, lim);\n        } else if (st == S_HDR_OWS) {\n          this.doOws(xs, lim);\n        } else if (st == S_HDR_LF) {\n          this.doHeaderLf(xs);\n        } else if (st == S_METHOD) {\n          this.doMethod(xs, lim);\n        } else if (st == S_TARGET) {\n          this.doTarget(xs, lim);\n        } else if (st == S_VERSION) {\n          this.doVersion(xs, lim);\n        } else if (st == S_CODE) {\n          this.doCode(xs, lim);\n        } else if (st == S_REASON) {\n          this.doReason(xs, lim);\n        } else if (st == S_START_LF) {\n          this.doStartLf(xs);\n        } else if (st == S_HEAD_END_LF) {\n          this.doHeadEnd(xs);\n        } else if (st == S_CHUNK_SIZE) {\n          this.doChunkSize(xs, lim);\n        } else if (st == S_CHUNK_BWS) {\n          this.doChunkBws(xs, lim);\n        } else if (st == S_CHUNK_EXT) {\n          this.doChunkExt(xs, lim);\n        } else if (st == S_CHUNK_SIZE_LF) {\n          this.doChunkSizeLf(xs);\n        } else if (st == S_CHUNK_CR) {\n          this.doChunkCr(xs);\n        } else {\n          this.doChunkLf(xs);\n        }\n        i = this.cur - off;\n      }\n    }\n    this.total = this.base0 + i;\n    if (this.state == S_ERROR) {\n      return Failed(this.err.unwrap());\n    }\n    if (this.state == S_DONE) {\n      return Done(0, i);\n    }\n    return NeedMore;\n  }\n\n  // atEof(): the peer closed the connection. A response body without Content-Length / chunking ends here (Done);\n  // any other incomplete message is `UnexpectedEof` at the number of bytes received. In a terminal state like `feed`.\n  @Ensures(resultKind(result) == 1 ==> this.state == S_DONE && old(this.state) == S_BODY_CLOSE)\n  @Ensures(resultKind(result) != 0)\n  atEof(): ParseResult<int> {\n    if (this.state == S_BODY_CLOSE) {\n      this.go(S_DONE);\n      return Done(0, 0);\n    }\n    if (this.state >= S_DONE) {\n      if (this.state == S_ERROR) {\n        return Failed(this.err.unwrap());\n      }\n      return Failed(httpError(this.total, ParserFinished));\n    }\n    this.fail(this.total, UnexpectedEof);\n    return Failed(this.err.unwrap());\n  }\n\n  // ---------------------------------------------------------------------------------------- start line\n  // Every step below reads the cursor `this.cur`, handles the bytes xs[cur .. n) in its state and leaves the new\n  // cursor in `this.cur`: a position past at least one byte, or the position of the byte it refused (ERROR).\n\n  // METHOD: a run of token characters, then SP.\n  @Requires(this.state == S_METHOD && this.cur < n && n <= xs.length)\n  @Ensures(this.cur > old(this.cur) || this.state == S_ERROR)\n  private doMethod(xs: u8[], n: usize): void {\n    const i = this.cur;\n    const room = this.lineMax - this.lineLen;\n    const lim = (n - i) < room ? n : i + room;\n    let j = i;\n    while (j < lim && HTTP_CLASS.charCodeAt(xs[j].toUsize()) >= C_TOKEN) {\n      j += 1;\n    }\n    let tok = \"\";\n    if (j > i) {\n      tok = sliceString(xs, i, j);\n      this.lineLen += j - i;\n    }\n    this.cur = j;\n    if (j >= n) {\n      if (j > i) {\n        this.acc += tok;\n      }\n      return;\n    }\n    const c = HTTP_CLASS.charCodeAt(xs[j].toUsize());\n    if (c >= C_TOKEN) {\n      if (j > i) {\n        this.acc += tok;\n      }\n      return;\n    }\n    if (c == C_SP && this.lineLen > 0) {\n      if (this.lineLen >= this.lineMax) {\n        this.fail(this.posOf(j), StartLineTooLong);\n        return;\n      }\n      this.lineLen += 1;\n      if (this.acc.length > 0) {\n        this.acc += tok;\n        tok = this.acc;\n        this.acc = \"\";\n      }\n      this.methodToken = tok;\n      this.meth = methodFromToken(tok).unwrap();\n      this.go(S_TARGET);\n      this.targetPos = posAt(this.base, this.off, j) + 1;\n      this.cur = j + 1;\n      return;\n    }\n    this.fail(this.posOf(j), BadMethod);\n  }\n\n  // TARGET: a run of 0x21..0x7E, then SP.\n  @Requires(this.state == S_TARGET && this.cur < n && n <= xs.length)\n  @Ensures(this.cur > old(this.cur) || this.state == S_ERROR)\n  private doTarget(xs: u8[], n: usize): void {\n    const i = this.cur;\n    const room = this.lineMax - this.lineLen;\n    const lim = (n - i) < room ? n : i + room;\n    let j = i;\n    while (j < lim && HTTP_CLASS.charCodeAt(xs[j].toUsize()) >= 6) {\n      j += 1;\n    }\n    let tok = \"\";\n    if (j > i) {\n      tok = sliceString(xs, i, j);\n      this.lineLen += j - i;\n    }\n    this.cur = j;\n    if (j >= n) {\n      if (j > i) {\n        this.acc += tok;\n      }\n      return;\n    }\n    const c = HTTP_CLASS.charCodeAt(xs[j].toUsize());\n    if (c >= 6) {\n      if (j > i) {\n        this.acc += tok;\n      }\n      return;\n    }\n    if (c == C_SP && this.lineLen > this.methodToken.length + 1) {\n      if (this.lineLen >= this.lineMax) {\n        this.fail(this.posOf(j), StartLineTooLong);\n        return;\n      }\n      this.lineLen += 1;\n      if (this.acc.length > 0) {\n        this.acc += tok;\n        tok = this.acc;\n        this.acc = \"\";\n      }\n      this.target = tok;\n      this.go(S_VERSION);\n      this.vidx = 0;\n      this.cur = j + 1;\n      return;\n    }\n    if (c == C_CR && this.lineLen > this.methodToken.length + 1) {\n      this.fail(this.posOf(j), BadVersion);\n      return;\n    }\n    this.fail(this.posOf(j), BadTarget);\n  }\n\n  // VERSION: \"HTTP/1.\" and a digit (0 or 1), then CR (request) or SP (response).\n  @Requires(this.state == S_VERSION && this.cur < n && n <= xs.length)\n  @Ensures(this.cur > old(this.cur) || this.state == S_ERROR)\n  private doVersion(xs: u8[], n: usize): void {\n    let j = this.cur;\n    while (j < n && this.vidx < 8 && this.lineLen < this.lineMax) {\n      const c = xs[j].toInt();\n      const k = this.vidx;\n      if (k < 7) {\n        if (c != \"HTTP/1.\".charCodeAt(k)) {\n          this.cur = j;\n          if (k == 5 && c >= 48 && c <= 57) {\n            this.fail(this.posOf(j), UnsupportedVersion);\n          } else {\n            this.fail(this.posOf(j), BadVersion);\n          }\n          return;\n        }\n      } else if (c == 48) {\n        this.minor = 0;\n      } else if (c == 49) {\n        this.minor = 1;\n      } else if (c >= 50 && c <= 57) {\n        this.cur = j;\n        this.fail(this.posOf(j), UnsupportedVersion);\n        return;\n      } else {\n        this.cur = j;\n        this.fail(this.posOf(j), BadVersion);\n        return;\n      }\n      this.vidx += 1;\n      this.lineLen += 1;\n      j += 1;\n    }\n    this.cur = j;\n    if (this.vidx < 8) {\n      if (j < n) {\n        if (this.lineLen >= this.lineMax && HTTP_CLASS.charCodeAt(xs[j].toUsize()) != C_CR) {\n          this.fail(this.posOf(j), StartLineTooLong);\n        } else {\n          this.fail(this.posOf(j), BadVersion);\n        }\n      }\n      return;\n    }\n    if (j >= n) {\n      return;\n    }\n    const d = HTTP_CLASS.charCodeAt(xs[j].toUsize());\n    if (this.isReq) {\n      if (d == C_CR) {\n        this.go(S_START_LF);\n        this.cur = j + 1;\n        return;\n      }\n      if (d == C_LF) {\n        this.fail(this.posOf(j), BareLf);\n      } else {\n        this.fail(this.posOf(j), BadVersion);\n      }\n      return;\n    }\n    if (d == C_SP) {\n      if (this.lineLen >= this.lineMax) {\n        this.fail(this.posOf(j), StartLineTooLong);\n        return;\n      }\n      this.lineLen += 1;\n      this.go(S_CODE);\n      this.code = 0;\n      this.codeDigits = 0;\n      this.cur = j + 1;\n      return;\n    }\n    if (d == C_LF) {\n      this.fail(this.posOf(j), BareLf);\n    } else {\n      this.fail(this.posOf(j), BadStatusLine);\n    }\n  }\n\n  // CODE: exactly three digits (first 1..5), then SP.\n  @Requires(this.state == S_CODE && this.cur < n && n <= xs.length)\n  @Ensures(this.cur > old(this.cur) || this.state == S_ERROR)\n  private doCode(xs: u8[], n: usize): void {\n    let j = this.cur;\n    while (j < n && this.codeDigits < 3 && this.lineLen < this.lineMax) {\n      const c = xs[j].toInt();\n      if (c < 48 || c > 57 || (this.codeDigits == 0 && (c < 49 || c > 53))) {\n        this.cur = j;\n        this.fail(this.posOf(j), BadStatusCode);\n        return;\n      }\n      this.code = this.code * 10 + (c - 48);\n      this.codeDigits += 1;\n      this.lineLen += 1;\n      j += 1;\n    }\n    this.cur = j;\n    if (this.codeDigits < 3) {\n      if (j < n) {\n        if (this.lineLen >= this.lineMax && HTTP_CLASS.charCodeAt(xs[j].toUsize()) != C_CR) {\n          this.fail(this.posOf(j), StartLineTooLong);\n        } else {\n          this.fail(this.posOf(j), BadStatusCode);\n        }\n      }\n      return;\n    }\n    if (j >= n) {\n      return;\n    }\n    const d = HTTP_CLASS.charCodeAt(xs[j].toUsize());\n    if (d == C_SP) {\n      if (this.lineLen >= this.lineMax) {\n        this.fail(this.posOf(j), StartLineTooLong);\n        return;\n      }\n      this.lineLen += 1;\n      this.go(S_REASON);\n      this.cur = j + 1;\n      return;\n    }\n    if (d == C_LF) {\n      this.fail(this.posOf(j), BareLf);\n    } else {\n      this.fail(this.posOf(j), BadStatusLine);\n    }\n  }\n\n  // REASON: a run of field bytes, then CR.\n  @Requires(this.state == S_REASON && this.cur < n && n <= xs.length)\n  @Ensures(this.cur > old(this.cur) || this.state == S_ERROR)\n  private doReason(xs: u8[], n: usize): void {\n    const i = this.cur;\n    const room = this.lineMax - this.lineLen;\n    const lim = (n - i) < room ? n : i + room;\n    let j = i;\n    while (j < lim && HTTP_CLASS.charCodeAt(xs[j].toUsize()) >= C_HTAB) {\n      j += 1;\n    }\n    let tok = \"\";\n    if (j > i) {\n      tok = sliceString(xs, i, j);\n      this.lineLen += j - i;\n    }\n    this.cur = j;\n    if (j >= n) {\n      if (j > i) {\n        this.acc += tok;\n      }\n      return;\n    }\n    const c = HTTP_CLASS.charCodeAt(xs[j].toUsize());\n    if (c >= C_HTAB) {\n      if (j > i) {\n        this.acc += tok;\n      }\n      return;\n    }\n    if (c == C_CR) {\n      if (this.acc.length > 0) {\n        this.acc += tok;\n        tok = this.acc;\n        this.acc = \"\";\n      }\n      this.reason = tok;\n      this.go(S_START_LF);\n      this.cur = j + 1;\n      return;\n    }\n    if (c == C_LF) {\n      this.fail(this.posOf(j), BareLf);\n    } else {\n      this.fail(this.posOf(j), BadStatusLine);\n    }\n  }\n\n  // START_LF: the LF of the start line; then the header section begins.\n  @Requires(this.state == S_START_LF && this.cur < xs.length)\n  @Ensures(this.cur > old(this.cur) || this.state == S_ERROR)\n  private doStartLf(xs: u8[]): void {\n    const i = this.cur;\n    if (xs[i].toInt() != 10) {\n      this.fail(this.posOf(i), BareCr);\n      return;\n    }\n    if (this.isReq && !isValidTarget(this.meth, this.target)) {\n      this.fail(this.targetPos, BadTarget);\n      return;\n    }\n    this.go(S_HDR_LINE);\n    this.lineLen = 0;\n    this.lineMax = this.maxLine;\n    this.lineStart = posAt(this.base, this.off, i) + 1;\n    this.cur = i + 1;\n  }\n\n  // ----------------------------------------------------------------------------- header and trailer fields\n\n  // HDR_LINE: the first byte of a line of the header (or trailer) section.\n  @Requires(this.state == S_HDR_LINE && this.cur < n && n <= xs.length)\n  @Ensures(this.cur > old(this.cur) || this.state == S_ERROR)\n  private doLineStart(xs: u8[], n: usize): void {\n    const i = this.cur;\n    const c = HTTP_CLASS.charCodeAt(xs[i].toUsize());\n    if (c >= C_TOKEN) {\n      const count = this.inTrailers ? this.tnames.length : this.hnames.length;\n      if (count >= this.maxCount) {\n        this.fail(this.posOf(i), TooManyHeaders);\n        return;\n      }\n      this.lineStart = posAt(this.base, this.off, i);\n      this.lineLen = 0;\n      this.go(S_HDR_NAME);\n      this.doName(xs, n);\n      return;\n    }\n    if (c == C_CR) {\n      this.go(S_HEAD_END_LF);\n      this.cur = i + 1;\n      return;\n    }\n    if (c == C_LF) {\n      this.fail(this.posOf(i), BareLf);\n    } else if (c == C_SP || c == C_HTAB) {\n      this.fail(this.posOf(i), ObsFold);\n    } else {\n      this.fail(this.posOf(i), BadHeaderName);\n    }\n  }\n\n  // HDR_NAME: a run of token characters, then \":\".\n  @Requires(this.state == S_HDR_NAME && this.cur < n && n <= xs.length)\n  @Ensures(this.cur > old(this.cur) || this.state == S_ERROR)\n  private doName(xs: u8[], n: usize): void {\n    const i = this.cur;\n    const room = this.lineMax - this.lineLen;\n    const lim = (n - i) < room ? n : i + room;\n    let j = i;\n    while (j < lim && HTTP_CLASS.charCodeAt(xs[j].toUsize()) >= C_TOKEN) {\n      j += 1;\n    }\n    let tok = \"\";\n    if (j > i) {\n      tok = sliceString(xs, i, j);\n      this.lineLen += j - i;\n    }\n    this.cur = j;\n    if (j >= n) {\n      if (j > i) {\n        this.acc += tok;\n      }\n      return;\n    }\n    const c = HTTP_CLASS.charCodeAt(xs[j].toUsize());\n    if (c >= C_TOKEN) {\n      if (j > i) {\n        this.acc += tok;\n      }\n      return;\n    }\n    if (c == C_COLON) {\n      if (this.lineLen >= this.lineMax) {\n        this.fail(this.posOf(j), HeaderLineTooLong);\n        return;\n      }\n      this.lineLen += 1;\n      if (this.acc.length > 0) {\n        this.acc += tok;\n        tok = this.acc;\n        this.acc = \"\";\n      }\n      this.curName = tok;\n      this.go(S_HDR_OWS);\n      this.cur = j + 1;\n      return;\n    }\n    if (c == C_SP || c == C_HTAB) {\n      this.fail(this.posOf(j), SpaceBeforeColon);\n    } else if (c == C_CR) {\n      this.fail(this.posOf(j), MissingColon);\n    } else if (c == C_LF) {\n      this.fail(this.posOf(j), BareLf);\n    } else {\n      this.fail(this.posOf(j), BadHeaderName);\n    }\n  }\n\n  // HDR_OWS: optional whitespace after the colon, then the value (or CR for an empty value).\n  @Requires(this.state == S_HDR_OWS && this.cur < n && n <= xs.length)\n  @Ensures(this.cur > old(this.cur) || this.state == S_ERROR)\n  private doOws(xs: u8[], n: usize): void {\n    const i = this.cur;\n    const room = this.lineMax - this.lineLen;\n    const lim = (n - i) < room ? n : i + room;\n    let j = i;\n    while (j < lim && isOws(xs[j].toInt())) {\n      j += 1;\n    }\n    this.lineLen += j - i;\n    this.cur = j;\n    if (j >= n) {\n      return;\n    }\n    const c = HTTP_CLASS.charCodeAt(xs[j].toUsize());\n    if (c == C_SP || c == C_HTAB) {\n      return;\n    }\n    if (c == C_CR) {\n      this.curValue = \"\";\n      this.go(S_HDR_LF);\n      this.cur = j + 1;\n      return;\n    }\n    this.go(S_HDR_VALUE);\n    if (j > i) {\n      return;\n    }\n    this.doValue(xs, n);\n  }\n\n  // HDR_VALUE: a run of field bytes, then CR; trailing blanks are not part of the value.\n  @Requires(this.state == S_HDR_VALUE && this.cur < n && n <= xs.length)\n  @Ensures(this.cur > old(this.cur) || this.state == S_ERROR)\n  private doValue(xs: u8[], n: usize): void {\n    const i = this.cur;\n    const room = this.lineMax - this.lineLen;\n    const lim = (n - i) < room ? n : i + room;\n    let j = i;\n    while (j < lim && HTTP_CLASS.charCodeAt(xs[j].toUsize()) >= C_HTAB) {\n      j += 1;\n    }\n    this.lineLen += j - i;\n    this.cur = j;\n    if (j >= n || (j == lim && HTTP_CLASS.charCodeAt(xs[j].toUsize()) >= C_HTAB)) {\n      if (j > i) {\n        const tok = sliceString(xs, i, j);\n        this.acc += tok;\n      }\n      return;\n    }\n    const c = HTTP_CLASS.charCodeAt(xs[j].toUsize());\n    if (c == C_CR) {\n      let e = j;\n      while (e > i && isOws(xs[e - 1].toInt())) {\n        e -= 1;\n      }\n      if (this.acc.length == 0) {\n        this.curValue = sliceString(xs, i, e);\n      } else {\n        this.acc += sliceString(xs, i, e);\n        this.curValue = trimEndOws(this.acc);\n        this.acc = \"\";\n      }\n      this.go(S_HDR_LF);\n      this.cur = j + 1;\n      return;\n    }\n    if (c == C_LF) {\n      this.fail(this.posOf(j), BareLf);\n    } else {\n      this.fail(this.posOf(j), BadHeaderValue);\n    }\n  }\n\n  // HDR_LF: the LF that ends a header line; the field is complete and checked.\n  @Requires(this.state == S_HDR_LF && this.cur < xs.length)\n  @Ensures(this.cur > old(this.cur) || this.state == S_ERROR)\n  private doHeaderLf(xs: u8[]): void {\n    const i = this.cur;\n    if (xs[i].toInt() != 10) {\n      this.fail(this.posOf(i), BareCr);\n      return;\n    }\n    this.commitHeader();\n    if (this.state == S_ERROR) {\n      return;\n    }\n    this.go(S_HDR_LINE);\n    this.lineLen = 0;\n    this.lineStart = posAt(this.base, this.off, i) + 1;\n    this.cur = i + 1;\n  }\n\n  // The field (curName, curValue) is complete: apply the framing and Host rules, then store it.\n  @Requires(this.state == S_HDR_LF)\n  @Ensures(this.state == S_ERROR || this.state == S_HDR_LF)\n  private commitHeader(): void {\n    const name = this.curName;\n    if (this.inTrailers) {\n      if (isForbiddenTrailerName(name)) {\n        this.fail(this.lineStart, ForbiddenTrailer);\n        return;\n      }\n      this.tnames.push(name);\n      this.tvals.push(this.curValue);\n      return;\n    }\n    const nl = name.length;\n    if (nl == 14 && eqIgnoreCase(name, \"content-length\")) {\n      this.clCount += 1;\n      if (this.clCount > 1) {\n        this.fail(this.lineStart, DuplicateContentLength);\n        return;\n      }\n      const v = parseContentLength(this.curValue);\n      if (v.isNone()) {\n        this.fail(this.lineStart, BadContentLength);\n        return;\n      }\n      this.clValue = v.unwrap();\n    } else if (nl == 17 && eqIgnoreCase(name, \"transfer-encoding\")) {\n      this.teCount += 1;\n      if (this.teCount > 1) {\n        this.fail(this.lineStart, DuplicateTransferEncoding);\n        return;\n      }\n      if (!eqIgnoreCase(this.curValue, \"chunked\")) {\n        this.fail(this.lineStart, UnsupportedTransferEncoding);\n        return;\n      }\n    } else if (nl == 4 && this.isReq && eqIgnoreCase(name, \"host\")) {\n      this.hostCount += 1;\n      if (this.hostCount > 1) {\n        this.fail(this.lineStart, DuplicateHost);\n        return;\n      }\n      if (!isHostValue(this.curValue)) {\n        this.fail(this.lineStart, BadHost);\n        return;\n      }\n    }\n    this.hnames.push(name);\n    this.hvals.push(this.curValue);\n  }\n\n  // HEAD_END_LF: the LF of the empty line. The end of the headers decides the framing; the end of the trailers\n  // ends the message.\n  @Requires(this.state == S_HEAD_END_LF && this.cur < xs.length)\n  @Ensures(this.cur > old(this.cur) || this.state == S_ERROR)\n  private doHeadEnd(xs: u8[]): void {\n    const i = this.cur;\n    if (xs[i].toInt() != 10) {\n      this.fail(this.posOf(i), BareCr);\n      return;\n    }\n    this.cur = i + 1;\n    if (this.inTrailers) {\n      this.go(S_DONE);\n      return;\n    }\n    this.decideFraming(this.posOf(i) - 1);\n  }\n\n  // End of the header section at `at` (the CR of the empty line): apply the rules that need all the fields and pick\n  // how the body is delimited (RFC 9112 \xc2\xa76.3).\n  @Requires(this.state == S_HEAD_END_LF && !this.inTrailers)\n  @Ensures(this.state != S_HEAD_END_LF)\n  private decideFraming(at: usize): void {\n    if (this.isReq && this.minor == 1 && this.hostCount == 0) {\n      this.fail(at, MissingHost);\n      return;\n    }\n    if (this.teCount > 0 && this.minor == 0) {\n      this.fail(at, UnsupportedTransferEncoding);\n      return;\n    }\n    if (this.teCount > 0 && this.clCount > 0) {\n      this.fail(at, ContentLengthWithTransferEncoding);\n      return;\n    }\n    let bodyless = false;\n    if (!this.isReq) {\n      if ((this.code < 200 || this.code == 204) && (this.teCount > 0 || this.clCount > 0)) {\n        this.fail(at, ForbiddenFraming);\n        return;\n      }\n      bodyless = this.forHead || this.code < 200 || this.code == 204 || this.code == 304;\n    }\n    if (bodyless) {\n      this.go(S_DONE);\n      return;\n    }\n    if (this.teCount > 0) {\n      this.framing = F_CHUNKED;\n      this.chunkSize = 0;\n      this.chunkDigits = 0;\n      this.lineLen = 0;\n      this.lineMax = this.maxChunk;\n      this.go(S_CHUNK_SIZE);\n      return;\n    }\n    if (this.clCount > 0) {\n      if (this.clValue > this.maxBody) {\n        this.fail(at, BodyTooLarge);\n        return;\n      }\n      if (this.clValue == 0) {\n        this.go(S_DONE);\n        return;\n      }\n      this.framing = F_LENGTH;\n      this.remaining = this.clValue;\n      this.go(S_BODY);\n      return;\n    }\n    if (this.isReq) {\n      this.go(S_DONE);\n      return;\n    }\n    this.framing = F_CLOSE;\n    this.go(S_BODY_CLOSE);\n  }\n\n  // ------------------------------------------------------------------------------------------------ body\n  // The body states take the cursor as an absolute index into the chunk (no window): they slice the chunk.\n\n  // BODY: the next bytes of a Content-Length body: a slice of the chunk, no copy.\n  @Requires(this.state == S_BODY && this.cur < n && n <= chunk.length())\n  @Ensures(this.cur > old(this.cur))\n  private doBody(chunk: Bytes, n: usize): void {\n    const i = this.cur;\n    const avail = n - i;\n    const take = avail < this.remaining ? avail : this.remaining;\n    this.parts.push(chunk.slice(i, i + take));\n    this.remaining -= take;\n    this.bodyLen += take;\n    if (this.remaining == 0) {\n      this.go(S_DONE);\n    }\n    this.cur = i + take;\n  }\n\n  // BODY_CLOSE: a response body that runs until the peer closes (`atEof`), within the body limit.\n  @Requires(this.state == S_BODY_CLOSE && this.cur < n && n <= chunk.length())\n  @Ensures(this.cur > old(this.cur) || this.state == S_ERROR)\n  private doBodyClose(chunk: Bytes, n: usize): void {\n    const i = this.cur;\n    const room = this.maxBody - this.bodyLen;\n    if (room == 0) {\n      this.fail(this.base0 + i, BodyTooLarge);\n      return;\n    }\n    const avail = n - i;\n    const take = avail < room ? avail : room;\n    this.parts.push(chunk.slice(i, i + take));\n    this.bodyLen += take;\n    this.cur = i + take;\n  }\n\n  // CHUNK_DATA: the next bytes of the current chunk: a slice of the input.\n  @Requires(this.state == S_CHUNK_DATA && this.cur < n && n <= chunk.length())\n  @Ensures(this.cur > old(this.cur))\n  private doChunkData(chunk: Bytes, n: usize): void {\n    const i = this.cur;\n    const avail = n - i;\n    const take = avail < this.remaining ? avail : this.remaining;\n    this.parts.push(chunk.slice(i, i + take));\n    this.remaining -= take;\n    this.bodyLen += take;\n    if (this.remaining == 0) {\n      this.go(S_CHUNK_CR);\n    }\n    this.cur = i + take;\n  }\n\n  // CHUNK_SIZE: hexadecimal digits of the chunk size, then (BWS) \";\" extension or CR.\n  @Requires(this.state == S_CHUNK_SIZE && this.cur < n && n <= xs.length)\n  @Ensures(this.cur > old(this.cur) || this.state == S_ERROR)\n  private doChunkSize(xs: u8[], n: usize): void {\n    const i = this.cur;\n    const room = this.lineMax - this.lineLen;\n    const lim = (n - i) < room ? n : i + room;\n    const allowed = this.maxBody - this.bodyLen;\n    let sz = this.chunkSize;\n    let j = i;\n    while (j < lim) {\n      const hv = HTTP_HEXV.charCodeAt(xs[j].toUsize());\n      if (hv > 15) {\n        break;\n      }\n      sz = sz * 16 + hv.toUsize();\n      if (sz > allowed) {\n        this.chunkSize = sz;\n        this.cur = j;\n        this.fail(this.posOf(j), BodyTooLarge);\n        return;\n      }\n      j += 1;\n    }\n    this.chunkSize = sz;\n    this.chunkDigits += j - i;\n    this.lineLen += j - i;\n    this.cur = j;\n    if (j >= n) {\n      return;\n    }\n    if (HTTP_HEXV.charCodeAt(xs[j].toUsize()) <= 15) {\n      return;\n    }\n    const c = HTTP_CLASS.charCodeAt(xs[j].toUsize());\n    if (this.chunkDigits == 0) {\n      this.fail(this.posOf(j), BadChunkSize);\n      return;\n    }\n    if (c == C_CR) {\n      this.go(S_CHUNK_SIZE_LF);\n      this.cur = j + 1;\n      return;\n    }\n    if (c == C_SEMI || c == C_SP || c == C_HTAB) {\n      if (this.lineLen >= this.lineMax) {\n        this.fail(this.posOf(j), ChunkLineTooLong);\n        return;\n      }\n      this.lineLen += 1;\n      this.go(c == C_SEMI ? S_CHUNK_EXT : S_CHUNK_BWS);\n      this.cur = j + 1;\n      return;\n    }\n    if (c == C_LF) {\n      this.fail(this.posOf(j), BareLf);\n    } else {\n      this.fail(this.posOf(j), BadChunkSize);\n    }\n  }\n\n  // CHUNK_BWS: blanks after the size, then \";\" or CR.\n  @Requires(this.state == S_CHUNK_BWS && this.cur < n && n <= xs.length)\n  @Ensures(this.cur > old(this.cur) || this.state == S_ERROR)\n  private doChunkBws(xs: u8[], n: usize): void {\n    const i = this.cur;\n    const room = this.lineMax - this.lineLen;\n    const lim = (n - i) < room ? n : i + room;\n    let j = i;\n    while (j < lim && isOws(xs[j].toInt())) {\n      j += 1;\n    }\n    this.lineLen += j - i;\n    this.cur = j;\n    if (j >= n) {\n      return;\n    }\n    const c = HTTP_CLASS.charCodeAt(xs[j].toUsize());\n    if (c == C_SP || c == C_HTAB) {\n      return;\n    }\n    if (c == C_CR) {\n      this.go(S_CHUNK_SIZE_LF);\n      this.cur = j + 1;\n      return;\n    }\n    if (c == C_SEMI) {\n      if (this.lineLen >= this.lineMax) {\n        this.fail(this.posOf(j), ChunkLineTooLong);\n        return;\n      }\n      this.lineLen += 1;\n      this.go(S_CHUNK_EXT);\n      this.cur = j + 1;\n      return;\n    }\n    if (c == C_LF) {\n      this.fail(this.posOf(j), BareLf);\n    } else {\n      this.fail(this.posOf(j), BadChunkSize);\n    }\n  }\n\n  // CHUNK_EXT: the chunk extension, ignored: a run of field bytes, then CR; control characters are refused.\n  @Requires(this.state == S_CHUNK_EXT && this.cur < n && n <= xs.length)\n  @Ensures(this.cur > old(this.cur) || this.state == S_ERROR)\n  private doChunkExt(xs: u8[], n: usize): void {\n    const i = this.cur;\n    const room = this.lineMax - this.lineLen;\n    const lim = (n - i) < room ? n : i + room;\n    let j = i;\n    while (j < lim && HTTP_CLASS.charCodeAt(xs[j].toUsize()) >= C_HTAB) {\n      j += 1;\n    }\n    this.lineLen += j - i;\n    this.cur = j;\n    if (j >= n) {\n      return;\n    }\n    const c = HTTP_CLASS.charCodeAt(xs[j].toUsize());\n    if (c >= C_HTAB) {\n      return;\n    }\n    if (c == C_CR) {\n      this.go(S_CHUNK_SIZE_LF);\n      this.cur = j + 1;\n      return;\n    }\n    if (c == C_LF) {\n      this.fail(this.posOf(j), BareLf);\n    } else {\n      this.fail(this.posOf(j), BadChunkExtension);\n    }\n  }\n\n  // CHUNK_SIZE_LF: the LF of the chunk-size line. Size 0: the trailer section follows; else the chunk data.\n  // (The cursor is an index into the storage array here; the chunk data state that follows uses a cursor relative to\n  // the chunk, which `feed` recomputes from the chunk's start in the array.)\n  @Requires(this.state == S_CHUNK_SIZE_LF && this.cur < xs.length)\n  @Ensures(this.cur > old(this.cur) || this.state == S_ERROR)\n  private doChunkSizeLf(xs: u8[]): void {\n    const i = this.cur;\n    if (xs[i].toInt() != 10) {\n      this.fail(this.posOf(i), BareCr);\n      return;\n    }\n    this.cur = i + 1;\n    if (this.chunkSize == 0) {\n      this.inTrailers = true;\n      this.sectionEnd = posAt(this.base, this.off, i) + 1 + this.maxHead;\n      this.lineLen = 0;\n      this.lineMax = this.maxLine;\n      this.lineStart = posAt(this.base, this.off, i) + 1;\n      this.go(S_HDR_LINE);\n      return;\n    }\n    this.remaining = this.chunkSize;\n    this.go(S_CHUNK_DATA);\n  }\n\n  // CHUNK_CR: the CR after the chunk data.\n  @Requires(this.state == S_CHUNK_CR && this.cur < xs.length)\n  @Ensures(this.cur > old(this.cur) || this.state == S_ERROR)\n  private doChunkCr(xs: u8[]): void {\n    const i = this.cur;\n    const c = xs[i].toInt();\n    if (c == 13) {\n      this.go(S_CHUNK_LF);\n      this.cur = i + 1;\n      return;\n    }\n    if (c == 10) {\n      this.fail(this.posOf(i), BareLf);\n    } else {\n      this.fail(this.posOf(i), BadChunkTerminator);\n    }\n  }\n\n  // CHUNK_LF: the LF after the chunk data; the next chunk-size line follows.\n  @Requires(this.state == S_CHUNK_LF && this.cur < xs.length)\n  @Ensures(this.cur > old(this.cur) || this.state == S_ERROR)\n  private doChunkLf(xs: u8[]): void {\n    const i = this.cur;\n    if (xs[i].toInt() != 10) {\n      this.fail(this.posOf(i), BareCr);\n      return;\n    }\n    this.chunkSize = 0;\n    this.chunkDigits = 0;\n    this.lineLen = 0;\n    this.lineMax = this.maxChunk;\n    this.go(S_CHUNK_SIZE);\n    this.cur = i + 1;\n  }\n\n  // ---------------------------------------------------------------------------------- the finished message\n\n  // bodyBytes(): the collected body (all `parts` concatenated; one part is returned as it is, without a copy, and no\n  // part as the parser's one empty `Bytes`).\n  @Requires(this.state == S_DONE)\n  @Ensures(result.length() == this.bodyLen)\n  bodyBytes(): Bytes {\n    if (this.parts.length == 0) {\n      return this.noBody;\n    }\n    if (this.parts.length == 1) {\n      return this.parts[0];\n    }\n    let all = new ByteBuilder();\n    all.reserve(this.bodyLen);\n    let k: usize = 0;\n    while (k < this.parts.length) {\n      all.appendBytes(this.parts[k]);\n      k += 1;\n    }\n    return all.build();\n  }\n\n  // httpVersion(): the version of the start line.\n  @Requires(this.state == S_DONE)\n  httpVersion(): HttpVersion {\n    return this.minor == 0 ? Http10 : Http11;\n  }\n\n  // buildRequest(): the parsed request (the constructor re-checks every rule). Request parsers only.\n  @Requires(this.state == S_DONE && this.isReq)\n  buildRequest(): Request {\n    return new Request(this.meth, this.target, this.httpVersion(), new Headers(this.hnames, this.hvals), this.bodyBytes(),\n      new Headers(this.tnames, this.tvals));\n  }\n\n  // buildResponse(): the parsed response. Response parsers only.\n  @Requires(this.state == S_DONE && !this.isReq)\n  buildResponse(): Response {\n    return new Response(new Status(this.code, this.reason), this.httpVersion(), new Headers(this.hnames, this.hvals),\n      this.bodyBytes(), new Headers(this.tnames, this.tvals), this.forHead);\n  }\n}\n\n\n// --------------------------------------------------------------------------------- public parser classes\n\n// The incremental HTTP/1.1 request parser. `feed` accepts bytes in arbitrary chunks; see the top of the file.\n// After `Done` (or `Failed`) call `reset()` to parse the next message of a connection.\n@Invariant(this.core.stateCode() >= S_METHOD && this.core.stateCode() <= S_ERROR)\n@Invariant(!this.core.isDone() || this.core.consumed() > 0)\nexport class RequestParser {\n  private core: MessageParser;\n\n  constructor(limits: Limits) {\n    this.core = new MessageParser(true, false, limits);\n  }\n\n  // feed(chunk): the next bytes of the request. NeedMore | Done(request, used) | Failed(error). O(chunk) per call.\n  @Ensures(resultKind(result) == 0 ==> !this.isDone() && !this.isFailed())\n  @Ensures(resultKind(result) == 1 ==> this.isDone() && resultUsed(result) <= chunk.length())\n  @Ensures(resultKind(result) == 2 ==> this.isFailed() || old(this.isDone()))\n  feed(chunk: Bytes): ParseResult<Request> {\n    const r = this.core.feed(chunk);\n    return match (r) {\n      NeedMore => NeedMore,\n      Failed(e) => Failed(e),\n      Done(z, used) => Done(this.core.buildRequest(), used)\n    };\n  }\n\n  // atEof(): the peer closed the connection: always `Failed(UnexpectedEof)` for a request that is not complete.\n  @Ensures(resultKind(result) == 2)\n  atEof(): ParseResult<Request> {\n    const r = this.core.atEof();\n    return match (r) {\n      NeedMore => NeedMore,\n      Failed(e) => Failed(e),\n      Done(z, used) => Done(this.core.buildRequest(), used)\n    };\n  }\n\n  // reset(): start a new message. O(1).\n  @Ensures(this.isIdle())\n  reset(): void {\n    this.core.reset();\n  }\n\n  // isIdle(): no byte of a message consumed yet (a connection closed now is a clean close). O(1).\n  @Ensures(result == (this.consumed() == 0 && !this.isDone() && !this.isFailed()))\n  isIdle(): bool {\n    return this.core.isIdle();\n  }\n\n  // isDone() / isFailed(): terminal states. O(1).\n  isDone(): bool {\n    return this.core.isDone();\n  }\n\n  isFailed(): bool {\n    return this.core.isFailed();\n  }\n\n  // consumed(): bytes consumed since the start of the message. O(1).\n  consumed(): usize {\n    return this.core.consumed();\n  }\n\n  // stateName(): the current state, e.g. \"HDR_VALUE\". O(1).\n  @Ensures(result.length > 0)\n  stateName(): string {\n    return stateName(this.core.stateCode());\n  }\n}\n\n// The incremental HTTP/1.1 response parser (for a client). `forHead`: the response is to a HEAD request, so no body\n// follows whatever the headers say. A response without Content-Length and Transfer-Encoding ends at connection\n// close: feed all input, then call `atEof()` for `Done`.\n@Invariant(this.core.stateCode() >= S_VERSION && this.core.stateCode() <= S_ERROR)\nexport class ResponseParser {\n  private core: MessageParser;\n\n  constructor(limits: Limits, forHead: bool) {\n    this.core = new MessageParser(false, forHead, limits);\n  }\n\n  // feed(chunk): the next bytes of the response. NeedMore | Done(response, used) | Failed(error). O(chunk) per call.\n  @Ensures(resultKind(result) == 0 ==> !this.isDone() && !this.isFailed())\n  @Ensures(resultKind(result) == 1 ==> this.isDone() && resultUsed(result) <= chunk.length())\n  @Ensures(resultKind(result) == 2 ==> this.isFailed() || old(this.isDone()))\n  feed(chunk: Bytes): ParseResult<Response> {\n    const r = this.core.feed(chunk);\n    return match (r) {\n      NeedMore => NeedMore,\n      Failed(e) => Failed(e),\n      Done(z, used) => Done(this.core.buildResponse(), used)\n    };\n  }\n\n  // atEof(): the peer closed the connection: `Done` for a response whose body runs until close, else\n  // `Failed(UnexpectedEof)`.\n  @Ensures(resultKind(result) != 0)\n  atEof(): ParseResult<Response> {\n    const r = this.core.atEof();\n    return match (r) {\n      NeedMore => NeedMore,\n      Failed(e) => Failed(e),\n      Done(z, used) => Done(this.core.buildResponse(), used)\n    };\n  }\n\n  // reset(): start a new message. O(1).\n  @Ensures(this.isIdle())\n  reset(): void {\n    this.core.reset();\n  }\n\n  // isIdle(): no byte of a message consumed yet. O(1).\n  isIdle(): bool {\n    return this.core.isIdle();\n  }\n\n  // isDone() / isFailed(): terminal states. O(1).\n  isDone(): bool {\n    return this.core.isDone();\n  }\n\n  isFailed(): bool {\n    return this.core.isFailed();\n  }\n\n  // consumed(): bytes consumed since the start of the message. O(1).\n  consumed(): usize {\n    return this.core.consumed();\n  }\n\n  // stateName(): the current state. O(1).\n  @Ensures(result.length > 0)\n  stateName(): string {\n    return stateName(this.core.stateCode());\n  }\n}\n\n// parseRequest(data, limits): a one-shot parse of all of `data` (a fresh parser, one `feed`). NeedMore when `data`\n// is a proper prefix of a message; `Done(request, used)` leaves `data[used..]` for the next message. O(data).\n@Ensures(resultKind(result) == 1 ==> resultUsed(result) <= data.length())\nexport function parseRequest(data: Bytes, limits: Limits): ParseResult<Request> {\n  let p = new RequestParser(limits);\n  return p.feed(data);\n}\n\n// parseResponse(data, limits, forHead): the same for a response; `atEof` is NOT applied (use `parseResponseToEof`\n// for a response that ends at connection close). O(data).\n@Ensures(resultKind(result) == 1 ==> resultUsed(result) <= data.length())\nexport function parseResponse(data: Bytes, limits: Limits, forHead: bool): ParseResult<Response> {\n  let p = new ResponseParser(limits, forHead);\n  return p.feed(data);\n}\n\n// parseResponseToEof(data, limits, forHead): `data` is everything the peer sent before it closed the connection;\n// a close-delimited body is complete. O(data).\nexport function parseResponseToEof(data: Bytes, limits: Limits, forHead: bool): ParseResult<Response> {\n  let p = new ResponseParser(limits, forHead);\n  const r = p.feed(data);\n  if (resultKind(r) == 0) {\n    return p.atEof();\n  }\n  return r;\n}\n\n\n\n// ------------------------------------------------------------------------------------------- serializer\n\n// hexString(n): n in lower-case hexadecimal without leading zeros (\"0\" for 0). O(digits).\n@Ensures(result.length >= 1)\nexport function hexString(n: usize): string {\n  if (n == 0) {\n    return \"0\";\n  }\n  let digits: string[] = [];\n  let v = n;\n  while (v > 0) {\n    digits.push(\"0123456789abcdef\".charAt(v % 16));\n    v = v / 16;\n  }\n  let out = \"\";\n  let k = digits.length;\n  while (k > 0) {\n    k -= 1;\n    out += digits[k];\n  }\n  return out;\n}\n\n// The fields of `h`, one line each: `name: value CRLF`. Names and values were validated by `Headers`, so no field\n// can contain a CR or LF: a field can never end its line early or start another one (no header injection).\n@Ensures(result.length == headerBytes(h))\nfunction fieldsText(h: Headers): string {\n  let out = \"\";\n  let i: usize = 0;\n  while (i < h.count()) {\n    out += h.nameAt(i);\n    out += \": \";\n    out += h.valueAt(i);\n    out += \"\\r\\n\";\n    i += 1;\n  }\n  return out;\n}\n\n// The serialized size of the fields of `h`.\nfunction headerBytes(h: Headers): usize {\n  let n: usize = 0;\n  let i: usize = 0;\n  while (i < h.count()) {\n    n += h.nameAt(i).length + h.valueAt(i).length + 4;\n    i += 1;\n  }\n  return n;\n}\n\n// A chunked body: chunks of at most `chunkSize` bytes, the last chunk, the trailers and the final CRLF.\n@Requires(chunkSize >= 1)\n@Ensures(result.length() >= 5 + body.length() + headerBytes(trailers))\nfunction chunkedBytes(body: Bytes, trailers: Headers, chunkSize: usize): Bytes {\n  let out = new ByteBuilder();\n  let off: usize = 0;\n  while (off < body.length()) {\n    const left = body.length() - off;\n    const take = left < chunkSize ? left : chunkSize;\n    out.appendString(hexString(take));\n    out.appendString(\"\\r\\n\");\n    out.appendBytes(body.slice(off, off + take));\n    out.appendString(\"\\r\\n\");\n    off += take;\n  }\n  out.appendString(\"0\\r\\n\");\n  out.appendString(fieldsText(trailers));\n  out.appendString(\"\\r\\n\");\n  return out.build();\n}\n\n// Limits large enough for any message of `n` bytes (the contract of the serializers parses their output with them).\nfunction limitsFor(n: usize): Limits {\n  const big = n < 16 ? 16 : (n > 1048576 ? 1048576 : n);\n  const head = n < 64 ? 64 : (n > 67108864 ? 67108864 : n);\n  return new Limits(big, 65536, big, head, 1024, n);\n}\n\n// Does the parser accept `wire` as exactly the request `r`? (The round-trip check of the contracts.)\nfunction roundTripsRequest(wire: Bytes, r: Request): bool {\n  if (wire.length() > 1048576 || r.headers().count() > 65536 || r.trailers().count() > 65536) {\n    return true;\n  }\n  const p = parseRequest(wire, limitsFor(wire.length()));\n  return match (p) {\n    Done(q, used) => used == wire.length() && q.equals(r),\n    _ => false\n  };\n}\n\n// Does the parser accept `wire` as exactly the response `r`?\nfunction roundTripsResponse(wire: Bytes, r: Response): bool {\n  if (wire.length() > 1048576 || r.headers().count() > 65536 || r.trailers().count() > 65536) {\n    return true;\n  }\n  const p = parseResponseToEof(wire, limitsFor(wire.length()), r.isForHead());\n  return match (p) {\n    Done(q, used) => q.equals(r),\n    _ => false\n  };\n}\n\n// serializeRequestChunked(r, chunkSize): the request as bytes; a chunked body is split into chunks of at most\n// `chunkSize` bytes. ROUND-TRIP CONTRACT: for every request `r` the parser accepts the output (with limits that fit\n// it) and returns a request equal to `r`: parse(serialize(r)) == r. O(size).\n@Requires(chunkSize >= 1)\n@Ensures(roundTripsRequest(result, r))\nexport function serializeRequestChunked(r: Request, chunkSize: usize): Bytes {\n  let out = new ByteBuilder();\n  out.appendString(methodName(r.method()));\n  out.appendString(\" \");\n  out.appendString(r.target());\n  out.appendString(\" \");\n  out.appendString(versionText(r.version()));\n  out.appendString(\"\\r\\n\");\n  out.appendString(fieldsText(r.headers()));\n  out.appendString(\"\\r\\n\");\n  if (r.isChunked()) {\n    out.appendBytes(chunkedBytes(r.body(), r.trailers(), chunkSize));\n  } else {\n    out.appendBytes(r.body());\n  }\n  return out.build();\n}\n\n// serializeRequest(r): the request as bytes (a chunked body in one chunk). The output starts with the request line\n// and ends with the last byte of the body; every line ends with CRLF. Round-trip contract as above. O(size).\n@Ensures(roundTripsRequest(result, r))\nexport function serializeRequest(r: Request): Bytes {\n  const size = r.body().length();\n  return serializeRequestChunked(r, size == 0 ? 1 : size);\n}\n\n// serializeResponseChunked(r, chunkSize): the response as bytes; a chunked body is split into chunks of at most\n// `chunkSize` bytes; a bodyless response (HEAD, 1xx, 204, 304) has no body bytes. Round-trip contract: the parser\n// (`parseResponseToEof`, with `forHead` as in `r`) accepts the output and returns a response equal to `r`. O(size).\n@Requires(chunkSize >= 1)\n@Ensures(roundTripsResponse(result, r))\nexport function serializeResponseChunked(r: Response, chunkSize: usize): Bytes {\n  let out = new ByteBuilder();\n  out.appendString(versionText(r.version()));\n  out.appendString(\" \");\n  out.appendString(r.status().code().toString());\n  out.appendString(\" \");\n  out.appendString(r.status().reason());\n  out.appendString(\"\\r\\n\");\n  out.appendString(fieldsText(r.headers()));\n  out.appendString(\"\\r\\n\");\n  if (!r.isBodyless()) {\n    if (r.isChunked()) {\n      out.appendBytes(chunkedBytes(r.body(), r.trailers(), chunkSize));\n    } else {\n      out.appendBytes(r.body());\n    }\n  }\n  return out.build();\n}\n\n// serializeResponse(r): the response as bytes (a chunked body in one chunk). Round-trip contract as above. O(size).\n@Ensures(roundTripsResponse(result, r))\nexport function serializeResponse(r: Response): Bytes {\n  const size = r.body().length();\n  return serializeResponseChunked(r, size == 0 ? 1 : size);\n}\n\n" });
  out.push(SourceFile { path: "$stdlib/json.or", text: "// std:json -- JSON values, parser and printers (spec 08, ADR-0016).\n//\n// Data model: `Json` is a plain union (no classes), so values copy like any other value and are\n// inspected with `match`. Numbers are INTEGERS ONLY (`JNum(int)`) until floats land; see the\n// TODO(after floats/map) notes. Objects are ordered field lists (`JField[]`), not maps.\n//\n//   * parse accepts RFC 8259 JSON with these restrictions: numbers must be integers in the\n//     range -9223372036854775807 .. 9223372036854775807; a fraction or exponent (`1.5`, `1e3`)\n//     is a JsonError (\"floats are not supported yet\"). Nesting deeper than 200 levels is an error.\n//   * Strings are Orin byte strings holding UTF-8. `\\uXXXX` escapes decode to UTF-8; a surrogate\n//     pair gives one 4-byte sequence, a lone surrogate gives U+FFFD. Raw control characters\n//     (< 0x20) inside strings are rejected. Bytes >= 0x80 are copied through unchanged (the\n//     input is not validated as UTF-8).\n//   * Duplicate object keys are kept (in order); `get` returns the LAST occurrence (JS semantics).\n//   * Errors carry the byte offset plus a 1-based line and column (column counts bytes after the\n//     last \"\\n\"; \"\\r\\n\" ends a line at \"\\n\").\n//   * stringify is compact and deterministic; `pretty` indents with spaces. Object field order is\n//     insertion order. Strings escape `\"`, `\\`, \\b \\f \\n \\r \\t and other control characters as\n//     \\u00XX; all other bytes pass through unchanged.\n//\n// TODO(after floats/map): JNum(float) / separate JFloat, `parse<T>` is post-1.0 (ADR-0016).\n\nexport type Json = JNull | JBool(bool) | JNum(int) | JStr(string) | JArr(Json[]) | JObj(JField[]);\n\nexport type JField = { key: string; value: Json; };\n\n// Parse failure: `message` describes the problem, `offset` is the 0-based byte offset where it was\n// detected (== text length for \"unexpected end of input\"), `line`/`column` are 1-based.\nexport type JsonError = { message: string; offset: usize; line: usize; column: usize; };\n\n// ---- constructors -------------------------------------------------------------------------\n\n// field(key: string, value: Json): JField -- builds an object field. O(1).\nexport function field(key: string, value: Json): JField {\n  return JField { key: key, value: value };\n}\n\n// ---- parser -------------------------------------------------------------------------------\n\ntype PErr = { msg: string; at: usize; };\ntype PRes = { v: Json; pos: usize; };\ntype SRes = { text: string; pos: usize; };\ntype NRes = { n: int; pos: usize; };\n\nconst MAX_DEPTH: int = 200;\n\nfunction fail(msg: string, at: usize): PErr {\n  return PErr { msg: msg, at: at };\n}\n\nfunction isWs(c: int): bool {\n  return c == 32 || c == 9 || c == 10 || c == 13;\n}\n\nfunction skipWs(s: string, start: usize): usize {\n  let i = start;\n  while (i < s.length && isWs(s.charCodeAt(i))) {\n    i += 1;\n  }\n  return i;\n}\n\nfunction hexVal(c: int): int {\n  if (c >= 48 && c <= 57) {\n    return c - 48;\n  }\n  if (c >= 97 && c <= 102) {\n    return c - 87;\n  }\n  if (c >= 65 && c <= 70) {\n    return c - 55;\n  }\n  return -1;\n}\n\n// Four hex digits at `at`, or -1.\nfunction hex4(s: string, at: usize): int {\n  if (at + 4 > s.length) {\n    return -1;\n  }\n  let v = 0;\n  let k: usize = 0;\n  while (k < 4) {\n    const h = hexVal(s.charCodeAt(at + k));\n    if (h < 0) {\n      return -1;\n    }\n    v = v * 16 + h;\n    k += 1;\n  }\n  return v;\n}\n\nfunction utf8(cp: int): string {\n  if (cp < 128) {\n    return String.fromCharCode(cp);\n  }\n  if (cp < 2048) {\n    return String.fromCharCode(192 + cp / 64) + String.fromCharCode(128 + cp % 64);\n  }\n  if (cp < 65536) {\n    return String.fromCharCode(224 + cp / 4096) + String.fromCharCode(128 + (cp / 64) % 64)\n      + String.fromCharCode(128 + cp % 64);\n  }\n  return String.fromCharCode(240 + cp / 262144) + String.fromCharCode(128 + (cp / 4096) % 64)\n    + String.fromCharCode(128 + (cp / 64) % 64) + String.fromCharCode(128 + cp % 64);\n}\n\n// `s[start]` is the opening quote.\nfunction parseString(s: string, start: usize): Result<SRes, PErr> {\n  let out = \"\";\n  let i = start + 1;\n  let runStart = i;\n  while (true) {\n    if (i >= s.length) {\n      return Err(fail(\"unterminated string\", start));\n    }\n    const c = s.charCodeAt(i);\n    if (c == 34) {\n      if (i > runStart) {\n        out += s.substring(runStart, i);\n      }\n      return Ok(SRes { text: out, pos: i + 1 });\n    }\n    if (c < 32) {\n      return Err(fail(\"control character in string\", i));\n    }\n    if (c != 92) {\n      i += 1;\n      continue;\n    }\n    if (i > runStart) {\n      out += s.substring(runStart, i);\n    }\n    if (i + 1 >= s.length) {\n      return Err(fail(\"unterminated escape\", i));\n    }\n    const e = s.charCodeAt(i + 1);\n    i += 2;\n    if (e == 34) {\n      out += \"\\\"\";\n    } else if (e == 92) {\n      out += \"\\\\\";\n    } else if (e == 47) {\n      out += \"/\";\n    } else if (e == 98) {\n      out += String.fromCharCode(8);\n    } else if (e == 102) {\n      out += String.fromCharCode(12);\n    } else if (e == 110) {\n      out += \"\\n\";\n    } else if (e == 114) {\n      out += \"\\r\";\n    } else if (e == 116) {\n      out += \"\\t\";\n    } else if (e == 117) {\n      const u = hex4(s, i);\n      if (u < 0) {\n        return Err(fail(\"invalid \\\\u escape\", i - 2));\n      }\n      i += 4;\n      let cp = u;\n      if (u >= 55296 && u <= 56319) {\n        // High surrogate: needs a following \\uDC00..\\uDFFF.\n        let lo = -1;\n        if (i + 1 < s.length && s.charCodeAt(i) == 92 && s.charCodeAt(i + 1) == 117) {\n          lo = hex4(s, i + 2);\n        }\n        if (lo >= 56320 && lo <= 57343) {\n          cp = 65536 + (u - 55296) * 1024 + (lo - 56320);\n          i += 6;\n        } else {\n          cp = 65533;\n        }\n      } else if (u >= 56320 && u <= 57343) {\n        cp = 65533;\n      }\n      out += utf8(cp);\n    } else {\n      return Err(fail(\"invalid escape\", i - 2));\n    }\n    runStart = i;\n  }\n  return Err(fail(\"unreachable\", i));\n}\n\nfunction isDigit(c: int): bool {\n  return c >= 48 && c <= 57;\n}\n\nconst INT_MAX: int = 9223372036854775807;\n\nfunction parseNumber(s: string, start: usize): Result<NRes, PErr> {\n  let i = start;\n  let neg = false;\n  if (s.charCodeAt(i) == 45) {\n    neg = true;\n    i += 1;\n  }\n  const ds = i;\n  while (i < s.length && isDigit(s.charCodeAt(i))) {\n    i += 1;\n  }\n  if (i == ds) {\n    return Err(fail(\"invalid number\", start));\n  }\n  if (i - ds > 1 && s.charCodeAt(ds) == 48) {\n    return Err(fail(\"leading zero in number\", ds));\n  }\n  let v = 0;\n  let k = ds;\n  while (k < i) {\n    const d = s.charCodeAt(k) - 48;\n    if (v > (INT_MAX - d) / 10) {\n      return Err(fail(\"integer out of range\", start));\n    }\n    v = v * 10 + d;\n    k += 1;\n  }\n  if (i < s.length && (s.charCodeAt(i) == 46 || s.charCodeAt(i) == 101 || s.charCodeAt(i) == 69)) {\n    return Err(fail(\"floats are not supported yet (integers only)\", i));\n  }\n  if (neg) {\n    v = 0 - v;\n  }\n  return Ok(NRes { n: v, pos: i });\n}\n\nfunction expectLit(s: string, at: usize, lit: string): bool {\n  if (at + lit.length > s.length) {\n    return false;\n  }\n  return s.substring(at, at + lit.length) == lit;\n}\n\nfunction parseValue(s: string, start: usize, depth: int): Result<PRes, PErr> {\n  const i = skipWs(s, start);\n  if (i >= s.length) {\n    return Err(fail(\"unexpected end of input\", i));\n  }\n  if (depth > MAX_DEPTH) {\n    return Err(fail(\"nesting too deep\", i));\n  }\n  const c = s.charCodeAt(i);\n  if (c == 34) {\n    const r = parseString(s, i)?;\n    return Ok(PRes { v: JStr(r.text), pos: r.pos });\n  }\n  if (c == 123) {\n    return parseObject(s, i, depth);\n  }\n  if (c == 91) {\n    return parseArray(s, i, depth);\n  }\n  if (c == 45 || isDigit(c)) {\n    const r = parseNumber(s, i)?;\n    return Ok(PRes { v: JNum(r.n), pos: r.pos });\n  }\n  if (expectLit(s, i, \"true\")) {\n    return Ok(PRes { v: JBool(true), pos: i + 4 });\n  }\n  if (expectLit(s, i, \"false\")) {\n    return Ok(PRes { v: JBool(false), pos: i + 5 });\n  }\n  if (expectLit(s, i, \"null\")) {\n    return Ok(PRes { v: JNull, pos: i + 4 });\n  }\n  return Err(fail(\"unexpected character\", i));\n}\n\nfunction parseArray(s: string, start: usize, depth: int): Result<PRes, PErr> {\n  let items: Json[] = [];\n  let i = skipWs(s, start + 1);\n  if (i < s.length && s.charCodeAt(i) == 93) {\n    return Ok(PRes { v: JArr(items), pos: i + 1 });\n  }\n  while (true) {\n    const r = parseValue(s, i, depth + 1)?;\n    items.push(r.v);\n    i = skipWs(s, r.pos);\n    if (i >= s.length) {\n      return Err(fail(\"unexpected end of input, expected `,` or `]`\", i));\n    }\n    const c = s.charCodeAt(i);\n    if (c == 93) {\n      return Ok(PRes { v: JArr(items), pos: i + 1 });\n    }\n    if (c != 44) {\n      return Err(fail(\"expected `,` or `]`\", i));\n    }\n    i += 1;\n  }\n  return Err(fail(\"unreachable\", i));\n}\n\nfunction parseObject(s: string, start: usize, depth: int): Result<PRes, PErr> {\n  let fields: JField[] = [];\n  let i = skipWs(s, start + 1);\n  if (i < s.length && s.charCodeAt(i) == 125) {\n    return Ok(PRes { v: JObj(fields), pos: i + 1 });\n  }\n  while (true) {\n    i = skipWs(s, i);\n    if (i >= s.length) {\n      return Err(fail(\"unexpected end of input, expected string key\", i));\n    }\n    if (s.charCodeAt(i) != 34) {\n      return Err(fail(\"expected string key\", i));\n    }\n    const k = parseString(s, i)?;\n    i = skipWs(s, k.pos);\n    if (i >= s.length) {\n      return Err(fail(\"unexpected end of input, expected `:`\", i));\n    }\n    if (s.charCodeAt(i) != 58) {\n      return Err(fail(\"expected `:`\", i));\n    }\n    const r = parseValue(s, i + 1, depth + 1)?;\n    fields.push(JField { key: k.text, value: r.v });\n    i = skipWs(s, r.pos);\n    if (i >= s.length) {\n      return Err(fail(\"unexpected end of input, expected `,` or `}`\", i));\n    }\n    const c = s.charCodeAt(i);\n    if (c == 125) {\n      return Ok(PRes { v: JObj(fields), pos: i + 1 });\n    }\n    if (c != 44) {\n      return Err(fail(\"expected `,` or `}`\", i));\n    }\n    i += 1;\n  }\n  return Err(fail(\"unreachable\", i));\n}\n\n// 1-based line and column of byte `offset` in `s`.\nfunction locate(s: string, offset: usize): JsonError {\n  let line: usize = 1;\n  let lineStart: usize = 0;\n  let i: usize = 0;\n  while (i < offset && i < s.length) {\n    if (s.charCodeAt(i) == 10) {\n      line += 1;\n      lineStart = i + 1;\n    }\n    i += 1;\n  }\n  return JsonError { message: \"\", offset: offset, line: line, column: offset - lineStart + 1 };\n}\n\nfunction toError(s: string, e: PErr): JsonError {\n  const l = locate(s, e.at);\n  return JsonError { message: e.msg, offset: e.at, line: l.line, column: l.column };\n}\n\n// parse(text: string): Result<Json, JsonError>\n// Parses one JSON document (surrounding whitespace allowed, trailing characters are an error:\n// \"trailing characters\"). Errors: syntax errors, unsupported floats, integer overflow, nesting\n// deeper than 200, each with offset/line/column. Complexity: O(n) time and allocation (plus\n// O(n) to locate the line/column of an error).\nexport function parse(text: string): Result<Json, JsonError> {\n  const r = parseValue(text, 0, 0);\n  if (r.isErr()) {\n    return Err(toError(text, r.unwrapErr()));\n  }\n  const ok = r.unwrap();\n  const end = skipWs(text, ok.pos);\n  if (end < text.length) {\n    return Err(toError(text, fail(\"trailing characters\", end)));\n  }\n  return Ok(ok.v);\n}\n\n// formatError(e: JsonError): string -- \"line L, column C: message\". O(1).\nexport function formatError(e: JsonError): string {\n  return \"line \" + e.line.toString() + \", column \" + e.column.toString() + \": \" + e.message;\n}\n\n// ---- printers -----------------------------------------------------------------------------\n\nfunction hexDigit(n: int): string {\n  if (n < 10) {\n    return String.fromCharCode(48 + n);\n  }\n  return String.fromCharCode(87 + n);\n}\n\n// quote(s: string): string -- `s` as a JSON string literal with escapes. O(n).\nexport function quote(s: string): string {\n  let out = \"\\\"\";\n  let runStart: usize = 0;\n  let i: usize = 0;\n  while (i < s.length) {\n    const c = s.charCodeAt(i);\n    if (c == 34 || c == 92 || c < 32) {\n      if (i > runStart) {\n        out += s.substring(runStart, i);\n      }\n      if (c == 34) {\n        out += \"\\\\\\\"\";\n      } else if (c == 92) {\n        out += \"\\\\\\\\\";\n      } else if (c == 10) {\n        out += \"\\\\n\";\n      } else if (c == 13) {\n        out += \"\\\\r\";\n      } else if (c == 9) {\n        out += \"\\\\t\";\n      } else if (c == 8) {\n        out += \"\\\\b\";\n      } else if (c == 12) {\n        out += \"\\\\f\";\n      } else {\n        out += \"\\\\u00\" + hexDigit(c / 16) + hexDigit(c % 16);\n      }\n      runStart = i + 1;\n    }\n    i += 1;\n  }\n  if (s.length > runStart) {\n    out += s.substring(runStart, s.length);\n  }\n  out += \"\\\"\";\n  return out;\n}\n\nfunction emit(j: Json, out: string[]): string[] {\n  let o = out;\n  match (j) {\n    JNull => { o.push(\"null\"); },\n    JBool(b) => { o.push(b ? \"true\" : \"false\"); },\n    JNum(n) => { o.push(n.toString()); },\n    JStr(s) => { o.push(quote(s)); },\n    JArr(a) => {\n      o.push(\"[\");\n      let i: usize = 0;\n      while (i < a.length) {\n        if (i > 0) {\n          o.push(\",\");\n        }\n        o = emit(a[i], o);\n        i += 1;\n      }\n      o.push(\"]\");\n    },\n    JObj(fs) => {\n      o.push(\"{\");\n      let i: usize = 0;\n      while (i < fs.length) {\n        if (i > 0) {\n          o.push(\",\");\n        }\n        o.push(quote(fs[i].key));\n        o.push(\":\");\n        o = emit(fs[i].value, o);\n        i += 1;\n      }\n      o.push(\"}\");\n    }\n  }\n  return o;\n}\n\n// stringify(j: Json): string\n// Compact deterministic serialization (no whitespace). Never fails. O(n) in the size of `j`.\n// parse(stringify(j)) == j for every j whose integers are in range.\nexport function stringify(j: Json): string {\n  const out: string[] = [];\n  return emit(j, out).join(\"\");\n}\n\nfunction spaces(n: usize): string {\n  let out = \"\";\n  let i: usize = 0;\n  while (i < n) {\n    out += \" \";\n    i += 1;\n  }\n  return out;\n}\n\nfunction emitPretty(j: Json, indent: usize, level: usize, out: string[]): string[] {\n  let o = out;\n  match (j) {\n    JArr(a) => {\n      if (a.length == 0) {\n        o.push(\"[]\");\n      } else {\n        o.push(\"[\\n\");\n        let i: usize = 0;\n        while (i < a.length) {\n          o.push(spaces(indent * (level + 1)));\n          o = emitPretty(a[i], indent, level + 1, o);\n          o.push(i + 1 < a.length ? \",\\n\" : \"\\n\");\n          i += 1;\n        }\n        o.push(spaces(indent * level));\n        o.push(\"]\");\n      }\n    },\n    JObj(fs) => {\n      if (fs.length == 0) {\n        o.push(\"{}\");\n      } else {\n        o.push(\"{\\n\");\n        let i: usize = 0;\n        while (i < fs.length) {\n          o.push(spaces(indent * (level + 1)));\n          o.push(quote(fs[i].key));\n          o.push(\": \");\n          o = emitPretty(fs[i].value, indent, level + 1, o);\n          o.push(i + 1 < fs.length ? \",\\n\" : \"\\n\");\n          i += 1;\n        }\n        o.push(spaces(indent * level));\n        o.push(\"}\");\n      }\n    },\n    _ => { o = emit(j, o); }\n  }\n  return o;\n}\n\n// pretty(j: Json, indent: usize): string\n// Multi-line serialization: one array element / object field per line, `indent` spaces per\n// nesting level, \": \" after keys, empty containers as `[]` / `{}`, no trailing newline.\n// `pretty(j, 0)` still puts every element on its own line (use `stringify` for compact output).\n// Never fails. O(n) in the size of `j` (plus the indentation written).\nexport function pretty(j: Json, indent: usize): string {\n  const out: string[] = [];\n  return emitPretty(j, indent, 0, out).join(\"\");\n}\n\n// ---- accessors ----------------------------------------------------------------------------\n// All accessors are total: a wrong kind or a missing key gives None. They never trap.\n\n// get(j: Json, key: string): Option<Json>\n// The value of field `key` when `j` is an object (the LAST field with that key), else None.\n// O(fields).\nexport function get(j: Json, key: string): Option<Json> {\n  return match (j) {\n    JObj(fs) => lastField(fs, key),\n    _ => None\n  };\n}\n\nfunction lastField(fs: JField[], key: string): Option<Json> {\n  let i = fs.length;\n  while (i > 0) {\n    i -= 1;\n    if (fs[i].key == key) {\n      return Some(fs[i].value);\n    }\n  }\n  return None;\n}\n\n// at(j: Json, index: usize): Option<Json> -- element `index` of an array, else None. O(1).\nexport function at(j: Json, index: usize): Option<Json> {\n  return match (j) {\n    JArr(a) => index < a.length ? Some(a[index]) : None,\n    _ => None\n  };\n}\n\n// path(j: Json, keys: string[]): Option<Json> -- follows object keys: path(j, [\"a\", \"b\"]) is\n// get(get(j, \"a\"), \"b\"); an empty `keys` gives Some(j). O(sum of fields visited).\nexport function path(j: Json, keys: string[]): Option<Json> {\n  let cur = j;\n  for (const k of keys) {\n    const f = get(cur, k);\n    if (f.isNone()) {\n      return None;\n    }\n    cur = f.unwrap();\n  }\n  return Some(cur);\n}\n\n// asString(j: Json): Option<string> -- Some for JStr. O(1).\nexport function asString(j: Json): Option<string> {\n  return match (j) {\n    JStr(s) => Some(s),\n    _ => None\n  };\n}\n\n// asInt(j: Json): Option<int> -- Some for JNum. O(1).\nexport function asInt(j: Json): Option<int> {\n  return match (j) {\n    JNum(n) => Some(n),\n    _ => None\n  };\n}\n\n// asBool(j: Json): Option<bool> -- Some for JBool. O(1).\nexport function asBool(j: Json): Option<bool> {\n  return match (j) {\n    JBool(b) => Some(b),\n    _ => None\n  };\n}\n\n// asArray(j: Json): Option<Json[]> -- Some for JArr. O(1) (the array is copied lazily).\nexport function asArray(j: Json): Option<Json[]> {\n  return match (j) {\n    JArr(a) => Some(a),\n    _ => None\n  };\n}\n\n// asObject(j: Json): Option<JField[]> -- Some for JObj, in insertion order. O(1).\nexport function asObject(j: Json): Option<JField[]> {\n  return match (j) {\n    JObj(fs) => Some(fs),\n    _ => None\n  };\n}\n\n// isNull(j: Json): bool -- true for JNull. O(1).\nexport function isNull(j: Json): bool {\n  return match (j) {\n    JNull => true,\n    _ => false\n  };\n}\n\n// keys(j: Json): string[] -- the field names of an object in order (duplicates included);\n// [] for any non-object. O(fields).\nexport function keys(j: Json): string[] {\n  let out: string[] = [];\n  match (j) {\n    JObj(fs) => {\n      for (const f of fs) {\n        out.push(f.key);\n      }\n    },\n    _ => {}\n  }\n  return out;\n}\n\n// getString / getInt / getBool / getArray: `get` followed by the matching `as*`; None when the\n// key is missing or has another kind. O(fields).\nexport function getString(j: Json, key: string): Option<string> {\n  const f = get(j, key);\n  if (f.isNone()) {\n    return None;\n  }\n  return asString(f.unwrap());\n}\n\nexport function getInt(j: Json, key: string): Option<int> {\n  const f = get(j, key);\n  if (f.isNone()) {\n    return None;\n  }\n  return asInt(f.unwrap());\n}\n\nexport function getBool(j: Json, key: string): Option<bool> {\n  const f = get(j, key);\n  if (f.isNone()) {\n    return None;\n  }\n  return asBool(f.unwrap());\n}\n\nexport function getArray(j: Json, key: string): Option<Json[]> {\n  const f = get(j, key);\n  if (f.isNone()) {\n    return None;\n  }\n  return asArray(f.unwrap());\n}\n" });
  out.push(SourceFile { path: "$stdlib/net.or", text: "// std:net -- blocking TCP on the L0 network primitives (ADR-0033, ADR-0027, ADR-0025). UNSTABLE (ADR-0016).\n//\n// Authority. Every function that touches the network takes a handle as its first argument. The root `NetGrant` comes\n// from `main(host: Host)` through `useNet(host, net => ...)` (std:host). It is NARROWED, never widened:\n//   useListen(net, addr, port, l => ...)                       `l` may listen on `addr:port` only\n//   useConnect(net, hostPattern, portLo, portHi, c => ...)     `c` may connect / resolve only names matching the pattern\n// A host pattern is \"*\" (any), \"*.example.com\" (names below example.com) or an exact name or address, compared with the\n// text the program supplies (ASCII case-insensitive; see ADR-0033 for the limits). A request outside the scope is refused\n// with `Err(NetError)` (isDenied) by L0 before any system call. `ORIN_DENY=net` denies the whole family the same way.\n//\n// Resources. `Listener` and `Stream` are RESOURCE HANDLES (ADR-0025, like `File`): they exist only as the parameter of a\n// scope function (`withListener`, `withAccepted`, `withConnection`) and are closed when it returns, on every path; they\n// cannot be stored, copied, returned or captured by a closure (E0450-E0452 and the MIR verifier). Because a Stream\n// cannot be stored, state that belongs to one connection (the bytes read ahead, a parser) lives in a normal value\n// next to it: a `StreamReader`, an `http.RequestParser`.\n//\n// Time. Every call that can wait takes a timeout in milliseconds (0 .. 3,600,000); there is no infinite wait. A timeout\n// of `readUntil` / `readExact` / `sendAll` is a DEADLINE for the whole operation (a client that sends one byte per\n// `timeout - 1` ms does not extend it); `recv` / `send` / `accept` time out per call.\n//\n// Blocking and single threaded: one connection is served at a time until tasks exist (ADR-0017); a slow client holds\n// the server up to the deadlines you set.\n//\n// Errors never trap, except a forged / stale / wrong-kind handle (the runtime traps: it is a bug, not a condition).\n//\n// Contract standard (ADR-0030): every class has an @Invariant, every public function states @Requires / @Ensures.\n\nimport { Bytes, bytesFromArray, emptyBytes } from \"std:bytes\";\nimport {\n  NetGrant, Listener, Stream, grantListen, grantConnect, grantRevoke, netListen, netAccept, netConnect, netStatus, netClose,\n  netPort, netNow, netRecv, netSend, netShutdown, netPeer, netResolve, netErrorText\n} from \"std:fsraw\";\n\nexport { NetGrant, Listener, Stream } from \"std:fsraw\";\n\n// ------------------------------------------------------------------------------------------------ errors\n\n// An error of this module: the L0 code and a message. Codes: 1 permission denied (scope or ORIN_DENY), 1001 closed by the\n// peer, 1002 timeout, 1003 reset; others are the errno of the OS (ECONNREFUSED, EADDRINUSE, ENOENT for an unknown name ...).\nexport type NetError = { code: int; message: string; };\n\nconst CODE_DENIED: int = 1;\nconst CODE_EOF: int = 1001;\nconst CODE_TIMEOUT: int = 1002;\nconst CODE_RESET: int = 1003;\nconst MAX_MS: int = 3600000;\nconst CHUNK: usize = 65536;\n\n// makeError(code): the NetError of an L0 code. O(1).\n@Ensures(result.code == code)\nexport function makeError(code: int): NetError {\n  return NetError { code: code, message: netErrorText(code) };\n}\n\n// isDenied(e): refused by the grant's scope or by the host policy. O(1).\nexport function isDenied(e: NetError): bool {\n  return e.code == CODE_DENIED;\n}\n\n// isTimeout(e): nothing happened within the time given. O(1).\nexport function isTimeout(e: NetError): bool {\n  return e.code == CODE_TIMEOUT;\n}\n\n// isReset(e): the connection was reset or broke. O(1).\nexport function isReset(e: NetError): bool {\n  return e.code == CODE_RESET;\n}\n\n@Ensures(result >= 0 && result <= MAX_MS)\n@Ensures(ms >= 0 && ms <= MAX_MS ==> result == ms)\nfunction clampMs(ms: int): int {\n  if (ms < 0) {\n    return 0;\n  }\n  return ms > MAX_MS ? MAX_MS : ms;\n}\n\n// ------------------------------------------------------------------------------------------------ peers\n\n// The address of the other end of a stream: `host` is the numeric address, `port` its port.\nexport type Peer = { host: string; port: int; };\n\n// parsePeer(text): \"1.2.3.4:5\" or \"[::1]:5\" to a Peer; Peer { host: text, port: 0 } if the text has no port. O(n).\n@Ensures(result.port >= 0 && result.port <= 100001)\nexport function parsePeer(text: string): Peer {\n  let i = text.length;\n  while (i > 0) {\n    i -= 1;\n    if (text.charCodeAt(i) == 58) {\n      const port = text.substring(i + 1, text.length);\n      const p = parseDigits(port);\n      let h = text.substring(0, i);\n      if (h.length >= 2 && h.charCodeAt(0) == 91 && h.charCodeAt(h.length - 1) == 93) {\n        h = h.substring(1, h.length - 1);\n      }\n      return Peer { host: h, port: p };\n    }\n  }\n  return Peer { host: text, port: 0 };\n}\n\nfunction parseDigits(s: string): int {\n  let v: int = 0;\n  let i: usize = 0;\n  while (i < s.length) {\n    const c = s.charCodeAt(i);\n    if (c < 48 || c > 57 || v > 100000) {\n      return 0;\n    }\n    v = v * 10 + (c - 48);\n    i += 1;\n  }\n  return v;\n}\n\n// ------------------------------------------------------------------------------------------------ narrowing\n\n// withListen(net, addr, port, body): runs body with a grant that can only listen on exactly `addr:port` (addr is an\n// address literal; \"0.0.0.0\", \"127.0.0.1\", \"::1\" ...; port 0 = any port the OS picks). If `net` does not allow that, the\n// grant reaches nothing (every listen is refused). The grant is revoked when body returns. O(1).\nexport function withListen<T>(net: NetGrant, addr: string, port: int, body: (l: NetGrant) => T): T {\n  const g = grantListen(net, addr, port);\n  const r = body(g);\n  grantRevoke(g);\n  return r;\n}\n\n// useListen: `withListen` for a body that returns nothing.\nexport function useListen(net: NetGrant, addr: string, port: int, body: (l: NetGrant) => void): void {\n  const g = grantListen(net, addr, port);\n  body(g);\n  grantRevoke(g);\n}\n\n// withConnect(net, hostPattern, portLo, portHi, body): a grant that can only connect to / resolve hosts matching\n// `hostPattern` on ports portLo..portHi. A pattern or range outside `net`'s scope yields a grant that reaches nothing. O(1).\nexport function withConnect<T>(net: NetGrant, hostPattern: string, portLo: int, portHi: int, body: (c: NetGrant) => T): T {\n  const g = grantConnect(net, hostPattern, portLo, portHi);\n  const r = body(g);\n  grantRevoke(g);\n  return r;\n}\n\n// useConnect: `withConnect` for a body that returns nothing.\nexport function useConnect(net: NetGrant, hostPattern: string, portLo: int, portHi: int, body: (c: NetGrant) => void): void {\n  const g = grantConnect(net, hostPattern, portLo, portHi);\n  body(g);\n  grantRevoke(g);\n}\n\n// ------------------------------------------------------------------------------------------------ listeners\n\n// withListener(net, addr, port, backlog, body): binds a listener on addr:port (SO_REUSEADDR), runs body(listener) and\n// closes it. `Err` if `net` does not allow it (isDenied), the port is in use or the arguments are invalid; body is not\n// called then. `port` 0 binds a free port, `portOf(listener)` tells which. backlog 1..4096. The listener is created\n// through a grant narrowed to exactly addr:port.\nexport function withListener<T>(net: NetGrant, addr: string, port: int, backlog: int, body: (ln: Listener) => T): Result<T, NetError> {\n  const g = grantListen(net, addr, port);\n  const ln = netListen(g, addr, port, backlog, 1);\n  const code = netStatus(ln);\n  if (code != 0) {\n    netClose(ln);\n    grantRevoke(g);\n    return Err(makeError(code));\n  }\n  const r = body(ln);\n  netClose(ln);\n  grantRevoke(g);\n  return Ok(r);\n}\n\n// useListener: `withListener` for a body that returns nothing.\nexport function useListener(net: NetGrant, addr: string, port: int, backlog: int, body: (ln: Listener) => void): Result<void, NetError> {\n  const g = grantListen(net, addr, port);\n  const ln = netListen(g, addr, port, backlog, 1);\n  const code = netStatus(ln);\n  if (code != 0) {\n    netClose(ln);\n    grantRevoke(g);\n    return Err(makeError(code));\n  }\n  body(ln);\n  netClose(ln);\n  grantRevoke(g);\n  return Ok();\n}\n\n// useListenerNet(net, addr, port, backlog, body): `useListener` whose body also receives `net` again as a parameter (a\n// closure cannot capture a grant, so a body that must also connect, for example a loopback test, gets it this way).\nexport function useListenerNet(\n  net: NetGrant, addr: string, port: int, backlog: int, body: (ln: Listener, net: NetGrant) => void\n): Result<void, NetError> {\n  const g = grantListen(net, addr, port);\n  const ln = netListen(g, addr, port, backlog, 1);\n  const code = netStatus(ln);\n  if (code != 0) {\n    netClose(ln);\n    grantRevoke(g);\n    return Err(makeError(code));\n  }\n  body(ln, net);\n  netClose(ln);\n  grantRevoke(g);\n  return Ok();\n}\n\n// portOf(ln): the port the listener is bound to (the real one when it was asked for port 0). O(1).\n@Ensures(result >= 0 && result <= 65535)\nexport function portOf(ln: Listener): int {\n  return netPort(ln);\n}\n\n// withAccepted(ln, timeoutMs, body): waits up to timeoutMs for a connection, runs body(stream, peer) and closes the\n// stream (a graceful `close` after `shutdownWrite` is the body's business). `Err(timeout)` if none came (isTimeout:\n// normal in a server loop), another Err on failure. TCP_NODELAY is on.\nexport function withAccepted<T>(ln: Listener, timeoutMs: int, body: (s: Stream, peer: Peer) => T): Result<T, NetError> {\n  const s = netAccept(ln, clampMs(timeoutMs), 1);\n  const code = netStatus(s);\n  if (code != 0) {\n    netClose(s);\n    return Err(makeError(code));\n  }\n  const peer = parsePeer(netPeer(s));\n  const r = body(s, peer);\n  netClose(s);\n  return Ok(r);\n}\n\n// useAccepted: `withAccepted` for a body that returns nothing.\nexport function useAccepted(ln: Listener, timeoutMs: int, body: (s: Stream, peer: Peer) => void): Result<void, NetError> {\n  const s = netAccept(ln, clampMs(timeoutMs), 1);\n  const code = netStatus(s);\n  if (code != 0) {\n    netClose(s);\n    return Err(makeError(code));\n  }\n  const peer = parsePeer(netPeer(s));\n  body(s, peer);\n  netClose(s);\n  return Ok();\n}\n\n// ------------------------------------------------------------------------------------------------ connections\n\n// withConnection(net, host, port, timeoutMs, body): connects (a name is resolved by the OS first: that lookup is not\n// bounded by timeoutMs), runs body(stream) and closes the stream. `Err` if refused (isDenied), unreachable or timed out.\nexport function withConnection<T>(net: NetGrant, host: string, port: int, timeoutMs: int, body: (s: Stream) => T): Result<T, NetError> {\n  const s = netConnect(net, host, port, clampMs(timeoutMs), 1);\n  const code = netStatus(s);\n  if (code != 0) {\n    netClose(s);\n    return Err(makeError(code));\n  }\n  const r = body(s);\n  netClose(s);\n  return Ok(r);\n}\n\n// useConnection: `withConnection` for a body that returns nothing.\nexport function useConnection(net: NetGrant, host: string, port: int, timeoutMs: int, body: (s: Stream) => void): Result<void, NetError> {\n  const s = netConnect(net, host, port, clampMs(timeoutMs), 1);\n  const code = netStatus(s);\n  if (code != 0) {\n    netClose(s);\n    return Err(makeError(code));\n  }\n  body(s);\n  netClose(s);\n  return Ok();\n}\n\n// useConnectionBeside(net, host, port, timeoutMs, ln, body): `useConnection` whose body also receives the listener `ln`\n// again (a closure cannot capture a handle): a client and the server side of the same process, for example a loopback test.\n// The connection completes before `accept` (the kernel queues it, backlog permitting).\nexport function useConnectionBeside(\n  net: NetGrant, host: string, port: int, timeoutMs: int, ln: Listener, body: (s: Stream, ln: Listener) => void\n): Result<void, NetError> {\n  const s = netConnect(net, host, port, clampMs(timeoutMs), 1);\n  const code = netStatus(s);\n  if (code != 0) {\n    netClose(s);\n    return Err(makeError(code));\n  }\n  body(s, ln);\n  netClose(s);\n  return Ok();\n}\n\n// resolve(net, name): the numeric addresses of `name` (IPv4 and IPv6, no duplicates), or Err. The grant's scope must\n// cover `name` (any port). Not bounded by a timeout (the OS resolver's own).\nexport function resolve(net: NetGrant, name: string): Result<string[], NetError> {\n  const r = netResolve(net, name);\n  return match (r) {\n    Ok(text) => Ok(splitLines(text)),\n    Err(code) => Err(makeError(code))\n  };\n}\n\nfunction splitLines(text: string): string[] {\n  let out: string[] = [];\n  let start: usize = 0;\n  let i: usize = 0;\n  while (i < text.length) {\n    if (text.charCodeAt(i) == 10) {\n      if (i > start) {\n        out.push(text.substring(start, i));\n      }\n      start = i + 1;\n    }\n    i += 1;\n  }\n  return out;\n}\n\n// ------------------------------------------------------------------------------------------------ stream operations\n\n// The result of one `recv`.\nexport type RecvResult = RecvData(Bytes) | RecvEof | RecvTimeout | RecvReset | RecvError(NetError);\n\n// recvWithin(r, max): a RecvData holds between 1 and `max` bytes (a recv never returns more than it was asked for, and\n// never an empty chunk: that is RecvEof). Other results hold no bytes. Used in contracts.\nexport function recvWithin(r: RecvResult, max: usize): bool {\n  return match (r) {\n    RecvData(b) => b.length() >= 1 && b.length() <= max,\n    _ => true\n  };\n}\n\n// recvIsError(r): the result is RecvError. Used in contracts.\nexport function recvIsError(r: RecvResult): bool {\n  return match (r) {\n    RecvError(e) => true,\n    _ => false\n  };\n}\n\n// recv(s, maxBytes, timeoutMs): waits up to timeoutMs for bytes and returns 1..min(maxBytes, 65536) of them\n// (RecvData), or RecvEof (the peer closed: no more data ever), RecvTimeout (nothing arrived), RecvReset, or RecvError.\n// maxBytes 0 is an error. One system call; the bytes are copied once from the L0 buffer into the result.\n@Ensures(recvWithin(result, maxBytes))\n@Ensures(maxBytes == 0 ==> recvIsError(result))\nexport function recv(s: Stream, maxBytes: usize, timeoutMs: int): RecvResult {\n  if (maxBytes == 0) {\n    return RecvError(makeError(22));\n  }\n  const r = netRecv(s, maxBytes, clampMs(timeoutMs));\n  return match (r) {\n    Ok(arr) => RecvData(bytesFromArray(arr)),\n    Err(code) => recvFailure(code)\n  };\n}\n\nfunction recvFailure(code: int): RecvResult {\n  if (code == CODE_EOF) {\n    return RecvEof;\n  }\n  if (code == CODE_TIMEOUT) {\n    return RecvTimeout;\n  }\n  if (code == CODE_RESET) {\n    return RecvReset;\n  }\n  return RecvError(makeError(code));\n}\n\n// send(s, data, timeoutMs): one attempt: waits up to timeoutMs until the socket is writable and hands the OS at most\n// 65536 bytes of `data`; Ok(n) with 0 <= n <= min(length, 65536) (a partial write is normal), Err otherwise (isTimeout,\n// isReset: the peer is gone). `sendAll` loops.\nexport function send(s: Stream, data: Bytes, timeoutMs: int): Result<usize, NetError> {\n  const start = data.storageStart();\n  return sendFrom(s, data.storage(), start, start + data.length(), timeoutMs);\n}\n\n// One attempt to send arr[off, end) (the bytes of a `Bytes` read from its storage, without a copy).\n@Requires(off <= end && end <= arr.length)\nfunction sendFrom(s: Stream, arr: u8[], off: usize, end: usize, timeoutMs: int): Result<usize, NetError> {\n  const r = netSend(s, arr, off, end - off, clampMs(timeoutMs));\n  return match (r) {\n    Ok(n) => Ok(n),\n    Err(code) => Err(makeError(code))\n  };\n}\n\n// sendAll(s, data, timeoutMs): sends all of `data`, resending the tail after partial writes; timeoutMs is a deadline for\n// the whole call. Err(timeout) if the peer does not read fast enough, Err(reset) if it is gone. O(length); `data` itself\n// is not copied.\nexport function sendAll(s: Stream, data: Bytes, timeoutMs: int): Result<void, NetError> {\n  const arr = data.storage();\n  const end = data.storageStart() + data.length();\n  const deadline = netNow(s) + clampMs(timeoutMs);\n  let off = data.storageStart();\n  while (off < end) {\n    const left = deadline - netNow(s);\n    if (left <= 0) {\n      return Err(makeError(CODE_TIMEOUT));\n    }\n    const r = sendFrom(s, arr, off, end, left > MAX_MS ? MAX_MS : left);\n    match (r) {\n      Ok(n) => {\n        if (n == 0) {\n          return Err(makeError(CODE_RESET));\n        }\n        off += n;\n      },\n      Err(e) => {\n        return Err(e);\n      }\n    }\n  }\n  return Ok();\n}\n\n// shutdownWrite(s): half-close: sends FIN so the peer reads EOF while this side can still read. The first step of a\n// graceful close (then drain with `recv` for a bounded time, then let the scope close the stream); a bare close with\n// unread input makes the OS send RST, which can discard the response just written.\nexport function shutdownWrite(s: Stream): Result<void, NetError> {\n  const code = netShutdown(s, 1);\n  if (code != 0) {\n    return Err(makeError(code));\n  }\n  return Ok();\n}\n\n// nowMillis(s): a monotonic clock in milliseconds (arbitrary origin) for deadlines; it needs a live stream, so a function\n// that has no clock grant can still enforce a deadline on the connection it was given. O(1).\nexport function nowMillis(s: Stream): int {\n  return netNow(s);\n}\n\n// ------------------------------------------------------------------------------------------------ reading with a buffer\n\n// The result of `readExact` / `readUntil`: Filled(bytes), FillClosed(bytes read before the peer closed), FillLimit\n// (the limit was reached without the delimiter), FillTimeout (the deadline passed; bytes read so far stay buffered),\n// FillError.\nexport type Fill = Filled(Bytes) | FillClosed(Bytes) | FillLimit | FillTimeout | FillError(NetError);\n\n// A read buffer for one stream: the bytes read ahead of what the caller consumed. A normal value (a Stream cannot be\n// stored). `cap` bounds the buffered bytes: no operation ever holds more, so a hostile peer cannot grow it.\n@Invariant(this.cap >= 1 && this.pending.length() <= this.cap)\nexport class StreamReader {\n  private pending: Bytes;\n  private cap: usize;\n\n  // new StreamReader(cap): an empty buffer that holds at most `cap` bytes (1 .. 268435456).\n  @Requires(cap >= 1 && cap <= 268435456)\n  constructor(cap: usize) {\n    this.pending = emptyBytes();\n    this.cap = cap;\n  }\n\n  // buffered(): the bytes read ahead and not yet consumed. O(1).\n  @Ensures(result.length() <= this.cap)\n  buffered(): Bytes {\n    return this.pending;\n  }\n\n  // capacity(): the most bytes the buffer holds. O(1).\n  @Ensures(result == this.cap)\n  capacity(): usize {\n    return this.cap;\n  }\n\n  // unread(data): puts `data` back in front of the buffered bytes (for example the rest of a chunk a parser did not use).\n  @Requires(data.length() + this.pending.length() <= this.cap)\n  @Ensures(this.buffered().length() == old(this.buffered().length()) + data.length())\n  unread(data: Bytes): void {\n    this.pending = data.concat(this.pending);\n  }\n\n  // take(n): removes and returns the first n buffered bytes.\n  @Requires(n <= this.pending.length())\n  @Ensures(result.length() == n)\n  @Ensures(this.pending.length() == old(this.pending.length()) - n)\n  take(n: usize): Bytes {\n    const head = this.pending.slice(0, n);\n    this.pending = this.pending.slice(n, this.pending.length());\n    return head;\n  }\n\n  // readSome(s, maxBytes, timeoutMs): buffered bytes if there are any (at most maxBytes, no system call), else one `recv`.\n  @Requires(maxBytes >= 1)\n  readSome(s: Stream, maxBytes: usize, timeoutMs: int): RecvResult {\n    if (this.pending.length() > 0) {\n      const n = this.pending.length() < maxBytes ? this.pending.length() : maxBytes;\n      return RecvData(this.take(n));\n    }\n    return recv(s, maxBytes < this.cap ? maxBytes : this.cap, timeoutMs);\n  }\n\n  // readExact(s, n, timeoutMs): exactly n bytes (Filled), or what arrived before the peer closed (FillClosed), or\n  // FillTimeout when the DEADLINE timeoutMs (for the whole call) passed. Never reads past n bytes: further bytes stay in\n  // the stream.\n  @Requires(n <= this.cap)\n  @Ensures(match (result) { Filled(b) => b.length() == n, _ => true })\n  @Ensures(this.pending.length() <= this.cap)\n  readExact(s: Stream, n: usize, timeoutMs: int): Fill {\n    const deadline = netNow(s) + clampMs(timeoutMs);\n    while (this.pending.length() < n) {\n      const left = deadline - netNow(s);\n      if (left < 0) {\n        return FillTimeout;\n      }\n      const want = n - this.pending.length();\n      const r = recv(s, want, left);\n      match (r) {\n        RecvData(b) => {\n          this.pending = this.pending.concat(b);\n        },\n        RecvEof => {\n          return FillClosed(this.take(this.pending.length()));\n        },\n        RecvTimeout => {\n          return FillTimeout;\n        },\n        RecvReset => {\n          return FillError(makeError(CODE_RESET));\n        },\n        RecvError(e) => {\n          return FillError(e);\n        }\n      }\n    }\n    return Filled(this.take(n));\n  }\n\n  // readUntil(s, delim, limit, timeoutMs): the bytes up to and including the first occurrence of `delim` (Filled), with\n  // at most `limit` bytes examined: FillLimit if `limit` bytes contain no delimiter (the buffer then keeps them), FillClosed\n  // (the bytes so far) if the peer closed first, FillTimeout at the DEADLINE timeoutMs for the whole call. Receives at\n  // most limit - buffered bytes each time, so at most `limit` bytes are buffered by the call.\n  @Requires(delim.length() >= 1 && limit >= delim.length() && limit <= this.cap)\n  @Ensures(match (result) { Filled(b) => b.length() <= limit && b.length() >= delim.length(), _ => true })\n  @Ensures(this.pending.length() <= this.cap)\n  readUntil(s: Stream, delim: Bytes, limit: usize, timeoutMs: int): Fill {\n    const deadline = netNow(s) + clampMs(timeoutMs);\n    let begin: usize = 0;\n    while (true) {\n      const at = findFrom(this.pending, delim, begin, limit);\n      match (at) {\n        Some(end) => {\n          return Filled(this.take(end));\n        },\n        None => {}\n      }\n      if (this.pending.length() >= limit) {\n        return FillLimit;\n      }\n      begin = this.pending.length() >= delim.length() ? this.pending.length() - delim.length() + 1 : 0;\n      const left = deadline - netNow(s);\n      if (left < 0) {\n        return FillTimeout;\n      }\n      const r = recv(s, limit - this.pending.length(), left);\n      match (r) {\n        RecvData(b) => {\n          this.pending = this.pending.concat(b);\n        },\n        RecvEof => {\n          return FillClosed(this.take(this.pending.length()));\n        },\n        RecvTimeout => {\n          return FillTimeout;\n        },\n        RecvReset => {\n          return FillError(makeError(CODE_RESET));\n        },\n        RecvError(e) => {\n          return FillError(e);\n        }\n      }\n    }\n    return FillLimit;\n  }\n}\n\n// findFrom(hay, delim, begin, limit): the end index (exclusive) of the first occurrence of `delim` in hay that starts at an\n// index >= begin and ends at <= limit, or None. O(length * delim) worst case, O(length) typical.\n@Ensures(result.isSome() ==> result.unwrap() >= delim.length() && result.unwrap() <= limit && result.unwrap() <= hay.length())\nexport function findFrom(hay: Bytes, delim: Bytes, begin: usize, limit: usize): Option<usize> {\n  const n = hay.length() < limit ? hay.length() : limit;\n  const m = delim.length();\n  if (m == 0 || n < m) {\n    return None;\n  }\n  let i = begin;\n  while (i + m <= n) {\n    let k: usize = 0;\n    while (k < m && hay.at(i + k) == delim.at(k)) {\n      k += 1;\n    }\n    if (k == m) {\n      return Some(i + m);\n    }\n    i += 1;\n  }\n  return None;\n}\n" });
  out.push(SourceFile { path: "$stdlib/path.or", text: "// std:path -- lexical POSIX path utilities (spec 08, ADR-0016).\n//\n// Semantics (documented once, for every function):\n//   * Paths are byte strings with \"/\" as the only separator (POSIX). There is no Windows\n//     handling, no filesystem access, no symlink resolution and no current directory: every\n//     function is pure and lexical. Results follow Node's `path.posix` where Node has an\n//     equivalent function.\n//   * A path is absolute when it starts with \"/\".\n//   * Every function is total (never traps, never returns Result); odd input such as \"\" or\n//     \"///\" is handled as documented per function.\n//   * Complexity: all functions are O(n) in the total length of their input and allocate O(n).\n\n// Non-empty segments of `p` in order (no \".\" / \"..\" processing).\nfunction splitSegments(p: string): string[] {\n  let out: string[] = [];\n  for (const s of p.split(\"/\")) {\n    if (s.length > 0) {\n      out.push(s);\n    }\n  }\n  return out;\n}\n\n// isAbsolute(p: string): bool\n// True when `p` starts with \"/\". `isAbsolute(\"\")` is false.\nexport function isAbsolute(p: string): bool {\n  return p.length > 0 && p.charCodeAt(0) == 47;\n}\n\n// normalize(p: string): string\n// Resolves \".\" and \"..\" segments lexically and collapses repeated separators.\n//   * \"\" normalizes to \".\"; a relative path that reduces to nothing is \".\" (\"a/..\" -> \".\").\n//   * \"..\" that would climb above the root of an absolute path is dropped (\"/..\" -> \"/\");\n//     in a relative path leading \"..\" segments are kept (\"../a\", \"a/../..\" -> \"..\").\n//   * A trailing separator is preserved (\"a//b/\" -> \"a/b/\", \"./\" -> \"./\"); the root is \"/\".\n// Examples: normalize(\"/a/./b/../c\") == \"/a/c\"; normalize(\"a//b\") == \"a/b\".\nexport function normalize(p: string): string {\n  if (p.length == 0) {\n    return \".\";\n  }\n  const abs = isAbsolute(p);\n  const trailing = p.charCodeAt(p.length - 1) == 47;\n  let out: string[] = [];\n  for (const s of splitSegments(p)) {\n    if (s == \".\") {\n      continue;\n    }\n    if (s == \"..\") {\n      if (out.length > 0 && out[out.length - 1] != \"..\") {\n        out.pop();\n      } else if (!abs) {\n        out.push(\"..\");\n      }\n      continue;\n    }\n    out.push(s);\n  }\n  const body = out.join(\"/\");\n  if (abs) {\n    if (body.length == 0) {\n      return \"/\";\n    }\n    return trailing ? \"/\" + body + \"/\" : \"/\" + body;\n  }\n  if (body.length == 0) {\n    return trailing ? \"./\" : \".\";\n  }\n  return trailing ? body + \"/\" : body;\n}\n\n// join(parts: string[]): string\n// Joins the non-empty `parts` with \"/\" and normalizes the result (see `normalize`). An empty\n// list, or a list of empty strings, gives \".\". Like Node, a later absolute part does NOT reset\n// the path: join([\"a\", \"/b\"]) == \"a/b\" (use `resolveAgainst` to get reset semantics).\n// Examples: join([\"/a\", \"b\", \"../c\"]) == \"/a/c\"; join([\"a\", \"\", \"b/\"]) == \"a/b/\".\nexport function join(parts: string[]): string {\n  let kept: string[] = [];\n  for (const q of parts) {\n    if (q.length > 0) {\n      kept.push(q);\n    }\n  }\n  if (kept.length == 0) {\n    return \".\";\n  }\n  return normalize(kept.join(\"/\"));\n}\n\n// resolveAgainst(base: string, p: string): string\n// `p` normalized when `p` is absolute, otherwise join([base, p]). Pure: there is no implicit\n// current directory, so `base` must be supplied by the caller.\nexport function resolveAgainst(base: string, p: string): string {\n  if (isAbsolute(p)) {\n    return normalize(p);\n  }\n  return join([base, p]);\n}\n\n// End offset (exclusive) of `p` after dropping trailing \"/\" characters; 0 when `p` is all \"/\".\nfunction endWithoutSlashes(p: string): usize {\n  let e = p.length;\n  while (e > 0 && p.charCodeAt(e - 1) == 47) {\n    e -= 1;\n  }\n  return e;\n}\n\n// Start offset of the last segment of p[0..e) (the position after the last \"/\" before e).\nfunction lastSegmentStart(p: string, e: usize): usize {\n  let i = e;\n  while (i > 0 && p.charCodeAt(i - 1) != 47) {\n    i -= 1;\n  }\n  return i;\n}\n\n// dirname(p: string): string\n// The directory part of `p`, ignoring trailing separators; the path is NOT normalized.\n//   dirname(\"/a/b/c\") == \"/a/b\"; dirname(\"/a/b/\") == \"/a\"; dirname(\"a\") == \".\"; dirname(\"\") == \".\";\n//   dirname(\"/a\") == \"/\"; dirname(\"/\") == \"/\"; dirname(\"a//b\") == \"a\"; dirname(\"a/./b\") == \"a/.\".\nexport function dirname(p: string): string {\n  const e = endWithoutSlashes(p);\n  if (e == 0) {\n    return p.length > 0 ? \"/\" : \".\";\n  }\n  const s = lastSegmentStart(p, e);\n  if (s == 0) {\n    return \".\";\n  }\n  const d = endWithoutSlashes(p.substring(0, s));\n  if (d == 0) {\n    return \"/\";\n  }\n  return p.substring(0, d);\n}\n\n// basename(p: string): string\n// The last segment of `p`, ignoring trailing separators. basename(\"/a/b.txt\") == \"b.txt\";\n// basename(\"a/b/\") == \"b\"; basename(\"/\") == \"\"; basename(\"\") == \"\".\nexport function basename(p: string): string {\n  const e = endWithoutSlashes(p);\n  if (e == 0) {\n    return \"\";\n  }\n  return p.substring(lastSegmentStart(p, e), e);\n}\n\n// extension(p: string): string\n// The extension of the basename including the leading dot, or \"\" when there is none (Node's\n// `extname`): extension(\"a/b.txt\") == \".txt\"; extension(\"a.tar.gz\") == \".gz\";\n// extension(\".bashrc\") == \"\"; extension(\"a.\") == \".\"; extension(\"a\") == \"\"; extension(\"..\") == \"\".\nexport function extension(p: string): string {\n  const b = basename(p);\n  let i = b.length;\n  while (i > 0) {\n    if (b.charCodeAt(i - 1) == 46) {\n      // i-1 is the last dot; a dot at offset 0 (\".bashrc\") or the name \"..\" has no extension.\n      if (i == 1 || b == \"..\") {\n        return \"\";\n      }\n      return b.substring(i - 1, b.length);\n    }\n    i -= 1;\n  }\n  return \"\";\n}\n\n// stem(p: string): string\n// The basename without its extension: stem(\"a/b.txt\") == \"b\"; stem(\".bashrc\") == \".bashrc\";\n// stem(\"a.tar.gz\") == \"a.tar\".\nexport function stem(p: string): string {\n  const b = basename(p);\n  const x = extension(p);\n  return b.substring(0, b.length - x.length);\n}\n\n// withExtension(p: string, ext: string): string\n// Replaces the extension of the basename of `p` by `ext` (which must include the dot, or be \"\"\n// to remove it). Trailing separators are dropped: withExtension(\"a/b.txt\", \".md\") == \"a/b.md\".\n// For \"\" or \"/\" (no basename) the result is `p + ext`.\nexport function withExtension(p: string, ext: string): string {\n  const e = endWithoutSlashes(p);\n  if (e == 0) {\n    return p + ext;\n  }\n  const x = extension(p);\n  return p.substring(0, e - x.length) + ext;\n}\n" });
  out.push(SourceFile { path: "$stdlib/seq.or", text: "// std:seq -- pure aggregates over arrays, for contracts and code (ADR-0036, ADR-0031 C11-C13).\n//\n// `range(lo, hi)` is the index array `[lo, lo + 1, .., hi - 1]` (empty when `hi <= lo`), so that a bounded\n// quantifier over indices is written with the array API: `range(0, xs.length).every(i => xs[i] > 0)` is \"for all\n// `i` in `0 .. xs.length`\", and `range(1, xs.length).every(i => xs[i - 1] <= xs[i])` says `xs` is sorted.\n// `sum(xs)` and `sumBy(xs, f)` add up the elements (or `f` of them): `sumBy(this.items, it => it.price * it.qty)`.\n//\n// These are ordinary, pure functions: contracts may call them (ADR-0031 A4; `sumBy` is pure relative to its\n// function argument, like `every`), and the contract-checked build runs them as written. `orin verify\n// --contracts` does not run them: it reads `range(a, b).every(..)` / `.some(..)` as a bounded quantifier over\n// the indices and `sum` / `sumBy` as the recursive sum `sum(xs, n) = sum(xs, n - 1) + f(xs[n - 1])` (docs/contracts.md,\n// \"Quantifiers and sums\"). The loop bodies below are the reference semantics: the runtime meaning is the one of\n// the code, the solver's is the same by construction (and tests/contracts/ checks they agree on examples).\n//\n// Overflow: `+` on `int` traps on overflow, so a sum that does not fit traps in the contract-checked build; the\n// verifier reasons over unbounded integers and assumes the paths that return did not overflow (A-INT).\n\n// range(lo, hi): the indices `lo`, `lo + 1`, .., `hi - 1`; no element when `hi <= lo`.\n@Ensures(result.length == (hi > lo ? hi - lo : 0))\nexport function range(lo: usize, hi: usize): usize[] {\n  let out: usize[] = [];\n  let i = lo;\n  @Invariant(out.length == (i > lo ? i - lo : 0))\n  while (i < hi) {\n    out.push(i);\n    i += 1;\n  }\n  return out;\n}\n\n// sum(xs): the sum of the elements; 0 for the empty array.\n@Ensures(xs.length == 0 ==> result == 0)\nexport function sum(xs: int[]): int {\n  let s: int = 0;\n  let i: usize = 0;\n  @Invariant(i == 0 ==> s == 0)\n  while (i < xs.length) {\n    s += xs[i];\n    i += 1;\n  }\n  return s;\n}\n\n// sumBy(xs, f): the sum of `f(x)` over the elements; 0 for the empty array.\n@Ensures(xs.length == 0 ==> result == 0)\nexport function sumBy<T>(xs: T[], f: (x: T) => int): int {\n  let s: int = 0;\n  for (const x of xs) {\n    s += f(x);\n  }\n  return s;\n}\n" });
  out.push(SourceFile { path: "$stdlib/task.or", text: "// std:task -- structured concurrency with isolated tasks (ADR-0017 stage 0; docs/concurrency.md).\n//\n// UNSTABLE until the concurrency freeze. The whole library is Orin. Only the primitives under it are C: the L0 thread and\n// monitor operations (platform/orin_platform.h) and the transfer / task-start functions of the temporary runtime interface\n// `orin_rt_*` (runtime/orin_runtime.c, to move to Orin in R3). Nothing in this file is trusted beyond what the compiler\n// checks: the scheduler bookkeeping (the scope's task table), the channel buffers, the join results and the panic\n// propagation are ordinary Orin with invariants and contracts.\n//\n// MODEL. A task is an operating-system thread with its own heap. A value that crosses from one task to another (a\n// captured variable of a task body, a result, a message) is MOVED when it is uniquely owned (every reference in it has\n// count 1: no copy is made) and deep-copied otherwise; to the program both are a value copy. Reference counts stay\n// non-atomic: no object is ever reachable from two tasks, so there is no shared mutable memory and no data race. The only\n// state tasks share is a MONITOR: a lock-protected array of integers owned by the L0 layer. std:task keeps the task table of a\n// scope in one and the buffer of a channel in one; a buffer holds transfer tokens, never values.\n//\n//   scope(s => {\n//     const a = spawn(s, () => work(1));\n//     const b = spawn(s, () => work(2));\n//     return a.join() + b.join();\n//   })\n//\n// * `scope(body)` runs `body(s)` and, before it returns, joins every task spawned in it whether or not the body joined it:\n//   no task outlives its scope. If a task that nobody joined panicked, the scope panics (traps) after all tasks have ended.\n// * `spawn(s, f)` starts `f` as a task; `h.join()` waits for it and returns its result. A panic (trap) in a task ends only\n//   that task; `join` (or the end of the scope) turns it into a trap of the joining task with the message\n//   `task panicked: <message>`. A panic is never lost silently. Generic methods do not exist (E0460), so `spawn` is a\n//   function taking the scope, not a method of it.\n// * `channel<T>(capacity)` makes a bounded channel; `ch.tx.send(v)` blocks while it is full, `ch.rx.recv()` blocks while it\n//   is empty and returns `None` once the channel is closed and drained. `tx.close()` ends the stream, `rx.close()`\n//   cancels it (a blocked or later `send` returns false). Each end can be copied and used by any number of tasks. Close both\n//   ends to release the channel: after that any use of it traps.\n// * Resource handles are not values: a task body cannot capture one (E0483). A grant is delegated with `spawnFs`,\n//   `spawnProcess`, `spawnStdio` or `spawnClock`: the spawner derives a fresh grant with the same authority and MOVES it\n//   into the task (the task owns it and revokes it when it ends, also when it panics) and the body receives it as a\n//   parameter, like the body of a scope function of std:host.\n// * `parallelMap(xs, f, parts)` maps `f` over `xs` in `parts` tasks and returns the results in order.\n//\n// Stage 0 has no `async` / `await`, no cancellation other than `rx.close()`, no timeouts, no deadlock detection (all tasks\n// blocked is a hang) and no work stealing: a task is a thread, so thousands are fine, hundreds of thousands are not.\n// A panic in the BODY of a scope (not in a task) is not unwound: tasks still running keep running until the process ends.\n\nimport { Ring, Ledger, Ranges } from \"std:taskcore\";\nimport {\n  FsGrant, ProcessGrant, StdioGrant, ClockGrant, grantRevoke, grantClone, grantMove, grantAdoptFs, grantAdoptProcess,\n  grantAdoptStdio, grantAdoptClock, monNew, monFree, monLock, monUnlock, monWait, monNotifyAll, monGet, monSet, monGrow,\n  transitPut, transitTake, transitDrop, taskSpawn, taskJoin, taskMessage, taskTrap, transferCount, monNotifyOne\n} from \"std:fsraw\";\n\n// ------------------------------------------------------------------------------------------------------ transfer\n\n// The unit of transfer: a one-field record. Building it consumes the value (the runtime then moves a uniquely owned graph\n// and copies a shared one); a task body, a result and a message all travel in one.\ntype Box<T> = { v: T; };\n\ntype Thunk = () => void;\n\n// putBox<T>(v): the transfer token of `v`. A token is taken exactly once, by takeBox or dropped by transitDrop.\n// The runtime publishes the box itself (no second box) when it is the only reference and its value moves; that needs\n// the box released here, before the token is handed to another task: it dies at the end of this function, and every\n// token travels through a monitor or a thread start afterwards. Keep the box a temporary of this function.\nfunction putBox<T>(v: T): usize {\n  return transitPut(Box<T> { v: v });\n}\n\nfunction takeBox<T>(tok: usize): T {\n  const b: Box<T> = transitTake(tok);\n  return b.v;\n}\n\nexport { Ring, Ledger, Ranges } from \"std:taskcore\";\n\n// movedCount(): how many values this task has sent by MOVE (no copy) since it started, and copiedCount(): by deep copy.\n// Only values that contain a reference (strings, arrays, records, ...) are counted; scalars cost nothing either way.\nexport function movedCount(): usize {\n  return transferCount(0);\n}\n\nexport function copiedCount(): usize {\n  return transferCount(1);\n}\n\n// ------------------------------------------------------------------------------------------------------ channels\n\n// Monitor words of a channel: [0] capacity, [1] head, [2] len, [3] flags (1 = tx closed, 2 = rx closed), [4 + i] the\n// token in ring slot i.\nconst CH_HDR: usize = 4;\n\nfunction loadRing(m: usize): Ring {\n  const flags = monGet(m, 3);\n  return new Ring(monGet(m, 0), monGet(m, 1), monGet(m, 2), flags % 2 == 1, flags >= 2);\n}\n\n// A monitor has two condition queues: 0 = \"there is room\" (blocked senders), 1 = \"there is a value\" (blocked receivers). A\n// send wakes one receiver, a receive wakes one sender, a close wakes everybody.\nfunction wakeAll(m: usize): void {\n  monNotifyAll(m, 0);\n  monNotifyAll(m, 1);\n}\n\nfunction storeRing(m: usize, r: Ring): void {\n  monSet(m, 1, r.head);\n  monSet(m, 2, r.len);\n  let flags: usize = 0;\n  if (r.txClosed) {\n    flags += 1;\n  }\n  if (r.rxClosed) {\n    flags += 2;\n  }\n  monSet(m, 3, flags);\n}\n\n// The sending end of a channel. A copy refers to the same channel. A monitor handle is never 0: a forged `new Sender<T>(0)` is a\n// contract violation (and any other forged handle is refused by the platform layer at its first use).\n@Invariant(this.ch != 0)\nexport class Sender<T> {\n  ch: usize;\n\n  @Requires(ch != 0)\n  constructor(ch: usize) {\n    this.ch = ch;\n  }\n\n  // send(v): blocks while the channel is full; true when `v` was handed to the channel (moved if it is uniquely owned,\n  // copied otherwise); false when the channel is closed by either end, in which case `v` is dropped.\n  send(v: T): bool {\n    const tok = putBox(v);\n    monLock(this.ch);\n    let r = loadRing(this.ch);\n    while (!r.canPush() && !r.txClosed && !r.rxClosed) {\n      monWait(this.ch, 0);\n      r = loadRing(this.ch);\n    }\n    if (!r.canPush()) {\n      monUnlock(this.ch);\n      transitDrop(tok);\n      return false;\n    }\n    const slot = r.push();\n    monSet(this.ch, CH_HDR + slot, tok);\n    storeRing(this.ch, r);\n    monNotifyOne(this.ch, 1);\n    monUnlock(this.ch);\n    return true;\n  }\n\n  // close(): no more values will be sent; receivers drain what is buffered and then get None.\n  close(): void {\n    monLock(this.ch);\n    let r = loadRing(this.ch);\n    r.closeTx();\n    storeRing(this.ch, r);\n    wakeAll(this.ch);\n    const done = r.released();\n    monUnlock(this.ch);\n    if (done) {\n      monFree(this.ch);\n    }\n  }\n}\n\n// The receiving end of a channel. A copy refers to the same channel (several receivers share the stream).\n@Invariant(this.ch != 0)\nexport class Receiver<T> {\n  ch: usize;\n\n  @Requires(ch != 0)\n  constructor(ch: usize) {\n    this.ch = ch;\n  }\n\n  // recv(): blocks while the channel is empty; Some(v) with the oldest value, or None once the channel is closed and\n  // drained (or cancelled by rx.close()).\n  recv(): Option<T> {\n    monLock(this.ch);\n    let r = loadRing(this.ch);\n    while (!r.canPop() && !r.isDone()) {\n      monWait(this.ch, 1);\n      r = loadRing(this.ch);\n    }\n    if (!r.canPop()) {\n      monUnlock(this.ch);\n      return None;\n    }\n    const slot = r.pop();\n    const tok = monGet(this.ch, CH_HDR + slot);\n    storeRing(this.ch, r);\n    monNotifyOne(this.ch, 0);\n    monUnlock(this.ch);\n    const v: T = takeBox(tok);\n    return Some(v);\n  }\n\n  // close(): this end is done: buffered values are dropped, a blocked or later send returns false.\n  close(): void {\n    monLock(this.ch);\n    let r = loadRing(this.ch);\n    let toks: usize[] = [];\n    while (r.canPop()) {\n      const slot = r.pop();\n      toks.push(monGet(this.ch, CH_HDR + slot));\n    }\n    r.closeRx();\n    storeRing(this.ch, r);\n    wakeAll(this.ch);\n    const done = r.released();\n    monUnlock(this.ch);\n    for (const t of toks) {\n      transitDrop(t);\n    }\n    if (done) {\n      monFree(this.ch);\n    }\n  }\n}\n\n// The two ends of a channel.\nexport type Channel<T> = { tx: Sender<T>; rx: Receiver<T>; };\n\n// channel<T>(capacity): a bounded channel of at least one slot. A capacity of 0 (rendezvous) is not supported in stage 0:\n// E0482 for a constant, a trap otherwise (also without contract checking). Both ends refer to the same channel.\n@Requires(capacity >= 1)\n@Ensures(result.tx.ch == result.rx.ch)\nexport function channel<T>(capacity: usize): Channel<T> {\n  if (capacity == 0) {\n    taskTrap(\"channel capacity must be at least 1\");\n  }\n  const m = monNew(CH_HDR + capacity);\n  monLock(m);\n  monSet(m, 0, capacity);\n  monUnlock(m);\n  return Channel<T> { tx: new Sender<T>(m), rx: new Receiver<T>(m) };\n}\n\n// ------------------------------------------------------------------------------------------------------ scopes\n\nconst LG_HDR: usize = 4;\nconst LG_STRIDE: usize = 3;\nconst LG_FIRST: usize = 8;\n\nfunction loadLedger(m: usize): Ledger {\n  return new Ledger(monGet(m, 0), monGet(m, 1), monGet(m, 2) == 1);\n}\n\n// First word of the entry of task i.\nfunction entry(i: usize): usize {\n  return LG_HDR + LG_STRIDE * i;\n}\n\n// A scope: the handle of a task table. `scope` makes one and passes it to its body; it is valid only until `scope` returns.\n@Invariant(this.tab != 0)\nexport class Scope {\n  tab: usize;\n\n  @Requires(tab != 0)\n  constructor(tab: usize) {\n    this.tab = tab;\n  }\n}\n\n// A started task. `join` may be called once; a second call, or a call after the scope has ended, traps.\n@Invariant(this.tab != 0 && this.res != 0)\nexport class TaskHandle<T> {\n  tab: usize;\n  idx: usize;\n  res: usize;\n\n  @Requires(tab != 0 && res != 0)\n  constructor(tab: usize, idx: usize, res: usize) {\n    this.tab = tab;\n    this.idx = idx;\n    this.res = res;\n  }\n\n  // join(): waits for the task and returns its result. If the task panicked, traps with `task panicked: <message>`.\n  join(): T {\n    monLock(this.tab);\n    const st = monGet(this.tab, entry(this.idx) + 2);\n    if (st != 0) {\n      monUnlock(this.tab);\n      taskTrap(\"task joined twice (or after the end of its scope)\");\n    }\n    monSet(this.tab, entry(this.idx) + 2, 1);\n    const th = monGet(this.tab, entry(this.idx));\n    monUnlock(this.tab);\n    const status = taskJoin(th);\n    if (status != 0) {\n      monFree(this.res);\n      taskTrap(\"task panicked: \" + taskMessage());\n    }\n    monLock(this.res);\n    const tok = monGet(this.res, 0);\n    monUnlock(this.res);\n    monFree(this.res);\n    return takeBox(tok);\n  }\n}\n\n// tryJoin(h): `h.join()` that returns None instead of trapping when the task panicked (its message is then `taskMessage()`).\n// A second join still traps. (`join` keeps its own copy of these lines so that programs that do not use the fork/join pool\n// compile to the same code as before the pool was added.)\nfunction tryJoin<T>(h: TaskHandle<T>): Option<T> {\n  monLock(h.tab);\n  const st = monGet(h.tab, entry(h.idx) + 2);\n  if (st != 0) {\n    monUnlock(h.tab);\n    taskTrap(\"task joined twice (or after the end of its scope)\");\n  }\n  monSet(h.tab, entry(h.idx) + 2, 1);\n  const th = monGet(h.tab, entry(h.idx));\n  monUnlock(h.tab);\n  const status = taskJoin(th);\n  if (status != 0) {\n    monFree(h.res);\n    return None;\n  }\n  monLock(h.res);\n  const tok = monGet(h.res, 0);\n  monUnlock(h.res);\n  monFree(h.res);\n  const v: T = takeBox(tok);\n  return Some(v);\n}\n\n// What a task does, as the runtime runs it: compute, publish the result in the result monitor.\nfunction runTask<T>(f: () => T, res: usize): void {\n  const r = f();\n  const tok = putBox(r);\n  monLock(res);\n  monSet(res, 0, tok);\n  monUnlock(res);\n}\n\n// spawn<T>(s, f): starts `f` as a task of the scope and returns its handle. `f` and everything it captures move to the task\n// (unique values) or are copied to it; the task cannot affect the spawner's values. A body that captures a resource handle\n// is E0483, one that captures a `Scope` is E0481. Traps when the scope has ended or no thread can be started.\n@Ensures(result.tab == s.tab)\nexport function spawn<T>(s: Scope, f: () => T): TaskHandle<T> {\n  const res = monNew(1);\n  const body: Thunk = () => runTask(f, res);\n  const tok = putBox(body);\n  monLock(s.tab);\n  let lg = loadLedger(s.tab);\n  if (lg.closed) {\n    monUnlock(s.tab);\n    transitDrop(tok);\n    monFree(res);\n    taskTrap(\"spawn in a scope that has ended\");\n  }\n  const idx = lg.add();\n  const need = entry(idx) + LG_STRIDE;\n  const have = monGet(s.tab, 3);\n  if (need > have) {\n    monGrow(s.tab, have * 2);\n    monSet(s.tab, 3, have * 2);\n  }\n  monSet(s.tab, 0, lg.count);\n  monSet(s.tab, entry(idx), 0);\n  monSet(s.tab, entry(idx) + 1, res);\n  monSet(s.tab, entry(idx) + 2, 0);\n  monUnlock(s.tab);\n  const th = taskSpawn(tok);\n  monLock(s.tab);\n  monSet(s.tab, entry(idx), th);\n  monNotifyAll(s.tab, 0);\n  monUnlock(s.tab);\n  return new TaskHandle<T>(s.tab, idx, res);\n}\n\n// spawnDo(s, f): spawn for a body that returns nothing; join() then returns true.\nexport function spawnDo(s: Scope, f: () => void): TaskHandle<bool> {\n  return spawn(s, () => {\n    f();\n    return true;\n  });\n}\n\n// Joins every task of the table that nobody joined, closes the table and returns \"\" or the message of the first panic.\nfunction drain(tab: usize): string {\n  let failure = \"\";\n  let more = true;\n  while (more) {\n    monLock(tab);\n    let lg = loadLedger(tab);\n    if (lg.isScanned()) {\n      lg.close();\n      monSet(tab, 2, 1);\n      monUnlock(tab);\n      more = false;\n    } else {\n      const e = entry(lg.cursor);\n      const claimed = monGet(tab, e + 2) != 0;\n      const th = monGet(tab, e);\n      if (claimed) {\n        lg.advance();\n        monSet(tab, 1, lg.cursor);\n        monUnlock(tab);\n      } else if (th == 0) {\n        monWait(tab, 0);\n        monUnlock(tab);\n      } else {\n        const res = monGet(tab, e + 1);\n        monSet(tab, e + 2, 1);\n        lg.advance();\n        monSet(tab, 1, lg.cursor);\n        monUnlock(tab);\n        const status = taskJoin(th);\n        if (status != 0) {\n          if (failure == \"\") {\n            failure = taskMessage();\n          }\n        } else {\n          monLock(res);\n          const tok = monGet(res, 0);\n          monUnlock(res);\n          transitDrop(tok);\n        }\n        monFree(res);\n      }\n    }\n  }\n  return failure;\n}\n\n// begin(): a new, empty task table.\n@Ensures(result != 0)\nfunction begin(): usize {\n  const tab = monNew(LG_FIRST * LG_STRIDE);\n  monLock(tab);\n  monSet(tab, 3, LG_FIRST * LG_STRIDE);\n  monUnlock(tab);\n  return tab;\n}\n\n// finish(tab): joins every task of the table, frees it, and panics if a task nobody joined panicked.\nfunction finish(tab: usize): void {\n  const failure = drain(tab);\n  monFree(tab);\n  if (failure != \"\") {\n    taskTrap(\"task panicked: \" + failure);\n  }\n}\n\n// scope(body): runs `body` with a new scope and returns its result after every task spawned in the scope has ended. See the\n// header comment for panics.\nexport function scope<R>(body: (s: Scope) => R): R {\n  const tab = begin();\n  const r = body(new Scope(tab));\n  finish(tab);\n  return r;\n}\n\n// scopeFs(fs, body), scopeProcess, scopeStdio, scopeClock: `scope` for a body that also uses a grant. A closure cannot\n// capture a grant (E0452), so the grant is passed through: the body gets it back as a second parameter (the same shape as\n// `withFileFs` of std:fs). Use it with the matching spawnFs / spawnProcess / spawnStdio / spawnClock.\nexport function scopeFs<R>(fs: FsGrant, body: (s: Scope, g: FsGrant) => R): R {\n  const tab = begin();\n  const r = body(new Scope(tab), fs);\n  finish(tab);\n  return r;\n}\n\nexport function scopeProcess<R>(proc: ProcessGrant, body: (s: Scope, g: ProcessGrant) => R): R {\n  const tab = begin();\n  const r = body(new Scope(tab), proc);\n  finish(tab);\n  return r;\n}\n\nexport function scopeStdio<R>(stdio: StdioGrant, body: (s: Scope, g: StdioGrant) => R): R {\n  const tab = begin();\n  const r = body(new Scope(tab), stdio);\n  finish(tab);\n  return r;\n}\n\nexport function scopeClock<R>(clock: ClockGrant, body: (s: Scope, g: ClockGrant) => R): R {\n  const tab = begin();\n  const r = body(new Scope(tab), clock);\n  finish(tab);\n  return r;\n}\n\n// scopeDo(body), scopeFsDo, ...: the flavours for a body that returns nothing (a generic result cannot be void; std:fs and\n// std:host have the same pairs of `with*` / `use*`).\nexport function scopeDo(body: (s: Scope) => void): void {\n  const tab = begin();\n  body(new Scope(tab));\n  finish(tab);\n}\n\nexport function scopeFsDo(fs: FsGrant, body: (s: Scope, g: FsGrant) => void): void {\n  const tab = begin();\n  body(new Scope(tab), fs);\n  finish(tab);\n}\n\nexport function scopeProcessDo(proc: ProcessGrant, body: (s: Scope, g: ProcessGrant) => void): void {\n  const tab = begin();\n  body(new Scope(tab), proc);\n  finish(tab);\n}\n\nexport function scopeStdioDo(stdio: StdioGrant, body: (s: Scope, g: StdioGrant) => void): void {\n  const tab = begin();\n  body(new Scope(tab), stdio);\n  finish(tab);\n}\n\nexport function scopeClockDo(clock: ClockGrant, body: (s: Scope, g: ClockGrant) => void): void {\n  const tab = begin();\n  body(new Scope(tab), clock);\n  finish(tab);\n}\n\n// ------------------------------------------------------------------------------------------------------ delegating grants\n//\n// A grant is a resource handle (ADR-0025, ADR-0027): it is only ever a parameter, never a captured or sent value. To give\n// authority to a task, the spawner DERIVES a grant of the same family (never more authority than its own: same scope, same\n// flags), MOVES it into the task, and the task's wrapper adopts it, passes it to the body as a parameter and revokes it\n// when the body returns (the runtime also revokes it if the task panics). The compiler checks both halves: the derived handle\n// is moved exactly once on every path of the spawner (the MIR verifier's closer rule), and the adopted one is revoked\n// exactly once on every path of the task wrapper. The spawner's own grant is untouched.\n\nfunction runFs<T>(tok: usize, body: (g: FsGrant) => T): T {\n  const g = grantAdoptFs(tok);\n  const r = body(g);\n  grantRevoke(g);\n  return r;\n}\n\nfunction runProcess<T>(tok: usize, body: (g: ProcessGrant) => T): T {\n  const g = grantAdoptProcess(tok);\n  const r = body(g);\n  grantRevoke(g);\n  return r;\n}\n\nfunction runStdio<T>(tok: usize, body: (g: StdioGrant) => T): T {\n  const g = grantAdoptStdio(tok);\n  const r = body(g);\n  grantRevoke(g);\n  return r;\n}\n\nfunction runClock<T>(tok: usize, body: (g: ClockGrant) => T): T {\n  const g = grantAdoptClock(tok);\n  const r = body(g);\n  grantRevoke(g);\n  return r;\n}\n\n// spawnFs(s, fs, body): a task whose body gets a file-system grant of the authority of `fs`, owned by the task.\nexport function spawnFs<T>(s: Scope, fs: FsGrant, body: (g: FsGrant) => T): TaskHandle<T> {\n  const c = grantClone(fs);\n  const tok = grantMove(c);\n  return spawn(s, () => runFs(tok, body));\n}\n\nexport function spawnProcess<T>(s: Scope, proc: ProcessGrant, body: (g: ProcessGrant) => T): TaskHandle<T> {\n  const c = grantClone(proc);\n  const tok = grantMove(c);\n  return spawn(s, () => runProcess(tok, body));\n}\n\nexport function spawnStdio<T>(s: Scope, stdio: StdioGrant, body: (g: StdioGrant) => T): TaskHandle<T> {\n  const c = grantClone(stdio);\n  const tok = grantMove(c);\n  return spawn(s, () => runStdio(tok, body));\n}\n\nexport function spawnClock<T>(s: Scope, clock: ClockGrant, body: (g: ClockGrant) => T): TaskHandle<T> {\n  const c = grantClone(clock);\n  const tok = grantMove(c);\n  return spawn(s, () => runClock(tok, body));\n}\n\n// ------------------------------------------------------------------------------------------------------ parallelMap\n\n// parallelMap(xs, f, parts): `xs.map(f)` computed by `parts` tasks, each mapping one contiguous chunk; the result is in\n// order. `f` is copied to every task, each chunk moves or is copied to its task. parts = 0 or 1 maps in the calling task.\n@Ensures(result.length == xs.length)\nexport function parallelMap<A, B>(xs: A[], f: (x: A) => B, parts: usize): B[] {\n  if (parts <= 1 || xs.length <= 1) {\n    return xs.map(f);\n  }\n  const n = parts < xs.length ? parts : xs.length;\n  const size = (xs.length + n - 1) / n;\n  return scope(s => {\n    let hs: TaskHandle<B[]>[] = [];\n    let lo: usize = 0;\n    while (lo < xs.length) {\n      const hi = lo + size < xs.length ? lo + size : xs.length;\n      const chunk = xs.slice(lo, hi);\n      hs.push(spawn(s, () => chunk.map(f)));\n      lo = hi;\n    }\n    let out: B[] = [];\n    for (const h of hs) {\n      out = out.concat(h.join());\n    }\n    return out;\n  });\n}\n\n// ------------------------------------------------------------------------------------------------------ fork/join pool\n//\n// The pool behind `parallel()` on an array `xs` (ADR-0039, docs/std.md \"Parallel pipelines\"); usable directly too. A computation is split\n// into `chunks` numbered pieces; `body(k)` computes piece k. With `workers` >= 2 the pool starts that many worker tasks for\n// the call (a pool lives for one call: structured, like `scope`). Worker w starts with the contiguous range of pieces\n// w * chunks / workers .. (w + 1) * chunks / workers - 1 and takes them from the front; when its range is empty it STEALS the\n// back half of the largest range left (std:taskcore `Ranges`, kept in one monitor). Results are put back in piece order,\n// so the result never depends on the number of workers or on who computed what. With `workers` <= 1 the pieces run in\n// order on the calling task. A panic in a piece cancels the pieces nobody has started, waits for the workers that are\n// still running and then traps the caller with the piece's own message (so a parallel pipeline traps like the sequential\n// one). `body` is copied to every worker like any task body: what it captures moves or is copied (`parallel()` lends\n// its input array instead, see \"lending\" in runtime/orin_runtime.c).\n\n// A finished piece: its number and its result.\ntype Done<R> = { k: usize; r: R; };\n\n// Monitor words of a pool: [0] chunks, [1] cut, [2] workers, then lo / hi of every worker.\nconst POOL_HDR: usize = 3;\n\nfunction loadRanges(m: usize): Ranges {\n  const n = monGet(m, 2);\n  let lo: usize[] = [];\n  let hi: usize[] = [];\n  let w: usize = 0;\n  while (w < n) {\n    lo.push(monGet(m, POOL_HDR + 2 * w));\n    hi.push(monGet(m, POOL_HDR + 2 * w + 1));\n    w += 1;\n  }\n  return new Ranges(lo, hi, monGet(m, 1), monGet(m, 0));\n}\n\nfunction storeRanges(m: usize, r: Ranges): void {\n  monSet(m, 0, r.chunks);\n  monSet(m, 1, r.cut);\n  monSet(m, 2, r.lo.length);\n  let w: usize = 0;\n  while (w < r.lo.length) {\n    monSet(m, POOL_HDR + 2 * w, r.lo[w]);\n    monSet(m, POOL_HDR + 2 * w + 1, r.hi[w]);\n    w += 1;\n  }\n}\n\n// The loop of worker w: claim a piece, compute it, repeat; with `until`, a piece whose result is a hit cancels every piece\n// after it.\nfunction poolWork<R>(m: usize, w: usize, body: (k: usize) => R, until: bool, hit: (r: R) => bool): Done<R>[] {\n  let out: Done<R>[] = [];\n  let more = true;\n  while (more) {\n    monLock(m);\n    let rs = loadRanges(m);\n    const c = rs.claim(w);\n    storeRanges(m, rs);\n    monUnlock(m);\n    match (c) {\n      Some(k) => {\n        const r = body(k);\n        if (until && hit(r)) {\n          monLock(m);\n          let rs2 = loadRanges(m);\n          rs2.cancelAfter(k);\n          storeRanges(m, rs2);\n          monUnlock(m);\n        }\n        out.push(Done<R> { k: k, r: r });\n      },\n      None => {\n        more = false;\n      }\n    }\n  }\n  return out;\n}\n\n// Runs the pieces on `nw` >= 2 worker tasks; the finished pieces in no particular order.\nfunction runPool<R>(chunks: usize, nw: usize, body: (k: usize) => R, until: bool, hit: (r: R) => bool): Done<R>[] {\n  const m = monNew(POOL_HDR + 2 * nw);\n  let lo: usize[] = [];\n  let hi: usize[] = [];\n  let w: usize = 0;\n  while (w < nw) {\n    lo.push(chunks * w / nw);\n    hi.push(chunks * (w + 1) / nw);\n    w += 1;\n  }\n  monLock(m);\n  storeRanges(m, new Ranges(lo, hi, chunks, chunks));\n  monUnlock(m);\n  const tab = begin();\n  const s = new Scope(tab);\n  let hs: TaskHandle<Done<R>[]>[] = [];\n  w = 0;\n  while (w < nw) {\n    const me = w;\n    hs.push(spawn(s, () => poolWork(m, me, body, until, hit)));\n    w += 1;\n  }\n  let all: Done<R>[] = [];\n  let failure = \"\";\n  let failed = false;\n  for (const h of hs) {\n    match (tryJoin(h)) {\n      Some(ds) => {\n        for (const d of ds) {\n          all.push(d);\n        }\n      },\n      None => {\n        if (!failed) {\n          failed = true;\n          failure = taskMessage();\n          monLock(m);\n          let rs = loadRanges(m);\n          rs.cancelAll();\n          storeRanges(m, rs);\n          monUnlock(m);\n        }\n      }\n    }\n  }\n  finish(tab);\n  monFree(m);\n  if (failed) {\n    taskTrap(failure);\n  }\n  return all;\n}\n\n// The results of `chunks` pieces in piece order (every piece ran exactly once: the unwrap checks it).\nfunction inOrder<R>(chunks: usize, ds: Done<R>[]): Option<R>[] {\n  let slots: Option<R>[] = [];\n  while (slots.length < chunks) {\n    slots.push(None);\n  }\n  for (const d of ds) {\n    slots[d.k] = Some(d.r);\n  }\n  return slots;\n}\n\n// parallelism(): how many worker threads a parallel computation uses: the environment variable ORIN_THREADS when it is a\n// number from 1 to 1024, else the number of processors online. Results of `forkJoin` and `parallel()` never depend on it.\n@Ensures(result >= 1)\nexport function parallelism(): usize {\n  const t = transferCount(2);\n  return t >= 1 ? t : 1;\n}\n\n// forkJoin(chunks, workers, body): [body(0), body(1), ..., body(chunks - 1)], computed by `workers` worker tasks (work\n// stealing) when workers >= 2, else in order by the calling task.\n@Ensures(result.length == chunks)\nexport function forkJoin<R>(chunks: usize, workers: usize, body: (k: usize) => R): R[] {\n  if (workers <= 1 || chunks <= 1) {\n    let out: R[] = [];\n    while (out.length < chunks) {\n      out.push(body(out.length));\n    }\n    return out;\n  }\n  const nw = workers < chunks ? workers : chunks;\n  const slots = inOrder(chunks, runPool(chunks, nw, body, false, (r: R) => false));\n  return slots.map(o => o.unwrap());\n}\n\n// forkJoinUntil(chunks, workers, body, hit): [body(0), ..., body(j)] where j is the first piece whose result is a hit (all\n// pieces when none is). Pieces after a hit are cancelled; the pieces before the first hit always run, so the result is the\n// same as computing the pieces one by one and stopping at the first hit.\n@Ensures(result.length <= chunks)\nexport function forkJoinUntil<R>(chunks: usize, workers: usize, body: (k: usize) => R, hit: (r: R) => bool): R[] {\n  let out: R[] = [];\n  if (workers <= 1 || chunks <= 1) {\n    let k: usize = 0;\n    while (k < chunks) {\n      const r = body(k);\n      const h = hit(r);\n      out.push(r);\n      k = h ? chunks : k + 1;\n    }\n    return out;\n  }\n  const nw = workers < chunks ? workers : chunks;\n  const slots = inOrder(chunks, runPool(chunks, nw, body, true, hit));\n  let k: usize = 0;\n  while (k < chunks) {\n    const r = slots[k].unwrap();\n    const h = hit(r);\n    out.push(r);\n    k = h ? chunks : k + 1;\n  }\n  return out;\n}\n" });
  out.push(SourceFile { path: "$stdlib/taskcore.or", text: "// std:taskcore -- the pure bookkeeping of std:task (ADR-0017 stage 0): the state machine of one channel buffer (`Ring`) and of one\n// scope's task table (`Ledger`). No I/O, no threads, no primitives: `std:task` loads one of them from a monitor, changes it and stores\n// it back inside one critical section, so the invariants below hold whenever a lock is released, and they can be tested and mutated\n// (tools/mutate_std.py) without a single thread. Part of the std:task implementation; import `std:task` for the API.\n\n// The bookkeeping of one channel buffer, a bounded ring of `cap` slots. Pure: the channel functions load it from the\n// channel's monitor, change it and store it back inside one critical section, so the invariants hold whenever the\n// lock is released (they are checked after every method under --check-contracts, and `orin test` does).\n@Invariant(this.cap >= 1)\n@Invariant(this.head < this.cap)\n@Invariant(this.len <= this.cap)\nexport class Ring {\n  cap: usize;\n  head: usize;\n  len: usize;\n  txClosed: bool;\n  rxClosed: bool;\n\n  @Requires(cap >= 1 && head < cap && len <= cap)\n  constructor(cap: usize, head: usize, len: usize, txClosed: bool, rxClosed: bool) {\n    this.cap = cap;\n    this.head = head;\n    this.len = len;\n    this.txClosed = txClosed;\n    this.rxClosed = rxClosed;\n  }\n\n  // canPush(): a send would not block and would be accepted.\n  @Ensures(result == (!this.txClosed && !this.rxClosed && this.len < this.cap))\n  canPush(): bool {\n    return !this.txClosed && !this.rxClosed && this.len < this.cap;\n  }\n\n  // canPop(): there is a value to receive.\n  @Ensures(result == (this.len > 0))\n  canPop(): bool {\n    return this.len > 0;\n  }\n\n  // isDone(): no value will ever be received (cancelled by the receiver, or closed by the sender and drained).\n  @Ensures(result == (this.rxClosed || (this.txClosed && this.len == 0)))\n  isDone(): bool {\n    return this.rxClosed || (this.txClosed && this.len == 0);\n  }\n\n  // push(): the slot to write the next value into; the ring now holds one more value.\n  @Requires(this.len < this.cap)\n  @Ensures(result < this.cap)\n  @Ensures(this.len == old(this.len) + 1)\n  @Ensures(this.head == old(this.head))\n  push(): usize {\n    const slot = (this.head + this.len) % this.cap;\n    this.len += 1;\n    return slot;\n  }\n\n  // pop(): the slot to read the oldest value from; the ring now holds one value less.\n  @Requires(this.len > 0)\n  @Ensures(result < this.cap)\n  @Ensures(result == old(this.head))\n  @Ensures(this.len + 1 == old(this.len))\n  pop(): usize {\n    const slot = this.head;\n    this.head = (this.head + 1) % this.cap;\n    this.len -= 1;\n    return slot;\n  }\n\n  // closeTx(): no more sends (what is buffered can still be received).\n  @Ensures(this.txClosed && this.len == old(this.len))\n  closeTx(): void {\n    this.txClosed = true;\n  }\n\n  // closeRx(): no more receives; senders are refused from now on.\n  @Ensures(this.rxClosed && this.len == old(this.len))\n  closeRx(): void {\n    this.rxClosed = true;\n  }\n\n  // released(): both ends have closed, so the channel's monitor can be freed.\n  @Ensures(result == (this.txClosed && this.rxClosed))\n  released(): bool {\n    return this.txClosed && this.rxClosed;\n  }\n}\n\n// The task table of a scope, as the scope's monitor holds it: [0] number of tasks spawned, [1] scan cursor (every entry below\n// it has been claimed), [2] closed flag, [3] size of the monitor in words, then three words per task: its thread handle\n// (0 until spawn has started the thread), its result monitor, and a state word (0 = nobody has joined it yet, 1 = claimed\n// by a join or by the scope's exit).\n@Invariant(this.cursor <= this.count)\nexport class Ledger {\n  count: usize;\n  cursor: usize;\n  closed: bool;\n\n  @Requires(cursor <= count)\n  constructor(count: usize, cursor: usize, closed: bool) {\n    this.count = count;\n    this.cursor = cursor;\n    this.closed = closed;\n  }\n\n  // add(): the index of a new task.\n  @Requires(!this.closed)\n  @Ensures(result == old(this.count) && this.count == old(this.count) + 1)\n  add(): usize {\n    const i = this.count;\n    this.count += 1;\n    return i;\n  }\n\n  // advance(): the scan has passed one more entry.\n  @Requires(this.cursor < this.count)\n  @Ensures(this.cursor == old(this.cursor) + 1)\n  advance(): void {\n    this.cursor += 1;\n  }\n\n  // isScanned(): the scan has passed every task.\n  @Ensures(result == (this.cursor == this.count))\n  isScanned(): bool {\n    return this.cursor == this.count;\n  }\n\n  // close(): no task can be added any more; legal only when the scan has passed every task.\n  @Requires(this.cursor == this.count)\n  @Ensures(this.closed)\n  close(): void {\n    this.closed = true;\n  }\n}\n\n// The chunk ranges of a fork/join pool (std:task `forkJoin`, ADR-0039): worker w owns the chunks lo[w] .. hi[w] - 1 and takes\n// them from the front; a worker whose range is empty steals the back half of the largest range of another worker. Chunks at\n// or after `cut` are cancelled (`forkJoinUntil`: everything to the right of the leftmost hit found so far). Pure: the pool\n// keeps the words in its monitor and loads, changes and stores them inside one critical section.\n@Invariant(this.lo.length == this.hi.length && this.lo.length >= 1)\n@Invariant(this.cut <= this.chunks)\n@Invariant(rangesOk(this.lo, this.hi, this.chunks))\nexport class Ranges {\n  lo: usize[];\n  hi: usize[];\n  cut: usize;\n  chunks: usize;\n\n  @Requires(lo.length == hi.length && lo.length >= 1 && cut <= chunks && rangesOk(lo, hi, chunks))\n  constructor(lo: usize[], hi: usize[], cut: usize, chunks: usize) {\n    this.lo = lo;\n    this.hi = hi;\n    this.cut = cut;\n    this.chunks = chunks;\n  }\n\n  // claim(w): the next chunk for worker w: its own next one, else one stolen from the back of the largest other range\n  // (counting only chunks before the cut). None when no chunk before the cut is left to anybody.\n  @Requires(w < this.lo.length)\n  @Ensures(result.isSome() ==> result.unwrap() < this.cut && result.unwrap() < this.chunks)\n  @Ensures(result.isSome() ==> this.lo[w] == result.unwrap() + 1)\n  @Ensures(this.cut == old(this.cut))\n  claim(w: usize): Option<usize> {\n    if (this.lo[w] >= this.hi[w] || this.lo[w] >= this.cut) {\n      const n = this.lo.length;\n      let best = n;\n      let most: usize = 0;\n      let v: usize = 0;\n      while (v < n) {\n        const top = this.hi[v] < this.cut ? this.hi[v] : this.cut;\n        if (v != w && top > this.lo[v] && top - this.lo[v] > most) {\n          best = v;\n          most = top - this.lo[v];\n        }\n        v += 1;\n      }\n      if (best == n) {\n        return None;\n      }\n      // the victim keeps the front half, the thief takes the back half (all of it when one chunk is left)\n      const mid = this.lo[best] + most / 2;\n      this.lo[w] = mid;\n      this.hi[w] = this.hi[best];\n      this.hi[best] = mid;\n    }\n    const k = this.lo[w];\n    this.lo[w] = k + 1;\n    return Some(k);\n  }\n\n  // cancelAfter(k): chunk k produced a hit, so no chunk after it needs to run.\n  @Ensures(this.cut <= old(this.cut) && this.cut <= k + 1)\n  cancelAfter(k: usize): void {\n    if (k + 1 < this.cut) {\n      this.cut = k + 1;\n    }\n  }\n\n  // cancelAll(): a worker failed; nothing more needs to run.\n  @Ensures(this.cut == 0)\n  cancelAll(): void {\n    this.cut = 0;\n  }\n}\n\n// Every range is inside 0 .. chunks and no chunk belongs to two ranges (so no chunk can run twice).\nexport function rangesOk(lo: usize[], hi: usize[], chunks: usize): bool {\n  if (lo.length != hi.length) {\n    return false;\n  }\n  let i: usize = 0;\n  while (i < lo.length) {\n    if (lo[i] > hi[i] || hi[i] > chunks) {\n      return false;\n    }\n    let j: usize = i + 1;\n    while (j < lo.length) {\n      const overlap = lo[i] < hi[i] && lo[j] < hi[j] && lo[i] < hi[j] && lo[j] < hi[i];\n      if (overlap) {\n        return false;\n      }\n      j += 1;\n    }\n    i += 1;\n  }\n  return true;\n}\n" });
  out.push(SourceFile { path: "$stdlib/test.or", text: "// std:test -- assertions for `@Test` functions (ADR-0024, docs/testing.md).\n//\n// A failed assertion TRAPS: it writes `trap: <message>` to stderr and exits with status 101, exactly\n// like any other trap (array bounds, `unwrap` of `None`, a violated contract). `orin test` runs\n// every test in its own process, so one failing test never stops the others. The functions work in\n// ordinary programs too (they are not tied to `orin test`).\n//\n//   * Every function is total apart from the trap it exists for; none returns a value.\n//   * `msg` describes what was being checked (\"\" is allowed); it is part of the trap message.\n//   * Orin has no generic equality, so there is one function per type: `assertEq` (int),\n//     `assertEqUsize`, `assertEqString`, `assertEqBool`, `assertNear` (float with a tolerance).\n//   * Complexity: O(1) (string equality: O(n)); no allocation unless the assertion fails.\n\nimport { exit } from \"std:process\";\n\n// fail(msg: string): void\n// Traps with `msg` unconditionally (a test that reached a place it must not reach).\nexport function fail(msg: string): void {\n  console.error(\"trap: \" + msg);\n  exit(101);\n}\n\n// assert(cond: bool, msg: string): void\n// Traps with \"assertion failed: <msg>\" when `cond` is false.\nexport function assert(cond: bool, msg: string): void {\n  if (!cond) {\n    fail(\"assertion failed: \" + msg);\n  }\n}\n\nfunction label(msg: string): string {\n  return msg.length > 0 ? msg + \": \" : \"\";\n}\n\n// assertEq(actual: int, expected: int, msg: string): void\n// Traps with \"assertEq failed: <msg>: expected <expected>, got <actual>\" when the ints differ.\nexport function assertEq(actual: int, expected: int, msg: string): void {\n  if (actual != expected) {\n    fail(\"assertEq failed: \" + label(msg) + \"expected \" + expected.toString() + \", got \" + actual.toString());\n  }\n}\n\n// assertEqUsize(actual: usize, expected: usize, msg: string): void\n// Like `assertEq` for `usize` (lengths, indices).\nexport function assertEqUsize(actual: usize, expected: usize, msg: string): void {\n  if (actual != expected) {\n    fail(\"assertEq failed: \" + label(msg) + \"expected \" + expected.toString() + \", got \" + actual.toString());\n  }\n}\n\n// assertEqString(actual: string, expected: string, msg: string): void\n// Like `assertEq` for strings; the values are shown in double quotes.\nexport function assertEqString(actual: string, expected: string, msg: string): void {\n  if (actual != expected) {\n    fail(\"assertEq failed: \" + label(msg) + \"expected \\\"\" + expected + \"\\\", got \\\"\" + actual + \"\\\"\");\n  }\n}\n\n// assertEqBool(actual: bool, expected: bool, msg: string): void\n// Like `assertEq` for bools.\nexport function assertEqBool(actual: bool, expected: bool, msg: string): void {\n  if (actual != expected) {\n    fail(\"assertEq failed: \" + label(msg) + \"expected \" + expected.toString() + \", got \" + actual.toString());\n  }\n}\n\n// assertNear(actual: float, expected: float, tolerance: float, msg: string): void\n// Traps unless |actual - expected| <= tolerance (a NaN on either side always fails).\nexport function assertNear(actual: float, expected: float, tolerance: float, msg: string): void {\n  const d = actual > expected ? actual - expected : expected - actual;\n  if (!(d <= tolerance)) {\n    fail(\"assertNear failed: \" + label(msg) + \"expected \" + expected.toString() + \" +/- \" + tolerance.toString() + \", got \" + actual.toString());\n  }\n}\n" });
  out.push(SourceFile { path: "$stdlib/text.or", text: "// std:text -- pure text-layout utilities for compilers, diagnostics, documentation and CLIs.\n//\n// Orin strings are byte strings (see std:utf8). All indices below count bytes, never\n// Unicode code points. Whitespace in this module means ASCII SP, TAB or CR.\n// UTF-8 data is preserved byte-for-byte; Unicode segmentation belongs in std:utf8.\n// No platform calls, no additional trusted code, no runtime reflection.\n// Every function is total (never traps) and O(n) in the size of its input and output.\n\n// True when `line` consists only of ASCII SP, TAB and CR (the empty line included).\nexport function isBlankLine(line: string): bool {\n  let i: usize = 0;\n  while (i < line.length) {\n    const c = line.charCodeAt(i);\n    if (c != 32 && c != 9 && c != 13) {\n      return false;\n    }\n    i += 1;\n  }\n  return true;\n}\n\n// The leading run of ASCII SP / TAB of `line`, as a string (the indentation itself, not its width).\n@Ensures(result.length <= line.length && line.startsWith(result))\nexport function leadingIndent(line: string): string {\n  let i: usize = 0;\n  while (i < line.length) {\n    const c = line.charCodeAt(i);\n    if (c != 32 && c != 9) {\n      break;\n    }\n    i += 1;\n  }\n  return line.substring(0, i);\n}\n\n// The longest common prefix of `a` and `b`, byte by byte.\n@Ensures(a.startsWith(result) && b.startsWith(result))\nfunction commonPrefix(a: string, b: string): string {\n  let i: usize = 0;\n  while (i < a.length && i < b.length && a.charCodeAt(i) == b.charCodeAt(i)) {\n    i += 1;\n  }\n  return a.substring(0, i);\n}\n\n// trimBlankLines: removes outer whitespace-only lines, retaining internal blank lines.\n// An empty or whitespace-only input produces \"\". The line break after the last kept line is removed.\n@Ensures(result.length <= text.length)\n@Ensures(result.length == 0 || !isBlankLine(result.split(\"\\n\")[0]))\n@Ensures(result.length == 0 || !isBlankLine(result.split(\"\\n\")[result.split(\"\\n\").length - 1]))\nexport function trimBlankLines(text: string): string {\n  const lines = text.split(\"\\n\");\n  let first: usize = 0;\n  while (first < lines.length && isBlankLine(lines[first])) {\n    first += 1;\n  }\n  let last = lines.length;\n  while (last > first && isBlankLine(lines[last - 1])) {\n    last -= 1;\n  }\n  return lines.slice(first, last).join(\"\\n\");\n}\n\n// dedent: removes the longest common indentation *prefix* (the same sequence of SP / TAB bytes, as in\n// Python's textwrap.dedent) from every nonblank line. A tab and a space never match, so \"\\tfoo\\n  bar\"\n// has no common indentation and is returned unchanged. Blank lines become empty; the number of lines,\n// and therefore a trailing newline, is preserved.\n@Ensures(result.length <= text.length)\n@Ensures(result.split(\"\\n\").length == text.split(\"\\n\").length)\nexport function dedent(text: string): string {\n  const lines = text.split(\"\\n\");\n  let common = \"\";\n  let found = false;\n  for (const line of lines) {\n    if (!isBlankLine(line)) {\n      const ind = leadingIndent(line);\n      common = found ? commonPrefix(common, ind) : ind;\n      found = true;\n    }\n  }\n  if (!found) {\n    return text;\n  }\n  return lines.map(line => isBlankLine(line) ? \"\" : line.substring(common.length, line.length)).join(\"\\n\");\n}\n\n// indentLines: prefixes each non-empty line with `prefix`; empty lines (and so a trailing newline) stay\n// empty. The prefix may be any byte string. O(n + number_of_lines * prefix.length).\n@Ensures(result.length >= text.length)\n@Ensures(prefix.length == 0 ==> result == text)\n@Ensures(result.split(\"\\n\").length == text.split(\"\\n\").length)\nexport function indentLines(text: string, prefix: string): string {\n  if (text.length == 0 || prefix.length == 0) {\n    return text;\n  }\n  return text.split(\"\\n\").map(line => line.length == 0 ? \"\" : prefix + line).join(\"\\n\");\n}\n\n// normalizeNewlines: converts CRLF and a lone CR to LF without touching other bytes.\n// This is deliberately not a Unicode normalization operation.\n@Ensures(result.length <= text.length)\n@Ensures(result.indexOf(\"\\r\").isNone())\n@Ensures(text.indexOf(\"\\r\").isNone() ==> result == text)\nexport function normalizeNewlines(text: string): string {\n  let parts: string[] = [];\n  let start: usize = 0;\n  let i: usize = 0;\n  while (i < text.length) {\n    if (text.charCodeAt(i) == 13) {\n      parts.push(text.substring(start, i));\n      parts.push(\"\\n\");\n      if (i + 1 < text.length && text.charCodeAt(i + 1) == 10) {\n        i += 1;\n      }\n      i += 1;\n      start = i;\n    } else {\n      i += 1;\n    }\n  }\n  if (start == 0) {\n    return text;\n  }\n  parts.push(text.substring(start, text.length));\n  return parts.join(\"\");\n}\n" });
  out.push(SourceFile { path: "$stdlib/time.or", text: "// std:time -- wall clock, durations with explicit units and UTC calendar conversion (spec 08).\n//\n// The only runtime primitive is `nowMillis` (builtin `std:clock`, runtime function\n// orin_time_now_millis); everything else is pure Orin. All quantities are `int` milliseconds\n// unless the name says otherwise (\"explicit units\": there is no unit-less number in this API).\n//   * Calendar functions use the proleptic Gregorian calendar in UTC; there are no time zones,\n//     no leap seconds. Instants are milliseconds since 1970-01-01T00:00:00Z (negative before).\n//   * Arithmetic on ints traps on overflow like everywhere in Orin; values here stay far from\n//     the limits for any date in years -292000000 .. 292000000.\n//\n// TODO(after floats/map): fractional seconds (`seconds(1.5)`), `sleep` (needs a second runtime\n// primitive), time zones / locale formatting.\n\n// nowMillis(clock: ClockGrant): int\n// Wall-clock time in milliseconds since the Unix epoch (CLOCK_REALTIME). Not monotonic: the system\n// clock may jump. Needs the clock grant (ADR-0027: `useClock(host, clock => ...)` of std:host). Cannot fail. O(1), no allocation.\nexport { nowMillis, ClockGrant } from \"std:clock\";\n\n// A span of time in whole milliseconds (may be negative: a difference of two instants).\nexport type Duration = { millis: int; };\n\n// ---- durations ----------------------------------------------------------------------------\n\n// milliseconds / seconds / minutes / hours / days (n: int): Duration -- n units as a Duration. O(1).\nexport function milliseconds(n: int): Duration {\n  return Duration { millis: n };\n}\n\nexport function seconds(n: int): Duration {\n  return Duration { millis: n * 1000 };\n}\n\nexport function minutes(n: int): Duration {\n  return Duration { millis: n * 60000 };\n}\n\nexport function hours(n: int): Duration {\n  return Duration { millis: n * 3600000 };\n}\n\nexport function days(n: int): Duration {\n  return Duration { millis: n * 86400000 };\n}\n\n// toMillis(d: Duration): int -- the span in milliseconds. O(1).\nexport function toMillis(d: Duration): int {\n  return d.millis;\n}\n\n// toSeconds(d: Duration): int -- whole seconds, truncated toward zero (1999 ms -> 1). O(1).\nexport function toSeconds(d: Duration): int {\n  return d.millis / 1000;\n}\n\n// addDuration(a: Duration, b: Duration): Duration -- sum. O(1).\nexport function addDuration(a: Duration, b: Duration): Duration {\n  return Duration { millis: a.millis + b.millis };\n}\n\n// between(start: int, end: int): Duration -- end - start for two instants (milliseconds). O(1).\nexport function between(start: int, end: int): Duration {\n  return Duration { millis: end - start };\n}\n\n// plus(instant: int, d: Duration): int -- the instant `d` after `instant`. O(1).\nexport function plus(instant: int, d: Duration): int {\n  return instant + d.millis;\n}\n\n// formatDuration(d: Duration): string\n// Human-readable \"1d 2h 3m 4s 5ms\" with zero components omitted, \"0ms\" for zero and a leading\n// \"-\" for negative spans: formatDuration(milliseconds(3723005)) == \"1h 2m 3s 5ms\". O(1).\nexport function formatDuration(d: Duration): string {\n  if (d.millis == 0) {\n    return \"0ms\";\n  }\n  const neg = d.millis < 0;\n  let rest = neg ? 0 - d.millis : d.millis;\n  let parts: string[] = [];\n  const dd = rest / 86400000;\n  rest = rest % 86400000;\n  const hh = rest / 3600000;\n  rest = rest % 3600000;\n  const mm = rest / 60000;\n  rest = rest % 60000;\n  const ss = rest / 1000;\n  const ms = rest % 1000;\n  if (dd > 0) {\n    parts.push(dd.toString() + \"d\");\n  }\n  if (hh > 0) {\n    parts.push(hh.toString() + \"h\");\n  }\n  if (mm > 0) {\n    parts.push(mm.toString() + \"m\");\n  }\n  if (ss > 0) {\n    parts.push(ss.toString() + \"s\");\n  }\n  if (ms > 0) {\n    parts.push(ms.toString() + \"ms\");\n  }\n  const body = parts.join(\" \");\n  return neg ? \"-\" + body : body;\n}\n\n// ---- calendar (UTC) -----------------------------------------------------------------------\n\n// Broken-down UTC time. month 1..12, day 1..31, hour 0..23, minute 0..59, second 0..59,\n// millisecond 0..999, weekday 0 = Sunday .. 6 = Saturday.\nexport type DateTime = {\n  year: int; month: int; day: int;\n  hour: int; minute: int; second: int; millisecond: int;\n  weekday: int;\n};\n\nfunction floorDiv(a: int, b: int): int {\n  const q = a / b;\n  if (a % b != 0 && (a < 0) != (b < 0)) {\n    return q - 1;\n  }\n  return q;\n}\n\n// Days since 1970-01-01 of the civil date y-m-d (Howard Hinnant's days_from_civil).\nfunction daysFromCivil(y0: int, m: int, d: int): int {\n  const y = m <= 2 ? y0 - 1 : y0;\n  const era = floorDiv(y, 400);\n  const yoe = y - era * 400;\n  const mp = m > 2 ? m - 3 : m + 9;\n  const doy = (153 * mp + 2) / 5 + d - 1;\n  const doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;\n  return era * 146097 + doe - 719468;\n}\n\n// fromMillis(instant: int): DateTime -- UTC calendar fields of an instant. Total, O(1).\nexport function fromMillis(instant: int): DateTime {\n  const dayNum = floorDiv(instant, 86400000);\n  const msOfDay = instant - dayNum * 86400000;\n  const z = dayNum + 719468;\n  const era = floorDiv(z, 146097);\n  const doe = z - era * 146097;\n  const yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;\n  const doy = doe - (365 * yoe + yoe / 4 - yoe / 100);\n  const mp = (5 * doy + 2) / 153;\n  const d = doy - (153 * mp + 2) / 5 + 1;\n  const m = mp < 10 ? mp + 3 : mp - 9;\n  const y = yoe + era * 400 + (m <= 2 ? 1 : 0);\n  let wd = (dayNum + 4) % 7;\n  if (wd < 0) {\n    wd += 7;\n  }\n  return DateTime {\n    year: y, month: m, day: d,\n    hour: msOfDay / 3600000, minute: (msOfDay / 60000) % 60,\n    second: (msOfDay / 1000) % 60, millisecond: msOfDay % 1000,\n    weekday: wd\n  };\n}\n\n// isLeapYear(year: int): bool -- Gregorian rule. O(1).\nexport function isLeapYear(year: int): bool {\n  return (year % 4 == 0 && year % 100 != 0) || year % 400 == 0;\n}\n\n// daysInMonth(year: int, month: int): Option<int> -- None unless month is 1..12. O(1).\nexport function daysInMonth(year: int, month: int): Option<int> {\n  if (month < 1 || month > 12) {\n    return None;\n  }\n  if (month == 2) {\n    return Some(isLeapYear(year) ? 29 : 28);\n  }\n  if (month == 4 || month == 6 || month == 9 || month == 11) {\n    return Some(30);\n  }\n  return Some(31);\n}\n\n// toInstant(dt: DateTime): Option<int>\n// The instant of a UTC date-time, or None when a field is out of range (month 1..12, day within\n// the month, hour 0..23, minute/second 0..59, millisecond 0..999). `weekday` is ignored. O(1).\nexport function toInstant(dt: DateTime): Option<int> {\n  const dim = daysInMonth(dt.year, dt.month);\n  if (dim.isNone()) {\n    return None;\n  }\n  if (dt.day < 1 || dt.day > dim.unwrap()) {\n    return None;\n  }\n  if (dt.hour < 0 || dt.hour > 23 || dt.minute < 0 || dt.minute > 59\n      || dt.second < 0 || dt.second > 59 || dt.millisecond < 0 || dt.millisecond > 999) {\n    return None;\n  }\n  const dayNum = daysFromCivil(dt.year, dt.month, dt.day);\n  return Some(dayNum * 86400000 + dt.hour * 3600000 + dt.minute * 60000 + dt.second * 1000 + dt.millisecond);\n}\n\nfunction pad(n: int, width: usize): string {\n  let s = n.toString();\n  while (s.length < width) {\n    s = \"0\" + s;\n  }\n  return s;\n}\n\n// formatIso(instant: int): string\n// ISO 8601 / RFC 3339 UTC: \"2024-02-29T13:04:05.006Z\" (year padded to at least 4 digits; years\n// before 0 or after 9999 are printed with their sign / extra digits). O(1).\nexport function formatIso(instant: int): string {\n  const t = fromMillis(instant);\n  const ys = t.year < 0 ? \"-\" + pad(0 - t.year, 4) : pad(t.year, 4);\n  return ys + \"-\" + pad(t.month, 2) + \"-\" + pad(t.day, 2) + \"T\" + pad(t.hour, 2) + \":\"\n    + pad(t.minute, 2) + \":\" + pad(t.second, 2) + \".\" + pad(t.millisecond, 3) + \"Z\";\n}\n" });
  out.push(SourceFile { path: "$stdlib/utf8.or", text: "// std:utf8 -- validated UTF-8 decoding and encoding, code point iteration and `Utf8String`, a string with the\n// invariant \"always valid UTF-8\" (ADR-0030 \xc2\xa73, layer \"bytes and text\"). Pure safe Orin.\n//\n// Background. Orin strings are byte strings (`length`, `charCodeAt` and `substring` count bytes) that are\n// *expected* to hold UTF-8 but nothing in the language enforces it. This module turns the expectation into a\n// type: a `Utf8String` can only be built from bytes that passed `validate`, so every function that takes one\n// may rely on well-formedness (RFC 3629 / Unicode Table 3-7):\n//\n//   U+0000..U+007F    00..7F\n//   U+0080..U+07FF    C2..DF 80..BF\n//   U+0800..U+0FFF    E0 A0..BF 80..BF         (E0 80..9F is an overlong form)\n//   U+1000..U+CFFF    E1..EC 80..BF 80..BF\n//   U+D000..U+D7FF    ED 80..9F 80..BF         (ED A0..BF is a surrogate, U+D800..U+DFFF)\n//   U+E000..U+FFFF    EE..EF 80..BF 80..BF\n//   U+10000..U+3FFFF  F0 90..BF 80..BF 80..BF  (F0 80..8F is an overlong form)\n//   U+40000..U+FFFFF  F1..F3 80..BF 80..BF 80..BF\n//   U+100000..U+10FFFF F4 80..8F 80..BF 80..BF (F4 90..BF is above U+10FFFF)\n//\n// Rejected, with the error kind: a continuation byte (80..BF) as first byte, or F8..FF (`InvalidLead`); C0, C1\n// and the overlong forms above (`Overlong`); surrogates (`Surrogate`); F5..F7 and F4 90..BF (`TooLarge`);\n// a sequence cut off by the end of input (`TruncatedSequence`); a missing continuation byte\n// (`InvalidContinuation`). Noncharacters (U+FFFE, U+FFFF, U+FDD0..) are valid scalar values and accepted.\n//\n// Error position. `Utf8Error.position` is the byte offset where the first invalid sequence starts, i.e. the\n// length of the longest valid prefix, and `length` the number of bytes of the maximal invalid prefix at that\n// point (1..3; for a truncated sequence the bytes left). Everything before `position` is valid UTF-8.\n//\n// Contract standard (ADR-0030 \xc2\xa73): `Utf8String` and `CodePointCursor` carry invariants checked after every\n// public method (`orin test`, `--check-contracts`); the constructor of `Utf8String` *always* validates, so the\n// invariant also holds in builds without contract checking. Helpers used in contracts are loops, not closures.\n//\n// Complexity: n = byte length. `validate*`, `isValidUtf8` (one table-driven pass, no allocation), `codePointCount`, `codePoints`, `concat`, `trySlice`,\n// `fromCodePoints` O(n); `encodeCodePoint`, `codePointAt`, `isCharBoundary`, `byteLength` O(1);\n// `CodePointCursor.next` O(1); constructing a `Utf8String` validates, O(n).\n\nimport { Bytes, ByteBuilder, bytesFromString } from \"std:bytes\";\n\n// ---------------------------------------------------------------------------------------------- errors\n\nexport type Utf8ErrorKind = InvalidLead | TruncatedSequence | InvalidContinuation | Overlong | Surrogate | TooLarge;\n\n// position: byte offset of the first invalid sequence (the length of the longest valid prefix).\n// length: bytes of the maximal invalid prefix there (1..3). kind: why it is invalid.\nexport type Utf8Error = { position: usize; length: usize; kind: Utf8ErrorKind; };\n\n// utf8ErrorMessage(e): \"invalid UTF-8 at byte 3: overlong encoding\". O(1).\n@Ensures(result.length > 0)\nexport function utf8ErrorMessage(e: Utf8Error): string {\n  const why = match (e.kind) {\n    InvalidLead => \"invalid leading byte\",\n    TruncatedSequence => \"truncated sequence\",\n    InvalidContinuation => \"invalid continuation byte\",\n    Overlong => \"overlong encoding\",\n    Surrogate => \"encoded surrogate\",\n    TooLarge => \"code point above U+10FFFF\"\n  };\n  return `invalid UTF-8 at byte ${e.position.toString()}: ${why}`;\n}\n\n// ------------------------------------------------------------------------------------ scalar values\n\n// isScalarValue(cp): cp is a Unicode scalar value: 0..0xD7FF or 0xE000..0x10FFFF. O(1).\n@Ensures(result ==> cp >= 0 && cp <= 1114111)\n@Ensures(cp >= 55296 && cp <= 57343 ==> !result)\nexport function isScalarValue(cp: int): bool {\n  return (cp >= 0 && cp < 55296) || (cp >= 57344 && cp <= 1114111);\n}\n\n// utf8Len(cp): number of UTF-8 bytes of a scalar value (1..4). O(1).\n@Requires(isScalarValue(cp))\n@Ensures(result >= 1 && result <= 4)\n@Ensures((result == 1) == (cp < 128))\n@Ensures((result == 4) == (cp >= 65536))\nexport function utf8Len(cp: int): int {\n  if (cp < 128) {\n    return 1;\n  }\n  if (cp < 2048) {\n    return 2;\n  }\n  if (cp < 65536) {\n    return 3;\n  }\n  return 4;\n}\n\n// encodeCodePoint(cp): the UTF-8 bytes of a scalar value as a string; None for surrogates, values above U+10FFFF\n// and negative values. O(1).\n@Ensures(result.isSome() == isScalarValue(cp))\n@Ensures(result.isSome() ==> result.unwrap().length.toInt() == utf8Len(cp))\n@Ensures(result.isSome() ==> isValidUtf8(result.unwrap()) && decodeAt(result.unwrap(), 0) == cp)\nexport function encodeCodePoint(cp: int): Option<string> {\n  if (!isScalarValue(cp)) {\n    return None;\n  }\n  if (cp < 128) {\n    return Some(String.fromCharCode(cp));\n  }\n  if (cp < 2048) {\n    return Some(String.fromCharCode(192 + cp / 64) + String.fromCharCode(128 + cp % 64));\n  }\n  if (cp < 65536) {\n    return Some(String.fromCharCode(224 + cp / 4096) + String.fromCharCode(128 + (cp / 64) % 64)\n      + String.fromCharCode(128 + cp % 64));\n  }\n  return Some(String.fromCharCode(240 + cp / 262144) + String.fromCharCode(128 + (cp / 4096) % 64)\n    + String.fromCharCode(128 + (cp / 64) % 64) + String.fromCharCode(128 + cp % 64));\n}\n\n// ------------------------------------------------------------------------------------------ scanning\n\nfunction isCont(c: int): bool {\n  return c >= 128 && c <= 191;\n}\n\n// Result of looking at one sequence: `kind` is None for a valid sequence of `len` bytes, else the error.\ntype Seq = { len: usize; kind: Option<Utf8ErrorKind>; };\n\nfunction okSeq(len: usize): Seq {\n  return Seq { len: len, kind: None };\n}\n\nfunction badSeq(len: usize, k: Utf8ErrorKind): Seq {\n  return Seq { len: len, kind: Some(k) };\n}\n\n// Looks at the sequence starting at byte i of s (i < s.length).\n@Requires(i < s.length)\n@Ensures(result.len >= 1 && result.len <= 4 && i + result.len <= s.length)\nfunction scanSeq(s: string, i: usize): Seq {\n  const n = s.length;\n  const c = s.charCodeAt(i);\n  if (c < 128) {\n    return okSeq(1);\n  }\n  if (c < 192) {\n    return badSeq(1, InvalidLead);\n  }\n  if (c < 194) {\n    return badSeq(1, Overlong);\n  }\n  if (c >= 245) {\n    if (c < 248) {\n      return badSeq(1, TooLarge);\n    }\n    return badSeq(1, InvalidLead);\n  }\n  let need: usize = 1;\n  let lo2 = 128;\n  let hi2 = 191;\n  if (c >= 240) {\n    need = 3;\n    if (c == 240) {\n      lo2 = 144;\n    }\n    if (c == 244) {\n      hi2 = 143;\n    }\n  } else if (c >= 224) {\n    need = 2;\n    if (c == 224) {\n      lo2 = 160;\n    }\n    if (c == 237) {\n      hi2 = 159;\n    }\n  }\n  if (i + 1 >= n) {\n    return badSeq(1, TruncatedSequence);\n  }\n  const b2 = s.charCodeAt(i + 1);\n  if (!isCont(b2)) {\n    return badSeq(1, InvalidContinuation);\n  }\n  if (b2 < lo2 || b2 > hi2) {\n    if (c == 237) {\n      return badSeq(1, Surrogate);\n    }\n    if (c == 244) {\n      return badSeq(1, TooLarge);\n    }\n    return badSeq(1, Overlong);\n  }\n  let k: usize = 2;\n  while (k <= need) {\n    if (i + k >= n) {\n      return badSeq(k, TruncatedSequence);\n    }\n    if (!isCont(s.charCodeAt(i + k))) {\n      return badSeq(k, InvalidContinuation);\n    }\n    k += 1;\n  }\n  return okSeq(need + 1);\n}\n\n// The validator is table-driven (Bjoern Hoehrmann's UTF-8 DFA, 12 byte classes x 9 states, accepting state 0,\n// rejecting state 12; the tables are string constants because Orin has no constant arrays). Runs of ASCII bytes\n// are skipped without table lookups. `scanSeq` (above) is only used on the error path, to classify the first bad\n// sequence; the tests check the DFA against it on every 1- and 2-byte input and on boundary-heavy 3- and 4-byte\n// inputs. Class table: 256 entries indexed by the byte; transition table: next = NEXT[state + class].\nconst UTF8_CLASS: string = \"\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x01\\x01\\x01\\x01\\x01\\x01\\x01\\x01\\x01\\x01\\x01\\x01\\x01\\x01\\x01\\x01\\x09\\x09\\x09\\x09\\x09\\x09\\x09\\x09\\x09\\x09\\x09\\x09\\x09\\x09\\x09\\x09\\x07\\x07\\x07\\x07\\x07\\x07\\x07\\x07\\x07\\x07\\x07\\x07\\x07\\x07\\x07\\x07\\x07\\x07\\x07\\x07\\x07\\x07\\x07\\x07\\x07\\x07\\x07\\x07\\x07\\x07\\x07\\x07\\x08\\x08\\x02\\x02\\x02\\x02\\x02\\x02\\x02\\x02\\x02\\x02\\x02\\x02\\x02\\x02\\x02\\x02\\x02\\x02\\x02\\x02\\x02\\x02\\x02\\x02\\x02\\x02\\x02\\x02\\x02\\x02\\x0a\\x03\\x03\\x03\\x03\\x03\\x03\\x03\\x03\\x03\\x03\\x03\\x03\\x04\\x03\\x03\\x0b\\x06\\x06\\x06\\x05\\x08\\x08\\x08\\x08\\x08\\x08\\x08\\x08\\x08\\x08\\x08\";\nconst UTF8_NEXT: string = \"\\x00\\x0c\\x18\\x24\\x3c\\x60\\x54\\x0c\\x0c\\x0c\\x30\\x48\\x0c\\x0c\\x0c\\x0c\\x0c\\x0c\\x0c\\x0c\\x0c\\x0c\\x0c\\x0c\\x0c\\x00\\x0c\\x0c\\x0c\\x0c\\x0c\\x00\\x0c\\x00\\x0c\\x0c\\x0c\\x18\\x0c\\x0c\\x0c\\x0c\\x0c\\x18\\x0c\\x18\\x0c\\x0c\\x0c\\x0c\\x0c\\x0c\\x0c\\x0c\\x0c\\x18\\x0c\\x0c\\x0c\\x0c\\x0c\\x18\\x0c\\x0c\\x0c\\x0c\\x0c\\x0c\\x0c\\x18\\x0c\\x0c\\x0c\\x0c\\x0c\\x0c\\x0c\\x0c\\x0c\\x24\\x0c\\x24\\x0c\\x0c\\x0c\\x24\\x0c\\x0c\\x0c\\x0c\\x0c\\x24\\x0c\\x24\\x0c\\x0c\\x0c\\x24\\x0c\\x0c\\x0c\\x0c\\x0c\\x0c\\x0c\\x0c\\x0c\\x0c\";\n\n// validPrefix(s): the length of the longest prefix of s that is valid UTF-8 and ends on a sequence boundary:\n// s.length when s is valid, else the offset of the first invalid (or cut-off) sequence. One pass, O(n), no\n// allocation. The spec decoder `scanSeq` agrees at the returned offset (checked by the contract).\n@Ensures(result <= s.length)\n@Ensures(result < s.length ==> scanSeq(s, result).kind.isSome())\nfunction validPrefix(s: string): usize {\n  const n = s.length;\n  let i: usize = 0;\n  while (i < n) {\n    if (s.charCodeAt(i) < 128) {\n      i += 1;\n      while (i < n && s.charCodeAt(i) < 128) {\n        i += 1;\n      }\n    } else {\n      const start = i;\n      let st = 0;\n      while (i < n) {\n        st = UTF8_NEXT.charCodeAt((st + UTF8_CLASS.charCodeAt(s.charCodeAt(i).toUsize())).toUsize());\n        i += 1;\n        if (st <= 12) {\n          break;\n        }\n      }\n      if (st != 0) {\n        return start;\n      }\n    }\n  }\n  return n;\n}\n\n// checkUtf8(s): Ok when the bytes of `s` are well-formed UTF-8, else the first error. O(n).\n@Ensures(result.isErr() ==> result.unwrapErr().position < s.length)\n@Ensures(result.isErr() ==> result.unwrapErr().position + result.unwrapErr().length <= s.length)\n@Ensures(s.length == 0 ==> result.isOk())\nexport function checkUtf8(s: string): Result<void, Utf8Error> {\n  const p = validPrefix(s);\n  if (p == s.length) {\n    return Ok();\n  }\n  const q = scanSeq(s, p);\n  return Err(Utf8Error { position: p, length: q.len, kind: q.kind.unwrap() });\n}\n\n// isValidUtf8(s): are the bytes of `s` well-formed UTF-8? Usable in contracts. O(n).\n@Ensures(s.length == 0 ==> result)\nexport function isValidUtf8(s: string): bool {\n  return validPrefix(s) == s.length;\n}\n\n// Number of code points of a string that is valid UTF-8 (not re-checked: that would make callers quadratic): the bytes that are not continuation bytes. O(n).\n@Ensures(result <= s.length)\n@Ensures((result == 0) == (s.length == 0))\nfunction countCodePoints(s: string): usize {\n  let n: usize = 0;\n  let i: usize = 0;\n  while (i < s.length) {\n    if (!isCont(s.charCodeAt(i))) {\n      n += 1;\n    }\n    i += 1;\n  }\n  return n;\n}\n\n// The code point of the sequence starting at byte i of s, which must be valid UTF-8 (not re-checked, see above).\n@Requires(i < s.length && !isCont(s.charCodeAt(i)))\n@Ensures(isScalarValue(result))\nfunction decodeAt(s: string, i: usize): int {\n  const c = s.charCodeAt(i);\n  if (c < 128) {\n    return c;\n  }\n  if (c < 224) {\n    return (c - 192) * 64 + (s.charCodeAt(i + 1) - 128);\n  }\n  if (c < 240) {\n    return (c - 224) * 4096 + (s.charCodeAt(i + 1) - 128) * 64 + (s.charCodeAt(i + 2) - 128);\n  }\n  return (c - 240) * 262144 + (s.charCodeAt(i + 1) - 128) * 4096 + (s.charCodeAt(i + 2) - 128) * 64\n    + (s.charCodeAt(i + 3) - 128);\n}\n\n// ------------------------------------------------------------------------------------------ Utf8String\n\n// A string that is valid UTF-8 by construction. Value semantics like every class: a copy is independent and\n// there is no mutating method, so the invariant cannot be broken after construction.\n@Invariant(isValidUtf8(this.text))\nexport class Utf8String {\n  private text: string;\n\n  // new Utf8String(text): wraps a string that is already valid UTF-8. Traps (unwrap of an Err) on invalid\n  // input, in every build: use `validateString` / `validate` to get a Result. O(n).\n  @Requires(isValidUtf8(text))\n  constructor(text: string) {\n    this.text = checked(text);\n  }\n\n  // asString(): the text (valid UTF-8). O(1).\n  @Ensures(isValidUtf8(result))\n  asString(): string {\n    return this.text;\n  }\n\n  // byteLength(): number of bytes. O(1).\n  @Ensures(result == this.text.length)\n  byteLength(): usize {\n    return this.text.length;\n  }\n\n  // isEmpty(): no bytes (and no code points). O(1).\n  @Ensures(result == (this.byteLength() == 0))\n  isEmpty(): bool {\n    return this.text.length == 0;\n  }\n\n  // toBytes(): the UTF-8 encoding as `Bytes`. O(n).\n  @Ensures(result.length() == this.text.length)\n  toBytes(): Bytes {\n    return bytesFromString(this.text);\n  }\n\n  // codePointCount(): number of code points. Between byteLength()/4 and byteLength(). O(n).\n  @Ensures(result <= this.text.length)\n  @Ensures(result * 4 >= this.text.length)\n  codePointCount(): usize {\n    return countCodePoints(this.text);\n  }\n\n  // isCharBoundary(i): i is 0, byteLength(), or the index of the first byte of a code point. O(1).\n  @Ensures(i > this.text.length ==> !result)\n  @Ensures(i == 0 || i == this.text.length ==> result)\n  isCharBoundary(i: usize): bool {\n    if (i > this.text.length) {\n      return false;\n    }\n    if (i == this.text.length) {\n      return true;\n    }\n    return !isCont(this.text.charCodeAt(i));\n  }\n\n  // codePointAt(i): the code point starting at byte i; None unless i is a boundary before the end. O(1).\n  @Ensures(result.isSome() == (i < this.text.length && this.isCharBoundary(i)))\n  @Ensures(result.isSome() ==> isScalarValue(result.unwrap()))\n  codePointAt(i: usize): Option<int> {\n    if (i >= this.text.length || isCont(this.text.charCodeAt(i))) {\n      return None;\n    }\n    return Some(decodeAt(this.text, i));\n  }\n\n  // codePoints(): all code points in order. O(n).\n  @Ensures(result.length == this.codePointCount())\n  codePoints(): int[] {\n    let out: int[] = [];\n    let i: usize = 0;\n    while (i < this.text.length) {\n      const c = decodeAt(this.text, i);\n      out.push(c);\n      i += utf8Len(c).toUsize();\n    }\n    return out;\n  }\n\n  // concat(other): this followed by other; concatenation of valid UTF-8 is valid. O(n + m).\n  @Ensures(result.byteLength() == this.text.length + other.byteLength())\n  @Ensures(result.codePointCount() == this.codePointCount() + other.codePointCount())\n  concat(other: Utf8String): Utf8String {\n    return new Utf8String(this.text + other.asString());\n  }\n\n  // trySlice(lo, hi): the bytes [lo, hi) as a Utf8String; None unless lo <= hi <= byteLength() and both ends\n  // are code point boundaries (so the result is valid by construction). O(hi - lo).\n  @Ensures(result.isSome() == (lo <= hi && this.isCharBoundary(lo) && this.isCharBoundary(hi)))\n  @Ensures(result.isSome() ==> result.unwrap().byteLength() == hi - lo)\n  trySlice(lo: usize, hi: usize): Option<Utf8String> {\n    if (lo > hi || !this.isCharBoundary(lo) || !this.isCharBoundary(hi)) {\n      return None;\n    }\n    return Some(new Utf8String(this.text.substring(lo, hi)));\n  }\n}\n\n// Returns s when it is valid UTF-8 and traps otherwise (the guard of the `Utf8String` constructor).\n@Requires(isValidUtf8(s))\n@Ensures(result == s)\nfunction checked(s: string): string {\n  checkUtf8(s).unwrap();\n  return s;\n}\n\n// validateString(s): `s` as a Utf8String, or the first error. O(n).\n@Ensures(result.isOk() == isValidUtf8(s))\n@Ensures(result.isOk() ==> result.unwrap().asString() == s)\n@Ensures(result.isErr() ==> result.unwrapErr().position < s.length)\nexport function validateString(s: string): Result<Utf8String, Utf8Error> {\n  const r = checkUtf8(s);\n  if (r.isErr()) {\n    return Err(r.unwrapErr());\n  }\n  return Ok(new Utf8String(s));\n}\n\n// validate(b): decodes bytes to text, rejecting overlong forms, surrogates and values above U+10FFFF, with the\n// error position. O(n).\n@Ensures(result.isOk() ==> result.unwrap().byteLength() == b.length())\n@Ensures(result.isErr() ==> result.unwrapErr().position < b.length())\nexport function validate(b: Bytes): Result<Utf8String, Utf8Error> {\n  return validateString(b.toRawString());\n}\n\n// encode(s): the UTF-8 bytes of a Utf8String. O(n).\n@Ensures(result.length() == s.byteLength())\nexport function encode(s: Utf8String): Bytes {\n  return s.toBytes();\n}\n\n// fromCodePoints(cps): the string made of the code points; None if any is not a scalar value. O(n).\n@Ensures(result.isSome() ==> result.unwrap().codePointCount() == cps.length)\n@Ensures(cps.length == 0 ==> result.isSome() && result.unwrap().isEmpty())\nexport function fromCodePoints(cps: int[]): Option<Utf8String> {\n  let parts: string[] = [];\n  let i: usize = 0;\n  while (i < cps.length) {\n    const e = encodeCodePoint(cps[i]);\n    if (e.isNone()) {\n      return None;\n    }\n    parts.push(e.unwrap());\n    i += 1;\n  }\n  return Some(new Utf8String(parts.join(\"\")));\n}\n\n// --------------------------------------------------------------------------------------------- cursor\n\n// Iterates the code points of a Utf8String. The cursor always sits on a code point boundary.\n@Invariant(this.pos <= this.src.byteLength() && this.src.isCharBoundary(this.pos))\nexport class CodePointCursor {\n  private src: Utf8String;\n  private pos: usize = 0;\n\n  constructor(src: Utf8String) {\n    this.src = src;\n  }\n\n  // position(): byte offset of the next code point. O(1).\n  @Ensures(result <= this.src.byteLength())\n  position(): usize {\n    return this.pos;\n  }\n\n  // hasNext(): a code point is left. O(1).\n  @Ensures(result == (this.pos < this.src.byteLength()))\n  hasNext(): bool {\n    return this.pos < this.src.byteLength();\n  }\n\n  // next(): the next code point and advance past it; None at the end. O(1).\n  @Ensures(result.isSome() == old(this.hasNext()))\n  @Ensures(result.isSome() ==> isScalarValue(result.unwrap()))\n  @Ensures(result.isSome() ==> this.position() == old(this.position()) + utf8Len(result.unwrap()).toUsize())\n  @Ensures(result.isNone() ==> this.position() == old(this.position()))\n  next(): Option<int> {\n    const c = this.src.codePointAt(this.pos);\n    if (c.isNone()) {\n      return None;\n    }\n    this.pos += utf8Len(c.unwrap()).toUsize();\n    return c;\n  }\n}\n" });
  return out;
}
