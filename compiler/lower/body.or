// HIR -> MIR lowering of function bodies (docs/mir.md ownership rules, ADR-0006).
//
// Output is a flat `Item` stream per function (instructions, labels, terminators, local
// declarations) that `buildBlocks` turns into basic blocks. Orin-B has no mutable references,
// so the counters (`Ctr`: next temp local / next label) are threaded through every function.
//
// Values (`V`) carry an ownership kind:
//   KS  scalar, or an immortal string literal operand: nothing to release
//   KO  `op` is a fresh Owned temp: the consumer must release or consume it
//   KB  `op` is a local that is only borrowed (a param, an HIR local or a Borrowed temp);
//       `root`/`stable` say which local it lives in and whether that local can change
//       (stable = the root is immutable: a param, a `const`, a pattern binding, a loop variable)
// `Sc.vars` lists every Owned local/temp of the current function that is live at this program
// point (innermost last): early exits (return, break, continue, `?`) release exactly those.

import {
  Type, Program, Function, HBlock, HStmt, Place, PlaceElem, HExpr, HExprKind, UnOp, BinOp,
  FieldInitH, HArm, HPattern, Builtin, MutBuiltin, intKindOf, kindNarrow, kindLo, kindHi, taskOpOpensFrom, taskOpAdopts
} from "../hir";
import { MType, MLocal, Operand, Instr, Terminator, SwitchCase, MFunction } from "../mir";
import { Item, buildBlocks } from "./items";
import { preludeSlot } from "./prelude";
import {
  Lits, litId, isRefTy, isHandleTy, isVoidTy, isUsizeTy, isStringTy, isF32Ty, mty, isSimple, hasEffects, armsHaveEffects
} from "./util";

export type Cx = { prog: Program; fn: Function; nHir: usize; lits: Lits; };
export type Ctr = { loc: usize; lab: usize; };
export type Sc = { vars: usize[]; loopMark: usize; brk: usize; cont: usize; };
type Kind = KS | KO | KB;
type V = { items: Item[]; op: Operand; k: Kind; root: usize; stable: bool; c: Ctr; };
type Args = { items: Item[]; ops: Operand[]; own: bool[]; roots: usize[]; stab: bool[]; c: Ctr; };
type Own = { items: Item[]; op: Operand; c: Ctr; };
type Tm = { c: Ctr; id: usize; d: Item; };
type SR = { items: Item[]; c: Ctr; added: Option<usize>; };
type SS = { items: Item[]; c: Ctr; vars: usize[]; };
type BR = { items: Item[]; c: Ctr; };

// ---------------------------------------------------------------- small helpers

function tm(c: Ctr, t: MType): Tm {
  return Tm { c: Ctr { loc: c.loc + 1, lab: c.lab }, id: c.loc, d: IxD(c.loc, t) };
}

function labs(c: Ctr, n: usize): Ctr {
  return Ctr { loc: c.loc, lab: c.lab + n };
}

function ii(i: Instr): Item {
  return IxI(i);
}

function localOf(op: Operand): usize {
  return match (op) {
    OLocal(l) => l,
    _ => 0
  };
}

function isLocalOp(op: Operand): bool {
  return match (op) {
    OLocal(_) => true,
    _ => false
  };
}

function isOStr(op: Operand): bool {
  return match (op) {
    OStr(_) => true,
    _ => false
  };
}

function kindIsO(k: Kind): bool {
  return match (k) { KO => true, _ => false };
}

function kindIsB(k: Kind): bool {
  return match (k) { KB => true, _ => false };
}

function vConst(op: Operand, c: Ctr): V {
  const none: Item[] = [];
  return V { items: none, op: op, k: KS, root: 0, stable: true, c: c };
}

function vVoid(items: Item[], c: Ctr): V {
  return V { items: items, op: OInt(0), k: KS, root: 0, stable: true, c: c };
}

function vOwned(items: Item[], t: usize, c: Ctr): V {
  return V { items: items, op: OLocal(t), k: KO, root: t, stable: true, c: c };
}

function vScalar(items: Item[], t: usize, c: Ctr): V {
  return V { items: items, op: OLocal(t), k: KS, root: t, stable: true, c: c };
}

function inVars(vars: usize[], l: usize): bool {
  for (const v of vars) {
    if (v == l) {
      return true;
    }
  }
  return false;
}

// Release statements for vars[lo..], innermost first.
function releaseFrom(vars: usize[], lo: usize): Item[] {
  let out: Item[] = [];
  let i = vars.length;
  while (i > lo) {
    i -= 1;
    out.push(ii(IRelease(vars[i])));
  }
  return out;
}

function releaseExcept(vars: usize[], keep: usize): Item[] {
  let out: Item[] = [];
  let i = vars.length;
  while (i > 0) {
    i -= 1;
    if (vars[i] != keep) {
      out.push(ii(IRelease(vars[i])));
    }
  }
  return out;
}

// Release an owned value that was only borrowed.
function discard(v: V): Item[] {
  let out: Item[] = [];
  match (v.k) {
    KO => {
      out.push(ii(IRelease(localOf(v.op))));
    },
    _ => {}
  }
  return out;
}

function releaseOwned(a: Args): Item[] {
  let out: Item[] = [];
  let i: usize = 0;
  while (i < a.ops.length) {
    if (a.own[i]) {
      out.push(ii(IRelease(localOf(a.ops[i]))));
    }
    i += 1;
  }
  return out;
}

function dupOf(c: Ctr, op: Operand): Own {
  const t = tm(c, MRef);
  const items: Item[] = [t.d, ii(IDup(t.id, op))];
  return Own { items: items, op: OLocal(t.id), c: t.c };
}

// An operand that can be consumed (moved into a struct/array/slot): Owned local or literal.
function ownOp(c: Ctr, ty: Type, op: Operand, owned: bool): Own {
  const none: Item[] = [];
  if (!isRefTy(ty) || owned || isOStr(op)) {
    return Own { items: none, op: op, c: c };
  }
  return dupOf(c, op);
}

function sub(sc: Sc, vars: usize[]): Sc {
  return Sc { vars: vars, loopMark: sc.loopMark, brk: sc.brk, cont: sc.cont };
}

// ---------------------------------------------------------------- argument sequences

// Evaluate `es` left to right. Owned temps stay Owned (listed in `own`) until the caller
// releases or consumes them. A borrowed ref that a later argument could invalidate (or a
// mutable scalar local that it could change) is pinned: duplicated / copied right away.
function lowerArgs(cx: Cx, sc: Sc, c0: Ctr, es: HExpr[]): Args {
  const n = es.length;
  let later: bool[] = [];
  let k: usize = 0;
  while (k < n) {
    later.push(false);
    k += 1;
  }
  let acc = false;
  k = n;
  while (k > 0) {
    k -= 1;
    later[k] = acc;
    if (hasEffects(es[k])) {
      acc = true;
    }
  }
  let items: Item[] = [];
  let ops: Operand[] = [];
  let own: bool[] = [];
  let roots: usize[] = [];
  let stab: bool[] = [];
  let vars = sc.vars;
  let c = c0;
  let i: usize = 0;
  while (i < n) {
    const e = es[i];
    const v = expr(cx, sub(sc, vars), c, e);
    items = items.concat(v.items);
    c = v.c;
    let op = v.op;
    let owned = kindIsO(v.k);
    let root = v.root;
    let st = v.stable;
    if (later[i]) {
      if (isRefTy(e.ty)) {
        if (kindIsB(v.k) && !v.stable) {
          const d = dupOf(c, op);
          items = items.concat(d.items);
          c = d.c;
          op = d.op;
          owned = true;
          root = localOf(op);
          st = true;
        }
      } else {
        if (isLocalOp(op) && localOf(op) < cx.nHir && cx.fn.locals[localOf(op)].mutable) {
          const t = tm(c, mty(e.ty));
          c = t.c;
          items.push(t.d);
          items.push(ii(ICopy(t.id, op)));
          op = OLocal(t.id);
        }
      }
    }
    if (owned) {
      vars.push(localOf(op));
    }
    ops.push(op);
    own.push(owned);
    roots.push(root);
    stab.push(st);
    i += 1;
  }
  return Args { items: items, ops: ops, own: own, roots: roots, stab: stab, c: c };
}

// ---------------------------------------------------------------- expressions

export function expr(cx: Cx, sc: Sc, c: Ctr, e: HExpr): V {
  return match (e.kind) {
    XInt(v) => vConst(isUsizeTy(e.ty) ? OUsize(v) : OInt(v), c),
    XFloat(t) => exprFloatLit(c, e, t),
    XBool(b) => vConst(OBool(b), c),
    XStr(s) => vConst(OStr(litId(cx.lits, s)), c),
    XLocal(l) => exprLocal(cx, c, l, e.ty),
    XUnary(op, x) => exprUnary(cx, sc, c, e, op, x),
    XBinary(op, a, b) => exprBinary(cx, sc, c, e, op, a, b),
    XCall(f, args) => exprCall(cx, sc, c, e, f, args),
    XBuiltin(b, args) => exprBuiltin(cx, sc, c, e, b, args),
    XMutMethod(m, p, args) => exprMut(cx, sc, c, m, p, args),
    XField(b, _, idx) => exprField(cx, sc, c, e, b, idx),
    XIndex(b, i) => exprIndex(cx, sc, c, e, b, i),
    XRecord(r, sp, fs) => exprRecord(cx, sc, c, r, sp, fs),
    XVariant(tag, payload) => exprVariant(cx, sc, c, tag, payload),
    XArray(xs) => exprArray(cx, sc, c, e, xs),
    XTry(x) => exprTry(cx, sc, c, e, x),
    XCond(a, b, d) => exprCond(cx, sc, c, e, a, b, d),
    XMatch(s, arms) => exprMatch(cx, sc, c, e, s, arms),
    XClosure(f, caps) => exprClosure(cx, sc, c, f, caps),
    XCallIndirect(f, args) => exprCallIndirect(cx, sc, c, e, f, args),
    XIface(vt, v) => exprIface(cx, sc, c, vt, v),
    XCallVirtual(r, slot, args) => exprCallVirtual(cx, sc, c, e, r, slot, args)
  };
}

function exprLocal(cx: Cx, c: Ctr, l: usize, ty: Type): V {
  const none: Item[] = [];
  const stable = !cx.fn.locals[l].mutable;
  const k: Kind = isRefTy(ty) ? KB : KS;
  return V { items: none, op: OLocal(l), k: k, root: l, stable: stable, c: c };
}

// A float literal; an f32 literal is rounded to binary32 (decimal -> double -> float, ADR-0018).
function exprFloatLit(c: Ctr, e: HExpr, text: string): V {
  if (!isF32Ty(e.ty)) {
    return vConst(OFloat(text), c);
  }
  const t = tm(c, MFloat);
  let items: Item[] = [];
  items.push(t.d);
  items.push(ii(IBuiltin(Some(t.id), BF32Round, [OFloat(text)])));
  return vScalar(items, t.id, t.c);
}

// After an operation whose f32 result was computed in binary64: round to binary32 (ADR-0018).
function roundF32(items0: Item[], id: usize, c: Ctr): V {
  let items = items0;
  const r = tm(c, MFloat);
  items.push(r.d);
  items.push(ii(IBuiltin(Some(r.id), BF32Round, [OLocal(id)])));
  return vScalar(items, r.id, r.c);
}

// Builtins whose result may need rounding when it is an f32 (the others are exact on f32 inputs).
function roundsF32(b: Builtin): bool {
  return match (b) {
    BFloatSqrt => true,
    BFloatPow => true,
    BIntToFloat => true,
    BUsizeToFloat => true,
    _ => false
  };
}

// After an operation on a type narrower than 64 bits (computed in an MInt with the 64-bit checked operation):
// trap unless the result is in the type's range (ADR-0022). `%` cannot leave the range. The `op` of a negation
// is passed as OpSub.
function rangeCheck(ty: Type, op: BinOp, id: usize): Item[] {
  let out: Item[] = [];
  const k = intKindOf(ty);
  if (k < 0 || !kindNarrow(k)) {
    return out;
  }
  const checked = match (op) {
    OpAdd => true,
    OpSub => true,
    OpMul => true,
    OpDiv => true,
    _ => false
  };
  if (checked) {
    out.push(ii(IBuiltin(Some(id), BIntRange, [OLocal(id), OInt(kindLo(k)), OInt(kindHi(k))])));
  }
  return out;
}

function isArithBin(op: BinOp): bool {
  return match (op) {
    OpAdd => true,
    OpSub => true,
    OpMul => true,
    OpDiv => true,
    _ => false
  };
}

function exprUnary(cx: Cx, sc: Sc, c0: Ctr, e: HExpr, op: UnOp, x: HExpr): V {
  const v = expr(cx, sc, c0, x);
  const t = tm(v.c, mty(e.ty));
  let items = v.items;
  items.push(t.d);
  items.push(ii(IUnary(t.id, op, v.op)));
  items = items.concat(rangeCheck(e.ty, OpSub, t.id));
  return vScalar(items, t.id, t.c);
}

function isAdd(op: BinOp): bool {
  return match (op) { OpAdd => true, _ => false };
}

function exprBinary(cx: Cx, sc: Sc, c: Ctr, e: HExpr, op: BinOp, lhs: HExpr, rhs: HExpr): V {
  match (op) {
    OpAnd => {
      return exprLogic(cx, sc, c, lhs, rhs, true);
    },
    OpOr => {
      return exprLogic(cx, sc, c, lhs, rhs, false);
    },
    _ => {}
  }
  const es: HExpr[] = [lhs, rhs];
  const a = lowerArgs(cx, sc, c, es);
  let items = a.items;
  if (isStringTy(lhs.ty) && isAdd(op)) {
    // a + b: append onto an owned copy of a (in place when a is a fresh temp)
    let acc = a.ops[0];
    let cc = a.c;
    if (!a.own[0]) {
      const d = dupOf(cc, a.ops[0]);
      items = items.concat(d.items);
      cc = d.c;
      acc = d.op;
    }
    items.push(ii(IStrAppend(localOf(acc), a.ops[1])));
    if (a.own[1]) {
      items.push(ii(IRelease(localOf(a.ops[1]))));
    }
    return vOwned(items, localOf(acc), cc);
  }
  const t = tm(a.c, mty(e.ty));
  items.push(t.d);
  items.push(ii(IBinary(t.id, op, a.ops[0], a.ops[1])));
  items = items.concat(rangeCheck(e.ty, op, t.id));
  items = items.concat(releaseOwned(a));
  if (isF32Ty(e.ty) && isArithBin(op)) {
    return roundF32(items, t.id, t.c);
  }
  return vScalar(items, t.id, t.c);
}

// a && b / a || b with short-circuit evaluation.
function exprLogic(cx: Cx, sc: Sc, c0: Ctr, lhs: HExpr, rhs: HExpr, isAnd: bool): V {
  if (isSimple(rhs)) {
    const es: HExpr[] = [lhs, rhs];
    const a = lowerArgs(cx, sc, c0, es);
    const t = tm(a.c, MBool);
    let items = a.items;
    items.push(t.d);
    items.push(ii(IBinary(t.id, isAnd ? OpAnd : OpOr, a.ops[0], a.ops[1])));
    return vScalar(items, t.id, t.c);
  }
  const a = expr(cx, sc, c0, lhs);
  const d = tm(a.c, MBool);
  let c = d.c;
  let items = a.items;
  items.push(d.d);
  items.push(ii(ICopy(d.id, a.op)));
  const lr = c.lab;
  const lend = c.lab + 1;
  c = labs(c, 2);
  if (isAnd) {
    items.push(IxT(TBranch(OLocal(d.id), lr, lend)));
  } else {
    items.push(IxT(TBranch(OLocal(d.id), lend, lr)));
  }
  items.push(IxL(lr));
  const b = expr(cx, sc, c, rhs);
  items = items.concat(b.items);
  items.push(ii(ICopy(d.id, b.op)));
  items.push(IxT(TGoto(lend)));
  items.push(IxL(lend));
  return vScalar(items, d.id, b.c);
}

function exprCall(cx: Cx, sc: Sc, c: Ctr, e: HExpr, f: usize, args: HExpr[]): V {
  const a = lowerArgs(cx, sc, c, args);
  let items = a.items;
  if (isVoidTy(e.ty)) {
    items.push(ii(ICall(None, f, a.ops)));
    items = items.concat(releaseOwned(a));
    return vVoid(items, a.c);
  }
  const t = tm(a.c, mty(e.ty));
  items.push(t.d);
  items.push(ii(ICall(Some(t.id), f, a.ops)));
  items = items.concat(releaseOwned(a));
  if (isRefTy(e.ty)) {
    return vOwned(items, t.id, t.c);
  }
  return vScalar(items, t.id, t.c);
}

// A closure: the captured values are consumed like the slots of a variant (IClosure, docs/mir.md v1.3).
function exprClosure(cx: Cx, sc: Sc, c: Ctr, f: usize, caps: HExpr[]): V {
  const a = lowerArgs(cx, sc, c, caps);
  let tys: Type[] = [];
  for (const x of caps) {
    tys.push(x.ty);
  }
  const o = ownAll(a.c, a, tys, a.items);
  let items = o.items;
  const t = tm(o.c, MRef);
  items.push(t.d);
  items.push(ii(IClosure(t.id, f, o.ops)));
  return vOwned(items, t.id, t.c);
}

// A call of a function value: the callee is evaluated first, then the arguments; all are borrowed.
function exprCallIndirect(cx: Cx, sc: Sc, c: Ctr, e: HExpr, callee: HExpr, args: HExpr[]): V {
  let es: HExpr[] = [callee];
  for (const x of args) {
    es.push(x);
  }
  const a = lowerArgs(cx, sc, c, es);
  let items = a.items;
  const f = a.ops[0];
  let rest: Operand[] = [];
  let i: usize = 1;
  while (i < a.ops.length) {
    rest.push(a.ops[i]);
    i += 1;
  }
  if (isVoidTy(e.ty)) {
    items.push(ii(ICallIndirect(None, f, rest)));
    items = items.concat(releaseOwned(a));
    return vVoid(items, a.c);
  }
  const t = tm(a.c, mty(e.ty));
  items.push(t.d);
  items.push(ii(ICallIndirect(Some(t.id), f, rest)));
  items = items.concat(releaseOwned(a));
  if (isRefTy(e.ty)) {
    return vOwned(items, t.id, t.c);
  }
  return vScalar(items, t.id, t.c);
}

// An interface value (ADR-0019): the class value is consumed like the slot of a variant (IIface,
// docs/mir.md v1.5); the vtable is `MProgram.vtables[vt]`.
function exprIface(cx: Cx, sc: Sc, c: Ctr, vt: usize, v: HExpr): V {
  const a = lowerArgs(cx, sc, c, [v]);
  const o = ownAll(a.c, a, [v.ty], a.items);
  let items = o.items;
  const t = tm(o.c, MRef);
  items.push(t.d);
  items.push(ii(IIface(t.id, vt, o.ops[0])));
  return vOwned(items, t.id, t.c);
}

// A call through the vtable of an interface value: receiver first, then the arguments; all borrowed.
function exprCallVirtual(cx: Cx, sc: Sc, c: Ctr, e: HExpr, recv: HExpr, slot: usize, args: HExpr[]): V {
  let es: HExpr[] = [recv];
  for (const x of args) {
    es.push(x);
  }
  const a = lowerArgs(cx, sc, c, es);
  let items = a.items;
  const r = a.ops[0];
  let rest: Operand[] = [];
  let i: usize = 1;
  while (i < a.ops.length) {
    rest.push(a.ops[i]);
    i += 1;
  }
  if (isVoidTy(e.ty)) {
    items.push(ii(ICallVirtual(None, r, slot, rest)));
    items = items.concat(releaseOwned(a));
    return vVoid(items, a.c);
  }
  const t = tm(a.c, mty(e.ty));
  items.push(t.d);
  items.push(ii(ICallVirtual(Some(t.id), r, slot, rest)));
  items = items.concat(releaseOwned(a));
  if (isRefTy(e.ty)) {
    return vOwned(items, t.id, t.c);
  }
  return vScalar(items, t.id, t.c);
}

// Tag test: Option/Result predicates.
function tagTest(a: Args, tag: int, eq: bool): V {
  let items = a.items;
  const tg = tm(a.c, MInt);
  items.push(tg.d);
  items.push(ii(ITag(tg.id, a.ops[0])));
  const r = tm(tg.c, MBool);
  items.push(r.d);
  items.push(ii(IBinary(r.id, eq ? OpEq : OpNe, OLocal(tg.id), OInt(tag))));
  items = items.concat(releaseOwned(a));
  return vScalar(items, r.id, r.c);
}

// unwrap / unwrapErr: trap unless the tag is `tag`, then borrow slot 0.
function unwrapForm(a: Args, ty: Type, tag: int, msg: string): V {
  let items = a.items;
  const tg = tm(a.c, MInt);
  items.push(tg.d);
  items.push(ii(ITag(tg.id, a.ops[0])));
  const cmp = tm(tg.c, MBool);
  items.push(cmp.d);
  items.push(ii(IBinary(cmp.id, OpEq, OLocal(tg.id), OInt(tag))));
  const lok = cmp.c.lab;
  const ltrap = cmp.c.lab + 1;
  const c = labs(cmp.c, 2);
  items.push(IxT(TBranch(OLocal(cmp.id), lok, ltrap)));
  items.push(IxL(ltrap));
  items.push(IxT(TTrap(msg)));
  items.push(IxL(lok));
  if (isVoidTy(ty)) {
    items = items.concat(releaseOwned(a));
    return vVoid(items, c);
  }
  const d = tm(c, mty(ty));
  items.push(d.d);
  items.push(ii(IGetField(d.id, a.ops[0], 0)));
  if (a.own[0]) {
    if (isRefTy(ty)) {
      const d2 = dupOf(d.c, OLocal(d.id));
      items = items.concat(d2.items);
      items.push(ii(IRelease(localOf(a.ops[0]))));
      return vOwned(items, localOf(d2.op), d2.c);
    }
    items.push(ii(IRelease(localOf(a.ops[0]))));
    return vScalar(items, d.id, d.c);
  }
  if (isRefTy(ty)) {
    return V { items: items, op: OLocal(d.id), k: KB, root: a.roots[0], stable: a.stab[0], c: d.c };
  }
  return vScalar(items, d.id, d.c);
}

function exprBuiltin(cx: Cx, sc: Sc, c: Ctr, e: HExpr, b: Builtin, args: HExpr[]): V {
  // Built-ins that migrated to the Orin prelude (spec 19 R1) become ordinary calls.
  const slot = preludeSlot(b);
  if (slot >= 0 && slot.toUsize() < cx.lits.pre.length && cx.lits.pre[slot.toUsize()] >= 0) {
    return exprCall(cx, sc, c, e, cx.lits.pre[slot.toUsize()].toUsize(), args);
  }
  const a = lowerArgs(cx, sc, c, args);
  match (b) {
    BOptIsSome => {
      return tagTest(a, 0, true);
    },
    BOptIsNone => {
      return tagTest(a, 1, true);
    },
    BResIsOk => {
      return tagTest(a, 0, true);
    },
    BResIsErr => {
      return tagTest(a, 1, true);
    },
    BOptUnwrap => {
      return unwrapForm(a, e.ty, 0, "unwrap on None");
    },
    BResUnwrap => {
      return unwrapForm(a, e.ty, 0, "unwrap on Err");
    },
    BResUnwrapErr => {
      return unwrapForm(a, e.ty, 1, "unwrapErr on Ok");
    },
    _ => {}
  }
  let items = a.items;
  if (isVoidTy(e.ty)) {
    items.push(ii(IBuiltin(None, b, a.ops)));
    items = items.concat(releaseOwned(a));
    return vVoid(items, a.c);
  }
  const t = tm(a.c, mty(e.ty));
  items.push(t.d);
  items.push(ii(IBuiltin(Some(t.id), b, a.ops)));
  items = items.concat(releaseOwned(a));
  if (isRefTy(e.ty)) {
    return vOwned(items, t.id, t.c);
  }
  if (isF32Ty(e.ty) && roundsF32(b)) {
    return roundF32(items, t.id, t.c);
  }
  return vScalar(items, t.id, t.c);
}

// Read a field/element of `base` into a new local `d`, fixing up ownership of the result.
function projected(items0: Item[], d: Tm, ty: Type, baseOp: Operand, baseOwned: bool, root: usize, stable: bool): V {
  let items = items0;
  if (baseOwned) {
    if (isRefTy(ty)) {
      const d2 = dupOf(d.c, OLocal(d.id));
      items = items.concat(d2.items);
      items.push(ii(IRelease(localOf(baseOp))));
      return vOwned(items, localOf(d2.op), d2.c);
    }
    items.push(ii(IRelease(localOf(baseOp))));
    return vScalar(items, d.id, d.c);
  }
  if (isRefTy(ty)) {
    return V { items: items, op: OLocal(d.id), k: KB, root: root, stable: stable, c: d.c };
  }
  return vScalar(items, d.id, d.c);
}

function exprField(cx: Cx, sc: Sc, c: Ctr, e: HExpr, base: HExpr, idx: usize): V {
  const v = expr(cx, sc, c, base);
  let items = v.items;
  const d = tm(v.c, mty(e.ty));
  items.push(d.d);
  items.push(ii(IGetField(d.id, v.op, idx)));
  return projected(items, d, e.ty, v.op, kindIsO(v.k), v.root, v.stable);
}

function exprIndex(cx: Cx, sc: Sc, c: Ctr, e: HExpr, base: HExpr, ix: HExpr): V {
  const es: HExpr[] = [base, ix];
  const a = lowerArgs(cx, sc, c, es);
  let items = a.items;
  const d = tm(a.c, mty(e.ty));
  items.push(d.d);
  items.push(ii(IArrayGet(d.id, a.ops[0], a.ops[1])));
  return projected(items, d, e.ty, a.ops[0], a.own[0], a.roots[0], a.stab[0]);
}

function containsIndex(fields: FieldInitH[], i: usize): bool {
  for (const f of fields) {
    if (f.index == i) {
      return true;
    }
  }
  return false;
}

function exprRecord(cx: Cx, sc: Sc, c: Ctr, rid: usize, spread: Option<HExpr>, fields: FieldInitH[]): V {
  const def = cx.prog.records[rid];
  const nf = def.fields.length;
  let es: HExpr[] = [];
  let hasSpread = false;
  match (spread) {
    Some(sp) => {
      es.push(sp);
      hasSpread = true;
    },
    None => {}
  }
  for (const f of fields) {
    es.push(f.value);
  }
  const a = lowerArgs(cx, sc, c, es);
  let items = a.items;
  let cc = a.c;
  let slots: Operand[] = [];
  let i: usize = 0;
  while (i < nf) {
    slots.push(OInt(0));
    i += 1;
  }
  const base: usize = hasSpread ? 1 : 0;
  i = 0;
  for (const f of fields) {
    const o = ownOp(cc, f.value.ty, a.ops[base + i], a.own[base + i]);
    items = items.concat(o.items);
    cc = o.c;
    slots[f.index] = o.op;
    i += 1;
  }
  if (hasSpread) {
    i = 0;
    while (i < nf) {
      if (!containsIndex(fields, i)) {
        const fty = def.fields[i].ty;
        const g = tm(cc, mty(fty));
        cc = g.c;
        items.push(g.d);
        items.push(ii(IGetField(g.id, a.ops[0], i)));
        if (isRefTy(fty)) {
          const d = dupOf(cc, OLocal(g.id));
          items = items.concat(d.items);
          cc = d.c;
          slots[i] = d.op;
        } else {
          slots[i] = OLocal(g.id);
        }
      }
      i += 1;
    }
  }
  const t = tm(cc, MRef);
  items.push(t.d);
  items.push(ii(IStructNew(t.id, 0, slots)));
  if (hasSpread && a.own[0]) {
    items.push(ii(IRelease(localOf(a.ops[0]))));
  }
  return vOwned(items, t.id, t.c);
}

function ownAll(c0: Ctr, a: Args, tys: Type[], items0: Item[]): Own2 {
  let items = items0;
  let c = c0;
  let ops: Operand[] = [];
  let i: usize = 0;
  while (i < tys.length) {
    const o = ownOp(c, tys[i], a.ops[i], a.own[i]);
    items = items.concat(o.items);
    c = o.c;
    ops.push(o.op);
    i += 1;
  }
  return Own2 { items: items, ops: ops, c: c };
}

type Own2 = { items: Item[]; ops: Operand[]; c: Ctr; };

function exprVariant(cx: Cx, sc: Sc, c: Ctr, tag: usize, payload: HExpr[]): V {
  if (payload.length == 0) {
    const t = tm(c, MRef);
    const items: Item[] = [t.d, ii(INullary(t.id, tag))];
    return vOwned(items, t.id, t.c);
  }
  const a = lowerArgs(cx, sc, c, payload);
  let tys: Type[] = [];
  for (const p of payload) {
    tys.push(p.ty);
  }
  const o = ownAll(a.c, a, tys, a.items);
  let items = o.items;
  const t = tm(o.c, MRef);
  items.push(t.d);
  items.push(ii(IStructNew(t.id, tag, o.ops)));
  return vOwned(items, t.id, t.c);
}

function exprArray(cx: Cx, sc: Sc, c: Ctr, e: HExpr, xs: HExpr[]): V {
  const elemRef = match (e.ty) {
    TyArray(t) => isRefTy(t),
    _ => false
  };
  const a = lowerArgs(cx, sc, c, xs);
  let tys: Type[] = [];
  for (const x of xs) {
    tys.push(x.ty);
  }
  const o = ownAll(a.c, a, tys, a.items);
  let items = o.items;
  const t = tm(o.c, MRef);
  items.push(t.d);
  items.push(ii(IArrayNew(t.id, elemRef, o.ops)));
  return vOwned(items, t.id, t.c);
}

function exprTry(cx: Cx, sc: Sc, c0: Ctr, e: HExpr, inner: HExpr): V {
  const errTy = match (inner.ty) {
    TyResult(_, er) => er,
    _ => TyVoid
  };
  const v = expr(cx, sc, c0, inner);
  let items = v.items;
  const tg = tm(v.c, MInt);
  items.push(tg.d);
  items.push(ii(ITag(tg.id, v.op)));
  const cmp = tm(tg.c, MBool);
  items.push(cmp.d);
  items.push(ii(IBinary(cmp.id, OpEq, OLocal(tg.id), OInt(1))));
  const lerr = cmp.c.lab;
  const lok = cmp.c.lab + 1;
  let c = labs(cmp.c, 2);
  items.push(IxT(TBranch(OLocal(cmp.id), lerr, lok)));
  // error path: rebuild Err(e) for our own return type, release everything live, return
  items.push(IxL(lerr));
  const g = tm(c, mty(errTy));
  c = g.c;
  items.push(g.d);
  items.push(ii(IGetField(g.id, v.op, 0)));
  let slot: Operand = OLocal(g.id);
  if (isRefTy(errTy)) {
    const d = dupOf(c, OLocal(g.id));
    items = items.concat(d.items);
    c = d.c;
    slot = d.op;
  }
  const r = tm(c, MRef);
  c = r.c;
  items.push(r.d);
  items.push(ii(IStructNew(r.id, 1, [slot])));
  items = items.concat(discard(v));
  items = items.concat(releaseFrom(sc.vars, 0));
  items.push(IxT(TReturn(Some(OLocal(r.id)))));
  // ok path
  items.push(IxL(lok));
  if (isVoidTy(e.ty)) {
    items = items.concat(discard(v));
    return vVoid(items, c);
  }
  const d = tm(c, mty(e.ty));
  items.push(d.d);
  items.push(ii(IGetField(d.id, v.op, 0)));
  return projected(items, d, e.ty, v.op, kindIsO(v.k), v.root, v.stable);
}

// res = value (consumed as an owned ref / copied scalar)
function assignRes(res: usize, v: V, ty: Type): Item[] {
  let out: Item[] = [];
  if (isVoidTy(ty)) {
    return discard(v);
  }
  if (!isRefTy(ty)) {
    out.push(ii(ICopy(res, v.op)));
    return out;
  }
  match (v.k) {
    KO => {
      out.push(ii(IMove(res, localOf(v.op))));
    },
    KS => {
      out.push(ii(ICopy(res, v.op)));
    },
    KB => {
      out.push(ii(IDup(res, v.op)));
    }
  }
  return out;
}

function exprCond(cx: Cx, sc: Sc, c0: Ctr, e: HExpr, cond: HExpr, th: HExpr, el: HExpr): V {
  const cv = expr(cx, sc, c0, cond);
  let items = cv.items;
  let c = cv.c;
  const isV = isVoidTy(e.ty);
  let res: usize = 0;
  if (!isV) {
    const r = tm(c, mty(e.ty));
    c = r.c;
    res = r.id;
    items.push(r.d);
  }
  const lt = c.lab;
  const lf = c.lab + 1;
  const le = c.lab + 2;
  c = labs(c, 3);
  items.push(IxT(TBranch(cv.op, lt, lf)));
  items.push(IxL(lt));
  const a = expr(cx, sc, c, th);
  items = items.concat(a.items);
  items = items.concat(assignRes(res, a, e.ty));
  items.push(IxT(TGoto(le)));
  items.push(IxL(lf));
  const b = expr(cx, sc, a.c, el);
  items = items.concat(b.items);
  items = items.concat(assignRes(res, b, e.ty));
  items.push(IxT(TGoto(le)));
  items.push(IxL(le));
  if (isV) {
    return vVoid(items, b.c);
  }
  if (isRefTy(e.ty)) {
    return vOwned(items, res, b.c);
  }
  return vScalar(items, res, b.c);
}

function patIsVariant(p: HPattern): bool {
  return match (p) {
    HPVariant(_, _) => true,
    _ => false
  };
}

function patIsWild(p: HPattern): bool {
  return match (p) {
    HPWildcard => true,
    _ => false
  };
}

function hasSeen(seen: usize[], t: usize): bool {
  for (const s of seen) {
    if (s == t) {
      return true;
    }
  }
  return false;
}

function litOperand(cx: Cx, p: HPattern, sty: Type): Operand {
  return match (p) {
    HPInt(v) => isUsizeTy(sty) ? OUsize(v) : OInt(v),
    HPStr(s) => OStr(litId(cx.lits, s)),
    HPBool(b) => OBool(b),
    _ => OInt(0)
  };
}

function exprMatch(cx: Cx, sc: Sc, c0: Ctr, e: HExpr, scrut: HExpr, arms: HArm[]): V {
  const sv = expr(cx, sc, c0, scrut);
  let items = sv.items;
  let c = sv.c;
  let sop = sv.op;
  let owned = kindIsO(sv.k);
  let vars = sc.vars;
  // a borrowed scrutinee that an arm could invalidate is pinned
  if (isRefTy(scrut.ty) && kindIsB(sv.k) && !sv.stable && armsHaveEffects(arms)) {
    const d = dupOf(c, sop);
    items = items.concat(d.items);
    c = d.c;
    sop = d.op;
    owned = true;
  }
  if (owned) {
    vars.push(localOf(sop));
  }
  const na = arms.length;
  let limit = na;
  let i: usize = 0;
  while (i < na) {
    if (patIsWild(arms[i].pattern)) {
      limit = i + 1;
      i = na;
    } else {
      i += 1;
    }
  }
  const base = c.lab;
  const lend = base;
  const ltrap = base + 1 + 2 * na;
  c = labs(c, 2 * na + 2);
  const hasVal = !isVoidTy(e.ty);
  let res: usize = 0;
  if (hasVal) {
    const r = tm(c, mty(e.ty));
    c = r.c;
    res = r.id;
    items.push(r.d);
  }
  let isVar = false;
  for (const a of arms) {
    if (patIsVariant(a.pattern)) {
      isVar = true;
    }
  }
  // dispatch
  if (isVar) {
    const tg = tm(c, MInt);
    c = tg.c;
    items.push(tg.d);
    items.push(ii(ITag(tg.id, sop)));
    let cases: SwitchCase[] = [];
    let seen: usize[] = [];
    let dflt = ltrap;
    i = 0;
    while (i < limit) {
      match (arms[i].pattern) {
        HPVariant(tag, _) => {
          if (!hasSeen(seen, tag)) {
            seen.push(tag);
            cases.push(SwitchCase { value: tag.toInt(), target: base + 1 + i });
          }
        },
        HPWildcard => {
          dflt = base + 1 + i;
        },
        _ => {}
      }
      i += 1;
    }
    items.push(IxT(TSwitch(OLocal(tg.id), cases, dflt)));
  } else {
    i = 0;
    let done = false;
    while (i < limit && !done) {
      if (i > 0) {
        items.push(IxL(base + 1 + na + i));
      }
      if (patIsWild(arms[i].pattern)) {
        items.push(IxT(TGoto(base + 1 + i)));
        done = true;
      } else {
        const cmp = tm(c, MBool);
        c = cmp.c;
        items.push(cmp.d);
        items.push(ii(IBinary(cmp.id, OpEq, sop, litOperand(cx, arms[i].pattern, scrut.ty))));
        const next = (i + 1 < limit) ? base + 1 + na + i + 1 : ltrap;
        items.push(IxT(TBranch(OLocal(cmp.id), base + 1 + i, next)));
      }
      i += 1;
    }
    if (!done && limit == 0) {
      items.push(IxT(TGoto(ltrap)));
    }
  }
  items.push(IxL(ltrap));
  items.push(IxT(TTrap("non-exhaustive match")));
  // arms
  i = 0;
  while (i < limit) {
    const arm = arms[i];
    items.push(IxL(base + 1 + i));
    match (arm.pattern) {
      HPVariant(_, binds) => {
        let k: usize = 0;
        for (const b of binds) {
          match (b) {
            Some(l) => {
              items.push(ii(IGetField(l, sop, k)));
            },
            None => {}
          }
          k += 1;
        }
      },
      _ => {}
    }
    const mark = vars.length;
    const body = stmtSeq(cx, sub(sc, vars), c, arm.body.stmts);
    items = items.concat(body.items);
    c = body.c;
    match (arm.value) {
      Some(vx) => {
        const vv = expr(cx, sub(sc, body.vars), c, vx);
        c = vv.c;
        items = items.concat(vv.items);
        items = items.concat(assignRes(res, vv, e.ty));
      },
      None => {}
    }
    items = items.concat(releaseFrom(body.vars, mark));
    items.push(IxT(TGoto(lend)));
    i += 1;
  }
  items.push(IxL(lend));
  if (owned) {
    items.push(ii(IRelease(localOf(sop))));
  }
  if (!hasVal) {
    return vVoid(items, c);
  }
  if (isRefTy(e.ty)) {
    return vOwned(items, res, c);
  }
  return vScalar(items, res, c);
}

// ---------------------------------------------------------------- places

type Fin = FSet(Operand) | FArith(BinOp, Operand) | FAppend(Operand) | FPush(Operand) | FPop(usize);
type Wk = { items: Item[]; c: Ctr; };

// Indices (usize operands) of the PIndex elements of `place`, by path position.
function placeIdx(place: Place, a: Args): Operand[] {
  let out: Operand[] = [];
  let j: usize = 0;
  for (const el of place.path) {
    match (el) {
      PIndex(_) => {
        out.push(a.ops[j]);
        j += 1;
      },
      PField(_, _) => {
        out.push(OInt(0));
      }
    }
  }
  return out;
}

function placeIdxExprs(place: Place): HExpr[] {
  let out: HExpr[] = [];
  for (const el of place.path) {
    match (el) {
      PIndex(ix) => {
        out.push(ix);
      },
      PField(_, _) => {}
    }
  }
  return out;
}

function elemIsIndex(el: PlaceElem): bool {
  return match (el) {
    PIndex(_) => true,
    PField(_, _) => false
  };
}

function fieldOf(el: PlaceElem): usize {
  return match (el) {
    PField(_, i) => i,
    PIndex(_) => 0
  };
}

function takeElem(t: usize, cont: usize, el: PlaceElem, ix: Operand): Instr {
  return match (el) {
    PField(_, i) => ITakeField(t, cont, i),
    PIndex(_) => IArrayTake(t, cont, ix)
  };
}

function putElem(cont: usize, el: PlaceElem, ix: Operand, t: usize): Instr {
  return match (el) {
    PField(_, i) => IPutField(cont, i, t),
    PIndex(_) => IArrayPut(cont, ix, t)
  };
}

function finIsWhole(f: Fin): bool {
  return match (f) {
    FPush(_) => true,
    FPop(_) => true,
    _ => false
  };
}

// Update `place` (path non-empty or whole-array mutation) via take / make_unique / put.
function walkPlace(c0: Ctr, place: Place, idx: Operand[], fin: Fin, ty: Type): Wk {
  let items: Item[] = [];
  let c = c0;
  const n = place.path.length;
  const whole = finIsWhole(fin);
  if (n == 0) {
    match (fin) {
      FPush(v) => {
        items.push(ii(IArrayPush(place.root, v)));
      },
      FPop(d) => {
        items.push(ii(IArrayPop(d, place.root)));
      },
      _ => {}
    }
    return Wk { items: items, c: c };
  }
  items.push(ii(IMakeUnique(place.root)));
  let cur = place.root;
  let conts: usize[] = [];
  let taken: usize[] = [];
  let k: usize = 0;
  while (k < n) {
    const last = k + 1 == n;
    const el = place.path[k];
    if (last && !whole) {
      match (fin) {
        FSet(v) => {
          match (el) {
            PField(_, i) => {
              items.push(ii(ISetField(cur, i, v)));
            },
            PIndex(_) => {
              items.push(ii(IArraySet(cur, idx[k], v)));
            }
          }
        },
        FArith(op, v) => {
          const old = tm(c, mty(ty));
          items.push(old.d);
          match (el) {
            PField(_, i) => {
              items.push(ii(IGetField(old.id, OLocal(cur), i)));
            },
            PIndex(_) => {
              items.push(ii(IArrayGet(old.id, OLocal(cur), idx[k])));
            }
          }
          const nw = tm(old.c, mty(ty));
          c = nw.c;
          items.push(nw.d);
          items.push(ii(IBinary(nw.id, op, OLocal(old.id), v)));
          items = items.concat(rangeCheck(ty, op, nw.id));
          if (isF32Ty(ty)) {
            items.push(ii(IBuiltin(Some(nw.id), BF32Round, [OLocal(nw.id)])));
          }
          match (el) {
            PField(_, i) => {
              items.push(ii(ISetField(cur, i, OLocal(nw.id))));
            },
            PIndex(_) => {
              items.push(ii(IArraySet(cur, idx[k], OLocal(nw.id))));
            }
          }
        },
        FAppend(v) => {
          const t = tm(c, MRef);
          c = t.c;
          items.push(t.d);
          items.push(ii(takeElem(t.id, cur, el, idx[k])));
          items.push(ii(IStrAppend(t.id, v)));
          items.push(ii(putElem(cur, el, idx[k], t.id)));
        },
        _ => {}
      }
    } else {
      const t = tm(c, MRef);
      c = t.c;
      items.push(t.d);
      items.push(ii(takeElem(t.id, cur, el, idx[k])));
      conts.push(cur);
      taken.push(t.id);
      cur = t.id;
      if (last) {
        match (fin) {
          FPush(v) => {
            items.push(ii(IArrayPush(cur, v)));
          },
          FPop(d) => {
            items.push(ii(IArrayPop(d, cur)));
          },
          _ => {}
        }
      } else {
        items.push(ii(IMakeUnique(cur)));
      }
    }
    k += 1;
  }
  // unwind: put every taken object back into its container (innermost first)
  let j = taken.length;
  while (j > 0) {
    j -= 1;
    // position of the element that produced taken[j]
    items.push(ii(putElem(conts[j], place.path[j], idx[j], taken[j])));
  }
  return Wk { items: items, c: c };
}

function exprMut(cx: Cx, sc: Sc, c: Ctr, m: MutBuiltin, place: Place, args: HExpr[]): V {
  let es = placeIdxExprs(place);
  match (m) {
    MArrPush => {
      es.push(args[0]);
    },
    MArrPop => {}
  }
  const a = lowerArgs(cx, sc, c, es);
  const idx = placeIdx(place, a);
  let items = a.items;
  match (m) {
    MArrPush => {
      const vi = es.length - 1;
      const elemTy = args[0].ty;
      const o = ownOp(a.c, elemTy, a.ops[vi], a.own[vi]);
      items = items.concat(o.items);
      const w = walkPlace(o.c, place, idx, FPush(o.op), place.ty);
      items = items.concat(w.items);
      return vVoid(items, w.c);
    },
    MArrPop => {
      const d = tm(a.c, MRef);
      items.push(d.d);
      const w = walkPlace(d.c, place, idx, FPop(d.id), place.ty);
      items = items.concat(w.items);
      return vOwned(items, d.id, w.c);
    }
  }
}

// ---------------------------------------------------------------- statements

function isLocalExpr(e: HExpr, id: usize): bool {
  return match (e.kind) {
    XLocal(l) => l == id,
    _ => false
  };
}

function stmt(cx: Cx, sc: Sc, c: Ctr, st: HStmt): SR {
  return match (st) {
    HLet(l, init) => stLet(cx, sc, c, l, init),
    HAssign(p, op, v) => stAssign(cx, sc, c, p, op, v),
    HExprStmt(e) => stExpr(cx, sc, c, e),
    HIf(cd, t, el) => stIf(cx, sc, c, cd, t, el),
    HWhile(cd, b) => stWhile(cx, sc, c, cd, b),
    HForOf(l, it, b) => stForOf(cx, sc, c, l, it, b),
    HBreak => stJump(sc, c, sc.brk),
    HContinue => stJump(sc, c, sc.cont),
    HReturn(e) => stReturn(cx, sc, c, e),
    HBlockStmt(b) => stBlock(cx, sc, c, b)
  };
}

function stJump(sc: Sc, c: Ctr, target: usize): SR {
  let items = releaseFrom(sc.vars, sc.loopMark);
  items.push(IxT(TGoto(target)));
  return SR { items: items, c: c, added: None };
}

export function stmtSeq(cx: Cx, sc: Sc, c0: Ctr, stmts: HStmt[]): SS {
  let vars = sc.vars;
  let items: Item[] = [];
  let c = c0;
  for (const st of stmts) {
    const r = stmt(cx, sub(sc, vars), c, st);
    for (const x of r.items) {
      items.push(x);
    }
    c = r.c;
    match (r.added) {
      Some(l) => {
        vars.push(l);
      },
      None => {}
    }
  }
  return SS { items: items, c: c, vars: vars };
}

function block(cx: Cx, sc: Sc, c: Ctr, b: HBlock): BR {
  const mark = sc.vars.length;
  const r = stmtSeq(cx, sc, c, b.stmts);
  let items = r.items;
  for (const x of releaseFrom(r.vars, mark)) {
    items.push(x);
  }
  return BR { items: items, c: r.c };
}

function stBlock(cx: Cx, sc: Sc, c: Ctr, b: HBlock): SR {
  const r = block(cx, sc, c, b);
  return SR { items: r.items, c: r.c, added: None };
}

// `const h = fileOpen(path, mode)` (the std:fs scope API, ADR-0025): the handle local is the destination of
// the IBuiltin itself; a handle is never copied or moved (the verifier rejects ICopy of a handle).
function stLetOpen(cx: Cx, sc: Sc, c: Ctr, l: usize, b: Builtin, args: HExpr[]): SR {
  const a = lowerArgs(cx, sc, c, args);
  let items = a.items;
  items.push(ii(IBuiltin(Some(l), b, a.ops)));
  items = items.concat(releaseOwned(a));
  return SR { items: items, c: a.c, added: None };
}

function isFileOpen(e: HExpr): bool {
  return match (e.kind) {
    XBuiltin(b, _) => match (b) {
      BFileOpen => true,
      BGrantFs => true,
      BGrantProcess => true,
      BGrantStdio => true,
      BGrantClock => true,
      BGrantUnder => true,
      BGrantReadOnly => true,
      BGrantArgsOnly => true,
      BTask(k) => taskOpOpensFrom(k) || taskOpAdopts(k),
      _ => false
    },
    _ => false
  };
}

function stLet(cx: Cx, sc: Sc, c: Ctr, l: usize, init: HExpr): SR {
  if (isHandleTy(cx.fn.locals[l].ty) && isFileOpen(init)) {
    return match (init.kind) {
      XBuiltin(b, args) => stLetOpen(cx, sc, c, l, b, args),
      _ => stLetOpen(cx, sc, c, l, BFileOpen, [])
    };
  }
  const v = expr(cx, sc, c, init);
  let items = v.items;
  const ty = cx.fn.locals[l].ty;
  if (!isRefTy(ty)) {
    items.push(ii(ICopy(l, v.op)));
    return SR { items: items, c: v.c, added: None };
  }
  match (v.k) {
    KO => {
      items.push(ii(IMove(l, localOf(v.op))));
    },
    KS => {
      items.push(ii(ICopy(l, v.op)));
    },
    KB => {
      if (!cx.fn.locals[l].mutable && v.stable) {
        items.push(ii(IBorrow(l, localOf(v.op))));
        return SR { items: items, c: v.c, added: None };
      }
      items.push(ii(IDup(l, v.op)));
    }
  }
  return SR { items: items, c: v.c, added: Some(l) };
}

function stExpr(cx: Cx, sc: Sc, c: Ctr, e: HExpr): SR {
  const v = expr(cx, sc, c, e);
  let items = v.items;
  items = items.concat(discard(v));
  return SR { items: items, c: v.c, added: None };
}

function stIf(cx: Cx, sc: Sc, c0: Ctr, cond: HExpr, th: HBlock, el: Option<HBlock>): SR {
  const cv = expr(cx, sc, c0, cond);
  let items = cv.items;
  const lt = cv.c.lab;
  const lf = cv.c.lab + 1;
  const le = cv.c.lab + 2;
  let c = labs(cv.c, 3);
  const hasElse = el.isSome();
  items.push(IxT(TBranch(cv.op, lt, hasElse ? lf : le)));
  items.push(IxL(lt));
  const t = block(cx, sc, c, th);
  items = items.concat(t.items);
  c = t.c;
  items.push(IxT(TGoto(le)));
  match (el) {
    Some(b) => {
      items.push(IxL(lf));
      const e2 = block(cx, sc, c, b);
      items = items.concat(e2.items);
      c = e2.c;
      items.push(IxT(TGoto(le)));
    },
    None => {}
  }
  items.push(IxL(le));
  return SR { items: items, c: c, added: None };
}

function stWhile(cx: Cx, sc: Sc, c0: Ctr, cond: HExpr, b: HBlock): SR {
  const lhead = c0.lab;
  const lbody = c0.lab + 1;
  const lexit = c0.lab + 2;
  let items: Item[] = [IxL(lhead)];
  const cv = expr(cx, sc, labs(c0, 3), cond);
  items = items.concat(cv.items);
  const alwaysTrue = match (cond.kind) {
    XBool(t) => t,
    _ => false
  };
  if (alwaysTrue) {
    items.push(IxT(TGoto(lbody)));
  } else {
    items.push(IxT(TBranch(cv.op, lbody, lexit)));
  }
  items.push(IxL(lbody));
  const inner = Sc { vars: sc.vars, loopMark: sc.vars.length, brk: lexit, cont: lhead };
  const body = block(cx, inner, cv.c, b);
  items = items.concat(body.items);
  items.push(IxT(TGoto(lhead)));
  items.push(IxL(lexit));
  return SR { items: items, c: body.c, added: None };
}

function stForOf(cx: Cx, sc: Sc, c0: Ctr, local: usize, iter: HExpr, b: HBlock): SR {
  const iv = expr(cx, sc, c0, iter);
  let items = iv.items;
  let c = iv.c;
  let vars = sc.vars;
  let itL = localOf(iv.op);
  let ownedIt = kindIsO(iv.k);
  if (kindIsB(iv.k) && !iv.stable) {
    const d = dupOf(c, iv.op);
    items = items.concat(d.items);
    c = d.c;
    itL = localOf(d.op);
    ownedIt = true;
  }
  if (ownedIt) {
    vars.push(itL);
  }
  const len = tm(c, MUsize);
  items.push(len.d);
  items.push(ii(IBuiltin(Some(len.id), BArrLength, [OLocal(itL)])));
  const ix = tm(len.c, MUsize);
  items.push(ix.d);
  items.push(ii(ICopy(ix.id, OUsize(0))));
  const cmp = tm(ix.c, MBool);
  c = cmp.c;
  items.push(cmp.d);
  const lhead = c.lab;
  const lbody = c.lab + 1;
  const lcont = c.lab + 2;
  const lexit = c.lab + 3;
  c = labs(c, 4);
  items.push(IxL(lhead));
  items.push(ii(IBinary(cmp.id, OpLt, OLocal(ix.id), OLocal(len.id))));
  items.push(IxT(TBranch(OLocal(cmp.id), lbody, lexit)));
  items.push(IxL(lbody));
  items.push(ii(IArrayGet(local, OLocal(itL), OLocal(ix.id))));
  const inner = Sc { vars: vars, loopMark: vars.length, brk: lexit, cont: lcont };
  const r = stmtSeq(cx, inner, c, b.stmts);
  items = items.concat(r.items);
  items = items.concat(releaseFrom(r.vars, vars.length));
  items.push(IxT(TGoto(lcont)));
  items.push(IxL(lcont));
  items.push(ii(IBinary(ix.id, OpAdd, OLocal(ix.id), OUsize(1))));
  items.push(IxT(TGoto(lhead)));
  items.push(IxL(lexit));
  if (ownedIt) {
    items.push(ii(IRelease(itL)));
  }
  return SR { items: items, c: r.c, added: None };
}

function stReturn(cx: Cx, sc: Sc, c: Ctr, e: Option<HExpr>): SR {
  match (e) {
    None => {
      let items = releaseFrom(sc.vars, 0);
      items.push(IxT(TReturn(None)));
      return SR { items: items, c: c, added: None };
    },
    Some(x) => {
      if (isVoidTy(cx.fn.ret)) {
        const v = expr(cx, sc, c, x);
        let items = v.items;
        items = items.concat(discard(v));
        items = items.concat(releaseFrom(sc.vars, 0));
        items.push(IxT(TReturn(None)));
        return SR { items: items, c: v.c, added: None };
      }
      // `return local` moves an owned local out instead of dup + release
      match (x.kind) {
        XLocal(l) => {
          if (isRefTy(x.ty) && inVars(sc.vars, l)) {
            let items = releaseExcept(sc.vars, l);
            items.push(IxT(TReturn(Some(OLocal(l)))));
            return SR { items: items, c: c, added: None };
          }
        },
        _ => {}
      }
      const v = expr(cx, sc, c, x);
      const o = ownOp(v.c, x.ty, v.op, kindIsO(v.k));
      let items = v.items;
      items = items.concat(o.items);
      items = items.concat(releaseFrom(sc.vars, 0));
      items.push(IxT(TReturn(Some(o.op))));
      return SR { items: items, c: o.c, added: None };
    }
  }
}

function stAssign(cx: Cx, sc: Sc, c0: Ctr, place: Place, op0: Option<BinOp>, value0: HExpr): SR {
  const ty = place.ty;
  const root = place.root;
  let op = op0;
  let value = value0;
  // `s = s + x` on a string local is an append
  if (op0.isNone() && isStringTy(ty) && place.path.length == 0) {
    match (value0.kind) {
      XBinary(bo, lhs, rhs) => {
        if (isAdd(bo) && isLocalExpr(lhs, root)) {
          op = Some(OpAdd);
          value = rhs;
        }
      },
      _ => {}
    }
  }
  let es = placeIdxExprs(place);
  es.push(value);
  const nv = es.length - 1;
  const a = lowerArgs(cx, sc, c0, es);
  const idx = placeIdx(place, a);
  let items = a.items;
  let c = a.c;
  let vop = a.ops[nv];
  let vown = a.own[nv];
  const isApp = match (op) {
    Some(o) => isAdd(o) && isStringTy(ty),
    None => false
  };
  if (isApp) {
    // the appended string must not alias the destination
    if (!vown && !isOStr(vop) && a.roots[nv] == root) {
      const d = dupOf(c, vop);
      items = items.concat(d.items);
      c = d.c;
      vop = d.op;
      vown = true;
    }
    if (place.path.length == 0) {
      items.push(ii(IStrAppend(root, vop)));
    } else {
      const w = walkPlace(c, place, idx, FAppend(vop), TyString);
      items = items.concat(w.items);
      c = w.c;
    }
    if (vown) {
      items.push(ii(IRelease(localOf(vop))));
    }
    return SR { items: items, c: c, added: None };
  }
  if (!isRefTy(ty)) {
    if (place.path.length == 0) {
      match (op) {
        None => {
          items.push(ii(ICopy(root, vop)));
        },
        Some(o) => {
          items.push(ii(IBinary(root, o, OLocal(root), vop)));
          items = items.concat(rangeCheck(ty, o, root));
          if (isF32Ty(ty)) {
            items.push(ii(IBuiltin(Some(root), BF32Round, [OLocal(root)])));
          }
        }
      }
    } else {
      const fin: Fin = match (op) {
        None => FSet(vop),
        Some(o) => FArith(o, vop)
      };
      const w = walkPlace(c, place, idx, fin, ty);
      items = items.concat(w.items);
      c = w.c;
    }
    return SR { items: items, c: c, added: None };
  }
  // reference-typed plain assignment
  const o = ownOp(c, ty, vop, vown);
  items = items.concat(o.items);
  c = o.c;
  if (place.path.length == 0) {
    items.push(ii(IRelease(root)));
    if (isOStr(o.op)) {
      items.push(ii(ICopy(root, o.op)));
    } else {
      items.push(ii(IMove(root, localOf(o.op))));
    }
  } else {
    const w = walkPlace(c, place, idx, FSet(o.op), ty);
    items = items.concat(w.items);
    c = w.c;
  }
  return SR { items: items, c: c, added: None };
}

// ---------------------------------------------------------------- functions

export function lowerFunction(prog: Program, fi: usize, lits: Lits): MFunction {
  const f = prog.functions[fi];
  const nHir = f.locals.length;
  const cx = Cx { prog: prog, fn: f, nHir: nHir, lits: lits };
  const sc0 = Sc { vars: [], loopMark: 0, brk: 0, cont: 0 };
  const r = stmtSeq(cx, sc0, Ctr { loc: nHir, lab: 1 }, f.body.stmts);
  let items: Item[] = [IxL(0)];
  items = items.concat(r.items);
  items = items.concat(releaseFrom(r.vars, 0));
  if (isVoidTy(f.ret)) {
    items.push(IxT(TReturn(None)));
  } else {
    items.push(IxT(TTrap("missing return")));
  }
  return finish(f, items, r.c);
}

function allBorrowed(n: usize): bool[] {
  let out: bool[] = [];
  let i: usize = 0;
  while (i < n) {
    out.push(false);
    i += 1;
  }
  return out;
}

function finish(f: Function, items: Item[], c: Ctr): MFunction {
  let locals: MLocal[] = [];
  for (const l of f.locals) {
    locals.push(MLocal { name: l.name, ty: mty(l.ty) });
  }
  let k = f.locals.length;
  while (k < c.loc) {
    locals.push(MLocal { name: "_", ty: MInt });
    k += 1;
  }
  for (const it of items) {
    match (it) {
      IxD(id, t) => {
        locals[id] = MLocal { name: "_", ty: t };
      },
      _ => {}
    }
  }
  return MFunction {
    name: f.name,
    paramCount: f.paramCount,
    paramOwned: allBorrowed(f.paramCount),
    locals: locals,
    ret: mty(f.ret),
    blocks: buildBlocks(items, c.lab)
  };
}
