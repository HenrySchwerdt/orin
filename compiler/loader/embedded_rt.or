 0);\n  out += line(\"load32 zero-extends\", load32(a + 4) == 3735928559);\n  store64(a + 8, 0x0123456789ABCDEF);\n  out += line(\"store64\", load64(a + 8) == 0x0123456789ABCDEF);\n  store64(a + 17, 18446744073709551615);\n  out += line(\"load64 unaligned\", load64(a + 17) == 18446744073709551615 && load8(a + 16) == 0 && load8(a + 25) == 0);\n  store32(a + 33, 1);\n  out += line(\"load32 unaligned\", load32(a + 33) == 1);\n  out += line(\"native order\", load8(a + 8) == load64(a + 8) - (load64(a + 8) / 256) * 256);\n\n  // floats\n  storeF64(a + 40, 1.5);\n  out += line(\"storeF64 / loadF64\", loadF64(a + 40) == 1.5);\n  storeF64(a + 41, -0.25);\n  out += line(\"loadF64 unaligned\", loadF64(a + 41) == -0.25);\n  store64(a + 48, 0x3FF0000000000000);\n  out += line(\"loadF64 bits\", loadF64(a + 48) == 1.0);\n  storeF64(a + 48, 2.0);\n  out += line(\"storeF64 bits\", load64(a + 48) == 0x4000000000000000);\n\n  // memCopy\n  const b = memAlloc(64);\n  memSet(b, 7, 64);\n  memCopy(b + 3, a + 8, 8);\n  out += line(\"memCopy\", load64(b + 3) == 0x0123456789ABCDEF && load8(b + 2) == 7 && load8(b + 11) == 7);\n  memCopy(b, a, 0);\n  out += line(\"memCopy zero length\", load8(b) == 7);\n\n  // memAlloc(0) is a valid block of one byte, never address 0\n  const z = memAlloc(0);\n  out += line(\"memAlloc zero\", z != 0);\n  store8(z, 9);\n  out += line(\"memAlloc zero usable\", load8(z) == 9);\n\n  // addrOf: the object address of a reference; stable, distinct per object, and it leaves the object alone\n  const s = \"core\";\n  const t = \"dore\";\n  const xs: int[] = [1, 2, 3];\n  out += line(\"addrOf string\", addrOf(s) != 0 && addrOf(s) == addrOf(s) && addrOf(s) != addrOf(t));\n  out += line(\"addrOf array\", addrOf(xs) != 0 && addrOf(xs) == addrOf(xs) && addrOf(xs) != addrOf(s));\n  out += line(\"addrOf aligned\", addrOf(s) / 8 * 8 == addrOf(s) && addrOf(xs) / 8 * 8 == addrOf(xs));\n  out += line(\"addrOf leaves value\", s == \"core\" && xs.length == 3 && xs[2] == 3);\n\n  memFree(z);\n  memFree(b);\n  memFree(a);\n  out += line(\"memFree\", true);\n  return out;\n}\n" });
