// error: E0417
// Conformance is nominal: structurally compatible is not enough.
interface Shape {
  area(): int;
}

class Square {
  constructor(public s: int) {}
  area(): int { return this.s * this.s; }
}

function main(): void {
  const s: Shape = new Square(2);
  console.log(s.area().toString());
}
