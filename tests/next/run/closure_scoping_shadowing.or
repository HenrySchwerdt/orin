// Parameters and inner declarations shadow captured names; names resolve lexically.
function main(): void {
  const x = 1;
  const y = 2;
  const f = (x: int) => x + y;
  console.log(f(10).toString());
  const g = (y: int) => {
    const x = y * 100;
    return x;
  };
  console.log(g(3).toString());
  const h = () => {
    const a = x + y;
    const inner = (x: int) => x + a;
    return inner(50);
  };
  console.log(h().toString());
  const k = (n: int) => n + x;
  const x2 = 7;
  const m = (n: int) => k(n) + x2;
  console.log(m(0).toString());
}
