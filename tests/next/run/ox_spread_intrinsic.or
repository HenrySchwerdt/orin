// OX (ADR-0044 §4.3): a spread `{...r}` on an intrinsic element expands the fields of the record `r` into attributes
// at compile time, with every provider rule applied by field name; `Option` attribute values; duplicate names.
import { Html, render } from "std:html";
import ox from "std:html";

type Field = { name: string; size: int; ratio: float; required: bool; };
type Link = { href: string; title: string; };
type Maybe = { id: Option<string>; max: Option<int>; hidden: Option<bool>; };
type Pair = { Id: string; id: string; };

// Functions that print, to show the evaluation order.
function s(tag: string, v: string): string {
  console.log("eval " + tag);
  return v;
}

function f(tag: string): Field {
  console.log("eval " + tag);
  return Field { name: "n-" + tag, size: 3, ratio: 0.5, required: true };
}

function main(): void {
  // string, number and bool fields, in declaration order; the string is escaped
  const fld = Field { name: "a<b>\"&'", size: 42, ratio: 1.5, required: true };
  console.log(render(<input {...fld} type="text" />));
  const off = Field { name: "x", size: -1, ratio: 0.25, required: false };
  console.log(render(<input type="text" {...off} />));

  // a URL field goes through the provider's converter
  const bad = Link { href: "javascript:alert(1)", title: "t\"q" };
  const good = Link { href: "https://example.com/?a=1&b=2", title: "ok" };
  console.log(render(<a {...bad}>x</a>));
  console.log(render(<a {...good}>x</a>));

  // Option fields: None omits the attribute, Some is as if written `f={v}`
  const none = Maybe { id: None, max: None, hidden: None };
  const some = Maybe { id: Some("<i>"), max: Some(7), hidden: Some(true) };
  const somef = Maybe { id: Some("j"), max: Some(8), hidden: Some(false) };
  console.log(render(<p {...none} class="c">x</p>));
  console.log(render(<p {...some}>x</p>));
  console.log(render(<p {...somef}>x</p>));

  // Option written attribute
  const oa: Option<string> = None;
  const ob: Option<string> = Some("b&b");
  const oc: Option<string> = Some("javascript:x");
  console.log(render(<p data-a={oa} data-b={ob}>x</p>));
  console.log(render(<a href={oc}>x</a>));

  // later wins, in both orders; every value is evaluated once, in source order
  console.log(render(<div name={s("w1", "written1")} {...f("sp1")} size={9}>x</div>));
  console.log(render(<div {...f("sp2")} name={s("w2", "written2")} size={9}>x</div>));
  console.log(render(<div {...f("sp3")} {...f("sp4")}>x</div>));
  console.log(render(<div NAME={s("w3", "upper")} {...f("sp5")}>x</div>));
  console.log(render(<div {...f("sp6")} Size={s("w4", "5")}>x</div>));
  const pair = Pair { Id: "big", id: "small" };
  console.log(render(<div {...pair}>x</div>));
}
