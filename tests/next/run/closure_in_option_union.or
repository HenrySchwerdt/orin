type Action = Say(string) | Run(() => string) | Calc(int, (x: int) => int);

function exec(a: Action): string {
  return match (a) {
    Say(s) => s,
    Run(f) => f(),
    Calc(n, f) => f(n).toString(),
  };
}

function lookup(key: string): Option<(x: int) => int> {
  if (key == "inc") {
    return Some(x => x + 1);
  }
  return None;
}

function main(): void {
  const who = "world";
  const actions = [Say("hi"), Run(() => "hello " + who), Calc(6, x => x * 7)];
  for (const a of actions) {
    console.log(exec(a));
  }
  const inc = lookup("inc");
  const missing = lookup("nope");
  console.log(inc.isSome().toString() + missing.isNone().toString());
  match (inc) {
    Some(f) => {
      console.log(f(41).toString());
    },
    None => {},
  }
  const fallback = missing.unwrapOr(x => 0 - x);
  console.log(fallback(5).toString());
  const maybe: Option<() => int> = Some(() => 7);
  console.log(maybe.unwrap()().toString());
}
