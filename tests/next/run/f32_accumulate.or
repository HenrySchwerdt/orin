// f32 accumulation error versus float
function main(): void {
  let s32: f32 = 0.0;
  let s64 = 0.0;
  let i = 0;
  while (i < 1000) {
    s32 += 0.1;
    s64 += 0.1;
    i += 1;
  }
  console.log(s32.toString());
  console.log(s64.toString());
  let arr: f32[] = [];
  arr.push(1.5);
  arr.push(2.25);
  arr[0] += 0.125;
  arr[1] *= 2.0;
  console.log(arr[0].toString() + " " + arr[1].toString());
}
