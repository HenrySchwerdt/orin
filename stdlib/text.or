// std:text -- pure text-layout utilities for compilers, diagnostics, documentation and CLIs.
//
// Orin strings are byte strings (see std:utf8). All indices below count bytes, never
// Unicode code points. Whitespace in this module means ASCII SP, TAB or CR.
// UTF-8 data is preserved byte-for-byte; Unicode segmentation belongs in std:utf8.
// No platform calls, no additional trusted code, no runtime reflection.

function blankLine(line: string): bool {
  let i: usize = 0;
  while (i < line.length) {
    const c = line.charCodeAt(i);
    if (c != 32 && c != 9 && c != 13) {
      return false;
    }
    i += 1;
  }
  return true;
}

function indentation(line: string): usize {
  let i: usize = 0;
  while (i < line.length) {
    const c = line.charCodeAt(i);
    if (c != 32 && c != 9) {
      break;
    }
    i += 1;
  }
  return i;
}

// trimBlankLines: removes outer whitespace-only lines, retaining internal blank lines.
// An empty or whitespace-only input produces "". O(n) time and space.
@Ensures(result.length <= text.length)
export function trimBlankLines(text: string): string {
  const lines = text.split("\n");
  let first: usize = 0;
  while (first < lines.length && blankLine(lines[first])) {
    first += 1;
  }
  let last = lines.length;
  while (last > first && blankLine(lines[last - 1])) {
    last -= 1;
  }
  let kept: string[] = [];
  let i = first;
  while (i < last) {
    kept.push(lines[i]);
    i += 1;
  }
  return kept.join("\n");
}

// dedent: removes the longest common ASCII-space/tab indentation from nonblank lines.
// Blank lines become empty; a trailing newline is preserved. O(n) time and space.
@Ensures(result.length <= text.length)
export function dedent(text: string): string {
  const lines = text.split("\n");
  let common = text.length;
  let found = false;
  for (const line of lines) {
    if (!blankLine(line)) {
      const width = indentation(line);
      if (!found || width < common) {
        common = width;
      }
      found = true;
    }
  }
  if (!found) {
    return text;
  }
  let out: string[] = [];
  for (const line of lines) {
    if (blankLine(line)) {
      out.push("");
    } else {
      out.push(line.substring(common, line.length));
    }
  }
  return out.join("\n");
}

// indentLines: prefix each non-empty line; empty lines and a trailing newline stay empty.
// The prefix may be any byte string. O(n + number_of_lines * prefix.length).
@Ensures(result.length >= text.length)
export function indentLines(text: string, prefix: string): string {
  if (text.length == 0 || prefix.length == 0) {
    return text;
  }
  let out: string[] = [];
  for (const line of text.split("\n")) {
    out.push(line.length == 0 ? "" : prefix + line);
  }
  return out.join("\n");
}

// normalizeNewlines: convert CRLF and lone CR to LF without touching other bytes.
// This is deliberately not a Unicode normalization operation. O(n) time and space.
@Ensures(result.length <= text.length)
export function normalizeNewlines(text: string): string {
  let parts: string[] = [];
  let start: usize = 0;
  let i: usize = 0;
  while (i < text.length) {
    if (text.charCodeAt(i) == 13) {
      parts.push(text.substring(start, i));
      parts.push("\n");
      if (i + 1 < text.length && text.charCodeAt(i + 1) == 10) {
        i += 1;
      }
      i += 1;
      start = i;
    } else {
      i += 1;
    }
  }
  if (start == 0) {
    return text;
  }
  parts.push(text.substring(start, text.length));
  return parts.join("");
}
