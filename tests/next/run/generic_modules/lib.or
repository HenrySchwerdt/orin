export type Pair<A, B> = { first: A; second: B; };
export type Tree<T> = Leaf | Node(Tree<T>, T, Tree<T>);

export function makePair<A, B>(a: A, b: B): Pair<A, B> {
  return Pair { first: a, second: b };
}

export function sizeOf<T>(t: Tree<T>): int {
  return match (t) {
    Leaf => 0,
    Node(l, _, r) => sizeOf(l) + 1 + sizeOf(r),
  };
}

export function id<T>(x: T): T {
  return helper(x);
}

function helper<T>(x: T): T {
  return x;
}
