// Qualified function and type names in the contract verifier: units `a` and `b` both declare the function `mk` and the
// type `Scope` (with different fields and different contracts). A call or a type is resolved in the scope of the unit
// it is written in, so each is checked against its own declaration; a claim that holds only for the other `mk` is
// not VERIFIED. The results of all four units are listed here: the test runs on this file only.
// expect: mk ensures VERIFIED
// expect: mk ensures VERIFIED
// expect: deeper ensures VERIFIED
// expect: count ensures VERIFIED
// expect: useB call-precondition VERIFIED
// expect: useB ensures VERIFIED
// expect: wrongB call-precondition VERIFIED
// expect: wrongB ensures UNKNOWN
// expect: sizeB ensures VERIFIED
// expect: useA ensures VERIFIED
// expect: twice call-precondition VERIFIED
// expect: twice call-precondition VERIFIED
// expect: twice ensures VERIFIED
// expect: main call-precondition VERIFIED
import { mk, Scope, deeper } from "./a";
import { useB, wrongB } from "./c";

@Ensures(result == 8)
function useA(): int {
  return mk(7);
}

@Requires(s.depth >= 0 && s.depth < 998)
@Ensures(result.depth == s.depth + 2)
function twice(s: Scope): Scope {
  return deeper(deeper(s));
}

function main(): void {
  const x = useA() + useB() + wrongB();
  const t = twice(Scope { depth: 1 });
}
