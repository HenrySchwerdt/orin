function main(): void {
  let m = new Map<int, int>();
  let i = 0;
  while (i < 100000) {
    m.set(i * 31, i);
    i += 1;
  }
  console.log(m.size.toString());
  let sum = 0;
  i = 0;
  while (i < 100000) {
    sum += m.get(i * 31).unwrap();
    i += 1;
  }
  console.log(sum.toString());
  console.log(m.has(1).toString());
  i = 0;
  while (i < 100000) {
    m.delete(i * 31);
    i += 2;
  }
  console.log(m.size.toString());
  console.log(m.get(31).unwrap().toString());
  console.log(m.get(0).isNone().toString());
}
