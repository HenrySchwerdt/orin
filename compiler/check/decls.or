// Phase 2: resolution of declarations (aliases, record fields, variant payloads, constants,
// function signatures) and the `main` check. Port of `resolve_decls`, `resolve_const`,
// `check_main` and `resolve_type` from bootstrap/src/checker/mod.rs.

import { Span, Diagnostic, diag } from "../diag";
import { Ident, TypeExpr, TNamed, TArray, EInt, EStr, EBool, EUnary, UNeg, Expr } from "../syntax";
import { Type, FieldDef, RecordDef, UnionDef, VariantDef, Local } from "../hir";
import {
  Env, RecordSrc, UnionSrc, FuncInfo, ConstInfo, ConstLit, LitInt, LitStr, LitBool, EntRecord, EntUnion,
  EntAlias, findType, typeEq, isVoid, showType
} from "./env";

const CYCLE_MSG: string = "type alias is defined in terms of itself";

function inStack(stack: usize[], i: usize): bool {
  for (const s of stack) {
    if (s == i) {
      return true;
    }
  }
  return false;
}

// `stack` holds the aliases currently being resolved (cycle detection).
function aliasType(env: Env, idx: usize, stack: usize[]): Result<Type, Diagnostic> {
  const a = env.aliases[idx];
  if (inStack(stack, idx)) {
    return Err(diag("E0400", a.target.span, CYCLE_MSG));
  }
  let st = stack;
  st.push(idx);
  return resolveTypeIn(env, a.unit, a.target, false, st);
}

function resolveTypeName(env: Env, unit: usize, name: Ident, stack: usize[]): Result<Type, Diagnostic> {
  const found = findType(env.units[unit].scope, name.name);
  return match (found) {
    Some(ent) => match (ent) {
      EntRecord(r) => Ok(TyRecord(r)),
      EntUnion(u) => Ok(TyUnion(u)),
      EntAlias(i) => aliasType(env, i, stack)
    },
    None => Err(diag("E0300", name.span, "unknown type `" + name.name + "`"))
  };
}

function resolveTypeIn(env: Env, unit: usize, te: TypeExpr, voidOk: bool, stack: usize[]): Result<Type, Diagnostic> {
  return match (te.kind) {
    TArray(inner) => resolveArray(env, unit, inner, stack),
    TNamed(name, args) => resolveNamed(env, unit, te, name, args, voidOk, stack)
  };
}

function resolveArray(env: Env, unit: usize, inner: TypeExpr, stack: usize[]): Result<Type, Diagnostic> {
  const t = resolveTypeIn(env, unit, inner, false, stack)?;
  return Ok(TyArray(t));
}

function resolveNamed(
  env: Env,
  unit: usize,
  te: TypeExpr,
  name: Ident,
  args: TypeExpr[],
  voidOk: bool,
  stack: usize[]
): Result<Type, Diagnostic> {
  const n = name.name;
  let b: Option<Type> = None;
  if (n == "int") {
    b = Some(TyInt);
  } else if (n == "usize") {
    b = Some(TyUsize);
  } else if (n == "bool") {
    b = Some(TyBool);
  } else if (n == "string") {
    b = Some(TyString);
  } else if (n == "void") {
    b = Some(TyVoid);
  }
  if (b.isSome()) {
    const bt = b.unwrap();
    if (args.length > 0) {
      return Err(diag("E0400", te.span, "type `" + n + "` takes no type arguments"));
    }
    if (isVoid(bt) && !voidOk) {
      return Err(diag("E0400", te.span, "`void` is only allowed as a return type or as `T` in `Result<T, E>`"));
    }
    return Ok(bt);
  }
  if (n == "Option") {
    if (args.length != 1) {
      return Err(diag("E0400", te.span, "`Option` takes exactly one type argument"));
    }
    const t = resolveTypeIn(env, unit, args[0], false, stack)?;
    return Ok(TyOption(t));
  }
  if (n == "Result") {
    if (args.length != 2) {
      return Err(diag("E0400", te.span, "`Result` takes exactly two type arguments"));
    }
    const t = resolveTypeIn(env, unit, args[0], true, stack)?;
    const e = resolveTypeIn(env, unit, args[1], false, stack)?;
    return Ok(TyResult(t, e));
  }
  if (args.length > 0) {
    return Err(diag("E0408", te.span, "generic types are not supported in Orin-B"));
  }
  return resolveTypeName(env, unit, name, stack);
}

export function resolveType(env: Env, unit: usize, te: TypeExpr, voidOk: bool): Result<Type, Diagnostic> {
  const stack: usize[] = [];
  return resolveTypeIn(env, unit, te, voidOk, stack);
}

export function resolveTypeNameTop(env: Env, unit: usize, name: Ident): Result<Type, Diagnostic> {
  const stack: usize[] = [];
  return resolveTypeName(env, unit, name, stack);
}

// ---------------------------------------------------------------------------
// Constants
// ---------------------------------------------------------------------------

type LitInfo = { lit: ConstLit; ty: Type; neg: bool; };

function constLit(e: Expr): Option<LitInfo> {
  return match (e.kind) {
    EInt(n) => Some(LitInfo { lit: LitInt(n), ty: TyInt, neg: false }),
    EStr(s) => Some(LitInfo { lit: LitStr(s), ty: TyString, neg: false }),
    EBool(b) => Some(LitInfo { lit: LitBool(b), ty: TyBool, neg: false }),
    EUnary(op, inner) => match (op) {
      UNeg => match (inner.kind) {
        EInt(n) => Some(LitInfo { lit: LitInt(-n), ty: TyInt, neg: true }),
        _ => None
      },
      _ => None
    },
    _ => None
  };
}

function resolveConst(env: Env, c: ConstInfo): Result<ConstInfo, Diagnostic> {
  const vspan = c.decl.value.span;
  const li = match (constLit(c.decl.value)) {
    Some(x) => x,
    None => {
      return Err(diag("E0408", vspan, "top-level const initializer must be a literal"));
    }
  };
  let ty = li.ty;
  match (c.decl.ty) {
    Some(te) => {
      ty = resolveType(env, c.unit, te, false)?;
    },
    None => {}
  }
  let ok = typeEq(li.ty, ty);
  if (isIntLike(li.ty) && isUsizeTy(ty)) {
    if (li.neg) {
      return Err(diag("E0400", vspan, "negative integer literal cannot have type `usize`"));
    }
    ok = true;
  }
  if (!ok) {
    return Err(diag("E0400", vspan, "expected `" + showType(env, ty) + "`, found `" + showType(env, li.ty) + "`"));
  }
  return Ok(ConstInfo { unit: c.unit, decl: c.decl, ty: ty, lit: li.lit });
}

function isIntLike(t: Type): bool {
  return match (t) { TyInt => true, _ => false };
}

function isUsizeTy(t: Type): bool {
  return match (t) { TyUsize => true, _ => false };
}

// ---------------------------------------------------------------------------
// Phase 2 driver
// ---------------------------------------------------------------------------

export type Resolved = { env: Env; diags: Diagnostic[]; };

function hasCycleDiag(ds: Diagnostic[]): bool {
  for (const d of ds) {
    if (d.message == CYCLE_MSG) {
      return true;
    }
  }
  return false;
}

function resolveFunc(env: Env, f: FuncInfo, diags: Diagnostic[]): FuncResolved {
  let ds = diags;
  let params: Type[] = [];
  let locals: Local[] = [];
  for (const p of f.decl.params) {
    let dup = false;
    for (const l of locals) {
      if (l.name == p.name.name) {
        dup = true;
      }
    }
    if (dup) {
      ds.push(diag("E0304", p.name.span, "duplicate parameter `" + p.name.name + "`"));
    }
    match (resolveType(env, f.unit, p.ty, false)) {
      Ok(t) => {
        locals.push(Local { name: p.name.name, ty: t, mutable: false });
        params.push(t);
      },
      Err(d) => { ds.push(d); }
    }
  }
  let ret: Type = TyVoid;
  match (f.decl.ret) {
    Some(te) => {
      match (resolveType(env, f.unit, te, true)) {
        Ok(t) => { ret = t; },
        Err(d) => { ds.push(d); }
      }
    },
    None => {}
  }
  const nf = FuncInfo {
    unit: f.unit,
    qname: f.qname,
    decl: f.decl,
    params: params,
    paramLocals: locals,
    ret: ret
  };
  return FuncResolved { func: nf, diags: ds };
}

type FuncResolved = { func: FuncInfo; diags: Diagnostic[]; };

export function findMain(env: Env): Option<usize> {
  let i: usize = 0;
  for (const f of env.funcs) {
    if (f.unit == env.entry && f.decl.name.name == "main") {
      return Some(i);
    }
    i += 1;
  }
  return None;
}

export function resolveDecls(env: Env, recordSrc: RecordSrc[], unionSrc: UnionSrc[]): Resolved {
  let diags: Diagnostic[] = [];
  // Aliases first (also detects cycles among unused aliases).
  let ai: usize = 0;
  while (ai < env.aliases.length) {
    match (aliasType(env, ai, [])) {
      Ok(_) => {},
      Err(d) => {
        if (!(d.message == CYCLE_MSG && hasCycleDiag(diags))) {
          diags.push(d);
        }
      }
    }
    ai += 1;
  }
  // Record fields.
  let records: RecordDef[] = [];
  let ri: usize = 0;
  while (ri < env.records.length) {
    const src = recordSrc[ri];
    let out: FieldDef[] = [];
    for (const f of src.fields) {
      let dup = false;
      for (const o of out) {
        if (o.name == f.name.name) {
          dup = true;
        }
      }
      if (dup) {
        diags.push(diag("E0304", f.name.span, "duplicate field `" + f.name.name + "`"));
      } else {
        match (resolveType(env, src.unit, f.ty, false)) {
          Ok(t) => { out.push(FieldDef { name: f.name.name, ty: t }); },
          Err(d) => { diags.push(d); }
        }
      }
    }
    records.push(RecordDef { name: env.records[ri].name, fields: out });
    ri += 1;
  }
  // Union payloads.
  let unions: UnionDef[] = [];
  let ui: usize = 0;
  while (ui < env.unions.length) {
    const src = unionSrc[ui];
    let vdefs: VariantDef[] = [];
    for (const v of src.variants) {
      let payload: Type[] = [];
      for (const te of v.payload) {
        match (resolveType(env, src.unit, te, false)) {
          Ok(t) => { payload.push(t); },
          Err(d) => { diags.push(d); }
        }
      }
      vdefs.push(VariantDef { name: v.name.name, payload: payload });
    }
    unions.push(UnionDef { name: env.unions[ui].name, variants: vdefs });
    ui += 1;
  }
  // Consts.
  let consts: ConstInfo[] = [];
  for (const c of env.consts) {
    match (resolveConst(env, c)) {
      Ok(r) => { consts.push(r); },
      Err(d) => {
        diags.push(d);
        consts.push(c);
      }
    }
  }
  // Function signatures.
  let funcs: FuncInfo[] = [];
  for (const f of env.funcs) {
    const r = resolveFunc(env, f, diags);
    diags = r.diags;
    funcs.push(r.func);
  }
  const env2 = Env {
    units: env.units,
    aliases: env.aliases,
    records: records,
    unions: unions,
    funcs: funcs,
    consts: consts,
    entry: env.entry
  };
  // `main` check.
  const entryUnit = env2.units[env2.entry];
  match (findMain(env2)) {
    None => {
      diags.push(diag(
        "E0412",
        Span { file: entryUnit.file, start: 0, end: 0 },
        "entry file must define `function main(): void`"
      ));
    },
    Some(i) => {
      const f = env2.funcs[i];
      if (f.decl.params.length > 0 || !isVoid(f.ret)) {
        diags.push(diag(
          "E0412",
          f.decl.name.span,
          "`main` must be declared as `function main(): void` with no parameters"
        ));
      }
    }
  }
  return Resolved { env: env2, diags: diags };
}
