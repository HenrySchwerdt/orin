function showOpt(o: Option<int>): void {
  match (o) {
    Some(v) => { console.log("some " + v.toString()); },
    None => { console.log("none"); },
  }
}

function main(): void {
  const xs = [10, 20, 30];
  console.log(xs[0].toString());
  console.log(xs[2].toString());
  console.log(xs.length.toString());
  const i: usize = 1;
  console.log(xs[i].toString());
  console.log(xs[xs.length - 1].toString());
  showOpt(xs.get(1));
  showOpt(xs.get(3));
  const e: int[] = [];
  console.log(e.length.toString());
  showOpt(e.get(0));
  const names = ["ann", "bob"];
  console.log(names[1]);
  console.log(names[0].length.toString());
  const flags = [true, false];
  console.log(flags[1].toString());
}
