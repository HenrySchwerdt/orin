// Text helpers of the mutation checks: shell quoting, Python-compatible `strip`, `splitlines`, `str.replace(old, new, 1)`,
// `str.count`, `re.findall("^FAIL ", text, re.M)`, `%-12s` / `%2d` padding and the `repr` of a string. Pure functions,
// no I/O (tests/text_test.or).

// True for the ASCII whitespace Python's str.strip() removes from the files of this repository.
export function isSpace(c: int): bool {
  return c == 32 || (c >= 9 && c <= 13);
}

export function strip(s: string): string {
  let a: usize = 0;
  let b = s.length;
  while (a < b && isSpace(s.charCodeAt(a))) {
    a += 1;
  }
  while (b > a && isSpace(s.charCodeAt(b - 1))) {
    b -= 1;
  }
  return s.substring(a, b);
}

// POSIX shell quoting of one word.
export function shq(s: string): string {
  return "'" + s.split("'").join("'\\''") + "'";
}

function isLineBreak(c: int): bool {
  return c == 10 || c == 13 || c == 11 || c == 12 || c == 28 || c == 29 || c == 30;
}

// Python's str.splitlines(): "\n", "\r\n", "\r" (and the other ASCII line boundaries) end a line; no empty last line.
export function splitLines(s: string): string[] {
  let out: string[] = [];
  let start: usize = 0;
  let i: usize = 0;
  while (i < s.length) {
    const c = s.charCodeAt(i);
    if (isLineBreak(c)) {
      out.push(s.substring(start, i));
      if (c == 13 && i + 1 < s.length && s.charCodeAt(i + 1) == 10) {
        i += 1;
      }
      start = i + 1;
    }
    i += 1;
  }
  if (start < s.length) {
    out.push(s.substring(start, s.length));
  }
  return out;
}

// `s.replace(old, new, 1)`: the first occurrence is replaced, `s` itself when there is none (`old` is not empty).
export function replaceFirst(s: string, old: string, rep: string): string {
  const at = s.indexOf(old);
  if (at.isNone()) {
    return s;
  }
  const i = at.unwrap();
  return s.substring(0, i) + rep + s.substring(i + old.length, s.length);
}

// `s.replace(old, new)`: every occurrence (`old` is not empty).
export function replaceAll(s: string, old: string, rep: string): string {
  return s.split(old).join(rep);
}

// `s.count(sub)`: the non-overlapping occurrences of the non-empty `sub`.
export function countOf(s: string, sub: string): usize {
  return s.split(sub).length - 1;
}

// `len(re.findall(r"^<prefix>", s, re.M))`: the lines (separated by "\n") that start with `prefix`.
export function countLinePrefix(s: string, prefix: string): usize {
  let n: usize = 0;
  for (const line of s.split("\n")) {
    if (line.startsWith(prefix)) {
      n += 1;
    }
  }
  return n;
}

// Cuts `s` to at most `n` bytes without splitting a UTF-8 sequence (`s[:n]`).
export function cutBytes(s: string, n: usize): string {
  if (s.length <= n) {
    return s;
  }
  let e = n;
  while (e > 0 && s.charCodeAt(e) >= 128 && s.charCodeAt(e) < 192) {
    e -= 1;
  }
  return s.substring(0, e);
}

// The last `n` bytes of `s`, starting on a character boundary (`s[-n:]`).
export function tailBytes(s: string, n: usize): string {
  if (s.length <= n) {
    return s;
  }
  let b = s.length - n;
  while (b < s.length && s.charCodeAt(b) >= 128 && s.charCodeAt(b) < 192) {
    b += 1;
  }
  return s.substring(b, s.length);
}

// `"%-<n>s" % s`
export function padEnd(s: string, n: usize): string {
  let out = s;
  while (out.length < n) {
    out += " ";
  }
  return out;
}

// `"%<n>s" % s` (`"%2d"` is `padStart(n.toString(), 2)`)
export function padStart(s: string, n: usize): string {
  let out = s;
  while (out.length < n) {
    out = " " + out;
  }
  return out;
}

// Python's repr of one string (for the `%r` of messages).
export function reprStr(x: string): string {
  const escaped = x.split("\\").join("\\\\");
  if (x.includes("'") && !x.includes("\"")) {
    return "\"" + escaped + "\"";
  }
  return "'" + escaped.split("'").join("\\'") + "'";
}
