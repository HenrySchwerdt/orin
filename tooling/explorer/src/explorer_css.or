export const EXPLORER_CSS: string = "/* orin-explorer styles, version 1: added after the orin-reports design system (tooling/reports/theme/report.css), which\n   supplies the tokens (--r-*), the page shell, cards, tables and badges. Source of truth for src/explorer_css.or\n   (tooling/explorer/gen_assets.sh). Every class is prefixed ex-; the SVG graphs carry ex- classes and take their colours\n   from the page, so they follow light and dark mode. */\n:root {\n  --ex-contract: #2a6fd6;\n  --ex-effect: #c9821c;\n  --ex-edge: #9aa1b0;\n  --ex-tint: #eaf1fc;\n  --ex-code: #f3f3ef;\n  --ex-must-bg: #e4ecf8; --ex-must-fg: #1b4c94;\n}\n@media (prefers-color-scheme: dark) {\n  :root {\n    --ex-contract: #6aa4ff;\n    --ex-effect: #e8a948;\n    --ex-edge: #5d6577;\n    --ex-tint: #18263d;\n    --ex-code: #16181d;\n    --ex-must-bg: #14264a; --ex-must-fg: #a9caff;\n  }\n}\nbody { font-size: 0.97rem; }\n.r-sidebar { border-right: 1px solid var(--r-line); padding-right: 1rem; margin-right: -1rem; }\n.ex-nav a { display: flex; justify-content: space-between; align-items: baseline; gap: 0.5rem; }\n.ex-nav-on { background: var(--ex-tint); font-weight: 600; color: var(--r-accent) !important; }\n.ex-nav-count { font-size: 0.72rem; color: var(--r-ink-2); font-variant-numeric: tabular-nums; }\n.ex-nav-head { margin: 1.4rem 0 0.4rem; padding: 0 0.65rem; font-size: 0.72rem; font-weight: 650; text-transform: uppercase; letter-spacing: 0.08em; color: var(--r-ink-2); }\n.ex-nav-mods a { padding-top: 0.18rem; padding-bottom: 0.18rem; font-size: 0.86rem; }\n.ex-main { padding-bottom: 2rem; }\n.ex-head { padding: 2.25rem 0 0.5rem; }\n.ex-eyebrow { margin: 0 0 0.35rem; font-size: 0.8rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.07em; color: var(--r-ink-2); }\n.ex-eyebrow a { color: var(--r-ink-2); text-decoration: none; }\n.ex-eyebrow a:hover { color: var(--r-accent); text-decoration: underline; }\n.ex-title { margin: 0; font-size: clamp(1.7rem, 1.3rem + 1.6vw, 2.35rem); line-height: 1.15; letter-spacing: -0.015em; overflow-wrap: anywhere; }\n.ex-lead { margin: 0.5rem 0 0; color: var(--r-ink-2); max-width: 70ch; overflow-wrap: anywhere; }\n.ex-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; margin: 0.9rem 0 0; }\n.ex-section { margin-top: 2.6rem; scroll-margin-top: 1rem; }\n.ex-section > h2 { margin: 0 0 0.35rem; font-size: 1.25rem; line-height: 1.25; letter-spacing: -0.005em; }\n.ex-section h3 { margin: 0 0 0.5rem; font-size: 0.82rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--r-ink-2); }\n.ex-intro { margin: 0 0 1rem; color: var(--r-ink-2); max-width: 75ch; }\n.ex-empty, .ex-muted { color: var(--r-ink-2); }\n.ex-more { margin: 0.6rem 0 0; }\n.ex-two { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.5rem; margin-top: 1rem; align-items: start; }\n.ex-table { margin-top: 0.5rem; }\n.ex-table .ex-sig-cell code { display: block; max-width: 44ch; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--r-ink-2); }\n.ex-mod { color: var(--r-ink-2); white-space: nowrap; }\n.ex-effects { font-family: var(--r-mono); font-size: 0.84em; color: var(--r-ink-2); }\n.ex-stage-what { display: block; font-weight: 400; font-size: 0.82rem; color: var(--r-ink-2); white-space: normal; max-width: 34ch; }\n.ex-sym { font-family: var(--r-mono); font-size: 0.9em; font-weight: 600; text-decoration: none; color: var(--r-accent); overflow-wrap: anywhere; }\na.ex-sym:hover { text-decoration: underline; }\n.ex-gone { color: var(--r-ink-2); font-weight: 400; }\n.ex-loc { font-family: var(--r-mono); font-size: 0.8rem; color: var(--r-ink-2); }\n.ex-flag { display: inline-block; padding: 0 0.4rem; border: 1px solid var(--r-line); border-radius: 5px; font-family: var(--r-sans); font-size: 0.68rem; font-weight: 600; line-height: 1.5; color: var(--r-ink-2); vertical-align: 0.05em; }\n.ex-kind { display: inline-block; padding: 0 0.5rem; border-radius: 5px; font-size: 0.7rem; font-weight: 650; line-height: 1.6; letter-spacing: 0.02em; background: var(--r-info-bg); color: var(--r-info-fg); }\n.ex-k-function, .ex-k-method { background: var(--r-improvement-bg); color: var(--r-improvement-fg); }\n.ex-k-class, .ex-k-interface { background: var(--r-unproven-bg); color: var(--r-unproven-fg); }\n.ex-k-record, .ex-k-union, .ex-k-alias, .ex-k-variant { background: var(--r-passed-bg); color: var(--r-passed-fg); }\n.ex-k-const, .ex-k-field { background: var(--r-regression-bg); color: var(--r-regression-fg); }\n.ex-evb { display: inline-block; padding: 0 0.5rem; border-radius: 999px; font-size: 0.7rem; font-weight: 700; line-height: 1.6; letter-spacing: 0.04em; cursor: help; }\n.ex-evb-must { background: var(--ex-must-bg); color: var(--ex-must-fg); }\n.ex-evb-may { background: var(--r-regression-bg); color: var(--r-regression-fg); }\n.ex-evb-unknown { background: var(--r-unproven-bg); color: var(--r-unproven-fg); }\n.ex-sig, .ex-code { margin: 1rem 0 0; padding: 0.85rem 1.1rem; overflow-x: auto; background: var(--ex-code); border: 1px solid var(--r-line); border-radius: var(--r-radius); font-family: var(--r-mono); font-size: 0.88rem; line-height: 1.5; }\n.ex-sig code, .ex-code code { font-size: inherit; white-space: pre; }\n.ex-doc { max-width: 72ch; margin-top: 0.75rem; }\n.ex-doc p { margin: 0 0 0.8rem; }\n.ex-doc code, .ex-contracts code { padding: 0.05rem 0.3rem; background: var(--ex-code); border-radius: 4px; }\n.ex-tags { margin: 1rem 0 0; display: grid; gap: 0.5rem; }\n.ex-tags > div { display: grid; grid-template-columns: 9rem minmax(0, 1fr); gap: 0.75rem; }\n.ex-tags dt { font-family: var(--r-mono); font-size: 0.85rem; color: var(--r-ink-2); }\n.ex-tags dd { margin: 0; }\n.ex-contracts { margin: 0.5rem 0 0; padding: 0; list-style: none; display: grid; gap: 0.4rem; }\n.ex-contracts li { display: flex; gap: 0.75rem; align-items: baseline; padding: 0.5rem 0.8rem; background: var(--r-surface); border: 1px solid var(--r-line); border-left: 3px solid var(--ex-contract); border-radius: 8px; }\n.ex-contract-kind { min-width: 5.5rem; font-size: 0.72rem; font-weight: 650; text-transform: uppercase; letter-spacing: 0.06em; color: var(--ex-contract); }\n.ex-chips { display: flex; flex-wrap: wrap; gap: 0.4rem; margin: 0; padding: 0; list-style: none; }\n.ex-chip { display: inline-block; padding: 0.1rem 0.65rem; border: 1px solid var(--r-line); border-radius: 999px; background: var(--r-surface); font-family: var(--r-mono); font-size: 0.82rem; text-decoration: none; color: var(--r-ink); }\n.ex-chip:hover { border-color: var(--r-accent); color: var(--r-accent); }\n.ex-figure { margin: 1rem 0 0; background: var(--r-surface); border: 1px solid var(--r-line); border-radius: var(--r-radius); box-shadow: 0 1px 2px rgba(16, 20, 30, 0.05); overflow: hidden; }\n.ex-scroll { overflow: auto; max-height: 78vh; padding: 0.5rem; cursor: grab; }\n.ex-scroll.ex-grab { cursor: grabbing; user-select: none; }\n.ex-figure figcaption { padding: 0.55rem 0.9rem; border-top: 1px solid var(--r-line); font-size: 0.82rem; color: var(--r-ink-2); }\n.ex-graph-svg { display: block; max-width: 100%; height: auto; margin: 0 auto; font-family: var(--r-sans); }\n.ex-node { cursor: pointer; }\n.ex-node-box { fill: var(--r-surface); stroke: var(--r-line); stroke-width: 1.3; }\n.ex-node:hover .ex-node-box, a.ex-node:focus-visible .ex-node-box { stroke: var(--r-accent); stroke-width: 2; }\n.ex-node-bar { stroke: none; }\n.ex-acc-plain { fill: var(--r-line); }\n.ex-acc-contract { fill: var(--ex-contract); }\n.ex-acc-effect { fill: var(--ex-effect); }\n.ex-node-off { opacity: 0.5; cursor: default; }\n.ex-t { fill: var(--r-ink); }\n.ex-t2 { fill: var(--r-ink-2); }\n.ex-pill-effect { fill: var(--r-regression-bg); stroke: var(--r-regression-fg); stroke-width: 1; }\n.ex-pill-t { fill: var(--r-regression-fg); }\n.ex-edge-line { fill: none; stroke: var(--ex-edge); stroke-linecap: round; }\n.ex-edge-head { fill: var(--ex-edge); stroke: none; }\n.ex-edge:hover .ex-edge-line { stroke: var(--r-accent); stroke-width: 2.6px; }\n.ex-edge:hover .ex-edge-head { fill: var(--r-accent); }\n.ex-ev-may .ex-edge-line { stroke: var(--ex-effect); }\n.ex-ev-may .ex-edge-head { fill: var(--ex-effect); }\n.ex-ev-unknown .ex-edge-line { stroke: var(--r-unproven-fg); }\n.ex-ev-unknown .ex-edge-head { fill: var(--r-unproven-fg); }\n.ex-box-focus { fill: var(--ex-tint); stroke: var(--r-accent); stroke-width: 2; }\n.ex-box-effect { fill: var(--r-regression-bg); stroke: var(--r-regression-fg); }\n.ex-box-unknown { stroke-dasharray: 4 3; }\n.ex-legend { display: flex; flex-wrap: wrap; gap: 0.4rem 1.5rem; margin: 1rem 0 0; padding: 0; list-style: none; font-size: 0.85rem; color: var(--r-ink-2); }\n.ex-legend li { display: flex; align-items: center; gap: 0.5rem; }\n.ex-sw { display: inline-block; width: 0.35rem; height: 1.1rem; border-radius: 2px; }\n.ex-sw-contract { background: var(--ex-contract); }\n.ex-sw-effect { background: var(--ex-effect); }\n.ex-sw-line { overflow: visible; }\n.ex-filter { display: flex; flex-wrap: wrap; gap: 0.6rem; align-items: center; margin: 1.25rem 0 0.25rem; }\n.ex-filter[hidden] { display: none; }\n.ex-filter input, .ex-filter select { font: inherit; padding: 0.45rem 0.7rem; border: 1px solid var(--r-line); border-radius: 8px; background: var(--r-surface); color: var(--r-ink); }\n.ex-filter input { flex: 1 1 18rem; max-width: 30rem; }\n.ex-count { font-size: 0.85rem; color: var(--r-ink-2); }\n.ex-paths { margin: 0; padding: 0; list-style: none; display: grid; gap: 0.25rem; }\n.ex-paths code { font-size: 0.82rem; }\ntr[hidden] { display: none; }\n.ex-section .r-table-wrap + .r-table-wrap { margin-top: 1rem; }\n.ex-btn { float: right; margin: -0.15rem 0 0 1rem; padding: 0.15rem 0.7rem; font: inherit; font-size: 0.8rem; border: 1px solid var(--r-line); border-radius: 999px; background: var(--r-surface); color: var(--r-ink); cursor: pointer; }\n.ex-btn:hover { border-color: var(--r-accent); color: var(--r-accent); }\n.ex-figure-wide .ex-graph-svg { max-width: none; margin: 0; }\n.r-sidebar .ex-nav a { display: flex; }\n.ex-eyebrow .ex-sym { font-family: inherit; font-size: inherit; font-weight: inherit; color: inherit; }\n.ex-eyebrow a.ex-sym:hover { color: var(--r-accent); }\n.ex-table caption { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }\n.ex-stack { display: grid; gap: 1.25rem; margin-top: 1rem; }\n@media (max-width: 60rem) {\n  .r-sidebar { border-right: 0; margin-right: 0; padding-right: 0; }\n  .ex-nav-mods { display: flex; flex-wrap: wrap; }\n  .ex-two { grid-template-columns: minmax(0, 1fr); }\n  .ex-tags > div { grid-template-columns: minmax(0, 1fr); gap: 0; }\n}\n@media print {\n  .ex-scroll { max-height: none; overflow: visible; }\n  .ex-filter { display: none; }\n}\n";
