import { Shape, area, Point, origin } from "./geometry";

function describe(s: Shape): string {
  return match (s) {
    Circle(r) => "circle " + r.toString(),
    Rect(w, h) => "rect " + w.toString() + "x" + h.toString(),
    Empty => "empty",
  };
}

function main(): void {
  const shapes: Shape[] = [Circle(2), Rect(3, 4), Empty];
  for (const s of shapes) {
    console.log(describe(s) + " area " + area(s).toString());
  }
  const p = Point { x: 1, y: 2 };
  const o = origin();
  console.log(p.x.toString() + "," + p.y.toString());
  console.log(o.x.toString() + "," + o.y.toString());
}
