  store32(a + 4, 0x1DEADBEEF);\n  out += line(\"store32 low word\", load32(a + 4) == 0xDEADBEEF && load32(a + 8) == 0);\n  out += line(\"load32 zero-extends\", load32(a + 4) == 3735928559);\n  store64(a + 8, 0x0123456789ABCDEF);\n  out += line(\"store64\", load64(a + 8) == 0x0123456789ABCDEF);\n  store64(a + 17, 18446744073709551615);\n  out += line(\"load64 unaligned\", load64(a + 17) == 18446744073709551615 && load8(a + 16) == 0 && load8(a + 25) == 0);\n  store32(a + 33, 1);\n  out += line(\"load32 unaligned\", load32(a + 33) == 1);\n  out += line(\"native order\", load8(a + 8) == load64(a + 8) - (load64(a + 8) / 256) * 256);\n\n  // floats\n  storeF64(a + 40, 1.5);\n  out += line(\"storeF64 / loadF64\", loadF64(a + 40) == 1.5);\n  storeF64(a + 41, -0.25);\n  out += line(\"loadF64 unaligned\", loadF64(a + 41) == -0.25);\n  store64(a + 48, 0x3FF0000000000000);\n  out += line(\"loadF64 bits\", loadF64(a + 48) == 1.0);\n  storeF64(a + 48, 2.0);\n  out += line(\"storeF64 bits\", load64(a + 48) == 0x4000000000000000);\n\n  // memCopy\n  const b = memAlloc(64);\n  memSet(b, 7, 64);\n  memCopy(b + 3, a + 8, 8);\n  out += line(\"memCopy\", load64(b + 3) == 0x0123456789ABCDEF && load8(b + 2) == 7 && load8(b + 11) == 7);\n  memCopy(b, a, 0);\n  out += line(\"memCopy zero length\", load8(b) == 7);\n\n  // memAlloc(0) is a valid block of one byte, never address 0\n  const z = memAlloc(0);\n  out += line(\"memAlloc zero\", z != 0);\n  store8(z, 9);\n  out += line(\"memAlloc zero usable\", load8(z) == 9);\n\n  // addrOf: the object address of a reference; stable, distinct per object, and it leaves the object alone\n  const s = \"core\";\n  const t = \"dore\";\n  const xs: int[] = [1, 2, 3];\n  out += line(\"addrOf string\", addrOf(s) != 0 && addrOf(s) == addrOf(s) && addrOf(s) != addrOf(t));\n  out += line(\"addrOf array\", addrOf(xs) != 0 && addrOf(xs) == addrOf(xs) && addrOf(xs) != addrOf(s));\n  out += line(\"addrOf aligned\", addrOf(s) / 8 * 8 == addrOf(s) && addrOf(xs) / 8 * 8 == addrOf(xs));\n  out += line(\"addrOf leaves value\", s == \"core\" && xs.length == 3 && xs[2] == 3);\n\n  // addrOf needs the real object (ADR-0052 Addendum A, rule 2): the optimiser must not unbox the record or scalar-replace the\n  // array, so the layout is there: string len@16 data@32, array len@16 items@40 (a pointer to the buffer), struct nslots@16 slots@32\n  const u = \"wxyz\";\n  const pr = Pair { x: 7, y: 9 };\n  const ys: int[] = [4, 5, 6];\n  out += line(\"addrOf string layout\", load64(addrOf(u) + 16) == 4 && load8(addrOf(u) + 32) == 119 && load8(addrOf(u) + 35) == 122);\n  out += line(\"addrOf array layout\", load64(addrOf(ys) + 16) == 3 && load64(load64(addrOf(ys) + 40)) == 4 && load64(load64(addrOf(ys) + 40) + 16) == 6);\n  out += line(\"addrOf record layout\", load64(addrOf(pr) + 16) == 2 && load64(addrOf(pr) + 32) == 7 && load64(addrOf(pr) + 40) == 9);\n\n  // bit operations on usize\n  out += line(\"and\", and(0xF0F0, 0xFF00) == 0xF000 && and(18446744073709551615, 5) == 5);\n  out += line(\"or\", or(0xF0F0, 0x0F0F) == 0xFFFF && or(0, 0) == 0);\n  out += line(\"xor\", xor(0xFF, 0x0F) == 0xF0 && xor(18446744073709551615, 18446744073709551615) == 0);\n  out += line(\"shl\", shl(1, 3) == 8 && shl(1, 63) == 9223372036854775808 && shl(3, 63) == 9223372036854775808);\n  out += line(\"shl 64 or more\", shl(1, 64) == 0 && shl(18446744073709551615, 200) == 0);\n  out += line(\"shr\", shr(256, 4) == 16 && shr(18446744073709551615, 63) == 1 && shr(5, 0) == 5);\n  out += line(\"shr 64 or more\", shr(18446744073709551615, 64) == 0 && shr(1, 1000) == 0);\n  out += line(\"shr is logical\", shr(9223372036854775808, 62) == 2);\n  const refmask: usize = 5;\n  out += line(\"bit test\", and(shr(refmask, 2), 1) == 1 && and(shr(refmask, 1), 1) == 0);\n\n  // expect is the identity on its first argument\n  const yes = a != 0;\n  out += line(\"expect\", expect(yes, true) && !expect(!yes, true) && expect(yes, false) && !expect(!yes, false));\n\n  // cfg: 0 or 1 for