// GENERATED by tools/embed_prelude.py from stdlib/ -- do not edit; run the script after changing the sources.

import { SourceFile } from "../diag";

export function embeddedStdlibFiles(): SourceFile[] {
  let out: SourceFile[] = [];
  out.push(SourceFile { path: "$stdlib/graph.or", text: "// std:graph -- Graph<T> with generational, graph-tagged node ids (spec 06 \"Cyclic graph\", ADR-0016).\n//\n// Cyclic structures are not expressible with owning values (no owning cycles), so a graph owner\n// holds all nodes and edges are checked, non-owning `GraphId<T>` handles:\n//   * Each id carries the graph's tag, the slot index and the slot's generation. Removing a node\n//     bumps its slot's generation, so an id that outlived its node is STALE and every operation\n//     rejects it with `Err(StaleId)`; an id minted by a graph with a different tag is `Err(ForeignId)`.\n//     (An id whose index lies beyond the graph is also `ForeignId`.)\n//   * Value semantics: a Graph is an ordinary value. Operations that change it return a new Graph\n//     (`Added<T>`, or `Result<Graph<T>, GraphError>`); the argument graph is not modified, so a\n//     copy taken earlier keeps seeing its old nodes (an id removed in the newer version is still\n//     valid in the older one: ids identify a node of one *tag*, generations track its history).\n//   * The tag is supplied by the caller: `newGraph(tag)`. Use a different tag per logical graph.\n//     TODO(after global state): an automatic unique tag once the language has a process-wide counter.\n//   * Edges are directed and stored in the source slot as (index, generation) pairs. Removing a node\n//     does not touch edges pointing at it: they become dangling and `neighbors` silently skips them\n//     (an edge only counts while both ends are live with the generations recorded at addEdge time).\n//     Duplicate edges are allowed and reported once per addEdge call.\n//   * Complexity: Orin copies arrays on write (until ADR-0010), so every changing operation is\n//     O(nodes) time/allocation; `get`, `contains`, `neighbors` are O(1) / O(out-degree) reads.\n//\n// TODO(after floats/map): `Map`-based index, edge weights.\n\n// Opaque handle of a node of a graph with value type T. `T` is only a phantom parameter that ties\n// the id to its graph's value type; construct ids only through `add`.\nexport type GraphId<T> = { tag: int; index: usize; gen: int; };\n\n// StaleId: the node was removed (the slot has a newer generation or is empty).\n// ForeignId: the id belongs to another graph (different tag) or does not name a slot at all.\nexport type GraphError = StaleId | ForeignId;\n\ntype Edge = { index: usize; gen: int; };\n\ntype Slot<T> = { gen: int; value: Option<T>; edges: Edge[]; };\n\nexport type Graph<T> = { tag: int; slots: Slot<T>[]; live: usize; };\n\nexport type Added<T> = { graph: Graph<T>; id: GraphId<T>; };\n\n// graphErrorMessage(e: GraphError): string -- \"stale graph id\" / \"foreign graph id\". O(1).\nexport function graphErrorMessage(e: GraphError): string {\n  return match (e) {\n    StaleId => \"stale graph id\",\n    ForeignId => \"foreign graph id\"\n  };\n}\n\n// newGraph<T>(tag: int): Graph<T>\n// An empty graph. Ids minted by it are accepted only by graphs with the same `tag`. O(1).\nexport function newGraph<T>(tag: int): Graph<T> {\n  return Graph { tag: tag, slots: [], live: 0 };\n}\n\n// size<T>(g: Graph<T>): usize -- number of live nodes. O(1).\nexport function size<T>(g: Graph<T>): usize {\n  return g.live;\n}\n\n// Validates `id` against `g`: Ok(slot index) when the node is live.\nfunction check<T>(g: Graph<T>, id: GraphId<T>): Result<usize, GraphError> {\n  if (id.tag != g.tag || id.index >= g.slots.length) {\n    return Err(ForeignId);\n  }\n  const s = g.slots[id.index];\n  if (s.gen != id.gen || s.value.isNone()) {\n    return Err(StaleId);\n  }\n  return Ok(id.index);\n}\n\n// contains<T>(g: Graph<T>, id: GraphId<T>): bool -- true when `id` names a live node of `g`. O(1).\nexport function contains<T>(g: Graph<T>, id: GraphId<T>): bool {\n  return check(g, id).isOk();\n}\n\n// add<T>(g: Graph<T>, value: T): Added<T>\n// Adds a node (reusing a freed slot with a bumped generation when one exists) and returns the new\n// graph together with the node's id: `const r = add(g, v); g = r.graph; const id = r.id;`. Never\n// fails. O(nodes).\nexport function add<T>(g: Graph<T>, value: T): Added<T> {\n  let slots = g.slots;\n  let i: usize = 0;\n  while (i < slots.length) {\n    if (slots[i].value.isNone()) {\n      // Free slot: its generation was already bumped by `remove`.\n      const gen = slots[i].gen;\n      let out: Slot<T>[] = [];\n      let k: usize = 0;\n      while (k < slots.length) {\n        out.push(k == i ? Slot { gen: gen, value: Some(value), edges: [] } : slots[k]);\n        k += 1;\n      }\n      return Added { graph: Graph { tag: g.tag, slots: out, live: g.live + 1 },\n        id: GraphId { tag: g.tag, index: i, gen: gen } };\n    }\n    i += 1;\n  }\n  slots.push(Slot { gen: 0, value: Some(value), edges: [] });\n  return Added { graph: Graph { tag: g.tag, slots: slots, live: g.live + 1 },\n    id: GraphId { tag: g.tag, index: slots.length - 1, gen: 0 } };\n}\n\n// get<T>(g: Graph<T>, id: GraphId<T>): Result<T, GraphError>\n// The value of a live node. Errors: StaleId (removed node), ForeignId (other graph). O(1).\nexport function get<T>(g: Graph<T>, id: GraphId<T>): Result<T, GraphError> {\n  const i = check(g, id)?;\n  return Ok(g.slots[i].value.unwrap());\n}\n\nfunction replaceSlot<T>(g: Graph<T>, i: usize, s: Slot<T>, live: usize): Graph<T> {\n  let out: Slot<T>[] = [];\n  let k: usize = 0;\n  while (k < g.slots.length) {\n    out.push(k == i ? s : g.slots[k]);\n    k += 1;\n  }\n  return Graph { tag: g.tag, slots: out, live: live };\n}\n\n// set<T>(g: Graph<T>, id: GraphId<T>, value: T): Result<Graph<T>, GraphError>\n// Replaces a live node's value (its edges and id stay). Errors as `get`. O(nodes).\nexport function set<T>(g: Graph<T>, id: GraphId<T>, value: T): Result<Graph<T>, GraphError> {\n  const i = check(g, id)?;\n  const old = g.slots[i];\n  return Ok(replaceSlot(g, i, Slot { gen: old.gen, value: Some(value), edges: old.edges }, g.live));\n}\n\n// remove<T>(g: Graph<T>, id: GraphId<T>): Result<Graph<T>, GraphError>\n// Removes a live node and its outgoing edges, bumps the slot generation (invalidating `id` and every\n// copy of it) and frees the slot for reuse. Edges of other nodes that pointed at it dangle and are\n// skipped by `neighbors`. Errors as `get`. O(nodes).\nexport function remove<T>(g: Graph<T>, id: GraphId<T>): Result<Graph<T>, GraphError> {\n  const i = check(g, id)?;\n  const old = g.slots[i];\n  let gone: Option<T> = None;\n  return Ok(replaceSlot(g, i, Slot { gen: old.gen + 1, value: gone, edges: [] }, g.live - 1));\n}\n\n// addEdge<T>(g: Graph<T>, a: GraphId<T>, b: GraphId<T>): Result<Graph<T>, GraphError>\n// Adds the directed edge a -> b (self loops and duplicates allowed). Both ids must be live in\n// `g`; the first failing id's error is returned (`a` is checked first). O(nodes).\nexport function addEdge<T>(g: Graph<T>, a: GraphId<T>, b: GraphId<T>): Result<Graph<T>, GraphError> {\n  const i = check(g, a)?;\n  const j = check(g, b)?;\n  const old = g.slots[i];\n  let edges = old.edges;\n  edges.push(Edge { index: j, gen: b.gen });\n  return Ok(replaceSlot(g, i, Slot { gen: old.gen, value: old.value, edges: edges }, g.live));\n}\n\n// neighbors<T>(g: Graph<T>, id: GraphId<T>): Result<GraphId<T>[], GraphError>\n// The targets of the outgoing edges of a live node, in insertion order, skipping dangling edges\n// (removed targets). Errors as `get`. O(out-degree).\nexport function neighbors<T>(g: Graph<T>, id: GraphId<T>): Result<GraphId<T>[], GraphError> {\n  const i = check(g, id)?;\n  let out: GraphId<T>[] = [];\n  for (const e of g.slots[i].edges) {\n    const t = g.slots[e.index];\n    if (t.gen == e.gen && t.value.isSome()) {\n      out.push(GraphId { tag: g.tag, index: e.index, gen: e.gen });\n    }\n  }\n  return Ok(out);\n}\n\n// ids<T>(g: Graph<T>): GraphId<T>[] -- ids of all live nodes in slot order. O(nodes).\nexport function ids<T>(g: Graph<T>): GraphId<T>[] {\n  let out: GraphId<T>[] = [];\n  let i: usize = 0;\n  while (i < g.slots.length) {\n    if (g.slots[i].value.isSome()) {\n      out.push(GraphId { tag: g.tag, index: i, gen: g.slots[i].gen });\n    }\n    i += 1;\n  }\n  return out;\n}\n" });
  out.push(SourceFile { path: "$stdlib/json.or", text: "// std:json -- JSON values, parser and printers (spec 08, ADR-0016).\n//\n// Data model: `Json` is a plain union (no classes), so values copy like any other value and are\n// inspected with `match`. Numbers are INTEGERS ONLY (`JNum(int)`) until floats land; see the\n// TODO(after floats/map) notes. Objects are ordered field lists (`JField[]`), not maps.\n//\n//   * parse accepts RFC 8259 JSON with these restrictions: numbers must be integers in the\n//     range -9223372036854775807 .. 9223372036854775807; a fraction or exponent (`1.5`, `1e3`)\n//     is a JsonError (\"floats are not supported yet\"). Nesting deeper than 200 levels is an error.\n//   * Strings are Orin byte strings holding UTF-8. `\\uXXXX` escapes decode to UTF-8; a surrogate\n//     pair gives one 4-byte sequence, a lone surrogate gives U+FFFD. Raw control characters\n//     (< 0x20) inside strings are rejected. Bytes >= 0x80 are copied through unchanged (the\n//     input is not validated as UTF-8).\n//   * Duplicate object keys are kept (in order); `get` returns the LAST occurrence (JS semantics).\n//   * Errors carry the byte offset plus a 1-based line and column (column counts bytes after the\n//     last \"\\n\"; \"\\r\\n\" ends a line at \"\\n\").\n//   * stringify is compact and deterministic; `pretty` indents with spaces. Object field order is\n//     insertion order. Strings escape `\"`, `\\`, \\b \\f \\n \\r \\t and other control characters as\n//     \\u00XX; all other bytes pass through unchanged.\n//\n// TODO(after floats/map): JNum(float) / separate JFloat, `parse<T>` is post-1.0 (ADR-0016).\n\nexport type Json = JNull | JBool(bool) | JNum(int) | JStr(string) | JArr(Json[]) | JObj(JField[]);\n\nexport type JField = { key: string; value: Json; };\n\n// Parse failure: `message` describes the problem, `offset` is the 0-based byte offset where it was\n// detected (== text length for \"unexpected end of input\"), `line`/`column` are 1-based.\nexport type JsonError = { message: string; offset: usize; line: usize; column: usize; };\n\n// ---- constructors -------------------------------------------------------------------------\n\n// field(key: string, value: Json): JField -- builds an object field. O(1).\nexport function field(key: string, value: Json): JField {\n  return JField { key: key, value: value };\n}\n\n// ---- parser -------------------------------------------------------------------------------\n\ntype PErr = { msg: string; at: usize; };\ntype PRes = { v: Json; pos: usize; };\ntype SRes = { text: string; pos: usize; };\ntype NRes = { n: int; pos: usize; };\n\nconst MAX_DEPTH: int = 200;\n\nfunction fail(msg: string, at: usize): PErr {\n  return PErr { msg: msg, at: at };\n}\n\nfunction isWs(c: int): bool {\n  return c == 32 || c == 9 || c == 10 || c == 13;\n}\n\nfunction skipWs(s: string, start: usize): usize {\n  let i = start;\n  while (i < s.length && isWs(s.charCodeAt(i))) {\n    i += 1;\n  }\n  return i;\n}\n\nfunction hexVal(c: int): int {\n  if (c >= 48 && c <= 57) {\n    return c - 48;\n  }\n  if (c >= 97 && c <= 102) {\n    return c - 87;\n  }\n  if (c >= 65 && c <= 70) {\n    return c - 55;\n  }\n  return -1;\n}\n\n// Four hex digits at `at`, or -1.\nfunction hex4(s: string, at: usize): int {\n  if (at + 4 > s.length) {\n    return -1;\n  }\n  let v = 0;\n  let k: usize = 0;\n  while (k < 4) {\n    const h = hexVal(s.charCodeAt(at + k));\n    if (h < 0) {\n      return -1;\n    }\n    v = v * 16 + h;\n    k += 1;\n  }\n  return v;\n}\n\nfunction utf8(cp: int): string {\n  if (cp < 128) {\n    return String.fromCharCode(cp);\n  }\n  if (cp < 2048) {\n    return String.fromCharCode(192 + cp / 64) + String.fromCharCode(128 + cp % 64);\n  }\n  if (cp < 65536) {\n    return String.fromCharCode(224 + cp / 4096) + String.fromCharCode(128 + (cp / 64) % 64)\n      + String.fromCharCode(128 + cp % 64);\n  }\n  return String.fromCharCode(240 + cp / 262144) + String.fromCharCode(128 + (cp / 4096) % 64)\n    + String.fromCharCode(128 + (cp / 64) % 64) + String.fromCharCode(128 + cp % 64);\n}\n\n// `s[start]` is the opening quote.\nfunction parseString(s: string, start: usize): Result<SRes, PErr> {\n  let parts: string[] = [];\n  let i = start + 1;\n  let runStart = i;\n  while (true) {\n    if (i >= s.length) {\n      return Err(fail(\"unterminated string\", start));\n    }\n    const c = s.charCodeAt(i);\n    if (c == 34) {\n      if (i > runStart) {\n        parts.push(s.substring(runStart, i));\n      }\n      return Ok(SRes { text: parts.join(\"\"), pos: i + 1 });\n    }\n    if (c < 32) {\n      return Err(fail(\"control character in string\", i));\n    }\n    if (c != 92) {\n      i += 1;\n      continue;\n    }\n    if (i > runStart) {\n      parts.push(s.substring(runStart, i));\n    }\n    if (i + 1 >= s.length) {\n      return Err(fail(\"unterminated escape\", i));\n    }\n    const e = s.charCodeAt(i + 1);\n    i += 2;\n    if (e == 34) {\n      parts.push(\"\\\"\");\n    } else if (e == 92) {\n      parts.push(\"\\\\\");\n    } else if (e == 47) {\n      parts.push(\"/\");\n    } else if (e == 98) {\n      parts.push(String.fromCharCode(8));\n    } else if (e == 102) {\n      parts.push(String.fromCharCode(12));\n    } else if (e == 110) {\n      parts.push(\"\\n\");\n    } else if (e == 114) {\n      parts.push(\"\\r\");\n    } else if (e == 116) {\n      parts.push(\"\\t\");\n    } else if (e == 117) {\n      const u = hex4(s, i);\n      if (u < 0) {\n        return Err(fail(\"invalid \\\\u escape\", i - 2));\n      }\n      i += 4;\n      let cp = u;\n      if (u >= 55296 && u <= 56319) {\n        // High surrogate: needs a following \\uDC00..\\uDFFF.\n        let lo = -1;\n        if (i + 1 < s.length && s.charCodeAt(i) == 92 && s.charCodeAt(i + 1) == 117) {\n          lo = hex4(s, i + 2);\n        }\n        if (lo >= 56320 && lo <= 57343) {\n          cp = 65536 + (u - 55296) * 1024 + (lo - 56320);\n          i += 6;\n        } else {\n          cp = 65533;\n        }\n      } else if (u >= 56320 && u <= 57343) {\n        cp = 65533;\n      }\n      parts.push(utf8(cp));\n    } else {\n      return Err(fail(\"invalid escape\", i - 2));\n    }\n    runStart = i;\n  }\n  return Err(fail(\"unreachable\", i));\n}\n\nfunction isDigit(c: int): bool {\n  return c >= 48 && c <= 57;\n}\n\nconst INT_MAX: int = 9223372036854775807;\n\nfunction parseNumber(s: string, start: usize): Result<NRes, PErr> {\n  let i = start;\n  let neg = false;\n  if (s.charCodeAt(i) == 45) {\n    neg = true;\n    i += 1;\n  }\n  const ds = i;\n  while (i < s.length && isDigit(s.charCodeAt(i))) {\n    i += 1;\n  }\n  if (i == ds) {\n    return Err(fail(\"invalid number\", start));\n  }\n  if (i - ds > 1 && s.charCodeAt(ds) == 48) {\n    return Err(fail(\"leading zero in number\", ds));\n  }\n  let v = 0;\n  let k = ds;\n  while (k < i) {\n    const d = s.charCodeAt(k) - 48;\n    if (v > (INT_MAX - d) / 10) {\n      return Err(fail(\"integer out of range\", start));\n    }\n    v = v * 10 + d;\n    k += 1;\n  }\n  if (i < s.length && (s.charCodeAt(i) == 46 || s.charCodeAt(i) == 101 || s.charCodeAt(i) == 69)) {\n    return Err(fail(\"floats are not supported yet (integers only)\", i));\n  }\n  if (neg) {\n    v = 0 - v;\n  }\n  return Ok(NRes { n: v, pos: i });\n}\n\nfunction expectLit(s: string, at: usize, lit: string): bool {\n  if (at + lit.length > s.length) {\n    return false;\n  }\n  return s.substring(at, at + lit.length) == lit;\n}\n\nfunction parseValue(s: string, start: usize, depth: int): Result<PRes, PErr> {\n  const i = skipWs(s, start);\n  if (i >= s.length) {\n    return Err(fail(\"unexpected end of input\", i));\n  }\n  if (depth > MAX_DEPTH) {\n    return Err(fail(\"nesting too deep\", i));\n  }\n  const c = s.charCodeAt(i);\n  if (c == 34) {\n    const r = parseString(s, i)?;\n    return Ok(PRes { v: JStr(r.text), pos: r.pos });\n  }\n  if (c == 123) {\n    return parseObject(s, i, depth);\n  }\n  if (c == 91) {\n    return parseArray(s, i, depth);\n  }\n  if (c == 45 || isDigit(c)) {\n    const r = parseNumber(s, i)?;\n    return Ok(PRes { v: JNum(r.n), pos: r.pos });\n  }\n  if (expectLit(s, i, \"true\")) {\n    return Ok(PRes { v: JBool(true), pos: i + 4 });\n  }\n  if (expectLit(s, i, \"false\")) {\n    return Ok(PRes { v: JBool(false), pos: i + 5 });\n  }\n  if (expectLit(s, i, \"null\")) {\n    return Ok(PRes { v: JNull, pos: i + 4 });\n  }\n  return Err(fail(\"unexpected character\", i));\n}\n\nfunction parseArray(s: string, start: usize, depth: int): Result<PRes, PErr> {\n  let items: Json[] = [];\n  let i = skipWs(s, start + 1);\n  if (i < s.length && s.charCodeAt(i) == 93) {\n    return Ok(PRes { v: JArr(items), pos: i + 1 });\n  }\n  while (true) {\n    const r = parseValue(s, i, depth + 1)?;\n    items.push(r.v);\n    i = skipWs(s, r.pos);\n    if (i >= s.length) {\n      return Err(fail(\"unexpected end of input, expected `,` or `]`\", i));\n    }\n    const c = s.charCodeAt(i);\n    if (c == 93) {\n      return Ok(PRes { v: JArr(items), pos: i + 1 });\n    }\n    if (c != 44) {\n      return Err(fail(\"expected `,` or `]`\", i));\n    }\n    i += 1;\n  }\n  return Err(fail(\"unreachable\", i));\n}\n\nfunction parseObject(s: string, start: usize, depth: int): Result<PRes, PErr> {\n  let fields: JField[] = [];\n  let i = skipWs(s, start + 1);\n  if (i < s.length && s.charCodeAt(i) == 125) {\n    return Ok(PRes { v: JObj(fields), pos: i + 1 });\n  }\n  while (true) {\n    i = skipWs(s, i);\n    if (i >= s.length) {\n      return Err(fail(\"unexpected end of input, expected string key\", i));\n    }\n    if (s.charCodeAt(i) != 34) {\n      return Err(fail(\"expected string key\", i));\n    }\n    const k = parseString(s, i)?;\n    i = skipWs(s, k.pos);\n    if (i >= s.length) {\n      return Err(fail(\"unexpected end of input, expected `:`\", i));\n    }\n    if (s.charCodeAt(i) != 58) {\n      return Err(fail(\"expected `:`\", i));\n    }\n    const r = parseValue(s, i + 1, depth + 1)?;\n    fields.push(JField { key: k.text, value: r.v });\n    i = skipWs(s, r.pos);\n    if (i >= s.length) {\n      return Err(fail(\"unexpected end of input, expected `,` or `}`\", i));\n    }\n    const c = s.charCodeAt(i);\n    if (c == 125) {\n      return Ok(PRes { v: JObj(fields), pos: i + 1 });\n    }\n    if (c != 44) {\n      return Err(fail(\"expected `,` or `}`\", i));\n    }\n    i += 1;\n  }\n  return Err(fail(\"unreachable\", i));\n}\n\n// 1-based line and column of byte `offset` in `s`.\nfunction locate(s: string, offset: usize): JsonError {\n  let line: usize = 1;\n  let lineStart: usize = 0;\n  let i: usize = 0;\n  while (i < offset && i < s.length) {\n    if (s.charCodeAt(i) == 10) {\n      line += 1;\n      lineStart = i + 1;\n    }\n    i += 1;\n  }\n  return JsonError { message: \"\", offset: offset, line: line, column: offset - lineStart + 1 };\n}\n\nfunction toError(s: string, e: PErr): JsonError {\n  const l = locate(s, e.at);\n  return JsonError { message: e.msg, offset: e.at, line: l.line, column: l.column };\n}\n\n// parse(text: string): Result<Json, JsonError>\n// Parses one JSON document (surrounding whitespace allowed, trailing characters are an error:\n// \"trailing characters\"). Errors: syntax errors, unsupported floats, integer overflow, nesting\n// deeper than 200, each with offset/line/column. Complexity: O(n) time and allocation (plus\n// O(n) to locate the line/column of an error).\nexport function parse(text: string): Result<Json, JsonError> {\n  const r = parseValue(text, 0, 0);\n  if (r.isErr()) {\n    return Err(toError(text, r.unwrapErr()));\n  }\n  const ok = r.unwrap();\n  const end = skipWs(text, ok.pos);\n  if (end < text.length) {\n    return Err(toError(text, fail(\"trailing characters\", end)));\n  }\n  return Ok(ok.v);\n}\n\n// formatError(e: JsonError): string -- \"line L, column C: message\". O(1).\nexport function formatError(e: JsonError): string {\n  return \"line \" + e.line.toString() + \", column \" + e.column.toString() + \": \" + e.message;\n}\n\n// ---- printers -----------------------------------------------------------------------------\n\nfunction hexDigit(n: int): string {\n  if (n < 10) {\n    return String.fromCharCode(48 + n);\n  }\n  return String.fromCharCode(87 + n);\n}\n\n// quote(s: string): string -- `s` as a JSON string literal with escapes. O(n).\nexport function quote(s: string): string {\n  let parts: string[] = [\"\\\"\"];\n  let runStart: usize = 0;\n  let i: usize = 0;\n  while (i < s.length) {\n    const c = s.charCodeAt(i);\n    if (c == 34 || c == 92 || c < 32) {\n      if (i > runStart) {\n        parts.push(s.substring(runStart, i));\n      }\n      if (c == 34) {\n        parts.push(\"\\\\\\\"\");\n      } else if (c == 92) {\n        parts.push(\"\\\\\\\\\");\n      } else if (c == 10) {\n        parts.push(\"\\\\n\");\n      } else if (c == 13) {\n        parts.push(\"\\\\r\");\n      } else if (c == 9) {\n        parts.push(\"\\\\t\");\n      } else if (c == 8) {\n        parts.push(\"\\\\b\");\n      } else if (c == 12) {\n        parts.push(\"\\\\f\");\n      } else {\n        parts.push(\"\\\\u00\" + hexDigit(c / 16) + hexDigit(c % 16));\n      }\n      runStart = i + 1;\n    }\n    i += 1;\n  }\n  if (s.length > runStart) {\n    parts.push(s.substring(runStart, s.length));\n  }\n  parts.push(\"\\\"\");\n  return parts.join(\"\");\n}\n\nfunction emit(j: Json, out: string[]): string[] {\n  let o = out;\n  match (j) {\n    JNull => { o.push(\"null\"); },\n    JBool(b) => { o.push(b ? \"true\" : \"false\"); },\n    JNum(n) => { o.push(n.toString()); },\n    JStr(s) => { o.push(quote(s)); },\n    JArr(a) => {\n      o.push(\"[\");\n      let i: usize = 0;\n      while (i < a.length) {\n        if (i > 0) {\n          o.push(\",\");\n        }\n        o = emit(a[i], o);\n        i += 1;\n      }\n      o.push(\"]\");\n    },\n    JObj(fs) => {\n      o.push(\"{\");\n      let i: usize = 0;\n      while (i < fs.length) {\n        if (i > 0) {\n          o.push(\",\");\n        }\n        o.push(quote(fs[i].key));\n        o.push(\":\");\n        o = emit(fs[i].value, o);\n        i += 1;\n      }\n      o.push(\"}\");\n    }\n  }\n  return o;\n}\n\n// stringify(j: Json): string\n// Compact deterministic serialization (no whitespace). Never fails. O(n) in the size of `j`.\n// parse(stringify(j)) == j for every j whose integers are in range.\nexport function stringify(j: Json): string {\n  const out: string[] = [];\n  return emit(j, out).join(\"\");\n}\n\nfunction spaces(n: usize): string {\n  let parts: string[] = [];\n  let i: usize = 0;\n  while (i < n) {\n    parts.push(\" \");\n    i += 1;\n  }\n  return parts.join(\"\");\n}\n\nfunction emitPretty(j: Json, indent: usize, level: usize, out: string[]): string[] {\n  let o = out;\n  match (j) {\n    JArr(a) => {\n      if (a.length == 0) {\n        o.push(\"[]\");\n      } else {\n        o.push(\"[\\n\");\n        let i: usize = 0;\n        while (i < a.length) {\n          o.push(spaces(indent * (level + 1)));\n          o = emitPretty(a[i], indent, level + 1, o);\n          o.push(i + 1 < a.length ? \",\\n\" : \"\\n\");\n          i += 1;\n        }\n        o.push(spaces(indent * level));\n        o.push(\"]\");\n      }\n    },\n    JObj(fs) => {\n      if (fs.length == 0) {\n        o.push(\"{}\");\n      } else {\n        o.push(\"{\\n\");\n        let i: usize = 0;\n        while (i < fs.length) {\n          o.push(spaces(indent * (level + 1)));\n          o.push(quote(fs[i].key));\n          o.push(\": \");\n          o = emitPretty(fs[i].value, indent, level + 1, o);\n          o.push(i + 1 < fs.length ? \",\\n\" : \"\\n\");\n          i += 1;\n        }\n        o.push(spaces(indent * level));\n        o.push(\"}\");\n      }\n    },\n    _ => { o = emit(j, o); }\n  }\n  return o;\n}\n\n// pretty(j: Json, indent: usize): string\n// Multi-line serialization: one array element / object field per line, `indent` spaces per\n// nesting level, \": \" after keys, empty containers as `[]` / `{}`, no trailing newline.\n// `pretty(j, 0)` still puts every element on its own line (use `stringify` for compact output).\n// Never fails. O(n) in the size of `j` (plus the indentation written).\nexport function pretty(j: Json, indent: usize): string {\n  const out: string[] = [];\n  return emitPretty(j, indent, 0, out).join(\"\");\n}\n\n// ---- accessors ----------------------------------------------------------------------------\n// All accessors are total: a wrong kind or a missing key gives None. They never trap.\n\n// get(j: Json, key: string): Option<Json>\n// The value of field `key` when `j` is an object (the LAST field with that key), else None.\n// O(fields).\nexport function get(j: Json, key: string): Option<Json> {\n  return match (j) {\n    JObj(fs) => lastField(fs, key),\n    _ => None\n  };\n}\n\nfunction lastField(fs: JField[], key: string): Option<Json> {\n  let i = fs.length;\n  while (i > 0) {\n    i -= 1;\n    if (fs[i].key == key) {\n      return Some(fs[i].value);\n    }\n  }\n  return None;\n}\n\n// at(j: Json, index: usize): Option<Json> -- element `index` of an array, else None. O(1).\nexport function at(j: Json, index: usize): Option<Json> {\n  return match (j) {\n    JArr(a) => index < a.length ? Some(a[index]) : None,\n    _ => None\n  };\n}\n\n// path(j: Json, keys: string[]): Option<Json> -- follows object keys: path(j, [\"a\", \"b\"]) is\n// get(get(j, \"a\"), \"b\"); an empty `keys` gives Some(j). O(sum of fields visited).\nexport function path(j: Json, keys: string[]): Option<Json> {\n  let cur = j;\n  for (const k of keys) {\n    const f = get(cur, k);\n    if (f.isNone()) {\n      return None;\n    }\n    cur = f.unwrap();\n  }\n  return Some(cur);\n}\n\n// asString(j: Json): Option<string> -- Some for JStr. O(1).\nexport function asString(j: Json): Option<string> {\n  return match (j) {\n    JStr(s) => Some(s),\n    _ => None\n  };\n}\n\n// asInt(j: Json): Option<int> -- Some for JNum. O(1).\nexport function asInt(j: Json): Option<int> {\n  return match (j) {\n    JNum(n) => Some(n),\n    _ => None\n  };\n}\n\n// asBool(j: Json): Option<bool> -- Some for JBool. O(1).\nexport function asBool(j: Json): Option<bool> {\n  return match (j) {\n    JBool(b) => Some(b),\n    _ => None\n  };\n}\n\n// asArray(j: Json): Option<Json[]> -- Some for JArr. O(1) (the array is copied lazily).\nexport function asArray(j: Json): Option<Json[]> {\n  return match (j) {\n    JArr(a) => Some(a),\n    _ => None\n  };\n}\n\n// asObject(j: Json): Option<JField[]> -- Some for JObj, in insertion order. O(1).\nexport function asObject(j: Json): Option<JField[]> {\n  return match (j) {\n    JObj(fs) => Some(fs),\n    _ => None\n  };\n}\n\n// isNull(j: Json): bool -- true for JNull. O(1).\nexport function isNull(j: Json): bool {\n  return match (j) {\n    JNull => true,\n    _ => false\n  };\n}\n\n// keys(j: Json): string[] -- the field names of an object in order (duplicates included);\n// [] for any non-object. O(fields).\nexport function keys(j: Json): string[] {\n  let out: string[] = [];\n  match (j) {\n    JObj(fs) => {\n      for (const f of fs) {\n        out.push(f.key);\n      }\n    },\n    _ => {}\n  }\n  return out;\n}\n\n// getString / getInt / getBool / getArray: `get` followed by the matching `as*`; None when the\n// key is missing or has another kind. O(fields).\nexport function getString(j: Json, key: string): Option<string> {\n  const f = get(j, key);\n  if (f.isNone()) {\n    return None;\n  }\n  return asString(f.unwrap());\n}\n\nexport function getInt(j: Json, key: string): Option<int> {\n  const f = get(j, key);\n  if (f.isNone()) {\n    return None;\n  }\n  return asInt(f.unwrap());\n}\n\nexport function getBool(j: Json, key: string): Option<bool> {\n  const f = get(j, key);\n  if (f.isNone()) {\n    return None;\n  }\n  return asBool(f.unwrap());\n}\n\nexport function getArray(j: Json, key: string): Option<Json[]> {\n  const f = get(j, key);\n  if (f.isNone()) {\n    return None;\n  }\n  return asArray(f.unwrap());\n}\n" });
  out.push(SourceFile { path: "$stdlib/path.or", text: "// std:path -- lexical POSIX path utilities (spec 08, ADR-0016).\n//\n// Semantics (documented once, for every function):\n//   * Paths are byte strings with \"/\" as the only separator (POSIX). There is no Windows\n//     handling, no filesystem access, no symlink resolution and no current directory: every\n//     function is pure and lexical. Results follow Node's `path.posix` where Node has an\n//     equivalent function.\n//   * A path is absolute when it starts with \"/\".\n//   * Every function is total (never traps, never returns Result); odd input such as \"\" or\n//     \"///\" is handled as documented per function.\n//   * Complexity: all functions are O(n) in the total length of their input and allocate O(n).\n\n// Non-empty segments of `p` in order (no \".\" / \"..\" processing).\nfunction splitSegments(p: string): string[] {\n  let out: string[] = [];\n  for (const s of p.split(\"/\")) {\n    if (s.length > 0) {\n      out.push(s);\n    }\n  }\n  return out;\n}\n\n// isAbsolute(p: string): bool\n// True when `p` starts with \"/\". `isAbsolute(\"\")` is false.\nexport function isAbsolute(p: string): bool {\n  return p.length > 0 && p.charCodeAt(0) == 47;\n}\n\n// normalize(p: string): string\n// Resolves \".\" and \"..\" segments lexically and collapses repeated separators.\n//   * \"\" normalizes to \".\"; a relative path that reduces to nothing is \".\" (\"a/..\" -> \".\").\n//   * \"..\" that would climb above the root of an absolute path is dropped (\"/..\" -> \"/\");\n//     in a relative path leading \"..\" segments are kept (\"../a\", \"a/../..\" -> \"..\").\n//   * A trailing separator is preserved (\"a//b/\" -> \"a/b/\", \"./\" -> \"./\"); the root is \"/\".\n// Examples: normalize(\"/a/./b/../c\") == \"/a/c\"; normalize(\"a//b\") == \"a/b\".\nexport function normalize(p: string): string {\n  if (p.length == 0) {\n    return \".\";\n  }\n  const abs = isAbsolute(p);\n  const trailing = p.charCodeAt(p.length - 1) == 47;\n  let out: string[] = [];\n  for (const s of splitSegments(p)) {\n    if (s == \".\") {\n      continue;\n    }\n    if (s == \"..\") {\n      if (out.length > 0 && out[out.length - 1] != \"..\") {\n        out.pop();\n      } else if (!abs) {\n        out.push(\"..\");\n      }\n      continue;\n    }\n    out.push(s);\n  }\n  const body = out.join(\"/\");\n  if (abs) {\n    if (body.length == 0) {\n      return \"/\";\n    }\n    return trailing ? \"/\" + body + \"/\" : \"/\" + body;\n  }\n  if (body.length == 0) {\n    return trailing ? \"./\" : \".\";\n  }\n  return trailing ? body + \"/\" : body;\n}\n\n// join(parts: string[]): string\n// Joins the non-empty `parts` with \"/\" and normalizes the result (see `normalize`). An empty\n// list, or a list of empty strings, gives \".\". Like Node, a later absolute part does NOT reset\n// the path: join([\"a\", \"/b\"]) == \"a/b\" (use `resolveAgainst` to get reset semantics).\n// Examples: join([\"/a\", \"b\", \"../c\"]) == \"/a/c\"; join([\"a\", \"\", \"b/\"]) == \"a/b/\".\nexport function join(parts: string[]): string {\n  let kept: string[] = [];\n  for (const q of parts) {\n    if (q.length > 0) {\n      kept.push(q);\n    }\n  }\n  if (kept.length == 0) {\n    return \".\";\n  }\n  return normalize(kept.join(\"/\"));\n}\n\n// resolveAgainst(base: string, p: string): string\n// `p` normalized when `p` is absolute, otherwise join([base, p]). Pure: there is no implicit\n// current directory, so `base` must be supplied by the caller.\nexport function resolveAgainst(base: string, p: string): string {\n  if (isAbsolute(p)) {\n    return normalize(p);\n  }\n  return join([base, p]);\n}\n\n// End offset (exclusive) of `p` after dropping trailing \"/\" characters; 0 when `p` is all \"/\".\nfunction endWithoutSlashes(p: string): usize {\n  let e = p.length;\n  while (e > 0 && p.charCodeAt(e - 1) == 47) {\n    e -= 1;\n  }\n  return e;\n}\n\n// Start offset of the last segment of p[0..e) (the position after the last \"/\" before e).\nfunction lastSegmentStart(p: string, e: usize): usize {\n  let i = e;\n  while (i > 0 && p.charCodeAt(i - 1) != 47) {\n    i -= 1;\n  }\n  return i;\n}\n\n// dirname(p: string): string\n// The directory part of `p`, ignoring trailing separators; the path is NOT normalized.\n//   dirname(\"/a/b/c\") == \"/a/b\"; dirname(\"/a/b/\") == \"/a\"; dirname(\"a\") == \".\"; dirname(\"\") == \".\";\n//   dirname(\"/a\") == \"/\"; dirname(\"/\") == \"/\"; dirname(\"a//b\") == \"a\"; dirname(\"a/./b\") == \"a/.\".\nexport function dirname(p: string): string {\n  const e = endWithoutSlashes(p);\n  if (e == 0) {\n    return p.length > 0 ? \"/\" : \".\";\n  }\n  const s = lastSegmentStart(p, e);\n  if (s == 0) {\n    return \".\";\n  }\n  const d = endWithoutSlashes(p.substring(0, s));\n  if (d == 0) {\n    return \"/\";\n  }\n  return p.substring(0, d);\n}\n\n// basename(p: string): string\n// The last segment of `p`, ignoring trailing separators. basename(\"/a/b.txt\") == \"b.txt\";\n// basename(\"a/b/\") == \"b\"; basename(\"/\") == \"\"; basename(\"\") == \"\".\nexport function basename(p: string): string {\n  const e = endWithoutSlashes(p);\n  if (e == 0) {\n    return \"\";\n  }\n  return p.substring(lastSegmentStart(p, e), e);\n}\n\n// extension(p: string): string\n// The extension of the basename including the leading dot, or \"\" when there is none (Node's\n// `extname`): extension(\"a/b.txt\") == \".txt\"; extension(\"a.tar.gz\") == \".gz\";\n// extension(\".bashrc\") == \"\"; extension(\"a.\") == \".\"; extension(\"a\") == \"\"; extension(\"..\") == \"\".\nexport function extension(p: string): string {\n  const b = basename(p);\n  let i = b.length;\n  while (i > 0) {\n    if (b.charCodeAt(i - 1) == 46) {\n      // i-1 is the last dot; a dot at offset 0 (\".bashrc\") or the name \"..\" has no extension.\n      if (i == 1 || b == \"..\") {\n        return \"\";\n      }\n      return b.substring(i - 1, b.length);\n    }\n    i -= 1;\n  }\n  return \"\";\n}\n\n// stem(p: string): string\n// The basename without its extension: stem(\"a/b.txt\") == \"b\"; stem(\".bashrc\") == \".bashrc\";\n// stem(\"a.tar.gz\") == \"a.tar\".\nexport function stem(p: string): string {\n  const b = basename(p);\n  const x = extension(p);\n  return b.substring(0, b.length - x.length);\n}\n\n// withExtension(p: string, ext: string): string\n// Replaces the extension of the basename of `p` by `ext` (which must include the dot, or be \"\"\n// to remove it). Trailing separators are dropped: withExtension(\"a/b.txt\", \".md\") == \"a/b.md\".\n// For \"\" or \"/\" (no basename) the result is `p + ext`.\nexport function withExtension(p: string, ext: string): string {\n  const e = endWithoutSlashes(p);\n  if (e == 0) {\n    return p + ext;\n  }\n  const x = extension(p);\n  return p.substring(0, e - x.length) + ext;\n}\n" });
  out.push(SourceFile { path: "$stdlib/time.or", text: "// std:time -- wall clock, durations with explicit units and UTC calendar conversion (spec 08).\n//\n// The only runtime primitive is `nowMillis` (builtin `std:clock`, runtime function\n// orin_time_now_millis); everything else is pure Orin. All quantities are `int` milliseconds\n// unless the name says otherwise (\"explicit units\": there is no unit-less number in this API).\n//   * Calendar functions use the proleptic Gregorian calendar in UTC; there are no time zones,\n//     no leap seconds. Instants are milliseconds since 1970-01-01T00:00:00Z (negative before).\n//   * Arithmetic on ints traps on overflow like everywhere in Orin; values here stay far from\n//     the limits for any date in years -292000000 .. 292000000.\n//\n// TODO(after floats/map): fractional seconds (`seconds(1.5)`), `sleep` (needs a second runtime\n// primitive), time zones / locale formatting.\n\n// nowMillis(): int\n// Wall-clock time in milliseconds since the Unix epoch (CLOCK_REALTIME). Not monotonic: the system\n// clock may jump. Cannot fail. O(1), no allocation.\nexport { nowMillis } from \"std:clock\";\n\n// A span of time in whole milliseconds (may be negative: a difference of two instants).\nexport type Duration = { millis: int; };\n\n// ---- durations ----------------------------------------------------------------------------\n\n// milliseconds / seconds / minutes / hours / days (n: int): Duration -- n units as a Duration. O(1).\nexport function milliseconds(n: int): Duration {\n  return Duration { millis: n };\n}\n\nexport function seconds(n: int): Duration {\n  return Duration { millis: n * 1000 };\n}\n\nexport function minutes(n: int): Duration {\n  return Duration { millis: n * 60000 };\n}\n\nexport function hours(n: int): Duration {\n  return Duration { millis: n * 3600000 };\n}\n\nexport function days(n: int): Duration {\n  return Duration { millis: n * 86400000 };\n}\n\n// toMillis(d: Duration): int -- the span in milliseconds. O(1).\nexport function toMillis(d: Duration): int {\n  return d.millis;\n}\n\n// toSeconds(d: Duration): int -- whole seconds, truncated toward zero (1999 ms -> 1). O(1).\nexport function toSeconds(d: Duration): int {\n  return d.millis / 1000;\n}\n\n// addDuration(a: Duration, b: Duration): Duration -- sum. O(1).\nexport function addDuration(a: Duration, b: Duration): Duration {\n  return Duration { millis: a.millis + b.millis };\n}\n\n// between(start: int, end: int): Duration -- end - start for two instants (milliseconds). O(1).\nexport function between(start: int, end: int): Duration {\n  return Duration { millis: end - start };\n}\n\n// plus(instant: int, d: Duration): int -- the instant `d` after `instant`. O(1).\nexport function plus(instant: int, d: Duration): int {\n  return instant + d.millis;\n}\n\n// formatDuration(d: Duration): string\n// Human-readable \"1d 2h 3m 4s 5ms\" with zero components omitted, \"0ms\" for zero and a leading\n// \"-\" for negative spans: formatDuration(milliseconds(3723005)) == \"1h 2m 3s 5ms\". O(1).\nexport function formatDuration(d: Duration): string {\n  if (d.millis == 0) {\n    return \"0ms\";\n  }\n  const neg = d.millis < 0;\n  let rest = neg ? 0 - d.millis : d.millis;\n  let parts: string[] = [];\n  const dd = rest / 86400000;\n  rest = rest % 86400000;\n  const hh = rest / 3600000;\n  rest = rest % 3600000;\n  const mm = rest / 60000;\n  rest = rest % 60000;\n  const ss = rest / 1000;\n  const ms = rest % 1000;\n  if (dd > 0) {\n    parts.push(dd.toString() + \"d\");\n  }\n  if (hh > 0) {\n    parts.push(hh.toString() + \"h\");\n  }\n  if (mm > 0) {\n    parts.push(mm.toString() + \"m\");\n  }\n  if (ss > 0) {\n    parts.push(ss.toString() + \"s\");\n  }\n  if (ms > 0) {\n    parts.push(ms.toString() + \"ms\");\n  }\n  const body = parts.join(\" \");\n  return neg ? \"-\" + body : body;\n}\n\n// ---- calendar (UTC) -----------------------------------------------------------------------\n\n// Broken-down UTC time. month 1..12, day 1..31, hour 0..23, minute 0..59, second 0..59,\n// millisecond 0..999, weekday 0 = Sunday .. 6 = Saturday.\nexport type DateTime = {\n  year: int; month: int; day: int;\n  hour: int; minute: int; second: int; millisecond: int;\n  weekday: int;\n};\n\nfunction floorDiv(a: int, b: int): int {\n  const q = a / b;\n  if (a % b != 0 && (a < 0) != (b < 0)) {\n    return q - 1;\n  }\n  return q;\n}\n\n// Days since 1970-01-01 of the civil date y-m-d (Howard Hinnant's days_from_civil).\nfunction daysFromCivil(y0: int, m: int, d: int): int {\n  const y = m <= 2 ? y0 - 1 : y0;\n  const era = floorDiv(y, 400);\n  const yoe = y - era * 400;\n  const mp = m > 2 ? m - 3 : m + 9;\n  const doy = (153 * mp + 2) / 5 + d - 1;\n  const doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;\n  return era * 146097 + doe - 719468;\n}\n\n// fromMillis(instant: int): DateTime -- UTC calendar fields of an instant. Total, O(1).\nexport function fromMillis(instant: int): DateTime {\n  const dayNum = floorDiv(instant, 86400000);\n  const msOfDay = instant - dayNum * 86400000;\n  const z = dayNum + 719468;\n  const era = floorDiv(z, 146097);\n  const doe = z - era * 146097;\n  const yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;\n  const doy = doe - (365 * yoe + yoe / 4 - yoe / 100);\n  const mp = (5 * doy + 2) / 153;\n  const d = doy - (153 * mp + 2) / 5 + 1;\n  const m = mp < 10 ? mp + 3 : mp - 9;\n  const y = yoe + era * 400 + (m <= 2 ? 1 : 0);\n  let wd = (dayNum + 4) % 7;\n  if (wd < 0) {\n    wd += 7;\n  }\n  return DateTime {\n    year: y, month: m, day: d,\n    hour: msOfDay / 3600000, minute: (msOfDay / 60000) % 60,\n    second: (msOfDay / 1000) % 60, millisecond: msOfDay % 1000,\n    weekday: wd\n  };\n}\n\n// isLeapYear(year: int): bool -- Gregorian rule. O(1).\nexport function isLeapYear(year: int): bool {\n  return (year % 4 == 0 && year % 100 != 0) || year % 400 == 0;\n}\n\n// daysInMonth(year: int, month: int): Option<int> -- None unless month is 1..12. O(1).\nexport function daysInMonth(year: int, month: int): Option<int> {\n  if (month < 1 || month > 12) {\n    return None;\n  }\n  if (month == 2) {\n    return Some(isLeapYear(year) ? 29 : 28);\n  }\n  if (month == 4 || month == 6 || month == 9 || month == 11) {\n    return Some(30);\n  }\n  return Some(31);\n}\n\n// toInstant(dt: DateTime): Option<int>\n// The instant of a UTC date-time, or None when a field is out of range (month 1..12, day within\n// the month, hour 0..23, minute/second 0..59, millisecond 0..999). `weekday` is ignored. O(1).\nexport function toInstant(dt: DateTime): Option<int> {\n  const dim = daysInMonth(dt.year, dt.month);\n  if (dim.isNone()) {\n    return None;\n  }\n  if (dt.day < 1 || dt.day > dim.unwrap()) {\n    return None;\n  }\n  if (dt.hour < 0 || dt.hour > 23 || dt.minute < 0 || dt.minute > 59\n      || dt.second < 0 || dt.second > 59 || dt.millisecond < 0 || dt.millisecond > 999) {\n    return None;\n  }\n  const dayNum = daysFromCivil(dt.year, dt.month, dt.day);\n  return Some(dayNum * 86400000 + dt.hour * 3600000 + dt.minute * 60000 + dt.second * 1000 + dt.millisecond);\n}\n\nfunction pad(n: int, width: usize): string {\n  let s = n.toString();\n  while (s.length < width) {\n    s = \"0\" + s;\n  }\n  return s;\n}\n\n// formatIso(instant: int): string\n// ISO 8601 / RFC 3339 UTC: \"2024-02-29T13:04:05.006Z\" (year padded to at least 4 digits; years\n// before 0 or after 9999 are printed with their sign / extra digits). O(1).\nexport function formatIso(instant: int): string {\n  const t = fromMillis(instant);\n  const ys = t.year < 0 ? \"-\" + pad(0 - t.year, 4) : pad(t.year, 4);\n  return ys + \"-\" + pad(t.month, 2) + \"-\" + pad(t.day, 2) + \"T\" + pad(t.hour, 2) + \":\"\n    + pad(t.minute, 2) + \":\" + pad(t.second, 2) + \".\" + pad(t.millisecond, 3) + \"Z\";\n}\n" });
  return out;
}
