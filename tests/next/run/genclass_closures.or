// Closures and function values with generic class values: capture by value (a snapshot), generic class
// values as parameters and results of function values, methods used inside arrow functions, arrays of
// closures over generic class values.
class Box<T> {
  value: T;
  constructor(v: T) {
    this.value = v;
  }
  get(): T {
    return this.value;
  }
  set(v: T): void {
    this.value = v;
  }
}

class Acc<T> {
  items: T[] = [];
  add(x: T): void {
    this.items.push(x);
  }
  count(): usize {
    return this.items.length;
  }
}

function applyAll<T>(b: Box<T>, fs: ((x: T) => T)[]): Box<T> {
  let cur = b;
  for (const f of fs) {
    cur = new Box(f(cur.get()));
  }
  return cur;
}

function make(start: int): (d: int) => Box<int> {
  const b = new Box(start);
  return d => new Box(b.get() + d);
}

function main(): void {
  let b = new Box(10);
  // the closure captures a snapshot of `b`
  const read = () => b.get();
  b.set(20);
  console.log(read().toString() + " " + b.get().toString());
  // methods and `new` inside arrow functions
  const plus = (n: int) => new Box(b.get() + n);
  console.log(plus(5).get().toString());
  // function values over generic class values
  const incr = (x: int) => x + 1;
  console.log(applyAll(new Box(1), [incr, incr, x => x * 10]).get().toString());
  const shout = (s: string) => s + "!";
  console.log(applyAll(new Box("hey"), [shout, shout]).get());
  // closures returned from functions capture generic class values
  const f = make(100);
  console.log(f(1).get().toString() + " " + f(2).get().toString());
  // arrays of closures over different instantiations
  const getters: (() => string)[] = [() => new Box("x").get(), () => new Box(7).get().toString(), () => new Box(true).get().toString()];
  let out: string[] = [];
  for (const g of getters) {
    out.push(g());
  }
  console.log(out.join(","));
  // a closure that builds and fills a generic class value in its own body
  const fill = (n: int) => {
    let a = new Acc<int>();
    let i = 0;
    while (i < n) {
      a.add(i);
      i += 1;
    }
    return a;
  };
  console.log(fill(4).count().toString());
  // map / filter / reduce over arrays of generic class values
  const bs = [new Box(1), new Box(2), new Box(3)];
  const doubled = bs.map(x => new Box(x.get() * 2));
  const big = doubled.filter(x => x.get() > 2);
  console.log(big.length.toString() + " " + doubled.reduce((acc: int, x: Box<int>) => acc + x.get(), 0).toString());
}
