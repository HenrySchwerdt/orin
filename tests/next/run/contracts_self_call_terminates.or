// flags: --check-contracts
// A contract that calls its own function (directly, or through another function with contracts) used to
// recurse forever under --check-contracts: the call in the clause went through the checking wrapper again.
// Calls made inside a contract run the unchecked body (ADR-0031 A5). The test runner kills a hang.
@Ensures(result == isNormalized(path))
function isNormalized(path: string): bool {
  return !path.includes("//") && !path.endsWith("/");
}

@Requires(isNormalized(path))
@Ensures(isNormalized(result) && isNormalized(path))
function normalize(path: string): string {
  return path;
}

@Requires(n >= 0)
@Ensures(result >= 1 && (n == 0 || result == n * fact(n - 1)))
function fact(n: int): int {
  if (n == 0) {
    return 1;
  }
  return n * fact(n - 1);
}

class Stack {
  items: int[];
  constructor() { this.items = []; }
  size(): usize { return this.items.length; }
  @Ensures(this.size() == old(this.size()) + 1)
  push(x: int): void { this.items.push(x); }
}

@Invariant(this.size() <= 100)
class Bounded {
  items: int[];
  constructor() { this.items = []; }
  size(): usize { return this.items.length; }
  add(x: int): void { this.items.push(x); }
}

function main(): void {
  console.log(normalize("a/b"));
  console.log(fact(10).toString());
  let s = new Stack();
  s.push(1);
  s.push(2);
  console.log(s.size().toString());
  let b = new Bounded();
  b.add(1);
  console.log(b.size().toString());
}
