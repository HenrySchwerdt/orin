// Tagged unions, match and Result propagation.
type Shape = Circle(int) | Rect(int, int) | Square(int);

function area(s: Shape): int {
  return match (s) {
    Circle(r) => 3 * r * r,
    Rect(w, h) => w * h,
    Square(a) => a * a,
  };
}

function parseSide(text: string): Result<int, string> {
  return match (parseInt(text)) {
    Some(n) => n >= 0 ? Ok(n) : Err("negative side: " + text),
    None => Err("not a number: " + text),
  };
}

function squareFrom(text: string): Result<Shape, string> {
  const side = parseSide(text)?;
  return Ok(Square(side));
}

function main(): void {
  const shapes = [Circle(2), Rect(3, 4), Square(5)];
  let total = 0;
  for (const s of shapes) {
    total += area(s);
  }
  console.log("total area: " + total.toString());
  for (const input of ["7", "-1", "abc"]) {
    match (squareFrom(input)) {
      Ok(s) => { console.log(input + " -> area " + area(s).toString()); },
      Err(e) => { console.log(input + " -> error: " + e); },
    }
  }
}
