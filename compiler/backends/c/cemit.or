// MIR -> GNU C (against runtime/core/orin_runtime.h and runtime/core/orin_runtime_mir.h). The output is deterministic for a given
// MIR.
//
// Three steps (rewrite step 3d, rule 8): `cSymbols` fixes everything numbered across the program (function symbols and
// signatures; string literals and vtables keep the numbers of the MIR), in function order; `emitCFunction` emits each
// function from that read-only table alone; `emitC` joins the header, the declarations and the function texts in index
// order. No counter is threaded from one function to the next, so the per-function step can run in any order (ADR-0039
// `.parallel()`) and the joined text is the same.

import {
  MProgram, MFunction, MBlock, Instr, Operand, isWellFormedFunction, isWellFormedProgram,
} from "../../mir";
import { u, isFloatT, commentSafe, cString } from "./text";
import { CSymbols, cSymbols, cSymbolsWith, refsDeclared, namesDefined } from "./symbols";
import { siteTable } from "./sites";
import { emitCFunction, emitCFunctionWith } from "./function";

function usesFloat(prog: MProgram): bool {
  return prog.functions.some(f => f.locals.some(l => isFloatT(l.ty)));
}

// What the emitters need of their input (a verified program satisfies it): the shared structural predicate of `mir/`:
// `main` and every function, vtable entry, string, block and local a function refers to exists. Catches an emitter run
// on MIR that a pass left with a dangling index (it would print a symbol that is never defined).
export function emittable(p: MProgram): bool {
  return isWellFormedProgram(p);
}

export function fnEmittable(p: MProgram, f: MFunction): bool {
  return isWellFormedFunction(p, f);
}

// The unit: header, string literals, prototypes, vtables, then the function definitions in index order (each starts with
// its own prototype's signature, so every function is defined exactly once under a distinct symbol), then `main`.
@Requires(syms.count() == prog.functions.length
    && bodies.length == prog.functions.length
    && prog.main < prog.functions.length)
@Ensures(refsDeclared(result, syms) && namesDefined(result, syms))
export function joinC(prog: MProgram, syms: CSymbols, bodies: string[]): string {
  return joinCWith(prog, syms, bodies, false, []);
}

// `joinC`, and for the allocation-site census build (`sites`) the `ORIN_SITE_STATS` define first and the site table
// (sites.or) after the functions; `files` are the source paths by file index of the spans.
@Requires(syms.count() == prog.functions.length
    && bodies.length == prog.functions.length
    && prog.main < prog.functions.length)
@Ensures(refsDeclared(result, syms) && namesDefined(result, syms))
export function joinCWith(
  prog: MProgram,
  syms: CSymbols,
  bodies: string[],
  sites: bool,
  files: string[],
): string {
  let out: string[] = [];
  if (sites) {
    out.push(
      "#define ORIN_SITE_STATS 1 /* allocation-site census build: link with a runtime built with -DORIN_SITE_STATS */\n",
    );
  }
  out.push(
    "/* Generated by orinc (Orin Stage 1, MIR backend). Do not edit. */\n#include \"orin_runtime.h\"\n#include \"orin_runtime_mir.h\"\n#include \"orin_runtime_io.h\"\n\n",
  );
  if (usesFloat(prog)) {
    // Programs with floats: no fused multiply-add (bit-identical results across backends); link with -lm.
    out.push("#pragma STDC FP_CONTRACT OFF\n\n");
  }
  let i: usize = 0;
  for (const s of prog.strings) {
    out.push(
      "ORIN_STRING_LIT(orin_s" + u(i) + ", " + s.length.toString() + ", " + cString(s) + ");\n",
    );
    i += 1;
  }
  out.push("\n");
  i = 0;
  while (i < syms.count()) {
    out.push(syms.sig(i) + ";\n");
    i += 1;
  }
  out.push("\n");
  i = 0;
  for (const v of prog.vtables) {
    let fs: string[] = v.funcs.map(g => "(void *)&" + syms.name(g));
    if (fs.length == 0) {
      fs.push("NULL");
    }
    out.push(
      "static void *const orin_vt" + u(i) + "[] = { " + fs.join(", ") + " }; /* "
          + commentSafe(v.name) + " */\n",
    );
    i += 1;
  }
  out.push("\n");
  for (const b of bodies) {
    out.push(b);
    out.push("\n");
  }
  if (sites) {
    out.push(siteTable(prog, files));
  }
  // `main(host: Host)` (ADR-0027) receives the runtime-created root grant; `main()` receives nothing.
  const hostArg = prog.functions[prog.main].paramCount == 1 ? "orin_cap_host_root()" : "";
  out.push(
    "int main(int argc, char **argv) {\n  orin_init(argc, argv);\n  " + syms.name(prog.main) + "("
        + hostArg + ");\n  orin_flush();\n  return 0;\n}\n",
  );
  return out.join("");
}

// The indices 0 .. n-1.
@Ensures(result.length == n)
export function indices(n: usize): usize[] {
  let out: usize[] = [];
  let i: usize = 0;
  while (i < n) {
    out.push(i);
    i += 1;
  }
  return out;
}

@Requires(emittable(prog))
export function emitC(prog: MProgram): string {
  return emitCFacts(prog, false);
}

// `emitC`, and with `facts` (`orin2 compile --assert-facts`) every `IForward` is followed by a check of the forwarded value
// against the slot (`orin_assert_fact`, exit 70 on a difference).
@Requires(emittable(prog))
export function emitCFacts(prog: MProgram, facts: bool): string {
  const syms = cSymbols(prog);
  const bodies = indices(prog.functions.length).map(i => emitCFunctionWith(syms, prog, i, facts));
  return joinC(prog, syms, bodies);
}

// The allocation-site census build (`orin2 compile --stats-sites`, runtime/core/orin_runtime.h "Allocation-site census"): the
// same C plus the site marks, `#define ORIN_SITE_STATS 1` and the site table (sites.or). The site ids are fixed in the
// symbol step, so the functions are still emitted independently. `files` are the source paths by file index of the spans.
@Requires(emittable(prog))
export function emitCSites(prog: MProgram, files: string[]): string {
  const syms = cSymbolsWith(prog, true);
  const bodies = indices(prog.functions.length).map(i => emitCFunction(syms, prog, i));
  return joinCWith(prog, syms, bodies, true, files);
}
