// MIR -> textual LLVM IR (ADR-0006), a behavioural twin of compiler/cemit: same runtime calls, same trap messages, same
// ownership operations. Output is deterministic for a given MIR.
//
// Scheme:
//   * int, usize and bool are i64 (usize compares unsigned); float / f32 are `double` (ADR-0018: slots hold the bit
//     pattern, stored and loaded as `double` directly); references are `ptr`.
//   * every MIR local is an `alloca` in a synthetic `entry` block; MIR block i is the LLVM block `B<i>` (function.or).
//   * the hot runtime operations (retain/release, make_unique fast path, struct/array slot access, array push, checked
//     arithmetic) are small internal `alwaysinline` IR functions in the prelude (runtime.or). All other operations call
//     the C runtime (runtime/orin_runtime.c) by symbol.
//
// Three steps (rewrite step 3d, rule 8), as in the C backend: `llvmSymbols` numbers the function symbols and the trap
// messages in a fixed order; `emitLlvmFunction` emits each function from that read-only table; `emitLlvm` joins the
// globals, the declarations, the prelude and the function texts in index order.

import { MProgram } from "../mir";
import { emittable, indices } from "../cemit";
import { u, lty, cstrGlobal, strGlobal } from "./text";
import { prelude, declares } from "./runtime";
import { LlvmSymbols, llvmSymbols, llvmRefsDeclared, trapsIndexed } from "./symbols";
import { emitLlvmFunction } from "./function";

// The module: trap message and string globals, vtables, declarations, prelude, the function definitions in index order,
// `main`. Every global it mentions is one it defines or declares.
@Requires(syms.count() == prog.functions.length
    && bodies.length == prog.functions.length
    && prog.main < prog.functions.length)
@Ensures(llvmRefsDeclared(result, syms))
export function joinLlvm(prog: MProgram, syms: LlvmSymbols, bodies: string[]): string {
  let out: string[] = [];
  out.push("; Generated by orinc (Orin Stage 1, MIR -> LLVM IR backend). Do not edit.\n\n");
  let i: usize = 0;
  for (const m of syms.messages()) {
    out.push(cstrGlobal("@.m" + u(i), "private unnamed_addr", m));
    i += 1;
  }
  i = 0;
  for (const s of prog.strings) {
    out.push(strGlobal(i, s));
    i += 1;
  }
  i = 0;
  for (const v of prog.vtables) {
    let fs: string[] = v.funcs.map(g => "ptr @" + syms.name(g));
    if (fs.length == 0) {
      fs.push("ptr null");
    }
    out.push(
      "@orin_vt" + u(i) + " = private unnamed_addr constant [" + u(fs.length) + " x ptr] ["
          + fs.join(", ") + "]\n",
    );
    i += 1;
  }
  out.push("\n");
  out.push(declares());
  out.push("\n");
  out.push(prelude());
  out.push("\n");
  for (const b of bodies) {
    out.push(b);
  }
  const hostCall = prog.functions[prog.main].paramCount == 1;
  out.push(
    "define i32 @main(i32 %argc, ptr %argv) {\n  call void @orin_init(i32 %argc, ptr %argv)\n"
        + (hostCall ? "  %host = call i64 @orin_cap_host_root()\n" : "") + "  call "
        + lty(prog.functions[prog.main].ret) + " @" + syms.name(prog.main) + "("
        + (hostCall ? "i64 %host" : "") + ")\n  call void @orin_flush()\n  ret i32 0\n}\n",
  );
  return out.join("");
}

@Requires(emittable(prog))
export function emitLlvm(prog: MProgram): string {
  const syms = llvmSymbols(prog);
  const bodies = indices(prog.functions.length).map(i => emitLlvmFunction(syms, prog, i));
  return joinLlvm(prog, syms, bodies);
}
