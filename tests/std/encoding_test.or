import { assert, assertEq, assertEqUsize, assertEqString } from "std:test";
import { Bytes, ByteBuilder, bytesFromString, bytesFromInts } from "std:bytes";
import {
  EncodingErrorKind, hexEncode, hexDecode, base64Encode, base64Decode, base64UrlEncode,
  base64UrlDecode, encodingErrorMessage,
} from "std:encoding";

function kindName(k: EncodingErrorKind): string {
  return match (k) {
    InvalidByte => "byte",
    InvalidLength => "length",
    InvalidPadding => "padding",
    NonCanonical => "canonical",
  };
}

function vector(raw: string, encoded: string, unpadded: string): void {
  const b = bytesFromString(raw);
  assertEqString(base64Encode(b, true), encoded, "RFC padded encoding");
  assertEqString(base64Encode(b, false), unpadded, "RFC unpadded encoding");
  assert(base64Decode(bytesFromString(encoded), true).unwrap().equals(b), "RFC padded decoding");
  assert(
    base64Decode(bytesFromString(unpadded), false).unwrap().equals(b),
    "RFC unpadded decoding",
  );
  assertEqString(base64UrlEncode(b, true), encoded, "RFC URL padded encoding");
  assertEqString(base64UrlEncode(b, false), unpadded, "RFC URL unpadded encoding");
  assert(
    base64UrlDecode(bytesFromString(encoded), true).unwrap().equals(b),
    "RFC URL padded decoding",
  );
  assert(
    base64UrlDecode(bytesFromString(unpadded), false).unwrap().equals(b),
    "RFC URL unpadded decoding",
  );
}

@Test
function rfc4648Vectors(): void {
  vector("", "", "");
  vector("f", "Zg==", "Zg");
  vector("fo", "Zm8=", "Zm8");
  vector("foo", "Zm9v", "Zm9v");
  vector("foob", "Zm9vYg==", "Zm9vYg");
  vector("fooba", "Zm9vYmE=", "Zm9vYmE");
  vector("foobar", "Zm9vYmFy", "Zm9vYmFy");
  const b = bytesFromInts([251, 255, 255, 255]);
  assertEqString(base64Encode(b, true), "+////w==", "standard alphabet");
  assertEqString(base64UrlEncode(b, true), "-____w==", "URL alphabet");
  assert(base64Decode(bytesFromString("+////w=="), true).unwrap().equals(b), "standard decode");
  assert(base64UrlDecode(bytesFromString("-____w=="), true).unwrap().equals(b), "URL decode");
}

function bad64(s: string, padded: bool, pos: usize, kind: EncodingErrorKind): void {
  const r = base64Decode(bytesFromString(s), padded);
  assert(r.isErr(), "malformed Base64 rejected");
  assertEqUsize(r.unwrapErr().position, pos, "error byte position");
  assert(kindName(r.unwrapErr().kind) == kindName(kind), "error kind");
  assert(encodingErrorMessage(r.unwrapErr()).length > 0, "error formatted");
}

@Test
function malformedBase64(): void {
  bad64("A", true, 1, InvalidLength);
  bad64("A", false, 1, InvalidLength);
  bad64("Zg", true, 2, InvalidLength);
  bad64("Zg=", true, 3, InvalidLength);
  bad64("Zg==", false, 2, InvalidPadding);
  bad64("=AAA", true, 0, InvalidPadding);
  bad64("A===", true, 1, InvalidPadding);
  bad64("AA=A", true, 3, InvalidPadding);
  bad64("AA==AAAA", true, 4, InvalidPadding);
  bad64("AA===", true, 4, InvalidPadding);
  bad64("AAAA=", true, 4, InvalidPadding);
  bad64("AAA==", true, 4, InvalidPadding);
  bad64("Zh==", true, 1, NonCanonical);
  bad64("Zm9=", true, 2, NonCanonical);
  bad64("Zh", false, 1, NonCanonical);
  bad64("Zm9", false, 2, NonCanonical);
  bad64("Zm9vZh==", true, 5, NonCanonical);
  bad64("Z g=", true, 1, InvalidByte);
  bad64("Zg==\n", true, 4, InvalidByte);
  bad64("Zg\r\n", true, 2, InvalidByte);
  bad64("Zg\0=", true, 2, InvalidByte);
  bad64("Zg\xff=", true, 2, InvalidByte);
  bad64("-___", true, 0, InvalidByte);
  assert(base64UrlDecode(bytesFromString("+///"), true).isErr(), "URL rejects standard alphabet");
  assert(base64UrlDecode(bytesFromString("-_/_"), false).isErr(), "URL rejects mixed alphabet");
  assert(
    kindName(base64UrlDecode(bytesFromString("_x=="), true).unwrapErr().kind) == "canonical",
    "URL pad bits",
  );
}

@Test
function hexVectorsAndErrors(): void {
  assertEqString(hexEncode(bytesFromString("foobar")), "666f6f626172", "RFC hex");
  assertEqString(hexEncode(bytesFromString("")), "", "empty hex");
  assert(hexDecode(bytesFromString("")).unwrap().isEmpty(), "empty decode");
  assert(
    hexDecode(bytesFromString("aAbBcCdDeEfF001122"))
        .unwrap()
        .equals(bytesFromInts([170, 187, 204, 221, 238, 255, 0, 17, 34])),
    "both cases",
  );
  assertEqString(
    encodingErrorMessage(hexDecode(bytesFromString("ab?")).unwrapErr()),
    "encoding error at byte 2: invalid alphabet byte",
    "error message and validation precedence",
  );
  const odd = hexDecode(bytesFromString("abc"));
  assert(kindName(odd.unwrapErr().kind) == "length", "odd length");
  assertEqUsize(odd.unwrapErr().position, 3, "odd EOF offset");
  const invalid = ["0x", " 0", "0\n", "0\0", "0\xff", "0G"];
  let i: usize = 0;
  while (i < invalid.length) {
    const r = hexDecode(bytesFromString(invalid[i]));
    assert(r.isErr(), "invalid hex");
    assert(kindName(r.unwrapErr().kind) == "byte", "hex byte kind");
    assertEqUsize(r.unwrapErr().position, i == 1 ? 0 : 1, "hex byte offset");
    i += 1;
  }
}

function roundtrip(b: Bytes): void {
  assert(hexDecode(bytesFromString(hexEncode(b))).unwrap().equals(b), "hex round trip");
  assert(
    base64Decode(bytesFromString(base64Encode(b, true)), true).unwrap().equals(b),
    "base64 padded round trip",
  );
  assert(
    base64Decode(bytesFromString(base64Encode(b, false)), false).unwrap().equals(b),
    "base64 raw round trip",
  );
  assert(
    base64UrlDecode(bytesFromString(base64UrlEncode(b, true)), true).unwrap().equals(b),
    "URL padded round trip",
  );
  assert(
    base64UrlDecode(bytesFromString(base64UrlEncode(b, false)), false).unwrap().equals(b),
    "URL raw round trip",
  );
}

@Test
function everyByteAndViews(): void {
  let out = new ByteBuilder();
  let i = 0;
  while (i < 256) {
    out.appendU8(i.toU8());
    i += 1;
  }
  const all = out.build();
  roundtrip(all);
  let n: usize = 0;
  while (n <= 256) {
    roundtrip(all.slice(0, n));
    roundtrip(all.slice(n, 256));
    n += 1;
  }
  const view = bytesFromString("!Zh==!").slice(1, 5);
  assertEqUsize(base64Decode(view, true).unwrapErr().position, 1, "error relative to view");
  assertEqUsize(
    hexDecode(bytesFromString("!0g!").slice(1, 3)).unwrapErr().position,
    1,
    "hex view offset",
  );
}

@Test
function exhaustiveTailBits(): void {
  // Every possible final sextet: only multiples of 16/4 are canonical.
  const digits = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
  let i: usize = 0;
  while (i < 64) {
    const two = "A" + digits.charAt(i);
    const three = "AA" + digits.charAt(i);
    assert(
      base64Decode(bytesFromString(two), false).isOk() == (i % 16 == 0),
      "two digit canonical bits",
    );
    assert(
      base64Decode(bytesFromString(two + "=="), true).isOk() == (i % 16 == 0),
      "padded two canonical bits",
    );
    assert(
      base64Decode(bytesFromString(three), false).isOk() == (i % 4 == 0),
      "three digit canonical bits",
    );
    assert(
      base64Decode(bytesFromString(three + "="), true).isOk() == (i % 4 == 0),
      "padded three canonical bits",
    );
    i += 1;
  }
}

@Test
function everyInputByte(): void {
  let i = 0;
  while (i < 256) {
    const b = bytesFromInts([i]);
    const c = b.toRawString();
    const expectedHex = i >= 48 && i <= 57 || i >= 65 && i <= 70 || i >= 97 && i <= 102;
    assert(hexDecode(bytesFromString(c + "0")).isOk() == expectedHex, "all hex input bytes");
    const alpha = i >= 65 && i <= 90 || i >= 97 && i <= 122 || i >= 48 && i <= 57;
    assert(
      base64Decode(bytesFromString(c + "AAA"), true).isOk() == (alpha || i == 43 || i == 47),
      "all standard input bytes",
    );
    assert(
      base64UrlDecode(bytesFromString(c + "AAA"), true).isOk() == (alpha || i == 45 || i == 95),
      "all URL input bytes",
    );
    i += 1;
  }
}

@Test
function deterministicMalformedAndRoundTrips(): void {
  const chars = "ABZagh09+/-_= \0\xff";
  let state = 12345;
  let trial: usize = 0;
  while (trial < 3000) {
    state = (state * 251 + 17) % 65521;
    const n = (state % 13).toUsize();
    let out = new ByteBuilder();
    let i: usize = 0;
    while (i < n) {
      state = (state * 251 + 17) % 65521;
      out.appendU8(chars.charCodeAt((state % chars.length.toInt()).toUsize()).toU8());
      i += 1;
    }
    const b = out.build();
    const text = b.toRawString();
    const a = base64Decode(b, true);
    const c = base64Decode(b, false);
    const d = base64UrlDecode(b, true);
    const e = base64UrlDecode(b, false);
    if (a.isOk()) {
      assertEqString(base64Encode(a.unwrap(), true), text, "canonical standard padded");
    }
    if (c.isOk()) {
      assertEqString(base64Encode(c.unwrap(), false), text, "canonical standard raw");
    }
    if (d.isOk()) {
      assertEqString(base64UrlEncode(d.unwrap(), true), text, "canonical URL padded");
    }
    if (e.isOk()) {
      assertEqString(base64UrlEncode(e.unwrap(), false), text, "canonical URL raw");
    }
    roundtrip(b);
    trial += 1;
  }
}
