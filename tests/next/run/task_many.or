// std:task: many tasks at once (500 threads alive in one scope), results in spawn order.
import { scope, spawn, TaskHandle } from "std:task";

function square(i: int): int {
  return i * i;
}

function main(): void {
  const sum = scope(s => {
    let hs: TaskHandle<int>[] = [];
    let i = 0;
    while (i < 500) {
      const k = i;
      hs.push(spawn(s, () => square(k)));
      i += 1;
    }
    let total = 0;
    for (const h of hs) {
      total += h.join();
    }
    return total;
  });
  console.log(sum.toString());
}
