// flags: --check-contracts
// exit: 101
// stderr: contract violated: @Requires(this.items.length > 0)
class Stack<T> {
  items: T[] = [];

  push(x: T): void {
    this.items.push(x);
  }

  @Requires(this.items.length > 0)
  pop(): T {
    return this.items.pop().unwrap();
  }
}

function main(): void {
  let s = new Stack<float>();
  s.push(1.5);
  console.log(s.pop().toString());
  console.log(s.pop().toString());
}
