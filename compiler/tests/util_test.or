import { assert, assertEqString, assertEqUsize } from "std:test";
import { Host, useHost } from "std:host";
import { exists } from "std:fs";
import {
  isDigit, isJsonSpace, hexVal, hexDigitLower, hexDigitUpper, shq, trunc, countNewlines, lineCol, addUnique,
  hasStr, hasUsize, workerCount, mapOrdered, mapOrderedFs, mapOrderedProcess, shellRun, mapOrderedLent, mapChunksLent,
} from "../util";

@Test
function characters(): void {
  assert(isDigit(48) && isDigit(57) && !isDigit(47) && !isDigit(58), "isDigit");
  assert(isJsonSpace(32) && isJsonSpace(9) && isJsonSpace(10) && isJsonSpace(13), "isJsonSpace");
  assert(!isJsonSpace(11) && !isJsonSpace(12) && !isJsonSpace(65), "isJsonSpace rejects");
  assert(hexVal(48) == 0 && hexVal(57) == 9, "hexVal digits");
  assert(hexVal(97) == 10 && hexVal(102) == 15 && hexVal(65) == 10 && hexVal(70) == 15, "hexVal letters");
  assert(hexVal(103) == -1 && hexVal(71) == -1 && hexVal(47) == -1 && hexVal(58) == -1, "hexVal rejects");
  assertEqString(hexDigitLower(0) + hexDigitLower(9) + hexDigitLower(10) + hexDigitLower(15), "09af", "hexDigitLower");
  assertEqString(hexDigitUpper(0) + hexDigitUpper(9) + hexDigitUpper(10) + hexDigitUpper(15), "09AF", "hexDigitUpper");
  let n: int = 0;
  while (n < 16) {
    assert(hexVal(hexDigitLower(n).charCodeAt(0)) == n, "lower round trip");
    assert(hexVal(hexDigitUpper(n).charCodeAt(0)) == n, "upper round trip");
    n += 1;
  }
}

@Test
function text(): void {
  assertEqString(shq("a b"), "'a b'", "shq plain");
  assertEqString(shq("it's"), "'it'\\''s'", "shq quote");
  assertEqString(shq(""), "''", "shq empty");
  assertEqString(trunc("abc", 3), "abc", "trunc fits");
  assertEqString(trunc("abcdef", 2), "ab...[truncated 4 bytes]", "trunc cuts");
  assert(countNewlines("") == 0 && countNewlines("a\nb\n\n") == 3, "countNewlines");
}

@Test
function positions(): void {
  const t = "ab\ncd\n";
  assert(lineCol(t, 0).line == 1 && lineCol(t, 0).col == 1, "start");
  assert(lineCol(t, 1).line == 1 && lineCol(t, 1).col == 2, "inside first line");
  assert(lineCol(t, 3).line == 2 && lineCol(t, 3).col == 1, "after newline");
  assert(lineCol(t, 4).line == 2 && lineCol(t, 4).col == 2, "second line");
  assert(lineCol(t, 6).line == 3 && lineCol(t, 6).col == 1, "end");
  assert(lineCol(t, 99).line == 3 && lineCol(t, 99).col == 1, "past the end counts as the end");
  assert(lineCol("", 5).line == 1 && lineCol("", 5).col == 1, "empty text");
}

@Test
function collections(): void {
  let xs: string[] = [];
  xs = addUnique(xs, "a");
  xs = addUnique(xs, "b");
  xs = addUnique(xs, "a");
  assert(xs.length == 2 && xs[0] == "a" && xs[1] == "b", "addUnique keeps first occurrences");
  assert(hasStr(xs, "b") && !hasStr(xs, "c"), "hasStr");
  const us: usize[] = [3, 5];
  assert(hasUsize(us, 5) && !hasUsize(us, 4), "hasUsize");
}

// ---- ordered parallel maps (ORIN_THREADS=N must never change a result) ---------------------------------------------------

@Test
function mapOrderedKeepsIndexOrder(): void {
  assertEqUsize(mapOrdered(0, (i: usize) => i).length, 0, "no indices");
  const one = mapOrdered(1, (i: usize) => i + 7);
  assert(one.length == 1 && one[0] == 7, "one index");
  const sq = mapOrdered(101, (i: usize) => i * i);
  assertEqUsize(sq.length, 101, "length");
  let i: usize = 0;
  while (i < 101) {
    assert(sq[i] == i * i, "square " + i.toString());
    i += 1;
  }
  assert(workerCount(0) == 1 && workerCount(1) == 1 && workerCount(5) >= 1 && workerCount(5) <= 5, "workerCount");
}

@Test
function mapOrderedMovesHeapResults(): void {
  const names: string[] = ["a", "bb", "ccc", "dddd", "eeeee", "ffffff", "ggggggg"];
  const rs = mapOrdered(names.length, (i: usize) => names[i] + "!" + i.toString());
  assertEqUsize(rs.length, 7, "length");
  assertEqString(rs.join(","), "a!0,bb!1,ccc!2,dddd!3,eeeee!4,ffffff!5,ggggggg!6", "strings in index order");
}

type Row = { id: usize; name: string; cells: string[]; };

function rows(n: usize): Row[] {
  let rs: Row[] = [];
  while (rs.length < n) {
    const id = rs.length;
    rs.push(Row { id: id, name: "row" + id.toString(), cells: ["c" + id.toString(), "x"] });
  }
  return rs;
}

@Test
function mapOrderedLentReadsTheGraphInIndexOrder(): void {
  const rs = rows(57);
  assertEqUsize(mapOrderedLent(rs, 0, (i: usize) => i).length, 0, "no indices");
  assertEqString(mapOrderedLent(rs, 1, (i: usize) => rs[i].name)[0], "row0", "one index");
  const out = mapOrderedLent(rs, 57, (i: usize) => rs[i].name + "/" + rs[i].cells[0]);
  assertEqUsize(out.length, 57, "length");
  let i: usize = 0;
  while (i < 57) {
    assertEqString(out[i], "row" + i.toString() + "/c" + i.toString(), "element " + i.toString());
    i += 1;
  }
}

@Test
function mapOrderedLentResultsAreCopies(): void {
  let rs = rows(20);
  const picked = mapOrderedLent(rs, 20, (i: usize) => rs[i]);
  rs[3].name = "changed";
  rs[3].cells[0] = "changed";
  assertEqString(picked[3].name, "row3", "a result keeps its value when the graph changes");
  assertEqString(picked[3].cells[0], "c3", "also in a nested array");
}

@Test
function mapChunksLentCoversEveryIndexOnce(): void {
  const rs = rows(103);
  assertEqUsize(mapChunksLent(rs, 0, 10, (lo: usize, hi: usize) => lo).length, 0, "no indices");
  const sizes: usize[] = [0, 1, 7, 64, 103, 500];
  for (const size of sizes) {
    const pieces = mapChunksLent(rs, 103, size, (lo: usize, hi: usize) => {
      let names: string[] = [];
      let i = lo;
      while (i < hi) {
        names.push(rs[i].name);
        i += 1;
      }
      return names.join(",");
    });
    const sz = size == 0 ? 1 : size;
    assertEqUsize(pieces.length, (103 + sz - 1) / sz, "pieces for size " + size.toString());
    let all: string[] = [];
    for (const p of pieces) {
      all.push(p);
    }
    let want: string[] = [];
    let i: usize = 0;
    while (i < 103) {
      want.push("row" + i.toString());
      i += 1;
    }
    assertEqString(all.join(","), want.join(","), "every index once, in order, for size " + size.toString());
  }
}

@Test
function mapOrderedWithGrants(host: Host): void {
  useHost(
    host,
    (fs, proc, stdio, clock) => {
      const codes = mapOrderedProcess(proc, 9, (i: usize, g) => shellRun(g, "exit " + i.toString()));
      assertEqUsize(codes.length, 9, "process: length");
      let i: usize = 0;
      while (i < 9) {
        assert(codes[i] == i.toInt(), "process: exit status of " + i.toString());
        i += 1;
      }
      const seen = mapOrderedFs(fs, 6, (i: usize, g) => exists(g, i % 2 == 0 ? "/" : "/no/such/path/" + i.toString()));
      assertEqUsize(seen.length, 6, "fs: length");
      i = 0;
      while (i < 6) {
        assert(seen[i] == (i % 2 == 0), "fs: result of " + i.toString());
        i += 1;
      }
      assertEqUsize(mapOrderedFs(fs, 0, (i: usize, g) => i).length, 0, "fs: no indices");
      assertEqUsize(mapOrderedProcess(proc, 0, (i: usize, g) => i).length, 0, "process: no indices");
    },
  );
}
