function main(): void {
  console.log("tab:\there");
  console.log("line1\nline2");
  console.log("quote:\"x\"");
  console.log("back\\slash");
  console.log("single\'s");
  console.log("\x41\x42\x43");
  const nul = "a\0b";
  console.log(nul.length.toString());
  console.log(nul.charCodeAt(1).toString());
  const cr = "a\rb";
  console.log(cr.length.toString());
  console.log("\x7e");
}
