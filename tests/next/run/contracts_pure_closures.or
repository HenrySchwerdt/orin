// Pure helpers and pure closures in contracts (ADR-0031 A4): `every` / `some` / `map` / `filter` with closures,
// a helper that itself uses a closure, a closure that calls a pure helper, and a closure capturing a parameter.
function isPositive(x: int): bool {
  return x > 0;
}

function allPositive(xs: int[]): bool {
  return xs.every(x => isPositive(x));
}

@Requires(xs.length > 0 && xs.some(x => x == pivot))
@Ensures(allPositive(result) && result.every(x => x < limit))
@Ensures(result.length == xs.filter(x => x > 0).length)
@Ensures(xs.map(x => x * 2).length == xs.length)
function scale(xs: int[], pivot: int, limit: int): int[] {
  return xs.map(x => x + pivot);
}

function main(): void {
  console.log(scale([1, 2, 3], 2, 100).length.toString());
  console.log(scale([1, 2, 3], 2, 5).length.toString());
}
