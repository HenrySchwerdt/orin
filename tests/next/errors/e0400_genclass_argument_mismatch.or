// error: E0400
interface Shape {
  area(): int;
}

class Sq implements Shape {
  s: int;
  constructor(s: int) {
    this.s = s;
  }
  area(): int {
    return this.s;
  }
}

class Plain {
  x: int;
  constructor(x: int) {
    this.x = x;
  }
}

class Box<T> {
  value: T;
  constructor(v: T) {
    this.value = v;
  }
  get(): T {
    return this.value;
  }
  set(v: T): void {
    this.value = v;
  }
}

class Holder<T extends Shape> {
  it: T;
  constructor(it: T) {
    this.it = it;
  }
  area(): int {
    return this.it.area();
  }
}

function main(): void {
  const b = new Box<int>("s");
}
