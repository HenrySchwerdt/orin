// Loader output types — Stage 1 shared contract (v1). Mirrors the interface section of
// bootstrap/src/loader.rs. Owned by the lead architect.

import { Module } from "../syntax";

// StdFs = "std:fs", StdProcess = "std:process"
export type ImportTarget = ImportUnit(usize) | ImportStd(StdModule);
export type StdModule = StdFs | StdProcess;

export type Unit = {
  file: usize;            // index into SourceMap.files
  path: string;           // normalized path (as opened)
  name: string;           // relative to the entry file's directory, "/"-separated, no ".or"
  ast: Module;
  imports: ImportTarget[];  // one per IImport / IReExport item, in item order
};

// units are topologically sorted (dependencies first, entry last); entry = index of entry.
export type LoadedProgram = { units: Unit[]; entry: usize; };
