// GENERATED by tools/embed_prelude.py from runtime/core/ -- do not edit; run the script after changing the sources.

import { SourceFile } from "../diag";

export function embeddedRtFiles(): SourceFile[] {
  let out: SourceFile[] = [];
  out.push(SourceFile { path: "$rt/array.or", text: "// $rt/array -- array slice, concatenation and extension and the byte conversions, written in Orin (ADR-0052 Addendum A, step R3d.4).\n//\n// The backends call these functions by name (compiler/mir/rt.or lists them; opt/prune.or keeps them) in place of the C runtime\n// functions `orin_array_slice`, `orin_array_concat`, `orin_array_extend`, `orin_bytes_to_string` and `orin_string_to_bytes`; the C\n// unit tests of the runtime reach them through the wrappers of the same C names. An object is its address as a `usize`; the layout\n// is the frozen one (heap.or): array len@16 cap@24 is_ref@32 items@40, the items 8-byte slots; string len@16 cap@24 data@32.\n// A reference array (`is_ref` != 0) owns one count of each element: copying it retains every element (a loop over the slots), a\n// scalar array is copied as bytes. Counters are updated exactly as the C versions did (the ORIN_STATS=1 report is the oracle).\n\nimport { load8, load32, load64, store8, store64, memCopy, heapBase, cfg, wadd, wsub, wmul, shl, and, or } from \"std:core\";\nimport { taskTrap } from \"std:fsraw\";\nimport { sbRealloc, addAt, statGrow, siteGrow, S_ARRAY_GROWS } from \"./heap\";\nimport { arrayNew, strAlloc } from \"./object\";\nimport { retain, release } from \"./rc\";\nimport { trapShape } from \"./leaf\";\n\n// Copy `n` slots from `src` to `dst` (ranges that do not overlap); a reference array retains each element.\n@Inline\nfunction copySlots(dst: usize, src: usize, n: usize, isRef: usize): void {\n  if (n == 0) {\n    return;\n  }\n  if (isRef != 0) {\n    let i: usize = 0;\n    while (i < n) {\n      const v = load64(wadd(src, shl(i, 3)));\n      store64(wadd(dst, shl(i, 3)), v);\n      retain(v);\n      i = wadd(i, 1);\n    }\n  } else {\n    memCopy(dst, src, shl(n, 3));\n  }\n}\n\n// The slots `lo .. hi` of `o` as a new array of the same element kind; traps \"slice out of range\" unless lo <= hi <= len.\nexport function arraySlice(o: usize, lo: usize, hi: usize): usize {\n  if (lo > hi || hi > load64(wadd(o, 16))) {\n    taskTrap(\"slice out of range\");\n  }\n  const isRef = load64(wadd(o, 32));\n  const k = wsub(hi, lo);\n  const r = arrayNew(k, isRef);\n  if (k != 0) {\n    copySlots(load64(wadd(r, 40)), wadd(load64(wadd(o, 40)), shl(lo, 3)), k, isRef);\n    store64(wadd(r, 16), k);\n  }\n  return r;\n}\n\n// x ++ y as a new array (a reference array when either is).\nexport function arrayConcat(x: usize, y: usize): usize {\n  const la = load64(wadd(x, 16));\n  const lb = load64(wadd(y, 16));\n  const n = wadd(la, lb);\n  const r = arrayNew(n, or(load64(wadd(x, 32)), load64(wadd(y, 32))));\n  if (n != 0) {\n    const dst = load64(wadd(r, 40));\n    copySlots(dst, load64(wadd(x, 40)), la, load64(wadd(x, 32)));\n    copySlots(wadd(dst, shl(la, 3)), load64(wadd(y, 40)), lb, load64(wadd(y, 32)));\n    store64(wadd(r, 16), n);\n  }\n  return r;\n}\n\n// The item buffer of the unique array `x` grown to hold at least `n` slots: at least twice the capacity, 4 slots at the least. Out of\n// line: the in-place path of `arrayExtend` stays small.\nfunction growItems(x: usize, n: usize): void {\n  const cap = load64(wadd(x, 24));\n  let ncap = wmul(cap, 2);\n  if (ncap < n) {\n    ncap = n;\n  }\n  if (ncap < 4) {\n    ncap = 4;\n  }\n  if (ncap > 1099511627776) {\n    taskTrap(\"array too large\");\n  }\n  store64(wadd(x, 40), sbRealloc(load64(wadd(x, 40)), shl(cap, 3), shl(ncap, 3)));\n  statGrow(shl(wsub(ncap, cap), 3));\n  if (cfg(1) == 1) {\n    addAt(wadd(heapBase(), S_ARRAY_GROWS), 1);\n  }\n  siteGrow(x, shl(wsub(ncap, cap), 3));\n  store64(wadd(x, 24), ncap);\n}\n\n// x ++ y as a new array and one count of `x` released (the copying path of `arrayExtend`).\nfunction extendCopy(x: usize, y: usize): usize {\n  const r = arrayConcat(x, y);\n  release(x);\n  return r;\n}\n\n// x = x ++ y. Consumes `x`; `y` is only read. In place only when `x` is unique, is not `y` and the element kinds agree (or `x` is\n// empty); else a new array and one count of `x` released.\nexport function arrayExtend(x: usize, y: usize): usize {\n  if (load32(wadd(x, 8)) != 2 || load32(wadd(y, 8)) != 2) {\n    trapShape();\n  }\n  const lb = load64(wadd(y, 16));\n  if (lb == 0) {\n    return x;\n  }\n  const la = load64(wadd(x, 16));\n  const xRef = load64(wadd(x, 32));\n  const yRef = load64(wadd(y, 32));\n  if (load64(x) == 1 && x != y && (xRef == yRef || la == 0)) {\n    const n = wadd(la, lb);\n    if (n > load64(wadd(x, 24))) {\n      growItems(x, n);\n    }\n    store64(wadd(x, 32), yRef);\n    copySlots(wadd(load64(wadd(x, 40)), shl(la, 3)), load64(wadd(y, 40)), lb, yRef);\n    store64(wadd(x, 16), n);\n    return x;\n  }\n  return extendCopy(x, y);\n}\n\n// Narrow `n` 8-byte slots at `src` to bytes at `dst`. The slots of a u8 array hold 0..255, but the runtime does not trust that: the\n// result is the OR of all slots, so a value above 255 shows as a result above 255. Eight elements per step.\nfunction narrow(dst: usize, src: usize, n: usize): usize {\n  let bad: usize = 0;\n  let i: usize = 0;\n  const n8 = wsub(n, and(n, 7));\n  let p = src;\n  let q = dst;\n  while (i < n8) {\n    const a = load64(p);\n    const b = load64(wadd(p, 8));\n    const c = load64(wadd(p, 16));\n    const d = load64(wadd(p, 24));\n    const e = load64(wadd(p, 32));\n    const f = load64(wadd(p, 40));\n    const g = load64(wadd(p, 48));\n    const h = load64(wadd(p, 56));\n    bad = or(bad, or(or(or(a, b), or(c, d)), or(or(e, f), or(g, h))));\n    store8(q, a);\n    store8(wadd(q, 1), b);\n    store8(wadd(q, 2), c);\n    store8(wadd(q, 3), d);\n    store8(wadd(q, 4), e);\n    store8(wadd(q, 5), f);\n    store8(wadd(q, 6), g);\n    store8(wadd(q, 7), h);\n    p = wadd(p, 64);\n    q = wadd(q, 8);\n    i = wadd(i, 8);\n  }\n  while (i < n) {\n    const v = load64(p);\n    bad = or(bad, v);\n    store8(q, v);\n    p = wadd(p, 8);\n    q = wadd(q, 1);\n    i = wadd(i, 1);\n  }\n  return bad;\n}\n\n// Widen `n` bytes at `src` to 8-byte slots at `dst`. Eight elements per step.\nfunction widen(dst: usize, src: usize, n: usize): void {\n  let i: usize = 0;\n  const n8 = wsub(n, and(n, 7));\n  let p = src;\n  let q = dst;\n  while (i < n8) {\n    store64(q, load8(p));\n    store64(wadd(q, 8), load8(wadd(p, 1)));\n    store64(wadd(q, 16), load8(wadd(p, 2)));\n    store64(wadd(q, 24), load8(wadd(p, 3)));\n    store64(wadd(q, 32), load8(wadd(p, 4)));\n    store64(wadd(q, 40), load8(wadd(p, 5)));\n    store64(wadd(q, 48), load8(wadd(p, 6)));\n    store64(wadd(q, 56), load8(wadd(p, 7)));\n    p = wadd(p, 8);\n    q = wadd(q, 64);\n    i = wadd(i, 8);\n  }\n  while (i < n) {\n    store64(q, load8(p));\n    p = wadd(p, 1);\n    q = wadd(q, 8);\n    i = wadd(i, 1);\n  }\n}\n\n// The bytes `o[start .. start + len)` of a u8 array as a string. Traps on a value that is not an array of scalars, on a range outside\n// the array (\"slice out of range\") and on an element above 255 (\"byte out of range\").\nexport function bytesToString(o: usize, start: usize, len: usize): usize {\n  if (load32(wadd(o, 8)) != 2 || load64(wadd(o, 32)) != 0) {\n    trapShape();\n  }\n  const alen = load64(wadd(o, 16));\n  if (start > alen || len > wsub(alen, start)) {\n    taskTrap(\"slice out of range\");\n  }\n  const s = strAlloc(len, len);\n  // an empty array may have no item buffer: form an element address only when len > 0\n  if (len != 0) {\n    const bad = narrow(wadd(s, 32), wadd(load64(wadd(o, 40)), shl(start, 3)), len);\n    if (bad > 255) {\n      release(s);\n      taskTrap(\"byte out of range\");\n    }\n  }\n  return s;\n}\n\n// The bytes of a string as a u8 array.\nexport function stringToBytes(o: usize): usize {\n  if (load32(wadd(o, 8)) != 1) {\n    trapShape();\n  }\n  const len = load64(wadd(o, 16));\n  const r = arrayNew(len, 0);\n  if (len != 0) {\n    widen(load64(wadd(r, 40)), wadd(o, 32), len);\n    store64(wadd(r, 16), len);\n  }\n  return r;\n}\n" });
  out.push(SourceFile { path: "$rt/coreprobe.or", text: "// std:coreprobe -- self-test of the core operations (ADR-0052 step R3a, spec 19 section 4; hir/coreops.or).\n//\n// INTERNAL. The core operations (raw loads / stores at a usize address, platform memory functions, the object address of a\n// reference) are reachable only through the internal module std:core, which only the modules of the embedded `$rt` root\n// (runtime/core/) can import, so a test of them has to live here. It is reached as `std:coreprobe` (loader/resolve.or). `coreProbe()` runs every operation on memory it allocates itself and returns one line per\n// check; `tests/run/core_ops.or` prints it and the conformance suite compares the output on both backends (C and LLVM). It\n// touches no memory but its own allocations. Delete it when the runtime modules of R3b+ exercise the operations for real.\n\nimport {\n  load8, load32, load64, loadF64, store8, store32, store64, storeF64, memAlloc, memFree, memCopy, memSet, addrOf,\n  and, or, xor, shl, shr, expect, cfg, heapBase, memRealloc, memMove, memCmp, wadd, wsub, wmul, hook\n} from \"std:core\";\n\ntype Pair = { x: int; y: int; };\n\nfunction line(name: string, ok: bool): string {\n  return name + (ok ? \" ok\" : \" FAIL\") + \"\\n\";\n}\n\n// One line per operation: \"<name> ok\" or \"<name> FAIL\".\nexport function coreProbe(): string {\n  let out = \"\";\n  const a = memAlloc(64);\n  out += line(\"memAlloc\", a != 0);\n\n  // memSet / load8: every byte of the block, and only the low 8 bits of the value are used\n  memSet(a, 0, 64);\n  out += line(\"memSet zero\", load64(a) == 0 && load64(a + 56) == 0);\n  memSet(a, 0x1AB, 16);\n  out += line(\"memSet byte\", load8(a) == 0xAB && load8(a + 15) == 0xAB && load8(a + 16) == 0);\n  out += line(\"load8 zero-extends\", load8(a) == 171);\n\n  // store8 / store32 / store64 and the loads, at unaligned addresses too\n  memSet(a, 0, 64);\n  store8(a, 0x1FF);\n  out += line(\"store8 low byte\", load8(a) == 255 && load8(a + 1) == 0);\n  store32(a + 4, 0x1DEADBEEF);\n  out += line(\"store32 low word\", load32(a + 4) == 0xDEADBEEF && load32(a + 8) == 0);\n  out += line(\"load32 zero-extends\", load32(a + 4) == 3735928559);\n  store64(a + 8, 0x0123456789ABCDEF);\n  out += line(\"store64\", load64(a + 8) == 0x0123456789ABCDEF);\n  store64(a + 17, 18446744073709551615);\n  out += line(\"load64 unaligned\", load64(a + 17) == 18446744073709551615 && load8(a + 16) == 0 && load8(a + 25) == 0);\n  store32(a + 33, 1);\n  out += line(\"load32 unaligned\", load32(a + 33) == 1);\n  out += line(\"native order\", load8(a + 8) == load64(a + 8) - (load64(a + 8) / 256) * 256);\n\n  // floats\n  storeF64(a + 40, 1.5);\n  out += line(\"storeF64 / loadF64\", loadF64(a + 40) == 1.5);\n  storeF64(a + 41, -0.25);\n  out += line(\"loadF64 unaligned\", loadF64(a + 41) == -0.25);\n  store64(a + 48, 0x3FF0000000000000);\n  out += line(\"loadF64 bits\", loadF64(a + 48) == 1.0);\n  storeF64(a + 48, 2.0);\n  out += line(\"storeF64 bits\", load64(a + 48) == 0x4000000000000000);\n\n  // memCopy\n  const b = memAlloc(64);\n  memSet(b, 7, 64);\n  memCopy(b + 3, a + 8, 8);\n  out += line(\"memCopy\", load64(b + 3) == 0x0123456789ABCDEF && load8(b + 2) == 7 && load8(b + 11) == 7);\n  memCopy(b, a, 0);\n  out += line(\"memCopy zero length\", load8(b) == 7);\n\n  // memAlloc(0) is a valid block of one byte, never address 0\n  const z = memAlloc(0);\n  out += line(\"memAlloc zero\", z != 0);\n  store8(z, 9);\n  out += line(\"memAlloc zero usable\", load8(z) == 9);\n\n  // addrOf: the object address of a reference; stable, distinct per object, and it leaves the object alone\n  const s = \"core\";\n  const t = \"dore\";\n  const xs: int[] = [1, 2, 3];\n  out += line(\"addrOf string\", addrOf(s) != 0 && addrOf(s) == addrOf(s) && addrOf(s) != addrOf(t));\n  out += line(\"addrOf array\", addrOf(xs) != 0 && addrOf(xs) == addrOf(xs) && addrOf(xs) != addrOf(s));\n  out += line(\"addrOf aligned\", addrOf(s) / 8 * 8 == addrOf(s) && addrOf(xs) / 8 * 8 == addrOf(xs));\n  out += line(\"addrOf leaves value\", s == \"core\" && xs.length == 3 && xs[2] == 3);\n\n  // addrOf needs the real object (ADR-0052 Addendum A, rule 2): the optimiser must not unbox the record or scalar-replace the\n  // array, so the layout is there: string len@16 data@32, array len@16 items@40 (a pointer to the buffer), struct nslots@16 slots@32\n  const u = \"wxyz\";\n  const pr = Pair { x: 7, y: 9 };\n  const ys: int[] = [4, 5, 6];\n  out += line(\"addrOf string layout\", load64(addrOf(u) + 16) == 4 && load8(addrOf(u) + 32) == 119 && load8(addrOf(u) + 35) == 122);\n  out += line(\"addrOf array layout\", load64(addrOf(ys) + 16) == 3 && load64(load64(addrOf(ys) + 40)) == 4 && load64(load64(addrOf(ys) + 40) + 16) == 6);\n  out += line(\"addrOf record layout\", load64(addrOf(pr) + 16) == 2 && load64(addrOf(pr) + 32) == 7 && load64(addrOf(pr) + 40) == 9);\n\n  // bit operations on usize\n  out += line(\"and\", and(0xF0F0, 0xFF00) == 0xF000 && and(18446744073709551615, 5) == 5);\n  out += line(\"or\", or(0xF0F0, 0x0F0F) == 0xFFFF && or(0, 0) == 0);\n  out += line(\"xor\", xor(0xFF, 0x0F) == 0xF0 && xor(18446744073709551615, 18446744073709551615) == 0);\n  out += line(\"shl\", shl(1, 3) == 8 && shl(1, 63) == 9223372036854775808 && shl(3, 63) == 9223372036854775808);\n  out += line(\"shl 64 or more\", shl(1, 64) == 0 && shl(18446744073709551615, 200) == 0);\n  out += line(\"shr\", shr(256, 4) == 16 && shr(18446744073709551615, 63) == 1 && shr(5, 0) == 5);\n  out += line(\"shr 64 or more\", shr(18446744073709551615, 64) == 0 && shr(1, 1000) == 0);\n  out += line(\"shr is logical\", shr(9223372036854775808, 62) == 2);\n  const refmask: usize = 5;\n  out += line(\"bit test\", and(shr(refmask, 2), 1) == 1 && and(shr(refmask, 1), 1) == 0);\n\n  // wrapping arithmetic on usize: no overflow trap\n  out += line(\"wadd\", wadd(1, 2) == 3 && wadd(18446744073709551615, 2) == 1 && wadd(18446744073709551615, 1) == 0);\n  out += line(\"wsub\", wsub(5, 3) == 2 && wsub(0, 1) == 18446744073709551615 && wsub(3, 3) == 0);\n  out += line(\"wmul\", wmul(6, 7) == 42 && wmul(9223372036854775808, 2) == 0 && wmul(4294967296, 4294967296) == 0);\n\n  // expect is the identity on its first argument\n  const yes = a != 0;\n  out += line(\"expect\", expect(yes, true) && !expect(!yes, true) && expect(yes, false) && !expect(!yes, false));\n\n  // cfg: 0 or 1 for the three switches, 0 for an unknown number\n  out += line(\"cfg\", cfg(0) <= 1 && cfg(1) <= 1 && cfg(2) <= 1 && cfg(3) == 0 && cfg(100) == 0);\n\n  // heapBase: a stable 8-aligned address; word 63 (byte 504) is ours (`probe` of OrinHeap) (zero at first, then what we store)\n  const h = heapBase();\n  out += line(\"heapBase\", h != 0 && h == heapBase() && h / 8 * 8 == h);\n  out += line(\"heapBase zeroed\", load64(h + 504) == 0);\n  store64(h + 504, 77);\n  out += line(\"heapBase usable\", load64(h + 504) == 77 && load64(heapBase() + 504) == 77);\n  store64(h + 504, 0);\n\n  // memRealloc keeps the contents, grows and shrinks, and a size of 0 is one byte\n  const c = memAlloc(16);\n  store64(c, 0x1122334455667788);\n  store64(c + 8, 0x99AABBCCDDEEFF00);\n  const c2 = memRealloc(c, 4096);\n  out += line(\"memRealloc grow\", c2 != 0 && load64(c2) == 0x1122334455667788 && load64(c2 + 8) == 0x99AABBCCDDEEFF00);\n  store8(c2 + 4095, 5);\n  out += line(\"memRealloc usable\", load8(c2 + 4095) == 5);\n  const c3 = memRealloc(c2, 8);\n  out += line(\"memRealloc shrink\", c3 != 0 && load64(c3) == 0x1122334455667788);\n  const c4 = memRealloc(c3, 0);\n  out += line(\"memRealloc zero\", c4 != 0 && load8(c4) == 0x88);\n\n  // memMove: overlapping ranges in both directions\n  memSet(b, 0, 64);\n  store64(b, 0x0807060504030201);\n  memMove(b + 2, b, 8);\n  out += line(\"memMove up\", load8(b) == 1 && load8(b + 1) == 2 && load8(b + 2) == 1 && load8(b + 9) == 8);\n  memMove(b, b + 2, 8);\n  out += line(\"memMove down\", load8(b) == 1 && load8(b + 7) == 8);\n  memMove(b, a, 0);\n  out += line(\"memMove zero length\", load8(b) == 1);\n\n  // memCmp: -1, 0, 1 by the first differing byte, bytes compare unsigned\n  const x = memAlloc(8);\n  const y = memAlloc(8);\n  memSet(x, 3, 8);\n  memSet(y, 3, 8);\n  out += line(\"memCmp equal\", memCmp(x, y, 8) == 0 && memCmp(x, y, 0) == 0);\n  store8(y + 5, 4);\n  out += line(\"memCmp less\", memCmp(x, y, 8) == -1 && memCmp(x, y, 5) == 0);\n  out += line(\"memCmp greater\", memCmp(y, x, 8) == 1);\n  store8(y + 1, 200);\n  out += line(\"memCmp unsigned\", memCmp(x, y, 8) == -1 && memCmp(y, x, 8) == 1);\n  memFree(y);\n  memFree(x);\n\n  // hook: the runtime lock can be taken and released (hooks 1, 2), the totals of finished tasks have addresses (hooks 4, 5), and the\n  // build says whether the hot counters are on (hook 6: 0 or 1)\n  hook(1, 0, 0, 0);\n  hook(2, 0, 0, 0);\n  out += line(\"hook\", hook(4, 0, 0, 0) != 0 && hook(5, 0, 0, 0) != 0 && hook(6, 1, 2, 3) <= 1);\n\n  memFree(c4);\n  memFree(z);\n  memFree(b);\n  memFree(a);\n  out += line(\"memFree\", true);\n  return out;\n}\n\n// A failed allocation traps \"out of memory\" (exit 101) instead of returning 0: `tests/run/core_oom_trap.or`.\nexport function coreOom(): usize {\n  return memAlloc(18446744073709551600);\n}\n\n// The same for memRealloc.\nexport function coreOomRealloc(): usize {\n  const p = memAlloc(8);\n  return memRealloc(p, 18446744073709551600);\n}\n" });
  out.push(SourceFile { path: "$rt/heap.or", text: "// $rt/heap -- the per-thread heap block and the small-block cache, written in Orin (ADR-0052 Addendum A, step R3d.3).\n//\n// Every task / thread has one zero-initialised block (`OrinHeap`, 1024 bytes, `heapBase()`): the free lists of struct objects and\n// array headers, the live-object balance, the work stack of `destroy`, the counters (`OrinStats`) and the small-block cache. The\n// offsets are the ones pinned by the _Static_asserts of runtime/core/orin_runtime.h (spec 19 \"R3d.1\"). A block is plain malloc\n// memory, so a node that came from another thread's heap joins this one's list (capped by FL_CAP / SB_CAP).\n//\n// Address arithmetic uses the wrapping core operations `wadd`, `wsub`, `wmul` (hir/coreops.or): the checked `+` of the language\n// would add a trap path to every access. The free lists and the small-block cache exist only when `cfg(0) == 1` (off under\n// ASan / MSan and with -DORIN_NO_FREELIST: then every block goes straight to the allocator, as before), the counters only when\n// `cfg(1) == 1` (-DORIN_STATS_ENABLED). The configuration is a constant, so the dead code folds away.\n//\n// Object layout (frozen, spec 19): header rc@0 kind@8 tag@12 (16 bytes); string len@16 cap@24 data@32; array len@16 cap@24\n// is_ref@32 items@40; struct nslots@16 refmask@24 slots@32; kinds string 1, array 2, struct 3.\n\nimport { load64, store64, memAlloc, memFree, memRealloc, memCopy, heapBase, cfg, hook, wadd, wsub, shl, shr, xor } from \"std:core\";\n\n// ---------------------------------------------------------------- offsets in the heap block\n\nexport const FL_STRUCT: usize = 0;   // free struct objects by nslots 0..8, 8 bytes each\nexport const FL_ARRAY: usize = 72;   // free array headers\nexport const FL_N: usize = 80;       // list lengths: [nslots] for structs, [9] (@152) for the array headers\nexport const LIVE: usize = 160;      // live objects of this heap (signed)\nexport const DSTACK: usize = 168;    // the work stack of destroy (0 until first use)\nexport const DCAP: usize = 176;      // its capacity in entries\nexport const S_ALLOC_STRING: usize = 192;\nexport const S_ALLOC_ARRAY: usize = 200;\nexport const S_ALLOC_STRUCT: usize = 208;\nexport const S_FREES: usize = 216;\nexport const S_RETAINS: usize = 224;\nexport const S_RELEASES: usize = 232;\nexport const S_COW_COPIES: usize = 240;\nexport const S_COW_INPLACE: usize = 248;\nexport const S_ARRAY_GROWS: usize = 256;\nexport const S_STRING_GROWS: usize = 264;\nexport const S_PEAK_LIVE_OBJS: usize = 272;\nexport const S_PEAK_LIVE_BYTES: usize = 280;\nexport const S_LIVE_BYTES: usize = 288;\nexport const S_FILE_OPENS: usize = 296;\nexport const S_FILE_CLOSES: usize = 304;\nexport const S_TRANSFER_MOVES: usize = 312;\nexport const S_TRANSFER_COPIES: usize = 320;\nexport const S_TASKS_SPAWNED: usize = 328;\nexport const SB: usize = 512;        // small-block cache: 17 classes of {head, length}, 16 bytes each\n\nexport const FL_CAP: usize = 262144;  // 2^18 objects per free list\nexport const SB_CAP: usize = 32768;   // 2^15 blocks per small-block class\nexport const SB_MAX: usize = 256;     // the largest cached block\n\nconst SIGN: usize = 9223372036854775808;\n\n// ---------------------------------------------------------------- C runtime hooks and the allocation-site census\n\n// The services of the C runtime that Orin code reaches through the core operation `hook` (orin_core_hook in runtime/core/orin_runtime.c\n// lists the same numbers): the process environment and stderr, the runtime lock, the totals of finished tasks, the census.\nexport const HK_GETENV: usize = 0;       // (name: C string) -> the value (C string) or 0\nexport const HK_LOCK: usize = 1;         // take the runtime lock\nexport const HK_UNLOCK: usize = 2;       // release it\nexport const HK_WRITE_LINE: usize = 3;   // (buf, n): n bytes and a newline on stderr\nexport const HK_FOLD_STATS: usize = 4;   // -> the address of the OrinStats of the finished tasks (under the lock)\nexport const HK_FOLD_LIVE: usize = 5;    // -> the address of their live-object balance (an i64)\nexport const HK_STATS_ON: usize = 6;     // -> 1 when the runtime was built with the hot counters (ORIN_STATS_ENABLED)\nexport const HK_SITE_ALLOC: usize = 7;   // (o, kind 0 string 1 value array 2 reference array 3 struct, bytes): census, a new object\nexport const HK_SITE_GROW: usize = 8;    // (o, bytes): census, a buffer of `o` grew\nexport const HK_SITE_FREE: usize = 9;    // (o): census, `o` is being freed\nexport const HK_SITE_RC: usize = 10;     // (o, what: 0 retain 1 release 2 copy-on-write copy): census, a reference-count operation\nexport const HK_SITE_REPORT: usize = 11; // the census table (ORIN_STATS=sites)\n\n// The census prefix word (ADR-0052 Addendum A, rule 4): in a census build (cfg 2) every heap object is preceded by 8 bytes holding the\n// site that allocated it, so the offsets of the object layout are the same in all builds. `pfx()` is that size (0 in a normal build).\n// The address of an object is the address of its block plus `pfx()`; a free list holds the block address (the link is stored in the\n// first word of the block, the prefix word in a census build).\n@Inline\nexport function pfx(): usize {\n  return shl(cfg(2), 3);\n}\n\n// Census: `o` was allocated (kind 0 string, 1 value array, 2 reference array, 3 struct; `bytes` as a normal build lays it out).\n@Inline\nexport function siteAlloc(o: usize, kind: usize, bytes: usize): void {\n  if (cfg(2) == 1) {\n    hook(HK_SITE_ALLOC, o, kind, bytes);\n  }\n}\n\n// Census: a buffer of `o` grew by `bytes`.\n@Inline\nexport function siteGrow(o: usize, bytes: usize): void {\n  if (cfg(2) == 1) {\n    hook(HK_SITE_GROW, o, bytes, 0);\n  }\n}\n\n// Census: `o` is being freed.\n@Inline\nexport function siteFree(o: usize): void {\n  if (cfg(2) == 1) {\n    hook(HK_SITE_FREE, o, 0, 0);\n  }\n}\n\n// Census: a reference-count operation on `o` (0 retain, 1 release, 2 copy-on-write copy).\n@Inline\nexport function siteRc(o: usize, what: usize): void {\n  if (cfg(2) == 1) {\n    hook(HK_SITE_RC, o, what, 0);\n  }\n}\n\n// ---------------------------------------------------------------- word helpers\n\n// word at `p` += d (wrapping)\n@Inline\nexport function addAt(p: usize, d: usize): void {\n  store64(p, wadd(load64(p), d));\n}\n\n// word at `p` -= d (wrapping)\n@Inline\nexport function subAt(p: usize, d: usize): void {\n  store64(p, wsub(load64(p), d));\n}\n\n// True when a reference count is positive as a signed 64-bit number: a live object (not immortal, not lend-pinned).\n@Inline\nexport function isLive(rc: usize): bool {\n  return wsub(rc, 1) < 9223372036854775807;\n}\n\n// ---------------------------------------------------------------- accounting (the static counters, hot path under cfg(1))\n\n// One more object, `bytes` more live bytes, and the peaks. `counter` is the offset of the kind's allocation counter.\n@Inline\nexport function statAlloc(counter: usize, bytes: usize): void {\n  if (cfg(1) == 1) {\n    const h = heapBase();\n    addAt(wadd(h, counter), 1);\n    const lb = wadd(load64(wadd(h, S_LIVE_BYTES)), bytes);\n    store64(wadd(h, S_LIVE_BYTES), lb);\n    if (xor(lb, SIGN) > xor(load64(wadd(h, S_PEAK_LIVE_BYTES)), SIGN)) {\n      store64(wadd(h, S_PEAK_LIVE_BYTES), lb);\n    }\n    const lv = load64(wadd(h, LIVE));\n    if (xor(lv, SIGN) > xor(load64(wadd(h, S_PEAK_LIVE_OBJS)), SIGN)) {\n      store64(wadd(h, S_PEAK_LIVE_OBJS), lv);\n    }\n  }\n}\n\n// `bytes` more live bytes (a buffer grew) and the peak.\n@Inline\nexport function statGrow(bytes: usize): void {\n  if (cfg(1) == 1) {\n    const h = heapBase();\n    const lb = wadd(load64(wadd(h, S_LIVE_BYTES)), bytes);\n    store64(wadd(h, S_LIVE_BYTES), lb);\n    if (xor(lb, SIGN) > xor(load64(wadd(h, S_PEAK_LIVE_BYTES)), SIGN)) {\n      store64(wadd(h, S_PEAK_LIVE_BYTES), lb);\n    }\n  }\n}\n\n// One more live object (the balance may go negative on a task that frees what another allocated: it is signed).\n@Inline\nexport function liveInc(): void {\n  addAt(wadd(heapBase(), LIVE), 1);\n}\n\n// One object freed: the live balance and the `frees` counter.\n@Inline\nexport function liveDec(): void {\n  subAt(wadd(heapBase(), LIVE), 1);\n  if (cfg(1) == 1) {\n    addAt(wadd(heapBase(), S_FREES), 1);\n  }\n}\n\n// ---------------------------------------------------------------- small-block cache (variable-size buffers <= SB_MAX)\n\n// A buffer of `n` bytes: string objects (sizeof(OrinString) + cap + 1) and array item buffers (cap * 8). Blocks of at most\n// SB_MAX bytes are rounded up to a 16-byte class and taken from the class list when it has one; a block can sit on any thread's\n// list and needs no header, because its free passes the same size.\n@Inline\nexport function sbAlloc(n: usize): usize {\n  if (cfg(0) == 1 && n <= 256) {\n    const c = shr(wadd(n, 15), 4);\n    const q = wadd(wadd(heapBase(), SB), shl(c, 4));\n    const f = load64(q);\n    if (f != 0) {\n      store64(q, load64(f));\n      subAt(wadd(q, 8), 1);\n      return f;\n    }\n    return memAlloc(shl(c, 4));\n  }\n  return memAlloc(n);\n}\n\n// Return the block `p` of `n` bytes to the cache, or to the allocator when the class is full or the block is large.\n@Inline\nexport function sbFree(p: usize, n: usize): void {\n  if (cfg(0) == 1 && n <= 256) {\n    const c = shr(wadd(n, 15), 4);\n    const q = wadd(wadd(heapBase(), SB), shl(c, 4));\n    if (load64(wadd(q, 8)) < 32768) {\n      store64(p, load64(q));\n      store64(q, p);\n      addAt(wadd(q, 8), 1);\n      return;\n    }\n  }\n  memFree(p);\n}\n\n// Grow (or shrink) the buffer `p` (0 when `old` is 0) from `old` to `n` bytes. Large buffers keep the in-place growth of `realloc`; a\n// small one stays where it is while it fits its 16-byte class, else it moves to a block of the new class.\nexport function sbRealloc(p: usize, old: usize, n: usize): usize {\n  if (cfg(0) == 0) {\n    return memRealloc(p, n);\n  }\n  if (old > 256 && n > 256) {\n    return memRealloc(p, n);\n  }\n  if (p != 0 && old <= 256 && n <= 256 && shr(wadd(old, 15), 4) == shr(wadd(n, 15), 4)) {\n    return p;\n  }\n  const q = sbAlloc(n);\n  if (p != 0) {\n    memCopy(q, p, old < n ? old : n);\n    sbFree(p, old);\n  }\n  return q;\n}\n" });
  out.push(SourceFile { path: "$rt/leaf.or", text: "// $rt/leaf -- the leaves of the object model without allocator state, written in Orin (ADR-0052 Addendum A, step R3d.2).\n//\n// The backends call these functions by name (compiler/mir/rt.or lists them; opt/prune.or keeps them) in place of the C runtime\n// functions of the same name (`orin_opt_unwrap`, `orin_res_unwrap`, `orin_res_unwrap_err`, `orin_v_unwrap`, `orin_trap_shape`,\n// `orin_assert_fact`, `orin_assert_array`), which the frozen snapshot bootstrap/seed/runtime/ keeps for the seed and `--c-builtins`.\n// An object is its address as a `usize`: the emitted call casts the pointer (the language cannot forge a reference). The\n// layout is the frozen one (spec 19, rule 3 of Addendum A section 2): kind@8 tag@12; struct nslots@16 slots@32; array len@16\n// items@40; kinds string 1, array 2, struct 3. A trap is `taskTrap`: the message of the C `orin_trap` (stdout flushed,\n// `trap: <msg>` on stderr, exit 101, and a trap on a task ends that task only).\n\nimport { load32, load64 } from \"std:core\";\nimport { taskTrap } from \"std:fsraw\";\nimport { exit } from \"std:process\";\n\n// The trap of every checked field or element access on an object of the wrong shape (docs/assurance.md \"shape confusion\").\nexport function trapShape(): void {\n  taskTrap(\"field access on a value of the wrong shape (compiler bug)\");\n}\n\n// Slot 0 of the struct at `o`: a struct with at least one slot, else the shape trap.\n@Inline\nfunction slot0(o: usize): usize {\n  if (load32(o + 8) != 3 || load32(o + 16) == 0) {\n    trapShape();\n  }\n  return load64(o + 32);\n}\n\n// `opt.unwrap()`: the payload slot of Some (tag 0).\n@Inline\nexport function optUnwrap(o: usize): usize {\n  if (load32(o + 12) != 0) {\n    taskTrap(\"unwrap on None\");\n  }\n  return slot0(o);\n}\n\n// `res.unwrap()`: the payload slot of Ok (tag 0), 0 for an Ok without payload.\n@Inline\nexport function resUnwrap(o: usize): usize {\n  if (load32(o + 12) != 0) {\n    taskTrap(\"unwrap on Err\");\n  }\n  if (load32(o + 8) == 3 && load32(o + 16) == 0) {\n    return 0;\n  }\n  return slot0(o);\n}\n\n// `res.unwrapErr()`: the payload slot of Err (tag 1).\n@Inline\nexport function resUnwrapErr(o: usize): usize {\n  if (load32(o + 12) != 1) {\n    taskTrap(\"unwrapErr on Ok\");\n  }\n  return slot0(o);\n}\n\n// The unboxed Option / Result (docs/mir.md v2.2): `word` when `tag` is the expected one, else the trap of the boxed builtin.\n// what: 0 = Option.unwrap (tag 0), 1 = Result.unwrap (tag 0), 2 = Result.unwrapErr (tag 1).\n@Inline\nexport function vUnwrap(tag: usize, word: usize, what: int): usize {\n  if (what == 0 && tag != 0) {\n    taskTrap(\"unwrap on None\");\n  }\n  if (what == 1 && tag != 0) {\n    taskTrap(\"unwrap on Err\");\n  }\n  if (what == 2 && tag != 1) {\n    taskTrap(\"unwrapErr on Ok\");\n  }\n  return word;\n}\n\n// `orin2 compile --assert-facts` (docs/mir.md v2.4): the dynamic check of a forwarded load. `got` is the value an IForward\n// claimed for slot `key` of `o` (a field index or an array index); the slot itself is read here, as the original getfield /\n// arrayget would have. A difference is an optimiser or verifier bug, not a program error: exit 70 (internal error).\nexport function assertFact(o: usize, key: usize, got: usize): void {\n  const kind = load32(o + 8);\n  let want: usize = 0;\n  let why = \"\";\n  if (kind == 3 && key < load32(o + 16)) {\n    want = load64(o + 32 + key * 8);\n  } else if (kind == 2 && key < load64(o + 16)) {\n    want = load64(load64(o + 40) + key * 8);\n  } else {\n    why = \"internal error: --assert-facts: a forwarded load names a slot that does not exist\";\n  }\n  if (why == \"\" && want != got) {\n    why = \"internal error: --assert-facts: a forwarded load differs from the slot it was forwarded from\";\n  }\n  if (why != \"\") {\n    console.error(why);\n    exit(70);\n  }\n}\n\n// `orin2 compile --assert-facts` (docs/mir.md v2.6, rule U1): the kind check and the bounds check that an IArrayGetU /\n// IArraySetU leaves out, executed before it. A failure is a verifier or optimiser bug: exit 70 (internal error).\nexport function assertArray(o: usize, i: usize): void {\n  let why = \"\";\n  if (load32(o + 8) != 2) {\n    why = \"internal error: --assert-facts: an unchecked array access on an object that is not an array\";\n  } else if (i >= load64(o + 16)) {\n    why = \"internal error: --assert-facts: an unchecked array access is out of bounds\";\n  }\n  if (why != \"\") {\n    console.error(why);\n    exit(70);\n  }\n}\n" });
  out.push(SourceFile { path: "$rt/module.or", text: "// $rt entry: the runtime core written in Orin (ADR-0052 Addendum A). Loaded implicitly into every program.\nexport { rtLayoutVersion } from \"./rt\";\nexport { trapShape, optUnwrap, resUnwrap, resUnwrapErr, vUnwrap, assertFact, assertArray } from \"./leaf\";\nexport { structNew, variant1, arrayNew, strAlloc, arrayPushGrow } from \"./object\";\nexport { sbAlloc, sbFree, sbRealloc } from \"./heap\";\nexport { destroy, makeUniqueSlow } from \"./rc\";\nexport {\n  strConcat, strAppend, strAppendSub, strAppendUsize, strAppendInt, strPrepend\n} from \"./str\";\nexport { arraySlice, arrayConcat, arrayExtend, bytesToString, stringToBytes } from \"./array\";\nexport { statsReport, liveCount } from \"./stats\";\n" });
  out.push(SourceFile { path: "$rt/object.or", text: "// $rt/object -- allocation of structs and arrays, written in Orin (ADR-0052 Addendum A, step R3d.3 (a)).\n//\n// The backends call these functions by name (compiler/mir/rt.or lists them; opt/prune.or keeps them) in place of the C runtime\n// functions `orin_struct_new`, `orin_variant1` and `orin_array_new`; the C shells of the runtime reach them through the\n// exported wrappers of the same names that the emitted code defines. An object is its address as a `usize`. The layout and the\n// heap block are described in heap.or. A failed allocation traps \"out of memory\" in `memAlloc` itself. Counters and the\n// live-object balance are updated exactly as the C versions did (the ORIN_STATS=1 report is the equivalence oracle). In a census build\n// (cfg 2) each object is preceded by the census prefix word (heap.or `pfx`) and the allocation is reported to the census (`siteAlloc`).\n\nimport { load64, store8, store32, store64, memAlloc, memSet, heapBase, cfg, expect, wadd, wsub, wmul, shl, and } from \"std:core\";\nimport { taskTrap } from \"std:fsraw\";\nimport {\n  sbAlloc, sbRealloc, subAt, addAt, liveInc, statAlloc, statGrow, pfx, siteAlloc, siteGrow, S_ALLOC_STRING, S_ALLOC_STRUCT,\n  S_ALLOC_ARRAY, S_ARRAY_GROWS, FL_ARRAY, FL_N\n} from \"./heap\";\n\n// A new struct with all slots zero (null refs): `nslots` slots of 8 bytes behind the 32-byte header, rc 1. `refmask` bit i set:\n// slot i is a reference (at most 64 slots).\n@Inline\nexport function structNew(tag: usize, nslots: usize, refmask: usize): usize {\n  if (nslots > 64) {\n    taskTrap(\"struct has more than 64 slots\");\n  }\n  let s: usize = 0;\n  if (cfg(0) == 1 && nslots < 9) {\n    // the free list of this size: the next pointer is word 0 of a free object\n    const lp = wadd(heapBase(), shl(nslots, 3));\n    const head = load64(lp);\n    if (expect(head != 0, true)) {\n      store64(lp, load64(head));\n      subAt(wadd(wadd(heapBase(), FL_N), shl(nslots, 3)), 1);\n      s = wadd(head, pfx());\n    }\n  }\n  if (s == 0) {\n    s = wadd(memAlloc(wadd(wadd(32, shl(nslots, 3)), pfx())), pfx());\n  }\n  store64(s, 1);\n  store32(wadd(s, 8), 3);\n  store32(wadd(s, 12), tag);\n  store32(wadd(s, 16), nslots);\n  store32(wadd(s, 20), 0);\n  store64(wadd(s, 24), refmask);\n  // small records dominate: plain stores, no loop and no call\n  if (nslots > 4) {\n    memSet(wadd(s, 32), 0, shl(nslots, 3));\n  } else {\n    if (nslots >= 1) {\n      store64(wadd(s, 32), 0);\n    }\n    if (nslots >= 2) {\n      store64(wadd(s, 40), 0);\n    }\n    if (nslots >= 3) {\n      store64(wadd(s, 48), 0);\n    }\n    if (nslots >= 4) {\n      store64(wadd(s, 56), 0);\n    }\n  }\n  liveInc();\n  statAlloc(S_ALLOC_STRUCT, wadd(32, shl(nslots, 3)));\n  siteAlloc(s, 3, wadd(32, shl(nslots, 3)));\n  return s;\n}\n\n// A variant with one slot; consumes the slot's reference if the slot is a ref (`refmask` 0 or 1).\n@Inline\nexport function variant1(tag: usize, refmask: usize, slot: usize): usize {\n  const o = structNew(tag, 1, and(refmask, 1));\n  store64(wadd(o, 32), slot);\n  return o;\n}\n\n// A new empty array of capacity `cap`; `isRef` != 0: the elements are references (retained / released).\n@Inline\nexport function arrayNew(cap: usize, isRef: usize): usize {\n  if (cap > 1099511627776) {\n    taskTrap(\"array too large\");\n  }\n  let a: usize = 0;\n  if (cfg(0) == 1) {\n    const lp = wadd(heapBase(), FL_ARRAY);\n    const head = load64(lp);\n    if (head != 0) {\n      store64(lp, load64(head));\n      subAt(wadd(wadd(heapBase(), FL_N), 72), 1);\n      a = wadd(head, pfx());\n    }\n  }\n  if (a == 0) {\n    a = wadd(memAlloc(wadd(48, pfx())), pfx());\n  }\n  store64(a, 1);\n  store32(wadd(a, 8), 2);\n  store32(wadd(a, 12), 0);\n  store64(wadd(a, 16), 0);\n  store64(wadd(a, 24), cap);\n  store64(wadd(a, 32), isRef != 0 ? 1 : 0);\n  store64(wadd(a, 40), cap != 0 ? sbAlloc(shl(cap, 3)) : 0);\n  liveInc();\n  statAlloc(S_ALLOC_ARRAY, wadd(48, shl(cap, 3)));\n  siteAlloc(a, isRef != 0 ? 2 : 1, wadd(48, shl(cap, 3)));\n  return a;\n}\n\n// A new string object of length `len` and capacity `cap` (at least `len`; the bytes are not written, the NUL terminator is): the\n// object and its data are one block of 32 + cap + 1 bytes.\n@Inline\nexport function strAlloc(len: usize, cap0: usize): usize {\n  const cap = cap0 < len ? len : cap0;\n  if (cap > 281474976710656) {\n    taskTrap(\"string too large\");\n  }\n  const total = wadd(cap, 33);\n  const s = wadd(sbAlloc(wadd(total, pfx())), pfx());\n  store64(s, 1);\n  store32(wadd(s, 8), 1);\n  store32(wadd(s, 12), 0);\n  store64(wadd(s, 16), len);\n  store64(wadd(s, 24), cap);\n  store8(wadd(wadd(s, 32), len), 0);\n  liveInc();\n  statAlloc(S_ALLOC_STRING, total);\n  siteAlloc(s, 0, total);\n  return s;\n}\n\n// `push` on a full array (len == cap): double the item buffer (4 slots at first), then store `slot`.\nexport function arrayPushGrow(o: usize, slot: usize): void {\n  const cap0 = load64(wadd(o, 24));\n  const cap = cap0 != 0 ? wmul(cap0, 2) : 4;\n  const items = sbRealloc(load64(wadd(o, 40)), shl(cap0, 3), shl(cap, 3));\n  store64(wadd(o, 40), items);\n  statGrow(shl(wsub(cap, cap0), 3));\n  if (cfg(1) == 1) {\n    addAt(wadd(heapBase(), S_ARRAY_GROWS), 1);\n  }\n  siteGrow(o, shl(wsub(cap, cap0), 3));\n  store64(wadd(o, 24), cap);\n  const len = load64(wadd(o, 16));\n  store64(wadd(items, shl(len, 3)), slot);\n  store64(wadd(o, 16), wadd(len, 1));\n}\n" });
  out.push(SourceFile { path: "$rt/rc.or", text: "// $rt/rc -- destroy and copy-on-write, written in Orin (ADR-0052 Addendum A, step R3d.3 (b)).\n//\n// `destroy` frees an object whose count reached 0 (iterative, so long chains and deep trees cannot overflow the stack; the work\n// stack is per task and lives in the heap block), `makeUniqueSlow` is the copying path of `make_unique`. The backends call them by\n// name in place of `orin_destroy` and `orin_make_unique_slow` (compiler/mir/rt.or); the C shells reach them through the wrappers of\n// the same names that the emitted code defines. The retain / release fast paths stay inline in the emitted code.\n//\n// A count above 0 is a live object; a count of 0 or below is immortal (static literals, the nullary objects) or pinned by a\n// lend (docs/concurrency.md, \"lending\"): neither is counted. Counters and the live balance are updated exactly as the C versions\n// did. In a census build (cfg 2) the reference-count operations, the frees and the copy-on-write copies are reported to the census\n// (`siteRc`, `siteFree`; the headers' inline retain / release of the generated C do the same), and an object's block starts `pfx()`\n// bytes before its address.\n\nimport { load32, load64, store64, memFree, memRealloc, memCopy, heapBase, cfg, wadd, wsub, wmul, shl, shr, and } from \"std:core\";\nimport {\n  isLive, addAt, subAt, liveDec, sbFree, pfx, siteFree, siteRc, FL_STRUCT, FL_ARRAY, FL_N, FL_CAP, DSTACK, DCAP, S_RELEASES, S_RETAINS,\n  S_COW_COPIES, S_LIVE_BYTES\n} from \"./heap\";\nimport { structNew, arrayNew, strAlloc } from \"./object\";\n\n// One reference dropped: true when the count of the live object `c` reached 0 (the caller destroys it). Immortal, pinned and null\n// references are left alone.\n@Inline\nfunction decRef(c: usize): bool {\n  if (c != 0) {\n    const rc = load64(c);\n    if (isLive(rc)) {\n      if (cfg(1) == 1) {\n        addAt(wadd(heapBase(), S_RELEASES), 1);\n      }\n      siteRc(c, 1);\n      const n = wsub(rc, 1);\n      store64(c, n);\n      return n == 0;\n    }\n  }\n  return false;\n}\n\n// One reference taken (`orin_retain`): a live object's count goes up, an immortal one is left alone.\n@Inline\nexport function retain(o: usize): void {\n  const rc = load64(o);\n  if (isLive(rc)) {\n    store64(o, wadd(rc, 1));\n    if (cfg(1) == 1) {\n      addAt(wadd(heapBase(), S_RETAINS), 1);\n    }\n    siteRc(o, 0);\n  }\n}\n\n// One reference dropped (`orin_release`): the count of a live object goes down and the object is destroyed at 0; an immortal or\n// pinned object is left alone. `o` is not null.\n@Inline\nexport function release(o: usize): void {\n  const rc = load64(o);\n  if (isLive(rc)) {\n    if (cfg(1) == 1) {\n      addAt(wadd(heapBase(), S_RELEASES), 1);\n    }\n    siteRc(o, 1);\n    const n = wsub(rc, 1);\n    store64(o, n);\n    if (n == 0) {\n      destroy(o);\n    }\n  }\n}\n\n// The work stack outgrew its capacity `scap` (0 before the first use): twice as many entries, 256 at first. The new block and\n// capacity are stored in the heap block; returns the capacity.\nfunction growStack(scap: usize): usize {\n  const h = heapBase();\n  const ncap = scap != 0 ? wmul(scap, 2) : 256;\n  store64(wadd(h, DSTACK), memRealloc(load64(wadd(h, DSTACK)), shl(ncap, 3)));\n  store64(wadd(h, DCAP), ncap);\n  return ncap;\n}\n\n// Free the object `o` (count 0) and every child whose count reaches 0 through it. The first dying child of an object is freed next\n// without a trip through the work stack (`cur`), the others wait on the stack: the order differs from a plain stack, the set of freed\n// objects does not. A freed struct or array header goes back on its free list (capped by FL_CAP); a string and an item buffer go to\n// the small-block cache; the rest to the allocator.\nexport function destroy(o: usize): void {\n  const h = heapBase();\n  let stack = load64(wadd(h, DSTACK));\n  let scap = load64(wadd(h, DCAP));\n  let sp: usize = 0;\n  let cur = o;\n  while (cur != 0 || sp != 0) {\n    if (cur == 0) {\n      sp = wsub(sp, 1);\n      cur = load64(wadd(stack, shl(sp, 3)));\n    }\n    const x = cur;\n    cur = 0;\n    siteFree(x);\n    const base = wsub(x, pfx());\n    const kind = load32(wadd(x, 8));\n    let recycled = false;\n    if (kind == 2) {\n      // array: release the elements of a reference array, free the item buffer, recycle the header\n      const cap = load64(wadd(x, 24));\n      const items = load64(wadd(x, 40));\n      if (load64(wadd(x, 32)) != 0) {\n        const len = load64(wadd(x, 16));\n        let p = items;\n        let i: usize = 0;\n        while (i < len) {\n          const c = load64(p);\n          if (decRef(c)) {\n            if (cur == 0) {\n              cur = c;\n            } else {\n              if (sp == scap) {\n                scap = growStack(scap);\n                stack = load64(wadd(h, DSTACK));\n              }\n              store64(wadd(stack, shl(sp, 3)), c);\n              sp = wadd(sp, 1);\n            }\n          }\n          p = wadd(p, 8);\n          i = wadd(i, 1);\n        }\n      }\n      if (cfg(1) == 1) {\n        subAt(wadd(h, S_LIVE_BYTES), wadd(48, shl(cap, 3)));\n      }\n      if (items != 0) {\n        sbFree(items, shl(cap, 3));\n      }\n      if (cfg(0) == 1 && load64(wadd(wadd(h, FL_N), 72)) < FL_CAP) {\n        store64(base, load64(wadd(h, FL_ARRAY)));\n        store64(wadd(h, FL_ARRAY), base);\n        addAt(wadd(wadd(h, FL_N), 72), 1);\n        liveDec();\n        recycled = true;\n      }\n    } else if (kind == 3) {\n      // struct: release the reference slots (refmask, lowest bit first, stopping at the last set bit; no bit is set at or above nslots), recycle the object by\n      // size class\n      const n = load32(wadd(x, 16));\n      let m = load64(wadd(x, 24));\n      let p = wadd(x, 32);\n      while (m != 0) {\n        if (and(m, 1) == 1) {\n          const c = load64(p);\n          if (decRef(c)) {\n            if (cur == 0) {\n              cur = c;\n            } else {\n              if (sp == scap) {\n                scap = growStack(scap);\n                stack = load64(wadd(h, DSTACK));\n              }\n              store64(wadd(stack, shl(sp, 3)), c);\n              sp = wadd(sp, 1);\n            }\n          }\n        }\n        m = shr(m, 1);\n        p = wadd(p, 8);\n      }\n      if (cfg(1) == 1) {\n        subAt(wadd(h, S_LIVE_BYTES), wadd(32, shl(n, 3)));\n      }\n      if (cfg(0) == 1 && n < 9 && load64(wadd(wadd(h, FL_N), shl(n, 3))) < FL_CAP) {\n        const lp = wadd(wadd(h, FL_STRUCT), shl(n, 3));\n        store64(base, load64(lp));\n        store64(lp, base);\n        addAt(wadd(wadd(h, FL_N), shl(n, 3)), 1);\n        liveDec();\n        recycled = true;\n      }\n    } else {\n      // string: one block of 32 + cap + 1 bytes\n      const total = wadd(load64(wadd(x, 24)), 33);\n      if (cfg(1) == 1) {\n        subAt(wadd(h, S_LIVE_BYTES), total);\n      }\n      sbFree(base, wadd(total, pfx()));\n      liveDec();\n      recycled = true;\n    }\n    if (!recycled) {\n      memFree(base);\n      liveDec();\n    }\n  }\n}\n\n// The copying path of `make_unique` (the count of `o` is not 1): a shallow copy with the children retained, one count of `o`\n// released. Consumes the caller's reference to `o`, returns an owned one.\nexport function makeUniqueSlow(o: usize): usize {\n  if (cfg(1) == 1) {\n    addAt(wadd(heapBase(), S_COW_COPIES), 1);\n  }\n  siteRc(o, 2);\n  const kind = load32(wadd(o, 8));\n  let r: usize = 0;\n  if (kind == 3) {\n    const n = load32(wadd(o, 16));\n    const mask = load64(wadd(o, 24));\n    r = structNew(load32(wadd(o, 12)), n, mask);\n    let i: usize = 0;\n    while (i < n) {\n      const v = load64(wadd(wadd(o, 32), shl(i, 3)));\n      store64(wadd(wadd(r, 32), shl(i, 3)), v);\n      if (and(shr(mask, i), 1) == 1) {\n        retain(v);\n      }\n      i = wadd(i, 1);\n    }\n  } else if (kind == 2) {\n    const len = load64(wadd(o, 16));\n    const isRef = load64(wadd(o, 32));\n    r = arrayNew(len, isRef);\n    const src = load64(wadd(o, 40));\n    const dst = load64(wadd(r, 40));\n    if (isRef != 0) {\n      let i: usize = 0;\n      while (i < len) {\n        const v = load64(wadd(src, shl(i, 3)));\n        store64(wadd(dst, shl(i, 3)), v);\n        retain(v);\n        i = wadd(i, 1);\n      }\n    } else if (len != 0) {\n      memCopy(dst, src, shl(len, 3));\n    }\n    store64(wadd(r, 16), len);\n  } else {\n    const len = load64(wadd(o, 16));\n    r = strAlloc(len, len);\n    if (len != 0) {\n      memCopy(wadd(r, 32), wadd(o, 32), len);\n    }\n  }\n  release(o);\n  return r;\n}\n" });
  out.push(SourceFile { path: "$rt/rt.or", text: "// $rt/rt -- the first module of the runtime core written in Orin (ADR-0052 Addendum A, step R3d.0; spec 19 section 3).\n//\n// `runtime/core/*.or` is the embedded root `$rt` (tools/embed_prelude.py, compiler/loader/prelude.or). Its entry\n// `$rt/module.or` is loaded into every compiled program like `$std`; unreferenced functions are pruned (compiler/opt/prune.or),\n// so a program that does not call into it is unchanged. Only modules of this root may import the internal module `std:core`\n// (the core operations of hir/coreops.or). The L1 object-model modules (layout, heap, object, rc, stats) of R3d.1..R3d.5 land here.\n\n// The version of the object layout that the L1 modules assume (spec 19; rule 3 of Addendum A section 2). It changes with the\n// frozen offsets, never otherwise.\nexport function rtLayoutVersion(): usize {\n  return 1;\n}\n" });
  out.push(SourceFile { path: "$rt/stats.or", text: "// $rt/stats -- the ORIN_STATS report and the live-object count, written in Orin (ADR-0052 Addendum A, step R3d.5).\n//\n// `statsReport` runs at process exit (the C `orin_init` registers the wrapper `orin_stats_report` with the platform's at-exit list):\n// with ORIN_STATS=1 it prints the one-line JSON report of the counters on stderr, with ORIN_STATS=sites (census builds) it prints\n// the census table first. The counters are the ones of the heap block (heap.or, `OrinStats`, 18 words from byte 192) of the exiting\n// thread plus the totals of the finished tasks, which the C runtime keeps in `g_fold` / `g_fold_live` and which Orin reaches through\n// the hooks HK_FOLD_STATS / HK_FOLD_LIVE under the runtime lock. The report is assembled by hand in a raw buffer (no Orin string is\n// allocated: the counters must not change while they are read) and is byte for byte the one the C `stats_report` printed.\n// `liveCount` is `orin_live_count`: the balance of this thread's heap plus the finished tasks'. The census itself (the per-site\n// tables, their fold and report) stays C in runtime/core/orin_runtime.c and is reached through hooks (heap.or).\n\nimport { load8, load64, store8, store64, memAlloc, memFree, memCopy, heapBase, cfg, hook, addrOf, wadd, wsub, shl } from \"std:core\";\nimport { HK_GETENV, HK_LOCK, HK_UNLOCK, HK_WRITE_LINE, HK_FOLD_STATS, HK_FOLD_LIVE, HK_STATS_ON, HK_SITE_REPORT, LIVE } from \"./heap\";\n\nconst STATS: usize = 192;             // OrinStats in the heap block\nconst SIGN: usize = 9223372036854775808;\n\n// True when the C string at `p` (0: none) is exactly the text of `s`.\nfunction cstrIs(p: usize, s: string): bool {\n  if (p == 0) {\n    return false;\n  }\n  const a = addrOf(s);\n  const n = load64(wadd(a, 16));\n  let i: usize = 0;\n  while (i < n) {\n    if (load8(wadd(p, i)) != load8(wadd(wadd(a, 32), i))) {\n      return false;\n    }\n    i = wadd(i, 1);\n  }\n  return load8(wadd(p, n)) == 0;\n}\n\n// Append the text of `s` to the buffer `buf` holding `n` bytes; returns the new length.\nfunction putStr(buf: usize, n: usize, s: string): usize {\n  const a = addrOf(s);\n  const k = load64(wadd(a, 16));\n  memCopy(wadd(buf, n), wadd(a, 32), k);\n  return wadd(n, k);\n}\n\n// Append the decimal digits of `v`; returns the new length.\nfunction putU(buf: usize, n: usize, v: usize): usize {\n  let digits: usize = 1;\n  let t = v / 10;\n  while (t != 0) {\n    digits = wadd(digits, 1);\n    t = t / 10;\n  }\n  let p = wadd(wadd(buf, n), digits);\n  let w = v;\n  store8(wsub(p, 1), wadd(48, w % 10));\n  p = wsub(p, 1);\n  w = w / 10;\n  while (w != 0) {\n    store8(wsub(p, 1), wadd(48, w % 10));\n    p = wsub(p, 1);\n    w = w / 10;\n  }\n  return wadd(n, digits);\n}\n\n// Append `,\"key\":` and the decimal value; `key` includes the leading comma and the colon.\nfunction putField(buf: usize, n: usize, key: string, v: usize): usize {\n  return putU(buf, putStr(buf, n, key), v);\n}\n\n// The balance of live objects: this thread's heap plus the finished tasks' (signed, as a word).\nexport function liveCount(): usize {\n  hook(HK_LOCK, 0, 0, 0);\n  const folded = load64(hook(HK_FOLD_LIVE, 0, 0, 0));\n  hook(HK_UNLOCK, 0, 0, 0);\n  return wadd(load64(wadd(heapBase(), LIVE)), folded);\n}\n\n// The report. `t` holds the 18 counters of the exiting thread, to which the finished tasks' totals are added under the runtime lock\n// (the sums, and the larger of the two peaks).\nexport function statsReport(): void {\n  const name = \"ORIN_STATS\";\n  const e = hook(HK_GETENV, wadd(addrOf(name), 32), 0, 0);\n  let sites = false;\n  if (cfg(2) == 1 && cstrIs(e, \"sites\")) {\n    sites = true;\n    hook(HK_SITE_REPORT, 0, 0, 0);\n  }\n  if (!sites && !cstrIs(e, \"1\")) {\n    return;\n  }\n  const t = memAlloc(144);\n  memCopy(t, wadd(heapBase(), STATS), 144);\n  hook(HK_LOCK, 0, 0, 0);\n  const g = hook(HK_FOLD_STATS, 0, 0, 0);\n  let i: usize = 0;\n  while (i < 18) {\n    const o = shl(i, 3);\n    const a = load64(wadd(t, o));\n    const b = load64(wadd(g, o));\n    if (i == 10 || i == 11) {\n      store64(wadd(t, o), b > a ? b : a);\n    } else {\n      store64(wadd(t, o), wadd(a, b));\n    }\n    i = wadd(i, 1);\n  }\n  hook(HK_UNLOCK, 0, 0, 0);\n  const r = memAlloc(1024);\n  let n = putStr(r, 0, \"{\\\"orin_stats\\\":\");\n  n = putStr(r, n, hook(HK_STATS_ON, 0, 0, 0) == 1 ? \"{\\\"counters\\\":\\\"all\\\"\" : \"{\\\"counters\\\":\\\"cold\\\"\");\n  n = putField(r, n, \",\\\"alloc_string\\\":\", load64(t));\n  n = putField(r, n, \",\\\"alloc_array\\\":\", load64(wadd(t, 8)));\n  n = putField(r, n, \",\\\"alloc_struct\\\":\", load64(wadd(t, 16)));\n  n = putField(r, n, \",\\\"alloc_total\\\":\", wadd(wadd(load64(t), load64(wadd(t, 8))), load64(wadd(t, 16))));\n  n = putField(r, n, \",\\\"frees\\\":\", load64(wadd(t, 24)));\n  n = putField(r, n, \",\\\"retains\\\":\", load64(wadd(t, 32)));\n  n = putField(r, n, \",\\\"releases\\\":\", load64(wadd(t, 40)));\n  n = putField(r, n, \",\\\"cow_copies\\\":\", load64(wadd(t, 48)));\n  n = putField(r, n, \",\\\"cow_inplace\\\":\", load64(wadd(t, 56)));\n  n = putField(r, n, \",\\\"array_grows\\\":\", load64(wadd(t, 64)));\n  n = putField(r, n, \",\\\"string_grows\\\":\", load64(wadd(t, 72)));\n  n = putField(r, n, \",\\\"peak_live_objs\\\":\", load64(wadd(t, 80)));\n  n = putField(r, n, \",\\\"peak_live_bytes\\\":\", load64(wadd(t, 88)));\n  n = putField(r, n, \",\\\"file_opens\\\":\", load64(wadd(t, 104)));\n  n = putField(r, n, \",\\\"file_closes\\\":\", load64(wadd(t, 112)));\n  n = putField(r, n, \",\\\"transfer_moves\\\":\", load64(wadd(t, 120)));\n  n = putField(r, n, \",\\\"transfer_copies\\\":\", load64(wadd(t, 128)));\n  n = putField(r, n, \",\\\"tasks_spawned\\\":\", load64(wadd(t, 136)));\n  n = putStr(r, n, \",\\\"live_objs_at_exit\\\":\");\n  const live = liveCount();\n  if (live >= SIGN) {\n    store8(wadd(r, n), 45);\n    n = putU(r, wadd(n, 1), wsub(0, live));\n  } else {\n    n = putU(r, n, live);\n  }\n  n = putStr(r, n, \"}}\");\n  hook(HK_WRITE_LINE, r, n, 0);\n  memFree(r);\n  memFree(t);\n}\n" });
  out.push(SourceFile { path: "$rt/str.or", text: "// $rt/str -- the string append family, written in Orin (ADR-0052 Addendum A, step R3d.4).\n//\n// The backends call these functions by name (compiler/mir/rt.or lists them; opt/prune.or keeps them) in place of the C runtime\n// functions `orin_str_concat`, `orin_str_append`, `orin_str_prepend`, `orin_str_append_sub`, `orin_str_append_int` and\n// `orin_str_append_usize`; the C unit tests of the runtime reach `strConcat` and `strAppend` through the wrappers of the same C\n// names. An object is its address as a `usize`; the layout is the frozen one (heap.or): string len@16 cap@24 data@32, the bytes\n// followed by a NUL. The sharing rule of every append is the C one: the string `a` (consumed, the result replaces it) is extended in\n// place only when its count is 1, else a fresh string is built and one count of `a` is released. The in-place path grows the\n// capacity to at least twice, 16 bytes at the least; the fresh one reserves a half more (append) so that a loop of appends on\n// a shared string turns into in-place appends. Counters are updated exactly as the C versions did (the ORIN_STATS=1 report is the\n// equivalence oracle).\n\nimport { load64, store8, store64, memCopy, memMove, heapBase, cfg, wadd, wsub, wmul, shr } from \"std:core\";\nimport { taskTrap } from \"std:fsraw\";\nimport { sbRealloc, addAt, pfx, siteGrow, S_LIVE_BYTES, S_STRING_GROWS } from \"./heap\";\nimport { strAlloc } from \"./object\";\nimport { retain, release } from \"./rc\";\n\n// The unique string `a` (count 1) with a capacity of at least `n` bytes: the grown block (which may have moved).\nfunction strGrow(a: usize, n: usize): usize {\n  const oldCap = load64(wadd(a, 24));\n  let cap = wmul(oldCap, 2);\n  if (cap < n) {\n    cap = n;\n  }\n  if (cap < 16) {\n    cap = 16;\n  }\n  const x = wadd(sbRealloc(wsub(a, pfx()), wadd(wadd(oldCap, 33), pfx()), wadd(wadd(cap, 33), pfx())), pfx());\n  if (cfg(1) == 1) {\n    const h = heapBase();\n    addAt(wadd(h, S_LIVE_BYTES), wsub(cap, oldCap));\n    addAt(wadd(h, S_STRING_GROWS), 1);\n  }\n  siteGrow(x, wsub(cap, oldCap));\n  store64(wadd(x, 24), cap);\n  return x;\n}\n\n// The fresh string a ++ y (a shared or immortal `a`, or the strings are the same): `n` is the new length, `src` the address of the\n// `k` bytes to append. Reserves a half more than the length, releases one count of `a`. Out of line: the in-place path of the\n// callers stays small.\nfunction appendFresh(a: usize, src: usize, k: usize, n: usize): usize {\n  const r = strAlloc(n, wadd(n, wadd(shr(n, 1), 8)));\n  const xl = wsub(n, k);\n  if (xl != 0) {\n    memCopy(wadd(r, 32), wadd(a, 32), xl);\n  }\n  memCopy(wadd(wadd(r, 32), xl), src, k);\n  release(a);\n  return r;\n}\n\n// a ++ b as a new string, or the other operand shared when one is empty.\nexport function strConcat(a: usize, b: usize): usize {\n  const xl = load64(wadd(a, 16));\n  const yl = load64(wadd(b, 16));\n  if (yl == 0) {\n    retain(a);\n    return a;\n  }\n  if (xl == 0) {\n    retain(b);\n    return b;\n  }\n  const n = wadd(xl, yl);\n  const r = strAlloc(n, n);\n  memCopy(wadd(r, 32), wadd(a, 32), xl);\n  memCopy(wadd(wadd(r, 32), xl), wadd(b, 32), yl);\n  return r;\n}\n\n// a = a ++ b. Consumes `a`; `b` is only read.\nexport function strAppend(a: usize, b: usize): usize {\n  const yl = load64(wadd(b, 16));\n  if (yl == 0) {\n    return a;\n  }\n  const xl = load64(wadd(a, 16));\n  const n = wadd(xl, yl);\n  if (load64(a) == 1 && a != b) {\n    let x = a;\n    if (n > load64(wadd(a, 24))) {\n      x = strGrow(a, n);\n    }\n    memCopy(wadd(wadd(x, 32), xl), wadd(b, 32), yl);\n    store64(wadd(x, 16), n);\n    store8(wadd(wadd(x, 32), n), 0);\n    return x;\n  }\n  return appendFresh(a, wadd(b, 32), yl, n);\n}\n\n// a = a ++ s.substring(i, j) without the substring object. Consumes `a`; traps \"substring out of range\" unless i <= j <= len(s).\nexport function strAppendSub(a: usize, s: usize, i: usize, j: usize): usize {\n  if (i > j || j > load64(wadd(s, 16))) {\n    taskTrap(\"substring out of range\");\n  }\n  if (i == j) {\n    return a;\n  }\n  const k = wsub(j, i);\n  const xl = load64(wadd(a, 16));\n  const n = wadd(xl, k);\n  if (load64(a) == 1 && a != s) {\n    let x = a;\n    if (n > load64(wadd(a, 24))) {\n      x = strGrow(a, n);\n    }\n    memCopy(wadd(wadd(x, 32), xl), wadd(wadd(s, 32), i), k);\n    store64(wadd(x, 16), n);\n    store8(wadd(wadd(x, 32), n), 0);\n    return x;\n  }\n  return appendFresh(a, wadd(wadd(s, 32), i), k, n);\n}\n\n// Write the decimal digits of `v` (`digits` of them) so that they end just before `end`, and a minus sign before them when `neg` is 1.\n@Inline\nfunction putDigits(end: usize, v: usize, neg: usize): void {\n  let p = wsub(end, 1);\n  store8(p, wadd(48, v % 10));\n  let w = v / 10;\n  while (w != 0) {\n    p = wsub(p, 1);\n    store8(p, wadd(48, w % 10));\n    w = w / 10;\n  }\n  if (neg == 1) {\n    store8(wsub(p, 1), 45);\n  }\n}\n\n// a = a ++ decimal text of `v` (a minus sign first when `neg` is 1) for a shared or immortal `a`: a fresh string, one count of `a`\n// released. `n` is the new length, `k` the length of the text.\nfunction decimalFresh(a: usize, v: usize, neg: usize, k: usize, n: usize): usize {\n  const r = strAlloc(n, wadd(n, wadd(shr(n, 1), 8)));\n  const xl = wsub(n, k);\n  if (xl != 0) {\n    memCopy(wadd(r, 32), wadd(a, 32), xl);\n  }\n  const end = wadd(wadd(r, 32), n);\n  store8(end, 0);\n  putDigits(end, v, neg);\n  release(a);\n  return r;\n}\n\n// The number of decimal digits of `v` (at least 1). A ladder of compares for the common short numbers, a division loop from six digits on:\n// counting by repeated division would cost as much as writing the digits (R3d.5: it was +1.4 % instructions on `mapfreq`).\n@Inline\nfunction decimalDigits(v: usize): usize {\n  if (v < 10) {\n    return 1;\n  }\n  if (v < 100) {\n    return 2;\n  }\n  if (v < 1000) {\n    return 3;\n  }\n  if (v < 10000) {\n    return 4;\n  }\n  if (v < 100000) {\n    return 5;\n  }\n  let d: usize = 5;\n  let t = v / 100000;\n  while (t != 0) {\n    d = wadd(d, 1);\n    t = t / 10;\n  }\n  return d;\n}\n\n// a = a ++ decimal text of `v` (a minus sign first when `neg` is 1). The digits are written straight behind the old bytes.\nfunction appendDecimal(a: usize, v: usize, neg: usize): usize {\n  const k = wadd(decimalDigits(v), neg);\n  const n = wadd(load64(wadd(a, 16)), k);\n  if (load64(a) != 1) {\n    return decimalFresh(a, v, neg, k, n);\n  }\n  let r = a;\n  if (n > load64(wadd(a, 24))) {\n    r = strGrow(a, n);\n  }\n  store64(wadd(r, 16), n);\n  const end = wadd(wadd(r, 32), n);\n  store8(end, 0);\n  putDigits(end, v, neg);\n  return r;\n}\n\n// a = a ++ decimal text of the unsigned `v`.\nexport function strAppendUsize(a: usize, v: usize): usize {\n  return appendDecimal(a, v, 0);\n}\n\n// a = a ++ decimal text of the signed `v`.\nexport function strAppendInt(a: usize, v: int): usize {\n  if (v < 0) {\n    return appendDecimal(a, wadd((-(v + 1)).toUsize(), 1), 1);\n  }\n  return appendDecimal(a, v.toUsize(), 0);\n}\n\n// The fresh string b ++ a of length `n` (a shared or immortal, or a is b), one count of `a` released.\nfunction prependFresh(a: usize, b: usize, n: usize): usize {\n  const yl = load64(wadd(b, 16));\n  const xl = load64(wadd(a, 16));\n  const r = strAlloc(n, n);\n  memCopy(wadd(r, 32), wadd(b, 32), yl);\n  if (xl != 0) {\n    memCopy(wadd(wadd(r, 32), yl), wadd(a, 32), xl);\n  }\n  release(a);\n  return r;\n}\n\n// a = b ++ a. Consumes `a`; `b` is only read.\nexport function strPrepend(a: usize, b: usize): usize {\n  const yl = load64(wadd(b, 16));\n  if (yl == 0) {\n    return a;\n  }\n  const xl = load64(wadd(a, 16));\n  const n = wadd(xl, yl);\n  if (load64(a) == 1 && a != b) {\n    let x = a;\n    if (n > load64(wadd(a, 24))) {\n      x = strGrow(a, n);\n    }\n    memMove(wadd(wadd(x, 32), yl), wadd(x, 32), xl);\n    memCopy(wadd(x, 32), wadd(b, 32), yl);\n    store64(wadd(x, 16), n);\n    store8(wadd(wadd(x, 32), n), 0);\n    return x;\n  }\n  return prependFresh(a, b, n);\n}\n" });
  return out;
}
