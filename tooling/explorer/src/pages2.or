// The processes page (pipeline stages, effects of the entry points) and the changes page (a diff between two snapshots).

import ox from "std:html";
import { Html, document, empty } from "std:html";
import {
  CardGrid, Card, card, DiffView, DiffTable, DiffRow, DiffKind, DiffAdded, DiffRemoved, DiffChanged, Badge, Info, Passed, Failed, Regression,
  newBareCanvas, Canvas, Pt, SvgDoc,
} from "orin-reports";
import { Ix, NONE } from "./index";
import { Diff, DSym, DEdge, DEffect, DReach, DCallPath } from "./model";
import {
  Ctx, Frame, FrameWith, PageHead, KindBadge, EvBadge, Flag, SymLink, IdLink, qualified, Figure, Section, Empty, modHref, lastSegment,
} from "./components";
import { plural, percent, clip, strCmp, afterLast } from "./util";
import { Run, RunHistory } from "./runs";

// ---- processes ---------------------------------------------------------------------------------------------------------------

type Stage = { name: string; what: string; modules: string[]; };

function stages(): Stage[] {
  return [
    Stage { name: "Parse", what: "Lexer and parser: source text to syntax tree, with error recovery", modules: ["syntax"] },
    Stage { name: "Load", what: "Manifests, the package graph and the import closure", modules: ["loader", "package"] },
    Stage { name: "Check", what: "Name resolution, types, generics and contract clauses", modules: ["check"] },
    Stage { name: "HIR", what: "The typed high-level IR and the semantic index", modules: ["hir"] },
    Stage { name: "MIR", what: "Lowering to the mid-level IR, array pipeline fusion", modules: ["lower", "mir", "fuse"] },
    Stage { name: "Optimise", what: "Passes over MIR", modules: ["opt"] },
    Stage { name: "Verify", what: "Ownership and range verifier, verification conditions", modules: ["verify", "vc"] },
    Stage { name: "Emit", what: "The C and LLVM IR back ends", modules: ["cemit", "llvm"] },
  ];
}

type StageStat = { present: bool; mods: usize[]; symbols: int; contracts: int; effectful: int; documented: int; };

function statOf(ix: Ix, st: Stage): StageStat {
  let r = StageStat { present: false, mods: [], symbols: 0, contracts: 0, effectful: 0, documented: 0 };
  for (const name of st.modules) {
    const m = ix.modNode.get(name);
    if (m.isSome()) {
      const ms = ix.mods[m.unwrap()];
      r.present = true;
      r.mods.push(m.unwrap());
      r.symbols += ms.symbols;
      r.contracts += ms.contracts;
      r.effectful += ms.effectful;
      r.documented += ms.documented;
    }
  }
  return r;
}

function pipelineSvg(ctx: Ctx, sts: Stage[]): SvgDoc {
  const ix = ctx.ix;
  const bw = 112.0;
  const gap = 20.0;
  const w = 16.0 + sts.length.toFloat() * (bw + gap) - gap + 16.0;
  const h = 96.0;
  let c = newBareCanvas(w.toInt(), h.toInt(), "Compiler pipeline", "Parse, load, check, HIR, MIR, optimise, verify and emit, with the size of the compiler modules that implement each stage.", "pl-", "ex-graph-svg");
  let k: usize = 0;
  while (k < sts.length) {
    const st = statOf(ix, sts[k]);
    const x = 16.0 + k.toFloat() * (bw + gap);
    const y = 16.0;
    if (st.present) {
      c.link(modHref(ctx, st.mods[0]), "ex-node", sts[k].name + ": " + plural(st.symbols, "symbol", "symbols"));
    } else {
      c.group("ex-node ex-node-off", sts[k].name + ": no such module in this snapshot");
    }
    c.rrect("ex-node-box", x, y, bw, 64.0, 10.0);
    c.rrect("ex-node-bar " + (st.effectful > 0 ? "ex-acc-effect" : (st.contracts > 0 ? "ex-acc-contract" : "ex-acc-plain")), x, y + 10.0, 4.0, 44.0, 2.0);
    c.text(x + 18.0, y + 24.0, sts[k].name, "ex-t", 14, "start", "700", 0);
    c.text(x + 18.0, y + 42.0, st.present ? plural(st.symbols, "symbol", "symbols") : "not in this package", "ex-t2", 11, "start", "400", 0);
    c.text(x + 18.0, y + 56.0, st.present ? st.contracts.toString() + " contracts" : "", "ex-t2", 10, "start", "400", 0);
    if (st.present) {
      c.endLink();
    } else {
      c.endGroup();
    }
    if (k + 1 < sts.length) {
      c.group("ex-edge", "");
      c.flow("ex-edge-line", [Pt { x: x + bw, y: y + 32.0 }, Pt { x: x + bw + gap, y: y + 32.0 }], 1.6, "");
      c.arrowhead("ex-edge-head", x + bw + gap, y + 32.0, 1);
      c.endGroup();
    }
    k += 1;
  }
  return c.finish();
}


function StageRow(ctx: Ctx, st: Stage): Html {
  const s = statOf(ctx.ix, st);
  return <tr>
    <th scope="row">{st.name}<span class="ex-stage-what">{st.what}</span></th>
    <td>{s.present ? <ul class="ex-chips">{s.mods.map(m => <li><a class="ex-chip" href={modHref(ctx, m)}>{ctx.ix.mods[m].name}</a></li>)}</ul> : <span class="ex-muted">not in this package</span>}</td>
    <td class="r-num">{s.present ? s.symbols.toString() : "–"}</td>
    <td class="r-num">{s.present ? s.contracts.toString() : "–"}</td>
    <td class="r-num">{s.present ? s.effectful.toString() : "–"}</td>
    <td class="r-num">{s.present ? percent(s.documented, s.symbols) : "–"}</td>
  </tr>;
}

function effectText(ix: Ix, i: usize): string {
  let parts: string[] = [];
  for (const e of ix.out[i]) {
    const ed = ix.snap.edges[e];
    if (ed.kind == "MAY_PERFORM") {
      parts.push((ed.dst.startsWith("~io:") ? ed.dst.substring(4, ed.dst.length) + " " + ed.via : "unknown " + ed.via) + (ed.ev == "MUST" ? "" : " (" + ed.ev + ")"));
    }
  }
  return parts.join(", ");
}

function EntryRow(ctx: Ctx, i: usize): Html {
  const s = ctx.ix.snap.nodes[i];
  return <tr>
    <th scope="row"><SymLink ctx={ctx} i={i} label={lastSegment(s.id)} /></th>
    <td class="ex-mod">{s.module}</td>
    <td class="ex-effects">{clip(effectText(ctx.ix, i), 160)}</td>
  </tr>;
}

// `runs`: the run history (oldest first); empty gives the page of a snapshot alone
export function ProcessesPage(ctx: Ctx, runs: Run[]): string {
  const ix = ctx.ix;
  const sts = stages();
  let found = 0;
  for (const st of sts) {
    found += statOf(ix, st).present ? 1 : 0;
  }
  let entries: usize[] = [];
  let k: usize = 0;
  while (k < ix.snap.nodes.length) {
    if (ix.page[k] == k && ix.snap.nodes[k].entry && effectText(ix, k).length > 0) {
      entries.push(k);
    }
    k += 1;
  }
  const shown = entries.length > 60 ? entries.slice(0, 60) : entries;
  const body = <>
    <PageHead eyebrow={<>Processes</>} title="Processes" lead="How the code runs: the compiler pipeline stages and what the entry points of the package may do to the outside world." />
    {Section("pipeline", "Compiler pipeline", found == 0 ? "This package contains none of the compiler's pipeline modules, so the stages are shown as a reference only. Explore the compiler itself (orin graph compiler/main.or) to see them filled." : "Each stage is the set of compiler modules that implements it; the numbers come from this snapshot.",
      <>{Figure("Pipeline stages, from source text to generated code", pipelineSvg(ctx, sts), false)}
        <div class="r-table-wrap ex-table" role="region" aria-label="Stages" tabindex={0}><table class="r-table">
          <thead><tr><th scope="col">Stage</th><th scope="col">Modules</th><th scope="col" class="r-num">Symbols</th><th scope="col" class="r-num">Contracts</th><th scope="col" class="r-num">Effectful</th><th scope="col" class="r-num">Documented</th></tr></thead>
          <tbody>{sts.map(s => <StageRow ctx={ctx} st={s} />)}</tbody></table></div></>)}
    {Section("entries", "Entry points and their effects", plural(entries.length.toInt(), "entry point", "entry points") + " may perform effects (transitively; ADR-0037). Direction is INPUT, OUTPUT or CONTROL; (MAY) marks an effect that is not certain.",
      entries.length == 0 ? Empty("No entry point of this package performs an effect.") :
      <div class="r-table-wrap ex-table" role="region" aria-label="Entry points" tabindex={0}><table class="r-table">
        <thead><tr><th scope="col">Entry point</th><th scope="col">Module</th><th scope="col">May perform</th></tr></thead>
        <tbody>{shown.map(i => <EntryRow ctx={ctx} i={i} />)}</tbody></table></div>)}
    {runs.length > 0 ? <RunHistory ctx={ctx} runs={runs} /> : Section("history", "Run history", "", <p class="r-notice r-notice-info"><Badge status={Info} /><span>Per-module compile times, test results and proof outcomes from CI runs join this page in a later step (ADR-0050, step 3). Today it shows what the snapshot knows.</span></p>)}
  </>;
  const more = runs.length > 0 ? <link rel="stylesheet" href={ctx.root + "assets/runs.css"} /> : empty();
  return document(<FrameWith ctx={ctx} active="processes" title="Processes" body={body} more={more} />);
}

// ---- changes -------------------------------------------------------------------------------------------------------------------

const LIMIT: usize = 400;

function capped(rows: DiffRow[]): DiffRow[] {
  return rows.length > LIMIT ? rows.slice(0, LIMIT) : rows;
}

function site(file: string, line: int): string {
  return file.length == 0 ? "" : file + ":" + line.toString();
}

function symRows(xs: DSym[], removed: bool, wantContracts: bool): DiffRow[] {
  let rows: DiffRow[] = [];
  for (const x of xs) {
    if ((x.kind == "Contract") != wantContracts) {
      continue;
    }
    const text = x.sig.length > 0 ? x.sig : x.kind;
    rows.push(DiffRow { kind: removed ? DiffRemoved : DiffAdded, label: x.kind + " " + qualified(x.id), before: removed ? text : "", after: removed ? "" : text });
  }
  return rows;
}

function changedRows(xs: DSym[]): DiffRow[] {
  let rows: DiffRow[] = [];
  for (const x of xs) {
    rows.push(DiffRow { kind: DiffChanged, label: x.kind + " " + qualified(x.id) + " [" + x.aspects.join(", ") + "]", before: x.before, after: x.after });
  }
  return rows;
}

function edgeText(e: DEdge): string {
  return e.kind + " " + qualified(e.src) + " -> " + qualified(e.dst);
}

function edgeDetail(e: DEdge): string {
  return e.ev + (e.via.length > 0 ? " " + e.via : "") + (e.file.length > 0 ? " @ " + site(e.file, e.line) : "");
}

function edgeRows(es: DEdge[], added: bool): DiffRow[] {
  let rows: DiffRow[] = [];
  for (const e of es) {
    rows.push(DiffRow { kind: added ? DiffAdded : DiffRemoved, label: edgeText(e), before: added ? "" : edgeDetail(e), after: added ? edgeDetail(e) : "" });
  }
  return rows;
}

function effectRows(es: DEffect[]): DiffRow[] {
  let rows: DiffRow[] = [];
  for (const e of es) {
    const what = e.op + " " + e.dir;
    const label = qualified(e.fn) + " · " + e.op;
    if (e.kind == "added") {
      rows.push(DiffRow { kind: DiffAdded, label: label, before: "", after: e.dir + " " + e.ev });
    } else if (e.kind == "removed") {
      rows.push(DiffRow { kind: DiffRemoved, label: label, before: e.dir + " " + e.ev, after: "" });
    } else {
      rows.push(DiffRow { kind: DiffChanged, label: label, before: e.dir + " " + e.was, after: e.dir + " " + e.ev });
    }
  }
  return rows;
}

function table(caption: string, rows: DiffRow[], empty_: string): DiffTable {
  return DiffTable { caption: caption, labelHeader: "Symbol", beforeHeader: "Before", afterHeader: "After", rows: capped(rows), emptyText: empty_ };
}

function More(n: usize, what: string): Html {
  return n > LIMIT ? <p class="ex-muted">{"Showing the first " + LIMIT.toString() + " of " + n.toString() + " " + what + "."}</p> : empty();
}

function pathText(ids: string[]): string {
  let parts: string[] = [];
  for (const id of ids) {
    parts.push(lastSegment(id));
  }
  return parts.join(" → ");
}

function PathItem(p: DCallPathView): Html {
  return <li><code>{p.text}</code> <EvBadge ev={p.ev} /></li>;
}

type DCallPathView = { text: string; ev: string; };

function ReachList(r: DReach): Html {
  let items: DCallPathView[] = [];
  for (const p of r.paths) {
    if (items.length < 3) {
      items.push(DCallPathView { text: pathText(p.nodes), ev: p.ev });
    }
  }
  return items.length == 0 ? <span class="ex-muted">no entry point reaches it</span> : <ul class="ex-paths">{items.map(p => <PathItem p={p} />)}</ul>;
}

function CallPathRow(cp: DCallPath): Html {
  return <tr>
    <th scope="row"><code>{edgeText(cp.edge)}</code><div class="ex-muted">{edgeDetail(cp.edge)}</div></th>
    <td><ReachList r={cp.reach} /></td>
  </tr>;
}

function CallPaths(title: string, cps: DCallPath[]): Html {
  const shown = cps.length > 60 ? cps.slice(0, 60) : cps;
  return cps.length == 0 ? Empty("None.") : <div class="r-table-wrap ex-table" role="region" aria-label={title} tabindex={0}><table class="r-table">
    <caption>{title}</caption>
    <thead><tr><th scope="col">Edge</th><th scope="col">Reached from entry points</th></tr></thead>
    <tbody>{shown.map(c => <CallPathRow cp={c} />)}</tbody></table></div>;
}

function ImpactRow(r: DReach): Html {
  return <tr><th scope="row"><code>{qualified(r.target)}</code></th><td class="r-num">{r.paths.length.toString() + (r.truncated ? "+" : "")}</td><td><ReachList r={r} /></td></tr>;
}

export function DiffPage(ctx: Ctx, d: Diff): string {
  const ix = ctx.ix;
  let contractsAdded = symRows(d.added, false, true);
  let contractsRemoved = symRows(d.removed, true, true);
  const symAdded = symRows(d.added, false, false);
  const symRemoved = symRows(d.removed, true, false);
  let contractRows: DiffRow[] = [];
  for (const r of contractsRemoved) {
    contractRows.push(r);
  }
  for (const r of contractsAdded) {
    contractRows.push(r);
  }
  const changed = changedRows(d.changed);
  const cards: Card[] = [
    card("Added", d.added.length.toString(), Some("symbols"), None),
    card("Removed", d.removed.length.toString(), Some("symbols"), None),
    card("Changed", d.changed.length.toString(), Some("signature, contract, visibility"), None),
    card("Edges", "+" + d.addedEdges.length.toString() + " / -" + d.removedEdges.length.toString(), Some("calls, imports, implements, types"), None),
    card("Effects", "+" + d.effects.length.toString(), Some(d.effectsComparable ? "new, removed or changed effects" : "not comparable (older snapshot)"), None),
    card("Renames", d.renames.length.toString(), Some("possible, heuristic"), None),
  ];
  let renameRows: Html[] = [];
  for (const r of d.renames) {
    renameRows.push(<tr><th scope="row"><code>{qualified(r.oldId)}</code> → <code>{qualified(r.newId)}</code></th><td>{r.kind}</td><td>{r.confidence}</td><td>{r.basis}</td></tr>);
  }
  let modEff: Html[] = [];
  for (const m of d.moduleEffects) {
    modEff.push(<tr><th scope="row">{m.module}</th><td>{m.added.join(", ")}</td><td>{m.removed.join(", ")}</td></tr>);
  }
  const body = <>
    <PageHead eyebrow={<>Changes</>} title="Changes between two states" lead={d.basePkg + " " + d.baseHash + " → " + d.headPkg + " " + d.headHash + " (" + d.schema + ")"} />
    {d.differences ? empty() : <p class="r-notice r-notice-passed"><Badge status={Passed} /><span>The two snapshots are identical: nothing changed.</span></p>}
    {d.truncated ? <p class="r-notice r-notice-info"><Badge status={Info} /><span>The report was truncated by orin diff: lists may be incomplete.</span></p> : empty()}
    <CardGrid cards={cards} />
    {Section("changed", "Changed symbols", "Same id in both states, different signature, visibility, kind, entry-point status or contract text.", <><DiffView table={table("Changed symbols", changed, "No symbol changed.")} />{More(changed.length, "changed symbols")}</>)}
    {Section("added", "Added and removed symbols", "", <><DiffView table={table("Symbols", symRemoved.concat(symAdded), "No symbol was added or removed.")} />{More(symAdded.length + symRemoved.length, "symbols")}</>)}
    {Section("contracts", "Contracts", "Contract clauses that appeared or disappeared with their owner.", <DiffView table={table("Contract clauses", contractRows, "No contract clause was added or removed.")} />)}
    {Section("renames", "Possible renames", "A heuristic: a removed and an added symbol of the same kind with the same signature. Never asserted as identity.", d.renames.length == 0 ? Empty("No rename detected.") :
      <div class="r-table-wrap ex-table" role="region" aria-label="Possible renames" tabindex={0}><table class="r-table">
        <thead><tr><th scope="col">From → to</th><th scope="col">Kind</th><th scope="col">Confidence</th><th scope="col">Basis</th></tr></thead><tbody>{renameRows}</tbody></table></div>)}
    {Section("edges", "Edges", "", <><DiffView table={table("Added and removed edges", edgeRows(d.removedEdges, false).concat(edgeRows(d.addedEdges, true)), "No edge changed.")} />{More(d.addedEdges.length + d.removedEdges.length, "edges")}</>)}
    {Section("effects", "Effects", d.effectsComparable ? "Transitive primitive effects that appeared, disappeared or changed evidence." : "Not compared: one of the snapshots predates effect summaries (osig/0.2).",
      <>{d.moduleEffects.length > 0 ? <div class="r-table-wrap ex-table" role="region" aria-label="Effects per module" tabindex={0}><table class="r-table">
          <thead><tr><th scope="col">Module</th><th scope="col">Gained</th><th scope="col">Lost</th></tr></thead><tbody>{modEff}</tbody></table></div> : empty()}
        <DiffView table={table("Effects per function", effectRows(d.effects), "No effect changed.")} /></>)}
    {Section("paths", "New call paths", "For every added call, the entry points that reach its caller.", CallPaths("New call paths", d.newPaths))}
    {d.removedPaths.length > 0 ? Section("gone", "Removed call paths", "", CallPaths("Removed call paths", d.removedPaths)) : empty()}
    {Section("impact", "Impact", "Entry points that reach each changed symbol.", d.impact.length == 0 ? Empty("No changed symbol has an impact path.") :
      <div class="r-table-wrap ex-table" role="region" aria-label="Impact" tabindex={0}><table class="r-table">
        <thead><tr><th scope="col">Changed symbol</th><th scope="col" class="r-num">Paths</th><th scope="col">Reached from</th></tr></thead>
        <tbody>{(d.impact.length > 60 ? d.impact.slice(0, 60) : d.impact).map(r => <ImpactRow r={r} />)}</tbody></table></div>)}
  </>;
  return document(<Frame ctx={ctx} active="diff" title="Changes" body={body} />);
}
