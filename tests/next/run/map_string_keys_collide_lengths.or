function main(): void {
  let m = new Map<string, int>();
  m.set("", 0);
  m.set("a", 1);
  m.set("A", 2);
  m.set("aa", 3);
  m.set("ab", 4);
  m.set("ba", 5);
  m.set("Aa", 6);
  m.set("BB", 7);
  console.log(m.get("").unwrap().toString());
  console.log(m.get("a").unwrap().toString() + m.get("A").unwrap().toString());
  console.log(m.get("Aa").unwrap().toString() + m.get("BB").unwrap().toString());
  console.log(m.get("ab").unwrap().toString() + m.get("ba").unwrap().toString());
  console.log(m.size.toString());
  let long1 = "";
  let long2 = "";
  let i = 0;
  while (i < 200) {
    long1 += "x";
    long2 += "x";
    i += 1;
  }
  m.set(long1, 100);
  console.log(m.get(long2).unwrap().toString());
  m.set(long2 + "y", 101);
  console.log(m.size.toString());
  console.log(m.get(long1 + "y").unwrap().toString());
}
