function main(): void {
  const x = 1;
  {
    const x = 2;
    console.log(x.toString());
    {
      const x = "inner";
      console.log(x);
    }
    console.log(x.toString());
  }
  console.log(x.toString());
  if (true) {
    let x = 100;
    x += 1;
    console.log(x.toString());
  }
  for (const x of [7, 8]) {
    console.log(x.toString());
  }
  console.log(x.toString());
  let y = 5;
  {
    let y = 6;
    y += 1;
  }
  console.log(y.toString());
}
