// Language Server Protocol message handling as PURE functions (spec 18 §3).
//
//   handle(state, msg) -> { state, out }     one decoded JSON-RPC message in, messages out
//   handleText(state, body)                  same, from the raw JSON text (parse errors -> -32700)
//   pump(state, buffer)                      Content-Length framed bytes in -> framed bytes out
//
// The stdio loop (reading stdin, writing stdout) is NOT here: the driver appends bytes to a
// buffer, calls `pump`, writes `output`, keeps `rest` as the new buffer and stops when
// `lspExitCode(state)` is Some.
//
// Phase 1 behaviour:
//   - Full-text sync. Every open document is its own analysis entry; on every change ALL open
//     documents are re-analysed and `publishDiagnostics` is sent for each open document, for
//     every other file that has diagnostics, and (empty) for files whose diagnostics went away.
//   - Only `file://` URIs are handled (others are ignored). Positions are UTF-16 based.
//   - definition/hover/references/rename need the checker's SemanticIndex; until the checker
//     produces it (`indexAvailable()`) they are not advertised and answer null.

import { FsGrant } from "std:fs";
import { Json, JField, JNull, JNum, JStr, JArr, JBool, JObj, jField, asArr, getField, getStr, getInt, getBool, getArr,
  getPath, getPathStr, getPathInt, parseJson, stringifyJson } from "../json";
import { Workspace, newWorkspace, openFile, changeFile, closeFile, openPaths, fileText, analyze, Analysis,
  PathDiag, fileIndexOf, indexAvailable, documentSymbols, readText, documentationAt, declCompletions, keywordCompletions,
  builtinCompletions, CompletionItem, DkLocal, posToOffset, definitionAt, hoverAt, referencesTo, renameEdits, implementationsAt,
  symbolSpanAt, symbolAt, TextEdit, effectsContext, isFunctionDef, hoverEffectText } from "../analysis";
import { SemanticIndex } from "../hir";
import { Span } from "../diag";
import { normalizePath } from "../loader";
import { frameMessage, unframe } from "./frame";
import { formatAvailable, formatDocument } from "./format";
import { uriToPath, pathToUri } from "./uri";
import { rangeJson, documentSymbolJson, completionJson, diagnosticJson, fullDocumentEdits } from "./convert";

export type LspState = {
  ws: Workspace;
  inited: bool;               // `initialize` received
  shutdownRequested: bool;
  exited: bool;               // `exit` received
  published: string[];        // paths that currently have non-empty diagnostics published
  // Test seam: when Some, used instead of `Analysis.index` (the checker does not produce one
  // yet). Remove once the checker side table exists.
  testIndex: Option<SemanticIndex>;
};

export type LspStep = { state: LspState; out: Json[]; };

export function newLspState(): LspState {
  const none: string[] = [];
  return LspState {
    ws: newWorkspace(), inited: false, shutdownRequested: false, exited: false,
    published: none, testIndex: None
  };
}

export function withTestIndex(st: LspState, idx: SemanticIndex): LspState {
  return LspState { ...st, testIndex: Some(idx) };
}

// Process exit code once `exit` was received: 0 after a prior `shutdown`, else 1.
export function lspExitCode(st: LspState): Option<int> {
  if (!st.exited) {
    return None;
  }
  return Some(st.shutdownRequested ? 0 : 1);
}

// ---- JSON-RPC envelopes -------------------------------------------------------------------

function respond(id: Json, result: Json): Json {
  return JObj([jField("jsonrpc", JStr("2.0")), jField("id", id), jField("result", result)]);
}

function respondError(id: Json, code: int, message: string): Json {
  return JObj([
    jField("jsonrpc", JStr("2.0")),
    jField("id", id),
    jField("error", JObj([jField("code", JNum(code)), jField("message", JStr(message))]))
  ]);
}

function notification(method: string, params: Json): Json {
  return JObj([jField("jsonrpc", JStr("2.0")), jField("method", JStr(method)), jField("params", params)]);
}

const PARSE_ERROR: int = -32700;
const INVALID_REQUEST: int = -32600;
const METHOD_NOT_FOUND: int = -32601;
const INVALID_PARAMS: int = -32602;
const SERVER_NOT_INITIALIZED: int = -32002;
const REQUEST_FAILED: int = -32803;

function step(st: LspState, out: Json[]): LspStep {
  return LspStep { state: st, out: out };
}

function none(st: LspState): LspStep {
  const out: Json[] = [];
  return LspStep { state: st, out: out };
}

// ---- entry points -------------------------------------------------------------------------

export function handleText(fs: FsGrant, st: LspState, body: string): LspStep {
  const r = parseJson(body);
  if (r.isErr()) {
    return step(st, [respondError(JNull, PARSE_ERROR, "parse error: " + r.unwrapErr())]);
  }
  return handle(fs, st, r.unwrap());
}

export function handle(fs: FsGrant, st: LspState, msg: Json): LspStep {
  if (st.exited) {
    return none(st);
  }
  const method = getStr(msg, "method");
  if (method.isNone()) {
    return none(st);   // a response from the client (we send no requests) or garbage
  }
  const id = getField(msg, "id");
  if (id.isSome()) {
    return handleRequest(fs, st, id.unwrap(), method.unwrap(), msg);
  }
  return handleNotification(fs, st, method.unwrap(), msg);
}

export type Pumped = { state: LspState; rest: string; output: string; };

// Feed raw bytes: decode all complete framed messages, handle them, return framed output.
export function pump(fs: FsGrant, st: LspState, buffer: string): Result<Pumped, string> {
  const u = unframe(buffer)?;
  let cur = st;
  let outs: string[] = [];
  for (const body of u.messages) {
    const s = handleText(fs, cur, body);
    cur = s.state;
    for (const j of s.out) {
      outs.push(frameMessage(stringifyJson(j)));
    }
  }
  return Ok(Pumped { state: cur, rest: u.rest, output: outs.join("") });
}

// ---- requests -----------------------------------------------------------------------------

function capabilities(st: LspState): Json {
  let caps: JField[] = [
    jField("textDocumentSync", JObj([
      jField("openClose", JBool(true)),
      jField("change", JNum(1)),
      jField("save", JObj([jField("includeText", JBool(false))]))
    ])),
    jField("documentSymbolProvider", JBool(true)),
    jField("completionProvider", JObj([jField("resolveProvider", JBool(false))]))
  ];
  if (formatAvailable()) {
    caps.push(jField("documentFormattingProvider", JBool(true)));
  }
  if (indexAvailable() || st.testIndex.isSome()) {
    caps.push(jField("definitionProvider", JBool(true)));
    caps.push(jField("hoverProvider", JBool(true)));
    caps.push(jField("referencesProvider", JBool(true)));
    caps.push(jField("implementationProvider", JBool(true)));
    caps.push(jField("renameProvider", JObj([jField("prepareProvider", JBool(true))])));
  }
  return JObj(caps);
}

function handleRequest(fs: FsGrant, st: LspState, id: Json, method: string, msg: Json): LspStep {
  if (method == "initialize") {
    const result = JObj([
      jField("capabilities", capabilities(st)),
      jField("serverInfo", JObj([jField("name", JStr("orin")), jField("version", JStr("0.1.0"))]))
    ]);
    return step(LspState { ...st, inited: true }, [respond(id, result)]);
  }
  if (!st.inited) {
    return step(st, [respondError(id, SERVER_NOT_INITIALIZED, "server not initialized")]);
  }
  if (st.shutdownRequested) {
    return step(st, [respondError(id, INVALID_REQUEST, "server is shutting down")]);
  }
  if (method == "shutdown") {
    return step(LspState { ...st, shutdownRequested: true }, [respond(id, JNull)]);
  }
  if (method == "textDocument/documentSymbol") {
    return reqDocumentSymbol(fs, st, id, msg);
  }
  if (method == "textDocument/completion") {
    return reqCompletion(fs, st, id, msg);
  }
  if (method == "textDocument/formatting") {
    return reqFormatting(fs, st, id, msg);
  }
  if (method == "textDocument/definition") {
    return reqDefinition(fs, st, id, msg);
  }
  if (method == "textDocument/hover") {
    return reqHover(fs, st, id, msg);
  }
  if (method == "textDocument/implementation") {
    return reqImplementation(fs, st, id, msg);
  }
  if (method == "textDocument/references") {
    return reqReferences(fs, st, id, msg);
  }
  if (method == "textDocument/prepareRename") {
    return reqPrepareRename(fs, st, id, msg);
  }
  if (method == "textDocument/rename") {
    return reqRename(fs, st, id, msg);
  }
  return step(st, [respondError(id, METHOD_NOT_FOUND, "method not found: " + method)]);
}

function docPath(msg: Json): Option<string> {
  const u = getPathStr(msg, ["params", "textDocument", "uri"]);
  if (u.isNone()) {
    return None;
  }
  return uriToPath(u.unwrap());
}

function invalidParams(st: LspState, id: Json): LspStep {
  return step(st, [respondError(id, INVALID_PARAMS, "invalid params")]);
}

function reqDocumentSymbol(fs: FsGrant, st: LspState, id: Json, msg: Json): LspStep {
  const p = docPath(msg);
  if (p.isNone()) {
    return invalidParams(st, id);
  }
  const text = readText(fs, st.ws, p.unwrap()).unwrapOr("");
  let items: Json[] = [];
  for (const s of documentSymbols(fs, st.ws, p.unwrap())) {
    items.push(documentSymbolJson(text, s));
  }
  return step(st, [respond(id, JArr(items))]);
}

// Parameters and locals of the function around the cursor that are declared before it
// (scope-insensitive approximation: sibling blocks are included).
function localCompletions(x: Ctx): CompletionItem[] {
  let out: CompletionItem[] = [];
  let seen: string[] = [];
  for (const d of x.idx.defs) {
    const isLocal = match (d.kind) {
      SkLocal => true,
      SkParam => true,
      _ => false
    };
    if (!isLocal || d.nameSpan.file != x.file || d.nameSpan.start >= x.off) {
      continue;
    }
    const inFn = match (d.container) {
      Some(f) => f < x.idx.defs.length && x.idx.defs[f].declSpan.file == x.file
        && x.idx.defs[f].declSpan.start <= x.off && x.off <= x.idx.defs[f].declSpan.end,
      None => false
    };
    if (!inFn) {
      continue;
    }
    let dup = false;
    for (const s of seen) {
      if (s == d.name) {
        dup = true;
      }
    }
    if (!dup) {
      seen.push(d.name);
      out.push(CompletionItem { label: d.name, kind: DkLocal, detail: d.detail });
    }
  }
  return out;
}

function reqCompletion(fs: FsGrant, st: LspState, id: Json, msg: Json): LspStep {
  const p = docPath(msg);
  if (p.isNone()) {
    return invalidParams(st, id);
  }
  let items: Json[] = [];
  for (const c of declCompletions(fs, st.ws, p.unwrap())) {
    items.push(completionJson(c));
  }
  const lc = context(fs, st, msg, false);
  if (lc.isSome()) {
    for (const c of localCompletions(lc.unwrap())) {
      items.push(completionJson(c));
    }
  }
  for (const c of keywordCompletions()) {
    items.push(completionJson(c));
  }
  for (const c of builtinCompletions()) {
    items.push(completionJson(c));
  }
  return step(st, [respond(id, JObj([jField("isIncomplete", JBool(false)), jField("items", JArr(items))]))]);
}

function reqFormatting(fs: FsGrant, st: LspState, id: Json, msg: Json): LspStep {
  const p = docPath(msg);
  if (p.isNone()) {
    return invalidParams(st, id);
  }
  const t = readText(fs, st.ws, p.unwrap());
  if (t.isNone()) {
    return invalidParams(st, id);
  }
  if (!formatAvailable()) {
    const none: Json[] = [];
    return step(st, [respond(id, JArr(none))]);   // stub: no edits
  }
  const r = formatDocument(t.unwrap());
  if (r.isErr()) {
    return step(st, [respondError(id, REQUEST_FAILED, r.unwrapErr())]);
  }
  return step(st, [respond(id, JArr(fullDocumentEdits(t.unwrap(), r.unwrap())))]);
}

// ---- index-based requests -----------------------------------------------------------------

type Ctx = { a: Analysis; idx: SemanticIndex; file: usize; off: usize; };

// Workspace-wide queries (references, rename) need an analysis whose program contains every
// user of the symbol: when `path` is imported by another open document, that document is used as
// the entry instead (first match in open order); otherwise `path` is its own entry.
function wideAnalysis(fs: FsGrant, st: LspState, path: string): Analysis {
  const me = normalizePath(path);
  for (const o of openPaths(st.ws)) {
    if (normalizePath(o) == me) {
      continue;
    }
    const a = analyze(fs, st.ws, o);
    if (a.index.isSome() && fileIndexOf(a, path).isSome()) {
      return a;
    }
  }
  return analyze(fs, st.ws, path);
}

// Analysis of the document, its semantic index and the cursor offset. None when the index is
// not available or the params are malformed.
function context(fs: FsGrant, st: LspState, msg: Json, wide: bool): Option<Ctx> {
  const p = docPath(msg);
  const line = getPathInt(msg, ["params", "position", "line"]);
  const ch = getPathInt(msg, ["params", "position", "character"]);
  if (p.isNone() || line.isNone() || ch.isNone() || line.unwrap() < 0 || ch.unwrap() < 0) {
    return None;
  }
  const a = wide ? wideAnalysis(fs, st, p.unwrap()) : analyze(fs, st.ws, p.unwrap());
  let idx: Option<SemanticIndex> = a.index;
  if (st.testIndex.isSome()) {
    idx = st.testIndex;
  }
  if (idx.isNone()) {
    return None;
  }
  const fi = fileIndexOf(a, p.unwrap());
  if (fi.isNone()) {
    return None;
  }
  const text = a.sm.files[fi.unwrap()].text;
  return Some(Ctx {
    a: a, idx: idx.unwrap(), file: fi.unwrap(),
    off: posToOffset(text, line.unwrap().toUsize(), ch.unwrap().toUsize())
  });
}

function spanText(a: Analysis, sp: Span): string {
  return a.sm.files[sp.file].text;
}

function locationJson(a: Analysis, sp: Span): Json {
  return JObj([
    jField("uri", JStr(pathToUri(a.sm.files[sp.file].path))),
    jField("range", rangeJson(spanText(a, sp), sp.start, sp.end))
  ]);
}

function reqDefinition(fs: FsGrant, st: LspState, id: Json, msg: Json): LspStep {
  const c = context(fs, st, msg, false);
  if (c.isNone()) {
    return step(st, [respond(id, JNull)]);
  }
  const x = c.unwrap();
  const d = definitionAt(x.idx, x.file, x.off);
  if (d.isNone()) {
    return step(st, [respond(id, JNull)]);
  }
  return step(st, [respond(id, locationJson(x.a, d.unwrap()))]);
}

// Go to implementations (ADR-0019): classes implementing the interface at the cursor, or their methods.
function reqImplementation(fs: FsGrant, st: LspState, id: Json, msg: Json): LspStep {
  const c = context(fs, st, msg, true);
  let locs: Json[] = [];
  if (c.isSome()) {
    const x = c.unwrap();
    for (const sp of implementationsAt(x.idx, x.file, x.off)) {
      locs.push(locationJson(x.a, sp));
    }
  }
  return step(st, [respond(id, JArr(locs))]);
}

function reqHover(fs: FsGrant, st: LspState, id: Json, msg: Json): LspStep {
  const c = context(fs, st, msg, false);
  if (c.isNone()) {
    return step(st, [respond(id, JNull)]);
  }
  const x = c.unwrap();
  const h = hoverAt(x.idx, x.file, x.off);
  if (h.isNone()) {
    return step(st, [respond(id, JNull)]);
  }
  const info = h.unwrap();
  let value = "```orin\n" + info.text + "\n```";
  // Documentation follows the resolved declaration (including cross-file references).
  // Contracts are already part of the symbol signature; never claim they are verified here.
  const sym = symbolAt(x.idx, x.file, x.off);
  if (sym.isSome() && sym.unwrap() < x.idx.defs.length) {
    const def = x.idx.defs[sym.unwrap()];
    if (def.declSpan.file < x.a.sm.files.length) {
      const source = x.a.sm.files[def.declSpan.file].text;
      const doc = documentationAt(source, def.declSpan.start);
      if (doc.isSome()) {
        value += "\n\n" + doc.unwrap();
      }
    }
  }
  // A function, method or constructor: its inferred effect summary (ADR-0037 D2; the same analysis as `orin effects`).
  if (sym.isSome() && x.a.program.isSome()) {
    const ec = effectsContext(x.a.program.unwrap(), x.idx, x.a.sm);
    if (isFunctionDef(ec, sym.unwrap())) {
      value = value + "\n\n" + hoverEffectText(ec, sym.unwrap());
    }
  }
  const contents = JObj([
    jField("kind", JStr("markdown")),
    jField("value", JStr(value))
  ]);
  return step(st, [respond(id, JObj([
    jField("contents", contents),
    jField("range", rangeJson(spanText(x.a, info.span), info.span.start, info.span.end))
  ]))]);
}

function reqReferences(fs: FsGrant, st: LspState, id: Json, msg: Json): LspStep {
  const c = context(fs, st, msg, true);
  let locs: Json[] = [];
  if (c.isSome()) {
    const x = c.unwrap();
    let includeDecl = false;
    const ctx = getPath(msg, ["params", "context"]);
    if (ctx.isSome()) {
      includeDecl = getBool(ctx.unwrap(), "includeDeclaration").unwrapOr(false);
    }
    for (const sp of referencesTo(x.idx, x.file, x.off, includeDecl)) {
      locs.push(locationJson(x.a, sp));
    }
  }
  return step(st, [respond(id, JArr(locs))]);
}

function reqPrepareRename(fs: FsGrant, st: LspState, id: Json, msg: Json): LspStep {
  const c = context(fs, st, msg, true);
  if (c.isNone()) {
    return step(st, [respond(id, JNull)]);
  }
  const x = c.unwrap();
  const s = symbolSpanAt(x.idx, x.file, x.off);
  if (s.isNone()) {
    return step(st, [respond(id, JNull)]);
  }
  const sp = s.unwrap();
  const text = spanText(x.a, sp);
  return step(st, [respond(id, JObj([
    jField("range", rangeJson(text, sp.start, sp.end)),
    jField("placeholder", JStr(text.substring(sp.start, sp.end)))
  ]))]);
}

function reqRename(fs: FsGrant, st: LspState, id: Json, msg: Json): LspStep {
  const c = context(fs, st, msg, true);
  const newName = getPathStr(msg, ["params", "newName"]);
  if (newName.isNone()) {
    return invalidParams(st, id);
  }
  if (c.isNone()) {
    return step(st, [respondError(id, REQUEST_FAILED, "no semantic information available for rename")]);
  }
  const x = c.unwrap();
  if (st.testIndex.isNone() && x.a.diags.length > 0) {
    // The index is partial while the program has errors (type-dependent references are missing).
    return step(st, [respondError(id, REQUEST_FAILED, "fix the errors in the workspace before renaming")]);
  }
  const r = renameEdits(x.idx, x.file, x.off, newName.unwrap());
  if (r.isErr()) {
    return step(st, [respondError(id, REQUEST_FAILED, r.unwrapErr())]);
  }
  // Group edits by file, in order of first appearance.
  let files: usize[] = [];
  let lists: Json[][] = [];
  for (const e of r.unwrap()) {
    let k: usize = 0;
    let found = false;
    while (k < files.length) {
      if (files[k] == e.span.file) {
        found = true;
        break;
      }
      k += 1;
    }
    if (!found) {
      files.push(e.span.file);
      const empty: Json[] = [];
      lists.push(empty);
      k = files.length - 1;
    }
    lists[k].push(JObj([
      jField("range", rangeJson(spanText(x.a, e.span), e.span.start, e.span.end)),
      jField("newText", JStr(e.newText))
    ]));
  }
  let changes: JField[] = [];
  let i: usize = 0;
  while (i < files.length) {
    changes.push(jField(pathToUri(x.a.sm.files[files[i]].path), JArr(lists[i])));
    i += 1;
  }
  return step(st, [respond(id, JObj([jField("changes", JObj(changes))]))]);
}

// ---- notifications and diagnostics --------------------------------------------------------

function handleNotification(fs: FsGrant, st: LspState, method: string, msg: Json): LspStep {
  if (method == "exit") {
    return none(LspState { ...st, exited: true });
  }
  if (!st.inited || st.shutdownRequested) {
    return none(st);
  }
  if (method == "textDocument/didOpen") {
    const p = docPath(msg);
    const text = getPathStr(msg, ["params", "textDocument", "text"]);
    if (p.isNone() || text.isNone()) {
      return none(st);
    }
    const ws = openFile(st.ws, p.unwrap(), text.unwrap());
    const st2 = LspState { ...st, ws: ws };
    const none2: string[] = [];
    return republish(fs, st2, none2);
  }
  if (method == "textDocument/didChange") {
    const p = docPath(msg);
    const changes = getPath(msg, ["params", "contentChanges"]);
    if (p.isNone() || changes.isNone()) {
      return none(st);
    }
    const itemsOpt = asArr(changes.unwrap());
    if (itemsOpt.isNone() || itemsOpt.unwrap().length == 0) {
      return none(st);
    }
    const items = itemsOpt.unwrap();
    // Full sync: the last change carries the whole document.
    const text = getStr(items[items.length - 1], "text");
    if (text.isNone()) {
      return none(st);
    }
    const st2 = LspState { ...st, ws: changeFile(st.ws, p.unwrap(), text.unwrap()) };
    const none2: string[] = [];
    return republish(fs, st2, none2);
  }
  if (method == "textDocument/didSave") {
    const none2: string[] = [];
    return republish(fs, st, none2);
  }
  if (method == "textDocument/didClose") {
    const p = docPath(msg);
    if (p.isNone()) {
      return none(st);
    }
    const st2 = LspState { ...st, ws: closeFile(st.ws, p.unwrap()) };
    return republish(fs, st2, [p.unwrap()]);
  }
  return none(st);   // initialized, $/cancelRequest, workspace/*, ... are ignored
}

type LDiag = { path: string; key: string; json: Json; };

function hasKey(ds: LDiag[], key: string): bool {
  for (const d of ds) {
    if (d.key == key) {
      return true;
    }
  }
  return false;
}

// Diagnostics of all open documents (each analysed as its own entry), de-duplicated.
function collectDiags(fs: FsGrant, ws: Workspace): LDiag[] {
  let out: LDiag[] = [];
  for (const entry of openPaths(ws)) {
    const a = analyze(fs, ws, entry);
    let both = a.diags;
    for (const w of a.warnings) {
      both.push(w);
    }
    for (const d of both) {
      const key = d.path + "|" + d.code + "|" + d.start.toString() + "|" + d.end.toString() + "|" + d.message;
      if (hasKey(out, key)) {
        continue;
      }
      const fi = fileIndexOf(a, d.path);
      let text = "";
      if (fi.isSome()) {
        text = a.sm.files[fi.unwrap()].text;
      }
      out.push(LDiag { path: d.path, key: key, json: diagnosticJson(text, d) });
    }
  }
  return out;
}

function addUnique(xs: string[], x: string): string[] {
  let out = xs;
  for (const y of xs) {
    if (y == x) {
      return out;
    }
  }
  out.push(x);
  return out;
}

// Recompute diagnostics and publish them for: every open document, every file that has
// diagnostics, every file that had diagnostics published before, and `extra` (e.g. a document
// that was just closed, so its markers are cleared).
function republish(fs: FsGrant, st: LspState, extra: string[]): LspStep {
  const all = collectDiags(fs, st.ws);
  let targets: string[] = [];
  for (const p of openPaths(st.ws)) {
    targets = addUnique(targets, p);
  }
  let nowPublished: string[] = [];
  for (const d of all) {
    targets = addUnique(targets, d.path);
    nowPublished = addUnique(nowPublished, d.path);
  }
  for (const p of st.published) {
    targets = addUnique(targets, p);
  }
  for (const p of extra) {
    targets = addUnique(targets, p);
  }
  let out: Json[] = [];
  for (const t of targets) {
    let arr: Json[] = [];
    for (const d of all) {
      if (d.path == t) {
        arr.push(d.json);
      }
    }
    out.push(notification("textDocument/publishDiagnostics", JObj([
      jField("uri", JStr(pathToUri(t))),
      jField("diagnostics", JArr(arr))
    ])));
  }
  return step(LspState { ...st, published: nowPublished }, out);
}
