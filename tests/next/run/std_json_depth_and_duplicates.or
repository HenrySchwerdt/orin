import { parse, get, stringify, asInt } from "std:json/legacy";

function nest(n: int): string {
  let open: string[] = [];
  let close: string[] = [];
  let i = 0;
  while (i < n) {
    open.push("[");
    close.push("]");
    i += 1;
  }
  return open.join("") + "1" + close.join("");
}

function main(): void {
  console.log(parse(nest(150)).isOk().toString());
  const deep = parse(nest(300));
  console.log(deep.isErr().toString());
  console.log(deep.unwrapErr().message);
  const d = parse("{\"a\":1,\"b\":2,\"a\":3}").unwrap();
  console.log(asInt(get(d, "a").unwrap()).unwrap().toString());
  console.log(stringify(d));
}
