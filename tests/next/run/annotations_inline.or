// @Inline (ADR-0024) is a backend hint: the C backend emits `static inline`, LLVM `alwaysinline`;
// behaviour is identical with and without it (all backends and the differential tests agree).
@Inline
function square(x: int): int {
  return x * x;
}

@Inline
function pick(c: bool, a: int, b: int): int {
  return c ? a : b;
}

@Inline
function greet(name: string): string {
  return "hello " + name;
}

@Inline
function sum<T>(xs: int[], extra: T): int {
  let t = 0;
  for (const x of xs) {
    t += x;
  }
  return t;
}

@Inline
function bump(xs: int[]): int[] {
  let ys = xs;
  ys.push(99);
  return ys;
}

class Counter {
  n: int;

  constructor(start: int) {
    this.n = start;
  }

  @Inline
  incr(by: int): void {
    this.n += by;
  }

  @Inline
  get(): int {
    return this.n;
  }

  @Inline
  static zero(): Counter {
    return new Counter(0);
  }
}

// Not recursive itself: it calls an @Inline function that calls back is an error (E0444), but a
// chain of distinct @Inline functions is fine.
@Inline
function a1(x: int): int {
  return x + 1;
}

@Inline
function a2(x: int): int {
  return a1(a1(x));
}

function viaValue(f: (x: int) => int, x: int): int {
  return f(x);
}

function main(): void {
  console.log(square(7).toString());
  console.log(pick(true, 1, 2).toString() + pick(false, 1, 2).toString());
  console.log(greet("orin"));
  console.log(sum([1, 2, 3], "x").toString());
  console.log(bump([1]).length.toString());
  let c = Counter.zero();
  c.incr(5);
  c.incr(6);
  console.log(c.get().toString());
  console.log(a2(1).toString());
  // an @Inline function used as a value is an ordinary function value
  console.log(viaValue(square, 9).toString());
  console.log(viaValue(x => a2(x), 10).toString());
}
