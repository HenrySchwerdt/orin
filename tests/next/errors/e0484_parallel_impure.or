// error: E0484
// A closure of a parallel pipeline must be pure (ADR-0039 §3.1): the chunks run on several tasks in no fixed order, so the
// output of `console.log` would come in an unpredictable order. The message names the effect and where it happens.
function main(): void {
  const xs = [1, 2, 3];
  const ys = xs.parallel().map(x => {
    console.log(x.toString());
    return x;
  }).toArray();
}
