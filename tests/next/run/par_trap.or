// exit: 101
// stderr: trap: integer overflow
// A trap in a closure of a parallel pipeline traps the program with the closure's own message, as the sequential chain
// would (the worker task's panic is not wrapped in `task panicked:`); the other workers are cancelled and joined first.
function main(): void {
  let xs: int[] = [];
  let i = 0;
  while (i < 30000) {
    xs.push(i == 20000 ? 9223372036854775807 : i);
    i += 1;
  }
  console.log("start");
  const r = xs.parallel().map(x => x + 1).toArray();
  console.log(r.length.toString());
}
