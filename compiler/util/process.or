// Running shell commands.
//
// The compiler's own convention (kept for its many call sites): a plain exit status, -1 when the command could not be
// run to completion, -2 when the time limit ran out. std:io reports these as a `Result` (ADR-0048); this module turns
// them back into the compiler-internal status code.

import { ProcessGrant } from "std:process";
import { shell, shellTimeout, ProcessError, Timeout } from "std:io";
import { seconds } from "std:time";

function statusOf(r: Result<int, ProcessError>): int {
  return match (r) {
    Ok(status) => status,
    Err(e) => match (e.kind) {
      Timeout => 0 - 2,
      _ => 0 - 1
    }
  };
}

// Runs a shell command, returns its exit status (-1: could not run / signalled).
export function shellRun(proc: ProcessGrant, cmd: string): int {
  return statusOf(shell(proc, cmd));
}

// seconds > 0: native monotonic deadline; -2 timeout. 0 explicitly disables the limit.
export function shellRunTimeout(proc: ProcessGrant, cmd: string, limit: int): int {
  if (limit == 0) { return shellRun(proc, cmd); }
  return statusOf(shellTimeout(proc, cmd, seconds(limit)));
}
