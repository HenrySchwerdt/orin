function show(m: Map<string, int>): string {
  return m.entries().map(e => e.key + "=" + e.value.toString()).join(",");
}

function withExtra(m: Map<string, int>): Map<string, int> {
  let c = m;
  c.set("extra", 99);
  return c;
}

function bump(m: Map<string, int>): void {
  let local = m;
  local.set("a", 1000);
  console.log("inside: " + show(local));
}

function main(): void {
  let a = new Map<string, int>();
  a.set("a", 1);
  a.set("b", 2);
  const b = a;
  a.set("c", 3);
  a.set("a", 10);
  console.log("a: " + show(a));
  console.log("b: " + show(b));
  const d = withExtra(a);
  console.log("a: " + show(a));
  console.log("d: " + show(d));
  bump(a);
  console.log("a: " + show(a));
  let e = b;
  e.delete("a");
  console.log("b: " + show(b));
  console.log("e: " + show(e));
  let ms: Map<string, int>[] = [a, b];
  ms[0].set("z", 26);
  console.log("a: " + show(a));
  console.log("ms0: " + show(ms[0]));
  console.log("ms1: " + show(ms[1]));
}
