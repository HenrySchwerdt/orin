type Pair<A, B> = { first: A; second: B; };

function twice<T>(x: T): Pair<T, T> {
  return Pair { first: x, second: x };
}

function first<T>(xs: T[]): Option<T> {
  return xs.get(0);
}

function scale(k: float): (v: float) => float {
  return (v: float) => v * k;
}

function compose(f: (v: float) => float, g: (v: float) => float): (v: float) => float {
  return (v: float) => g(f(v));
}

function apply<T>(f: (x: T) => T, x: T): T {
  return f(x);
}

function main(): void {
  const p = twice(2.5);
  console.log(p.first.toString() + " " + p.second.toString());
  const q: Pair<float, int> = Pair { first: 1.25, second: 3 };
  console.log(q.first.toString() + " " + q.second.toString());
  console.log(first([4.5, 5.5]).unwrap().toString());
  const f = scale(2.5);
  const h = compose(f, v => v + 1.0);
  console.log(f(4.0).toString());
  console.log(h(4.0).toString());
  console.log(apply(v => v * v, 1.5).toString());
  const offset = 0.25;
  const adders = [1.0, 2.0, 3.0].map(x => (y: float) => x + y + offset);
  console.log(adders[1](10.0).toString());
  let acc = 0.0;
  [1.5, 2.5].forEach(x => { console.log(x.toString()); });
  acc += 1.0;
  console.log(acc.toString());
  const fs: f32[] = [0.5, 0.25];
  console.log(fs.map(x => x * 2.0).map(x => x.toString()).join(" "));
}
