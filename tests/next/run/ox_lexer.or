// The `<` of OX (ADR-0043) is told apart from the less-than operator and type arguments by the token before it: after
// a name, a literal, `)`, `]` or `}` it is an operator, after `(`, `,`, `=`, `=>`, `?`, `:`, `{`, `[`, `return`, an
// operator or `${` it starts an element (when a tag name or `>` follows).
import { Html, render } from "std:html";
import ox from "std:html";

type Pair<A, B> = { a: A; b: B; };

function id<T>(x: T): T {
  return x;
}

function pick(c: bool): Html {
  return c ? <b>yes</b> : <i>no</i>;
}

function main(): void {
  const a = 1;
  const b = 2;
  const lt = a <b;
  const le = a <=b;
  const gen = id<int>(a) <b;
  const pair = Pair<int, string> { a: 1, b: "x" };
  const arr = [1, 2, 3];
  const idx = arr[0] <arr[1];
  const call = id(a) <b;
  console.log(`${lt} ${le} ${gen} ${pair.a <pair.b.length.toInt() + 1} ${idx} ${call}`);
  const xs: Html[] = [<p>1</p>, <p>2</p>];
  const m: Map<string, Html> = new Map<string, Html>();
  console.log(render(pick(a <b)) + render(pick(a> b)) + render(xs[1]));
  console.log(`${render(<em>in a template</em>)} after`);
  const f = (x: int): Html => <span>{x}</span>;
  console.log(render(f(5)) + render(id(<br />)) + `${m.size}`);
}
