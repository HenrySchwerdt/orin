size: 0.75rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--r-ink-2); }\n.r-meta dd { margin: 0; overflow-wrap: anywhere; }\n.r-nav { display: flex; flex-wrap: wrap; gap: 0.25rem 1rem; margin: 1rem 0 0; padding: 0; list-style: none; font-size: 0.92rem; }\n.r-section { margin-top: 2.5rem; scroll-margin-top: 1rem; }\n.r-section > h2 { margin: 0 0 0.35rem; font-size: 1.35rem; line-height: 1.25; }\n.r-section > h3, .r-block > h3 { margin: 1.5rem 0 0.5rem; font-size: 1.05rem; }\n.r-intro { margin: 0 0 1rem; color: var(--r-ink-2); max-width: 70ch; }\n.r-block { margin-top: 1rem; }\n.r-cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr)); gap: 0.85rem; margin: 1.5rem 0 0; padding: 0; list-style: none; }\n/* r-cols-N: the column count on a wide page, chosen by the component so that no row ends with a lone card; fewer on narrow pages */\n.r-cols-1 { grid-template-columns: minmax(0, 1fr); }\n.r-cols-2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }\n.r-cols-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }\n.r-cols-4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }\n.r-cols-5 { grid-template-columns: repeat(5, minmax(0, 1fr)); }\n.r-card { background: var(--r-surface); border: 1px solid var(--r-line); border-radius: var(--r-radius); padding: 1rem 1.1rem; min-width: 0; box-shadow: 0 1px 2px rgba(16, 20, 30, 0.05); }\n.r-card-label { font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--r-ink-2); }\n.r-card-value { font-size: 1.6rem; line-height: 1.25; font-weight: 650; font-variant-numeric: tabular-nums; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\n.r-card-note { margin-top: 0.15rem; font-size: 0.85rem; color: var(--r-ink-2); }\n.r-card-status { margin-top: 0.5rem; }\n.r-notice { display: flex; gap: 0.6rem; align-items: baseline; margin: 1rem 0 0; padding: 0.7rem 1rem; border-radius: var(--r-radius); border: 1px solid var(--r-line); background: var(--r-surface); }\n.r-notice-failed { border-color: var(--r-failed-fg); background: var(--r-failed-bg); color: var(--r-failed-fg); }\n.r-notice-regression { border-color: var(--r-regression-fg); background: var(--r-regression-bg); color: var(--r-regression-fg); }\n.r-notice-passed { border-color: var(--r-passed-fg); background: var(--r-passed-bg); color: var(--r-passed-fg); }\n.r-table-wrap { box-shadow: 0 1px 2px rgba(16, 20, 30, 0.05); overflow-x: auto; background: var(--r-surface); border: 1px solid var(--r-line); border-radius: var(--r-radius); }\n.r-table { width: 100%; border-collapse: collapse; font-size: 0.92rem; }\n.r-table caption { text-align: left; padding: 0.7rem 0.9rem; font-weight: 600; caption-side: top; }\n.r-table th, .r-table td { padding: 0.5rem 0.9rem; border-top: 1px solid var(--r-line); text-align: left; vertical-align: baseline; }\n.r-table thead th { background: var(--r-surface-2); font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--r-ink-2); white-space: nowrap; }\n.r-table tbody th { font-weight: 600; white-space: nowrap; }\n.r-table tbody tr:hover { background: var(--r-surface-2); }\n.r-table .r-num { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }\n.r-table .r-mono { font-family: var(--r-mono); font-size: 0.88em; }\n.r-diff-mark { display: inline-block; width: 1.4rem; text-align: center; font-family: var(--r-mono); font-weight: 700; }\n.r-diff-added { background: var(--r-passed-bg); color: var(--r-passed-fg); }\n.r-diff-removed { background: var(--r-failed-bg); color: var(--r-failed-fg); }\n.r-diff-changed { background: var(--r-regression-bg); color: var(--r-regression-fg); }\n.r-table tbody tr.r-diff-added:hover, .r-table tbody tr.r-diff-removed:hover, .r-table tbody tr.r-diff-changed:hover { filter: brightness(0.97); background: inherit; }\n.r-empty { padding: 1rem 0.9rem; color: var(--r-ink-2); }\n.r-badge { display: inline-flex; align-items: center; gap: 0.3rem; padding: 0.05rem 0.55rem; border-radius: 999px; font-size: 0.78rem; font-weight: 650; line-height: 1.5; white-space: nowrap; border: 1px solid currentColor; }\n.r-badge-passed { background: var(--r-passed-bg); color: var(--r-passed-fg); }\n.r-badge-failed { background: var(--r-failed-bg); color: var(--r-failed-fg); }\n.r-badge-regression { background: var(--r-regression-bg); color: var(--r-regression-fg); }\n.r-badge-improvement { background: var(--r-improvement-bg); color: var(--r-improvement-fg); }\n.r-badge-unproven { background: var(--r-unproven-bg); color: var(--r-unproven-fg); }\n.r-badge-timeout { background: var(--r-timeout-bg); color: var(--r-timeout-fg); }\n.r-badge-info { background: var(--r-info-bg); color: var(--r-info-fg); }\n.r-badge-skipped { background: var(--r-skipped-bg); color: var(--r-skipped-fg); }\n.r-figure { margin: 1rem 0 0; background: var(--r-surface); border: 1px solid var(--r-line); border-radius: var(--r-radius); padding: 0.75rem; overflow-x: auto; }\n.r-figure svg { display: block; max-width: 100%; height: auto; margin: 0 auto; }\n.r-figure figcaption { margin-top: 0.5rem; font-size: 0.85rem; color: var(--r-ink-2); }\n.r-details { margin-top: 1rem; }\n.r-details summary { cursor: pointer; font-weight: 600; }\n.r-pre { margin: 0.5rem 0 0; padding: 0.8rem 1rem; overflow-x: auto; background: var(--r-surface); border: 1px solid var(--r-line); border-radius: var(--r-radius); font-family: var(--r-mono); font-size: 0.85rem; line-height: 1.45; }\n.r-footer { margin-top: 3rem; padding-top: 1rem; border-top: 1px solid var(--r-line); color: var(--r-ink-2); font-size: 0.85rem; }\n@media (max-width: 72rem) {\n  .r-cols-4 { grid-template-columns: repeat(2, minmax(0, 1fr)); }\n  .r-cols-5 { grid-template-columns: repeat(3, minmax(0, 1fr)); }\n}\n@media (max-width: 60rem) {\n  .r-layout { grid-template-columns: minmax(0, 1fr); }\n  .r-sidebar { position: static; max-height: none; padding: 1.5rem 0 0; }\n  .r-sidebar .r-nav { flex-direction: row; flex-wrap: wrap; }\n}\n@media (max-width: 40rem) {\n  .r-header { padding-top: 1.5rem; }\n  .r-table th, .r-table td { padding: 0.45rem 0.65rem; }\n  .r-card-value { font-size: 1.4rem; }\n  .r-cols-3, .r-cols-4, .r-cols-5 { grid-template-columns: repeat(2, minmax(0, 1fr)); }\n}\n@media print {\n  body { background: #fff; color: #000; }\n  .r-skip, .r-sidebar { display: none; }\n  .r-table-wrap, .r-figure, .r-card { break-inside: avoid; }\n}\n"}</style>;
}
