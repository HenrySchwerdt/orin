// f32: binary32 arithmetic (every operation rounds to binary32), shortest printing
function main(): void {
  const a: f32 = 0.1;
  const b: f32 = 0.2;
  console.log(a.toString());
  console.log((a + b).toString());
  console.log((a * 3.0).toString());
  console.log((1.0 / 3.0 + a).toString());
  const third: f32 = 1.0 / 3.0;
  console.log(third.toString());
  console.log(third.toFloat().toString());
  console.log((third * 3.0).toString());
  const big: f32 = 16777216.0;
  console.log((big + 1.0).toString());
  console.log((big + 2.0).toString());
  const f: f32 = 3.4028235e38;
  console.log(f.toString());
  console.log((f * 2.0).toString());
  const tiny: f32 = 1e-45;
  console.log(tiny.toString());
  console.log(3.14159.toF32().toString());
  const n: int = 16777217;
  console.log(n.toF32().toString());
  console.log(n.toFloat().toString());
  console.log(a.sqrt().toString());
  console.log((a < b).toString());
  console.log(a.toInt().toString());
  console.log((a + b).toFloat().toString());
  console.log((-a).toString());
  const g: f32 = 0.1;
  console.log((a == g).toString());
  const sevenTenths = a.toFloat() * 7.0;
  console.log(sevenTenths.toString());
}
