// error: E0484
// Purity is inferred through calls: `show` performs I/O, so a closure that calls it is not pure (ADR-0039 §3.1).
function show(x: int): int {
  console.log(x.toString());
  return x;
}

function main(): void {
  const n = [1, 2, 3].parallel().filter(x => show(x) > 1).toArray().length;
}
