import { assertEq, assertEqString, assertEqBool } from "std:test";
import { Json, parse } from "std:json/legacy";
import { sortedStrs } from "../src/text";
import { at, has, eq, str, len, strs, isIntEq, isBoolEq, isStrEq, isNull, strEq, S, N, B, O, F, A, SA, show } from "../src/jx";

function doc(text: string): Json {
  return parse(text).unwrap();
}

@Test
function pathsAreTotal(): void {
  const j = doc("{\"result\":{\"items\":[{\"label\":\"a\"},{\"label\":\"b\"}],\"n\":3},\"file:///x.or\":true}");
  assertEqString(str(at(j, ["result", "items", "1", "label"])), "b", "array index in a path");
  assertEqBool(isIntEq(at(j, ["result", "n"]), 3), true, "int");
  assertEqBool(isBoolEq(at(j, ["file:///x.or"]), true), true, "key with dots and slashes");
  assertEqBool(isNull(at(j, ["result", "items", "9"])), true, "index out of range");
  assertEqBool(isNull(at(j, ["nope", "deeper"])), true, "missing key");
  assertEqBool(isNull(at(j, ["result", "n", "x"])), true, "step into a number");
  assertEqBool(has(j, "result"), true, "has");
  assertEqBool(has(j, "nope"), false, "has not");
}

@Test
function equalityIgnoresFieldOrder(): void {
  const a = doc("{\"a\":1,\"b\":[1,2,{\"c\":null}]}");
  const b = doc("{\"b\":[1,2,{\"c\":null}],\"a\":1}");
  assertEqBool(eq(a, b), true, "same");
  assertEqBool(eq(a, doc("{\"a\":1,\"b\":[1,2,{\"c\":0}]}")), false, "different leaf");
  assertEqBool(eq(a, doc("{\"a\":1}")), false, "missing field");
  assertEqBool(eq(doc("[]"), doc("[]")), true, "empty arrays");
  assertEqBool(eq(doc("[]"), doc("{}")), false, "array is not object");
  assertEqBool(eq(doc("[1,2]"), doc("[2,1]")), false, "array order matters");
}

@Test
function builders(): void {
  const j = O([F("a", N(1)), F("b", A([S("x"), B(true)])), F("c", SA(["p", "q"]))]);
  assertEqString(show(j), "{\"a\":1,\"b\":[\"x\",true],\"c\":[\"p\",\"q\"]}", "compact output");
  assertEq(len(at(j, ["c"])), 2, "len");
}

@Test
function stringHelpers(): void {
  const j = doc("[\"b\",\"a\",\"c\"]");
  assertEqBool(strEq(strs(j), ["b", "a", "c"]), true, "strs");
  assertEqBool(strEq(sortedStrs(strs(j)), ["a", "b", "c"]), true, "sorted");
  assertEqBool(isStrEq(S("x"), "x"), true, "string equality");
}
