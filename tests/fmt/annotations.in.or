// Built-in annotations (ADR-0024): one per line above the declaration, in the order they were written,
// followed by the contract clauses.
import { assert } from "std:test";

   @Inline   @Requires(a>=0)
 @Deprecated(  "use addChecked"  )
function add(a:int,b:int):int{return a+b;}

@Test
function addsTwo():void{assert(add(1,2)==3,"1+2");}

@Deprecated("old shape")
export type Shape={w:int;h:int;};

@Deprecated("use Counter2")
class Counter {
  n:int;
  constructor(){this.n=0;}
  @Inline @Deprecated("use bump")
  incr():void{this.n+=1;}
  // keeps working
  @Inline
  get():int{return this.n;}
}

@Deprecated("use Shape2")
interface Sized {
  @Deprecated("use width2") width():int;
  height():int;
}

function main(): void {
  console.log(add(1,2).toString());
}
