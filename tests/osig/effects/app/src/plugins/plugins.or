// A call through an interface is the union over the implementations the program declares.
export interface Plugin {
  run(msg: string): void;
}

export class Logger implements Plugin {
  run(msg: string): void {
    console.log(msg);
  }
}

export class Quiet implements Plugin {
  run(msg: string): void {
  }
}

function each(ps: Plugin[], msg: string): void {
  for (const p of ps) {
    p.run(msg);
  }
}

export function emitAll(): void {
  const ps: Plugin[] = [new Logger(), new Quiet()];
  each(ps, "hello");
}
