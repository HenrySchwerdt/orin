import { Graph, GraphError, graphErrorMessage, StaleId, ForeignId } from "std:graph";

// ADR-0048: `has` is the membership test; `contains` stays one release as a @Deprecated wrapper.
function main(): void {
  let g = new Graph<string>(3);
  console.log(g.isEmpty().toString());
  const a = g.add("alpha");
  console.log(g.isEmpty().toString());
  console.log(g.has(a).toString() + " " + g.contains(a).toString());
  g.remove(a).unwrap();
  console.log(g.has(a).toString() + " " + g.contains(a).toString());
  const e: GraphError = g.get(a).unwrapErr();
  console.log(graphErrorMessage(e));
  console.log(match (e.kind) { StaleId => "stale", ForeignId => "foreign" });
}
