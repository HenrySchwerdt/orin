type Point = { x: int; y: int; };
type Shape = Circle(int) | Rect(int, int);
type Pair<A, B> = { first: A; second: B; };

function id<T>(x: T): T {
  return x;
}

function area(s: Shape): int {
  return match (s) {
    Circle(r) => 3 * r * r,
    Rect(w, h) => w * h,
  };
}

function main(): void {
  const p = id(Point { x: 1, y: 2 });
  console.log((p.x + p.y).toString());
  const s = id(Rect(3, 4));
  console.log(area(s).toString());
  const q = Pair { first: Point { x: 5, y: 6 }, second: Circle(2) };
  console.log(q.first.y.toString() + area(q.second).toString());
  const shapes = id([Circle(1), Rect(2, 2)]);
  console.log(area(shapes[1]).toString());
}
