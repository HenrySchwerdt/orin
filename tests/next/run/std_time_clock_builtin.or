import { Host, useHost } from "std:host";
import { ClockGrant } from "std:time";
import { nowMillis } from "std:clock";

function main(host: Host): void {
  useHost(host, (fs, proc, stdio, clock) => { run(clock); });
}
function run(clock: ClockGrant): void {
  console.log((nowMillis(clock) > 0).toString());
}
