// std:math (spec 08, ADR-0018), written in Orin on top of the `float` methods (libm / LLVM intrinsics).
//
// `import { sqrt, PI } from "std:math";` resolves to this file (loader/loader.or, unit `$array/math`); the file is
// part of the always-embedded `$array` prelude root but is only *loaded* when a program imports it.
// All functions work on `float`. Edge cases are defined (IEEE-754):
//   sqrt(x)      NaN for x < 0 and NaN; sqrt(-0.0) = -0.0; sqrt(Infinity) = Infinity
//   abs(x)       |x|; abs(-0.0) = 0.0; abs(NaN) = NaN
//   min / max    NaN if either argument is NaN; min(-0.0, 0.0) = -0.0, max(-0.0, 0.0) = 0.0
//   pow(x, y)    C `pow` (pow(1.0, NaN) = 1.0, pow(x, 0.0) = 1.0)
//   floor/ceil   results stay floats (use `.toInt()` for an integer); round is half away from zero

// PI: float -- the ratio of a circle's circumference to its diameter, 3.141592653589793.
export const PI: float = 3.141592653589793;
// E: float -- Euler's number, 2.718281828459045.
export const E: float = 2.718281828459045;

// sqrt(x): float -- the square root; NaN for x < 0 and NaN. Never fails. O(1).
export function sqrt(x: float): float {
  return x.sqrt();
}

// abs(x): float -- the absolute value. Never fails. O(1).
export function abs(x: float): float {
  return x.abs();
}

// floor(x): float -- the greatest integral value <= x, still a float (use `.toInt()` for an integer). Never fails. O(1).
export function floor(x: float): float {
  return x.floor();
}

// ceil(x): float -- the least integral value >= x, still a float. Never fails. O(1).
export function ceil(x: float): float {
  return x.ceil();
}

// round(x): float -- x rounded to the nearest integral value, half away from zero. Never fails. O(1).
export function round(x: float): float {
  return x.round();
}

// pow(x, y): float -- x to the power y (C `pow`). Never fails. O(1).
export function pow(x: float, y: float): float {
  return x.pow(y);
}

// min(a, b): float -- the smaller of two floats; NaN if either is NaN; min(-0.0, 0.0) = -0.0. Never fails. O(1).
export function min(a: float, b: float): float {
  if (a != a) {
    return a;
  }
  if (b != b) {
    return b;
  }
  if (a == b) {
    return 1.0 / a < 0.0 ? a : b;
  }
  return a < b ? a : b;
}

// max(a, b): float -- the larger of two floats; NaN if either is NaN; max(-0.0, 0.0) = 0.0. Never fails. O(1).
export function max(a: float, b: float): float {
  if (a != a) {
    return a;
  }
  if (b != b) {
    return b;
  }
  if (a == b) {
    return 1.0 / a > 0.0 ? a : b;
  }
  return a > b ? a : b;
}
