// std:bytes/internal -- helpers behind std:bytes (ADR-0048 rule 7.3). NOT API: user code does not import this module.
//
// A contract has to be able to call a function, and the language has no visibility between "private to the file" and
// "exported", so the helper is exported from here. It can change in any release.

// allBytes(xs): bool -- is every element of `xs` a valid byte (0..255)? Loop-based so that contracts can use it. Never
// fails; O(n).
export function allBytes(xs: int[]): bool {
  let i: usize = 0;
  while (i < xs.length) {
    if (xs[i] < 0 || xs[i] > 255) {
      return false;
    }
    i += 1;
  }
  return true;
}
