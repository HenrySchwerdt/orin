import { Html } from "std:html";
import ox from "std:html";
function Card(title: string, footer: Option<Html>): Html {
  return <section><h1>{title}</h1>{footer.unwrapOr(<hr />)}</section>;
}
function main(): void {
  const x = <Card title="a"><:footer><b>one</b><i>two</i></:footer></Card>;
}
