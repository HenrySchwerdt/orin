import { Box, box, unbox, Stack, push, top } from "./lib";

function main(): void {
  console.log(unbox(box(41) ).toString());
  let s: Stack<string> = Stack { items: [] };
  s = push(s, "a");
  s = push(s, "b");
  console.log(top(s).unwrap());
  const b: Box<int> = Box { value: 5 };
  console.log(b.value.toString());
}
