function first<T>(xs: T[]): Option<T> {
  return xs.get(0);
}

function last<T>(xs: T[]): Option<T> {
  if (xs.length == 0) {
    return None;
  }
  return Some(xs[xs.length - 1]);
}

function main(): void {
  const nums = [10, 20, 30];
  console.log(first(nums).unwrap().toString());
  console.log(last(nums).unwrap().toString());
  const words = ["x", "y"];
  match (last(words)) {
    Some(w) => { console.log("last word " + w); },
    None => { console.log("none"); },
  }
  const empty: string[] = [];
  match (first(empty)) {
    Some(w) => { console.log("unexpected " + w); },
    None => { console.log("empty"); },
  }
  console.log(first<int>(nums).unwrap().toString());
}
