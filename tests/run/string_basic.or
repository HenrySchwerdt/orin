function main(): void {
  const s = "Hello, World";
  console.log(s.length.toString());
  console.log(s.charAt(0));
  console.log(s.charCodeAt(1).toString());
  console.log(s.substring(7, 12));
  console.log("[" + s.substring(3, 3) + "]");
  console.log("a" + "b" + "c");
  const e = "";
  console.log(e.length.toString());
  console.log(s.substring(0, 5) + "!");
  console.log(s.charAt(11) + s.charAt(10));
  console.log(s.charAt(s.length - 1));
}
