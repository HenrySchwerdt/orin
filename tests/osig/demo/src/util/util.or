// Higher-order and generic helpers: `f` is a function value, so the call in `mapAll` is UNKNOWN.
export function mapAll<T, U>(xs: T[], f: (x: T) => U): U[] {
  let out: U[] = [];
  for (const x of xs) {
    out.push(f(x));
  }
  return out;
}

export function firstOr<T>(xs: T[], fallback: T): T {
  return xs.get(0).unwrapOr(fallback);
}

// A generic class (ADR-0026): one node in the graph; its two instantiations in `main` are not separate symbols.
export class Stack<T> {
  items: T[] = [];
  push(x: T): void { this.items.push(x); }
  pop(): Option<T> { return this.items.pop(); }
  size(): usize { return this.items.length; }
}
