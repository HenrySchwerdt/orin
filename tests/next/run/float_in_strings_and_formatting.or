function fixed2(x: float): string {
  const scaled = (x * 100.0).round();
  const n = scaled.toInt();
  const whole = n / 100;
  let frac = n % 100;
  if (frac < 0) {
    frac = -frac;
  }
  const fs = frac < 10 ? "0" + frac.toString() : frac.toString();
  return whole.toString() + "." + fs;
}

function main(): void {
  console.log("pi ~ " + fixed2(3.14159));
  console.log("e ~ " + fixed2(2.71828));
  console.log("half = " + 0.5.toString());
  console.log(fixed2(0.005));
  console.log(fixed2(19.999));
  let line = "";
  let i = 0;
  while (i < 5) {
    line = line + (i.toFloat() / 4.0).toString() + ";";
    i += 1;
  }
  console.log(line);
}
