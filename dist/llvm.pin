# The pinned LLVM toolchain (ADR-0038 section 8, gate 3). Read by `orin toolchain` (dist/orin) and checked in CI
# (tools/test_llvm_toolchain.sh). Format: "version <x.y.z>", then one line per platform:
#   asset <platform> <sha256 of the archive> <https url of the archive>
# The archives are the official, unmodified LLVM release archives. `orin toolchain install` refuses an archive whose
# sha256 differs. To change the pin: update the version and every checksum (sha256sum of the downloaded archive), then run
# tools/llvm_fixpoint.sh and the llvm conformance suite with the new clang.
# There is no archive for macos-x86_64 in this LLVM release. LLVM 19.1.7 (not 18.1.8) because the 18.1.8 Linux x86_64 archive
# needs libtinfo.so.5, which current distributions no longer ship.
version 19.1.7
asset linux-x86_64 4a5ec53951a584ed36f80240f6fbf8fdd46b4cf6c7ee87cc2d5018dc37caf679 https://github.com/llvm/llvm-project/releases/download/llvmorg-19.1.7/LLVM-19.1.7-Linux-X64.tar.xz
asset linux-aarch64 a73d9326e5d756e3937df6a9f621664d76403b59119f741901106b387e53a6ae https://github.com/llvm/llvm-project/releases/download/llvmorg-19.1.7/clang+llvm-19.1.7-aarch64-linux-gnu.tar.xz
asset macos-arm64 d93bf12952d89fe4ec7501c40475718b722407da6a8d651f05c995863468e570 https://github.com/llvm/llvm-project/releases/download/llvmorg-19.1.7/LLVM-19.1.7-macOS-ARM64.tar.xz
