// error: E0485
// A parallel `reduce` folds chunks separately and combines them, which equals the sequential fold only for an associative
// reducer (ADR-0039 §3.2). Subtraction is not associative; user functions need a proof obligation (not supported yet).
function main(): void {
  const r = [1, 2, 3, 4].parallel().reduce((a, b) => a - b, 0);
}
