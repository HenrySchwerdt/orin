import { extension, stem, replaceExtension } from "std:path";

function main(): void {
  const cases = ["a/b.txt", "a.tar.gz", ".bashrc", "a.", "a", "..", "...", "dir.d/file", "dir.d/", "/x/.hidden.cfg", "", "/"];
  for (const c of cases) {
    console.log("[" + c + "] ext=[" + extension(c) + "] stem=[" + stem(c) + "]");
  }
  console.log(replaceExtension("a/b.txt", ".md"));
  console.log(replaceExtension("a/b", ".md"));
  console.log(replaceExtension("a/b.tar.gz", ""));
  console.log(replaceExtension("a/b/", ".x"));
  console.log(replaceExtension("", ".x"));
}
