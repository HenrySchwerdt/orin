// ------------------------------------------------------------------------------------------ SortedMap

// One node of the B-tree: `keys` sorted, `vals` parallel to them, `kids` empty for a leaf, else keys.length + 1
// child ids (indices into the arena `nodes` of the map).
export type IntNode<V> = { keys: int[]; vals: V[]; kids: usize[]; };

// The first index whose key is >= k (keys.length when there is none). Binary search, O(log keys.length).
@Ensures(result <= keys.length)
@Ensures(result < keys.length ==> (keys[result] >= k))
@Ensures(result > 0 ==> (keys[result - 1] < k))
export function lowerBoundInt(keys: int[], k: int): usize {
  let lo: usize = 0;
  let hi: usize = keys.length;
  while (lo < hi) {
    const mid = lo + (hi - lo) / 2;
    if ((keys[mid] < k)) {
      lo = mid + 1;
    } else {
      hi = mid;
    }
  }
  return lo;
}

// Is `nodes` a well-formed B-tree arena of minimum degree t rooted at `root`, with free list `free`? Checked
// iteratively with an explicit stack: every node id is in range and reached exactly once (no dangling or shared
// ids, no cycles), keys and values have the same length, a leaf has no children and an inner node has one more
// child than keys (and at least one key), every non-root node holds t-1 .. 2t-1 keys and the root at most 2t-1,
// all leaves have the same depth, the free list holds distinct ids of unreachable nodes, and every arena slot is
// either reachable or free.
export function btreeIntShapeOk<V>(nodes: IntNode<V>[], root: usize, t: usize, free: usize[]): bool {
  const n = nodes.length;
  if (t < 2 || root >= n) {
    return false;
  }
  let seen: bool[] = [];
  let i: usize = 0;
  while (i < n) {
    seen.push(false);
    i += 1;
  }
  i = 0;
  while (i < free.length) {
    if (free[i] >= n || seen[free[i]]) {
      return false;
    }
    seen[free[i]] = true;
    i += 1;
  }
  let ids: usize[] = [root];
  let depths: usize[] = [0];
  let leafDepth: int = -1;
  let reachable: usize = 0;
  while (ids.length > 0) {
    const id = ids.pop().unwrap();
    const d = depths.pop().unwrap();
    if (seen[id]) {
      return false;
    }
    seen[id] = true;
    reachable += 1;
    const kc = nodes[id].keys.length;
    if (nodes[id].vals.length != kc || kc > 2 * t - 1) {
      return false;
    }
    if (id != root && kc < t - 1) {
      return false;
    }
    const kk = nodes[id].kids.length;
    if (kk == 0) {
      if (leafDepth < 0) {
        leafDepth = d.toInt();
      } else if (leafDepth != d.toInt()) {
        return false;
      }
    } else {
      if (kk != kc + 1 || kc == 0) {
        return false;
      }
      let c: usize = 0;
      while (c < kk) {
        if (nodes[id].kids[c] >= n) {
          return false;
        }
        ids.push(nodes[id].kids[c]);
        depths.push(d + 1);
        c += 1;
      }
    }
  }
  return reachable + free.length == n;
}

// Are the keys ordered? Inside every node strictly increasing, and every key of a child lies strictly between the
// separator keys around it in the parent (inherited bounds), which together say the in-order sequence is strictly
// increasing. Iterative; tolerates a broken shape (out-of-range ids, revisits) by answering false.
export function btreeIntOrderOk<V>(nodes: IntNode<V>[], root: usize): bool {
  if (root >= nodes.length) {
    return false;
  }
  let ids: usize[] = [root];
  let loFlags: bool[] = [false];
  let los: int[] = [0];
  let hiFlags: bool[] = [false];
  let his: int[] = [0];
  let visited: usize = 0;
  while (ids.length > 0) {
    visited += 1;
    if (visited > nodes.length) {
      return false;
    }
    const id = ids.pop().unwrap();
    const hasLo = loFlags.pop().unwrap();
    const lo = los.pop().unwrap();
    const hasHi = hiFlags.pop().unwrap();
    const hi = his.pop().unwrap();
    const kc = nodes[id].keys.length;
    let j: usize = 0;
    while (j < kc) {
      if (j > 0 && (nodes[id].keys[j - 1] >= nodes[id].keys[j])) {
        return false;
      }
      j += 1;
    }
    if (kc > 0) {
      if (hasLo && (nodes[id].keys[0] <= lo)) {
        return false;
      }
      if (hasHi && (nodes[id].keys[kc - 1] >= hi)) {
        return false;
      }
    }
    const kk = nodes[id].kids.length;
    if (kk > 0 && kk != kc + 1) {
      return false;
    }
    let c: usize = 0;
    while (c < kk) {
      if (nodes[id].kids[c] >= nodes.length) {
        return false;
      }
      ids.push(nodes[id].kids[c]);
      if (c == 0) {
        loFlags.push(hasLo);
        los.push(lo);
      } else {
        loFlags.push(true);
        los.push(nodes[id].keys[c - 1]);
      }
      if (c == kc) {
        hiFlags.push(hasHi);
        his.push(hi);
      } else {
        hiFlags.push(true);
        his.push(nodes[id].keys[c]);
      }
      c += 1;
    }
  }
  return true;
}

// The number of keys stored in the tree below `root` (iterative; a revisit or bad id stops the walk early).
export function btreeIntKeyCount<V>(nodes: IntNode<V>[], root: usize): usize {
  if (root >= nodes.length) {
    return 0;
  }
  let ids: usize[] = [root];
  let total: usize = 0;
  let visited: usize = 0;
  while (ids.length > 0) {
    visited += 1;
    if (visited > nodes.length) {
      return total;
    }
    const id = ids.pop().unwrap();
    total += nodes[id].keys.length;
    let c: usize = 0;
    while (c < nodes[id].kids.length) {
      if (nodes[id].kids[c] < nodes.length) {
        ids.push(nodes[id].kids[c]);
      }
      c += 1;
    }
  }
  return total;
}

// Height of the tree: the number of levels (1 for a single leaf root). Follows the first child down. O(height).
export function btreeIntHeight<V>(nodes: IntNode<V>[], root: usize): usize {
  let h: usize = 1;
  let id = root;
  while (id < nodes.length && nodes[id].kids.length > 0 && h <= nodes.length) {
    id = nodes[id].kids[0];
    h += 1;
  }
  return h;
}

// The fewest keys a tree of minimum degree t and the given height can hold: the root has 1 key, every other node
// at least t-1, so level d >= 1 has >= 2 t^(d-1) nodes and the total is 2 t^(h-1) - 1 (height 1: 1 key, but the
// root leaf may also be empty, so 0 is returned for an empty tree by the caller). This is why height is O(log_t n).
@Requires(t >= 2 && h >= 1)
export function btreeMinKeysInt(h: usize, t: usize): usize {
  let p: usize = 1;
  let d: usize = 1;
  while (d < h) {
    p *= t;
    d += 1;
  }
  return 2 * p - 1;
}

// All keys in order, by an explicit-stack in-order walk (the stack holds a node id and how many of its children
// were visited). O(n).
export function btreeIntKeys<V>(nodes: IntNode<V>[], root: usize): int[] {
  let out: int[] = [];
  let ids: usize[] = [root];
  let js: usize[] = [0];
  while (ids.length > 0) {
    const top = ids.length - 1;
    const id = ids[top];
    const j = js[top];
    const kc = nodes[id].keys.length;
    if (nodes[id].kids.length == 0) {
      let a: usize = 0;
      while (a < kc) {
        out.push(nodes[id].keys[a]);
        a += 1;
      }
      ids.pop();
      js.pop();
    } else {
      if (j > 0 && j - 1 < kc) {
        out.push(nodes[id].keys[j - 1]);
      }
      if (j <= kc) {
        js[top] = j + 1;
        ids.push(nodes[id].kids[j]);
        js.push(0);
      } else {
        ids.pop();
        js.pop();
      }
    }
  }
  return out;
}

// All values in key order (same walk as `btreeIntKeys`). O(n).
export function btreeIntVals<V>(nodes: IntNode<V>[], root: usize): V[] {
  let out: V[] = [];
  let ids: usize[] = [root];
  let js: usize[] = [0];
  while (ids.length > 0) {
    const top = ids.length - 1;
    const id = ids[top];
    const j = js[top];
    const kc = nodes[id].keys.length;
    if (nodes[id].kids.length == 0) {
      let a: usize = 0;
      while (a < kc) {
        out.push(nodes[id].vals[a]);
        a += 1;
      }
      ids.pop();
      js.pop();
    } else {
      if (j > 0 && j - 1 < kc) {
        out.push(nodes[id].vals[j - 1]);
      }
      if (j <= kc) {
        js[top] = j + 1;
        ids.push(nodes[id].kids[j]);
        js.push(0);
      } else {
        ids.pop();
        js.pop();
      }
    }
  }
  return out;
}

// ------------------------------------------------------------------------------------------ SortedStringMap

// One node of the B-tree: `keys` sorted, `vals` parallel to them, `kids` empty for a leaf, else keys.length + 1
// child ids (indices into the arena `nodes` of the map).
export type StringNode<V> = { keys: string[]; vals: V[]; kids: usize[]; };

// The first index whose key is >= k (keys.length when there is none). Binary search, O(log keys.length).
@Ensures(result <= keys.length)
@Ensures(result < keys.length ==> (compareBytewise(keys[result], k) >= 0))
@Ensures(result > 0 ==> (compareBytewise(keys[result - 1], k) < 0))
export function lowerBoundString(keys: string[], k: string): usize {
  let lo: usize = 0;
  let hi: usize = keys.length;
  while (lo < hi) {
    const mid = lo + (hi - lo) / 2;
    if ((compareBytewise(keys[mid], k) < 0)) {
      lo = mid + 1;
    } else {
      hi = mid;
    }
  }
  return lo;
}

// Is `nodes` a well-formed B-tree arena of minimum degree t rooted at `root`, with free list `free`? Checked
// iteratively with an explicit stack: every node id is in range and reached exactly once (no dangling or shared
// ids, no cycles), keys and values have the same length, a leaf has no children and an inner node has one more
// child than keys (and at least one key), every non-root node holds t-1 .. 2t-1 keys and the root at most 2t-1,
// all leaves have the same depth, the free list holds distinct ids of unreachable nodes, and every arena slot is
// either reachable or free.
export function btreeStringShapeOk<V>(nodes: StringNode<V>[], root: usize, t: usize, free: usize[]): bool {
