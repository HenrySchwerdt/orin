import { openTable } from "../database";
import { hidden } from "./internal";

export class User {
  constructor(public id: int, public name: string) {}
  describe(): string {
    return "user " + this.id.toString() + " " + this.name + " " + hidden();
  }
}

export function findUser(id: int): User {
  return new User(id, "user" + openTable("users").size().toString());
}

export function rename(u: User, name: string): User {
  return new User(u.id, name);
}
