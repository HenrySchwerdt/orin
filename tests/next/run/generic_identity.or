function id<T>(x: T): T {
  return x;
}

function main(): void {
  console.log(id(42).toString());
  console.log(id("text"));
  console.log(id(true).toString());
  const xs = id([1, 2, 3]);
  console.log(xs.length.toString());
  const ys = id(["a", "b"]);
  console.log(ys.join("-"));
  console.log(id(id(id(7))).toString());
}
