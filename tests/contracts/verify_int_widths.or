// Inputs for tools/test_verify_contracts.py: only `int` (= i64) and `bool` are modelled by the verifier;
// every other integer width gives UNKNOWN with a reason (ADR-0022), while i64 is verified like int.
// expect: with_i64 ensures VERIFIED
// expect: with_i32 ensures UNKNOWN
// expect: with_u8_result ensures UNKNOWN
// expect: with_usize ensures UNKNOWN
// expect: caller ensures UNKNOWN

@Requires(x >= 0 && x < 1000)
@Ensures(result == x + 1)
function with_i64(x: i64): i64 {
  return x + 1;
}

@Requires(x >= 0 && x < 1000)
@Ensures(result == x + 1)
function with_i32(x: i32): i32 {
  return x + 1;
}

@Ensures(result >= 0)
function with_u8_result(x: int): u8 {
  return 1;
}

@Requires(n >= 0)
@Ensures(result >= 0)
function with_usize(n: usize): int {
  return 1;
}

@Ensures(result >= 0)
function caller(): int {
  return with_i32(5).toInt() + with_usize(2).toInt();
}

function main(): void {
  console.log(caller().toString());
}
