        los.push(lo);
      } else {
        loFlags.push(true);
        los.push(nodes[id].keys[c - 1]);
      }
      if (c == kc) {
        hiFlags.push(hasHi);
        his.push(hi);
      } else {
        hiFlags.push(true);
        his.push(nodes[id].keys[c]);
      }
      c += 1;
    }
  }
  return true;
}

// The number of keys stored in the tree below `root` (iterative; a revisit or bad id stops the walk early).
export function btreeStringKeyCount<V>(nodes: StringNode<V>[], root: usize): usize {
