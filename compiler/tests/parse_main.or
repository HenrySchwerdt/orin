// Differential-test driver: parse the file named by the first argument and print its
// canonical AST dump (format documented in astdump.or). Parse errors are rendered to stderr
// as `path:line:col: error[CODE]: message` with exit status 1.

import { Host, useHost } from "std:host";
import { FsGrant } from "std:fs";
import { ProcessGrant } from "std:process";
import { parse } from "../syntax";
import { SourceMap, SourceFile, render } from "../diag";
import { readFile } from "std:fs";
import { args, exit } from "std:process";
import { dumpModule } from "./astdump";

function main(host: Host): void {
  useHost(host, (fs, proc, stdio, clock) => { run(fs, proc); });
}

function run(fs: FsGrant, proc: ProcessGrant): void {
  const argv = args(proc);
  if (argv.length < 1) {
    console.error("usage: parse_main <file.or>");
    exit(2);
    return;
  }
  const path = argv[0];
  const rf = readFile(fs, path);
  if (rf.isErr()) {
    console.error("cannot read " + path + ": " + rf.unwrapErr());
    exit(2);
    return;
  }
  const src = rf.unwrap();
  const sm = SourceMap { files: [SourceFile { path: path, text: src }] };
  match (parse(0, src)) {
    Ok(m) => {
      console.log(dumpModule(m));
    },
    Err(d) => {
      console.error(render(sm, d));
      exit(1);
    }
  }
}
