// std prelude: string utilities (spec 19, R1). See module.or for the rules.
// Replaces orin_str_index_of / includes / starts_with / ends_with / split / trim and
// orin_array_join of runtime/core/orin_runtime.c. Behaviour is identical, including the trap
// message of `split` with an empty separator.

import { exit } from "std:process";

// Same observable behaviour as orin_trap: flush stdout, `trap: <msg>` on stderr, exit status 101.
function trap(msg: string): void {
  console.error("trap: " + msg);
  exit(101);
}

// True when `n` occurs in `s` at byte offset `at` (requires at + n.length <= s.length).
function matchAt(s: string, n: string, at: usize): bool {
  let k: usize = 0;
  while (k < n.length) {
    if (s.charCodeAt(at + k) != n.charCodeAt(k)) {
      return false;
    }
    k += 1;
  }
  return true;
}

// First offset >= `begin` (<= s.length) at which `n` occurs in `s`; `s.length + 1` when there is none.
// An empty needle is found at `begin`.
function findFrom(s: string, n: string, begin: usize): usize {
  const nl = n.length;
  const sl = s.length;
  if (nl == 0) {
    return begin;
  }
  if (nl > sl) {
    return sl + 1;
  }
  const last = sl - nl;
  const c0 = n.charCodeAt(0);
  let i = begin;
  while (i <= last) {
    if (s.charCodeAt(i) == c0 && matchAt(s, n, i)) {
      return i;
    }
    i += 1;
  }
  return sl + 1;
}

export function strIndexOf(s: string, needle: string): Option<usize> {
  const p = findFrom(s, needle, 0);
  if (p > s.length) {
    return None;
  }
  return Some(p);
}

export function strIncludes(s: string, needle: string): bool {
  return findFrom(s, needle, 0) <= s.length;
}

export function strStartsWith(s: string, p: string): bool {
  if (p.length > s.length) {
    return false;
  }
  return matchAt(s, p, 0);
}

export function strEndsWith(s: string, p: string): bool {
  if (p.length > s.length) {
    return false;
  }
  return matchAt(s, p, s.length - p.length);
}

export function strSplit(s: string, sep: string): string[] {
  let out: string[] = [];
  if (sep.length == 0) {
    trap("split with empty separator");
    return out;
  }
  let start: usize = 0;
  while (true) {
    const p = findFrom(s, sep, start);
    if (p > s.length) {
      break;
    }
    out.push(s.substring(start, p));
    start = p + sep.length;
  }
  out.push(s.substring(start, s.length));
  return out;
}

function isSpace(c: int): bool {
  return c == 32 || (c >= 9 && c <= 13);
}

export function strTrim(s: string): string {
  let a: usize = 0;
  let b = s.length;
  while (a < b && isSpace(s.charCodeAt(a))) {
    a += 1;
  }
  while (b > a && isSpace(s.charCodeAt(b - 1))) {
    b -= 1;
  }
  return s.substring(a, b);
}

export function strJoin(a: string[], sep: string): string {
  let out = "";
  let i: usize = 0;
  while (i < a.length) {
    if (i > 0) {
      out += sep;
    }
    out += a[i];
    i += 1;
  }
  return out;
}
