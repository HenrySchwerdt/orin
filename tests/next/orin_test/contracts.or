// `orin test` fixture: tests run with runtime contract checking (ADR-0012) unless --no-contracts is given.
import { assertEq } from "std:test";

@Requires(n >= 0)
@Ensures(result >= 0)
function halve(n: int): int {
  return n / 2;
}

@Test
function validCall(): void {
  assertEq(halve(10), 5, "half of ten");
}

@Test
function violatesPrecondition(): void {
  assertEq(halve(-4), -2, "unreachable with contract checking");
}
