// error: E0475
// stderr: does not satisfy the bound `Hash` of `keyed`
// the class is `Ord` (it declares `equals` and `compare`), so the first bound holds and the second one fails
class Level {
  constructor(public n: int) {}
  equals(other: Level): bool { return this.n == other.n; }
  compare(other: Level): int { return this.n - other.n; }
}

function keyed<T extends Ord & Hash>(x: T, y: T): bool {
  return x < y && x.hash() != y.hash();
}

function main(): void {
  console.log(keyed(1, 2).toString());
  console.log(keyed("a", "b").toString());
  console.log(keyed(new Level(1), new Level(2)).toString());
}
