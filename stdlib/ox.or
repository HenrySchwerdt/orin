// std:ox -- the types of an OX provider (ADR-0044 §3). Types only: no code, no platform calls.
//
// A file with markup selects its provider with `import ox from "M";`. The module `M` exports `function ox()` whose
// body is a single `return` of a literal of type `Markup<R>` (the provider serialises markup to text, like std:html)
// or `Components<R>` (the provider builds values, like a widget toolkit). The function is an ordinary, type-checked
// Orin function and is never called: the compiler reads the literal and calls the functions it names directly.
// `R` is the provider's result type; the compiler requires nothing of it.

// One byte of static text or of a static attribute value and its encoding: `char` is a single-byte string.
// Example: Escape { char: "<", encoded: "&lt;" }.
export type Escape = { char: string; encoded: string; };

// A per-attribute override. An attribute `a` matches the rule when `a` is in `names` or starts with the non-empty
// `prefix`, both compared ASCII case-insensitively. `convert: Some(f)` sends a computed string value through `f`
// instead of `Markup.attr` (a URL sanitiser, say); `convert: None` makes a computed value an error (E0493): the
// attribute may only be written statically (event handlers: their value is code).
export type AttrRule = { names: string[]; prefix: string; convert: Option<(value: string) => string>; };

// A provider that serialises markup to text: the kind of std:html. Intrinsic elements (lower-case tags) are written
// into one buffer, the result of a root is `wrap(buffer)`.
export type Markup<R> = {
  // The finished text of a root becomes the result value (it is trusted: the compiler built it from encoded parts).
  wrap: (markup: string) => R;
  // An `R` child becomes its text.
  embed: (value: R) => string;
  // An `R[]` child becomes its text.
  embedAll: (values: R[]) => string;
  // A computed `string` child becomes its encoded text.
  text: (value: string) => string;
  // A computed `string` attribute value becomes its encoded text, unless a rule of `rules` applies.
  attr: (value: string) => string;
  // Per-attribute overrides; the first matching rule wins.
  rules: AttrRule[];
  // The encoding of static text and static attribute values, applied at compile time byte by byte.
  escapes: Escape[];
  // Elements without children and closing tag.
  voidTags: string[];
  // How a void tag ends: ">" (HTML) or "/>" (XML).
  voidEnd: string;
  // Elements whose children are static text only, written unencoded (`<script>`, `<style>`).
  rawTextTags: string[];
  // A `bool` attribute is present or absent (HTML) rather than an error.
  presenceAttrs: bool;
};

// A provider that builds values: an intrinsic tag `t` is the provider's exported function `t`, called like a
// component (docs/ox.md). `R` is the type of the finished values (a widget, a DOM node, a string builder, ...).
export type Components<R> = {
  // Several children where one `R` is expected, and `<>..</>`.
  fragment: (items: R[]) => R;
  // Text where an `R` is expected.
  text: (value: string) => R;
};
