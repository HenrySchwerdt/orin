function main(): void {
  let m = new Map<string, int>();
  m.set("zebra", 1);
  m.set("apple", 2);
  m.set("mango", 3);
  m.set("banana", 4);
  console.log(m.keys().join(" "));
  m.set("apple", 20);
  console.log(m.keys().join(" "));
  m.delete("zebra");
  console.log(m.keys().join(" "));
  m.set("zebra", 5);
  console.log(m.keys().join(" "));
  console.log(m.values().map(v => v.toString()).join(" "));
  m.delete("mango");
  m.delete("zebra");
  m.set("kiwi", 6);
  m.set("mango", 7);
  for (const e of m.entries()) {
    console.log(e.key + " -> " + e.value.toString());
  }
}
