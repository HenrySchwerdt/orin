function twice<T>(f: (x: T) => T): (x: T) => T {
  return x => f(f(x));
}

function compose<A, B, C>(f: (a: A) => B, g: (b: B) => C): (a: A) => C {
  return a => g(f(a));
}

function applyN(f: (x: int) => int, n: int, x: int): int {
  let r = x;
  let i = 0;
  while (i < n) {
    r = f(r);
    i += 1;
  }
  return r;
}

function foldInts(xs: int[], f: (acc: int, x: int) => int, init: int): int {
  let acc = init;
  for (const x of xs) {
    acc = f(acc, x);
  }
  return acc;
}

function flip<A, B, C>(f: (a: A, b: B) => C): (b: B, a: A) => C {
  return (b, a) => f(a, b);
}

function main(): void {
  console.log(twice((x: int) => x + 10)(1).toString());
  console.log(twice((s: string) => s + "!")("hey"));
  console.log(twice(twice((x: int) => x * 2))(1).toString());
  const toText = compose((x: int) => x * x, (y: int) => "<" + y.toString() + ">");
  console.log(toText(12));
  console.log(applyN(x => x * 3, 4, 1).toString());
  console.log(foldInts([1, 2, 3, 4], (a, x) => a * 10 + x, 0).toString());
  const sub = (a: int, b: int) => a - b;
  console.log(sub(10, 3).toString() + " " + flip(sub)(10, 3).toString());
}
