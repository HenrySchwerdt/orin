// Range facts for constant-length arrays (ADR-0038 lever 2 T6): loops whose guard keeps the index inside a literal array. The
// accesses may be compiled without the kind and bounds checks; the output must be the same either way.
function sumUp(): int {
  const a: int[] = [3, 1, 4, 1, 5];
  let s = 0;
  let i: usize = 0;
  while (i < 5) {
    s += a[i];
    i += 1;
  }
  return s;
}

// `<=` against a bound that is still inside the array
function sumLe(): int {
  const a: int[] = [3, 1, 4, 1, 5];
  let s = 0;
  let i: usize = 0;
  while (i <= 3) {
    s += a[i] * 2;
    i += 1;
  }
  return s;
}

// the bound is a local, and so is the length
function sumBound(): int {
  const a: int[] = [2, 7, 1, 8];
  const n: usize = 4;
  let s = 0;
  let i: usize = 0;
  while (i < n) {
    s += a[i];
    i += 1;
  }
  let j: usize = 0;
  while (j < a.length) {
    s += a[j] * 10;
    j += 1;
  }
  return s;
}

// downwards: `i > 0` and then `i - 1`
function sumDown(): int {
  const a: int[] = [5, 6, 7];
  let s = 0;
  let i: usize = 3;
  while (i > 0) {
    i -= 1;
    s = s * 10 + a[i];
  }
  return s;
}

// stores through the same guard
function fill(): int[] {
  let a: int[] = [0, 0, 0, 0];
  let i: usize = 0;
  while (i < 4) {
    a[i] = (i + 1).toInt() * 11;
    i += 1;
  }
  return a;
}

// the guard on the false edge
function exitFirst(): int {
  const a: int[] = [9, 8, 7, 6];
  let s = 0;
  let i: usize = 0;
  while (true) {
    if (i >= 4) {
      break;
    }
    s += a[i];
    i += 1;
  }
  return s;
}

// a start other than 0, a step other than 1
function stride(): int {
  const a: int[] = [1, 2, 3, 4, 5, 6, 7, 8];
  let s = 0;
  let i: usize = 1;
  while (i < 8) {
    s += a[i];
    i += 2;
  }
  return s;
}

function main(): void {
  console.log(sumUp().toString());
  console.log(sumLe().toString());
  console.log(sumBound().toString());
  console.log(sumDown().toString());
  const f = fill();
  console.log(f[0].toString() + " " + f[1].toString() + " " + f[2].toString() + " " + f[3].toString());
  console.log(exitFirst().toString());
  console.log(stride().toString());
}
