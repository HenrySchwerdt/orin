// TypeScript lexing rules for template literals: escapes, `$` that is not an interpolation, nested braces and
// strings inside ${}, nested template literals, comments inside ${}, multi-line literals.
type R = { a: i32; b: i32; };

function mk(a: i32, b: i32): R {
  return R { a: a, b: b };
}

function main(): void {
  const x = 5;
  // escapes
  console.log(`tab[\t] quote[\"] apos[\'] backslash[\\] backtick[\`] dollar[\$] hex[\x41\x7a] nul[\0]`.length.toString());
  console.log(`line1\nline2`);
  console.log(`a\${x}b`);
  // a `$` that does not start an interpolation, and braces in the text
  console.log(`cost $5 and $ {x} and {x} and }${x}{`);
  console.log(`$`);
  console.log(`$$${x}$`);
  // braces and strings inside the interpolation
  console.log(`rec ${mk(1, 2).a + mk(3, 4).b} ${R { a: 7, b: 8 }.b}`);
  console.log(`brace string ${"}"} and ${"{"} and ${"`"} and ${"${"}`);
  console.log(`closure ${((n: i32): i32 => { return n + 1; })(x.toI32())}`);
  console.log(`arrow body block ${[1, 2, 3].map((v: int): int => { return v * 2; })[2]}`);
  console.log(`match ${match (x) { 5 => "five", _ => "other" }}`);
  // nested template literals, to any depth
  console.log(`outer ${`inner ${`innermost ${x}`} done`} end`);
  console.log(`${`${`${`${x}`}`}`}`);
  const nested = `a${`b${x}c`}d${`e`}f`;
  console.log(nested);
  // comments inside the interpolation
  console.log(`c ${/* block */ x + 1} ${x // line comment
    + 2}`);
  console.log(`not a comment: // ${x} /* still text */`);
  // multi-line
  const m = `first
second ${x}
  third (two leading spaces)
`;
  console.log(m);
  console.log(m.length.toString());
  console.log(m.split("\n").length.toString());
  console.log(`line ${
    x
  } after`);
  // a template that ends with the interpolation and starts with it
  console.log(`${x} `.length.toString() + ` ${x}`.length.toString());
}
