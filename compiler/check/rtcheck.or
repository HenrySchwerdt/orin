// Optional runtime checking of contracts (`orin compile --check-contracts`, ADR-0012, spec 15 §4.2a).
// Beyond Orin-B. A source-to-source expansion run on an already type-checked program; the normal
// pipeline (class lowering, checking, MIR, C) then sees ordinary code. Without the flag contracts
// are erased and none of this runs.
//
//   function f(a: T): R with @Requires(p) @Ensures(q)        becomes
//   function f(a: T): R {                                    // the wrapper keeps the name
//     if (!(p)) { $contract$fail("@Requires(p) at file:line"); }
//     const result = $contract$body$f(a);                    // the original body
//     if (!(q')) { $contract$fail("@Ensures(q) at file:line"); }
//     return result;
//   }
//   * `old(e)` is `e` for functions (parameters are immutable); in methods it is `e` over a snapshot
//     `old$this` of the receiver taken at entry (value semantics);
//   * `a ==> b` is `!a || b`;
//   * methods (non-static, non-private): the class invariants are checked after the body; same for
//     constructors, whose invariant checks run at the end of the body and whose `@Requires` run after
//     the leading `this.f = e;` field initialisations;
//   * a violation prints `trap: contract violated: <clause> at <file>:<line>` and exits with 101
//     (the same convention as every other trap).
// Not checked at runtime (type-checked only): record-type invariants, loop invariants and `@Decreases`.
// Every return of the body, including an early `?` return, is checked: the body is a separate function.

import { Span, SourceMap } from "../diag";
import {
  Ident, Module, Item, ImportDecl, plainImport, importedName, FunctionDecl, Param, TypeDeclBody, DRecord, TypeExpr, TNamed, Block, Stmt, StmtKind, Expr, ExprKind,
  EInt, ETemplate, EStr, EIdent, ECall, EMember, EUnary, EBinary, EThis, ETyApp, EMethodT, EIndex, ETry, ECond, EArray,
  ERecord, ERecordT, EMatch, ENew, EBool, EArrow, ArrowParam, ArrowBody, AExpr, ABlock, FieldInit, MatchArm, ArmBody, BExpr, BBlock,
  SLet, SIf, SExpr, SReturn, SAssign, OpAssign, UNot, BAdd, BOr, BImplies,
  IImport, IFunction, IClass, IType, TypeDecl, parse, ClassDecl, ClassMember, MField, MCtor, MMethod, MethodDecl, CtorDecl,
  ContractClause, CRequires, CEnsures, CInvariant, EOx, oxExprs, oxMapExprs
} from "../syntax";
import { LoadedProgram, Unit, ImportTarget, ImportUnit, ImportStd, StdProcess } from "../loader";

const FAIL: string = "$contract$fail";
const BODY: string = "$contract$body$";
const SITE: string = "$contract$site$";   // checking wrapper that takes the caller's location (functions with @Requires)
const SITE_PARAM: string = "$site";
const REC: string = "$contract$rec$";     // invariant check of a record type
const THIS_PARAM: string = "this$";

function mkE(k: ExprKind, sp: Span): Expr {
  return Expr { kind: k, span: sp };
}

function mkS(k: StmtKind, sp: Span): Stmt {
  return Stmt { kind: k, span: sp };
}

function idOf(name: string, sp: Span): Ident {
  return Ident { name: name, span: sp };
}

function isKind(c: ContractClause, k: int): bool {
  return match (c.kind) {
    CRequires => k == 0,
    CEnsures => k == 1,
    CInvariant => k == 2,
    _ => false
  };
}

function ofKind(cs: ContractClause[], k: int): ContractClause[] {
  let out: ContractClause[] = [];
  for (const c of cs) {
    if (isKind(c, k)) {
      out.push(c);
    }
  }
  return out;
}

// ---------------------------------------------------------------------------
// Expression rewriting: `==>`, `old(..)`
// ---------------------------------------------------------------------------

function rwAll(es: Expr[], th: string): Expr[] {
  let out: Expr[] = [];
  for (const e of es) {
    out.push(rw(e, th));
  }
  return out;
}

function rwFields(fs: FieldInit[], th: string): FieldInit[] {
  let out: FieldInit[] = [];
  for (const f of fs) {
    out.push(FieldInit { name: f.name, value: rw(f.value, th), span: f.span });
  }
  return out;
}

function rwSpread(o: Option<Expr>, th: string): Option<Expr> {
  return match (o) {
    Some(x) => Some(rw(x, th)),
    None => None
  };
}

function rwArms(arms: MatchArm[], th: string): MatchArm[] {
  let out: MatchArm[] = [];
  for (const a of arms) {
    const b = match (a.body) {
      BExpr(x) => BExpr(rw(x, th)),
      BBlock(blk) => BBlock(blk)
    };
    out.push(MatchArm { pattern: a.pattern, body: b, span: a.span });
  }
  return out;
}

// `th`: what `this` denotes ("" keeps it; inside `old(..)` it is the entry snapshot `old$this`; in a record
// invariant check it is the parameter `this$`).
function rw(e: Expr, th: string): Expr {
  const sp = e.span;
  return match (e.kind) {
    EThis => th == "" ? e : mkE(EIdent(idOf(th, sp)), sp),
    EUnary(op, x) => mkE(EUnary(op, rw(x, th)), sp),
    EBinary(op, l, r) => match (op) {
      BImplies => mkE(EBinary(BOr, mkE(EUnary(UNot, rw(l, th)), l.span), rw(r, th)), sp),
      _ => mkE(EBinary(op, rw(l, th), rw(r, th)), sp)
    },
    ECall(callee, args) => rwCall(e, callee, args, th),
    EMember(b, n) => mkE(EMember(rw(b, th), n), sp),
    EMethodT(b, n, tys) => mkE(EMethodT(rw(b, th), n, tys), sp),
    EIndex(b, i) => mkE(EIndex(rw(b, th), rw(i, th)), sp),
    ETry(x) => mkE(ETry(rw(x, th)), sp),
    ECond(c, a, b) => mkE(ECond(rw(c, th), rw(a, th), rw(b, th)), sp),
    EArray(xs) => mkE(EArray(rwAll(xs, th)), sp),
    ETemplate(ps, xs) => mkE(ETemplate(ps, rwAll(xs, th)), sp),
    EOx(el) => mkE(EOx(oxMapExprs(el, x => rw(x, th))), sp),
    ERecord(n, spread, fs) => mkE(ERecord(n, rwSpread(spread, th), rwFields(fs, th)), sp),
    ERecordT(n, tys, spread, fs) => mkE(ERecordT(n, tys, rwSpread(spread, th), rwFields(fs, th)), sp),
    EMatch(s, arms) => mkE(EMatch(rw(s, th), rwArms(arms, th)), sp),
    ENew(n, tys, args) => mkE(ENew(n, tys, rwAll(args, th)), sp),
    EArrow(ps, rte, body) => mkE(EArrow(ps, rte, rwArrow(body, th)), sp),
    _ => e
  };
}

// A closure with an expression body is rewritten like any other expression; a block body is left alone
// (`result`, `this` and `old` inside it are not supported: docs/contracts.md).
function rwArrow(b: ArrowBody, th: string): ArrowBody {
  return match (b) {
    AExpr(x) => AExpr(rw(x, th)),
    ABlock(blk) => ABlock(blk)
  };
}

function rwCall(e: Expr, callee: Expr, args: Expr[], th: string): Expr {
  const isOld = match (callee.kind) {
    EIdent(id) => id.name == "old" && args.length == 1,
    _ => false
  };
  if (isOld) {
    return rw(args[0], "old$this");
  }
  return mkE(ECall(rw(callee, th), rwAll(args, th)), e.span);
}

function isEnsures(c: ContractClause): bool {
  return isKind(c, 1);
}

// `result` of an `@Ensures` is the wrapper's local `result$` (a parameter may be called `result`).
function renameResult(e: Expr, on: bool): Expr {
  if (!on) {
    return e;
  }
  return rn(e);
}

function rnAll(es: Expr[]): Expr[] {
  let out: Expr[] = [];
  for (const e of es) {
    out.push(rn(e));
  }
  return out;
}

function rnFields(fs: FieldInit[]): FieldInit[] {
  let out: FieldInit[] = [];
  for (const f of fs) {
    out.push(FieldInit { name: f.name, value: rn(f.value), span: f.span });
  }
  return out;
}

function rnSpread(o: Option<Expr>): Option<Expr> {
  return match (o) {
    Some(x) => Some(rn(x)),
    None => None
  };
}

function rnArms(arms: MatchArm[]): MatchArm[] {
  let out: MatchArm[] = [];
  for (const a of arms) {
    const b = match (a.body) {
      BExpr(x) => BExpr(rn(x)),
      BBlock(blk) => BBlock(blk)
    };
    out.push(MatchArm { pattern: a.pattern, body: b, span: a.span });
  }
  return out;
}

function rn(e: Expr): Expr {
  const sp = e.span;
  return match (e.kind) {
    EIdent(id) => id.name == "result" ? mkE(EIdent(idOf("result$", id.span)), sp) : e,
    EUnary(op, x) => mkE(EUnary(op, rn(x)), sp),
    EBinary(op, l, r) => mkE(EBinary(op, rn(l), rn(r)), sp),
    ECall(c, args) => mkE(ECall(rn(c), rnAll(args)), sp),
    EMember(b, n) => mkE(EMember(rn(b), n), sp),
    EMethodT(b, n, tys) => mkE(EMethodT(rn(b), n, tys), sp),
    EIndex(b, i) => mkE(EIndex(rn(b), rn(i)), sp),
    ETry(x) => mkE(ETry(rn(x)), sp),
    ECond(c, a, b) => mkE(ECond(rn(c), rn(a), rn(b)), sp),
    EArray(xs) => mkE(EArray(rnAll(xs)), sp),
    ETemplate(ps, xs) => mkE(ETemplate(ps, rnAll(xs)), sp),
    EOx(el) => mkE(EOx(oxMapExprs(el, x => rn(x))), sp),
    ERecord(n, spread, fs) => mkE(ERecord(n, rnSpread(spread), rnFields(fs)), sp),
    ERecordT(n, tys, spread, fs) => mkE(ERecordT(n, tys, rnSpread(spread), rnFields(fs)), sp),
    EMatch(s, arms) => mkE(EMatch(rn(s), rnArms(arms)), sp),
    ENew(n, tys, args) => mkE(ENew(n, tys, rnAll(args)), sp),
    EArrow(ps, rte, body) => rnArrow(e, ps, rte, body),
    _ => e
  };
}

// A closure parameter called `result` hides the result: the body is left alone then.
function rnArrow(e: Expr, ps: ArrowParam[], rte: Option<TypeExpr>, body: ArrowBody): Expr {
  for (const p of ps) {
    if (p.name.name == "result") {
      return e;
    }
  }
  return match (body) {
    AExpr(x) => mkE(EArrow(ps, rte, AExpr(rn(x))), e.span),
    ABlock(_) => e
  };
}

// ---------------------------------------------------------------------------
// Old-value spans: where the `old(..)` arguments of a clause are (the HIR pass prints their values)
// ---------------------------------------------------------------------------

function spanKey(sp: Span): string {
  return sp.file.toString() + ":" + sp.start.toString() + ":" + sp.end.toString() + ";";
}

function osAll(es: Expr[]): string {
  let out = "";
  for (const e of es) {
    out = out + os(e);
  }
  return out;
}

function osSpread(o: Option<Expr>): string {
  return match (o) {
    Some(x) => os(x),
    None => ""
  };
}

function osFields(fs: FieldInit[]): string {
  let out = "";
  for (const f of fs) {
    out = out + os(f.value);
  }
  return out;
}

function osArms(arms: MatchArm[]): string {
  let out = "";
  for (const a of arms) {
    out = out + match (a.body) {
      BExpr(x) => os(x),
      BBlock(_) => ""
    };
  }
  return out;
}

function os(e: Expr): string {
  return match (e.kind) {
    EUnary(_, x) => os(x),
    EBinary(_, l, r) => os(l) + os(r),
    ECall(callee, args) => osCall(callee, args),
    EMember(b, _) => os(b),
    EMethodT(b, _, _) => os(b),
    EIndex(b, i) => os(b) + os(i),
    ETry(x) => os(x),
    ECond(c, a, b) => os(c) + os(a) + os(b),
    EArray(xs) => osAll(xs),
    ETemplate(_, xs) => osAll(xs),
    EOx(el) => osAll(oxExprs(el)),
    ERecord(_, spread, fs) => osSpread(spread) + osFields(fs),
    ERecordT(_, _, spread, fs) => osSpread(spread) + osFields(fs),
    EMatch(s, arms) => os(s) + osArms(arms),
    ENew(_, _, args) => osAll(args),
    EArrow(_, _, body) => match (body) {
      AExpr(x) => os(x),
      ABlock(_) => ""
    },
    _ => ""
  };
}

function osCall(callee: Expr, args: Expr[]): string {
  const isOld = match (callee.kind) {
    EIdent(id) => id.name == "old" && args.length == 1,
    _ => false
  };
  if (isOld) {
    return spanKey(args[0].span);
  }
  return os(callee) + osAll(args);
}

// ---------------------------------------------------------------------------
// Check statements
// ---------------------------------------------------------------------------

function lineOf(text: string, offset: usize): usize {
  let line: usize = 1;
  let i: usize = 0;
  while (i < offset && i < text.length) {
    if (text.charCodeAt(i) == 10) {
      line += 1;
    }
    i += 1;
  }
  return line;
}

// `@Requires(p) at file:line`
function clauseMessage(sm: SourceMap, c: ContractClause): string {
  const f = sm.files[c.span.file];
  const txt = f.text.substring(c.span.start, c.span.end).split("\n").join(" ");
  return txt + " at " + f.path + ":" + lineOf(f.text, c.span.start).toString();
}

function mentionsOld(sm: SourceMap, cs: ContractClause[]): bool {
  for (const c of cs) {
    const f = sm.files[c.span.file];
    if (f.text.substring(c.span.start, c.span.end).includes("old(")) {
      return true;
    }
  }
  return false;
}

// `if (!(e)) { $contract$fail("msg", site, "old spans", ""); }` for every clause. `site` is the expression
// for the call site (an empty string, or the `$site` parameter of the checking wrapper); `th` is what
// `this` denotes in the clause ("" = itself). The last two arguments are filled in by the HIR pass
// (rthir.or), which knows the types: the stub `$contract$fail` has no body.
function checkStmts(sm: SourceMap, cs: ContractClause[], site: Expr, th: string): Stmt[] {
  let out: Stmt[] = [];
  for (const c of cs) {
    match (c.expr) {
      Some(x) => {
        const sp = c.span;
        const msg = mkE(EStr(clauseMessage(sm, c)), sp);
        const olds = mkE(EStr(isEnsures(c) ? oldSpans(x) : ""), sp);
        const detail = mkE(EStr(""), sp);
        const fail = mkS(SExpr(mkE(ECall(mkE(EIdent(idOf(FAIL, sp)), sp), [msg, site, olds, detail]), sp)), sp);
        const cond = mkE(EUnary(UNot, renameResult(rw(x, th), isEnsures(c))), sp);
        out.push(mkS(SIf(cond, Block { stmts: [fail], span: sp }, None), sp));
      },
      None => {}
    }
  }
  return out;
}

function oldSpans(e: Expr): string {
  return os(e);
}

// ---------------------------------------------------------------------------
// Wrappers
// ---------------------------------------------------------------------------

function isVoidRet(r: Option<TypeExpr>): bool {
  return match (r) {
    None => true,
    Some(t) => match (t.kind) {
      TNamed(id, args) => id.name == "void" && args.length == 0,
      _ => false
    }
  };
}

function argExprs(ps: Param[]): Expr[] {
  let out: Expr[] = [];
  for (const p of ps) {
    out.push(mkE(EIdent(p.name), p.name.span));
  }
  return out;
}

function tyArgs(tps: Ident[]): TypeExpr[] {
  let out: TypeExpr[] = [];
  for (const t of tps) {
    out.push(TypeExpr { kind: TNamed(t, []), span: t.span });
  }
  return out;
}

function stringType(sp: Span): TypeExpr {
  return TypeExpr { kind: TNamed(idOf("string", sp), []), span: sp };
}

function siteParam(sp: Span): Param {
  return Param { name: idOf(SITE_PARAM, sp), ty: stringType(sp), span: sp };
}

// The parameters of a checking wrapper that receives the call site: `$site: string` first.
function withSiteParam(ps: Param[], sp: Span): Param[] {
  let out: Param[] = [siteParam(sp)];
  for (const p of ps) {
    out.push(p);
  }
  return out;
}

// The statements of a wrapper: entry checks, the call of `callee`, exit checks, `return result`.
function wrapperBody(
  sm: SourceMap, sp: Span, callee: Expr, params: Param[], ret: Option<TypeExpr>,
  reqs: ContractClause[], enss: ContractClause[], invs: ContractClause[], isMethod: bool, site: Expr
): Block {
  let stmts: Stmt[] = [];
  if (isMethod && mentionsOld(sm, enss)) {
    stmts.push(mkS(SLet(false, idOf("old$this", sp), None, mkE(EThis, sp)), sp));
  }
  for (const s of checkStmts(sm, reqs, site, "")) {
    stmts.push(s);
  }
  const call = mkE(ECall(callee, argExprs(params)), sp);
  const isVoid = isVoidRet(ret);
  if (isVoid) {
    stmts.push(mkS(SExpr(call), sp));
  } else {
    stmts.push(mkS(SLet(false, idOf("result$", sp), None, call), sp));
  }
  for (const s of checkStmts(sm, enss, site, "")) {
    stmts.push(s);
  }
  for (const s of checkStmts(sm, invs, site, "")) {
    stmts.push(s);
  }
  if (!isVoid) {
    stmts.push(mkS(SReturn(Some(mkE(EIdent(idOf("result$", sp)), sp))), sp));
  }
  return Block { stmts: stmts, span: sp };
}

// The forwarder `f(a) { return $contract$site$f("", a); }`: the callers the HIR pass rewrites pass their
// location instead of "" (rthir.or); function values and virtual calls keep the forwarder.
function forwarderBody(sp: Span, callee: Expr, params: Param[], ret: Option<TypeExpr>): Block {
  let args: Expr[] = [];
  args.push(mkE(EStr(""), sp));
  for (const a of argExprs(params)) {
    args.push(a);
  }
  const call = mkE(ECall(callee, args), sp);
  let stmts: Stmt[] = [];
  if (isVoidRet(ret)) {
    stmts.push(mkS(SExpr(call), sp));
  } else {
    stmts.push(mkS(SReturn(Some(call)), sp));
  }
  return Block { stmts: stmts, span: sp };
}

type Wrapped = { items: Item[]; used: bool; };

function wrapFunction(sm: SourceMap, f: FunctionDecl): Wrapped {
  const reqs = ofKind(f.contracts, 0);
  const enss = ofKind(f.contracts, 1);
  if (reqs.length == 0 && enss.length == 0) {
    return Wrapped { items: [IFunction(f)], used: false };
  }
  const bodyName = idOf(BODY + f.name.name, f.name.span);
  const body = FunctionDecl {
    exported: false, name: bodyName, typeParams: f.typeParams, bounds: f.bounds, params: f.params, ret: f.ret, body: f.body,
    contracts: [], annotations: [], span: f.span
  };
  const calleeId = mkE(EIdent(bodyName), f.name.span);
  const callee = f.typeParams.length == 0 ? calleeId : mkE(ETyApp(bodyName, tyArgs(f.typeParams)), f.name.span);
  if (reqs.length == 0) {
    const wrapper = FunctionDecl {
      exported: f.exported, name: f.name, typeParams: f.typeParams, bounds: f.bounds, params: f.params, ret: f.ret,
      body: wrapperBody(sm, f.span, callee, f.params, f.ret, reqs, enss, [], false, mkE(EStr(""), f.span)),
      contracts: [], annotations: f.annotations, span: f.span
    };
    return Wrapped { items: [IFunction(wrapper), IFunction(body)], used: true };
  }
  // With a @Requires: the checking wrapper takes the caller's location.
  const siteName = idOf(SITE + f.name.name, f.name.span);
  const siteId = mkE(EIdent(siteName), f.name.span);
  const siteCallee = f.typeParams.length == 0 ? siteId : mkE(ETyApp(siteName, tyArgs(f.typeParams)), f.name.span);
  const checking = FunctionDecl {
    exported: false, name: siteName, typeParams: f.typeParams, bounds: f.bounds, params: withSiteParam(f.params, f.span), ret: f.ret,
    body: wrapperBody(sm, f.span, callee, f.params, f.ret, reqs, enss, [], false, mkE(EIdent(idOf(SITE_PARAM, f.span)), f.span)),
    contracts: [], annotations: [], span: f.span
  };
  const forwarder = FunctionDecl {
    exported: f.exported, name: f.name, typeParams: f.typeParams, bounds: f.bounds, params: f.params, ret: f.ret,
    body: forwarderBody(f.span, siteCallee, f.params, f.ret),
    contracts: [], annotations: f.annotations, span: f.span
  };
  return Wrapped { items: [IFunction(forwarder), IFunction(checking), IFunction(body)], used: true };
}

type WrappedMembers = { members: ClassMember[]; used: bool; };

function wrapMethod(sm: SourceMap, cname: Ident, md: MethodDecl, invs: ContractClause[]): WrappedMembers {
  const reqs = ofKind(md.contracts, 0);
  const enss = ofKind(md.contracts, 1);
  const useInv = !md.isStatic && !md.priv;
  const minv: ContractClause[] = useInv ? invs : [];
  if (reqs.length == 0 && enss.length == 0 && minv.length == 0) {
    return WrappedMembers { members: [MMethod(md)], used: false };
  }
  const bodyName = idOf(BODY + md.name.name, md.name.span);
  const bodyM = MethodDecl {
    priv: true, isStatic: md.isStatic, name: bodyName, typeParams: md.typeParams, bounds: md.bounds, params: md.params,
    ret: md.ret, body: md.body, contracts: [], annotations: [], span: md.span
  };
  // Instance methods call the body through `this`, static methods through the class name.
  const recv = md.isStatic ? mkE(EIdent(cname), md.span) : mkE(EThis, md.span);
  const callee = md.typeParams.length == 0
      ? mkE(EMember(recv, bodyName), md.span)
      : mkE(EMethodT(recv, bodyName, tyArgs(md.typeParams)), md.span);
  if (reqs.length == 0) {
    const wrapper = MethodDecl {
      priv: md.priv, isStatic: md.isStatic, name: md.name, typeParams: md.typeParams, bounds: md.bounds, params: md.params,
      ret: md.ret, body: wrapperBody(sm, md.span, callee, md.params, md.ret, reqs, enss, minv, !md.isStatic, mkE(EStr(""), md.span)),
      contracts: [], annotations: md.annotations, span: md.span
    };
    return WrappedMembers { members: [MMethod(wrapper), MMethod(bodyM)], used: true };
  }
  const siteName = idOf(SITE + md.name.name, md.name.span);
  const siteCallee = md.typeParams.length == 0
      ? mkE(EMember(recv, siteName), md.span)
      : mkE(EMethodT(recv, siteName, tyArgs(md.typeParams)), md.span);
  const checking = MethodDecl {
    priv: true, isStatic: md.isStatic, name: siteName, typeParams: md.typeParams, bounds: md.bounds, params: withSiteParam(md.params, md.span),
    ret: md.ret,
    body: wrapperBody(sm, md.span, callee, md.params, md.ret, reqs, enss, minv, !md.isStatic, mkE(EIdent(idOf(SITE_PARAM, md.span)), md.span)),
    contracts: [], annotations: [], span: md.span
  };
  const forwarder = MethodDecl {
    priv: md.priv, isStatic: md.isStatic, name: md.name, typeParams: md.typeParams, bounds: md.bounds, params: md.params,
    ret: md.ret, body: forwarderBody(md.span, siteCallee, md.params, md.ret),
    contracts: [], annotations: md.annotations, span: md.span
  };
  return WrappedMembers { members: [MMethod(forwarder), MMethod(checking), MMethod(bodyM)], used: true };
}

// Leading `this.f = e;` statements of a constructor body (they must stay first: ADR-0009).
function leadingFieldInits(stmts: Stmt[]): usize {
  let k: usize = 0;
  let go = true;
  while (go && k < stmts.length) {
    go = false;
    match (stmts[k].kind) {
      SAssign(target, op, _) => {
        const plain = match (op) { OpAssign => true, _ => false };
        match (target.kind) {
          EMember(base, _) => {
            const onThis = match (base.kind) { EThis => true, _ => false };
            if (plain && onThis) {
              go = true;
            }
          },
          _ => {}
        }
      },
      _ => {}
    }
    if (go) {
      k += 1;
    }
  }
  return k;
}

function wrapCtor(sm: SourceMap, k: CtorDecl, invs: ContractClause[]): CtorDecl {
  const reqs = ofKind(k.contracts, 0);
  if (reqs.length == 0 && invs.length == 0) {
    return k;
  }
  const lead = leadingFieldInits(k.body.stmts);
  let stmts: Stmt[] = [];
  let i: usize = 0;
  const noSite = mkE(EStr(""), k.span);
  while (i < lead) {
    stmts.push(k.body.stmts[i]);
    i += 1;
  }
  for (const s of checkStmts(sm, reqs, noSite, "")) {
    stmts.push(s);
  }
  while (i < k.body.stmts.length) {
    stmts.push(k.body.stmts[i]);
    i += 1;
  }
  for (const s of checkStmts(sm, invs, noSite, "")) {
    stmts.push(s);
  }
  return CtorDecl { params: k.params, body: Block { stmts: stmts, span: k.body.span }, contracts: [], span: k.span };
}

function wrapClass(sm: SourceMap, c: ClassDecl): Wrapped {
  const invs = ofKind(c.contracts, 2);
  let members: ClassMember[] = [];
  let used = false;
  let hasCtor = false;
  for (const m of c.members) {
    match (m) {
      MCtor(k) => {
        hasCtor = true;
        const nk = wrapCtor(sm, k, invs);
        if (nk.contracts.length != k.contracts.length || invs.length > 0) {
          used = true;
        }
        members.push(MCtor(nk));
      },
      MMethod(md) => {
        const w = wrapMethod(sm, c.name, md, invs);
        if (w.used) {
          used = true;
        }
        for (const x of w.members) {
          members.push(x);
        }
      },
      _ => { members.push(m); }
    }
  }
  if (!hasCtor && invs.length > 0) {
    // The implicit constructor gets an explicit (empty) one so the invariants have a place to run.
    const k = CtorDecl { params: [], body: Block { stmts: [], span: c.span }, contracts: [], span: c.span };
    members.push(MCtor(wrapCtor(sm, k, invs)));
    used = true;
  }
  const nc = ClassDecl {
    exported: c.exported, name: c.name, typeParams: c.typeParams, bounds: c.bounds, ext: c.ext, impls: c.impls, members: members,
    contracts: [], annotations: c.annotations, span: c.span
  };
  return Wrapped { items: [IClass(nc)], used: used };
}

// The invariant of a record type `type R = { .. }` (ADR-0031 A3): the function
// `$contract$rec$R($site: string, this$: R): R` checks the clauses and returns its argument. The HIR pass
// (rthir.or) puts a call around every record literal, after every field assignment and at the return of
// every function that returns an `R`. Generic records are not supported (E0408).
function recordCheck(sm: SourceMap, td: TypeDecl): Option<Item> {
  const invs = ofKind(td.contracts, 2);
  const isRecord = match (td.body) {
    DRecord(_) => true,
    _ => false
  };
  if (invs.length == 0 || !isRecord || td.typeParams.length > 0) {
    return None;
  }
  const sp = td.span;
  const rty = TypeExpr { kind: TNamed(td.name, []), span: sp };
  const self = idOf(THIS_PARAM, sp);
  const site = mkE(EIdent(idOf(SITE_PARAM, sp)), sp);
  let stmts: Stmt[] = checkStmts(sm, invs, site, THIS_PARAM);
  stmts.push(mkS(SReturn(Some(mkE(EIdent(self), sp))), sp));
  return Some(IFunction(FunctionDecl {
    exported: false, name: idOf(REC + td.name.name, td.name.span), typeParams: [], bounds: [],
    params: [siteParam(sp), Param { name: self, ty: rty, span: sp }], ret: Some(rty),
    body: Block { stmts: stmts, span: sp }, contracts: [], annotations: [], span: sp
  }));
}

// The stub the check statements call: the HIR pass replaces every call with one of `contract__fail`
// (below), so the stub needs no body and no imports.
function failStub(sp: Span): Item {
  const tstr = stringType(sp);
  const tvoid = TypeExpr { kind: TNamed(idOf("void", sp), []), span: sp };
  const params: Param[] = [
    Param { name: idOf("msg", sp), ty: tstr, span: sp },
    Param { name: idOf("site", sp), ty: tstr, span: sp },
    Param { name: idOf("olds", sp), ty: tstr, span: sp },
    Param { name: idOf("detail", sp), ty: tstr, span: sp }
  ];
  return IFunction(FunctionDecl {
    exported: false, name: idOf(FAIL, sp), typeParams: [], bounds: [], params: params,
    ret: Some(tvoid), body: Block { stmts: [], span: sp }, contracts: [], annotations: [], span: sp
  });
}

// Orin source of the run-time support, added once to the first unit that has contracts (the HIR pass finds
// the functions by name). `contract__fail` prints the report (docs/contracts.md "Violation reports"): the
// first line is `trap: contract violated: <clause> at <file>:<line>`, then the lines of `detail` (the
// function and its arguments, the values of the clause's terms, the `old` values; built by the HIR pass),
// then blame and action (ADR-0029). The status is 101 like every other trap.
function supportText(): string {
  return `
function contract__showInt(x: int): string { return x.toString(); }
function contract__showUsize(x: usize): string { return x.toString(); }
function contract__showBool(x: bool): string { return x ? "true" : "false"; }
function contract__showFloat(x: float): string { return x.toString(); }
function contract__showF32(x: f32): string { return x.toString(); }
function contract__showStr(s: string): string {
  if (s.length > 40) {
    return "\\"" + s.substring(0, 40) + "...\\" (length " + s.length.toString() + ")";
  }
  return "\\"" + s + "\\"";
}
function contract__showLen(ty: string, n: usize): string { return ty + " of length " + n.toString(); }
function contract__fail(msg: string, site: string, fname: string, detail: string): void {
  let out = "trap: contract violated: " + msg + "\\n" + detail;
  if (msg.startsWith("@Requires")) {
    if (site != "") {
      out = out + "  blame: the caller, at " + site + "\\n";
    } else {
      out = out + "  blame: the caller of " + fname + " (call site not available: called through a function value, an interface or a constructor)\\n";
    }
    out = out + "  action: FIX_CODE (caller)";
  } else {
    const kind = msg.startsWith("@Ensures") ? "@Ensures" : "@Invariant";
    if (fname.startsWith("record ")) {
      out = out + "  blame: the code that built this value" + (site != "" ? ", at " + site : "") + "\\n";
      out = out + "  action: NEEDS_DECISION\\n";
      out = out + "  question: a value of " + fname + " breaks its " + kind + ". Is the code that built it wrong, or is the invariant?\\n";
      out = out + "  option 1: fix the code that builds or changes the value (the specification stays)\\n";
      out = out + "  option 2: change the invariant (changes the specification)";
    } else {
      out = out + "  blame: the callee " + fname + "\\n";
      out = out + "  action: NEEDS_DECISION\\n";
      out = out + "  question: " + fname + " breaks its " + kind + ". Is the code wrong, or is the contract?\\n";
      out = out + "  option 1: fix the code (the specification stays)\\n";
      out = out + "  option 2: add a precondition that excludes this call (changes the specification)\\n";
      out = out + "  option 3: change the clause (changes the specification)";
    }
  }
  console.error(out);
  exit(101);
}
`;
}

function supportItems(file: usize): Item[] {
  const m = parse(file, supportText());
  return match (m) {
    Ok(mod) => mod.items,
    Err(_) => []
  };
}

function importsExit(m: Module): bool {
  for (const it of m.items) {
    match (it) {
      IImport(d) => {
        let k: usize = 0;
        while (k < d.names.length) {
          if (importedName(d, k).name == "exit" && d.names[k].name == "exit") {
            return true;
          }
          k += 1;
        }
      },
      _ => {}
    }
  }
  return false;
}

// Expands the contracts of every unit into runtime checks.
export function expandContracts(prog: LoadedProgram, sm: SourceMap): LoadedProgram {
  let units: Unit[] = [];
  let supportDone = false;
  for (const u of prog.units) {
    let items: Item[] = [];
    let used = false;
    for (const it of u.ast.items) {
      match (it) {
        IFunction(f) => {
          const w = wrapFunction(sm, f);
          if (w.used) {
            used = true;
          }
          for (const x of w.items) {
            items.push(x);
          }
        },
        IClass(c) => {
          const w = wrapClass(sm, c);
          if (w.used) {
            used = true;
          }
          for (const x of w.items) {
            items.push(x);
          }
        },
        IType(td) => {
          items.push(it);
          match (recordCheck(sm, td)) {
            Some(x) => {
              items.push(x);
              used = true;
            },
            None => {}
          }
        },
        _ => { items.push(it); }
      }
    }
    if (!used) {
      units.push(u);
    } else {
      let imports: ImportTarget[] = [];
      for (const t of u.imports) {
        imports.push(t);
      }
      const sp = Span { file: u.file, start: 0, end: 0 };
      if (!importsExit(u.ast)) {
        items.push(IImport(plainImport([idOf("exit", sp)], "std:process", sp, sp, false)));
        imports.push(ImportStd(StdProcess));
      }
      items.push(failStub(sp));
      if (!supportDone) {
        supportDone = true;
        for (const x of supportItems(u.file)) {
          items.push(x);
        }
      }
      units.push(Unit {
        file: u.file, path: u.path, name: u.name, module: u.module,
        ast: Module { file: u.ast.file, items: items }, imports: imports
      });
    }
  }
  return LoadedProgram { units: units, entry: prog.entry, manifest: prog.manifest };
}
