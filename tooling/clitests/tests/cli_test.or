import { assertEq, assertEqString, assertEqBool } from "std:test";
import { parseArgs, usage } from "../src/cli";

@Test
function osigAndDefaults(): void {
  const p = parseArgs(["osig"]);
  assertEqBool(p.ok, true, "ok");
  assertEqString(p.options.suite, "osig", "suite");
  assertEqString(p.options.orin, "", "no --orin: build/bootstrap/orin2");
  assertEqBool(p.options.update, false, "no --update");
  assertEqString(p.options.root, ".", "default root");
}

@Test
function osigOptions(): void {
  const p = parseArgs(["--orin", "x/orin", "osig", "--update", "--root=/r"]);
  assertEqBool(p.ok, true, "ok");
  assertEqString(p.options.orin, "x/orin", "--orin before the suite");
  assertEqBool(p.options.update, true, "--update");
  assertEqString(p.options.root, "/r", "--root=");
}

@Test
function fmtOptions(): void {
  const p = parseArgs(["fmt", "--orin2", "y/orin2", "--no-build", "--jobs", "3", "-v"]);
  assertEqBool(p.ok, true, "ok");
  assertEqString(p.options.suite, "fmt", "suite");
  assertEqString(p.options.orin2, "y/orin2", "--orin2");
  assertEqBool(p.options.noBuild, true, "--no-build");
  assertEq(p.options.jobs, 3, "--jobs");
  assertEqBool(p.options.verbose, true, "-v");
  assertEq(parseArgs(["fmt"]).options.jobs, 0, "default: the CPU count");
  assertEqString(parseArgs(["fmt"]).options.orin2, "build/bootstrap/orin2", "default orin2");
}

@Test
function errorsAreReported(): void {
  assertEqBool(parseArgs([]).ok, false, "suite is required");
  assertEqBool(parseArgs(["both"]).ok, false, "unknown suite");
  assertEqBool(parseArgs(["osig", "fmt"]).ok, false, "two suites");
  assertEqBool(parseArgs(["osig", "--orin"]).ok, false, "missing value");
  assertEqBool(parseArgs(["osig", "--orin", "--root"]).ok, false, "option as value");
  assertEqBool(parseArgs(["osig", "--nope"]).ok, false, "unknown option");
  assertEqString(parseArgs(["osig", "--nope"]).error, "unrecognized arguments: --nope", "message");
  assertEqBool(parseArgs(["osig", "--jobs", "2"]).ok, false, "--jobs belongs to fmt");
  assertEqBool(parseArgs(["fmt", "--update"]).ok, false, "--update belongs to osig");
  assertEqString(parseArgs(["fmt", "--jobs", "x"]).error, "argument --jobs: invalid int value: 'x'", "bad int");
}

@Test
function helpWins(): void {
  const p = parseArgs(["fmt", "-h"]);
  assertEqBool(p.ok && p.options.help, true, "help");
  assertEqBool(usage().startsWith("usage: orin-clitests"), true, "usage");
}
