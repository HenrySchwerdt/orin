// OX member tags on a class name (ADR-0044 §4.5): `<Ui.Card ..>..</Ui.Card>` calls the static method `Card` of the class
// `Ui`, with the component rules (attributes by parameter name, slots, Option parameters, spread, source-order
// evaluation). The class is imported from another module.
import { Html, render } from "std:html";
import ox from "std:html";
import { Ui } from "./kit";

class Local {
  static Tag(label: string): Html {
    return <b>{label}</b>;
  }
}

// a static method of a generic class
class Box<T> {
  v: T;

  constructor(v: T) {
    this.v = v;
  }

  static Tag(label: string): Html {
    return <i>{label}</i>;
  }
}

type Cells = { a: string; b: string; };

// Prints when it is evaluated: the attributes are evaluated left to right whatever the parameter order.
function note(s: string): string {
  console.log(`eval ${s}`);
  return s;
}

function main(): void {
  console.log(render(<Ui.Card title="x & y">body</Ui.Card>));
  console.log(render(<Ui.Card title="self" />));
  console.log(render(<Ui.Dialog title="T"><:header>H</:header>text</Ui.Dialog>));
  console.log(render(<Ui.Dialog title="T" footer={Some(<b>f</b>)}><:header><u>H</u></:header></Ui.Dialog>));
  const cells = Cells { a: "s1", b: "s2" };
  console.log(render(<Ui.Row {...cells} />));
  console.log(render(<Ui.Table><tr><td>end</td></tr></Ui.Table>));
  console.log(render(<Local.Tag label="local" />));
  console.log(render(<Box.Tag label="generic" />));
  const same = render(<Ui.Card title="t">c</Ui.Card>) == render(Ui.Card("t", <>c</>));
  console.log(`same: ${same}`);
  console.log(render(<Ui.Row b={note("b")} a={note("a")} />));
}
