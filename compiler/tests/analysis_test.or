// Assertions for compiler/analysis (workspace overlay, diagnostics, symbols, completions,
// positions, SemanticIndex queries on a hand-built index). Prints `ok` or one line per failure.
// Build: build/bootstrap/orin2 compile compiler/tests/analysis_test.or -o x.c && cc -O1 -w -I runtime/core x.c runtime/core/orin_runtime.c runtime/platform/orin_platform.c

import { Host, useFs } from "std:host";
import { FsGrant, writeFile } from "std:fs";
import {
  newWorkspace, openFile, changeFile, closeFile, fileText, openPaths, analyze, diagsForPath, documentSymbols,
  keywordCompletions, declCompletions, offsetToPos, posToOffset, definitionAt, hoverAt, referencesTo,
  renameEdits, symbolSpanAt, newAnalysisCache, Workspace, DocSymbol, CompletionItem, PathDiag, DkFunction, DkRecord,
  DkUnion, DkVariant, DkConst, DkField, DkImported, DkAlias
} from "../analysis";
import { SemanticIndex, SymbolDef, SymbolRef, TypeAt, SkFunction, SkParam } from "../hir";
import { Span, span } from "../diag";
import { exit } from "std:process";

function eq(fails: string[], what: string, got: string, want: string): string[] {
  let f = fails;
  if (got != want) {
    f.push(what + ": got `" + got + "`, want `" + want + "`");
  }
  return f;
}

function eqi(fails: string[], what: string, got: usize, want: usize): string[] {
  return eq(fails, what, got.toString(), want.toString());
}

function names(items: CompletionItem[]): string {
  let parts: string[] = [];
  for (const i of items) {
    parts.push(i.label);
  }
  return parts.join(",");
}

function symNames(ss: DocSymbol[]): string {
  let parts: string[] = [];
  for (const s of ss) {
    parts.push(s.name);
  }
  return parts.join(",");
}

function diagLine(d: PathDiag): string {
  return d.path + " " + d.code + " " + d.start.toString() + "-" + d.end.toString();
}

// Span of the nth-agnostic first occurrence of `needle` in `text` (file 0).
function sp(text: string, needle: string): Span {
  const i = text.indexOf(needle).unwrap();
  return span(0, i, i + needle.length);
}

// Span of the occurrence of `needle` that starts at or after `begin`.
function spAfter(text: string, begin: usize, needle: string): Span {
  const rest = text.substring(begin, text.length);
  const i = begin + rest.indexOf(needle).unwrap();
  return span(0, i, i + needle.length);
}

function testWorkspace(f: string[]): string[] {
  let fails = f;
  let ws = newWorkspace();
  fails = eqi(fails, "rev0", ws.revision().toUsize(), 0);
  ws = openFile(ws, "/w/./a.or", "one");
  ws = openFile(ws, "/w/b.or", "two");
  fails = eq(fails, "text a", fileText(ws, "/w/a.or").unwrapOr("?"), "one");
  ws = changeFile(ws, "/w/x/../a.or", "uno");
  fails = eq(fails, "changed a", fileText(ws, "/w/a.or").unwrapOr("?"), "uno");
  fails = eq(fails, "paths", openPaths(ws).join(";"), "/w/a.or;/w/b.or");
  ws = closeFile(ws, "/w/a.or");
  fails = eq(fails, "closed", fileText(ws, "/w/a.or").isNone().toString(), "true");
  fails = eqi(fails, "rev4", ws.revision().toUsize(), 4);
  return fails;
}

function testPositions(f: string[]): string[] {
  let fails = f;
  const t = "ab\ncd\xc3\xa9f\n\xf0\x9f\x98\x80x";
  const p0 = offsetToPos(t, 4);
  fails = eq(fails, "pos 4", p0.line.toString() + ":" + p0.character.toString(), "1:1");
  // after the e-acute (2 bytes, 1 unit): byte 7 -> col 3
  const p1 = offsetToPos(t, 7);
  fails = eq(fails, "pos 7", p1.line.toString() + ":" + p1.character.toString(), "1:3");
  // after the emoji (4 bytes, 2 units): line 2, col 2
  const p2 = offsetToPos(t, 13);
  fails = eq(fails, "pos emoji", p2.line.toString() + ":" + p2.character.toString(), "2:2");
  fails = eqi(fails, "off 1:3", posToOffset(t, 1, 3), 7);
  fails = eqi(fails, "off 2:2", posToOffset(t, 2, 2), 13);
  fails = eqi(fails, "off clamp", posToOffset(t, 0, 99), 2);
  fails = eqi(fails, "off eof", posToOffset(t, 9, 0), t.length);
  fails = eqi(fails, "off 0:0", posToOffset(t, 0, 0), 0);
  return fails;
}

function testAnalyze(fs: FsGrant, f: string[]): string[] {
  let fails = f;
  // Valid file without main: no diagnostics (synthetic main).
  let ws = openFile(newWorkspace(), "/v/ok.or", "export function f(x: int): int { return x + 1; }");
  let a = analyze(fs, ws, "/v/ok.or");
  fails = eqi(fails, "ok diags", a.diags.length, 0);
  fails = eqi(fails, "ok rev", a.revision.toUsize(), 1);
  // Type error, position preserved.
  ws = changeFile(ws, "/v/ok.or", "function f(): int { return true; }");
  a = analyze(fs, ws, "/v/ok.or");
  fails = eqi(fails, "terr n", a.diags.length, 1);
  if (a.diags.length == 1) {
    fails = eq(fails, "terr", diagLine(a.diags[0]), "/v/ok.or E0400 27-31");
  }
  // Syntax error.
  ws = changeFile(ws, "/v/ok.or", "function f( {");
  a = analyze(fs, ws, "/v/ok.or");
  fails = eqi(fails, "syn n", a.diags.length, 1);
  if (a.diags.length == 1) {
    fails = eq(fails, "syn code", a.diags[0].code, "E0200");
  }
  // Several syntax errors (parser error recovery): all of them, and no type error from the checker.
  ws = changeFile(ws, "/v/ok.or", "function f(): int { return true; }\nfunction g(): void { let a = ; }\nfunction h( {");
  a = analyze(fs, ws, "/v/ok.or");
  fails = eqi(fails, "syn2 n", a.diags.length, 2);
  if (a.diags.length == 2) {
    fails = eq(fails, "syn2 first", diagLine(a.diags[0]), "/v/ok.or E0200 64-65");
    fails = eq(fails, "syn2 second", diagLine(a.diags[1]), "/v/ok.or E0200 80-81");
  }
  // Existing main is respected (E0412 for a wrong signature is reported).
  ws = changeFile(ws, "/v/ok.or", "function main(x: int): void { }");
  a = analyze(fs, ws, "/v/ok.or");
  fails = eqi(fails, "main sig n", a.diags.length, 1);
  // Cross-module: the error is in the imported file.
  ws = newWorkspace();
  ws = openFile(ws, "/v/main.or", "import { f } from \"./lib\";\nfunction main(): void { console.log(f(1).toString()); }");
  ws = openFile(ws, "/v/lib.or", "export function f(x: int): int { return \"s\"; }");
  a = analyze(fs, ws, "/v/main.or");
  fails = eqi(fails, "x n", a.diags.length, 1);
  if (a.diags.length == 1) {
    fails = eq(fails, "x diag", diagLine(a.diags[0]), "/v/lib.or E0400 40-43");
  }
  fails = eqi(fails, "x main empty", diagsForPath(a, "/v/main.or").length, 0);
  fails = eqi(fails, "x lib", diagsForPath(a, "/v/./lib.or").length, 1);
  // Fix the imported file: clean.
  ws = changeFile(ws, "/v/lib.or", "export function f(x: int): int { return x; }");
  a = analyze(fs, ws, "/v/main.or");
  fails = eqi(fails, "fixed", a.diags.length, 0);
  // Imported name that is not exported -> E0300 in the importer.
  ws = changeFile(ws, "/v/lib.or", "function f(x: int): int { return x; }");
  a = analyze(fs, ws, "/v/main.or");
  fails = eqi(fails, "unexported n", a.diags.length, 1);
  if (a.diags.length == 1) {
    fails = eq(fails, "unexported", a.diags[0].code + " " + a.diags[0].path, "E0300 /v/main.or");
  }
  // Missing module.
  ws = changeFile(ws, "/v/main.or", "import { g } from \"./nothere\";\nfunction main(): void { }");
  a = analyze(fs, ws, "/v/main.or");
  fails = eqi(fails, "missing n", a.diags.length, 1);
  if (a.diags.length == 1) {
    fails = eq(fails, "missing", a.diags[0].code, "E0301");
  }
  return fails;
}

// AnalysisCache: a hit needs the same workspace revision and unchanged inputs; a changed overlay buffer, a changed file on
// disk, a failed load and the capacity each lead to a fresh analysis.
function testAnalysisCache(fs: FsGrant, f: string[]): string[] {
  let fails = f;
  let cache = newAnalysisCache(2);
  let ws = openFile(newWorkspace(), "/v/c1.or", "export function f(x: int): int { return x + 1; }");
  const a1 = cache.analyze(fs, ws, "/v/c1.or");
  const a2 = cache.analyze(fs, ws, "/v/./c1.or");
  fails = eq(fails, "miss then hit", cache.hits.toString() + "/" + cache.misses.toString(), "1/1");
  fails = eq(fails, "hit is the same result", a1.entry + a1.diags.length.toString() + a1.revision.toString(),
    a2.entry + a2.diags.length.toString() + a2.revision.toString());
  // A change of the buffer bumps the revision: the entry is recomputed and sees the new text.
  ws = changeFile(ws, "/v/c1.or", "function f(): int { return true; }");
  const a3 = cache.analyze(fs, ws, "/v/c1.or");
  fails = eq(fails, "change misses", cache.hits.toString() + "/" + cache.misses.toString(), "1/2");
  fails = eqi(fails, "change sees new text", a3.diags.length, 1);
  const a4 = cache.analyze(fs, ws, "/v/c1.or");
  fails = eqi(fails, "hit after change", cache.hits, 2);
  fails = eqi(fails, "hit keeps the diagnostics", a4.diags.length, 1);
  // A load that fails is never cached.
  ws = changeFile(ws, "/v/c1.or", "function f( {");
  cache.analyze(fs, ws, "/v/c1.or");
  cache.analyze(fs, ws, "/v/c1.or");
  fails = eq(fails, "failed load not cached", cache.hits.toString() + "/" + cache.misses.toString(), "2/4");
  fails = eqi(fails, "nothing cached", cache.size(), 0);
  // Capacity 2: the oldest entry goes.
  ws = openFile(ws, "/v/c1.or", "function f(): int { return 1; }");
  ws = openFile(ws, "/v/c2.or", "function g(): int { return 2; }");
  ws = openFile(ws, "/v/c3.or", "function h(): int { return 3; }");
  cache.analyze(fs, ws, "/v/c1.or");
  cache.analyze(fs, ws, "/v/c2.or");
  cache.analyze(fs, ws, "/v/c3.or");
  fails = eqi(fails, "bounded", cache.size(), 2);
  const hits = cache.hits;
  cache.analyze(fs, ws, "/v/c3.or");
  cache.analyze(fs, ws, "/v/c1.or");
  fails = eqi(fails, "newest kept, oldest dropped", cache.hits - hits, 1);
  cache.clear();
  fails = eqi(fails, "clear", cache.size(), 0);

  // A file read from disk: the same workspace (a fresh overlay of the entry, as the MCP server builds it) hits while the
  // file is unchanged and misses once it changed on disk.
  const lib = "/tmp/orin_analysis_cache_test_lib.or";
  const w1 = writeFile(fs, lib, "export function g(): int { return 1; }\n");
  fails = eq(fails, "write lib", w1.isOk().toString(), "true");
  const main = "import { g } from \"./orin_analysis_cache_test_lib\";\nfunction main(): void {\n  const n: int = g();\n}\n";
  const ws2 = openFile(newWorkspace(), "/tmp/orin_analysis_cache_test_main.or", main);
  let c2 = newAnalysisCache(4);
  const b1 = c2.analyze(fs, ws2, "/tmp/orin_analysis_cache_test_main.or");
  fails = eqi(fails, "disk project loads", b1.diags.length, 0);
  fails = eqi(fails, "disk project cached", c2.size(), 1);
  const ws3 = openFile(newWorkspace(), "/tmp/orin_analysis_cache_test_main.or", main);
  c2.analyze(fs, ws3, "/tmp/orin_analysis_cache_test_main.or");
  fails = eq(fails, "fresh overlay, same files: hit", c2.hits.toString() + "/" + c2.misses.toString(), "1/1");
  writeFile(fs, lib, "export function g(): string { return \"s\"; }\n");
  const b2 = c2.analyze(fs, ws3, "/tmp/orin_analysis_cache_test_main.or");
  fails = eq(fails, "disk change: miss", c2.hits.toString() + "/" + c2.misses.toString(), "1/2");
  fails = eqi(fails, "disk change seen", b2.diags.length, 1);
  return fails;
}

function testSymbols(fs: FsGrant, f: string[]): string[] {
  let fails = f;
  const src = "import { g } from \"./lib\";\nexport type P = { x: int; y: int; };\ntype S = A(int) | B;\ntype N = string;\nconst K: int = 3;\nfunction h(a: int, b: string): bool { return true; }\n";
  const ws = openFile(newWorkspace(), "/s/a.or", src);
  const ss = documentSymbols(fs, ws, "/s/a.or");
  fails = eq(fails, "top names", symNames(ss), "P,S,N,K,h");
  if (ss.length == 5) {
    fails = eq(fails, "P children", symNames(ss[0].children), "x,y");
    fails = eq(fails, "S children", symNames(ss[1].children), "A,B");
    fails = eq(fails, "h detail", ss[4].detail, "function h(a: int, b: string): bool");
    fails = eq(fails, "K detail", ss[3].detail, "const K: int");
    fails = eq(fails, "A detail", ss[1].children[0].detail, "A(int): S");
    fails = eqi(fails, "P nameSpan", ss[0].nameSpan.start, src.indexOf("P =").unwrap());
    fails = eq(fails, "P exported", ss[0].exported.toString(), "true");
    fails = eq(fails, "kinds", match (ss[0].kind) { DkRecord => "rec", _ => "?" } + match (ss[1].kind) { DkUnion => "uni", _ => "?" }
      + match (ss[2].kind) { DkAlias => "ali", _ => "?" } + match (ss[3].kind) { DkConst => "con", _ => "?" }
      + match (ss[4].kind) { DkFunction => "fun", _ => "?" }, "recunialiconfun");
  }
  const bad = openFile(newWorkspace(), "/s/bad.or", "function (");
  fails = eqi(fails, "bad syms", documentSymbols(fs, bad, "/s/bad.or").length, 0);
  fails = eqi(fails, "kw count", keywordCompletions().length, 22);

  // Completions: own decls (+ union variants) and imported names (+ imported variants).
  let ws2 = openFile(newWorkspace(), "/s/lib.or", "export type Shape = Circle(int) | Dot;\nexport function area(s: Shape): int { return 0; }\nfunction hidden(): void { }\n");
  ws2 = openFile(ws2, "/s/main.or", "import { Shape, area, hidden, nothing } from \"./lib\";\ntype T = { q: int; };\nfunction main(): void { }\n");
  const cs = declCompletions(fs, ws2, "/s/main.or");
  fails = eq(fails, "completions", names(cs), "T,main,Shape,Circle,Dot,area,hidden,nothing");
  if (cs.length == 8) {
    fails = eq(fails, "area detail", cs[5].detail, "function area(s: Shape): int");
    fails = eq(fails, "hidden imported", match (cs[6].kind) { DkImported => "imp", _ => "?" }, "imp");
    fails = eq(fails, "variant kind", match (cs[3].kind) { DkVariant => "var", _ => "?" }, "var");
  }
  return fails;
}

function testIndex(f: string[]): string[] {
  let fails = f;
  const text = "function add(a: int): int { return a; }\nfunction main(): void { add(1); }\n";
  const addDecl = sp(text, "add");
  const aDecl = sp(text, "a:");
  const aName = span(0, aDecl.start, aDecl.start + 1);
  const mainDecl = sp(text, "main");
  const aUse = spAfter(text, aName.end, "a;");
  const aUse1 = span(0, aUse.start, aUse.start + 1);
  const callAt = spAfter(text, mainDecl.end, "add");
  const callExpr = spAfter(text, mainDecl.end, "add(1)");
  const defs = [
    SymbolDef { id: 0, name: "add", kind: SkFunction, nameSpan: addDecl, declSpan: span(0, 0, 39), unit: 0, container: None, exported: false, detail: "function add(a: int): int", deprecated: None },
    SymbolDef { id: 1, name: "a", kind: SkParam, nameSpan: aName, declSpan: aName, unit: 0, container: Some(0), exported: false, detail: "a: int", deprecated: None },
    SymbolDef { id: 2, name: "main", kind: SkFunction, nameSpan: mainDecl, declSpan: span(0, 40, 70), unit: 0, container: None, exported: false, detail: "function main(): void", deprecated: None }
  ];
  const refs = [
    SymbolRef { span: aUse1, def: 1 },
    SymbolRef { span: callAt, def: 0 }
  ];
  const types = [
    TypeAt { span: callExpr, ty: "int" },
    TypeAt { span: aUse1, ty: "int" }
  ];
  const idx = SemanticIndex { defs: defs, refs: refs, types: types, impls: [], calls: [], fnDefs: [], fnKinds: [], typed: true };

  // definitionAt: on the call -> decl; on the decl itself -> decl; at a keyword -> none.
  const d1 = definitionAt(idx, 0, callAt.start + 1);
  fails = eq(fails, "def call", d1.isSome().toString(), "true");
  if (d1.isSome()) {
    fails = eqi(fails, "def call start", d1.unwrap().start, addDecl.start);
  }
  fails = eq(fails, "def on decl", definitionAt(idx, 0, addDecl.start).isSome().toString(), "true");
  fails = eq(fails, "def end-of-ident", definitionAt(idx, 0, callAt.end).isSome().toString(), "true");
  fails = eq(fails, "def none", definitionAt(idx, 0, 2).isNone().toString(), "true");
  fails = eq(fails, "def other file", definitionAt(idx, 1, callAt.start).isNone().toString(), "true");
  const d2 = definitionAt(idx, 0, aUse1.start);
  fails = eqi(fails, "def param", d2.unwrap().start, aName.start);

  // hover: symbol detail, else the narrowest type.
  fails = eq(fails, "hover sym", hoverAt(idx, 0, callAt.start).unwrap().text, "function add(a: int): int");
  fails = eq(fails, "hover type", hoverAt(idx, 0, callExpr.end - 1).unwrap().text, "int");
  fails = eq(fails, "hover none", hoverAt(idx, 0, 1).isNone().toString(), "true");

  // references.
  fails = eqi(fails, "refs incl", referencesTo(idx, 0, callAt.start, true).length, 2);
  fails = eqi(fails, "refs excl", referencesTo(idx, 0, addDecl.start, false).length, 1);
  fails = eqi(fails, "refs param", referencesTo(idx, 0, aUse1.start, true).length, 2);
  fails = eqi(fails, "refs none", referencesTo(idx, 0, 1, true).length, 0);
  fails = eq(fails, "symbolSpan", symbolSpanAt(idx, 0, callAt.start).unwrap().start.toString(), callAt.start.toString());

  // rename.
  const r1 = renameEdits(idx, 0, callAt.start, "plus");
  fails = eq(fails, "rename ok", r1.isOk().toString(), "true");
  if (r1.isOk()) {
    const es = r1.unwrap();
    fails = eqi(fails, "rename n", es.length, 2);
    fails = eq(fails, "rename text", es[0].newText, "plus");
    fails = eqi(fails, "rename decl first", es[0].span.start, addDecl.start);
  }
  fails = eq(fails, "rename collide", renameEdits(idx, 0, callAt.start, "main").unwrapErr(), "`main` is already defined in this scope");
  fails = eq(fails, "rename reserved", renameEdits(idx, 0, callAt.start, "let").unwrapErr(), "`let` is a reserved word");
  fails = eq(fails, "rename invalid", renameEdits(idx, 0, callAt.start, "1x").unwrapErr(), "`1x` is not a valid identifier");
  fails = eq(fails, "rename empty", renameEdits(idx, 0, callAt.start, "").unwrapErr(), "name is empty");
  fails = eq(fails, "rename same", renameEdits(idx, 0, callAt.start, "add").isErr().toString(), "true");
  fails = eq(fails, "rename nosym", renameEdits(idx, 0, 1, "zzz").isErr().toString(), "true");
  // A parameter may take a name that exists in another scope.
  fails = eq(fails, "rename param", renameEdits(idx, 0, aUse1.start, "add").isOk().toString(), "true");
  return fails;
}

// Semantic index of closures (ADR-0011): arrow parameters and captured variables resolve, array
// methods with arrow arguments check, and the types of closure bodies are indexed.
function testClosures(fs: FsGrant, f: string[]): string[] {
  let fails = f;
  const text = "function main(): void {\n  const k = 3;\n  const g = (x: int): int => x + k;\n  const ys = [1, 2].map(y => y * k);\n  console.log(g(1).toString() + ys.length.toString());\n}\n";
  const ws = openFile(newWorkspace(), "/c/a.or", text);
  const a = analyze(fs, ws, "/c/a.or");
  fails = eqi(fails, "closure diags", a.diags.length, 0);
  if (a.index.isNone()) {
    return eq(fails, "closure index", "none", "some");
  }
  const idx = a.index.unwrap();
  const kDecl = text.indexOf("k = 3").unwrap();
  const xDecl = text.indexOf("x: int").unwrap();
  const xUse = text.indexOf("x + k").unwrap();
  const kUse = xUse + 4;
  const yDecl = text.indexOf("y =>").unwrap();
  const yUse = text.indexOf("y * k").unwrap();
  const kUse2 = yUse + 4;
  const gUse = text.indexOf("g(1)").unwrap();
  const gDecl = text.indexOf("g = ").unwrap();
  fails = eq(fails, "x use -> param", definitionAt(idx, 0, xUse).unwrapOr(span(0, 0, 0)).start.toString(), xDecl.toString());
  fails = eq(fails, "k captured", definitionAt(idx, 0, kUse).unwrapOr(span(0, 0, 0)).start.toString(), kDecl.toString());
  fails = eq(fails, "y use -> param", definitionAt(idx, 0, yUse).unwrapOr(span(0, 0, 0)).start.toString(), yDecl.toString());
  fails = eq(fails, "k captured (2)", definitionAt(idx, 0, kUse2).unwrapOr(span(0, 0, 0)).start.toString(), kDecl.toString());
  fails = eq(fails, "g call -> decl", definitionAt(idx, 0, gUse).unwrapOr(span(0, 0, 0)).start.toString(), gDecl.toString());
  fails = eqi(fails, "refs to k", referencesTo(idx, 0, kDecl, false).length, 2);
  fails = eq(fails, "hover g", hoverAt(idx, 0, gDecl).unwrap().text, "const g: (int) => int");
  // hover on the arrow expression itself: its function type
  const arrow = text.indexOf("=> x + k").unwrap();
  fails = eq(fails, "hover arrow", hoverAt(idx, 0, arrow).unwrap().text, "(int) => int");
  return fails;
}

// Contract clauses (ADR-0012): diagnostics with their own codes, hover shows the clauses, names in
// clauses resolve (including loop clauses).
function testContracts(fs: FsGrant, f: string[]): string[] {
  let fails = f;
  const text = "@Requires(a > 0)\n@Ensures(result >= a)\nfunction add(a: int): int { return a; }\nfunction main(): void {\n  let i = 0;\n  @Invariant(i >= 0)\n  while (i < 3) { i += 1; }\n  console.log(add(1).toString());\n}\n";
  const ws = openFile(newWorkspace(), "/k/a.or", text);
  const a = analyze(fs, ws, "/k/a.or");
  fails = eqi(fails, "contracts diags", a.diags.length, 0);
  if (a.index.isNone()) {
    return eq(fails, "contracts index", "none", "some");
  }
  const idx = a.index.unwrap();
  const addUse = text.indexOf("add(1)").unwrap();
  fails = eq(
    fails, "hover contracts", hoverAt(idx, 0, addUse).unwrap().text,
    "function add(a: int): int\n@Requires(a > 0)\n@Ensures(result >= a)"
  );
  const aDecl = text.indexOf("a: int").unwrap();
  const aUse = text.indexOf("a > 0").unwrap();
  fails = eq(fails, "param in @Requires", definitionAt(idx, 0, aUse).unwrapOr(span(0, 0, 0)).start.toString(), aDecl.toString());
  const iDecl = text.indexOf("i = 0").unwrap();
  const iUse = text.indexOf("i >= 0").unwrap();
  fails = eq(fails, "local in loop @Invariant", definitionAt(idx, 0, iUse).unwrapOr(span(0, 0, 0)).start.toString(), iDecl.toString());
  // Errors carry the contract codes.
  const bad = openFile(newWorkspace(), "/k/b.or", "@Requires(a + 1)\nfunction f(a: int): int { return a; }\n");
  const b = analyze(fs, bad, "/k/b.or");
  fails = eqi(fails, "E0414 n", b.diags.length, 1);
  if (b.diags.length == 1) {
    fails = eq(fails, "E0414", b.diags[0].code, "E0414");
  }
  const impure = openFile(newWorkspace(), "/k/c.or", "function p(x: int): bool { console.log(\"x\"); return true; }\n@Requires(p(a))\nfunction f(a: int): int { return a; }\n");
  const c = analyze(fs, impure, "/k/c.or");
  if (c.diags.length == 1) {
    fails = eq(fails, "E0416", c.diags[0].code, "E0416");
  } else {
    fails = eqi(fails, "E0416 n", c.diags.length, 1);
  }
  // Purity is inferred (ADR-0031 A4): pure closures and a helper that uses `every` are accepted ...
  const pureCl = openFile(
    newWorkspace(), "/k/d.or",
    "function g(xs: int[]): bool { return xs.every(x => x > 0); }\n@Requires(g(a) && a.some(x => x > 1))\nfunction f(a: int[]): int { return 1; }\n"
  );
  fails = eqi(fails, "pure closure diags", analyze(fs, pureCl, "/k/d.or").diags.length, 0);
  // ... a closure that reaches an I/O built-in is rejected, and the message names it.
  const impureCl = openFile(
    newWorkspace(), "/k/e.or",
    "function h(xs: int[]): bool { return xs.every(x => { console.log(\"x\"); return true; }); }\n@Requires(h(a))\nfunction f(a: int[]): int { return 1; }\n"
  );
  const e = analyze(fs, impureCl, "/k/e.or");
  fails = eqi(fails, "impure closure n", e.diags.length, 1);
  if (e.diags.length == 1) {
    fails = eq(fails, "impure closure code", e.diags[0].code, "E0416");
    fails = eq(fails, "impure closure names the operation", e.diags[0].message.includes("performs I/O (console.log) at /k/e.or:1:").toString(), "true");
  }
  return fails;
}

function main(host: Host): void {
  useFs(host, fs => { run(fs); });
}

function run(fs: FsGrant): void {
  let f: string[] = [];
  f = testContracts(fs, f);
  f = testClosures(fs, f);
  f = testWorkspace(f);
  f = testPositions(f);
  f = testAnalyze(fs, f);
  f = testAnalysisCache(fs, f);
  f = testSymbols(fs, f);
  f = testIndex(f);
  if (f.length == 0) {
    console.log("ok");
  } else {
    for (const m of f) {
      console.log("FAIL " + m);
    }
    exit(1);
  }
}
