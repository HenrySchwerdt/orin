// Capturing an array does not copy it; mutating the original afterwards copies on write, so the
// closure keeps seeing the array as it was.
function main(): void {
  let xs: int[] = [1, 2, 3];
  const sum = () => {
    let t = 0;
    for (const x of xs) {
      t += x;
    }
    return t;
  };
  const len = () => xs.length;
  xs.push(4);
  xs[0] = 100;
  console.log(sum().toString() + " " + len().toString());
  let total = 0;
  for (const x of xs) {
    total += x;
  }
  console.log(total.toString() + " " + xs.length.toString());
}
