import { assertEqString, assertEqUsize, assertEqBool } from "std:test";
import { strip, shq, splitLines, replaceFirst, replaceAll, countOf, countLinePrefix, cutBytes, tailBytes, padEnd, padStart, reprStr } from "../src/text";

@Test
function stripRemovesSurroundingWhitespace(): void {
  assertEqString(strip("  a b \t\r\n"), "a b", "both sides");
  assertEqString(strip(""), "", "empty");
  assertEqString(strip(" \n "), "", "only blanks");
}

@Test
function shellQuoting(): void {
  assertEqString(shq("a b"), "'a b'", "plain");
  assertEqString(shq("it's"), "'it'\\''s'", "quote");
  assertEqString(shq(""), "''", "empty");
}

@Test
function splitLinesLikePython(): void {
  assertEqUsize(splitLines("a\nb\n").length, 2, "trailing newline adds no line");
  assertEqUsize(splitLines("a\r\nb").length, 2, "crlf");
  assertEqUsize(splitLines("").length, 0, "empty");
  assertEqString(splitLines("FAIL x\n    detail")[1], "    detail", "second line");
}

@Test
function replaceFirstOnlyChangesTheFirstOccurrence(): void {
  assertEqString(replaceFirst("a+b+c", "+", "-"), "a-b+c", "first");
  assertEqString(replaceFirst("abc", "x", "-"), "abc", "absent");
  assertEqString(replaceFirst("return len;\nreturn len;", "return len;", "return 0;"), "return 0;\nreturn len;", "multi-line text");
  assertEqString(replaceFirst("abc", "abc", ""), "", "deletion");
}

@Test
function replaceAllChangesEveryOccurrence(): void {
  assertEqString(replaceAll("\"std:bytes\" \"std:bytes\"", "\"std:bytes\"", "\"./bytes\""), "\"./bytes\" \"./bytes\"", "both");
  assertEqString(replaceAll("abc", "x", "y"), "abc", "absent");
}

@Test
function countsNonOverlappingOccurrences(): void {
  assertEqUsize(countOf("aaaa", "aa"), 2, "non-overlapping");
  assertEqUsize(countOf("abc", "x"), 0, "absent");
  assertEqUsize(countOf("contract violated; contract violated", "contract violated"), 2, "twice");
}

@Test
function countsLinesThatStartWithAPrefix(): void {
  assertEqUsize(countLinePrefix("FAIL a\nok\nFAIL b\n  FAIL c\nFAIL", "FAIL "), 2, "only line starts, with the blank");
  assertEqUsize(countLinePrefix("", "FAIL "), 0, "empty");
  assertEqUsize(countLinePrefix("x FAIL a", "FAIL "), 0, "not at the start");
  assertEqUsize(countLinePrefix("FAIL (timeout after 900 s)\n", "FAIL "), 1, "the line of a timeout");
}

@Test
function cutsAndTails(): void {
  assertEqString(cutBytes("abcdef", 3), "abc", "cut");
  assertEqString(cutBytes("abc", 10), "abc", "short");
  assertEqString(tailBytes("abcdef", 2), "ef", "tail");
  assertEqString(tailBytes("abc", 10), "abc", "short tail");
  assertEqString(cutBytes("aé", 2), "a", "does not split a UTF-8 sequence");
}

@Test
function padsLikePrintf(): void {
  assertEqString(padEnd("ab", 5) + "|", "ab   |", "%-5s");
  assertEqString(padEnd("abcdef", 3), "abcdef", "%-3s does not truncate");
  assertEqString(padStart("7", 2), " 7", "%2d");
  assertEqString(padStart("12", 2), "12", "%2d two digits");
  assertEqString(padStart("123", 2), "123", "%2d three digits");
}

@Test
function reprOfStrings(): void {
  assertEqString(reprStr("5"), "'5'", "plain");
  assertEqString(reprStr("it's"), "\"it's\"", "single quote");
  assertEqBool(reprStr("a\\b") == "'a\\\\b'", true, "backslash");
}
