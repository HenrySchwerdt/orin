type Pair<A, B> = { first: A; second: B; };

function id<T>(x: T): T {
  return x;
}

function single<T>(x: T): T[] {
  return [id(x)];
}

function twice<T>(x: T): Pair<T[], T[]> {
  return Pair { first: single(x), second: single(id(x)) };
}

function flatten<T>(xss: T[][]): T[] {
  let out: T[] = [];
  for (const xs of xss) {
    for (const x of xs) {
      out.push(x);
    }
  }
  return out;
}

function both<T>(p: Pair<T[], T[]>): T[] {
  return flatten([p.first, p.second]);
}

function main(): void {
  console.log(both(twice(3)).length.toString());
  console.log(both(twice("s")).join(""));
  console.log(flatten([[1], [2, 3], []]).length.toString());
  console.log(flatten(single(single(true))).length.toString());
}
