function main(): void {
  const none: int[] = [];
  console.log(none.map(x => x + 1).length.toString());
  console.log(none.filter(x => true).length.toString());
  console.log(none.find(x => true).isNone().toString());
  none.forEach(x => console.log("never"));
  const one = [9];
  console.log(one.map(x => x * x)[0].toString());
  console.log(one.filter(x => x > 100).length.toString());
  const nested = [[1, 2], [3], []];
  const lens = nested.map(a => a.length);
  console.log(lens[0].toString() + lens[1].toString() + lens[2].toString());
  const flat = nested.reduce((acc: int[], a) => acc.concat(a), []);
  console.log(flat.map(x => x.toString()).join(""));
  const strs = ["a", "b"].map(s => [s, s]);
  console.log(strs[1].join(""));
  const opts = [1, 2, 3].map((x: int): Option<int> => x > 1 ? Some(x) : None);
  console.log(opts[0].isNone().toString() + opts[2].unwrap().toString());
}
