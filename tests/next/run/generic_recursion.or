function countFrom<T>(xs: T[], i: usize): usize {
  if (i >= xs.length) {
    return 0;
  }
  return 1 + countFrom(xs, i + 1);
}

function revInto<T>(xs: T[], i: usize, acc: T[]): T[] {
  if (i >= xs.length) {
    return acc;
  }
  let a = acc;
  a.push(xs[xs.length - 1 - i]);
  return revInto(xs, i + 1, a);
}

function isEven<T>(xs: T[], i: usize): bool {
  if (i >= xs.length) {
    return true;
  }
  return isOdd(xs, i + 1);
}

function isOdd<T>(xs: T[], i: usize): bool {
  if (i >= xs.length) {
    return false;
  }
  return isEven(xs, i + 1);
}

function main(): void {
  console.log(countFrom([1, 2, 3], 0).toString());
  console.log(countFrom(["a"], 0).toString());
  console.log(revInto(["a", "b", "c"], 0, []).join(""));
  console.log(isEven([1, 2, 3, 4], 0).toString());
  console.log(isOdd(["x", "y", "z"], 0).toString());
}
