type Op = { name: string; run: (a: int, b: int) => int; };
type Button = { label: string; onClick: () => string; };

function describe(op: Op): string {
  return op.name + "(6, 3) = " + op.run(6, 3).toString();
}

function main(): void {
  const ops: Op[] = [
    Op { name: "add", run: (a, b) => a + b },
    Op { name: "sub", run: (a, b) => a - b },
    Op { name: "mul", run: (a: int, b: int): int => a * b },
  ];
  for (const op of ops) {
    console.log(describe(op));
  }
  const times = 3;
  const b = Button { label: "go", onClick: () => "clicked x" + times.toString() };
  console.log(b.label + ": " + b.onClick());
  const copy = Button { ...b, label: "stop" };
  console.log(copy.label + ": " + copy.onClick());
  const f = ops[2].run;
  console.log(f(7, 7).toString());
}
