// MIR -> GNU C (against runtime/orin_runtime.h and runtime/orin_runtime_mir.h).
// A direct translation: one C local per MIR local (`l<i>`), blocks as labels (`B<i>:`) and gotos.
// The output is deterministic for a given MIR.

import { BinOp, UnOp, Builtin } from "../hir";
import {
  MType, MLocal, Operand, Instr, SwitchCase, Terminator, MBlock, MFunction, MProgram, isInlineFn
} from "../mir";

type Fx = { prog: MProgram; f: MFunction; names: string[]; };

function u(n: usize): string {
  return n.toString();
}

// ---------------------------------------------------------------- types and literals

function isRefT(t: MType): bool {
  return match (t) {
    MRef => true,
    _ => false
  };
}

function isUsizeT(t: MType): bool {
  return match (t) {
    MUsize => true,
    _ => false
  };
}

function isFloatT(t: MType): bool {
  return match (t) {
    MFloat => true,
    _ => false
  };
}

function cty(t: MType): string {
  return match (t) {
    MInt => "int64_t",
    MBool => "int64_t",
    MFloat => "double",
    MHandle => "int64_t",
    MUsize => "uint64_t",
    MVoid => "void",
    MRef => "OrinObj *"
  };
}

function fromSlot(t: MType, code: string): string {
  if (isRefT(t)) {
    return "ORIN_REF(" + code + ")";
  }
  if (isFloatT(t)) {
    return "orin_s2f(" + code + ")";
  }
  return "((" + cty(t) + ")(" + code + "))";
}

function toSlot(t: MType, code: string): string {
  if (isRefT(t)) {
    return "ORIN_SLOT(" + code + ")";
  }
  if (isFloatT(t)) {
    return "orin_f2s(" + code + ")";
  }
  return "((uint64_t)(" + code + "))";
}

function sanitize(name: string): string {
  let out = "";
  let start: usize = 0;
  let i: usize = 0;
  while (i < name.length) {
    const c = name.charCodeAt(i);
    const ok = (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122);
    if (!ok) {
      out += name.substring(start, i);
      out += "_";
      start = i + 1;
    }
    i += 1;
  }
  out += name.substring(start, name.length);
  return out;
}

function commentSafe(name: string): string {
  let out = "";
  let i: usize = 0;
  while (i < name.length) {
    if (name.charCodeAt(i) == 42 && i + 1 < name.length && name.charCodeAt(i + 1) == 47) {
      out += "* /";
      i += 2;
    } else {
      out += name.charAt(i);
      i += 1;
    }
  }
  return out;
}

function cString(s: string): string {
  let out = "\"";
  let start: usize = 0;
  let i: usize = 0;
  while (i < s.length) {
    const c = s.charCodeAt(i);
    let esc = "";
    if (c == 34) {
      esc = "\\\"";
    } else if (c == 92) {
      esc = "\\\\";
    } else if (c == 63) {
      esc = "\\?";
    } else if (c < 32 || c > 126) {
      esc = "\\" + (c / 64).toString() + ((c / 8) % 8).toString() + (c % 8).toString();
    }
    if (esc.length > 0) {
      out += s.substring(start, i);
      out += esc;
      start = i + 1;
    }
    i += 1;
  }
  out += s.substring(start, s.length);
  out += "\"";
  return out;
}

// ---------------------------------------------------------------- operands

function lname(i: usize): string {
  return "l" + u(i);
}

function opTy(fx: Fx, o: Operand): MType {
  return match (o) {
    OLocal(l) => fx.f.locals[l].ty,
    OInt(_) => MInt,
    OUsize(_) => MUsize,
    OBool(_) => MBool,
    OFloat(_) => MFloat,
    OStr(_) => MRef
  };
}

function intCode(v: int): string {
  if (v == -9223372036854775807 - 1) {
    return "INT64_MIN";
  }
  return "((int64_t)" + v.toString() + "LL)";
}

function opC(o: Operand): string {
  return match (o) {
    OLocal(l) => lname(l),
    OInt(v) => intCode(v),
    OUsize(v) => "((uint64_t)" + v.toString() + "ULL)",
    OBool(b) => b ? "1" : "0",
    OFloat(t) => "(" + t + ")",
    OStr(i) => "orin_s" + u(i)
  };
}

function slotOf(fx: Fx, o: Operand): string {
  return toSlot(opTy(fx, o), opC(o));
}

function maskOf(fx: Fx, os: Operand[]): usize {
  let m: usize = 0;
  let p: usize = 1;
  let i: usize = 0;
  while (i < os.length) {
    if (isRefT(opTy(fx, os[i]))) {
      m += p;
    }
    if (i < 63) {
      p *= 2;
    }
    i += 1;
  }
  return m;
}

// ---------------------------------------------------------------- operators and builtins

function arith(op: BinOp, usz: bool, a: string, b: string): string {
  const suffix = usz ? "u" : "i";
  const name = match (op) {
    OpAdd => "add",
    OpSub => "sub",
    OpMul => "mul",
    OpDiv => "div",
    OpRem => "rem",
    _ => "?"
  };
  return "orin_" + name + "_" + suffix + "(" + a + ", " + b + ")";
}

// IEEE arithmetic on doubles: plain C operators, no traps.
function floatArith(op: BinOp, a: string, b: string): string {
  const s = match (op) {
    OpAdd => "+",
    OpSub => "-",
    OpMul => "*",
    _ => "/"
  };
  return "(" + a + " " + s + " " + b + ")";
}

function binaryC(op: BinOp, ref: bool, usz: bool, flt: bool, a: string, b: string): string {
  return match (op) {
    OpAdd => flt ? floatArith(op, a, b) : arith(op, usz, a, b),
    OpSub => flt ? floatArith(op, a, b) : arith(op, usz, a, b),
    OpMul => flt ? floatArith(op, a, b) : arith(op, usz, a, b),
    OpDiv => flt ? floatArith(op, a, b) : arith(op, usz, a, b),
    OpRem => arith(op, usz, a, b),
    OpEq => ref ? "orin_str_eq(" + a + ", " + b + ")" : "(" + a + " == " + b + ")",
    OpNe => ref ? "(!orin_str_eq(" + a + ", " + b + "))" : "(" + a + " != " + b + ")",
    OpLt => "(" + a + " < " + b + ")",
    OpLe => "(" + a + " <= " + b + ")",
    OpGt => "(" + a + " > " + b + ")",
    OpGe => "(" + a + " >= " + b + ")",
    OpAnd => "(" + a + " && " + b + ")",
    OpOr => "(" + a + " || " + b + ")"
  };
}

function c1(f: string, a: string[]): string {
  return f + "(" + a[0] + ")";
}

function c2(f: string, a: string[]): string {
  return f + "(" + a[0] + ", " + a[1] + ")";
}

function c3(f: string, a: string[]): string {
  return f + "(" + a[0] + ", " + a[1] + ", " + a[2] + ")";
}

// C expression for a builtin whose result is a fresh Owned ref or a scalar. `rt` is the type of
// the destination (MVoid when there is none).
function builtinC(op: Builtin, a: string[], rt: MType): string {
  return match (op) {
    BConsoleLog => c1("orin_console_log", a),
    BConsoleError => c1("orin_console_error", a),
    BStringFromCharCode => c1("orin_string_from_char_code", a),
    BParseInt => c1("orin_parse_int", a),
    BFsReadFile => c2("orin_fs_read_file", a),
    BFsWriteFile => c3("orin_fs_write_file", a),
    BFsExists => c2("orin_fs_exists", a),
    BProcessArgs => c1("orin_process_args", a),
    BProcessExit => c1("orin_process_exit", a),
    BIoReadBytes => c2("orin_io_read_bytes", a),
    BIoReadLine => c1("orin_io_read_line", a),
    BIoWriteStdout => c2("orin_io_write_stdout", a),
    BIoShell => c2("orin_io_shell", a),
    BTimeNowMillis => c1("orin_time_now_millis", a),
    BGrantFs => c1("orin_cap_fs", a),
    BGrantProcess => c1("orin_cap_process", a),
    BGrantStdio => c1("orin_cap_stdio", a),
    BGrantClock => c1("orin_cap_clock", a),
    BGrantUnder => c2("orin_cap_under", a),
    BGrantReadOnly => c1("orin_cap_read_only", a),
    BGrantArgsOnly => c1("orin_cap_args_only", a),
    BGrantRevoke => c1("orin_cap_revoke", a),
    BFileOpen => c3("orin_file_open", a),
    BFileIsOpen => c1("orin_file_is_open", a),
    BFileOpenError => c1("orin_file_open_error", a),
    BFileClose => c1("orin_file_close", a),
    BFileReadLine => c1("orin_file_read_line", a),
    BFileRead => c2("orin_file_read", a),
    BFileReadAll => c1("orin_file_read_all", a),
    BFileWrite => c2("orin_file_write", a),
    BFileWriteLine => c2("orin_file_write_line", a),
    BFileFlush => c1("orin_file_flush", a),
    BStrLength => c1("orin_str_len", a),
    BStrCharCodeAt => c2("orin_str_char_code_at", a),
    BStrCharAt => c2("orin_str_char_at", a),
    BStrSubstring => c3("orin_str_substring", a),
    BStrIndexOf => c2("orin_str_index_of", a),
    BStrIncludes => c2("orin_str_includes", a),
    BStrStartsWith => c2("orin_str_starts_with", a),
    BStrEndsWith => c2("orin_str_ends_with", a),
    BStrSplit => c2("orin_str_split", a),
    BStrTrim => c1("orin_str_trim", a),
    BArrLength => c1("orin_array_len", a),
    BArrGet => c2("orin_array_get", a),
    BArrSlice => c3("orin_array_slice", a),
    BArrConcat => c2("orin_array_concat", a),
    BArrJoin => c2("orin_array_join", a),
    BIntToString => c1("orin_int_to_string", a),
    BIntToUsize => c1("orin_int_to_usize", a),
    BUsizeToString => c1("orin_usize_to_string", a),
    BUsizeToInt => c1("orin_usize_to_int", a),
    BBoolToString => c1("orin_bool_to_string", a),
    BOptIsSome => "(orin_tag(" + a[0] + ") == 0)",
    BOptIsNone => "(orin_tag(" + a[0] + ") == 1)",
    BResIsOk => "(orin_tag(" + a[0] + ") == 0)",
    BResIsErr => "(orin_tag(" + a[0] + ") == 1)",
    BOptUnwrap => dupIf(rt, fromSlot(rt, c1("orin_opt_unwrap", a))),
    BOptUnwrapOr => dupIf(rt, "(orin_tag(" + a[0] + ") == 0 ? " + fromSlot(rt, "orin_struct_get(" + a[0] + ", 0)") + " : " + a[1] + ")"),
    BResUnwrap => dupIf(rt, fromSlot(rt, c1("orin_res_unwrap", a))),
    BResUnwrapErr => dupIf(rt, fromSlot(rt, c1("orin_res_unwrap_err", a))),
    BParseFloat => c1("orin_parse_float", a),
    BFloatToString => c1("orin_float_to_string", a),
    BF32ToString => c1("orin_f32_to_string", a),
    BIntToFloat => "((double)(" + a[0] + "))",
    BUsizeToFloat => "((double)(" + a[0] + "))",
    BFloatToInt => c1("orin_float_to_int", a),
    BF32Round => "((double)(float)(" + a[0] + "))",
    BF32ToFloat => "(" + a[0] + ")",
    BFloatFloor => c1("__builtin_floor", a),
    BFloatCeil => c1("__builtin_ceil", a),
    BFloatRound => c1("__builtin_round", a),
    BFloatSqrt => c1("__builtin_sqrt", a),
    BFloatAbs => c1("__builtin_fabs", a),
    BFloatPow => c2("__builtin_pow", a),
    BFloatIsNaN => "((int64_t)(!!__builtin_isnan(" + a[0] + ")))",
    BFloatIsFinite => "((int64_t)(!!__builtin_isfinite(" + a[0] + ")))",
    BIntRange => c3("orin_range_i", a),
    BIntConv => c3("orin_conv_i", a),
    BUIntConv => c2("orin_conv_u", a),
    BIntId => "(" + a[0] + ")",
    BIntOp => "orin_int_op(" + a[0] + ", " + a[1] + ", " + a[2] + ", " + a[3] + ")",
    BIntChk => "orin_int_chk(" + a[0] + ", " + a[1] + ", " + a[2] + ", " + a[3] + ")",
    BParseIntK => c2("orin_parse_int_k", a)
  };
}

// Builtins that return a borrowed slot are retained: the MIR result is Owned.
function dupIf(rt: MType, code: string): string {
  if (isRefT(rt)) {
    return "orin_dup(" + code + ")";
  }
  return code;
}

// ---------------------------------------------------------------- instructions

function argsC(os: Operand[]): string[] {
  let out: string[] = [];
  for (const o of os) {
    out.push(opC(o));
  }
  return out;
}

function instrC(fx: Fx, i: Instr): string {
  return match (i) {
    ICopy(d, o) => lname(d) + " = " + opC(o) + ";",
    IMove(d, s) => lname(d) + " = " + lname(s) + ";",
    IBorrow(d, s) => lname(d) + " = " + lname(s) + ";",
    IDup(d, o) => lname(d) + " = orin_dup(" + opC(o) + ");",
    IRelease(x) => "orin_release(" + lname(x) + ");",
    IUnary(d, op, o) => lname(d) + " = " + unaryC(op, isUsizeT(fx.f.locals[d].ty), isFloatT(fx.f.locals[d].ty), opC(o)) + ";",
    IBinary(d, op, a, b) => lname(d) + " = " + binaryC(op, isRefT(opTy(fx, a)), isUsizeT(opTy(fx, a)), isFloatT(opTy(fx, a)), opC(a), opC(b)) + ";",
    ICall(d, f, args) => callC(fx, d, f, args),
    IBuiltin(d, b, args) => builtinInstr(fx, d, b, args),
    IStrAppend(x, y) => lname(x) + " = orin_str_append(" + lname(x) + ", " + opC(y) + ");",
    IStructNew(d, tag, slots) => structNewC(fx, d, tag, slots),
    INullary(d, t) => lname(d) + " = orin_nullary(" + u(t) + ");",
    ITag(d, o) => lname(d) + " = (int64_t)orin_tag(" + opC(o) + ");",
    IGetField(d, o, k) => lname(d) + " = " + fromSlot(fx.f.locals[d].ty, "orin_struct_get(" + opC(o) + ", " + u(k) + ")") + ";",
    ISetField(x, k, v) => "orin_mir_struct_replace(" + lname(x) + ", " + u(k) + ", " + slotOf(fx, v) + ");",
    ITakeField(d, x, k) => lname(d) + " = ORIN_REF(orin_mir_struct_take(" + lname(x) + ", " + u(k) + "));",
    IPutField(x, k, s) => "orin_struct_set(" + lname(x) + ", " + u(k) + ", ORIN_SLOT(" + lname(s) + "));",
    IMakeUnique(x) => lname(x) + " = orin_make_unique(" + lname(x) + ");",
    IArrayNew(d, r, es) => arrayNewC(fx, d, r, es),
    IArrayGet(d, a, k) => lname(d) + " = " + fromSlot(fx.f.locals[d].ty, "orin_array_at(" + opC(a) + ", " + opC(k) + ")") + ";",
    IArraySet(x, k, v) => "orin_mir_array_replace(" + lname(x) + ", " + opC(k) + ", " + slotOf(fx, v) + ");",
    IArrayTake(d, x, k) => lname(d) + " = ORIN_REF(orin_mir_array_take(" + lname(x) + ", " + opC(k) + "));",
    IArrayPut(x, k, s) => "orin_mir_array_put(" + lname(x) + ", " + opC(k) + ", ORIN_SLOT(" + lname(s) + "));",
    IArrayPush(x, v) => lname(x) + " = orin_mir_array_push(" + lname(x) + ", " + slotOf(fx, v) + ");",
    IArrayPop(d, x) => lname(x) + " = orin_make_unique(" + lname(x) + "); " + lname(d) + " = orin_array_pop(" + lname(x) + ");",
    IClosure(d, f, caps) => closureC(fx, d, f, caps),
    ICallIndirect(d, f, args) => callIndirectC(fx, d, f, args),
    IIface(d, vt, v) => ifaceC(fx, d, vt, v),
    ICallVirtual(d, r, slot, args) => callVirtualC(fx, d, r, slot, args)
  };
}

function unaryC(op: UnOp, usz: bool, flt: bool, a: string): string {
  return match (op) {
    UnNot => "(!" + a + ")",
    UnNeg => flt ? "(-" + a + ")" : (usz ? "orin_neg_u(" + a + ")" : "orin_neg_i(" + a + ")")
  };
}

function callC(fx: Fx, d: Option<usize>, f: usize, args: Operand[]): string {
  const call = fx.names[f] + "(" + argsC(args).join(", ") + ")";
  return match (d) {
    Some(x) => lname(x) + " = " + call + ";",
    None => call + ";"
  };
}

function builtinInstr(fx: Fx, d: Option<usize>, b: Builtin, args: Operand[]): string {
  return match (d) {
    Some(x) => lname(x) + " = " + builtinC(b, argsC(args), fx.f.locals[x].ty) + ";",
    None => builtinC(b, argsC(args), MVoid) + ";"
  };
}

function structNewC(fx: Fx, d: usize, tag: usize, slots: Operand[]): string {
  const n = lname(d);
  let s = n + " = orin_struct_new(" + u(tag) + ", " + u(slots.length) + ", " + u(maskOf(fx, slots)) + "ULL);";
  let k: usize = 0;
  for (const o of slots) {
    s += " orin_struct_init(" + n + ", " + u(k) + ", " + slotOf(fx, o) + ");";
    k += 1;
  }
  return s;
}

function arrayNewC(fx: Fx, d: usize, isRef: bool, es: Operand[]): string {
  const n = lname(d);
  let s = n + " = orin_array_new(" + u(es.length) + ", " + (isRef ? "1" : "0") + ");";
  for (const o of es) {
    s += " orin_array_push(" + n + ", " + slotOf(fx, o) + ");";
  }
  return s;
}

// A closure is a struct `{ code pointer (scalar slot 0), environment (reference slot 1) }`; the
// environment is a struct holding the captured values in order (the immortal nullary object when
// nothing is captured). docs/mir.md v1.3, ADR-0011.
function closureC(fx: Fx, d: usize, f: usize, caps: Operand[]): string {
  const n = lname(d);
  let s = "";
  let env = "orin_nullary(0)";
  if (caps.length > 0) {
    s += "{ OrinObj *env_ = orin_struct_new(0, " + u(caps.length) + ", " + u(maskOf(fx, caps)) + "ULL);";
    let k: usize = 0;
    for (const o of caps) {
      s += " orin_struct_init(env_, " + u(k) + ", " + slotOf(fx, o) + ");";
      k += 1;
    }
    s += " ";
    env = "env_";
  }
  s += n + " = orin_struct_new(0, 2, 2ULL); orin_struct_init(" + n + ", 0, (uint64_t)(uintptr_t)&" + fx.names[f]
    + "); orin_struct_init(" + n + ", 1, ORIN_SLOT(" + env + "));";
  if (caps.length > 0) {
    s += " }";
  }
  return s;
}

// Call through a closure: the code pointer is cast to the C type implied by the operand and
// destination types (environment first).
function callIndirectC(fx: Fx, d: Option<usize>, f: Operand, args: Operand[]): string {
  const c = opC(f);
  const rt = match (d) {
    Some(x) => cty(fx.f.locals[x].ty),
    None => "void"
  };
  let sig = rt + " (*)(OrinObj *";
  let cargs: string[] = ["ORIN_REF(orin_struct_get(" + c + ", 1))"];
  for (const a of args) {
    sig += ", " + cty(opTy(fx, a));
    cargs.push(opC(a));
  }
  sig += ")";
  const call = "((" + sig + ")(uintptr_t)orin_struct_get(" + c + ", 0))(" + cargs.join(", ") + ")";
  return match (d) {
    Some(x) => lname(x) + " = " + call + ";",
    None => call + ";"
  };
}

// An interface value (docs/mir.md v1.5, ADR-0019): a struct `{ vtable pointer (scalar slot 0), boxed value
// (reference slot 1) }`; the vtable is the static table `orin_vtN`.
function ifaceC(fx: Fx, d: usize, vt: usize, v: Operand): string {
  const n = lname(d);
  return n + " = orin_struct_new(0, 2, 2ULL); orin_struct_init(" + n + ", 0, (uint64_t)(uintptr_t)orin_vt" + u(vt)
    + "); orin_struct_init(" + n + ", 1, " + slotOf(fx, v) + ");";
}

// Call through the vtable of an interface value: entry `slot`, cast to the C type implied by the operand
// and destination types (the boxed value first).
function callVirtualC(fx: Fx, d: Option<usize>, r: Operand, slot: usize, args: Operand[]): string {
  const c = opC(r);
  const rt = match (d) {
    Some(x) => cty(fx.f.locals[x].ty),
    None => "void"
  };
  let sig = rt + " (*)(OrinObj *";
  let cargs: string[] = ["ORIN_REF(orin_struct_get(" + c + ", 1))"];
  for (const a of args) {
    sig += ", " + cty(opTy(fx, a));
    cargs.push(opC(a));
  }
  sig += ")";
  const call = "((" + sig + ")(((void *const *)(uintptr_t)orin_struct_get(" + c + ", 0))[" + u(slot) + "]))(" + cargs.join(", ") + ")";
  return match (d) {
    Some(x) => lname(x) + " = " + call + ";",
    None => call + ";"
  };
}

function termC(fx: Fx, t: Terminator): string {
  return match (t) {
    TGoto(b) => "goto B" + u(b) + ";",
    TBranch(c, a, b) => "if (" + opC(c) + ") goto B" + u(a) + "; else goto B" + u(b) + ";",
    TSwitch(o, cases, d) => switchC(o, cases, d),
    TReturn(o) => match (o) {
      Some(x) => "return " + opC(x) + ";",
      None => "return;"
    },
    TTrap(m) => "orin_trap(" + cString(m) + ");"
  };
}

function switchC(o: Operand, cases: SwitchCase[], d: usize): string {
  let s = "switch (" + opC(o) + ") {";
  for (const k of cases) {
    s += " case " + k.value.toString() + ": goto B" + u(k.target) + ";";
  }
  s += " default: goto B" + u(d) + "; }";
  return s;
}

// ---------------------------------------------------------------- functions

// `@Inline` (ADR-0024) becomes `static inline`: a hint the C compiler may ignore, so semantics and
// link behaviour (one translation unit) are unchanged.
function signature(name: string, f: MFunction, inl: bool): string {
  let s = (inl ? "static inline " : "") + cty(f.ret) + " " + name + "(";
  if (f.paramCount == 0) {
    s += "void";
  }
  let i: usize = 0;
  while (i < f.paramCount) {
    if (i > 0) {
      s += ", ";
    }
    s += cty(f.locals[i].ty) + " " + lname(i);
    i += 1;
  }
  s += ")";
  return s;
}

function genFunction(fx: Fx, sig: string): string {
  const f = fx.f;
  let out: string[] = [];
  out.push(sig + " {\n");
  let i = f.paramCount;
  while (i < f.locals.length) {
    const l = f.locals[i];
    const init = isRefT(l.ty) ? "NULL" : "0";
    out.push("  " + cty(l.ty) + " " + lname(i) + " = " + init + "; /* " + commentSafe(l.name) + " */\n");
    i += 1;
  }
  let b: usize = 0;
  for (const blk of f.blocks) {
    out.push("B" + u(b) + ":;\n");
    for (const ins of blk.instrs) {
      out.push("  " + instrC(fx, ins) + "\n");
    }
    out.push("  " + termC(fx, blk.term) + "\n");
    b += 1;
  }
  out.push("}\n");
  return out.join("");
}

function usesFloat(prog: MProgram): bool {
  for (const f of prog.functions) {
    for (const l of f.locals) {
      if (isFloatT(l.ty)) {
        return true;
      }
    }
  }
  return false;
}

export function emitC(prog: MProgram): string {
  let names: string[] = [];
  let i: usize = 0;
  for (const f of prog.functions) {
    names.push("orin_fn_" + u(i) + "_" + sanitize(f.name));
    i += 1;
  }
  let sigs: string[] = [];
  i = 0;
  while (i < prog.functions.length) {
    sigs.push(signature(names[i], prog.functions[i], isInlineFn(prog, prog.functions[i].name)));
    i += 1;
  }
  let out: string[] = [];
  out.push("/* Generated by orinc (Orin Stage 1, MIR backend). Do not edit. */\n#include \"orin_runtime.h\"\n#include \"orin_runtime_mir.h\"\n#include \"orin_runtime_io.h\"\n\n");
  if (usesFloat(prog)) {
    // Programs with floats: no fused multiply-add (bit-identical results across backends); link with -lm.
    out.push("#pragma STDC FP_CONTRACT OFF\n\n");
  }
  i = 0;
  while (i < prog.strings.length) {
    const s = prog.strings[i];
    out.push("ORIN_STRING_LIT(orin_s" + u(i) + ", " + s.length.toString() + ", " + cString(s) + ");\n");
    i += 1;
  }
  out.push("\n");
  for (const sg of sigs) {
    out.push(sg + ";\n");
  }
  out.push("\n");
  i = 0;
  while (i < prog.vtables.length) {
    let fs: string[] = [];
    for (const g of prog.vtables[i].funcs) {
      fs.push("(void *)&" + names[g]);
    }
    if (fs.length == 0) {
      fs.push("NULL");
    }
    out.push("static void *const orin_vt" + u(i) + "[] = { " + fs.join(", ") + " }; /* " + commentSafe(prog.vtables[i].name) + " */\n");
    i += 1;
  }
  out.push("\n");
  i = 0;
  while (i < prog.functions.length) {
    const fx = Fx { prog: prog, f: prog.functions[i], names: names };
    out.push(genFunction(fx, sigs[i]));
    out.push("\n");
    i += 1;
  }
  // `main(host: Host)` (ADR-0027) receives the runtime-created root grant; `main()` receives nothing.
  const hostArg = prog.functions[prog.main].paramCount == 1 ? "orin_cap_host_root()" : "";
  out.push("int main(int argc, char **argv) {\n  orin_init(argc, argv);\n  " + names[prog.main]
    + "(" + hostArg + ");\n  orin_flush();\n  return 0;\n}\n");
  return out.join("");
}
