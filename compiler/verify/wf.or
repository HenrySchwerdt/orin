// Well-formedness of MIR (docs/mir.md "Execution model"): index ranges and operand classes. The
// ownership rules in rules.or assume every function passed this check, so they never index out
// of range. Each check returns an error message, or "" when the item is well-formed.

import { MProgram, MFunction, MType, Operand, Instr, Terminator, SwitchCase } from "../mir";
import { UnOp, BinOp, Builtin } from "../hir";

// Operand/local classes.
export const CInt: int = 0;
export const CUsize: int = 1;
export const CBool: int = 2;
export const CRef: int = 3;
export const CVoid: int = 4;
export const CFloat: int = 5;
export const CHandle: int = 6;   // resource handle (v1.8, ADR-0025)

export function tyClass(t: MType): int {
  return match (t) {
    MInt => 0,
    MUsize => 1,
    MBool => 2,
    MFloat => 5,
    MHandle => 6,
    MRef => 3,
    MVoid => 4
  };
}

// Class of a local; callers have checked the index.
export function localClass(f: MFunction, l: usize): int {
  return tyClass(f.locals[l].ty);
}

// Class of a well-formed operand.
export function opClass(f: MFunction, o: Operand): int {
  return match (o) {
    OLocal(l) => localClass(f, l),
    OInt(_) => 0,
    OUsize(_) => 1,
    OBool(_) => 2,
    OFloat(_) => 5,
    OStr(_) => 3
  };
}

function opOk(p: MProgram, f: MFunction, o: Operand): bool {
  return match (o) {
    OLocal(l) => l < f.locals.length,
    OInt(_) => true,
    OUsize(_) => true,   // the 64-bit pattern: a negative int is a value above 2^63-1 (u64 literals, ADR-0022)
    OBool(_) => true,
    OFloat(t) => t.length > 0,
    OStr(i) => i < p.strings.length
  };
}

function isLocal(o: Operand, l: usize): bool {
  return match (o) {
    OLocal(m) => m == l,
    _ => false
  };
}

// Operand of class handle (a resource handle may only be an argument of a call, see handleMsg).
function isHandleOp(f: MFunction, o: Operand): bool {
  return match (o) {
    OLocal(l) => l < f.locals.length && localClass(f, l) == CHandle,
    _ => false
  };
}

// None of `os` is a resource handle (a handle is never stored, captured or boxed).
function noHandles(f: MFunction, os: Operand[]): bool {
  for (const o of os) {
    if (isHandleOp(f, o)) {
      return false;
    }
  }
  return true;
}

function opsOk(p: MProgram, f: MFunction, os: Operand[]): bool {
  for (const o of os) {
    if (!opOk(p, f, o)) {
      return false;
    }
  }
  return true;
}

// local `l` is in range and has class `c`
function isCls(f: MFunction, l: usize, c: int): bool {
  return l < f.locals.length && localClass(f, l) == c;
}

// operand is well-formed and has class `c`
function opIs(p: MProgram, f: MFunction, o: Operand, c: int): bool {
  return opOk(p, f, o) && opClass(f, o) == c;
}

function constsOk(p: MProgram, f: MFunction, os: Operand[], isRef: bool): bool {
  for (const o of os) {
    if (!opOk(p, f, o) || (opClass(f, o) == CRef) != isRef || opClass(f, o) == CHandle) {
      return false;
    }
  }
  return true;
}

// Operand that is a *local* of class ref (OStr is not an object that can be indexed/mutated).
function refLocalOp(f: MFunction, o: Operand): bool {
  return match (o) {
    OLocal(l) => isCls(f, l, CRef),
    _ => false
  };
}

function binOk(f: MFunction, op: BinOp, d: usize, a: Operand, b: Operand): bool {
  const ca = opClass(f, a);
  const cb = opClass(f, b);
  const cd = localClass(f, d);
  return match (op) {
    OpAdd => ca == cb && (ca == CInt || ca == CUsize || ca == CFloat) && cd == ca,
    OpSub => ca == cb && (ca == CInt || ca == CUsize || ca == CFloat) && cd == ca,
    OpMul => ca == cb && (ca == CInt || ca == CUsize || ca == CFloat) && cd == ca,
    OpDiv => ca == cb && (ca == CInt || ca == CUsize || ca == CFloat) && cd == ca,
    OpRem => ca == cb && (ca == CInt || ca == CUsize) && cd == ca,
    OpEq => ca == cb && ca != CHandle && cd == CBool,
    OpNe => ca == cb && ca != CHandle && cd == CBool,
    OpLt => ca == cb && (ca == CInt || ca == CUsize || ca == CFloat) && cd == CBool,
    OpLe => ca == cb && (ca == CInt || ca == CUsize || ca == CFloat) && cd == CBool,
    OpGt => ca == cb && (ca == CInt || ca == CUsize || ca == CFloat) && cd == CBool,
    OpGe => ca == cb && (ca == CInt || ca == CUsize || ca == CFloat) && cd == CBool,
    OpAnd => ca == CBool && cb == CBool && cd == CBool,
    OpOr => ca == CBool && cb == CBool && cd == CBool
  };
}

function unOk(f: MFunction, op: UnOp, d: usize, a: Operand): bool {
  const c = match (op) {
    UnNot => CBool,
    UnNeg => opClass(f, a) == CFloat ? CFloat : CInt
  };
  return opClass(f, a) == c && localClass(f, d) == c;
}

function callMsg(p: MProgram, f: MFunction, dst: Option<usize>, fi: usize, args: Operand[]): string {
  if (fi >= p.functions.length) {
    return "ICall: function index out of range";
  }
  const g = p.functions[fi];
  if (args.length != g.paramCount) {
    return "ICall: wrong number of arguments for " + g.name;
  }
  if (!opsOk(p, f, args)) {
    return "ICall: bad operand";
  }
  let i: usize = 0;
  while (i < args.length) {
    if (opClass(f, args[i]) != localClass(g, i)) {
      return "ICall: argument " + i.toString() + " has the wrong class";
    }
    i += 1;
  }
  const rc = tyClass(g.ret);
  return match (dst) {
    None => "",
    Some(d) => {
      if (d >= f.locals.length) {
        return "ICall: destination out of range";
      }
      if (rc == CVoid || localClass(f, d) != rc) {
        return "ICall: destination class does not match the callee's return type";
      }
      return "";
    }
  };
}

// IClosure: the lifted function takes the environment record first (a reference) and has only
// borrowed parameters (an indirect call cannot honour owned-parameter modes).
function closureMsg(p: MProgram, f: MFunction, d: usize, fi: usize, caps: Operand[]): string {
  if (!isCls(f, d, CRef)) {
    return "IClosure: the destination must be a reference local";
  }
  if (fi >= p.functions.length) {
    return "IClosure: function index out of range";
  }
  const g = p.functions[fi];
  if (g.paramCount == 0 || tyClass(g.locals[0].ty) != CRef) {
    return "IClosure: the lifted function must take the environment record as its first parameter";
  }
  for (const o of g.paramOwned) {
    if (o) {
      return "IClosure: the lifted function " + g.name + " must have only borrowed parameters";
    }
  }
  if (!noHandles(f, caps)) {
    return "IClosure: a resource handle cannot be captured";
  }
  return opsOk(p, f, caps) ? "" : "IClosure: bad capture operand";
}

function optDstOk(f: MFunction, dst: Option<usize>): bool {
  return match (dst) {
    None => true,
    Some(d) => d < f.locals.length
  };
}

// Both locals in range and of class ref, and distinct.
function refPair(f: MFunction, a: usize, b: usize): bool {
  return isCls(f, a, CRef) && isCls(f, b, CRef) && a != b;
}

// `v` (a consumed/stored operand) must be well-formed and not the object being written.
function valueOk(p: MProgram, f: MFunction, x: usize, v: Operand): bool {
  return opOk(p, f, v) && !isLocal(v, x) && !isHandleOp(f, v);
}

// ---- resource handles (v1.8, ADR-0025): the structural half of the rules (the dataflow half is in rules.or) ----

// Builtins that take a handle as their first argument (every file builtin but the one that creates handles).
function takesHandle(b: Builtin): bool {
  return match (b) {
    BFileIsOpen => true,
    BFileOpenError => true,
    BFileClose => true,
    BFileReadLine => true,
    BFileRead => true,
    BFileReadAll => true,
    BFileWrite => true,
    BFileWriteLine => true,
    BFileFlush => true,
    _ => false
  };
}

function isOpenB(b: Builtin): bool {
  return match (b) { BFileOpen => true, _ => false };
}

// The destination local an instruction defines, if any.
function dstOf(ins: Instr): Option<usize> {
  return match (ins) {
    ICopy(d, _) => Some(d),
    IMove(d, _) => Some(d),
    IBorrow(d, _) => Some(d),
    IDup(d, _) => Some(d),
    IUnary(d, _, _) => Some(d),
    IBinary(d, _, _, _) => Some(d),
    ICall(dst, _, _) => dst,
    IBuiltin(dst, _, _) => dst,
    IStructNew(d, _, _) => Some(d),
    INullary(d, _) => Some(d),
    ITag(d, _) => Some(d),
    IGetField(d, _, _) => Some(d),
    ITakeField(d, _, _) => Some(d),
    IArrayNew(d, _, _) => Some(d),
    IArrayGet(d, _, _) => Some(d),
    IArrayTake(d, _, _) => Some(d),
    IArrayPop(d, _) => Some(d),
    IClosure(d, _, _) => Some(d),
    ICallIndirect(dst, _, _) => dst,
    IIface(d, _, _) => Some(d),
    ICallVirtual(dst, _, _, _) => dst,
    _ => None
  };
}

// First violated handle rule of `ins` ("" if none). Runs after the other structural checks, so every index is in range.
//   * a handle local is defined only by IBuiltin(Some(h), BFileOpen, ..): never by a copy, move, borrow, call result,
//     field/element read, arithmetic ...;
//   * BFileOpen defines exactly a handle; the other file builtins take a handle as first argument and non-handles
//     after it; no other builtin sees a handle (no conversion, comparison or printing of one);
//   * handles are not compared (IBinary), not stored/captured/boxed (the slot/value checks above), not returned.
function handleMsg(f: MFunction, ins: Instr): string {
  match (dstOf(ins)) {
    Some(d) => {
      if (localClass(f, d) == CHandle) {
        match (ins) {
          IBuiltin(_dst, b, _args) => {
            if (!isOpenB(b)) {
              return "IBuiltin: only BFileOpen may define a resource handle";
            }
          },
          _ => { return "a resource handle is defined only by BFileOpen (it cannot be copied, moved, borrowed, read from a field or returned by a call)"; }
        }
      }
    },
    None => {}
  }
  match (ins) {
    IBuiltin(dst, b, args) => {
      if (isOpenB(b)) {
        if (!noHandles(f, args)) { return "BFileOpen: arguments cannot be resource handles"; }
        match (dst) {
          Some(d) => { return localClass(f, d) == CHandle ? "" : "BFileOpen: the destination must be a handle local"; },
          None => { return "BFileOpen: the handle must be bound to a local (it would never be closed)"; }
        }
      }
      if (takesHandle(b)) {
        if (args.length == 0 || !isHandleOp(f, args[0])) { return "file builtin: the first argument must be a resource handle"; }
        let i: usize = 1;
        while (i < args.length) {
          if (isHandleOp(f, args[i])) { return "file builtin: only the first argument can be a resource handle"; }
          i += 1;
        }
        return "";
      }
      return noHandles(f, args) ? "" : "a resource handle can only be passed to calls and file builtins";
    },
    _ => { return ""; }
  }
}

export function wfInstr(p: MProgram, f: MFunction, ins: Instr): string {
  const base = wfInstrBase(p, f, ins);
  if (base != "") {
    return base;
  }
  return handleMsg(f, ins);
}

function wfInstrBase(p: MProgram, f: MFunction, ins: Instr): string {
  return match (ins) {
    ICopy(d, o) => {
      if (d >= f.locals.length || !opOk(p, f, o)) { return "ICopy: bad local or operand"; }
      if (opClass(f, o) != localClass(f, d)) { return "ICopy: operand and destination classes differ"; }
      if (localClass(f, d) == CHandle) { return "ICopy of a resource handle (handles are never copied)"; }
      if (localClass(f, d) == CRef && !isStr(o)) { return "ICopy of a reference local (use IMove/IDup/IBorrow)"; }
      return "";
    },
    IMove(d, s) => refPair(f, d, s) ? "" : "IMove: needs two distinct reference locals",
    IBorrow(d, s) => refPair(f, d, s) ? "" : "IBorrow: needs two distinct reference locals",
    IDup(d, o) => (isCls(f, d, CRef) && opIs(p, f, o, CRef)) ? "" : "IDup: needs a reference destination and operand",
    IRelease(x) => isCls(f, x, CRef) ? "" : "IRelease: needs a reference local",
    IUnary(d, op, o) => (d < f.locals.length && opOk(p, f, o) && unOk(f, op, d, o)) ? "" : "IUnary: operand class mismatch",
    IBinary(d, op, a, b) => {
      if (d < f.locals.length && opOk(p, f, a) && opOk(p, f, b) && binOk(f, op, d, a, b)) { return ""; }
      return "IBinary: operand class mismatch";
    },
    ICall(dst, fi, args) => callMsg(p, f, dst, fi, args),
    IBuiltin(dst, _, args) => (optDstOk(f, dst) && opsOk(p, f, args)) ? "" : "IBuiltin: bad local or operand",
    IStrAppend(x, y) => {
      if (!isCls(f, x, CRef) || !opIs(p, f, y, CRef)) { return "IStrAppend: needs reference operands"; }
      return isLocal(y, x) ? "IStrAppend: appending a string to itself" : "";
    },
    IStructNew(d, _, slots) => {
      if (isCls(f, d, CRef) && !noHandles(f, slots)) { return "IStructNew: a resource handle cannot be stored"; }
      return (isCls(f, d, CRef) && opsOk(p, f, slots)) ? "" : "IStructNew: bad destination or slot operand";
    },
    INullary(d, _) => isCls(f, d, CRef) ? "" : "INullary: destination must be a reference local",
    ITag(d, o) => (isCls(f, d, CInt) && opIs(p, f, o, CRef)) ? "" : "ITag: needs an int destination and a reference operand",
    IGetField(d, o, _) => (d < f.locals.length && refLocalOp(f, o)) ? "" : "IGetField: bad destination or object",
    ISetField(x, _, v) => (isCls(f, x, CRef) && valueOk(p, f, x, v)) ? "" : "ISetField: bad object or value",
    ITakeField(d, x, _) => refPair(f, d, x) ? "" : "ITakeField: needs two distinct reference locals",
    IPutField(x, _, s) => refPair(f, x, s) ? "" : "IPutField: needs two distinct reference locals",
    IMakeUnique(x) => isCls(f, x, CRef) ? "" : "IMakeUnique: needs a reference local",
    IArrayNew(d, isRef, elems) => (isCls(f, d, CRef) && constsOk(p, f, elems, isRef)) ? "" : "IArrayNew: bad destination or element class",
    IArrayGet(d, a, i) => (d < f.locals.length && refLocalOp(f, a) && opIs(p, f, i, CUsize)) ? "" : "IArrayGet: bad destination, array or index",
    IArraySet(x, i, v) => (isCls(f, x, CRef) && opIs(p, f, i, CUsize) && valueOk(p, f, x, v)) ? "" : "IArraySet: bad array, index or value",
    IArrayTake(d, x, i) => (refPair(f, d, x) && opIs(p, f, i, CUsize)) ? "" : "IArrayTake: bad destination, array or index",
    IArrayPut(x, i, s) => (refPair(f, x, s) && opIs(p, f, i, CUsize)) ? "" : "IArrayPut: bad array, index or source",
    IArrayPush(x, v) => (isCls(f, x, CRef) && valueOk(p, f, x, v)) ? "" : "IArrayPush: bad array or value",
    IArrayPop(d, x) => refPair(f, d, x) ? "" : "IArrayPop: needs two distinct reference locals",
    IClosure(d, fi, caps) => closureMsg(p, f, d, fi, caps),
    ICallIndirect(dst, c, args) => {
      if (!optDstOk(f, dst) || !opsOk(p, f, args)) { return "ICallIndirect: bad destination or argument"; }
      return refLocalOp(f, c) ? "" : "ICallIndirect: the callee must be a reference local";
    },
    IIface(d, vt, v) => {
      if (!isCls(f, d, CRef)) { return "IIface: the destination must be a reference local"; }
      if (vt >= p.vtables.length) { return "IIface: vtable index out of range"; }
      return opIs(p, f, v, CRef) ? "" : "IIface: the boxed value must be a reference operand";
    },
    ICallVirtual(dst, c, _, args) => {
      if (!optDstOk(f, dst) || !opsOk(p, f, args)) { return "ICallVirtual: bad destination or argument"; }
      return refLocalOp(f, c) ? "" : "ICallVirtual: the interface value must be a reference local";
    }
  };
}

function isStr(o: Operand): bool {
  return match (o) {
    OStr(_) => true,
    _ => false
  };
}

function targetOk(f: MFunction, t: usize): bool {
  return t < f.blocks.length;
}

function casesOk(f: MFunction, cs: SwitchCase[]): bool {
  for (const c of cs) {
    if (!targetOk(f, c.target)) {
      return false;
    }
  }
  return true;
}

export function wfTerm(p: MProgram, f: MFunction, t: Terminator): string {
  return match (t) {
    TGoto(b) => targetOk(f, b) ? "" : "TGoto: block index out of range",
    TBranch(o, a, b) => {
      if (!targetOk(f, a) || !targetOk(f, b)) { return "TBranch: block index out of range"; }
      return opIs(p, f, o, CBool) ? "" : "TBranch: condition must be a bool operand";
    },
    TSwitch(o, cs, d) => {
      if (!targetOk(f, d) || !casesOk(f, cs)) { return "TSwitch: block index out of range"; }
      return opIs(p, f, o, CInt) ? "" : "TSwitch: scrutinee must be an int operand";
    },
    TReturn(r) => {
      const rc = tyClass(f.ret);
      return match (r) {
        None => rc == CVoid ? "" : "TReturn without a value in a non-void function",
        Some(o) => {
          if (rc == CVoid) { return "TReturn with a value in a void function"; }
          return opIs(p, f, o, rc) ? "" : "TReturn: value class does not match the return type";
        }
      };
    },
    TTrap(_) => ""
  };
}

// Function-level checks (first error, "" if fine).
export function wfFunction(f: MFunction): string {
  if (f.paramCount > f.locals.length) { return "paramCount exceeds the number of locals"; }
  if (f.paramOwned.length != f.paramCount) { return "paramOwned length differs from paramCount"; }
  let i: usize = 0;
  while (i < f.paramCount) {
    if (f.paramOwned[i] && tyClass(f.locals[i].ty) != CRef) { return "owned parameter `" + f.locals[i].name + "` is not a reference"; }
    i += 1;
  }
  if (tyClass(f.ret) == CHandle) { return "function returns a resource handle (a handle cannot be returned)"; }
  if (f.blocks.length == 0) { return "function has no blocks"; }
  for (const l of f.locals) {
    if (tyClass(l.ty) == CVoid) { return "local `" + l.name + "` has type void"; }
  }
  return "";
}
