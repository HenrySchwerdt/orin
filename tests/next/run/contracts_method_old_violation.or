// flags: --check-contracts
// exit: 101
// stderr: contract violated: @Ensures(this.n == old(this.n) + 1)
class Counter {
  n: int;

  constructor() {
    this.n = 0;
  }

  @Ensures(this.n == old(this.n) + 1)
  bump(by: int): void {
    this.n += by;
  }
}

function main(): void {
  let c = new Counter();
  c.bump(1);
  console.log(c.n.toString());
  c.bump(2);
  console.log("after");
}
