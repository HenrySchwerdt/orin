// toString: shortest digits that round-trip, JavaScript-like layout
function main(): void {
  console.log((0.1 + 0.2).toString());
  console.log((1.0 / 3.0).toString());
  console.log((2.0 / 3.0).toString());
  console.log((0.1 * 3.0).toString());
  console.log(1e21.toString());
  console.log(1e20.toString());
  console.log(123456789012345680000.0.toString());
  console.log(1.5e21.toString());
  console.log(0.000001.toString());
  console.log(0.0000001.toString());
  console.log(1.5e-7.toString());
  console.log(1e-10.toString());
  console.log(5e-324.toString());
  console.log(1.7976931348623157e308.toString());
  console.log(2.2250738585072014e-308.toString());
  console.log(4.35.toString());
  console.log(0.3.toString());
  console.log(100.0.toString());
  console.log(1234567.0.toString());
  console.log(9007199254740993.0.toString());
  console.log(9007199254740992.0.toString());
  console.log(0.5.toString());
  console.log(123.456.toString());
  console.log(3.141592653589793.toString());
  console.log(2.718281828459045.toString());
  console.log(1e15.toString());
  console.log(1e16.toString());
  console.log(1.25e17.toString());
}
