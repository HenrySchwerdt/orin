// flags: --check-contracts
@Ensures(result == old(a + b))
@Ensures(a >= 0 ==> result >= b)
function add(a: int, b: int): int {
  return a + b;
}

@Requires(xs.length > 0)
@Ensures(result >= 0)
function first(xs: int[]): int {
  return xs[0];
}

function main(): void {
  console.log(add(2, 3).toString());
  console.log(first([4, 5]).toString());
}
