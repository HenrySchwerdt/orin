function show(xs: int[]): string {
  let s = "[";
  let i: usize = 0;
  while (i < xs.length) {
    if (i > 0) { s = s + ","; }
    s = s + xs[i].toString();
    i += 1;
  }
  return s + "]";
}

function main(): void {
  const xs = [1, 2, 3, 4, 5];
  console.log(show(xs.slice(1, 3)));
  console.log(show(xs.slice(0, 0)));
  console.log(show(xs.slice(2, 5)));
  console.log(show(xs.slice(0, 5)));
  const ys = [6, 7];
  console.log(show(xs.concat(ys)));
  console.log(show(ys.concat(xs.slice(0, 1))));
  const e: int[] = [];
  console.log(show(e.concat(ys)));
  console.log(show(xs));
}
