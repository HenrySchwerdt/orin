// flags: --check-contracts
import { Set, OrderedMap, MinHeap } from "std:collections";

type Pt = { x: int; y: int; };

class Job {
  prio: int;
  name: string;
  constructor(prio: int, name: string) {
    this.prio = prio;
    this.name = name;
  }
  equals(other: Job): bool { return this.prio == other.prio; }
  compare(other: Job): int {
    if (this.prio < other.prio) { return -1; }
    if (this.prio > other.prio) { return 1; }
    return 0;
  }
  hash(): usize { return this.prio.toUsize(); }
}

function main(): void {
  let s = new Set<Pt>();
  s.add(Pt { x: 1, y: 2 });
  s.add(Pt { x: 1, y: 2 });
  s.add(Pt { x: 0, y: 5 });
  console.log(s.size().toString());
  console.log(s.has(Pt { x: 0, y: 5 }).toString());

  let m = new OrderedMap<Pt, string>(2);
  m.set(Pt { x: 2, y: 0 }, "c");
  m.set(Pt { x: 1, y: 9 }, "b");
  m.set(Pt { x: 1, y: 3 }, "a");
  console.log(m.values().join(""));
  console.log(m.get(Pt { x: 1, y: 9 }).unwrap());
  console.log(m.floorKey(Pt { x: 1, y: 100 }).unwrap().y.toString());

  let h = new MinHeap<Job>();
  h.push(new Job(3, "c"));
  h.push(new Job(1, "first"));
  h.push(new Job(1, "second"));
  h.push(new Job(2, "b"));
  let out: string[] = [];
  while (!h.isEmpty()) {
    out.push(h.pop().unwrap().name);
  }
  console.log(out.join(","));
}
