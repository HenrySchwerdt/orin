// In-place iterative quicksort (Lomuto partition, pivot = last, explicit range stack) of
// 1,000,000 ints. The array is a local `let`, so writes are in place when it is unique.
function lcg(x: int): int {
  return (x * 1103515245 + 12345) % 2147483648;
}

function sortInts(xs: int[]): int[] {
  let a = xs;
  let stack: usize[] = [];
  stack.push(0);
  stack.push(a.length - 1);
  while (stack.length > 0) {
    const hi = stack.pop().unwrap();
    const lo = stack.pop().unwrap();
    const p = a[hi];
    let i = lo;
    let j = lo;
    while (j < hi) {
      if (a[j] < p) {
        const t = a[i];
        a[i] = a[j];
        a[j] = t;
        i += 1;
      }
      j += 1;
    }
    const t2 = a[i];
    a[i] = a[hi];
    a[hi] = t2;
    if (i > lo + 1) { stack.push(lo); stack.push(i - 1); }
    if (hi > i + 1) { stack.push(i + 1); stack.push(hi); }
  }
  return a;
}

function main(): void {
  let a: int[] = [];
  let x = 42;
  let i = 0;
  while (i < 1000000) {
    x = lcg(x);
    a.push((x / 16) % 1000000);
    i += 1;
  }
  const s = sortInts(a);
  let cs = 0;
  let sorted = 1;
  let k: usize = 0;
  while (k < s.length) {
    cs = (cs * 31 + s[k]) % 1000000007;
    if (k > 0) {
      if (s[k - 1] > s[k]) { sorted = 0; }
    }
    k += 1;
  }
  console.log("sorted " + sorted.toString());
  console.log("checksum " + cs.toString());
}
