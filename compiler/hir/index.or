// Semantic index — shared contract (v1) for tooling (spec 18, ADR-0008). Owned by the lead.
// Produced by the checker alongside the HIR; consumed by compiler/analysis (LSP, MCP, fmt-aware
// refactors). Deterministic: defs in declaration order per unit (units in loader order), refs
// in source order per file.

import { Span } from "../diag";

export type SymbolKind =
  SkFunction | SkRecord | SkUnion | SkVariant | SkAlias | SkConst
  | SkLocal | SkParam | SkField
  | SkInterface;           // interface (ADR-0019); its methods are SkFunction defs with the interface as container

export type SymbolDef = {
  id: usize;               // index into SemanticIndex.defs
  name: string;
  kind: SymbolKind;
  nameSpan: Span;          // span of the defining identifier (rename target)
  declSpan: Span;          // whole declaration
  unit: usize;             // defining unit (index into LoadedProgram.units)
  container: Option<usize>; // enclosing def: function for locals/params, record for fields,
                            // union for variants
  exported: bool;
  detail: string;          // rendered signature or type, e.g. "function f(x: int): bool"
};

// One per resolved identifier occurrence in source (including the import-list names of an
// `import { a } from ...`, which refer to the exported definition, and field names in member
// access / record literals).
export type SymbolRef = { span: Span; def: usize; };

// Type of an expression occurrence (rendered), for hover/inlay hints.
export type TypeAt = { span: Span; ty: string; };

// `class cls implements iface` (ADR-0019): the class def, the interface def and the span of the name in the
// `implements` list. In declaration order (units in loader order, classes in source order).
export type ImplLink = { cls: usize; iface: usize; span: Span; };

export type SemanticIndex = { defs: SymbolDef[]; refs: SymbolRef[]; types: TypeAt[]; impls: ImplLink[]; };
