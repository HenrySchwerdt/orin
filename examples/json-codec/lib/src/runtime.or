// Runtime support of the generated `@Json` codecs (ADR-0046 S6 example). Ordinary Orin code over `std:json`: the generated
// companion modules call these functions, so the generated code stays small and the error messages live in one place.
// Paths in messages look like `$.address.zip` and `$.tags[2]`.
import { Json, JField, JNull, JBool, JNum, JStr, JArr, JObj, field } from "std:json";

// `Json` of `std:json`, under a name that does not clash with the `@Json` annotation.
export type JsonValue = Json;

// ---- encoding ---------------------------------------------------------------------------------------------------

export function jNull(): JsonValue {
  return JNull;
}

export function jInt(n: int): JsonValue {
  return JNum(n);
}

export function jBool(b: bool): JsonValue {
  return JBool(b);
}

export function jStr(s: string): JsonValue {
  return JStr(s);
}

export function jArr(items: JsonValue[]): JsonValue {
  return JArr(items);
}

export function jField(key: string, value: JsonValue): JField {
  return field(key, value);
}

export function jObj(fields: JField[]): JsonValue {
  return JObj(fields);
}

// ---- decoding ---------------------------------------------------------------------------------------------------

function kindOf(j: JsonValue): string {
  return match (j) {
    JNull => "null",
    JBool(b) => "a bool",
    JNum(n) => "an int",
    JStr(s) => "a string",
    JArr(a) => "an array",
    JObj(fs) => "an object",
  };
}

export function isNull(j: JsonValue): bool {
  return match (j) {
    JNull => true,
    _ => false,
  };
}

export function decInt(j: JsonValue, path: string): Result<int, string> {
  return match (j) {
    JNum(n) => Ok(n),
    _ => Err(path + ": expected an int, found " + kindOf(j)),
  };
}

export function decBool(j: JsonValue, path: string): Result<bool, string> {
  return match (j) {
    JBool(b) => Ok(b),
    _ => Err(path + ": expected a bool, found " + kindOf(j)),
  };
}

export function decString(j: JsonValue, path: string): Result<string, string> {
  return match (j) {
    JStr(s) => Ok(s),
    _ => Err(path + ": expected a string, found " + kindOf(j)),
  };
}

export function decArray(j: JsonValue, path: string): Result<JsonValue[], string> {
  return match (j) {
    JArr(a) => Ok(a),
    _ => Err(path + ": expected an array, found " + kindOf(j)),
  };
}

export function decObject(j: JsonValue, path: string): Result<JField[], string> {
  return match (j) {
    JObj(fs) => Ok(fs),
    _ => Err(path + ": expected an object, found " + kindOf(j)),
  };
}

// The value of field `key` (the last one when it is repeated), or None.
export function lookup(fields: JField[], key: string): Option<JsonValue> {
  let i = fields.length;
  while (i > 0) {
    i -= 1;
    if (fields[i].key == key) {
      return Some(fields[i].value);
    }
  }
  return None;
}

export function required(fields: JField[], key: string, path: string): Result<JsonValue, string> {
  const v = lookup(fields, key);
  if (v.isNone()) {
    return Err(path + ": missing field \"" + key + "\"");
  }
  return Ok(v.unwrap());
}

export function indexPath(path: string, i: usize): string {
  return path + "[" + i.toString() + "]";
}
