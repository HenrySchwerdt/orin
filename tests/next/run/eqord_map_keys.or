// `Map` keys are any `Hash` type (ADR-0034): records, unions, `Option`, arrays and classes with `hash`; the scalar key types
// keep their own hash.
type Point = { x: int; y: int; };
type Cell = Empty | Wall | Item(string, int);

class Name {
  text: string;
  constructor(text: string) {
    this.text = text;
  }
  equals(other: Name): bool {
    return this.text.length == other.text.length && this.text.includes(other.text) && other.text.includes(this.text);
  }
  hash(): usize {
    return this.text.length;
  }
}

function main(): void {
  let grid = new Map<Point, string>();
  grid.set(Point { x: 0, y: 0 }, "origin");
  grid.set(Point { x: 1, y: 2 }, "a");
  grid.set(Point { x: 1, y: 2 }, "b");
  console.log(grid.size.toString());
  console.log(grid.get(Point { x: 1, y: 2 }).unwrapOr("-"));
  console.log(grid.has(Point { x: 2, y: 1 }).toString());
  grid.delete(Point { x: 0, y: 0 });
  console.log(grid.size.toString());
  let cells = new Map<Cell, int>();
  cells.set(Empty, 1);
  cells.set(Wall, 2);
  cells.set(Item("key", 3), 3);
  cells.set(Item("key", 4), 4);
  console.log(cells.get(Item("key", 3)).unwrapOr(0).toString());
  console.log(cells.get(Item("key", 5)).unwrapOr(0).toString());
  console.log(cells.get(Wall).unwrapOr(0).toString());
  let paths = new Map<int[], string>();
  paths.set([1, 2], "one-two");
  paths.set([1, 2, 3], "one-two-three");
  console.log(paths.get([1, 2]).unwrapOr("-"));
  console.log(paths.get([1]).unwrapOr("-"));
  let opt = new Map<Option<string>, int>();
  opt.set(None, 0);
  opt.set(Some("a"), 1);
  console.log(opt.get(None).unwrapOr(-1).toString());
  console.log(opt.get(Some("a")).unwrapOr(-1).toString());
  console.log(opt.get(Some("b")).unwrapOr(-1).toString());
  let names = new Map<Name, int>();
  names.set(new Name("ann"), 1);
  names.set(new Name("bob"), 2);
  names.set(new Name("ann"), 3);
  console.log(names.size.toString());
  console.log(names.get(new Name("ann")).unwrapOr(0).toString());
  let counts = new Map<string, int>();
  counts.set("a", 1);
  console.log(counts.get("a").unwrapOr(0).toString());
  let many = new Map<Point, int>();
  let i = 0;
  while (i < 200) {
    many.set(Point { x: i % 20, y: i / 20 }, i);
    i += 1;
  }
  console.log(many.size.toString());
  console.log(many.get(Point { x: 7, y: 9 }).unwrapOr(-1).toString());
}
