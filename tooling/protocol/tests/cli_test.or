import { assertEqString, assertEqBool } from "std:test";
import { parseArgs, usage } from "../src/cli";

@Test
function suiteAndDefaults(): void {
  const p = parseArgs(["lsp"]);
  assertEqBool(p.ok, true, "ok");
  assertEqString(p.options.suite, "lsp", "suite");
  assertEqString(p.options.orin, "", "no --orin: build one");
  assertEqString(p.options.orin2, "build/bootstrap/orin2", "default orin2");
  assertEqString(p.options.root, ".", "default root");
}

@Test
function optionsTakeValues(): void {
  const p = parseArgs(["--orin", "x/orin", "mcp", "--orin2=y/orin2", "--root", "/r"]);
  assertEqBool(p.ok, true, "ok");
  assertEqString(p.options.suite, "mcp", "suite");
  assertEqString(p.options.orin, "x/orin", "--orin");
  assertEqString(p.options.orin2, "y/orin2", "--orin2=");
  assertEqString(p.options.root, "/r", "--root");
}

@Test
function errorsAreReported(): void {
  assertEqBool(parseArgs([]).ok, false, "suite is required");
  assertEqBool(parseArgs(["both"]).ok, false, "unknown suite");
  assertEqBool(parseArgs(["lsp", "mcp"]).ok, false, "two suites");
  assertEqBool(parseArgs(["lsp", "--orin"]).ok, false, "missing value");
  assertEqBool(parseArgs(["lsp", "--orin", "--root"]).ok, false, "option as value");
  assertEqBool(parseArgs(["lsp", "--nope"]).ok, false, "unknown option");
  assertEqString(parseArgs(["lsp", "--nope"]).error, "unrecognized arguments: --nope", "message");
}

@Test
function helpWins(): void {
  const p = parseArgs(["lsp", "-h"]);
  assertEqBool(p.ok && p.options.help, true, "help");
  assertEqBool(usage().startsWith("usage: orin-protocol"), true, "usage");
}
