// flags: --check-contracts
// Template literals inside classes, closures, generic functions, interfaces, match arms, contracts and
// loops; many parts in one literal; building a long string.
interface Named {
  label(): string;
}

class Tag implements Named {
  constructor(private text: string, private n: u16) {}
  label(): string {
    return `<${this.text}:${this.n}>`;
  }
  bump(): void {
    this.n += 1;
  }
}

type Shape = Circle(u32) | Square(u32);

function describe(s: Shape): string {
  return match (s) {
    Circle(r) => `circle r=${r}`,
    Square(w) => `square w=${w} area=${w * w}`
  };
}

function show<T>(label: string, v: T, render: (x: T) => string): string {
  return `${label} = ${render(v)}`;
}

@Requires(n >= 0)
@Ensures(result == `${n}`.length.toI32() || result >= 0)
function digits(n: i32): i32 {
  return `${n}`.length.toI32();
}

function main(): void {
  let t = new Tag("id", 7);
  t.bump();
  console.log(t.label());
  const named: Named = t;
  console.log(`via interface: ${named.label()}`);
  console.log(describe(Circle(5)) + "; " + describe(Square(300)));
  console.log(show<i16>("answer", 42, (x: i16): string => `<${x}>`));
  console.log(show("name", "Ann", (x: string): string => `'${x}'`));
  console.log(digits(12345).toString());

  // closure capturing and building strings
  const prefix = "item";
  const mkItem = (i: u8): string => `${prefix}-${i}`;
  console.log(mkItem(1) + " " + mkItem(255));
  const lines: string[] = [];
  let all = lines;
  for (const i of [1, 2, 3]) {
    all.push(`line ${i} of ${3}`);
  }
  console.log(all.join("|"));

  // many parts in one literal (lowered to appends on a single buffer)
  const a = 1;
  const b: u8 = 2;
  const c: i64 = -3;
  const d = "four";
  console.log(`${a}${b}${c}${d}${a}${b}${c}${d}${a}${b}${c}${d}${a}${b}${c}${d}|${a},${b},${c},${d};${a},${b},${c},${d};${a},${b},${c},${d}`);

  // a long string built by appending template literals
  let long = "";
  let i: u32 = 0;
  while (i < 20000) {
    long += `${i},`;
    i += 1;
  }
  console.log(long.length.toString());
  console.log(long.substring(0, 20));
  let sum: u64 = 0;
  const parts = long.split(",");
  console.log(parts.length.toString());
  for (const p of parts) {
    if (p.length > 0) {
      sum += parseU64(p).unwrap();
    }
  }
  console.log(`${sum}`);
}
