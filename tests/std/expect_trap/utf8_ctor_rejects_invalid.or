// `orin test` must report this test as FAILED (a trap): the constructor of Utf8String validates in every build,
// so the invariant "always valid UTF-8" cannot be bypassed with `new`. tools/test_std.sh expects the failure;
// tools/mutate_std.py uses it to kill the mutant that skips the validation.
import { Utf8String } from "std:utf8";

@Test
function constructorTrapsOnInvalidUtf8(): void {
  const s = new Utf8String("ok\xffnot utf8");
  s.byteLength();
}
