function show(b: bool): void {
  console.log(b.toString());
}

function main(): void {
  console.log((1 + 2 * 3).toString());
  console.log(((1 + 2) * 3).toString());
  console.log((10 - 4 - 3).toString());
  console.log((100 / 10 / 5).toString());
  console.log((2 + 3 * 4 % 5).toString());
  console.log((-2 * 3).toString());
  console.log((2 * -3 + 10).toString());
  console.log((20 - 2 * 3 - 4).toString());
  show(1 + 2 < 4);
  show(1 < 2 == true);
  show(true || false && false);
  show(!false && true);
  show(1 + 1 == 2 && 3 * 3 == 9);
}
