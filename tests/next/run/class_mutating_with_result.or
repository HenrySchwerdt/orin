// A mutating method with a result: the call updates the receiver and yields the value.
class Ids {
  constructor(public next: int) {}
  fresh(): int {
    const id = this.next;
    this.next += 1;
    return id;
  }
  freshName(prefix: string): string {
    return prefix + this.fresh().toString();
  }
}

function main(): void {
  let ids = new Ids(10);
  const a = ids.fresh();
  const b = ids.fresh();
  console.log(a.toString() + " " + b.toString());
  console.log(ids.freshName("v"));
  console.log(ids.freshName("w"));
  console.log((ids.fresh() + ids.fresh()).toString());
  console.log(ids.next.toString());
  let k = 0;
  if (ids.fresh() > 100) {
    k = 1;
  } else if (ids.fresh() > 15) {
    k = 2;
  } else {
    k = 3;
  }
  console.log(k.toString() + " " + ids.next.toString());
}
