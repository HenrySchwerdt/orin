// warns: W0451 W0451 W0451 W0451
// W0451 (ADR-0028): an @Ensures that mentions neither `result` nor (non-static method) `this`. Parameters are
// immutable, so such a clause cannot be violated by the function.
import { exit } from "std:process";

@Ensures(x > 0)
function restatesInput(x: int): int {
  return x;
}

@Ensures(x > 0 && y > 0)
function twoParams(x: int, y: int): void {
}

class Box {
  v: int = 0;

  @Ensures(x > 0)
  set(x: int): void {
    this.v = x;
  }

  // static: no `this`, so only `result` can be observed
  @Ensures(x >= 0)
  static make(x: int): int {
    return x;
  }

  // negatives: mention `result` or `this`
  @Ensures(result == this.v)
  get(): int {
    return this.v;
  }

  @Ensures(this.v == x)
  put(x: int): void {
    this.v = x;
  }
}

@Ensures(result == x)
function observes(x: int): int {
  return x;
}

function main(): void {
  let b = new Box();
  b.set(1);
  console.log((restatesInput(2) + observes(3) + b.get() + Box.make(1)).toString());
  b.put(4);
  twoParams(1, 1);
  exit(0);
}
