// A small SVG writer for report charts. Every string that is data (titles, labels, tooltips) goes through `xmlEscape`; the
// numbers are formatted here; element and attribute names, classes and colours are fixed by the methods. A finished
// chart is a `SvgDoc`, which only this module can build (@Sealed), so the page can embed it without escaping it again
// and without a caller being able to pass in arbitrary markup.
//
// The output is also written as stand-alone `.svg` files; `idPrefix` keeps the ids of several charts embedded in one
// HTML page apart (the stand-alone files use the prefix "").

import { fixed } from "./numfmt";

@Sealed
export type SvgDoc = { xml: string; };

export type Palette = {
  dark: bool; bg: string; border: string; ink: string; ink2: string; grid: string; ref: string;
  s1: string; s2: string; s3: string;
};

// Categorical slots 1-3 of the reference palette (validated adjacent and all-pairs for three series, light and dark).
export function lightPalette(): Palette {
  return Palette { dark: false, bg: "#fcfcfb", border: "#d6d5d0", ink: "#0b0b0b", ink2: "#52514e", grid: "#e4e3df", ref: "#8a8984",
                   s1: "#2a78d6", s2: "#eb6834", s3: "#1baf7a" };
}

export function darkPalette(): Palette {
  return Palette { dark: true, bg: "#1a1a19", border: "#3a3a37", ink: "#f0efec", ink2: "#c3c2b7", grid: "#2f2f2c", ref: "#8a8984",
                   s1: "#3987e5", s2: "#d95926", s3: "#199e70" };
}

const FONT: string = "-apple-system, 'Segoe UI', Helvetica, Arial, sans-serif";

// xml.sax.saxutils.escape: & < > only (strings reach text nodes and double-quoted attribute values built here from
// fixed names, so quotes never need escaping in a text node).
export function xmlEscape(s: string): string {
  let out = "";
  let start: usize = 0;
  let i: usize = 0;
  while (i < s.length) {
    const c = s.charCodeAt(i);
    let rep = "";
    if (c == 38) {
      rep = "&amp;";
    } else if (c == 60) {
      rep = "&lt;";
    } else if (c == 62) {
      rep = "&gt;";
    }
    if (rep.length > 0) {
      out += s.substring(start, i) + rep;
      start = i + 1;
    }
    i += 1;
  }
  return start == 0 ? s : out + s.substring(start, s.length);
}

// The same as xmlEscape plus the quote characters: for a value placed inside an attribute.
export function attrEscape(s: string): string {
  return xmlEscape(s).split("\"").join("&quot;").split("'").join("&#39;");
}

function rules(c: Palette): string {
  return "svg{color-scheme:" + (c.dark ? "dark" : "light") + "}.bg{fill:" + c.bg + ";stroke:" + c.border + "}.t{fill:" + c.ink
    + "}.t2{fill:" + c.ink2 + "}.grid{stroke:" + c.grid + "}.ref{stroke:" + c.ref + "}.s1{stroke:" + c.s1 + ";fill:" + c.s1
    + "}.s2{stroke:" + c.s2 + ";fill:" + c.s2 + "}.s3{stroke:" + c.s3 + ";fill:" + c.s3 + "}.ring{stroke:" + c.bg + "}";
}

// The light surface is explicit, so the chart reads the same on GitHub's light and dark page; a viewer whose system is in
// dark mode gets the dark steps of the same palette (both backgrounds and inks switch together).
function style(): string {
  return "<style>" + rules(lightPalette()) + " text{font-family:" + FONT + "}@media (prefers-color-scheme: dark){"
    + rules(darkPalette()) + "}</style>";
}

export type Pt = { x: float; y: float; };

// "M12.0,3.0 L14.0,5.0 ..." for a polyline
export function pathData(points: Pt[]): string {
  let out = "";
  let k: usize = 0;
  while (k < points.length) {
    if (k > 0) {
      out += " ";
    }
    out += (k == 0 ? "M" : "L") + fixed(points[k].x, 1) + "," + fixed(points[k].y, 1);
    k += 1;
  }
  return out;
}

function dashAttr(dashed: bool): string {
  return dashed ? " stroke-dasharray=\"5 4\"" : "";
}

export class Canvas {
  parts: string[];

  constructor(public width: int, public height: int, parts: string[]) {
    this.parts = parts;
  }

  // text(x, y, s): class `cls` (t | t2), anchor start | middle | end, optional rotation about (x, y)
  text(x: float, y: float, s: string, cls: string, size: int, anchor: string, weight: string, rotate: int): void {
    const tr = rotate != 0 ? " transform=\"rotate(" + rotate.toString() + " " + fixed(x, 1) + " " + fixed(y, 1) + ")\"" : "";
    this.parts.push("<text class=\"" + cls + "\" x=\"" + fixed(x, 1) + "\" y=\"" + fixed(y, 1) + "\" font-size=\"" + size.toString()
      + "\" text-anchor=\"" + anchor + "\" font-weight=\"" + weight + "\"" + tr + ">" + xmlEscape(s) + "</text>");
  }

  // a 1-2 px line; `strokeWidth` is a fixed token such as "1", "1.5" or "2"
  line(cls: string, x1: float, y1: float, x2: float, y2: float, strokeWidth: string, dashed: bool): void {
    this.parts.push("<line class=\"" + cls + "\" x1=\"" + fixed(x1, 1) + "\" y1=\"" + fixed(y1, 1) + "\" x2=\"" + fixed(x2, 1)
      + "\" y2=\"" + fixed(y2, 1) + "\" stroke-width=\"" + strokeWidth + "\"" + dashAttr(dashed) + "/>");
  }

  // a data marker; `tip` is the text of its tooltip (empty: none)
  marker(cls: string, cx: float, cy: float, tip: string): void {
    const head = "<circle class=\"" + cls + " ring\" cx=\"" + fixed(cx, 1) + "\" cy=\"" + fixed(cy, 1) + "\" r=\"4\" stroke-width=\"2\"";
    if (tip.length == 0) {
      this.parts.push(head + "/>");
    } else {
      this.parts.push(head + "><title>" + xmlEscape(tip) + "</title></circle>");
    }
  }

  path(cls: string, d: string, dashed: bool): void {
    this.parts.push("<path class=\"" + cls + "\" d=\"" + d + "\" style=\"fill:none\" stroke-width=\"2\" stroke-linejoin=\"round\" "
      + "stroke-linecap=\"round\"" + dashAttr(dashed) + "/>");
  }

  // The finished document. The title and description are the chart's accessible name and long description.
  finish(): SvgDoc {
    return SvgDoc { xml: this.parts.join("\n") + "\n</svg>\n" };
  }
}

export function newCanvas(width: int, height: int, title: string, desc: string, idPrefix: string): Canvas {
  const w = width.toString();
  const h = height.toString();
  return new Canvas(width, height, [
    "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"" + w + "\" height=\"" + h + "\" viewBox=\"0 0 " + w + " " + h
      + "\" role=\"img\" aria-labelledby=\"" + idPrefix + "title " + idPrefix + "desc\">",
    "<title id=\"" + idPrefix + "title\">" + xmlEscape(title) + "</title><desc id=\"" + idPrefix + "desc\">" + xmlEscape(desc) + "</desc>",
    style(),
    "<rect class=\"bg\" x=\"0.5\" y=\"0.5\" width=\"" + (width - 1).toString() + "\" height=\"" + (height - 1).toString()
      + "\" rx=\"6\" stroke-width=\"1\"/>",
  ]);
}

export function svgText(d: SvgDoc): string {
  return d.xml;
}
