// flags: --check-contracts
type Point = { x: int; y: int; };

@Ensures(result == a || result == b)
function pick<T extends Eq>(a: T, b: T, first: bool): T {
  return first ? a : b;
}

@Ensures(result >= a && result >= b)
function bigger<T extends Ord>(a: T, b: T): T {
  return a >= b ? a : b;
}

class Stack<T extends Eq> {
  items: T[] = [];
  push(x: T): void { this.items.push(x); }
  @Ensures(result == this.items.length > 0)
  hasAny(): bool { return this.items.length > 0; }
  has(x: T): bool {
    for (const y of this.items) {
      if (y == x) { return true; }
    }
    return false;
  }
}

function main(): void {
  console.log(pick(Point { x: 1, y: 2 }, Point { x: 3, y: 4 }, false).x.toString());
  console.log(bigger("pear", "apple"));
  let s = new Stack<Point>();
  s.push(Point { x: 1, y: 1 });
  console.log(s.has(Point { x: 1, y: 1 }).toString());
  console.log(s.has(Point { x: 2, y: 1 }).toString());
}
