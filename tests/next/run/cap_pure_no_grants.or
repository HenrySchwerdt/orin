// Pure calculation (ADR-0021 acceptance test 1): `main()` without `host`, no grant anywhere, no I/O effect other
// than the ambient console output. The OSIG of this program has no PERFORMS_IO edge but Console.Write (tools/clitests.sh osig).
function fib(n: int): int {
  if (n < 2) {
    return n;
  }
  return fib(n - 1) + fib(n - 2);
}

function main(): void {
  console.log(fib(20).toString());
}
