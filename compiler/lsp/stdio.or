// Process stdio for the language server loop (spec 18 §3): the only compiler file that uses
// `std:io`. Stage 0 (Rust, frozen) does not know `std:io`, so tools/bootstrap.sh compiles stage 1
// from a copy of the tree in which this file is replaced by tools/stage0/lsp_stdio.or (a stub
// with the same signatures); every later stage (orin1 onwards) builds the real thing.

import { readBytes, readLine, writeStdout } from "std:io";

export function stdinReadBytes(n: usize): Option<string> {
  return readBytes(n);
}

export function stdinReadLine(): Option<string> {
  return readLine();
}

export function stdoutWrite(s: string): void {
  writeStdout(s);
}
