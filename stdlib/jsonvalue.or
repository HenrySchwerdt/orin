// Opt-in bounded JSON documents. Legacy JSON and exact-number utilities are unchanged.
// Policies, error precedence, allocation and complexity: docs/std-jsonvalue.md.
import { JsonNumber, jsonNumber } from "std:jsonnumber";
import { checkUtf8, encodeCodePoint } from "std:utf8";

export type JsonValue =
  ValueNull
  | ValueBool(bool)
  | ValueNumber(JsonNumber)
  | ValueString(string)
  | ValueArray(JsonValue[])
  | ValueObject(JsonMember[]);
export type JsonMember = { key: string; value: JsonValue; };
export type JsonDuplicatePolicy = RejectDuplicates | PreserveDuplicates;
export type JsonLimits = {
  maxInputBytes: usize;
  maxDepth: usize;
  maxNodes: usize;
  maxContainerItems: usize;
  maxStringBytes: usize;
  maxDecodedStringBytes: usize;
  maxNumberBytes: usize;
  maxOutputBytes: usize;
};
export type JsonReadOptions = { limits: JsonLimits; duplicates: JsonDuplicatePolicy; };
export type JsonValueErrorKind =
  JsonSyntax
  | JsonInvalidUtf8
  | JsonInvalidSurrogate
  | JsonDuplicateKey
  | JsonLimitExceeded
  | JsonInvalidLimits;
export type JsonParseError = {
  kind: JsonValueErrorKind;
  offset: usize;
  line: usize;
  column: usize;
  limit: Option<string>;
};
// Writer errors have no source position: values may have been built by the caller.
export type JsonWriteError = { kind: JsonValueErrorKind; limit: Option<string>; };

@Ensures(result.maxDepth == 64 && result.maxInputBytes == 1048576)
export function defaultJsonLimits(): JsonLimits {
  return JsonLimits {
    maxInputBytes: 1048576,
    maxDepth: 64,
    maxNodes: 100000,
    maxContainerItems: 10000,
    maxStringBytes: 262144,
    maxDecodedStringBytes: 1048576,
    maxNumberBytes: 1024,
    maxOutputBytes: 4194304,
  };
}

export function defaultJsonOptions(): JsonReadOptions {
  return JsonReadOptions { limits: defaultJsonLimits(), duplicates: RejectDuplicates };
}

function validLimits(l: JsonLimits): bool {
  return l.maxInputBytes > 0
      && l.maxDepth > 0
      && l.maxDepth <= 200
      && l.maxNodes > 0
      && l.maxContainerItems > 0
      && l.maxStringBytes > 0
      && l.maxDecodedStringBytes > 0
      && l.maxNumberBytes > 0
      && l.maxOutputBytes > 0;
}

function parseError(
  s: string,
  kind: JsonValueErrorKind,
  at: usize,
  limit: Option<string>,
): JsonParseError {
  let line: usize = 1;
  let start: usize = 0;
  let i: usize = 0;
  while (i < at) {
    if (s.charCodeAt(i) == 10) {
      line += 1;
      start = i + 1;
    }
    i += 1;
  }
  return JsonParseError {
    kind: kind,
    offset: at,
    line: line,
    column: at - start + 1,
    limit: limit,
  };
}

function digit(c: int): bool {
  return c >= 48 && c <= 57;
}
function hex(c: int): int {
  if (digit(c)) {
    return c - 48;
  }
  if (c >= 65 && c <= 70) {
    return c - 55;
  }
  if (c >= 97 && c <= 102) {
    return c - 87;
  }
  return -1;
}

@Invariant(this.pos <= this.text.length
    && this.nodes <= this.limits.maxNodes
    && this.decoded <= this.limits.maxDecodedStringBytes)
class DocumentParser {
  private text: string;
  private limits: JsonLimits;
  private reject: bool;
  private pos: usize = 0;
  private nodes: usize = 0;
  private decoded: usize = 0;

  constructor(text: string, options: JsonReadOptions) {
    this.text = text;
    this.limits = options.limits;
    this.reject = match (options.duplicates) {
      RejectDuplicates => true,
      PreserveDuplicates => false,
    };
  }

  private fail(kind: JsonValueErrorKind, at: usize, limit: Option<string>): JsonParseError {
    return parseError(this.text, kind, at, limit);
  }
  private peek(): int {
    return this.pos < this.text.length ? this.text.charCodeAt(this.pos) : -1;
  }
  private ws(): void {
    while (this.pos < this.text.length) {
      const c = this.peek();
      if (c != 32 && c != 9 && c != 10 && c != 13) {
        break;
      }
      this.pos += 1;
    }
  }

  private stringBudget(current: usize, count: usize, at: usize): Result<void, JsonParseError> {
    if (count > this.limits.maxStringBytes - current) {
      return Err(this.fail(JsonLimitExceeded, at, Some("maxStringBytes")));
    }
    if (count > this.limits.maxDecodedStringBytes - this.decoded) {
      return Err(this.fail(JsonLimitExceeded, at, Some("maxDecodedStringBytes")));
    }
    this.decoded += count;
    return Ok();
  }

  private hex4(): Result<int, JsonParseError> {
    let n = 0;
    let k = 0;
    while (k < 4) {
      const h = hex(this.peek());
      if (h < 0) {
        return Err(this.fail(JsonSyntax, this.pos, None));
      }
      n = n * 16 + h;
      this.pos += 1;
      k += 1;
    }
    return Ok(n);
  }

  // Caller has consumed no part of the opening quote. No old(this) snapshots
  // or ByteBuilder per-byte contracts: the local byte buffer stays unique.
  private stringValue(): Result<string, JsonParseError> {
    this.pos += 1;
    let out: u8[] = [];
    while (this.pos < this.text.length) {
      const at = this.pos;
      const c = this.peek();
      if (c == 34) {
        this.pos += 1;
        // Empty arrays have no backing storage; avoid null+0 in bytesToString.
        if (out.length == 0) {
          return Ok("");
        }
        return Ok(bytesToString(out, 0, out.length));
      }
      if (c < 32) {
        return Err(this.fail(JsonSyntax, at, None));
      }
      if (c != 92) {
        this.stringBudget(out.length, 1, at)?;
        out.push(c.toU8());
        this.pos += 1;
        continue;
      }
      this.pos += 1;
      const e = this.peek();
      if (e < 0) {
        return Err(this.fail(JsonSyntax, this.pos, None));
      }
      this.pos += 1;
      let encoded = "";
      if (e == 34 || e == 92 || e == 47) {
        encoded = String.fromCharCode(e);
      } else if (e == 98) {
        encoded = "\x08";
      } else if (e == 102) {
        encoded = "\x0c";
      } else if (e == 110) {
        encoded = "\n";
      } else if (e == 114) {
        encoded = "\r";
      } else if (e == 116) {
        encoded = "\t";
      } else if (e == 117) {
        let cp = this.hex4()?;
        if (cp >= 55296 && cp <= 56319) {
          if (this.peek() != 92
              || this.pos + 1 >= this.text.length
              || this.text.charCodeAt(this.pos + 1) != 117) {
            return Err(this.fail(JsonInvalidSurrogate, at, None));
          }
          this.pos += 2;
          const low = this.hex4()?;
          if (low < 56320 || low > 57343) {
            return Err(this.fail(JsonInvalidSurrogate, at, None));
          }
          cp = 65536 + (cp - 55296) * 1024 + low - 56320;
        } else if (cp >= 56320 && cp <= 57343) {
          return Err(this.fail(JsonInvalidSurrogate, at, None));
        }
        encoded = encodeCodePoint(cp).unwrap();
      } else {
        return Err(this.fail(JsonSyntax, this.pos - 1, None));
      }
      this.stringBudget(out.length, encoded.length, at)?;
      let j: usize = 0;
      while (j < encoded.length) {
        out.push(encoded.charCodeAt(j).toU8());
        j += 1;
      }
    }
    return Err(this.fail(JsonSyntax, this.pos, None));
  }

  private numberValue(): Result<JsonValue, JsonParseError> {
    const start = this.pos;
    while (this.pos < this.text.length) {
      const c = this.peek();
      if (!digit(c) && c != 45 && c != 43 && c != 46 && c != 101 && c != 69) {
        break;
      }
      if (this.pos - start == this.limits.maxNumberBytes) {
        return Err(this.fail(JsonLimitExceeded, this.pos, Some("maxNumberBytes")));
      }
      this.pos += 1;
    }
    const token = this.text.substring(start, this.pos);
    const n = jsonNumber(token, this.limits.maxNumberBytes);
    if (n.isErr()) {
      return Err(this.fail(JsonSyntax, start + n.unwrapErr().offset.unwrapOr(0), None));
    }
    return Ok(ValueNumber(n.unwrap()));
  }

  private literal(word: string): Result<void, JsonParseError> {
    let i: usize = 0;
    while (i < word.length) {
      if (this.peek() != word.charCodeAt(i)) {
        return Err(this.fail(JsonSyntax, this.pos, None));
      }
      this.pos += 1;
      i += 1;
    }
    return Ok();
  }

  private arrayValue(depth: usize): Result<JsonValue, JsonParseError> {
    this.pos += 1;
    this.ws();
    let values: JsonValue[] = [];
    if (this.peek() == 93) {
      this.pos += 1;
      return Ok(ValueArray(values));
    }
    while (true) {
      this.ws();
      if (this.peek() < 0 || this.peek() == 93) {
        return Err(this.fail(JsonSyntax, this.pos, None));
      }
      if (values.length == this.limits.maxContainerItems) {
        return Err(this.fail(JsonLimitExceeded, this.pos, Some("maxContainerItems")));
      }
      const v = this.value(depth)?;
      values.push(v);
      this.ws();
      if (this.peek() == 93) {
        this.pos += 1;
        return Ok(ValueArray(values));
      }
      if (this.peek() != 44) {
        return Err(this.fail(JsonSyntax, this.pos, None));
      }
      this.pos += 1;
    }
    return Err(this.fail(JsonSyntax, this.pos, None));
  }

  private objectValue(depth: usize): Result<JsonValue, JsonParseError> {
    this.pos += 1;
    this.ws();
    let members: JsonMember[] = [];
    let seen = new Map<string, bool>();
    if (this.peek() == 125) {
      this.pos += 1;
      return Ok(ValueObject(members));
    }
    while (true) {
      this.ws();
      const at = this.pos;
      if (this.peek() != 34) {
        return Err(this.fail(JsonSyntax, at, None));
      }
      if (members.length == this.limits.maxContainerItems) {
        return Err(this.fail(JsonLimitExceeded, at, Some("maxContainerItems")));
      }
      const key = this.stringValue()?;
      if (this.reject) {
        if (seen.has(key)) {
          return Err(this.fail(JsonDuplicateKey, at, None));
        }
        seen.set(key, true);
      }
      this.ws();
      if (this.peek() != 58) {
        return Err(this.fail(JsonSyntax, this.pos, None));
      }
      this.pos += 1;
      const v = this.value(depth)?;
      members.push(JsonMember { key: key, value: v });
      this.ws();
      if (this.peek() == 125) {
        this.pos += 1;
        return Ok(ValueObject(members));
      }
      if (this.peek() != 44) {
        return Err(this.fail(JsonSyntax, this.pos, None));
      }
      this.pos += 1;
    }
    return Err(this.fail(JsonSyntax, this.pos, None));
  }

  private value(depth: usize): Result<JsonValue, JsonParseError> {
    this.ws();
    const at = this.pos;
    const c = this.peek();
    if (c < 0) {
      return Err(this.fail(JsonSyntax, at, None));
    }
    if (this.nodes == this.limits.maxNodes) {
      return Err(this.fail(JsonLimitExceeded, at, Some("maxNodes")));
    }
    this.nodes += 1;
    if ((c == 91 || c == 123) && depth == this.limits.maxDepth) {
      return Err(this.fail(JsonLimitExceeded, at, Some("maxDepth")));
    }
    if (c == 34) {
      return Ok(ValueString(this.stringValue()?));
    }
    if (c == 91) {
      return this.arrayValue(depth + 1);
    }
    if (c == 123) {
      return this.objectValue(depth + 1);
    }
    if (c == 45 || digit(c)) {
      return this.numberValue();
    }
    if (c == 116) {
      this.literal("true")?;
      return Ok(ValueBool(true));
    }
    if (c == 102) {
      this.literal("false")?;
      return Ok(ValueBool(false));
    }
    if (c == 110) {
      this.literal("null")?;
      return Ok(ValueNull);
    }
    return Err(this.fail(JsonSyntax, at, None));
  }

  @Ensures(result.isErr() ==> result.unwrapErr().offset <= this.text.length)
  document(): Result<JsonValue, JsonParseError> {
    const v = this.value(0)?;
    this.ws();
    if (this.pos != this.text.length) {
      return Err(this.fail(JsonSyntax, this.pos, None));
    }
    return Ok(v);
  }
}

@Ensures(result.isErr() ==> result.unwrapErr().offset <= text.length)
export function parseDocument(
  text: string,
  options: JsonReadOptions,
): Result<JsonValue, JsonParseError> {
  if (!validLimits(options.limits)) {
    return Err(parseError(text, JsonInvalidLimits, 0, None));
  }
  if (text.length > options.limits.maxInputBytes) {
    return Err(
      parseError(text, JsonLimitExceeded, options.limits.maxInputBytes, Some("maxInputBytes")),
    );
  }
  const utf8 = checkUtf8(text);
  if (utf8.isErr()) {
    return Err(parseError(text, JsonInvalidUtf8, utf8.unwrapErr().position, None));
  }
  let parser = new DocumentParser(text, options);
  return parser.document();
}

function writeError(kind: JsonValueErrorKind, limit: Option<string>): JsonWriteError {
  return JsonWriteError { kind: kind, limit: limit };
}

@Invariant(this.out.length <= this.limits.maxOutputBytes
    && this.nodes <= this.limits.maxNodes
    && this.decoded <= this.limits.maxDecodedStringBytes)
class DocumentWriter {
  private limits: JsonLimits;
  private out: u8[] = [];
  private nodes: usize = 0;
  private decoded: usize = 0;
  constructor(limits: JsonLimits) {
    this.limits = limits;
  }

  private byte(b: u8): Result<void, JsonWriteError> {
    if (this.out.length == this.limits.maxOutputBytes) {
      return Err(writeError(JsonLimitExceeded, Some("maxOutputBytes")));
    }
    this.out.push(b);
    return Ok();
  }
  private raw(s: string): Result<void, JsonWriteError> {
    if (s.length > this.limits.maxOutputBytes - this.out.length) {
      return Err(writeError(JsonLimitExceeded, Some("maxOutputBytes")));
    }
    let i: usize = 0;
    while (i < s.length) {
      this.out.push(s.charCodeAt(i).toU8());
      i += 1;
    }
    return Ok();
  }
  private stringValue(s: string): Result<void, JsonWriteError> {
    if (s.length > this.limits.maxStringBytes) {
      return Err(writeError(JsonLimitExceeded, Some("maxStringBytes")));
    }
    if (s.length > this.limits.maxDecodedStringBytes - this.decoded) {
      return Err(writeError(JsonLimitExceeded, Some("maxDecodedStringBytes")));
    }
    if (checkUtf8(s).isErr()) {
      return Err(writeError(JsonInvalidUtf8, None));
    }
    this.decoded += s.length;
    this.byte(34)?;
    const digits = "0123456789abcdef";
    let i: usize = 0;
    while (i < s.length) {
      const c = s.charCodeAt(i);
      if (c == 34) {
        this.raw("\\\"")?;
      } else if (c == 92) {
        this.raw("\\\\")?;
      } else if (c == 8) {
        this.raw("\\b")?;
      } else if (c == 12) {
        this.raw("\\f")?;
      } else if (c == 10) {
        this.raw("\\n")?;
      } else if (c == 13) {
        this.raw("\\r")?;
      } else if (c == 9) {
        this.raw("\\t")?;
      } else if (c < 32) {
        this.raw("\\u00")?;
        this.byte(digits.charCodeAt((c / 16).toUsize()).toU8())?;
        this.byte(digits.charCodeAt((c % 16).toUsize()).toU8())?;
      } else {
        this.byte(c.toU8())?;
      }
      i += 1;
    }
    this.byte(34)?;
    return Ok();
  }

  private value(v: JsonValue, depth: usize): Result<void, JsonWriteError> {
    if (this.nodes == this.limits.maxNodes) {
      return Err(writeError(JsonLimitExceeded, Some("maxNodes")));
    }
    this.nodes += 1;
    match (v) {
      ValueNull => {
        this.raw("null")?;
      },
      ValueBool(b) => {
        this.raw(b ? "true" : "false")?;
      },
      ValueNumber(n) => {
        if (n.token.length > this.limits.maxNumberBytes) {
          return Err(writeError(JsonLimitExceeded, Some("maxNumberBytes")));
        }
        this.raw(n.token)?;
      },
      ValueString(s) => {
        this.stringValue(s)?;
      },
      ValueArray(values) => {
        if (depth == this.limits.maxDepth) {
          return Err(writeError(JsonLimitExceeded, Some("maxDepth")));
        }
        if (values.length > this.limits.maxContainerItems) {
          return Err(writeError(JsonLimitExceeded, Some("maxContainerItems")));
        }
        this.byte(91)?;
        let i: usize = 0;
        while (i < values.length) {
          if (i > 0) {
            this.byte(44)?;
          }
          this.value(values[i], depth + 1)?;
          i += 1;
        }
        this.byte(93)?;
      },
      ValueObject(members) => {
        if (depth == this.limits.maxDepth) {
          return Err(writeError(JsonLimitExceeded, Some("maxDepth")));
        }
        if (members.length > this.limits.maxContainerItems) {
          return Err(writeError(JsonLimitExceeded, Some("maxContainerItems")));
        }
        this.byte(123)?;
        let i: usize = 0;
        while (i < members.length) {
          if (i > 0) {
            this.byte(44)?;
          }
          this.stringValue(members[i].key)?;
          this.byte(58)?;
          this.value(members[i].value, depth + 1)?;
          i += 1;
        }
        this.byte(125)?;
      },
    }
    return Ok();
  }

  @Ensures(result.isOk() ==> result.unwrap().length <= this.limits.maxOutputBytes)
  document(v: JsonValue): Result<string, JsonWriteError> {
    this.value(v, 0)?;
    return Ok(bytesToString(this.out, 0, this.out.length));
  }
}

@Ensures(result.isOk() ==> result.unwrap().length <= limits.maxOutputBytes)
export function writeDocument(v: JsonValue, limits: JsonLimits): Result<string, JsonWriteError> {
  if (!validLimits(limits)) {
    return Err(writeError(JsonInvalidLimits, None));
  }
  let writer = new DocumentWriter(limits);
  return writer.document(v);
}
