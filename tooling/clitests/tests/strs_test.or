import { assertEq, assertEqUsize, assertEqString, assertEqBool } from "std:test";
import { reprList, reprList2, absolute, containsAll, uniqueSorted, isSorted, isDistinct, sameList, symmetricDiff, lastPart, head, tail } from "../src/strs";

@Test
function reprsLikePython(): void {
  assertEqString(reprList(["a", "b"]), "['a', 'b']", "list");
  assertEqString(reprList([]), "[]", "empty list");
  assertEqString(reprList2([["a"], []]), "[['a'], []]", "list of lists");
}

@Test
function setsOfStrings(): void {
  assertEqBool(containsAll(["a", "b", "c"], ["c", "a"]), true, "subset");
  assertEqBool(containsAll(["a"], ["a", "z"]), false, "not a subset");
  assertEqUsize(uniqueSorted(["b", "a", "b"]).length, 2, "distinct");
  assertEqString(uniqueSorted(["b", "a", "b"]).join(","), "a,b", "sorted");
  assertEqBool(isSorted(["a", "b", "b"]), true, "sorted with a repeat");
  assertEqBool(isSorted(["b", "a"]), false, "unsorted");
  assertEqBool(isDistinct(["a", "b"]), true, "distinct");
  assertEqBool(isDistinct(["a", "a"]), false, "repeat");
  assertEqBool(sameList(["a", "b"], ["a", "b"]), true, "same");
  assertEqBool(sameList(["a", "b"], ["b", "a"]), false, "order matters");
  assertEqString(symmetricDiff(["a", "b"], ["b", "c"]).join(","), "a,c", "symmetric difference");
}

@Test
function pathsAndCuts(): void {
  assertEqString(absolute("/cwd", "x/y"), "/cwd/x/y", "relative");
  assertEqString(absolute("/cwd", "/abs"), "/abs", "absolute");
  assertEqString(lastPart("a::b::c", "::"), "c", "last part");
  assertEqString(lastPart("abc", "::"), "abc", "no separator");
  assertEqString(head("abcdef", 3), "abc", "head");
  assertEqString(tail("abcdef", 3), "def", "tail");
  assertEqString(tail("ab", 5), "ab", "short");
}
