// A bounded generic function calls another one with T, converts T to the interface and passes it on.
interface Shape {
  area(): int;
}

class Sq implements Shape {
  constructor(public s: int) {}
  area(): int { return this.s * this.s; }
}

function area2<T extends Shape>(x: T): int {
  return x.area() * 2;
}

function viaIface(s: Shape): int {
  return s.area() + 1;
}

function both<T extends Shape>(x: T): int {
  const s: Shape = x;
  return area2(x) + viaIface(x) + viaIface(s);
}

function main(): void {
  console.log(both(new Sq(3)).toString());
  const s: Shape = new Sq(2);
  console.log(both(s).toString());
}
