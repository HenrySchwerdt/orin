// flags: --check-contracts
import { bytesFromHex } from "std:bytes";
import { validate, validateString, utf8ErrorMessage, CodePointCursor } from "std:utf8";

function main(): void {
  const s = validateString("h\xc3\xa9\xe2\x82\xac\xf0\x9f\x98\x80").unwrap();
  console.log(s.byteLength().toString() + " " + s.codePointCount().toString());
  let c = new CodePointCursor(s);
  while (c.hasNext()) {
    console.log(c.next().unwrap().toString());
  }
  console.log(validate(bytesFromHex("c0af").unwrap()).isErr().toString());
  console.log(utf8ErrorMessage(validate(bytesFromHex("41eda080").unwrap()).unwrapErr()));
  console.log(utf8ErrorMessage(validate(bytesFromHex("e180").unwrap()).unwrapErr()));
}
