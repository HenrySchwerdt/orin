// `checkWithIndex`: the checker result together with the semantic index (hir/index.or).
// `check` itself is unchanged; the index is built by the separate pass in check/index/ and is
// available even when type checking fails (then without type-dependent entries).

import { Diagnostic, SourceMap } from "../diag";
import { Program, SemanticIndex } from "../hir";
import { LoadedProgram } from "../loader";
import { check } from "./checker";
import { buildIndex } from "./index/build";

export type Checked = { result: Result<Program, Diagnostic[]>; index: SemanticIndex; };

export function checkWithIndex(prog: LoadedProgram, sm: SourceMap): Checked {
  const r = check(prog, sm);
  let hir: Option<Program> = None;
  match (r) {
    Ok(p) => { hir = Some(p); },
    Err(_) => {}
  }
  return Checked { result: r, index: buildIndex(prog, sm, hir) };
}
