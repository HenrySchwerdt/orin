// `s + n.toString()`, `${n}` and `s += n.toString()` append the decimal text of n straight onto the destination buffer
// (docs/mir.md v2.5, `strappendi` / `strappendu`), and a bare `n.toString()` fills one pre-sized buffer. The text must be
// exactly what the digit loop of std/numbers produced: 0, the extremes of int and usize, negatives, and every sharing case
// (a literal, an alias, a struct field) must leave the other names of the destination untouched.

type Box = { s: string; n: int; };

function same(s: string): string {
  return s;
}

function line(label: string, v: string): void {
  console.log(label + "=" + v + ";");
}

function main(): void {
  const zero = 0;
  const neg = -42;
  const imin = -9223372036854775807 - 1;
  const imax = 9223372036854775807;
  const u0: usize = 0;
  const u9: usize = 9;
  const u10: usize = 10;
  const umx: usize = imax.toUsize() * 2 + 1;

  // bare toString
  line("zero", zero.toString());
  line("neg", neg.toString());
  line("imin", imin.toString());
  line("imax", imax.toString());
  line("u0", u0.toString());
  line("u9", u9.toString());
  line("u10", u10.toString());
  line("umax", umx.toString());
  line("len umax", umx.toString().length.toString());

  // literal prefix, borrowed prefix, empty prefix
  line("lit", "w" + zero.toString());
  line("lit-neg", "w" + imin.toString());
  line("lit-umax", "n" + umx.toString());
  line("empty", "" + neg.toString());
  line("empty-u", "" + u0.toString());
  const base = "base";
  line("borrowed", base + imax.toString());
  line("base kept", base);

  // template literals
  line("tpl", `${zero}|${neg}|${imin}|${imax}|${u0}|${umx}`);
  line("tpl-only", `${neg}`);
  line("tpl-adjacent", `${zero}${u10}`);
  line("tpl-mixed", `a${zero}b${u9}c${true}d${neg}`);

  // narrow integer kinds
  const b: i8 = -128;
  const w: u8 = 255;
  const h: i32 = -2147483648;
  const v: u32 = 4294967295;
  line("narrow", `${b} ${w} ${h} ${v}`);

  // += and s = s + n
  let acc = "";
  acc += zero.toString();
  acc += ",";
  acc += neg.toString();
  acc += ",";
  acc += umx.toString();
  line("acc", acc);
  let acc2 = "x";
  acc2 = acc2 + imin.toString();
  acc2 = acc2 + u9.toString();
  line("acc2", acc2);

  // a shared destination is copied, never modified
  let s1 = "shared";
  const s2 = s1;
  s1 += neg.toString();
  line("s1", s1);
  line("s2", s2);
  const al = same(s1);
  s1 += u10.toString();
  line("s1b", s1);
  line("al", al);

  // growth: many appends onto one buffer
  let big = "";
  let i = 0;
  while (i < 300) {
    big += (i * 1000003).toString();
    big += " ";
    i += 1;
  }
  line("big len", big.length.toString());
  line("big tail", big.substring(big.length - 24, big.length));

  // struct field destination
  let bx = Box { s: "f", n: 7 };
  bx.s += bx.n.toString();
  bx.s += neg.toString();
  line("field", bx.s);
  bx.s = bx.s + bx.n.toString();
  line("field2", bx.s);

  // the number depends on the destination
  let t = "ab";
  t += t.length.toString();
  t += t.length.toString();
  line("self", t);

  // order of evaluation is unchanged
  let k = 0;
  const parts = [1, 2, 3];
  let o = "o";
  for (const p of parts) {
    k += p;
    o += k.toString();
  }
  line("order", o);
  line("max-min", imax.toString() + imin.toString());

  // chains on the right of += are appended piece by piece; every piece sees the destination as it was before the statement
  let c1 = "s";
  c1 += "a" + c1;
  line("c1", c1);
  let c2 = "s";
  c2 += c2 + "b" + c2.length.toString();
  line("c2", c2);
  let c3 = "";
  let j = 0;
  while (j < 4) {
    c3 += "item" + j.toString() + "," + (j * j).toString() + ";";
    j += 1;
  }
  line("c3", c3);
  let c4 = "z";
  c4 += `${neg}/${umx}/${c4}`;
  line("c4", c4);
  let c5 = "k";
  const c6 = c5;
  c5 += "<" + zero.toString() + ">" + c6;
  line("c5", c5);
  line("c6", c6);
  let c7 = "";
  c7 += "" + "" + zero.toString() + "";
  line("c7", c7);
  let c8 = "q";
  c8 += c8.substring(0, 1) + "|" + c8.substring(0, 1);
  line("c8", c8);
  c8 += c8.substring(1, 3);
  line("c8b", c8);
  c8 += c8.substring(2, 2);
  line("c8c", c8);
  c8 += c8.substring(0, c8.length);
  line("c8d", c8);
  const ss = "0123456789";
  let c9 = ">";
  c9 += ss.substring(2, 5);
  c9 += "-" + ss.substring(7, 10);
  c9 += ss.substring(0, 10);
  c9 += ss.substring(4, 4);
  line("c9", c9);
  let c10 = "";
  c10 += ss.substring(0, 0);
  c10 += ss.substring(9, 10);
  line("c10", c10);
}
