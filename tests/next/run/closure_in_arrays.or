function main(): void {
  const fs: ((x: int) => int)[] = [x => x + 1, x => x * 2, (x: int): int => x - 3];
  console.log(fs[0](10).toString());
  console.log(fs[1](10).toString());
  console.log(fs[2](10).toString());
  let acc = 1;
  for (const f of fs) {
    acc = f(acc);
  }
  console.log(acc.toString());
  const n = 5;
  const adders = [1, 2, 3].map(k => (x: int) => x + k * n);
  console.log(
    adders[0](0).toString() + " " + adders[1](0).toString() + " " + adders[2](0).toString(),
  );
  const names = ["x", "y"];
  const printers: (() => string)[] = names.map(s => () => s + s);
  console.log(printers[1]());
  let grid: ((a: int, b: int) => int)[][] = [[(a, b) => a + b], [(a, b) => a * b, (a, b) => a - b]];
  console.log(
    grid[1][1](9, 4).toString() + grid[0][0](1, 1).toString() + grid[1][0](3, 3).toString(),
  );
}
