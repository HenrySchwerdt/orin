// The conversion applies to the branches of ?: and to match arms with an interface target type.
interface Shape {
  area(): int;
}

class A implements Shape {
  area(): int { return 1; }
}

class B implements Shape {
  area(): int { return 2; }
}

type Kind = Ka | Kb;

function make(k: Kind): Shape {
  return match (k) {
    Ka => new A(),
    Kb => new B()
  };
}

function main(): void {
  const flag = true;
  const s: Shape = flag ? new A() : new B();
  const t: Shape = !flag ? new A() : new B();
  console.log(s.area().toString() + t.area().toString());
  console.log(make(Ka).area().toString() + make(Kb).area().toString());
}
