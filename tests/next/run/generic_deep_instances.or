function wrap<T>(x: T): Option<T> {
  return Some(x);
}

function unwrap3<T>(o: Option<Option<Option<T>>>): T {
  return o.unwrap().unwrap().unwrap();
}

function nest<T>(n: int, x: T): int {
  if (n <= 0) {
    return 0;
  }
  return 1;
}

function main(): void {
  console.log(unwrap3(wrap(wrap(wrap(12)))).toString());
  console.log(unwrap3(wrap(wrap(wrap("deep")))));
  const w4 = wrap(wrap(wrap(wrap(1))));
  console.log(w4.isSome().toString());
  console.log(nest(3, [[1]]).toString());
}
