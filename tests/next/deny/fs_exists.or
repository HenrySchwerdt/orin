// ORIN_DENY=fs: `exists` returns a bool, which cannot carry a denial: it traps
import { Host, useFs } from "std:host";
import { exists } from "std:fs";
function main(host: Host): void {
  useFs(host, fs => {
    console.log("before");
    console.log(exists(fs, "tests/next/deny/fs_exists.or").toString());
  });
}
