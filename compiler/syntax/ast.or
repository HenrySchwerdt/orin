// Untyped syntax tree for one .or file — Stage 1 shared contract (v1).
// Mirrors bootstrap/src/ast.rs. Owned by the lead architect.
// Naming: variant names carry a kind prefix (E = expr, S = stmt, I = item, T = type expr,
// P = pattern, B = arm body, D = type decl body) so AST and HIR can be imported together.

import { Span } from "../diag";

export type Ident = { name: string; span: Span; };

export type Module = { file: usize; items: Item[]; };

export type Item =
  IImport(ImportDecl)
  | IReExport(ImportDecl)
  | IFunction(FunctionDecl)
  | IType(TypeDecl)
  | IConst(ConstDecl)
  // --- beyond Orin-B (classes, ADR-0009); Stage 0 never produces these ---
  | IClass(ClassDecl)
  // --- beyond Orin-B (interfaces, ADR-0019) ---
  | IInterface(InterfaceDecl);

// `import { a, b } from "path";` and `export { a, b } from "path";`
export type ImportDecl = { names: Ident[]; path: string; pathSpan: Span; span: Span; };

export type FunctionDecl = {
  exported: bool;
  name: Ident;
  typeParams: Ident[];
  bounds: Option<Ident>[];     // one per type parameter: `T extends Shape` (ADR-0019)
  params: Param[];
  ret: Option<TypeExpr>;
  body: Block;
  contracts: ContractClause[];   // beyond Orin-B (ADR-0012): `@Requires(..)` etc. written before the declaration
  annotations: Annotation[];     // beyond Orin-B (ADR-0024): `@Test`, `@Deprecated("..")`, `@Inline`
  span: Span;
};

export type Param = { name: Ident; ty: TypeExpr; span: Span; };

// Contract clauses (ADR-0012, spec 15 §4.2a). They are NOT annotations: a closed set of reserved,
// compiler-defined constructs with their own productions. `expr` is None only for `@Rule("ID")`,
// whose argument is the string `rule`. Expressions may contain `==>` (BImplies), `result` and
// `old(e)`; the checker validates where those are allowed.
export type ContractKind = CRequires | CEnsures | CInvariant | CDecreases | CRule;

export type ContractClause = { kind: ContractKind; expr: Option<Expr>; rule: string; span: Span; };

// Built-in annotations (ADR-0024, spec 05): a closed set of compiler-defined markers. They are NOT a
// general annotation mechanism (user-defined annotations are post-1.0) and, like contract clauses, have
// dedicated grammar and AST nodes. `message` is the string argument of `@Deprecated`, "" otherwise.
export type AnnotationKind = ATest | ADeprecated | AInline;

export type Annotation = { kind: AnnotationKind; message: string; span: Span; };

export type TypeDecl = {
  exported: bool;
  name: Ident;
  typeParams: Ident[];
  body: TypeDeclBody;
  contracts: ContractClause[];
  annotations: Annotation[];
  span: Span;
};

export type TypeDeclBody = DAlias(TypeExpr) | DRecord(FieldDecl[]) | DUnion(VariantDecl[]);

export type FieldDecl = { name: Ident; ty: TypeExpr; span: Span; };

export type VariantDecl = { name: Ident; payload: TypeExpr[]; span: Span; };

export type ConstDecl = { exported: bool; name: Ident; ty: Option<TypeExpr>; value: Expr; span: Span; };

// `class C { members }`. `ext` is parsed only so that the checker can reject it (E0408). `typeParams` /
// `bounds` (parallel, `class SortedList<T extends Comparable>`) make a generic class (ADR-0026).
export type ClassDecl = {
  exported: bool;
  name: Ident;
  typeParams: Ident[];
  bounds: Option<Ident>[];
  ext: Option<Ident>;
  impls: Ident[];              // `implements A, B` (ADR-0019)
  members: ClassMember[];
  contracts: ContractClause[];
  annotations: Annotation[];
  span: Span;
};

// `interface Shape { area(): int; }` (ADR-0019). `typeParams` / `ext` are parsed only so that the checker
// can reject them (E0408); fields and default methods are rejected by the parser (E0408).
export type InterfaceDecl = {
  exported: bool;
  name: Ident;
  typeParams: Ident[];
  ext: Option<Ident>;
  methods: IfaceMethod[];
  annotations: Annotation[];
  span: Span;
};

export type IfaceMethod = { name: Ident; params: Param[]; ret: Option<TypeExpr>; annotations: Annotation[]; span: Span; };

export type ClassMember = MField(ClassField) | MCtor(CtorDecl) | MMethod(MethodDecl);

// `private label: string = "";`
export type ClassField = { priv: bool; name: Ident; ty: TypeExpr; init: Option<Expr>; span: Span; };

// `constructor(public a: int, b: int) { .. }`
export type CtorDecl = { params: CtorParam[]; body: Block; contracts: ContractClause[]; span: Span; };

// access: 0 plain parameter, 1 `public` parameter property, 2 `private` parameter property.
export type CtorParam = { access: int; name: Ident; ty: TypeExpr; span: Span; };

export type MethodDecl = {
  priv: bool;
  isStatic: bool;
  name: Ident;
  typeParams: Ident[];
  params: Param[];
  ret: Option<TypeExpr>;
  body: Block;
  contracts: ContractClause[];
  annotations: Annotation[];
  span: Span;
};

export type TypeExpr = { kind: TypeExprKind; span: Span; };

// TNamed(name, typeArgs) | TArray(element) | TFn(params, result): `(x: T, ..) => R` (beyond Orin-B,
// closures, ADR-0011; the parameter names are documentation only)
export type TypeExprKind = TNamed(Ident, TypeExpr[]) | TArray(TypeExpr) | TFn(FnTyParam[], TypeExpr);

export type FnTyParam = { name: Ident; ty: TypeExpr; };

export type Block = { stmts: Stmt[]; span: Span; };

export type Stmt = { kind: StmtKind; span: Span; };

export type AssignOp = OpAssign | OpAddAssign | OpSubAssign | OpMulAssign | OpDivAssign | OpRemAssign;

export type StmtKind =
  SLet(bool, Ident, Option<TypeExpr>, Expr)          // mutable, name, type, init
  | SAssign(Expr, AssignOp, Expr)                     // target, op, value
  | SExpr(Expr)
  | SReturn(Option<Expr>)
  | SIf(Expr, Block, Option<Stmt>)                    // else: an SBlock or SIf stmt
  | SWhile(Expr, Block)
  | SForOf(Ident, Expr, Block)
  | SBreak
  | SContinue
  | SBlock(Block)
  // --- beyond Orin-B (contract clauses, ADR-0012) ---
  // `@Invariant(e)` / `@Decreases(e)` before a loop: the parser emits one SContract statement per
  // clause immediately before the `while` / `for` statement they constrain.
  | SContract(ContractClause);

export type Expr = { kind: ExprKind; span: Span; };

export type UnaryOp = UNot | UNeg;

export type BinaryOp =
  BAdd | BSub | BMul | BDiv | BRem
  | BEq | BNe | BLt | BLe | BGt | BGe
  | BAnd | BOr
  // --- beyond Orin-B (contract clauses, ADR-0012): `a ==> b`, only valid inside contract expressions ---
  | BImplies;

export type ExprKind =
  EInt(int)
  | EStr(string)
  | EBool(bool)
  | EIdent(Ident)
  | EUnary(UnaryOp, Expr)
  | EBinary(BinaryOp, Expr, Expr)
  | ECall(Expr, Expr[])                               // callee, args
  | EMember(Expr, Ident)
  | EIndex(Expr, Expr)
  | ETry(Expr)
  | ECond(Expr, Expr, Expr)
  | EArray(Expr[])
  | ERecord(Ident, Option<Expr>, FieldInit[])         // type name, spread, fields
  // --- beyond Orin-B (generics, ADR-0007); Stage 0 never produces these ---
  | ETyApp(Ident, TypeExpr[])                         // `name<T, U>`; only valid as a call callee
  | ERecordT(Ident, TypeExpr[], Option<Expr>, FieldInit[])  // `Name<T, U> { ... }`
  | EMatch(Expr, MatchArm[])
  // --- beyond Orin-B (classes, ADR-0009) ---
  | EFloat(string)                                    // float literal (ADR-0018): canonical decimal text
  | EBigInt(int)                                      // integer literal in 2^63 .. 2^64-1 (ADR-0022): the 64-bit pattern as a negative int
  | ETemplate(string[], Expr[])                       // template literal (ADR-0022): n+1 cooked text parts around n interpolated expressions
  | ENew(Ident, TypeExpr[], Expr[])                   // `new C(args)` / `new C<T>(args)` (generic classes, ADR-0026)
  | EThis
  // --- beyond Orin-B (closures, ADR-0011) ---
  | EArrow(ArrowParam[], Option<TypeExpr>, ArrowBody)  // `(x: T, y) [: R] => body` / `x => body`
  // --- beyond Orin-B (JSX, ADR-0043) ---
  | EJsx(JsxElement);                                 // `<div class="a">{x}</div>`, `<Card title={t} />`, `<>..</>`

// A parameter type may be omitted when the checker knows the expected function type.
export type ArrowParam = { name: Ident; ty: Option<TypeExpr>; span: Span; };

export type ArrowBody = AExpr(Expr) | ABlock(Block);

// JSX (ADR-0043). `name` is None for a fragment `<>..</>`. A name starting with an upper-case letter is a component
// (a function called with the attributes as named arguments), any other an HTML element. The closing tag is not kept
// (the parser checks that it repeats the name). `selfClosing`: written `<x />` (then `children` is empty).
export type JsxElement = {
  name: Option<Ident>;
  attrs: JsxAttr[];
  children: JsxChild[];
  selfClosing: bool;
  span: Span;
};

// `name="text"` (JSX string: no backslash escapes, entities decoded), `name={expr}` or a bare `name` (the value `true`).
export type JsxAttr = { name: Ident; value: JsxValue; span: Span; };

export type JsxValue = JVStr(string) | JVExpr(Expr) | JVTrue;

// Text between tags (cooked: JSX whitespace rules applied, entities decoded; never empty), `{expr}`, a nested element.
export type JsxChild = JText(string, Span) | JExpr(Expr) | JElem(JsxElement);

// The expressions written inside `el` (attribute values and `{..}` children, nested elements included), in source order.
export function jsxExprs(el: JsxElement): Expr[] {
  let out: Expr[] = [];
  for (const a of el.attrs) {
    match (a.value) {
      JVExpr(x) => {
        out.push(x);
      },
      _ => {},
    }
  }
  for (const c of el.children) {
    match (c) {
      JExpr(x) => {
        out.push(x);
      },
      JElem(sub) => {
        out = out.concat(jsxExprs(sub));
      },
      JText(_, _) => {},
    }
  }
  return out;
}

// `el` with `f` applied to every expression written inside it (the same order as `jsxExprs`); the shape is unchanged.
export function jsxMapExprs(el: JsxElement, f: (x: Expr) => Expr): JsxElement {
  let attrs: JsxAttr[] = [];
  for (const a of el.attrs) {
    const v = match (a.value) {
      JVExpr(x) => JVExpr(f(x)),
      JVStr(s) => JVStr(s),
      JVTrue => JVTrue,
    };
    attrs.push(JsxAttr { name: a.name, value: v, span: a.span });
  }
  let kids: JsxChild[] = [];
  for (const c of el.children) {
    const k = match (c) {
      JExpr(x) => JExpr(f(x)),
      JElem(sub) => JElem(jsxMapExprs(sub, f)),
      JText(t, sp) => JText(t, sp),
    };
    kids.push(k);
  }
  return JsxElement { name: el.name, attrs: attrs, children: kids, selfClosing: el.selfClosing, span: el.span };
}

// The names of the component tags in `el` (itself and nested elements), in source order: references to functions.
export function jsxComponents(el: JsxElement): Ident[] {
  let out: Ident[] = [];
  if (jsxIsComponent(el)) {
    out.push(el.name.unwrap());
  }
  for (const c of el.children) {
    match (c) {
      JElem(sub) => {
        out = out.concat(jsxComponents(sub));
      },
      _ => {},
    }
  }
  return out;
}

// A component tag: the name starts with an upper-case ASCII letter (`<Card />`); `<div>` and fragments are not.
export function jsxIsComponent(el: JsxElement): bool {
  return match (el.name) {
    Some(n) => n.name.length > 0 && n.name.charCodeAt(0) >= 65 && n.name.charCodeAt(0) <= 90,
    None => false,
  };
}

export type FieldInit = { name: Ident; value: Expr; span: Span; };

export type MatchArm = { pattern: Pattern; body: ArmBody; span: Span; };

export type ArmBody = BExpr(Expr) | BBlock(Block);

export type Pattern = { kind: PatternKind; span: Span; };

export type PatternKind =
  PWildcard
  | PIdent(Ident)                                     // nullary variant
  | PVariant(Ident, Pattern[])                        // sub-patterns: PIdent (binding) or PWildcard
  | PInt(int)
  | PStr(string)
  | PBool(bool);
