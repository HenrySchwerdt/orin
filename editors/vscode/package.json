{
  "name": "orin-vscode",
  "displayName": "Orin",
  "description": "Orin language support: syntax highlighting and the `orin lsp` language server (diagnostics, symbols, completion, navigation), with automatic compiler discovery.",
  "version": "0.1.0",
  "publisher": "orin-lang",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/orin-lang/orin-lang.git",
    "directory": "editors/vscode"
  },
  "homepage": "https://github.com/orin-lang/orin-lang",
  "bugs": {
    "url": "https://github.com/orin-lang/orin-lang/issues"
  },
  "keywords": [
    "orin",
    "language",
    "lsp",
    "syntax"
  ],
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.75.0",
    "node": ">=18"
  },
  "categories": [
    "Programming Languages"
  ],
  "orinCompiler": {
    "min": "0.1.0-alpha.2",
    "series": "0.1"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:orin"
  ],
  "contributes": {
    "languages": [
      {
        "id": "orin",
        "aliases": [
          "Orin",
          "orin"
        ],
        "extensions": [
          ".or"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "orin",
        "scopeName": "source.orin",
        "path": "./syntaxes/orin.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Orin",
      "properties": {
        "orin.serverPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to the `orin` executable. Leave empty (recommended) to discover it automatically: workspace `build/` or `tools/orin` inside the Orin repository, then `PATH`, then `~/.orin/bin`, `~/.local/bin`, `/opt/homebrew/bin`, `/usr/local/bin`. The extension runs `<path> lsp` over stdio.",
          "scope": "machine-overridable"
        },
        "orin.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Trace LSP traffic between VS Code and the Orin language server."
        }
      }
    },
    "commands": [
      {
        "command": "orin.restartServer",
        "title": "Orin: Restart Language Server"
      },
      {
        "command": "orin.showCompilerInfo",
        "title": "Orin: Show Compiler Info"
      },
      {
        "command": "orin.openInstallDocs",
        "title": "Orin: Open Install Docs"
      }
    ]
  },
  "scripts": {
    "test": "node --test test/grammar.test.js test/compiler.test.js"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.1.0"
  },
  "icon": "images/icon.png"
}
