import { add } from "./mathx";
import { shout } from "./strs";
import { assertEq, assertEqString } from "std:test";

@Test
function testAdd(): void {
  assertEq(add(2, 3), 5, "main: add");
}

@Test
function testShout(): void {
  assertEqString(shout("a"), "a!", "main: shout");
}

function main(): void {
  console.log(add(1, 2).toString());
  console.log(shout("hi"));
}
