import { decodeConfig } from "../../../examples/json_config";
import { JsonValue, parseDocument, defaultJsonOptions } from "std:jsonvalue";
import { formatPath } from "std:jsondecode";
function main(): void {
  const config = decodeConfig(
    parseDocument("{\"endpoint\":\"localhost\",\"port\":8.080e3}", defaultJsonOptions()).unwrap(),
  ).unwrap();
  console.log(config.endpoint);
  console.log(config.port.toString());
  console.log(config.enabled.toString());
  console.log(
    formatPath(
      decodeConfig(
        parseDocument("{\"endpoint\":\"localhost\",\"port\":0}", defaultJsonOptions()).unwrap(),
      ).unwrapErr().path,
    ),
  );
}
