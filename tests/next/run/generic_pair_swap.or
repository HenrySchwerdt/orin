type Pair<A, B> = { first: A; second: B; };

function swap<A, B>(p: Pair<A, B>): Pair<B, A> {
  return Pair { first: p.second, second: p.first };
}

function dup<T>(x: T): Pair<T, T> {
  return Pair { first: x, second: x };
}

function main(): void {
  const p = Pair { first: 1, second: "a" };
  const q = swap(p);
  console.log(q.first + q.second.toString());
  const r = swap(q);
  console.log(r.first.toString() + r.second);
  const d = dup("ab");
  console.log(d.first + d.second);
  const e = dup(dup(5));
  console.log(e.first.first.toString() + e.second.second.toString());
}
