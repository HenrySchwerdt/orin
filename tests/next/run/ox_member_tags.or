// OX member tags (ADR-0044 §4.5): `<ui.Card ..>..</ui.Card>` calls the method `Card` of the value `ui` with the
// component rules (attributes by parameter name, slots, Option parameters, source-order evaluation).
import { Html, render } from "std:html";
import ox from "std:html";

class Kit {
  prefix: string;

  constructor(prefix: string) {
    this.prefix = prefix;
  }

  Card(title: string, children: Html): Html {
    return <section class={this.prefix + "card"}><h2>{title}</h2>{children}</section>;
  }

  // named slots and an Option parameter
  Dialog(title: string, header: Html, footer: Option<Html>, children: Html): Html {
    return <div class="dialog">
      <header>{header}</header>
      <h1>{title}</h1>
      {children}
      {footer.isSome() ? <footer>{footer.unwrap()}</footer> : <i>no footer</i>}
    </div>;
  }

  Badge(label: string, count: Option<int>): Html {
    return <span>{label}:{count.unwrapOr(0).toString()}</span>;
  }

  Row(a: string, b: string): Html {
    return <tr><td>{a}</td><td>{b}</td></tr>;
  }

  // a member tag inside a method: `<this.Row />`
  Table(children: Html): Html {
    return <table><this.Row a="x" b="y" /><this.Row b="2" a="1" />{children}</table>;
  }
}

class Theme {
  kit: Kit;

  constructor(kit: Kit) {
    this.kit = kit;
  }
}

class App {
  theme: Theme;

  constructor(theme: Theme) {
    this.theme = theme;
  }
}

type Cells = { a: string; b: string; };

// Prints when it is evaluated: the attributes are evaluated left to right whatever the parameter order.
function note(s: string): string {
  console.log(`eval ${s}`);
  return s;
}

function main(): void {
  const ui = new Kit("k-");
  console.log(render(<ui.Card title="x & y">body</ui.Card>));
  console.log(render(<ui.Card title="self" />));
  // named slots, an omitted Option, a given Option
  console.log(render(<ui.Dialog title="T"><:header>H</:header>text</ui.Dialog>));
  console.log(render(<ui.Dialog title="T" footer={Some(<b>f</b>)}><:header><u>H</u></:header></ui.Dialog>));
  console.log(render(<ui.Badge label="n" />));
  console.log(render(<ui.Badge count={Some(3)} label="n" />));
  // a spread
  const cells = Cells { a: "s1", b: "s2" };
  console.log(render(<ui.Row {...cells} />));
  // inside a method
  console.log(render(ui.Table(<tr><td>end</td></tr>)));
  // a path of fields
  const app = new App(new Theme(new Kit("deep-")));
  console.log(render(<app.theme.kit.Card title="nested">path</app.theme.kit.Card>));
  // the same as the method call
  const same = render(<ui.Card title="t">c</ui.Card>) == render(ui.Card("t", <>c</>));
  console.log(`same: ${same}`);
  // evaluation order: `b` is written first although `a` is the first parameter
  console.log(render(<ui.Row b={note("b")} a={note("a")} />));
}
