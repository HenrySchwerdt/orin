// std:time (ADR-0048): durationBetween / instantAfter and the deprecated between / plus, calendar and formatting names.
// Run by tools/test_std.sh with and without contract checking.
import { assertEq, assertEqString } from "std:test";
import {
  milliseconds, seconds, minutes, durationBetween, instantAfter, between, plus, addDuration, toMillis, formatDuration,
  fromMillis, toInstant, formatIso
} from "std:time";

@Test
function instantArithmetic(): void {
  assertEq(toMillis(durationBetween(1000, 61000)), 60000, "forward");
  assertEq(toMillis(durationBetween(61000, 1000)), -60000, "backward is negative");
  assertEq(instantAfter(1000, minutes(1)), 61000, "after");
  assertEq(instantAfter(1000, milliseconds(-1)), 999, "negative durations go back");
  assertEq(instantAfter(0, addDuration(seconds(1), milliseconds(5))), 1005, "sum of spans");
  assertEqString(formatDuration(durationBetween(0, 3723005)), "1h 2m 3s 5ms", "format");
}

@Test
function deprecatedNamesAgree(): void {
  assertEq(toMillis(between(10, 50)), toMillis(durationBetween(10, 50)), "between");
  assertEq(plus(10, seconds(2)), instantAfter(10, seconds(2)), "plus");
}

@Test
function calendarRoundTrip(): void {
  const t = 1709211845006;
  const dt = fromMillis(t);
  assertEq(dt.year, 2024, "year");
  assertEq(dt.month, 2, "month");
  assertEq(dt.day, 29, "day");
  assertEq(toInstant(dt).unwrap(), t, "back to the instant");
  assertEqString(formatIso(t), "2024-02-29T13:04:05.006Z", "ISO");
}
