// @Test functions are type-checked but erased from ordinary builds (ADR-0024): they are not emitted and
// nothing they use is. tools/test_annotation_erasure.py compiles this file with and without them and
// requires byte-identical output.
import { assert, assertEq, assertEqString } from "std:test";

type Pair = { a: int; b: int; };

function add(a: int, b: int): int {
  return a + b;
}

@Test
function addsTwo(): void {
  assertEq(add(1, 2), 3, "1 + 2");
}

@Test
function usesGenericsAndClosures(): void {
  const xs = [1, 2, 3];
  const ys = xs.map(x => x * 2);
  assertEq(ys.length.toInt(), 3, "length");
  assert(ys[2] == 6, "last");
  const p = Pair { a: 1, b: 2 };
  assertEq(add(p.a, p.b), 3, "pair");
  assertEqString("test-only literal that must not reach the output", "test-only literal that must not reach the output", "str");
}

@Test
export function failsOnPurpose(): void {
  assertEq(add(1, 1), 3, "this test fails, but only `orin test` ever runs it");
}

function main(): void {
  console.log(add(20, 22).toString());
}
