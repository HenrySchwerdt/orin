// $rt/rt -- the first module of the runtime core written in Orin (ADR-0052 Addendum A, step R3d.0; spec 19 section 3).
//
// `runtime/core/*.or` is the embedded root `$rt` (tools/embed_prelude.py, compiler/loader/prelude.or). Its entry
// `$rt/module.or` is loaded into every compiled program like `$std`; unreferenced functions are pruned (compiler/opt/prune.or),
// so a program that does not call into it is unchanged. Only modules of this root may import the internal module `std:core`
// (the core operations of hir/coreops.or). The L1 object-model modules (layout, heap, object, rc, stats) of R3d.1..R3d.5 land here.

// The version of the object layout that the L1 modules assume (spec 19; rule 3 of Addendum A section 2). It changes with the
// frozen offsets, never otherwise.
export function rtLayoutVersion(): usize {
  return 1;
}
