// `file://` URI <-> filesystem path (POSIX only; Windows drive paths are not handled).

function hexVal(c: int): int {
  if (c >= 48 && c <= 57) {
    return c - 48;
  }
  if (c >= 97 && c <= 102) {
    return c - 87;
  }
  if (c >= 65 && c <= 70) {
    return c - 55;
  }
  return -1;
}

function percentDecode(s: string): string {
  let parts: string[] = [];
  let run: usize = 0;
  let i: usize = 0;
  while (i < s.length) {
    if (s.charCodeAt(i) == 37 && i + 2 < s.length && hexVal(s.charCodeAt(i + 1)) >= 0 && hexVal(s.charCodeAt(i + 2)) >= 0) {
      parts.push(s.substring(run, i));
      parts.push(String.fromCharCode(hexVal(s.charCodeAt(i + 1)) * 16 + hexVal(s.charCodeAt(i + 2))));
      i += 3;
      run = i;
    } else {
      i += 1;
    }
  }
  parts.push(s.substring(run, s.length));
  return parts.join("");
}

function hexDigit(n: int): string {
  if (n < 10) {
    return String.fromCharCode(48 + n);
  }
  return String.fromCharCode(55 + n);
}

function isUnreserved(c: int): bool {
  return (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122)
    || c == 45 || c == 46 || c == 95 || c == 126 || c == 47;
}

// Path of a `file://` URI, or None for other schemes.
export function uriToPath(uri: string): Option<string> {
  if (!uri.startsWith("file://")) {
    return None;
  }
  return Some(percentDecode(uri.substring(7, uri.length)));
}

export function pathToUri(path: string): string {
  let parts: string[] = ["file://"];
  let i: usize = 0;
  while (i < path.length) {
    const c = path.charCodeAt(i);
    if (isUnreserved(c)) {
      parts.push(path.charAt(i));
    } else {
      parts.push("%" + hexDigit(c / 16) + hexDigit(c % 16));
    }
    i += 1;
  }
  return parts.join("");
}
