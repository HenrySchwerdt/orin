// Orin for TypeScript developers: integers, explicit conversions, template literals.
function main(): void {
  const n: int = 200;
  const b: u8 = n.toU8();
  const f: float = n.toFloat() / 3.0;
  console.log(`${b} ${f}`);
  console.log(`${7 / 2} ${-7 / 2} ${-7 % 3} ${7.0 / 2.0}`);
  const big: int = 9223372036854775807;
  match (big.checkedAdd(1)) {
    Some(v) => { console.log(`${v}`); },
    None => { console.log("overflow"); },
  }
  console.log(`${big.wrappingAdd(1)}`);
  const nan = 0.0 / 0.0;
  console.log(`${nan == nan} ${1 < 2 && "a" == "a"}`);
}
