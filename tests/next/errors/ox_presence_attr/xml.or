// A minimal Markup provider without presence attributes and with a static-only `script-` prefix.
import { Markup, AttrRule, Escape } from "std:ox";

@Sealed
export type Xml = { xml: string; };

export function escapeXml(s: string): string {
  return s;
}

export function wrapXml(markup: string): Xml {
  return Xml { xml: markup };
}

export function embedXml(x: Xml): string {
  return x.xml;
}

export function embedAllXml(xs: Xml[]): string {
  let out = "";
  for (const x of xs) {
    out += x.xml;
  }
  return out;
}

export function ox(): Markup<Xml> {
  return Markup<Xml> {
    wrap: wrapXml,
    embed: embedXml,
    embedAll: embedAllXml,
    text: escapeXml,
    attr: escapeXml,
    rules: [AttrRule { names: [], prefix: "script-", convert: None }],
    escapes: [Escape { char: "<", encoded: "&lt;" }],
    voidTags: ["br"],
    voidEnd: "/>",
    rawTextTags: [],
    presenceAttrs: false,
  };
}
