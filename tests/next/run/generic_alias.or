type Pair<A, B> = { first: A; second: B; };
type List<T> = T[];
type Entry<V> = Pair<string, V>;
type Grid<T> = List<List<T>>;

function entries(): List<Entry<int>> {
  return [Pair { first: "a", second: 1 }, Pair { first: "b", second: 2 }];
}

function total(es: List<Entry<int>>): int {
  let sum = 0;
  for (const e of es) {
    sum += e.second;
  }
  return sum;
}

function firstOf<T>(xs: List<T>): Option<T> {
  return xs.get(0);
}

function cells<T>(g: Grid<T>): usize {
  let n: usize = 0;
  for (const row of g) {
    n += row.length;
  }
  return n;
}

function main(): void {
  console.log(total(entries()).toString());
  console.log(firstOf(entries()).unwrap().first);
  const g: Grid<int> = [[1, 2], [3], []];
  console.log(cells(g).toString());
  const names: List<string> = ["x", "y"];
  console.log(firstOf(names).unwrap());
}
