// small deterministic n-body step loop (floats in records and arrays, sqrt)
import { sqrt } from "std:math";

type Body = { x: float; y: float; z: float; vx: float; vy: float; vz: float; mass: float; };

function energy(bs: Body[]): float {
  let e = 0.0;
  let i: usize = 0;
  while (i < bs.length) {
    const b = bs[i];
    e += 0.5 * b.mass * (b.vx * b.vx + b.vy * b.vy + b.vz * b.vz);
    let j = i + 1;
    while (j < bs.length) {
      const c = bs[j];
      const dx = b.x - c.x;
      const dy = b.y - c.y;
      const dz = b.z - c.z;
      e -= b.mass * c.mass / sqrt(dx * dx + dy * dy + dz * dz);
      j += 1;
    }
    i += 1;
  }
  return e;
}

function advance(start: Body[], dt: float): Body[] {
  let bs = start;
  let i: usize = 0;
  while (i < bs.length) {
    let j = i + 1;
    while (j < bs.length) {
      const dx = bs[i].x - bs[j].x;
      const dy = bs[i].y - bs[j].y;
      const dz = bs[i].z - bs[j].z;
      const d2 = dx * dx + dy * dy + dz * dz;
      const mag = dt / (d2 * sqrt(d2));
      bs[i].vx -= dx * bs[j].mass * mag;
      bs[i].vy -= dy * bs[j].mass * mag;
      bs[i].vz -= dz * bs[j].mass * mag;
      bs[j].vx += dx * bs[i].mass * mag;
      bs[j].vy += dy * bs[i].mass * mag;
      bs[j].vz += dz * bs[i].mass * mag;
      j += 1;
    }
    i += 1;
  }
  let k: usize = 0;
  while (k < bs.length) {
    bs[k].x += dt * bs[k].vx;
    bs[k].y += dt * bs[k].vy;
    bs[k].z += dt * bs[k].vz;
    k += 1;
  }
  return bs;
}

function main(): void {
  let bs: Body[] = [
    Body { x: 0.0, y: 0.0, z: 0.0, vx: 0.0, vy: 0.0, vz: 0.0, mass: 39.47841760435743 },
    Body { x: 4.84, y: -1.16, z: -0.10, vx: 0.606, vy: 2.81, vz: -0.02, mass: 0.037 },
    Body { x: 8.34, y: 4.12, z: -0.4, vx: -1.01, vy: 1.82, vz: 0.008, mass: 0.011 }
  ];
  console.log(energy(bs).toString());
  let s = 0;
  while (s < 1000) {
    bs = advance(bs, 0.01);
    s += 1;
  }
  console.log(energy(bs).toString());
}
