// Tests for std:http (parser rules, rejections, smuggling vectors, limits, API). Run with
// `orin test tests/std/http_test.or` (contracts are checked by default) and with `--no-contracts`.
// See tools/test_std.sh. Split-at-every-byte tests: http_split_test.or; serializer round trip, differential and
// fuzz tests: http_prop_test.or.
import { assert, assertEq, assertEqUsize, assertEqString, assertEqBool, fail } from "std:test";
import { Bytes, fromString, empty } from "std:bytes";
import {
  Request, Response, Headers, Status, HttpLimits, ParseResult, NeedMore, Done, Failed, Method, Get, Head, Post, Put,
  Delete, Connect, Options, Trace, Patch, Ext, HttpVersion, Http10, Http11, RequestParser, ResponseParser, HttpError,
  defaultLimits, parseRequest, parseResponse, parseResponseToEof, methodName, methodFromToken, isValidMethod,
  isValidTarget, methodEquals, httpErrorKindName, httpErrorKindText, versionText, isToken, isFieldValue,
  isReasonPhrase, isHostValue, isTokenChar, isFieldByte, charClass, eqIgnoreCase, toLowerAscii, parseContentLength,
  emptyHeaders, tryHeaders, standardStatus, standardReason,
  statusHasNoBody, RequestParts, ResponseParts, makeStatus, makeRequest, makeResponse, headersFromLists, reasonName, reasonText,
  isValidLimits, InvalidMethod, InvalidHeaderName, InvalidHeaderValue, MismatchedLists, edgeAllowed, stateName, hexString, httpError, headerErrorMessage,
  serializeRequest, serializeResponse, ToHead, ToOther, httpErrorMessage
} from "std:http";

function bs(s: string): Bytes {
  return fromString(s);
}

function tryRequest(m: Method, target: string, v: HttpVersion, h: Headers, body: Bytes, trailers: Headers): Result<Request, HttpError> {
  return Request.tryNew(RequestParts { method: m, target: target, version: v, headers: h, body: body, trailers: trailers });
}

function tryResponse(st: Status, v: HttpVersion, h: Headers, body: Bytes, trailers: Headers, forHead: bool): Result<Response, HttpError> {
  return Response.tryNew(ResponseParts { status: st, version: v, headers: h, body: body, trailers: trailers, forHead: forHead });
}

function kindOf(e: HttpError): string {
  return httpErrorKindName(e.kind);
}

function lim(startLine: usize, count: usize, line: usize, head: usize, chunkLine: usize, body: usize): HttpLimits {
  return HttpLimits { maxStartLine: startLine, maxHeaderCount: count, maxHeaderLine: line, maxHeaderBytes: head, maxChunkLine: chunkLine, maxBody: body };
}

// A complete request that must parse; returns it (and checks that all of the bytes were used).
function okReq(msg: string): Request {
  const r = parseRequest(bs(msg), defaultLimits());
  return match (r) {
    Done(q, used) => q,
    NeedMore => failReq("NeedMore for: " + msg),
    Failed(e) => failReq("refused: " + httpErrorMessage(e) + " for: " + msg)
  };
}

function failReq(why: string): Request {
  fail(why);
  return new Request(Get, "/", Http10, emptyHeaders(), empty(), emptyHeaders());
}

function okRes(msg: string, forHead: bool): Response {
  const r = parseResponseToEof(bs(msg), defaultLimits(), (forHead ? ToHead : ToOther));
  return match (r) {
    Done(q, used) => q,
    NeedMore => failRes("NeedMore for: " + msg),
    Failed(e) => failRes("refused: " + httpErrorMessage(e) + " for: " + msg)
  };
}

function failRes(why: string): Response {
  fail(why);
  return new Response(standardStatus(200), Http10, emptyHeaders(), empty(), emptyHeaders(), false);
}

// The request must be refused with `reason` at byte `pos`.
function expectFail(msg: string, reason: string, pos: usize): void {
  expectFailWith(msg, defaultLimits(), reason, pos);
}

function expectFailWith(msg: string, l: HttpLimits, reason: string, pos: usize): void {
  const r = parseRequest(bs(msg), l);
  match (r) {
    Failed(e) => {
      assertEqString(httpErrorKindName(e.kind), reason, "reason for: " + msg);
      assertEqUsize(e.offset, pos, "position for: " + msg);
      assert(httpErrorMessage(e).length > 0, "message");
    },
    NeedMore => { fail("NeedMore, expected " + reason + " for: " + msg); },
    Done(q, used) => { fail("accepted, expected " + reason + " for: " + msg); }
  };
}

function expectResFail(msg: string, forHead: bool, reason: string, pos: usize): void {
  const r = parseResponseToEof(bs(msg), defaultLimits(), (forHead ? ToHead : ToOther));
  match (r) {
    Failed(e) => {
      assertEqString(httpErrorKindName(e.kind), reason, "reason for: " + msg);
      assertEqUsize(e.offset, pos, "position for: " + msg);
    },
    NeedMore => { fail("NeedMore, expected " + reason + " for: " + msg); },
    Done(q, used) => { fail("accepted, expected " + reason + " for: " + msg); }
  };
}

function expectNeedMore(msg: string): void {
  const r = parseRequest(bs(msg), defaultLimits());
  match (r) {
    NeedMore => { assert(true, ""); },
    Failed(e) => { fail("refused: " + httpErrorMessage(e) + " for: " + msg); },
    Done(q, used) => { fail("complete, expected NeedMore for: " + msg); }
  };
}

// "NeedMore", "Done" or the name of the failure reason.
function outcome(r: ParseResult<Request>): string {
  return match (r) {
    NeedMore => "NeedMore",
    Done(q, used) => "Done",
    Failed(e) => httpErrorKindName(e.kind)
  };
}

function rep(s: string, n: usize): string {
  let parts: string[] = [];
  let i: usize = 0;
  while (i < n) {
    parts.push(s);
    i += 1;
  }
  return parts.join("");
}

const PRE: string = "GET / HTTP/1.1\r\nHost: a\r\n";
const POSTPRE: string = "POST / HTTP/1.1\r\nHost: a\r\n";

// ------------------------------------------------------------------------------------ character classes

// An independent definition of the sets from RFC 9110 §5.6.2 / §5.5 (explicit character lists).
function refIsTchar(c: int): bool {
  const s = "!#$%&'*+-.^_`|~0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ";
  let i: usize = 0;
  while (i < s.length) {
    if (s.charCodeAt(i) == c) {
      return true;
    }
    i += 1;
  }
  return false;
}

@Test
function classTableMatchesTheRfcSets(): void {
  let c = 0;
  while (c < 256) {
    assertEqBool(isTokenChar(c), refIsTchar(c), "tchar " + c.toString());
    const fieldByte = c == 9 || (c >= 32 && c <= 126) || c >= 128;
    assertEqBool(isFieldByte(c), fieldByte, "field byte " + c.toString());
    const k = charClass(c);
    assertEqBool(k == 13, c >= 48 && c <= 57, "digit class " + c.toString());
    assertEqBool(k >= 12, (c >= 48 && c <= 57) || (c >= 65 && c <= 70) || (c >= 97 && c <= 102), "hex class " + c.toString());
    assertEqBool(k == 1, c == 10, "LF class");
    assertEqBool(k == 2, c == 13, "CR class");
    assertEqBool(k == 3, c == 9, "HTAB class");
    assertEqBool(k == 4, c == 32, "SP class");
    assertEqBool(k == 7, c == 58, "colon class");
    assertEqBool(k == 8, c == 59, "semicolon class");
    assertEqBool(k == 0, c < 32 && c != 9 && c != 10 && c != 13 || c == 127, "CTL class " + c.toString());
    assertEqBool(k == 5, c >= 128, "obs-text class");
    c += 1;
  }
}

@Test
function tokenFieldValueAndReasonPredicates(): void {
  assertEqBool(isToken("Content-Length"), true, "token");
  assertEqBool(isToken(""), false, "empty token");
  assertEqBool(isToken("a b"), false, "space");
  assertEqBool(isToken("a:b"), false, "colon");
  assertEqBool(isToken("a\r"), false, "CR");
  assertEqBool(isToken("\xe9"), false, "obs-text");
  assertEqBool(isFieldValue(""), true, "empty value");
  assertEqBool(isFieldValue("a b\tc"), true, "inner blanks");
  assertEqBool(isFieldValue(" a"), false, "leading blank");
  assertEqBool(isFieldValue("a "), false, "trailing blank");
  assertEqBool(isFieldValue("a\tb\xe9\xff"), true, "obs-text");
  assertEqBool(isFieldValue("a\rb"), false, "CR");
  assertEqBool(isFieldValue("a\nb"), false, "LF");
  assertEqBool(isFieldValue("a\x00b"), false, "NUL");
  assertEqBool(isFieldValue("a\x7fb"), false, "DEL");
  assertEqBool(isFieldValue("a\x01b"), false, "SOH");
  assertEqBool(isReasonPhrase(""), true, "empty reason");
  assertEqBool(isReasonPhrase(" OK "), true, "blanks kept");
  assertEqBool(isReasonPhrase("O\nK"), false, "LF");
  assertEqBool(isHostValue("example.com:8080"), true, "host");
  assertEqBool(isHostValue("[::1]:80"), true, "ipv6");
  assertEqBool(isHostValue(""), true, "empty host");
  assertEqBool(isHostValue("a b"), false, "space");
  assertEqBool(isHostValue("a/b"), false, "slash");
  assertEqBool(isHostValue("u@h"), false, "userinfo");
  assertEqBool(isHostValue("a,b"), true, "comma is a sub-delim");
}

@Test
function caseInsensitiveHelpers(): void {
  assertEqBool(eqIgnoreCase("Content-Length", "content-length"), true, "eq");
  assertEqBool(eqIgnoreCase("Host", "Hosu"), false, "ne");
  assertEqBool(eqIgnoreCase("Host", "Hos"), false, "length");
  assertEqBool(eqIgnoreCase("@", "`"), false, "no wrap-around: 0x40 vs 0x60");
  assertEqBool(eqIgnoreCase("[", "{"), false, "no wrap-around: 0x5b vs 0x7b");
  assertEqString(toLowerAscii("Content-TYPE\xc9"), "content-type\xc9", "lower keeps non-ASCII");
  assertEqUsize(toLowerAscii("").length, 0, "empty");
}

@Test
function contentLengthParsing(): void {
  assertEqUsize(parseContentLength("0").unwrap(), 0, "0");
  assertEqUsize(parseContentLength("007").unwrap(), 7, "leading zeros");
  assertEqUsize(parseContentLength("999999999999999999").unwrap(), 999999999999999999, "18 digits");
  assertEqBool(parseContentLength("1000000000000000000").isNone(), true, "19 digits");
  assertEqBool(parseContentLength("").isNone(), true, "empty");
  assertEqBool(parseContentLength("-1").isNone(), true, "negative");
  assertEqBool(parseContentLength("+1").isNone(), true, "plus");
  assertEqBool(parseContentLength("1 ").isNone(), true, "blank");
  assertEqBool(parseContentLength("1,1").isNone(), true, "list");
  assertEqBool(parseContentLength("0x10").isNone(), true, "hex");
  assertEqBool(parseContentLength("1e3").isNone(), true, "exponent");
}

// ----------------------------------------------------------------------------------------------- methods

@Test
function methods(): void {
  assertEqString(methodName(methodFromToken("GET").unwrap()), "GET", "GET");
  assertEqString(methodName(methodFromToken("PATCH").unwrap()), "PATCH", "PATCH");
  assertEqString(methodName(methodFromToken("CONNECT").unwrap()), "CONNECT", "CONNECT");
  assertEqString(methodName(methodFromToken("PURGE").unwrap()), "PURGE", "extension");
  assertEqString(methodName(methodFromToken("get").unwrap()), "get", "methods are case-sensitive");
  assertEqBool(methodFromToken("").isNone(), true, "empty");
  assertEqBool(methodFromToken("G T").isNone(), true, "space");
  assertEqBool(isValidMethod(Ext("GET")), false, "Ext(GET) is not canonical");
  assertEqBool(isValidMethod(Ext("get")), true, "Ext(get)");
  assertEqBool(isValidMethod(Ext("A B")), false, "Ext with a blank");
  assertEqBool(isValidMethod(Ext("")), false, "Ext empty");
  assertEqBool(methodEquals(Get, methodFromToken("GET").unwrap()), true, "equals");
  assertEqBool(methodEquals(Get, Head), false, "differs");
  // the parser maps a standard token to its variant
  const q = okReq("DELETE /x HTTP/1.1\r\nHost: a\r\n\r\n");
  assertEqBool(methodEquals(q.method(), Delete), true, "DELETE variant");
  const e = okReq("PURGE /x HTTP/1.1\r\nHost: a\r\n\r\n");
  assertEqBool(methodEquals(e.method(), Ext("PURGE")), true, "PURGE extension");
}

@Test
function requestTargetForms(): void {
  assertEqBool(isValidTarget(Get, "/"), true, "origin");
  assertEqBool(isValidTarget(Get, "/a/b?c=d&e=%20"), true, "origin with query");
  assertEqBool(isValidTarget(Get, "http://example.com/x"), true, "absolute");
  assertEqBool(isValidTarget(Get, "HTTPS://example.com"), true, "absolute upper-case scheme");
  assertEqBool(isValidTarget(Get, "foo"), false, "no slash");
  assertEqBool(isValidTarget(Get, ""), false, "empty");
  assertEqBool(isValidTarget(Get, "/a b"), false, "space");
  assertEqBool(isValidTarget(Get, "/a#frag"), false, "fragment");
  assertEqBool(isValidTarget(Get, "/\xc3\xa9"), false, "raw non-ASCII");
  assertEqBool(isValidTarget(Get, "/a\x01"), false, "control character");
  assertEqBool(isValidTarget(Get, "*"), false, "asterisk-form only for OPTIONS");
  assertEqBool(isValidTarget(Options, "*"), true, "OPTIONS *");
  assertEqBool(isValidTarget(Options, "/x"), true, "OPTIONS origin");
  assertEqBool(isValidTarget(Connect, "example.com:443"), true, "CONNECT authority");
  assertEqBool(isValidTarget(Connect, "/x"), false, "CONNECT origin");
  assertEqBool(isValidTarget(Connect, ""), false, "CONNECT empty");
  assertEqBool(isValidTarget(Get, "example.com:443"), false, "authority-form only for CONNECT");
  assertEqBool(isValidTarget(Get, "ht!tp://x"), false, "bad scheme");
  assertEqBool(isValidTarget(Get, "://x"), false, "empty scheme");
}

// ----------------------------------------------------------------------------------------------- Headers

@Test
function headersBasics(): void {
  let h = emptyHeaders();
  assertEqUsize(h.size(), 0, "empty");
  assertEqBool(h.add("Content-Type", "text/plain").isOk(), true, "add");
  assertEqBool(h.add("X-A", "1").isOk(), true, "add 2");
  assertEqBool(h.add("x-a", "2").isOk(), true, "add same name, other case");
  assertEqUsize(h.size(), 3, "count");
  assertEqString(h.get("content-type").unwrap(), "text/plain", "case-insensitive get");
  assertEqString(h.get("X-A").unwrap(), "1", "first of several");
  assertEqUsize(h.countOf("X-a"), 2, "countOf");
  const all = h.getAll("X-A");
  assertEqUsize(all.length, 2, "getAll length");
  assertEqString(all[0], "1", "getAll order 0");
  assertEqString(all[1], "2", "getAll order 1");
  assertEqString(h.nameAt(2), "x-a", "names are kept as written");
  assertEqBool(h.has("nope"), false, "has");
  assertEqBool(h.get("nope").isNone(), true, "get none");
  assertEqBool(h.add("Bad Name", "x").isErr(), true, "invalid name");
  assertEqBool(h.add("", "x").isErr(), true, "empty name");
  assertEqBool(h.add("N", "a\r\nInjected: 1").isErr(), true, "CRLF in a value (header injection)");
  assertEqBool(h.add("N", "a\nb").isErr(), true, "LF");
  assertEqBool(h.add("N", "a\rb").isErr(), true, "CR");
  assertEqBool(h.add("N", "a\x00b").isErr(), true, "NUL");
  assertEqBool(h.add("N", " a").isErr(), true, "leading blank");
  assertEqBool(h.add("N\r\nX", "a").isErr(), true, "CRLF in a name");
  assertEqUsize(h.size(), 3, "failed adds change nothing");
  assertEqBool(h.add("Empty", "").isOk(), true, "empty value is valid");
}

@Test
function headersSetRemoveEquals(): void {
  let h = emptyHeaders();
  h.add("A", "1").unwrap();
  h.add("B", "2").unwrap();
  h.add("a", "3").unwrap();
  assertEqBool(h.set("A", "9").isOk(), true, "set");
  assertEqUsize(h.countOf("a"), 1, "set leaves one");
  assertEqString(h.get("a").unwrap(), "9", "set value");
  assertEqUsize(h.size(), 2, "count after set");
  assertEqBool(h.set("A", "x\ny").isErr(), true, "set validates");
  assertEqString(h.get("A").unwrap(), "9", "failed set changes nothing");
  assertEqUsize(h.remove("b"), 1, "remove returns the count");
  assertEqUsize(h.remove("b"), 0, "remove of an absent name");
  assertEqUsize(h.size(), 1, "count after remove");
  let g = emptyHeaders();
  g.add("A", "9").unwrap();
  assertEqBool(h.equals(g), true, "equal");
  g.add("X", "1").unwrap();
  assertEqBool(h.equals(g), false, "different length");
  let k = emptyHeaders();
  k.add("a", "9").unwrap();
  assertEqBool(h.equals(k), false, "names compare as written");
  let m = emptyHeaders();
  m.add("A", "8").unwrap();
  assertEqBool(h.equals(m), false, "different value");
}

@Test
function headersFromListsChecksEverything(): void {
  assertEqBool(tryHeaders(["A", "B"], ["1", "2"]).isOk(), true, "ok");
  assertEqBool(tryHeaders(["A"], ["1", "2"]).isErr(), true, "length mismatch");
  assertEqBool(tryHeaders(["A B"], ["1"]).isErr(), true, "bad name");
  assertEqBool(tryHeaders(["A"], ["1\r\n"]).isErr(), true, "bad value");
  assertEqString(headerErrorMessage(tryHeaders(["A B"], ["1"]).unwrapErr()).substring(0, 13), "invalid field", "message");
}

@Test
function headersOrderIsKept(): void {
  const q = okReq("GET / HTTP/1.1\r\nZ: 1\r\nHost: a\r\nA: 2\r\nz: 3\r\n\r\n");
  const h = q.headers();
  assertEqUsize(h.size(), 4, "count");
  assertEqString(h.nameAt(0), "Z", "order 0");
  assertEqString(h.nameAt(1), "Host", "order 1");
  assertEqString(h.nameAt(2), "A", "order 2");
  assertEqString(h.nameAt(3), "z", "order 3");
  assertEqString(h.valueAt(3), "3", "value 3");
  assertEqUsize(h.countOf("Z"), 2, "multiple values");
}

// ------------------------------------------------------------------------------------------------ Status

@Test
function statusInvariants(): void {
  const s = new Status(404, "Not Found");
  assertEq(s.code(), 404, "code");
  assertEqString(s.reason(), "Not Found", "reason");
  assertEqBool(Status.tryNew(99, "x").isErr(), true, "99");
  assertEqBool(Status.tryNew(600, "x").isErr(), true, "600");
  assertEqBool(Status.tryNew(100, "x").isOk(), true, "100");
  assertEqBool(Status.tryNew(599, "").isOk(), true, "599, empty reason");
  assertEqBool(Status.tryNew(200, "O\r\nK").isErr(), true, "CRLF in the reason phrase");
  assertEqBool(Status.tryNew(-1, "x").isErr(), true, "negative");
  assertEqString(standardStatus(200).reason(), "OK", "OK");
  assertEqString(standardStatus(599).reason(), "Unknown Status", "unregistered");
  assertEqString(standardReason(418).unwrap(), "I'm a teapot", "418");
  assertEqBool(standardReason(299).isNone(), true, "unregistered is None");
  assertEqBool(statusHasNoBody(100), true, "100");
  assertEqBool(statusHasNoBody(199), true, "199");
  assertEqBool(statusHasNoBody(200), false, "200");
  assertEqBool(statusHasNoBody(204), true, "204");
  assertEqBool(statusHasNoBody(205), false, "205");
  assertEqBool(statusHasNoBody(304), true, "304");
  assertEqBool(statusHasNoBody(404), false, "404");
  assertEqBool(standardStatus(204).hasNoBody(), true, "hasNoBody");
  assertEqBool(new Status(200, "A").equals(new Status(200, "A")), true, "equals");
  assertEqBool(new Status(200, "A").equals(new Status(200, "B")), false, "different reason");
  assertEqBool(new Status(200, "A").equals(new Status(201, "A")), false, "different code");
}

// ---------------------------------------------------------------------------------- message construction

@Test
function requestConstructionRules(): void {
  let h = emptyHeaders();
  h.add("Host", "a").unwrap();
  assertEqBool(tryRequest(Get, "/", Http11, h, empty(), emptyHeaders()).isOk(), true, "valid");
  assertEqBool(tryRequest(Get, "/", Http11, emptyHeaders(), empty(), emptyHeaders()).isErr(), true, "HTTP/1.1 needs Host");
  assertEqBool(tryRequest(Get, "/", Http10, emptyHeaders(), empty(), emptyHeaders()).isOk(), true, "HTTP/1.0 needs no Host");
  assertEqBool(tryRequest(Get, "x", Http11, h, empty(), emptyHeaders()).isErr(), true, "bad target");
  assertEqBool(tryRequest(Ext("GET"), "/", Http11, h, empty(), emptyHeaders()).isErr(), true, "non-canonical method");
  assertEqBool(tryRequest(Get, "/", Http11, h, bs("x"), emptyHeaders()).isErr(), true, "body without framing");
  let h2 = emptyHeaders();
  h2.add("Host", "a").unwrap();
  h2.add("Host", "b").unwrap();
  assertEqBool(tryRequest(Get, "/", Http11, h2, empty(), emptyHeaders()).isErr(), true, "two Hosts");
  let h3 = emptyHeaders();
  h3.add("Host", "a").unwrap();
  h3.add("Content-Length", "3").unwrap();
  assertEqBool(tryRequest(Post, "/", Http11, h3, bs("abc"), emptyHeaders()).isOk(), true, "CL matches");
  assertEqBool(tryRequest(Post, "/", Http11, h3, bs("ab"), emptyHeaders()).isErr(), true, "CL does not match");
  h3.add("Transfer-Encoding", "chunked").unwrap();
  assertEqBool(tryRequest(Post, "/", Http11, h3, bs("abc"), emptyHeaders()).isErr(), true, "CL and TE");
  assertEqString(kindOf(tryRequest(Post, "/", Http11, h3, bs("abc"), emptyHeaders()).unwrapErr()), "ContentLengthWithTransferEncoding", "kind");
}

@Test
function responseConstructionRules(): void {
  let h = emptyHeaders();
  assertEqBool(tryResponse(standardStatus(200), Http11, h, empty(), emptyHeaders(), false).isOk(), true, "valid");
  assertEqBool(tryResponse(standardStatus(200), Http11, h, bs("x"), emptyHeaders(), false).isOk(), true, "close-delimited body");
  assertEqBool(tryResponse(standardStatus(204), Http11, h, bs("x"), emptyHeaders(), false).isErr(), true, "204 with a body");
  assertEqBool(tryResponse(standardStatus(200), Http11, h, bs("x"), emptyHeaders(), true).isErr(), true, "HEAD response with a body");
  let c = emptyHeaders();
  c.add("Content-Length", "5").unwrap();
  assertEqBool(tryResponse(standardStatus(200), Http11, c, empty(), emptyHeaders(), true).isOk(), true, "HEAD response with CL");
  assertEqBool(tryResponse(standardStatus(304), Http11, c, empty(), emptyHeaders(), false).isOk(), true, "304 with CL");
  assertEqBool(tryResponse(standardStatus(204), Http11, c, empty(), emptyHeaders(), false).isErr(), true, "204 with CL");
  assertEqBool(tryResponse(standardStatus(101), Http11, c, empty(), emptyHeaders(), false).isErr(), true, "101 with CL");
  assertEqBool(tryResponse(standardStatus(200), Http11, c, bs("12345"), emptyHeaders(), false).isOk(), true, "CL matches");
  assertEqBool(tryResponse(standardStatus(200), Http11, c, bs("123"), emptyHeaders(), false).isErr(), true, "CL mismatch");
  const r = tryResponse(standardStatus(204), Http11, h, empty(), emptyHeaders(), false).unwrap();
  assertEqBool(r.isBodyless(), true, "204 is bodyless");
  assertEqBool(r.isForHead(), false, "not for HEAD");
}

// ------------------------------------------------------------------------------------- valid requests

@Test
function parsesASimpleGet(): void {
  const msg = "GET /index.html?x=1 HTTP/1.1\r\nHost: example.com\r\nUser-Agent: orin\r\nAccept: */*\r\n\r\n";
  const r = parseRequest(bs(msg), defaultLimits());
  match (r) {
    Done(q, used) => {
      assertEqUsize(used, msg.length, "all bytes used");
      assertEqString(methodName(q.method()), "GET", "method");
      assertEqString(q.target(), "/index.html?x=1", "target");
      assertEqString(versionText(q.version()), "HTTP/1.1", "version");
      assertEqUsize(q.headers().size(), 3, "headers");
      assertEqString(q.headers().get("user-agent").unwrap(), "orin", "ua");
      assertEqUsize(q.body().length(), 0, "no body");
      assertEqBool(q.isChunked(), false, "not chunked");
    },
    NeedMore => { fail("need more"); },
    Failed(e) => { fail(httpErrorMessage(e)); }
  };
}

@Test
function parsesContentLengthBodies(): void {
  const q = okReq("POST /submit HTTP/1.1\r\nHost: a\r\nContent-Length: 11\r\n\r\nhello world");
  assertEqString(q.body().toRawString(), "hello world", "body");
  assertEqBool(methodEquals(q.method(), Post), true, "POST");
  const z = okReq("POST / HTTP/1.1\r\nHost: a\r\nContent-Length: 0\r\n\r\n");
  assertEqUsize(z.body().length(), 0, "zero length");
  const lz = okReq("POST / HTTP/1.1\r\nHost: a\r\ncontent-length: 003\r\n\r\nabc");
  assertEqString(lz.body().toRawString(), "abc", "leading zeros, lower-case name");
  const bin = okReq("PUT / HTTP/1.1\r\nHost: a\r\nContent-Length: 4\r\n\r\n\x00\r\n\xff");
  assertEqString(bin.body().toHex(), "000d0aff", "binary body");
}

@Test
function parsesChunkedBodies(): void {
  const q = okReq("POST / HTTP/1.1\r\nHost: a\r\nTransfer-Encoding: chunked\r\n\r\n5\r\nhello\r\n6\r\n world\r\n0\r\n\r\n");
  assertEqString(q.body().toRawString(), "hello world", "decoded body");
  assertEqBool(q.isChunked(), true, "chunked");
  assertEqUsize(q.trailers().size(), 0, "no trailers");
  const u = okReq("POST / HTTP/1.1\r\nHost: a\r\nTransfer-Encoding: Chunked\r\n\r\nA\r\n0123456789\r\nff\r\n" + rep("x", 255) + "\r\n0\r\n\r\n");
  assertEqUsize(u.body().length(), 265, "hex sizes, any case");
  const e = okReq("POST / HTTP/1.1\r\nHost: a\r\nTransfer-Encoding: chunked\r\n\r\n0\r\n\r\n");
  assertEqUsize(e.body().length(), 0, "empty chunked body");
  const lz = okReq("POST / HTTP/1.1\r\nHost: a\r\nTransfer-Encoding: chunked\r\n\r\n0005\r\nhello\r\n000\r\n\r\n");
  assertEqString(lz.body().toRawString(), "hello", "leading zeros in sizes");
}

@Test
function chunkExtensionsAreIgnoredAndTrailersParsed(): void {
  const msg = "POST / HTTP/1.1\r\nHost: a\r\nTransfer-Encoding: chunked\r\n\r\n"
    + "5;name=value\r\nhello\r\n"
    + "3 ; a=\"q;uo\\\"te\" ;b\r\nabc\r\n"
    + "2\t;x\r\nxy\r\n"
    + "0;last=1\r\nX-Checksum: abc123\r\nX-Other:   spaced  \r\n\r\n";
  const q = okReq(msg);
  assertEqString(q.body().toRawString(), "helloabcxy", "body without extensions");
  assertEqUsize(q.trailers().size(), 2, "two trailers");
  assertEqString(q.trailers().get("x-checksum").unwrap(), "abc123", "trailer");
  assertEqString(q.trailers().get("X-Other").unwrap(), "spaced", "trailer value trimmed");
  assertEqUsize(q.headers().size(), 2, "trailers are not merged into the headers");
  assertEqBool(q.headers().has("X-Checksum"), false, "not in the headers");
}

@Test
function trimsOptionalWhitespaceAroundValues(): void {
  const q = okReq("GET / HTTP/1.1\r\nHost:   a  \t\r\nX-Tab:\tv\t\r\nX-Empty:\r\nX-Blank:   \r\nX-Inner: a \t b\r\n\r\n");
  assertEqString(q.headers().get("host").unwrap(), "a", "host trimmed");
  assertEqString(q.headers().get("x-tab").unwrap(), "v", "tab trimmed");
  assertEqString(q.headers().get("x-empty").unwrap(), "", "empty");
  assertEqString(q.headers().get("x-blank").unwrap(), "", "blank only");
  assertEqString(q.headers().get("x-inner").unwrap(), "a \t b", "inner whitespace kept");
}

@Test
function acceptsObsTextAndVisibleCharactersInValues(): void {
  const q = okReq("GET / HTTP/1.1\r\nHost: a\r\nX-U: caf\xc3\xa9 \xff \"quoted\" (c) [x] {y} <z>\r\n\r\n");
  assertEqString(q.headers().get("x-u").unwrap(), "caf\xc3\xa9 \xff \"quoted\" (c) [x] {y} <z>", "value bytes kept");
}

@Test
function targetsAndVersions(): void {
  assertEqString(okReq("OPTIONS * HTTP/1.1\r\nHost: a\r\n\r\n").target(), "*", "asterisk-form");
  assertEqString(okReq("CONNECT example.com:443 HTTP/1.1\r\nHost: example.com:443\r\n\r\n").target(), "example.com:443", "authority-form");
  assertEqString(okReq("GET http://example.com/a?b HTTP/1.1\r\nHost: example.com\r\n\r\n").target(), "http://example.com/a?b", "absolute-form");
  const old = okReq("GET / HTTP/1.0\r\n\r\n");
  assertEqString(versionText(old.version()), "HTTP/1.0", "HTTP/1.0");
  assertEqUsize(old.headers().size(), 0, "HTTP/1.0 without Host");
  const lower = okReq("get / HTTP/1.0\r\n\r\n");
  assertEqString(methodName(lower.method()), "get", "lower-case method is an extension");
}

@Test
function parsesPipelinedRequestsAndReset(): void {
  const a = "GET /a HTTP/1.1\r\nHost: h\r\n\r\n";
  const b = "POST /b HTTP/1.1\r\nHost: h\r\nContent-Length: 2\r\n\r\nxy";
  const both = bs(a + b);
  let p = new RequestParser(defaultLimits());
  assertEqBool(p.isIdle(), true, "idle at the start");
  const r1 = p.feed(both);
  match (r1) {
    Done(q, used) => {
      assertEqString(q.target(), "/a", "first");
      assertEqUsize(used, a.length, "used covers the first message only");
      assertEqBool(p.isDone(), true, "done");
      assertEqBool(p.isIdle(), false, "not idle after done");
      p.reset();
      assertEqBool(p.isIdle(), true, "idle after reset");
      const r2 = p.feed(both.slice(used, both.length()));
      match (r2) {
        Done(q2, used2) => {
          assertEqString(q2.target(), "/b", "second");
          assertEqString(q2.body().toRawString(), "xy", "second body");
          assertEqUsize(used2, b.length, "second used");
        },
        NeedMore => { fail("second need more"); },
        Failed(e) => { fail(httpErrorMessage(e)); }
      };
    },
    NeedMore => { fail("need more"); },
    Failed(e) => { fail(httpErrorMessage(e)); }
  };
}

@Test
function feedAfterDoneOrFailureIsRefusedWithoutConsuming(): void {
  let p = new RequestParser(defaultLimits());
  p.feed(bs("GET / HTTP/1.0\r\n\r\n"));
  assertEqBool(p.isDone(), true, "done");
  const at = p.consumed();
  const r = p.feed(bs("GET / HTTP/1.0\r\n\r\n"));
  match (r) {
    Failed(e) => { assertEqString(httpErrorKindName(e.kind), "ParserFinished", "after done"); },
    NeedMore => { fail("need more"); },
    Done(q, used) => { fail("done twice"); }
  };
  assertEqUsize(p.consumed(), at, "nothing consumed");
  let f = new RequestParser(defaultLimits());
  f.feed(bs("GET / HTTP/1.1\r\nHost a\r\n\r\n"));
  assertEqBool(f.isFailed(), true, "failed");
  assertEqString(outcome(f.feed(bs("x"))), "SpaceBeforeColon", "sticky error");
  f.reset();
  assertEqBool(f.isIdle(), true, "reset clears the error");
  assertEqString(outcome(f.feed(bs("GET / HTTP/1.0\r\n\r\n"))), "Done", "usable again");
}

// ------------------------------------------------------------------------------------------- equality

function mkReq(m: Method, target: string, v: HttpVersion, names: string[], values: string[], body: string, tn: string[], tv: string[]): Request {
  return tryRequest(m, target, v, tryHeaders(names, values).unwrap(), bs(body), tryHeaders(tn, tv).unwrap()).unwrap();
}

@Test
function requestEqualityComparesEveryPart(): void {
  // a chunked request, so that headers, body and trailers can each differ
  const base = mkReq(Post, "/p", Http11, ["Host", "X", "Transfer-Encoding"], ["a", "1", "chunked"], "ab", ["T"], ["1"]);
  assertEqBool(base.equals(base), true, "reflexive");
  assertEqBool(base.equals(mkReq(Post, "/p", Http11, ["Host", "X", "Transfer-Encoding"], ["a", "1", "chunked"], "ab", ["T"], ["1"])), true, "same parts");
  assertEqBool(base.equals(mkReq(Put, "/p", Http11, ["Host", "X", "Transfer-Encoding"], ["a", "1", "chunked"], "ab", ["T"], ["1"])), false, "method");
  assertEqBool(base.equals(mkReq(Post, "/q", Http11, ["Host", "X", "Transfer-Encoding"], ["a", "1", "chunked"], "ab", ["T"], ["1"])), false, "target");
  assertEqBool(base.equals(mkReq(Post, "/p", Http11, ["Host", "X", "Transfer-Encoding"], ["a", "2", "chunked"], "ab", ["T"], ["1"])), false, "header value");
  assertEqBool(base.equals(mkReq(Post, "/p", Http11, ["Host", "x", "Transfer-Encoding"], ["a", "1", "chunked"], "ab", ["T"], ["1"])), false, "header name spelling");
  assertEqBool(base.equals(mkReq(Post, "/p", Http11, ["X", "Host", "Transfer-Encoding"], ["1", "a", "chunked"], "ab", ["T"], ["1"])), false, "header order");
  assertEqBool(base.equals(mkReq(Post, "/p", Http11, ["Host", "X", "Transfer-Encoding"], ["a", "1", "chunked"], "ac", ["T"], ["1"])), false, "body");
  assertEqBool(base.equals(mkReq(Post, "/p", Http11, ["Host", "X", "Transfer-Encoding"], ["a", "1", "chunked"], "abc", ["T"], ["1"])), false, "body length");
  assertEqBool(base.equals(mkReq(Post, "/p", Http11, ["Host", "X", "Transfer-Encoding"], ["a", "1", "chunked"], "ab", ["T"], ["2"])), false, "trailer value");
  assertEqBool(base.equals(mkReq(Post, "/p", Http11, ["Host", "X", "Transfer-Encoding"], ["a", "1", "chunked"], "ab", [], [])), false, "trailers");
  const old = mkReq(Get, "/", Http10, ["Host"], ["a"], "", [], []);
  const new11 = mkReq(Get, "/", Http11, ["Host"], ["a"], "", [], []);
  assertEqBool(old.equals(new11), false, "version");
  assertEqBool(mkReq(Ext("PURGE"), "/", Http11, ["Host"], ["a"], "", [], []).equals(mkReq(Ext("PURGE"), "/", Http11, ["Host"], ["a"], "", [], [])), true, "extension methods");
  assertEqBool(mkReq(Ext("PURGE"), "/", Http11, ["Host"], ["a"], "", [], []).equals(mkReq(Ext("PUSH"), "/", Http11, ["Host"], ["a"], "", [], [])), false, "different extension methods");
  assertEqBool(old.isChunked(), false, "not chunked");
  assertEqBool(base.isChunked(), true, "chunked");
  assertEqUsize(base.trailers().size(), 1, "trailers accessor");
}

function mkRes(code: int, reason: string, v: HttpVersion, names: string[], values: string[], body: string, tn: string[], tv: string[], head: bool): Response {
  return tryResponse(new Status(code, reason), v, tryHeaders(names, values).unwrap(), bs(body), tryHeaders(tn, tv).unwrap(), head).unwrap();
}

@Test
function responseEqualityComparesEveryPart(): void {
  const base = mkRes(200, "OK", Http11, ["Transfer-Encoding", "X"], ["chunked", "1"], "ab", ["T"], ["1"], false);
  assertEqBool(base.equals(mkRes(200, "OK", Http11, ["Transfer-Encoding", "X"], ["chunked", "1"], "ab", ["T"], ["1"], false)), true, "same parts");
  assertEqBool(base.equals(mkRes(201, "OK", Http11, ["Transfer-Encoding", "X"], ["chunked", "1"], "ab", ["T"], ["1"], false)), false, "code");
  assertEqBool(base.equals(mkRes(200, "Fine", Http11, ["Transfer-Encoding", "X"], ["chunked", "1"], "ab", ["T"], ["1"], false)), false, "reason");
  assertEqBool(base.equals(mkRes(200, "OK", Http11, ["Transfer-Encoding", "X"], ["chunked", "2"], "ab", ["T"], ["1"], false)), false, "header");
  assertEqBool(base.equals(mkRes(200, "OK", Http11, ["Transfer-Encoding", "X"], ["chunked", "1"], "ac", ["T"], ["1"], false)), false, "body");
  assertEqBool(base.equals(mkRes(200, "OK", Http11, ["Transfer-Encoding", "X"], ["chunked", "1"], "ab", ["T"], ["2"], false)), false, "trailer");
  const plain = mkRes(200, "OK", Http10, [], [], "x", [], [], false);
  assertEqBool(plain.equals(mkRes(200, "OK", Http11, [], [], "x", [], [], false)), false, "version");
  const head = mkRes(200, "OK", Http11, ["Content-Length"], ["3"], "", [], [], true);
  assertEqBool(head.equals(mkRes(200, "OK", Http11, ["Content-Length"], ["3"], "", [], [], true)), true, "HEAD response");
  assertEqBool(head.isForHead(), true, "isForHead");
  assertEqBool(plain.isForHead(), false, "not for HEAD");
  assertEqBool(plain.isBodyless(), false, "has a body");
  assertEqBool(mkRes(204, "No Content", Http11, [], [], "", [], [], false).isBodyless(), true, "204");
  assertEqUsize(base.trailers().size(), 1, "trailers accessor");
  assertEqUsize(plain.body().length(), 1, "body accessor");
}

// ------------------------------------------------------------------------------- ADR-0048: typed twins and errors

@Test
function statusTryNewReportsTheKind(): void {
  assertEqString(kindOf(Status.tryNew(99, "x").unwrapErr()), "InvalidStatusCode", "99");
  assertEqString(kindOf(Status.tryNew(600, "x").unwrapErr()), "InvalidStatusCode", "600");
  const bad = Status.tryNew(200, "O\r\nK").unwrapErr();
  assertEqString(kindOf(bad), "InvalidStatusReason", "CRLF in the phrase");
  assertEqUsize(bad.offset, 1, "offset of the first offending byte");
  assertEqUsize(Status.tryNew(200, "OK\x00").unwrapErr().offset, 2, "NUL at the end");
  assertEqString(Status.tryNew(404, "Not Found").unwrap().reason(), "Not Found", "ok");
  assertEqBool(httpErrorMessage(bad).length > 0, true, "message");
}

@Test
function requestAndResponseTryNewReportTheRule(): void {
  let h = emptyHeaders();
  h.add("Host", "a").unwrap();
  assertEqString(kindOf(tryRequest(Ext("GET"), "/", Http11, h, empty(), emptyHeaders()).unwrapErr()), "InvalidMethod", "method");
  assertEqString(kindOf(tryRequest(Get, "x", Http11, h, empty(), emptyHeaders()).unwrapErr()), "InvalidTarget", "target");
  assertEqString(kindOf(tryRequest(Get, "/", Http11, emptyHeaders(), empty(), emptyHeaders()).unwrapErr()), "MissingHost", "no Host");
  let two = emptyHeaders();
  two.add("Host", "a").unwrap();
  two.add("Host", "b").unwrap();
  assertEqString(kindOf(tryRequest(Get, "/", Http11, two, empty(), emptyHeaders()).unwrapErr()), "DuplicateHost", "two Hosts");
  assertEqString(kindOf(tryRequest(Get, "/", Http11, h, bs("x"), emptyHeaders()).unwrapErr()), "MissingFraming", "body without framing");
  let cl = emptyHeaders();
  cl.add("Host", "a").unwrap();
  cl.add("Content-Length", "3").unwrap();
  assertEqString(kindOf(tryRequest(Post, "/", Http11, cl, bs("ab"), emptyHeaders()).unwrapErr()), "BodyLengthMismatch", "CL mismatch");
  let bad = emptyHeaders();
  bad.add("Content-Length", "x").unwrap();
  assertEqString(kindOf(tryResponse(standardStatus(200), Http11, bad, empty(), emptyHeaders(), false).unwrapErr()), "InvalidContentLength", "CL");
  assertEqString(kindOf(tryResponse(standardStatus(204), Http11, emptyHeaders(), bs("x"), emptyHeaders(), false).unwrapErr()), "UnexpectedBody", "204 body");
  let ok = tryRequest(Get, "/", Http11, h, empty(), emptyHeaders());
  assertEqBool(ok.isOk(), true, "the valid request");
  assertEqBool(ok.unwrap().equals(new Request(Get, "/", Http11, h, empty(), emptyHeaders())), true, "tryNew builds the same request");
}

@Test
function headersSizeAndErrors(): void {
  const e = emptyHeaders();
  assertEqBool(e.isEmpty(), true, "empty");
  assertEqUsize(e.size(), 0, "size 0");
  let h = emptyHeaders();
  h.add("A", "1").unwrap();
  assertEqBool(h.isEmpty(), false, "not empty");
  assertEqUsize(h.size(), 1, "size 1");
  assertEqUsize(h.count(), 1, "the deprecated count() is size()");
  assertEqString(headerErrorMessage(tryHeaders(["A"], ["1", "2"]).unwrapErr()).substring(0, 9), "the lists", "MismatchedLists");
  const n = h.add("A B", "1").unwrapErr();
  assertEqString(headerErrorMessage(n).substring(0, 13), "invalid field", "InvalidHeaderName");
  match (n.kind) {
    InvalidHeaderName => {},
    _ => { fail("wrong kind for a bad name"); }
  }
  match (h.add("A", "1\r\n").unwrapErr().kind) {
    InvalidHeaderValue => {},
    _ => { fail("wrong kind for a bad value"); }
  }
  match (tryHeaders(["A"], []).unwrapErr().kind) {
    MismatchedLists => {},
    _ => { fail("wrong kind for lists of different lengths"); }
  }
}

@Test
function limitsRecordIsCheckedByTheParsers(): void {
  const d = defaultLimits();
  assertEqBool(isValidLimits(d), true, "the default is valid");
  assertEqUsize(d.maxBody, 1048576, "1 MiB");
  const small = HttpLimits { ...d, maxBody: 4 };
  assertEqUsize(small.maxStartLine, 8192, "spread keeps the other fields");
  assertEqBool(isValidLimits(small), true, "valid");
  assertEqBool(isValidLimits(HttpLimits { ...d, maxStartLine: 15 }), false, "start line below 16");
  assertEqBool(isValidLimits(HttpLimits { ...d, maxHeaderCount: 0 }), false, "no headers");
  assertEqBool(isValidLimits(HttpLimits { ...d, maxHeaderBytes: 63 }), false, "head below 64");
  assertEqBool(isValidLimits(HttpLimits { ...d, maxChunkLine: 7 }), false, "chunk line below 8");
  assertEqBool(isValidLimits(HttpLimits { ...d, maxBody: 1099511627777 }), false, "body above 2^40");
  assertEqBool(isValidLimits(HttpLimits { ...d, maxHeaderLine: 1048577 }), false, "header line above 1 MiB");
}

@Test
function responseToIsTheNamedHeadFlag(): void {
  const msg = "HTTP/1.1 200 OK\r\nContent-Length: 5\r\n\r\n";
  match (parseResponse(bs(msg), defaultLimits(), ToHead)) {
    Done(q, used) => { assertEqBool(q.isForHead(), true, "ToHead"); assertEqUsize(used, msg.length, "no body bytes"); },
    _ => { fail("a HEAD response with Content-Length is complete"); }
  }
  match (parseResponse(bs(msg), defaultLimits(), ToOther)) {
    NeedMore => {},
    _ => { fail("the same bytes need the body for another request"); }
  }
}

@Test
function deprecatedWrappersStillWork(): void {
  assertEqBool(makeStatus(99, "x").isErr(), true, "makeStatus");
  assertEqBool(makeStatus(200, "OK").isOk(), true, "makeStatus ok");
  assertEqBool(headersFromLists(["A"], ["1"]).isOk(), true, "headersFromLists");
  assertEqBool(headersFromLists(["A"], []).isErr(), true, "headersFromLists mismatch");
  let h = emptyHeaders();
  h.add("Host", "a").unwrap();
  assertEqBool(makeRequest(Get, "/", Http11, h, empty(), emptyHeaders()).isOk(), true, "makeRequest");
  assertEqString(makeRequest(Get, "x", Http11, h, empty(), emptyHeaders()).unwrapErr(), "invalid request-target", "makeRequest text");
  assertEqBool(makeResponse(standardStatus(204), Http11, h, bs("x"), emptyHeaders(), false).isErr(), true, "makeResponse");
  assertEqString(reasonName(InvalidMethod), "InvalidMethod", "reasonName");
  assertEqBool(reasonText(InvalidMethod).length > 0, true, "reasonText");
}
