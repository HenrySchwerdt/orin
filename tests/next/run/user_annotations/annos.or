// Annotation definitions (ADR-0046 S1): ordinary record types marked with @Annotation.
export type Verb = Get | Post | Put;

export const DEFAULT_LIMIT: int = 25;
export const ROOT: string = "/api";

@Annotation(function, method)
export type Route = { path: string; verb: Verb; auth: Option<string>; };

@Annotation(type, class, interface)
export type Json = { };

@Annotation(field)
export type JsonName = { name: string; };

@Annotation(function, method, class, type, interface, field, const)
export type Doc = { text: string; };

@Annotation(const, field)
export type Bounds = { min: int; max: usize; ratio: float; flags: bool[]; tags: string[]; cap: Option<int>; };
