// Generic classes (ADR-0026): type parameters, bounds, `new C<T>(..)`, nested type arguments.
export class Box<T> {
  value: T;
  constructor(v: T) {
    this.value = v;
  }
  get(): T {
    return this.value;
  }
  set(v: T): void {
    this.value = v;
  }
}
class Sorted<T extends Ordered, U> implements Shape, Named {
  private items: T[] = [];
  constructor(public tag: U) {}
  area(): int {
    return this.items.length;
  }
}
export class Graph<Node extends Labelled> {
  count: int = 0;
}

function main(): void {
  const b = new Box<int>(1);
  let nested = new Box<Box<Map<string, int>>>(new Box<Map<string, int>>(new Map<string, int>()));
  const c: Box<string>[] = [new Box("a"), new Box<string>("b")];
  let veryLongNameForTheBox = new Box<Result<int, string>>(Ok(1234567890));
  const f = new Box<(x: int) => int>(x => x + 1);
  console.log(b.get().toString());
}
