// `orin test` must report this test as FAILED (a trap) in every build: a channel needs a capacity of at least 1 also when the
// capacity is not a compile-time constant (the constant case is E0482); the monitor of a zero-slot ring would be unusable.
import { channel } from "std:task";

function zero(): usize {
  return 0;
}

@Test
function zeroCapacityTraps(): void {
  const ch = channel<int>(zero());
  ch.tx.close();
}
