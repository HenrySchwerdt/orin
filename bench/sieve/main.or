// Sieve of Eratosthenes over 10,000,000 flags stored as 8-byte ints.
function sieve(n: usize): int {
  let flags: int[] = [];
  let i: usize = 0;
  while (i <= n) { flags.push(1); i += 1; }
  flags[0] = 0;
  flags[1] = 0;
  i = 2;
  while (i * i <= n) {
    if (flags[i] == 1) {
      let j = i * i;
      while (j <= n) { flags[j] = 0; j += i; }
    }
    i += 1;
  }
  let count = 0;
  i = 0;
  while (i <= n) { count += flags[i]; i += 1; }
  return count;
}

function main(): void {
  console.log("primes<=10000000: " + sieve(10000000).toString());
}
