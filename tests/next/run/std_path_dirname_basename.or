import { dirname, basename } from "std:path";

function main(): void {
  const cases = ["/a/b/c", "/a/b/", "a", "", "/a", "/", "//", "a/b", "a//b", "a/./b", "a/b/c.txt", "a/", "///a///"];
  for (const c of cases) {
    console.log("[" + c + "] dir=[" + dirname(c) + "] base=[" + basename(c) + "]");
  }
}
