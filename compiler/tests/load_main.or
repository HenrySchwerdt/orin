// Loader test driver: loads the file named by the first argument and prints one line per
// unit: `name <tab> path <tab> imports...` (imports are unit names, or std:fs / std:process),
// in load order. Diagnostics are rendered to stderr with exit status 1.

import { loadAll } from "../loader";
import { render } from "../diag";
import { args, exit } from "std:process";

function main(): void {
  const argv = args();
  if (argv.length < 1) {
    console.error("usage: load_main <file.or>");
    exit(2);
    return;
  }
  const o = loadAll(argv[0]);
  match (o.program) {
    None => {
      for (const d of o.diags) {
        console.error(render(o.sm, d));
      }
      exit(1);
    },
    Some(p) => {
      for (const u of p.units) {
        let parts: string[] = [u.name, u.path];
        for (const t of u.imports) {
          parts.push(match (t) {
            ImportUnit(i) => p.units[i].name,
            ImportStd(m) => match (m) {
              StdFs => "std:fs",
              StdProcess => "std:process",
              StdIo => "std:io",
              StdClock => "std:clock"
            }
          });
        }
        console.log(parts.join("\t"));
      }
    }
  }
}
