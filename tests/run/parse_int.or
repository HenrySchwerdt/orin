function show(o: Option<int>): void {
  match (o) {
    Some(v) => { console.log("some " + v.toString()); },
    None => { console.log("none"); },
  }
}

function main(): void {
  show(parseInt("123"));
  show(parseInt("-45"));
  show(parseInt("0"));
  show(parseInt("abc"));
  show(parseInt("12x"));
  show(parseInt(" 5"));
  show(parseInt("9223372036854775807"));
  const n = parseInt("77").unwrapOr(0) + 1;
  console.log(n.toString());
}
