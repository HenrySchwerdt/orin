// Functional (out-of-place) quicksort of 1,000,000 ints: 3-way partition into fresh arrays,
// pivot = first element, results concatenated.
function lcg(x: int): int {
  return (x * 1103515245 + 12345) % 2147483648;
}

function qs(xs: int[]): int[] {
  if (xs.length <= 1) { return xs; }
  const p = xs[0];
  let lo: int[] = [];
  let eq: int[] = [];
  let hi: int[] = [];
  for (const x of xs) {
    if (x < p) { lo.push(x); }
    else if (x == p) { eq.push(x); }
    else { hi.push(x); }
  }
  return qs(lo).concat(eq).concat(qs(hi));
}

function main(): void {
  let a: int[] = [];
  let x = 42;
  let i = 0;
  while (i < 1000000) {
    x = lcg(x);
    a.push((x / 16) % 1000000);
    i += 1;
  }
  const s = qs(a);
  let cs = 0;
  let sorted = 1;
  let k: usize = 0;
  while (k < s.length) {
    cs = (cs * 31 + s[k]) % 1000000007;
    if (k > 0) {
      if (s[k - 1] > s[k]) { sorted = 0; }
    }
    k += 1;
  }
  console.log("sorted " + sorted.toString());
  console.log("checksum " + cs.toString());
}
