import { Pair, makePair, Tree, Leaf, Node, sizeOf, id } from "./lib";

function main(): void {
  const p: Pair<int, string> = makePair(1, "x");
  console.log(p.first.toString() + p.second);
  const t = Node(Node(Leaf, "a", Leaf), "b", Leaf);
  console.log(sizeOf(t).toString());
  const e: Tree<int> = Leaf;
  console.log(sizeOf(e).toString());
  console.log(id("done"));
}
