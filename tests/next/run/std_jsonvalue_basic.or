// flags: --check-contracts
import {
  parseDocument, writeDocument, defaultJsonOptions, defaultJsonLimits, JsonValue, JsonMember,
  JsonDuplicatePolicy, JsonReadOptions,
} from "std:jsonvalue";
import { numberFromInt } from "std:jsonnumber";
function main(): void {
  const source = " {\"n\":9007199254740993,\"f\":1.00e+3,\"s\":\"\\ud83d\\ude00\",\"e\":\"\"} ";
  console.log(
    writeDocument(parseDocument(source, defaultJsonOptions()).unwrap(), defaultJsonLimits()).unwrap(),
  );
  const duplicate = "{\"a\":1,\"\\u0061\":2}";
  console.log(parseDocument(duplicate, defaultJsonOptions()).unwrapErr().offset.toString());
  const opt = JsonReadOptions { limits: defaultJsonLimits(), duplicates: PreserveDuplicates };
  console.log(writeDocument(parseDocument(duplicate, opt).unwrap(), opt.limits).unwrap());
  const built = ValueObject([
    JsonMember { key: "id", value: ValueNumber(numberFromInt(-9223372036854775807 - 1)) },
  ]);
  console.log(writeDocument(built, defaultJsonLimits()).unwrap());
}
