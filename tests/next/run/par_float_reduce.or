// warns: W0480 W0480
// A parallel float `reduce` (ADR-0039 §3.4): the chunks are fixed (4096 elements, independent of the number of threads),
// so the result is the same bits on every machine and with every ORIN_THREADS; it may differ from the sequential fold in
// the last bits, which W0480 says at compile time. The parallel sum is printed (the same with every ORIN_THREADS) and
// compared with the sequential one within a tolerance.
function main(): void {
  let xs: float[] = [];
  let i = 0;
  while (i < 50000) {
    xs.push(1.0 / (i.toFloat() + 1.0));
    i += 1;
  }
  const par = xs.parallel().reduce((a, b) => a + b, 0.0);
  const seq = xs.reduce((a, b) => a + b, 0.0);
  console.log(par.toString());
  console.log(((par - seq).abs() < 0.000000001).toString());
  const twice = xs.parallel().map(x => x * 2.0).reduce((a, b) => a + b, 0.0);
  console.log((twice == par * 2.0).toString());
}
