// flags: --check-contracts
class Util {
  n: int;

  constructor() {
    this.n = 1;
  }

  @Requires(x > 0)
  @Ensures(result == x * 2)
  static twice(x: int): int {
    return x * 2;
  }
}

@Requires(xs.length > 0)
@Ensures(result.length == xs.length)
function same<T>(xs: T[]): T[] {
  return xs;
}

function main(): void {
  console.log(Util.twice(4).toString());
  console.log(same([1, 2, 3]).length.toString());
}
