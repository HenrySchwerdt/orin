// Interface, implementations and the user live in four modules.
import { Shape, describe } from "./shape";
import { Circle } from "./circle";
import { Square } from "./square";

function main(): void {
  const all: Shape[] = [new Circle(1), new Square(2), new Circle(2)];
  for (const s of all) {
    console.log(describe(s));
  }
  const one: Shape = new Square(5);
  console.log(describe(one));
}
