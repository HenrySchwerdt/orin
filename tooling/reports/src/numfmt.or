// Number formatting with the exact rounding of C / Python (`%.Nf`, `%g`, `round(x, n)`, `{:,}`).
//
// Orin has no fixed-precision float formatting (`float.toString()` is the shortest round-tripping text), and a report
// that compares numbers with another implementation must print the same digits. `fixed` rounds the exact binary value
// half to even, like `printf("%.3f")`, using only 64-bit integer arithmetic: a finite double below 2^53 is m / 2^k with
// m < 2^53 and k found by doubling (every doubling is exact), so m * 10^d < 2^63 for d <= 3 and the quotient, remainder
// and tie test are exact.

const TWO53: float = 9007199254740992.0;

export function decimalOf(n: int): string {
  // decimal text of a non-negative int, written out so that the module does not depend on formatting of negatives
  if (n == 0) {
    return "0";
  }
  let out = "";
  let v = n;
  while (v > 0) {
    out = String.fromCharCode(48 + (v % 10)) + out;
    v = v / 10;
  }
  return out;
}

export function intText(n: int): string {
  return n.toString();
}

function pow10i(d: int): int {
  let p: int = 1;
  let i: int = 0;
  while (i < d) {
    p = p * 10;
    i += 1;
  }
  return p;
}

function zeros(n: int): string {
  let s = "";
  let i: int = 0;
  while (i < n) {
    s += "0";
    i += 1;
  }
  return s;
}

function isNegative(x: float): bool {
  return x < 0.0 || (x == 0.0 && 1.0 / x < 0.0);
}

// `scaled` is the digits of round(|x| * 10^d); lay out as integer part "." d fraction digits.
function layout(scaled: int, d: int): string {
  let ds = decimalOf(scaled);
  if (d == 0) {
    return ds;
  }
  if (ds.length <= d.toUsize()) {
    ds = zeros(d + 1 - ds.length.toInt()) + ds;
  }
  const cut = ds.length.toInt() - d;
  return ds.substring(0, cut.toUsize()) + "." + ds.substring(cut.toUsize(), ds.length);
}

type Fx = { text: string; residual: int; };   // residual: sign of (exact value - rounded value) scaled by 10^d

// round(|a| * 10^d) half to even for 0 <= d <= 3, 0 <= a < 2^63 (exact); the result is laid out as a decimal text.
function fixedAbsX(a: float, d: int): Fx {
  if (a >= TWO53) {
    // an integer already; below 2^63 print it exactly, else fall back to the shortest text
    if (a < 9.0e18) {
      return Fx { text: decimalOf(a.toInt()) + (d > 0 ? "." + zeros(d) : ""), residual: 0 };
    }
    return Fx { text: a.toString() + (d > 0 ? "." + zeros(d) : ""), residual: 0 };
  }
  let t = a;
  let k: int = 0;
  while (t.floor() != t) {
    t = t * 2.0;
    k += 1;
  }
  const m = t.toInt();
  const p = m * pow10i(d);
  if (k == 0) {
    return Fx { text: layout(p, d), residual: 0 };
  }
  if (k >= 64) {
    return Fx { text: layout(0, d), residual: p > 0 ? 1 : 0 };
  }
  if (k == 63) {
    // p < 2^63, so p / 2^63 < 1: rounds to 1 only above one half (2^62), a tie goes to the even 0
    if (p > 4611686018427387904) {
      return Fx { text: layout(1, d), residual: -1 };
    }
    return Fx { text: layout(0, d), residual: p > 0 ? 1 : 0 };
  }
  const pow2 = pow2i(k);
  let q = p / pow2;
  const r = p % pow2;
  const half = pow2 / 2;
  if (r > half || (r == half && q % 2 == 1)) {
    return Fx { text: layout(q + 1, d), residual: -1 };
  }
  return Fx { text: layout(q, d), residual: r > 0 ? 1 : 0 };
}

function fixedAbs(a: float, d: int): string {
  return fixedAbsX(a, d).text;
}

function pow2i(k: int): int {
  let p: int = 1;
  let i: int = 0;
  while (i < k) {
    p = p * 2;
    i += 1;
  }
  return p;
}

// printf("%.<d>f", x) for 0 <= d <= 3; `plus` is the "+" flag (printf("%+.1f")). nan/inf as printf prints them.
export function fixedSigned(x: float, d: int, plus: bool): string {
  if (x != x) {
    return "nan";
  }
  if (!x.isFinite()) {
    return x > 0.0 ? (plus ? "+inf" : "inf") : "-inf";
  }
  const sign = isNegative(x) ? "-" : (plus ? "+" : "");
  return sign + fixedAbs(x.abs(), d);
}

export function fixed(x: float, d: int): string {
  return fixedSigned(x, d, false);
}

// Python round(x, 3): the exact value rounded half to even to 3 decimals, read back as a float.
export function round3(x: float): float {
  if (x != x || !x.isFinite()) {
    return x;
  }
  return parseFloat(fixed(x, 3)).unwrap();
}

// Python round(x, 10) for the magnitudes the charts use. The product x * 1e10 is exact enough below 2^20 (about 1e6);
// above that one ulp of x is larger than 1e-10 and Python returns x itself.
export function round10(x: float): float {
  if (x != x || !x.isFinite() || x.abs() >= 1048576.0) {
    return x;
  }
  return (x * 1.0e10).round() / 1.0e10;
}

// C `%g` (6 significant digits, trailing zeros removed) of a value that has at most 3 decimals (the output of round3).
export function general(x: float): string {
  if (x != x) {
    return "nan";
  }
  if (!x.isFinite()) {
    return x > 0.0 ? "inf" : "-inf";
  }
  const neg = isNegative(x);
  const sign = neg ? "-" : "";
  const fx = fixedAbsX(x.abs(), 3);
  const text = fx.text;                       // "123.450"
  const dot = text.indexOf(".").unwrap().toInt();
  const intPart = text.substring(0, dot.toUsize());
  const frac = text.substring((dot + 1).toUsize(), text.length);
  // all digits, then the decimal exponent of the first significant one
  let all = intPart + frac;
  let lead: int = 0;
  while (lead < all.length.toInt() && all.charCodeAt(lead.toUsize()) == 48) {
    lead += 1;
  }
  if (lead == all.length.toInt()) {
    return sign + "0";
  }
  let exp10: int = intPart.length.toInt() - 1 - lead;
  let ds = all.substring(lead.toUsize(), all.length);
  if (ds.length > 6) {
    const next = ds.charCodeAt(6).toInt() - 48;
    let rest: bool = false;
    let i: int = 7;
    while (i < ds.length.toInt()) {
      if (ds.charCodeAt(i.toUsize()) != 48) {
        rest = true;
      }
      i += 1;
    }
    let head = ds.substring(0, 6);
    let up: bool = next > 5 || (next == 5 && rest);
    if (next == 5 && !rest) {
      // a tie of the printed decimals: the exact binary value decides, and only an exact tie goes to the even digit
      up = fx.residual > 0 ? true : (fx.residual < 0 ? false : (head.charCodeAt(5).toInt() - 48) % 2 == 1);
    }
    if (up) {
      head = incrementDecimal(head);
      if (head.length > 6) {
        head = head.substring(0, 6);
        exp10 += 1;
      }
    }
    ds = head;
  }
  // strip trailing zeros
  let end: int = ds.length.toInt();
  while (end > 1 && ds.charCodeAt((end - 1).toUsize()) == 48) {
    end -= 1;
  }
  ds = ds.substring(0, end.toUsize());
  if (exp10 < -4 || exp10 >= 6) {
    const mant = ds.length > 1 ? ds.substring(0, 1) + "." + ds.substring(1, ds.length) : ds;
    const e = exp10 < 0 ? -exp10 : exp10;
    const es = e < 10 ? "0" + decimalOf(e) : decimalOf(e);
    return sign + mant + "e" + (exp10 < 0 ? "-" : "+") + es;
  }
  if (exp10 >= 0) {
    const need = exp10 + 1;
    if (ds.length.toInt() <= need) {
      return sign + ds + zeros(need - ds.length.toInt());
    }
    return sign + ds.substring(0, need.toUsize()) + "." + ds.substring(need.toUsize(), ds.length);
  }
  return sign + "0." + zeros(-exp10 - 1) + ds;
}

// "999" + 1 = "1000": decimal increment of a digit string
function incrementDecimal(s: string): string {
  let i: int = s.length.toInt() - 1;
  let out = "";
  let carry: bool = true;
  while (i >= 0) {
    const c = s.charCodeAt(i.toUsize()).toInt() - 48;
    if (carry) {
      if (c == 9) {
        out = "0" + out;
      } else {
        out = String.fromCharCode(48 + c + 1) + out;
        carry = false;
      }
    } else {
      out = String.fromCharCode(48 + c) + out;
    }
    i -= 1;
  }
  return carry ? "1" + out : out;
}

// Python "{:,}".format(n)
export function grouped(n: int): string {
  if (n < 0) {
    // -(i64 min) overflows; the benchmark counts are never negative
    return "-" + grouped(-n);
  }
  const ds = decimalOf(n);
  let out = "";
  let i: int = 0;
  const len = ds.length.toInt();
  while (i < len) {
    if (i > 0 && (len - i) % 3 == 0) {
      out += ",";
    }
    out += ds.substring(i.toUsize(), (i + 1).toUsize());
    i += 1;
  }
  return out;
}

// A short form for a card: 999, 12.35 k, 1.50 M, 24.50 G, 3.10 T (decimal prefixes; the exact value belongs in the card's title).
export function compact(n: int): string {
  if (n < 0) {
    return "-" + compact(-n);
  }
  if (n < 1000) {
    return decimalOf(n);
  }
  const x = n.toFloat();
  if (n < 1000000) {
    return fixed(x / 1000.0, 2) + " k";
  }
  if (n < 1000000000) {
    return fixed(x / 1000000.0, 2) + " M";
  }
  if (n < 1000000000000) {
    return fixed(x / 1000000000.0, 2) + " G";
  }
  return fixed(x / 1000000000000.0, 2) + " T";
}
