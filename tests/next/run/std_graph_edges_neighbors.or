import { Graph, GraphId } from "std:graph";

function names(g: Graph<string>, xs: GraphId<string>[]): string {
  let out: string[] = [];
  for (const x of xs) {
    out.push(g.get(x).unwrap());
  }
  return out.join(",");
}

function main(): void {
  let g = new Graph<string>(9);
  const a = g.add("a");
  const b = g.add("b");
  const c = g.add("c");
  g.addEdge(a, b).unwrap();
  g.addEdge(a, c).unwrap();
  g.addEdge(b, a).unwrap();
  g.addEdge(c, c).unwrap();
  console.log(names(g, g.neighbors(a).unwrap()));
  console.log(names(g, g.neighbors(b).unwrap()));
  console.log(names(g, g.neighbors(c).unwrap()));
  g.addEdge(a, b).unwrap();
  console.log(names(g, g.neighbors(a).unwrap()));
  g.remove(b).unwrap();
  console.log(names(g, g.neighbors(a).unwrap()));
  // A new node reusing b's slot is not a neighbour of a: the edge recorded b's old generation.
  const d = g.add("d");
  console.log(names(g, g.neighbors(a).unwrap()));
  console.log(g.neighbors(d).unwrap().length.toString());
}
