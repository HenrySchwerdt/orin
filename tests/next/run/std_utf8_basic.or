// flags: --check-contracts
import { hexDecodeText } from "std:encoding";
import { Utf8String, decode, utf8ErrorMessage, CodePointCursor } from "std:utf8";

function main(): void {
  const s = Utf8String.tryFrom("h\xc3\xa9\xe2\x82\xac\xf0\x9f\x98\x80").unwrap();
  console.log(s.byteLength().toString() + " " + s.codePointCount().toString());
  let c = new CodePointCursor(s);
  while (c.hasNext()) {
    console.log(c.next().unwrap().toString());
  }
  console.log(decode(hexDecodeText("c0af").unwrap()).isErr().toString());
  console.log(utf8ErrorMessage(decode(hexDecodeText("41eda080").unwrap()).unwrapErr()));
  console.log(utf8ErrorMessage(decode(hexDecodeText("e180").unwrap()).unwrapErr()));
}
