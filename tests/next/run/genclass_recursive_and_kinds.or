// Recursive generic structures through generic classes, and instantiation with every kind of type:
// integers of each width, floats, strings, bools, arrays, records, unions, interfaces, function values.
type Link<T> = Nil | Cons(T, Link<T>);

class List<T> {
  head: Link<T> = Nil;
  size: int = 0;
  push(x: T): void {
    this.head = Cons(x, this.head);
    this.size += 1;
  }
  first(): Option<T> {
    return match (this.head) {
      Nil => None,
      Cons(x, rest) => Some(x)
    };
  }
}

class Tree<T> {
  value: T;
  left: Option<Tree<T>>;
  right: Option<Tree<T>>;
  constructor(value: T) {
    this.value = value;
    this.left = None;
    this.right = None;
  }
  insertLeft(x: T): void {
    this.left = Some(new Tree(x));
  }
  insertRight(x: T): void {
    this.right = Some(new Tree(x));
  }
  depth(): int {
    let l = 0;
    let r = 0;
    match (this.left) {
      Some(t) => { l = t.depth(); },
      None => {}
    }
    match (this.right) {
      Some(t) => { r = t.depth(); },
      None => {}
    }
    return 1 + (l > r ? l : r);
  }
}

class Cell<T> {
  v: T;
  constructor(v: T) {
    this.v = v;
  }
  get(): T {
    return this.v;
  }
}

type P = { x: int; y: int; };
type Shape = Dot | Line(int);
interface Named {
  name(): string;
}
class Item implements Named {
  name(): string {
    return "item";
  }
}

function main(): void {
  let l = new List<string>();
  l.push("a");
  l.push("b");
  console.log(l.first().unwrap() + l.size.toString());
  let t = new Tree(1);
  t.insertLeft(2);
  t.insertRight(3);
  console.log(t.depth().toString());
  // every kind of type argument
  console.log(new Cell<i8>(-5).get().toString() + " " + new Cell<i16>(-300).get().toString() + " " + new Cell<i32>(70000).get().toString());
  console.log(new Cell<u8>(255).get().toString() + " " + new Cell<u16>(65535).get().toString() + " " + new Cell<u32>(4000000000).get().toString());
  console.log(new Cell<i64>(9).get().toString() + " " + new Cell<u64>(18446744073709551615).get().toString() + " " + new Cell<isize>(-3).get().toString());
  console.log(new Cell<usize>(8).get().toString() + " " + new Cell<float>(1.5).get().toString() + " " + new Cell<f32>(0.5).get().toString());
  console.log(new Cell<bool>(false).get().toString() + new Cell<string>("s").get());
  console.log(new Cell<int[]>([1, 2, 3]).get().length.toString());
  console.log(new Cell<P>(P { x: 1, y: 2 }).get().y.toString());
  console.log(match (new Cell<Shape>(Line(4)).get()) { Dot => "dot", Line(n) => "line" + n.toString() });
  console.log(new Cell<Option<int>>(Some(3)).get().unwrap().toString());
  console.log(new Cell<Result<int, string>>(Err("bad")).get().isErr().toString());
  console.log(new Cell<Named>(new Item()).get().name());
  const fcell = new Cell<(x: int) => int>(x => x + 100);
  console.log(fcell.get()(1).toString());
  console.log(`${new Cell<int>(1).get()} and ${new Cell(2.5).get()}`);
}
