// `orin mcp [--root <dir>] [--allow-exec] [--repo <dir>]`: MCP over stdio. Messages are
// newline-delimited JSON-RPC (no embedded newlines; our serializer escapes them). stdout carries
// only protocol messages; diagnostics of the server itself go to stderr.

import { FsGrant } from "std:fs";
import { ProcessGrant } from "std:process";
import { StdioGrant } from "std:io";
import { stringifyJson } from "../json";
import { McpSession, newState } from "./util";
import { handleText } from "./handler";
import { stdinReadLine, stdoutWrite } from "../lsp";

// `argv`: the arguments after `mcp`. Returns the exit code (0 at end of input, 2 on bad usage).
export function runMcp(fs: FsGrant, proc: ProcessGrant, stdio: StdioGrant, argv: string[]): int {
  let root = ".";
  let repo = ".";
  let allowExec = false;
  let i: usize = 0;
  while (i < argv.length) {
    const a = argv[i];
    if (a == "--allow-exec") {
      allowExec = true;
    } else if ((a == "--root" || a == "--repo") && i + 1 < argv.length) {
      if (a == "--root") {
        root = argv[i + 1];
      } else {
        repo = argv[i + 1];
      }
      i += 1;
    } else {
      console.error("usage: orin mcp [--root <dir>] [--allow-exec] [--repo <dir>]");
      return 2;
    }
    i += 1;
  }
  let st: McpSession = newState(root, allowExec, repo);
  while (true) {
    const l = stdinReadLine(stdio);
    if (l.isNone()) {
      return 0;
    }
    const line = l.unwrap().trim();
    if (line.length == 0) {
      continue;
    }
    const s = handleText(fs, proc, st, line);
    st = s.st;
    for (const j of s.out) {
      stdoutWrite(stdio, stringifyJson(j) + "\n");
    }
  }
  return 0;
}
