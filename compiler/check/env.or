// Checker environment: symbol tables, type helpers and type display.
// Port of the "Tables" section of bootstrap/src/checker/mod.rs.

import { Span, Diagnostic, diag } from "../diag";
import { Ident, FunctionDecl, ConstDecl, TypeExpr, FieldDecl, VariantDecl, TypeDecl, InterfaceDecl } from "../syntax";
import { Type, RecordDef, UnionDef, Local, Builtin, Function, VTable, intKindOf, kindName, kindSigned } from "../hir";

// Entry of the type namespace (records, unions, aliases).
// EntGen: a generic type declaration (record, union or alias with type parameters), index into
// Env.gtypes. EntIface: an interface (ADR-0019), index into Env.ifaces.
export type TypeEnt = EntRecord(usize) | EntUnion(usize) | EntAlias(usize) | EntGen(usize) | EntIface(usize);

// Entry of the value namespace: functions, consts, union variants (union id, tag), std functions.
// VGFunc: generic function (index into Env.gfuncs); VGVariant: variant of a generic union
// (Env.gtypes index, tag).
export type ValEnt = VFunc(usize) | VConst(usize) | VVariant(usize, usize) | VStd(Builtin)
  | VGFunc(usize) | VGVariant(usize, usize);

export type TypeBind = { name: string; ent: TypeEnt; };
export type ValBind = { name: string; ent: ValEnt; };
export type Names = { types: TypeBind[]; vals: ValBind[]; };

export type UnitInfo = { name: string; file: usize; scope: Names; };

export type AliasInfo = { unit: usize; target: TypeExpr; };

export type FuncInfo = {
  unit: usize;
  qname: string;
  decl: FunctionDecl;
  params: Type[];
  paramLocals: Local[];
  ret: Type;
  // Monomorphized instances (and abstract checks) of generic functions: type parameter names,
  // their bindings, and the instantiation nesting depth. Empty / 0 for ordinary functions.
  tpNames: string[];
  tpTys: Type[];
  depth: usize;
  // Classes (ADR-0009). `mode`: 0 ordinary function, 1 constructor, 2 non-mutating method,
  // 3 mutating method returning void (lowered result: the updated receiver), 4 mutating method with
  // a result (lowered result: a `$ret` record), 5 static method. `cls`: index into Env.classes (modes
  // 1..5). `srcRet`: the return type as written (`ret` is the lowered one); only meaningful for modes 1..5.
  // Closures (ADR-0011): mode 6 is a lifted function (arrow body or function-value wrapper) whose HIR
  // was produced while checking its enclosing function: `cls` indexes Env.lifted.
  mode: int;
  cls: usize;
  srcRet: Type;
};

// A class member as seen by the checker: access and mutability. Methods are plain functions
// `Class.name(this$, args)` found by id (ADR-0009).
export type FieldAcc = { name: string; priv: bool; };
export type MethodInfo = {
  name: string;
  fid: usize;
  isStatic: bool;
  priv: bool;
  mutating: bool;     // inferred (fixpoint over the classes)
  hasRet: bool;       // declared result type is not void
  retRec: usize;      // the `$ret` record (mutating methods with a result)
};
// Generic classes (ADR-0026): `gid` is the index of the generic record in Env.gtypes (-1 for an ordinary class;
// `rec` is then meaningless), `bounds` parallel to the type parameters. The constructor and the instance
// methods of a generic class are generic functions: `ctor` / `MethodInfo.fid` index Env.gfuncs; static
// methods stay ordinary functions (they cannot mention the type parameters, as in TypeScript).
export type ClassInfo = {
  name: string;
  unit: usize;
  gid: int;
  bounds: Option<Ident>[];
  rec: usize;         // the record the class lowers to
  fields: FieldAcc[];
  ctor: usize;        // function id of the constructor
  methods: MethodInfo[];
  implNames: Ident[]; // `implements` list as written (ADR-0019) ...
  impls: usize[];     // ... resolved to interface ids (buildClassTables); parallel to implNames
};

// Interfaces (ADR-0019). `methods` are the resolved signatures in declaration order (receiver
// excluded); the slot of a method in a vtable is its index here.
export type IfaceSig = { name: string; paramNames: string[]; params: Type[]; ret: Type; };
export type IfaceInfo = { name: string; unit: usize; decl: InterfaceDecl; methods: IfaceSig[]; };

// An opaque type parameter with a bound (abstract check of `function f<T extends I>`): the field-less
// record `rec` stands for any class implementing interface `iface`.
export type OpaqueBound = { rec: usize; iface: usize; };

// Generic declarations (ADR-0007). Their bodies are only ever checked through instances.
export type GenType = { unit: usize; qname: string; decl: TypeDecl; };
// `mode` / `cls`: FuncInfo.mode and class index for the constructor and instance methods of a generic class
// (ADR-0026; mode 0 for every other generic function). Their instances inherit both.
export type GenFunc = { unit: usize; qname: string; decl: FunctionDecl; mode: int; cls: usize; };

// A monomorphic instance: kind 0 record, 1 union, 2 function; `gid` indexes gtypes (kinds 0/1) or
// gfuncs (kind 2); `id` is the record / union / function id of the instance.
export type Inst = { kind: int; gid: usize; args: Type[]; id: usize; depth: usize; };

export type ConstLit = LitInt(int) | LitStr(string) | LitBool(bool) | LitFloat(string);

export type ConstInfo = { unit: usize; decl: ConstDecl; ty: Type; lit: ConstLit; };

export type Env = {
  units: UnitInfo[];
  aliases: AliasInfo[];
  records: RecordDef[];
  unions: UnionDef[];
  funcs: FuncInfo[];
  consts: ConstInfo[];
  entry: usize;
  gtypes: GenType[];
  gfuncs: GenFunc[];
  insts: Inst[];
  classes: ClassInfo[];
  ifaces: IfaceInfo[];
  bounds: OpaqueBound[];
  vtables: VTable[];        // interned (class, interface) vtables (ADR-0019)
  lifted: Function[];       // checked HIR of the lifted closure functions (FuncInfo.mode 6)
  prelude: int;             // unit index of the array prelude ($array/array), -1 if none
  mapUnit: int;             // unit index of the Map prelude ($array/map), -1 if none (ADR-0018)
};

// Source declarations needed by the declaration-resolution phase (indexed like Env.records/unions).
export type RecordSrc = { unit: usize; fields: FieldDecl[]; };
export type UnionSrc = { unit: usize; variants: VariantDecl[]; };

// ---------------------------------------------------------------------------
// Type helpers
// ---------------------------------------------------------------------------

export function typeEq(a: Type, b: Type): bool {
  return match (a) {
    TyInt => match (b) { TyInt => true, _ => false },
    TyUsize => match (b) { TyUsize => true, _ => false },
    TyIntK(k) => match (b) { TyIntK(j) => k == j, _ => false },
    TyBool => match (b) { TyBool => true, _ => false },
    TyFloat => match (b) { TyFloat => true, _ => false },
    TyF32 => match (b) { TyF32 => true, _ => false },
    TyString => match (b) { TyString => true, _ => false },
    TyVoid => match (b) { TyVoid => true, _ => false },
    TyArray(x) => match (b) { TyArray(y) => typeEq(x, y), _ => false },
    TyOption(x) => match (b) { TyOption(y) => typeEq(x, y), _ => false },
    TyResult(x1, x2) => match (b) { TyResult(y1, y2) => typeEq(x1, y1) && typeEq(x2, y2), _ => false },
    TyRecord(i) => match (b) { TyRecord(j) => i == j, _ => false },
    TyUnion(i) => match (b) { TyUnion(j) => i == j, _ => false },
    TyFn(p1, r1) => match (b) { TyFn(p2, r2) => typesEq(p1, p2) && typeEq(r1, r2), _ => false },
    TyIface(i) => match (b) { TyIface(j) => i == j, _ => false }
  };
}

// `int` (= i64) exactly.
export function isInt(t: Type): bool {
  return match (t) { TyInt => true, _ => false };
}

// A signed integer type (negation is defined).
export function isSignedInt(t: Type): bool {
  const k = intKindOf(t);
  return k >= 0 && kindSigned(k);
}

export function isUsize(t: Type): bool {
  return match (t) { TyUsize => true, _ => false };
}

export function isBool(t: Type): bool {
  return match (t) { TyBool => true, _ => false };
}

export function isString(t: Type): bool {
  return match (t) { TyString => true, _ => false };
}

export function isFn(t: Type): bool {
  return match (t) { TyFn(_, _) => true, _ => false };
}

export function isIface(t: Type): bool {
  return match (t) { TyIface(_) => true, _ => false };
}

export function isVoid(t: Type): bool {
  return match (t) { TyVoid => true, _ => false };
}

// Any integer type (int, usize and the fixed-width ones, ADR-0022).
export function isIntish(t: Type): bool {
  return intKindOf(t) >= 0;
}

// `float` or `f32` (ADR-0018).
export function isFloatTy(t: Type): bool {
  return match (t) { TyFloat => true, TyF32 => true, _ => false };
}

// A numeric type that adopts a literal's type from context: int, usize, float, f32.
export function isNumeric(t: Type): bool {
  return isIntish(t) || isFloatTy(t);
}

export function isArrayTy(t: Type): bool {
  return match (t) { TyArray(_) => true, _ => false };
}

// `Some(t)` is the expected type, and it is `usize`.
export function expIsUsize(exp: Option<Type>): bool {
  return match (exp) {
    Some(t) => isUsize(t),
    None => false
  };
}

export function showType(env: Env, t: Type): string {
  return match (t) {
    TyInt => "int",
    TyUsize => "usize",
    TyIntK(k) => kindName(k.toInt()),
    TyBool => "bool",
    TyFloat => "float",
    TyF32 => "f32",
    TyString => "string",
    TyVoid => "void",
    TyArray(e) => showType(env, e) + "[]",
    TyOption(e) => "Option<" + showType(env, e) + ">",
    TyResult(a, b) => "Result<" + showType(env, a) + ", " + showType(env, b) + ">",
    TyRecord(r) => r < env.records.length ? prettyName(env.records[r].name) : "?",
    TyUnion(u) => u < env.unions.length ? env.unions[u].name : "?",
    TyFn(ps, r) => "(" + showTypes(env, ps) + ") => " + showType(env, r),
    TyIface(i) => i < env.ifaces.length ? env.ifaces[i].name : "?"
  };
}

// `$array/map.Map<string,int>` is shown as `Map<string, int>` (the Map prelude's instances, ADR-0018).
function prettyName(n: string): string {
  if (n.startsWith("$array/map.")) {
    return n.substring(11, n.length).split(",").join(", ");
  }
  return n;
}

function showTypes(env: Env, ts: Type[]): string {
  let parts: string[] = [];
  for (const t of ts) {
    parts.push(showType(env, t));
  }
  return parts.join(", ");
}

// Comma-separated, space-free rendering used in deterministic instance names
// (`main.Pair<int,string>`).
export function tyKey(env: Env, t: Type): string {
  return match (t) {
    TyArray(e) => tyKey(env, e) + "[]",
    TyOption(e) => "Option<" + tyKey(env, e) + ">",
    TyResult(a, b) => "Result<" + tyKey(env, a) + "," + tyKey(env, b) + ">",
    TyFn(ps, r) => "(" + tysKey(env, ps) + ")=>" + tyKey(env, r),
    _ => showType(env, t)
  };
}

export function tysKey(env: Env, ts: Type[]): string {
  let parts: string[] = [];
  for (const t of ts) {
    parts.push(tyKey(env, t));
  }
  return parts.join(",");
}

export function mismatch(env: Env, span: Span, expected: Type, found: Type): Diagnostic {
  return diag("E0400", span, "expected `" + showType(env, expected) + "`, found `" + showType(env, found) + "`");
}

export function diagEq(a: Diagnostic, b: Diagnostic): bool {
  return a.code == b.code && a.span.file == b.span.file && a.span.start == b.span.start
    && a.span.end == b.span.end && a.message == b.message;
}

// Drops later duplicates (same code, span and message), keeping first-occurrence order.
export function dedupDiags(ds: Diagnostic[]): Diagnostic[] {
  let out: Diagnostic[] = [];
  for (const d of ds) {
    let seen = false;
    for (const o of out) {
      if (diagEq(o, d)) {
        seen = true;
      }
    }
    if (!seen) {
      out.push(d);
    }
  }
  return out;
}

// ---------------------------------------------------------------------------
// Name tables
// ---------------------------------------------------------------------------

export function typeEntEq(a: TypeEnt, b: TypeEnt): bool {
  return match (a) {
    EntRecord(x) => match (b) { EntRecord(y) => x == y, _ => false },
    EntUnion(x) => match (b) { EntUnion(y) => x == y, _ => false },
    EntAlias(x) => match (b) { EntAlias(y) => x == y, _ => false },
    EntGen(x) => match (b) { EntGen(y) => x == y, _ => false },
    EntIface(x) => match (b) { EntIface(y) => x == y, _ => false }
  };
}

// Only the std functions can appear in VStd; this id distinguishes them.
function stdId(b: Builtin): int {
  return match (b) {
    BFsReadFile => 1,
    BFsWriteFile => 2,
    BFsExists => 3,
    BProcessArgs => 4,
    BProcessExit => 5,
    BIoReadBytes => 6,
    BIoReadLine => 7,
    BIoWriteStdout => 8,
    BIoShell => 9,
    BTimeNowMillis => 10,
    _ => 0
  };
}

export function valEntEq(a: ValEnt, b: ValEnt): bool {
  return match (a) {
    VFunc(x) => match (b) { VFunc(y) => x == y, _ => false },
    VConst(x) => match (b) { VConst(y) => x == y, _ => false },
    VVariant(u1, t1) => match (b) { VVariant(u2, t2) => u1 == u2 && t1 == t2, _ => false },
    VStd(x) => match (b) { VStd(y) => stdId(x) == stdId(y), _ => false },
    VGFunc(x) => match (b) { VGFunc(y) => x == y, _ => false },
    VGVariant(g1, t1) => match (b) { VGVariant(g2, t2) => g1 == g2 && t1 == t2, _ => false }
  };
}

export function findType(names: Names, name: string): Option<TypeEnt> {
  for (const b of names.types) {
    if (b.name == name) {
      return Some(b.ent);
    }
  }
  return None;
}

export function findVal(names: Names, name: string): Option<ValEnt> {
  for (const b of names.vals) {
    if (b.name == name) {
      return Some(b.ent);
    }
  }
  return None;
}

export function emptyNames(): Names {
  const t: TypeBind[] = [];
  const v: ValBind[] = [];
  return Names { types: t, vals: v };
}

export function isBuiltinTypeName(n: string): bool {
  return n == "int" || n == "usize" || n == "bool" || n == "string" || n == "void" || n == "Option" || n == "Result"
    || n == "float" || n == "f32";
}

// Value lookup in the scope of unit `unit`.
export function globalVal(env: Env, unit: usize, name: string): Option<ValEnt> {
  return findVal(env.units[unit].scope, name);
}

// Instance record for type `t` (a record or union instantiated from a generic type).
export function originOf(env: Env, t: Type): Option<Inst> {
  for (const i of env.insts) {
    const hit = match (t) {
      TyRecord(r) => i.kind == 0 && i.id == r,
      TyUnion(u) => i.kind == 1 && i.id == u,
      _ => false
    };
    if (hit) {
      return Some(i);
    }
  }
  return None;
}

// The generic type `name` (`Map` or `MapEntry`) of the Map prelude (array/map.or), if that prelude is loaded.
export function mapGenType(env: Env, name: string): Option<usize> {
  if (env.mapUnit < 0) {
    return None;
  }
  const t = findType(env.units[env.mapUnit.toUsize()].scope, name);
  return match (t) {
    Some(ent) => match (ent) {
      EntGen(g) => Some(g),
      _ => None
    },
    None => None
  };
}

// The instance record of `Map<K, V>` (array/map.or) when `t` is one.
export function mapOrigin(env: Env, t: Type): Option<Inst> {
  const o = originOf(env, t);
  const g = mapGenType(env, "Map");
  if (o.isSome() && g.isSome()) {
    const i = o.unwrap();
    if (i.kind == 0 && i.gid == g.unwrap()) {
      return o;
    }
  }
  return None;
}

// Key types of `Map<K, V>`: the classes that have a hash and an equality (ADR-0018).
export function isMapKeyType(t: Type): bool {
  return match (t) {
    TyInt => true,
    TyUsize => true,
    TyIntK(_) => true,
    TyBool => true,
    TyString => true,
    _ => false
  };
}

export function typesEq(a: Type[], b: Type[]): bool {
  if (a.length != b.length) {
    return false;
  }
  let i: usize = 0;
  while (i < a.length) {
    if (!typeEq(a[i], b[i])) {
      return false;
    }
    i += 1;
  }
  return true;
}

export function findInst(env: Env, kind: int, gid: usize, args: Type[]): Option<Inst> {
  for (const i of env.insts) {
    if (i.kind == kind && i.gid == gid && typesEq(i.args, args)) {
      return Some(i);
    }
  }
  return None;
}

// ---------------------------------------------------------------------------
// Interfaces (ADR-0019)
// ---------------------------------------------------------------------------

export function ifaceMethodIndex(i: IfaceInfo, name: string): Option<usize> {
  let k: usize = 0;
  while (k < i.methods.length) {
    if (i.methods[k].name == name) {
      return Some(k);
    }
    k += 1;
  }
  return None;
}

// `area(x: int): int` — a rendered interface method signature.
export function showIfaceSig(env: Env, m: IfaceSig): string {
  let ps: string[] = [];
  let k: usize = 0;
  while (k < m.params.length) {
    ps.push(m.paramNames[k] + ": " + showType(env, m.params[k]));
    k += 1;
  }
  return m.name + "(" + ps.join(", ") + "): " + showType(env, m.ret);
}

// The interface bounding the opaque record `r` (abstract check of a bounded type parameter).
export function boundOf(env: Env, r: usize): Option<usize> {
  for (const b of env.bounds) {
    if (b.rec == r) {
      return Some(b.iface);
    }
  }
  return None;
}
