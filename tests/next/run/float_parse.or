function show(s: string): void {
  const r = parseFloat(s);
  match (r) {
    Some(v) => { console.log(s + " -> " + v.toString()); },
    None => { console.log(s + " -> none"); }
  }
}

function main(): void {
  show("3.25");
  show("-0.5");
  show("10");
  show("1e3");
  show("1E-2");
  show("2.5e+2");
  show("0.1");
  show("-0");
  show("123456789.123456789");
  show("Infinity");
  show("-Infinity");
  show("NaN");
  show("1e999");
  show("");
  show("-");
  show(".5");
  show("5.");
  show("+1");
  show(" 1");
  show("1 ");
  show("1e");
  show("1e+");
  show("0x10");
  show("abc");
  show("1.2.3");
  show("--1");
  show("nan");
  show("inf");
}
