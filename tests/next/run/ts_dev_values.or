// Orin for TypeScript developers (docs/ts-developers.md): value semantics.
class Counter {
  constructor(public value: int) {}
  increment(): void { this.value += 1; }
}

type Point = { x: int; y: int; };

// A parameter is immutable: to "change" a value, return the new one.
function bumped(c: Counter): Counter {
  let copy = c;
  copy.increment();
  return copy;
}

function main(): void {
  let a = new Counter(0);
  const b = a;
  a.increment();
  console.log(`${a.value} ${b.value}`);

  const c = bumped(a);
  console.log(`${a.value} ${c.value}`);

  let p = Point { x: 1, y: 2 };
  const q = p;
  p.x = 5;
  const r = Point { ...q, y: 9 };
  console.log(`${p.x} ${q.x} ${r.x} ${r.y}`);

  let xs = [1, 2];
  const ys = xs;
  xs.push(3);
  console.log(`${xs.length} ${ys.length}`);
}
