import { Priced } from "./api";

export function cheapest<T extends Priced>(xs: T[]): string {
  let best = xs[0].price();
  let name = xs[0].title();
  for (const x of xs) {
    if (x.price() < best) {
      best = x.price();
      name = x.title();
    }
  }
  return name + "@" + best.toString();
}

export function sumPrices<T extends Priced>(xs: T[]): int {
  let t = 0;
  for (const x of xs) {
    t += x.price();
  }
  return t;
}
