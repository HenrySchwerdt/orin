// Two files open at the same time: stream one into another line by line (withFiles / useFiles).
import { withFiles, useFiles, useFile, withFile, Read, Write, Append, File } from "std:fs";

const SRC: string = "build/tests/fs_copy_src.txt";
const DST: string = "build/tests/fs_copy_dst.txt";

function pump(a: File, b: File): int {
  let n: int = 0;
  while (true) {
    const l = a.readLine();
    if (l.isNone()) {
      return n;
    }
    b.writeLine(l.unwrap().trim());
    n += 1;
  }
  return n;
}

function main(): void {
  useFile(SRC, Write, f => {
    let i: int = 0;
    while (i < 1000) {
      f.writeLine("  line " + i.toString() + "  ");
      i += 1;
    }
  }).unwrap();
  const copied = withFiles(SRC, Read, DST, Write, (a, b) => pump(a, b));
  console.log("copied " + copied.unwrap().toString());
  console.log("dst: " + withFile(DST, Read, f => f.readAll().length).unwrap().toString() + " bytes");
  const tail = withFile(DST, Read, f => {
    let last = "";
    while (true) {
      const l = f.readLine();
      if (l.isNone()) {
        return last;
      }
      last = l.unwrap();
    }
    return last;
  });
  console.log("last line: " + tail.unwrap());
  // append the source to the copy, then count the lines of the result
  const ap = useFiles(SRC, Read, DST, Append, (a, b) => { pump(a, b); });
  console.log("append ok " + ap.isOk().toString());
  console.log("total " + withFile(DST, Read, f => f.readAll().split("\n").length).unwrap().toString());
  // the same path twice: two independent handles
  const same = withFiles(SRC, Read, SRC, Read, (a, b) => a.readLine().unwrapOr("") + "/" + b.readLine().unwrapOr(""));
  console.log("same file twice: [" + same.unwrap() + "]");
}
