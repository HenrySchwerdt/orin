// A blocking HTTP/1.1 server on std:net and std:http (ADR-0033).
//
//   GET  /health   200 "ok"
//   POST /echo     200 with the request body (and its Content-Type)
//   anything else  404 / 405 / 400 / 408 / 413 / 414 / 431 as the case may be
//
// Usage:  http_server [port] [maxConnections] [requestMs] [verbose]
//   port            default 8080; 0 = a free port (printed on stderr: "listening on 127.0.0.1:PORT")
//   maxConnections  serve this many connections, then exit; 0 = forever (default)
//   requestMs       deadline for one whole request (head and body) from its first byte: default 5000
//   verbose         1 = one log line per request on stderr (default 0)
//
// Limits (a hostile client can make the server wait and buffer, never more than this): request line 2048 bytes, 50
// headers, header line 4096, head 16 KiB, body 64 KiB, 100 requests per connection, idle wait for the next request 5 s,
// request deadline `requestMs`, 5 s to accept the response. It listens on the loopback interface only, through a
// network grant narrowed to that address: the program cannot open any other socket, whatever its code does.
//
// One connection at a time (no tasks yet, ADR-0017): a slow client holds the server until a deadline above passes. The
// connection is closed gracefully after an error answer (shutdown of the write side, bounded drain, close) so that the
// client sees the answer and not a reset.

import { Host, withProcess, useNet } from "std:host";
import { args } from "std:process";
import { Bytes, fromString, empty } from "std:bytes";
import {
  Request, Response, Headers, Limits, ParseResult, NeedMore, Done, Failed, RequestParser, HttpError, Http11, methodName, eqIgnoreCase, versionMinor,
  standardStatus, makeResponse, headersFromLists, reasonName, emptyHeaders, serializeResponse
} from "std:http";
import {
  NetGrant, Listener, Stream, Peer, useListener, useAccepted, portOf, recv, sendAll, shutdownWrite, nowMillis, isTimeout,
  RecvData, RecvEof, RecvTimeout, RecvReset, RecvError
} from "std:net";

type Config = { limits: Limits; requestMs: int; idleMs: int; sendMs: int; maxPerConn: int; verbose: bool; };

function intArg(xs: string[], i: usize, dflt: int): int {
  if (i >= xs.length) {
    return dflt;
  }
  return match (parseInt(xs[i])) {
    Some(v) => v,
    None => dflt
  };
}

// The status code for a request the parser refused.
function statusFor(e: HttpError): int {
  const r = reasonName(e.reason);
  if (r == "BodyTooLarge") {
    return 413;
  }
  if (r == "StartLineTooLong") {
    return 414;
  }
  if (r == "HeaderLineTooLong" || r == "HeadersTooLarge" || r == "TooManyHeaders") {
    return 431;
  }
  if (r == "UnsupportedVersion") {
    return 505;
  }
  return 400;
}

// Sends one response; false if it could not be sent (the connection is then useless).
function respond(s: Stream, cfg: Config, code: int, ctype: string, body: Bytes, close: bool): bool {
  let names: string[] = ["Content-Length", "Content-Type"];
  let values: string[] = [body.length().toString(), ctype];
  if (close) {
    names.push("Connection");
    values.push("close");
  }
  const h = headersFromLists(names, values);
  if (h.isErr()) {
    return false;
  }
  const resp = makeResponse(standardStatus(code), Http11, h.unwrap(), body, emptyHeaders(), false);
  if (resp.isErr()) {
    return false;
  }
  return sendAll(s, serializeResponse(resp.unwrap()), cfg.sendMs).isOk();
}

function text(code: int, msg: string): Bytes {
  return fromString(msg + "\n");
}

// What to answer: the status, content type and body for a request.
type Answer = { code: int; ctype: string; body: Bytes; };

function route(req: Request): Answer {
  const target = req.target();
  const m = methodName(req.method());
  if (target == "/health") {
    if (m == "GET") {
      return Answer { code: 200, ctype: "text/plain", body: fromString("ok\n") };
    }
    return Answer { code: 405, ctype: "text/plain", body: text(405, "use GET") };
  }
  if (target == "/echo") {
    if (m == "POST") {
      const ct = req.headers().get("content-type");
      return Answer { code: 200, ctype: ct.unwrapOr("application/octet-stream"), body: req.body() };
    }
    return Answer { code: 405, ctype: "text/plain", body: text(405, "use POST") };
  }
  return Answer { code: 404, ctype: "text/plain", body: text(404, "not found") };
}

// After an error answer: send FIN, then read (and drop) what the client still sends for at most 200 ms, so that the OS does not
// answer unread data with a reset that destroys the response.
function drain(s: Stream): void {
  shutdownWrite(s);
  const end = nowMillis(s) + 200;
  let n: int = 0;
  while (nowMillis(s) < end && n < 16) {
    const r = recv(s, 4096, 50);
    match (r) {
      RecvData(b) => { n += 1; },
      _ => { n = 16; }
    }
  }
}

// One connection: requests until the client goes away, asks for close or does something wrong. Returns the number of requests.
function serveConnection(s: Stream, peer: Peer, cfg: Config): int {
  let parser = new RequestParser(cfg.limits);
  const none = empty();   // one empty chunk per connection, shared (a Bytes never changes)
  let carry: Bytes = none;
  let served: int = 0;
  while (served < cfg.maxPerConn) {
    parser.reset();
    let first = true;
    let deadline: int = 0;
    let req: Option<Request> = None;
    let fail: int = 0;     // status to answer with a close, 0 = none
    let quit = false;      // close without an answer
    while (req.isNone() && fail == 0 && !quit) {
      let chunk: Bytes = none;
      if (carry.length() > 0) {
        chunk = carry;
        carry = none;
      } else {
        const wait = first ? cfg.idleMs : deadline - nowMillis(s);
        if (wait <= 0) {
          fail = 408;
        } else {
          const r = recv(s, 16384, wait);
          match (r) {
            RecvData(b) => { chunk = b; },
            RecvTimeout => { if (first) { quit = true; } else { fail = 408; } },
            _ => { quit = true; }
          }
        }
      }
      if (chunk.length() > 0) {
        if (first) {
          first = false;
          deadline = nowMillis(s) + cfg.requestMs;
        }
        const pr = parser.feed(chunk);
        match (pr) {
          NeedMore => {},
          Done(rq, used) => {
            req = Some(rq);
            carry = chunk.slice(used, chunk.length());
          },
          Failed(e) => { fail = statusFor(e); }
        }
      }
    }
    if (fail != 0) {
      respond(s, cfg, fail, "text/plain", text(fail, "request refused"), true);
      if (cfg.verbose) { console.error(peer.host + " -> " + fail.toString()); }
      drain(s);
      return served;
    }
    if (quit) {
      return served;
    }
    const rq = req.unwrap();
    const ans = route(rq);
    const conn = rq.headers().get("connection");
    served += 1;
    const closeIt = versionMinor(rq.version()) == 0 || (conn.isSome() && eqIgnoreCase(conn.unwrap(), "close")) || served >= cfg.maxPerConn;
    if (cfg.verbose) { console.error(peer.host + " " + methodName(rq.method()) + " " + rq.target() + " -> " + ans.code.toString()); }
    if (!respond(s, cfg, ans.code, ans.ctype, ans.body, closeIt)) {
      return served;
    }
    if (closeIt) {
      drain(s);
      return served;
    }
  }
  return served;
}

function acceptLoop(ln: Listener, cfg: Config, maxConns: int): void {
  let n: int = 0;
  while (maxConns == 0 || n < maxConns) {
    const r = useAccepted(ln, 1000, (s: Stream, peer: Peer) => {
      serveConnection(s, peer, cfg);
    });
    match (r) {
      Ok => { n += 1; },
      Err(e) => {
        if (!isTimeout(e)) {
          console.error("accept: " + e.message);
        }
      }
    }
  }
}

function runServer(net: NetGrant, port: int, maxConns: int, cfg: Config): void {
  const r = useListener(net, "127.0.0.1", port, 128, (ln: Listener) => {
    console.error("listening on 127.0.0.1:" + portOf(ln).toString());
    acceptLoop(ln, cfg, maxConns);
  });
  match (r) {
    Ok => {},
    Err(e) => {
      console.error("cannot listen: " + e.message);
    }
  }
}

function main(host: Host): void {
  const argv = withProcess(host, p => args(p));
  const port = intArg(argv, 0, 8080);
  const maxConns = intArg(argv, 1, 0);
  const requestMs = intArg(argv, 2, 5000);
  const cfg = Config {
    limits: new Limits(2048, 50, 4096, 16384, 256, 65536),
    requestMs: requestMs,
    idleMs: 5000,
    sendMs: 5000,
    maxPerConn: 100,
    verbose: intArg(argv, 3, 0) == 1
  };
  useNet(host, net => {
    runServer(net, port, maxConns, cfg);
  });
}
