type Pair<A, B> = { first: A; second: B; };

function withFirst<A, B>(p: Pair<A, B>, a: A): Pair<A, B> {
  return Pair { ...p, first: a };
}

function main(): void {
  const p = Pair { first: 1, second: "s" };
  const q = withFirst(p, 9);
  console.log(q.first.toString() + q.second);
  const r = Pair { ...q, second: "t" };
  console.log(r.first.toString() + r.second);
  const same = Pair { ...p };
  console.log(same.first.toString());
  console.log(p.first.toString());
}
