type Token = Num(int) | Plus | Minus | Star | Slash | LParen | RParen;
type Parsed = { value: int; pos: usize; };

function isDigit(c: int): bool {
  return c >= 48 && c <= 57;
}

function tokenize(src: string): Result<Token[], string> {
  let toks: Token[] = [];
  let i: usize = 0;
  while (i < src.length) {
    const c = src.charCodeAt(i);
    if (c == 32) {
      i += 1;
      continue;
    }
    if (isDigit(c)) {
      let v = 0;
      while (i < src.length && isDigit(src.charCodeAt(i))) {
        v = v * 10 + (src.charCodeAt(i) - 48);
        i += 1;
      }
      toks.push(Num(v));
      continue;
    }
    const ch = src.charAt(i);
    if (ch == "+") {
      toks.push(Plus);
    } else if (ch == "-") {
      toks.push(Minus);
    } else if (ch == "*") {
      toks.push(Star);
    } else if (ch == "/") {
      toks.push(Slash);
    } else if (ch == "(") {
      toks.push(LParen);
    } else if (ch == ")") {
      toks.push(RParen);
    } else {
      return Err("unexpected character '" + ch + "' at " + i.toString());
    }
    i += 1;
  }
  return Ok(toks);
}

function parseExpr(toks: Token[], pos: usize): Result<Parsed, string> {
  const first = parseTerm(toks, pos)?;
  let acc = first.value;
  let p = first.pos;
  while (p < toks.length) {
    match (toks[p]) {
      Plus => {
        const r = parseTerm(toks, p + 1)?;
        acc = acc + r.value;
        p = r.pos;
      },
      Minus => {
        const r = parseTerm(toks, p + 1)?;
        acc = acc - r.value;
        p = r.pos;
      },
      _ => { return Ok(Parsed { value: acc, pos: p }); },
    }
  }
  return Ok(Parsed { value: acc, pos: p });
}

function parseTerm(toks: Token[], pos: usize): Result<Parsed, string> {
  const first = parseFactor(toks, pos)?;
  let acc = first.value;
  let p = first.pos;
  while (p < toks.length) {
    match (toks[p]) {
      Star => {
        const r = parseFactor(toks, p + 1)?;
        acc = acc * r.value;
        p = r.pos;
      },
      Slash => {
        const r = parseFactor(toks, p + 1)?;
        if (r.value == 0) {
          return Err("division by zero");
        }
        acc = acc / r.value;
        p = r.pos;
      },
      _ => { return Ok(Parsed { value: acc, pos: p }); },
    }
  }
  return Ok(Parsed { value: acc, pos: p });
}

function parseFactor(toks: Token[], pos: usize): Result<Parsed, string> {
  if (pos >= toks.length) {
    return Err("unexpected end");
  }
  match (toks[pos]) {
    Num(v) => { return Ok(Parsed { value: v, pos: pos + 1 }); },
    Minus => {
      const r = parseFactor(toks, pos + 1)?;
      return Ok(Parsed { value: 0 - r.value, pos: r.pos });
    },
    LParen => {
      const r = parseExpr(toks, pos + 1)?;
      if (r.pos >= toks.length) {
        return Err("expected )");
      }
      match (toks[r.pos]) {
        RParen => { return Ok(Parsed { value: r.value, pos: r.pos + 1 }); },
        _ => { return Err("expected )"); },
      }
    },
    _ => { return Err("unexpected token"); },
  }
}

function evaluate(src: string): Result<int, string> {
  const toks = tokenize(src)?;
  const r = parseExpr(toks, 0)?;
  if (r.pos != toks.length) {
    return Err("trailing tokens");
  }
  return Ok(r.value);
}

function main(): void {
  const cases = [
    "100",
    "1 + 2 * 3",
    "(1 + 2) * 3",
    "10 / 3 - 1",
    "2 * (3 + 4) * 5",
    "-5 + 8",
    "7 / (3 - 3)",
    "2 +",
    "2 $ 3",
    "(1 + 2",
    "1 2"
  ];
  for (const s of cases) {
    match (evaluate(s)) {
      Ok(v) => { console.log(s + " = " + v.toString()); },
      Err(e) => { console.log(s + " -> error: " + e); },
    }
  }
}
