// ORIN_DENY=clock must trap before reading the clock, including on the fallible API.
import { Host, useClock } from "std:host";
import { monotonicNow } from "std:time";
function main(host: Host): void {
  useClock(
    host,
    clock => {
      console.log(monotonicNow(clock).isOk().toString());
    },
  );
}
