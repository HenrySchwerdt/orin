// Classes are values: copies are independent snapshots (spec 03).
class Counter {
  constructor(public value: int) {}
  increment(): void { this.value += 1; }
  get(): int { return this.value; }
}

function main(): void {
  let a = new Counter(0);
  const b = a;
  a.increment();
  a.increment();
  console.log("a = " + a.get().toString() + ", b = " + b.get().toString());
}
