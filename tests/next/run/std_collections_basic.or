// flags: --check-contracts
import { IntSet, Deque, SortedMap, SortedStringMap, PriorityQueue } from "std:collections";

function main(): void {
  let s = new IntSet();
  s.add(3);
  s.add(1);
  s.add(3);
  console.log(s.size().toString());

  let d = new Deque<string>();
  d.pushBack("b");
  d.pushBack("c");
  d.pushFront("a");
  console.log(d.toArray().join(""));
  console.log(d.popFront().unwrap() + d.popBack().unwrap());

  let m = new SortedMap<string>();
  m.put(30, "thirty");
  m.put(10, "ten");
  m.put(20, "twenty");
  console.log(m.valueArray().join(","));
  console.log(m.floorKey(25).unwrap().toString());

  let sm = new SortedStringMap<int>();
  sm.put("pear", 1);
  sm.put("apple", 2);
  console.log(sm.keyArray().join(","));

  let q = new PriorityQueue<string>();
  q.push(2, "two");
  q.push(1, "one");
  q.push(1, "uno");
  console.log(q.pop().unwrap().value + q.pop().unwrap().value + q.pop().unwrap().value);
}
