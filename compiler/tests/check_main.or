// Checker test driver: load the program named by the first argument (Stage 1 loader), type-check
// it and print "ok", or the rendered diagnostics to stderr with exit status 1.

import { Host, useHost } from "std:host";
import { FsGrant } from "std:fs";
import { ProcessGrant } from "std:process";
import { check } from "../check";
import { loadAll } from "../loader";
import { render } from "../diag";
import { args, exit } from "std:process";

function main(host: Host): void {
  useHost(host, (fs, proc, stdio, clock) => { run(fs, proc); });
}

function run(fs: FsGrant, proc: ProcessGrant): void {
  const argv = args(proc);
  if (argv.length < 1) {
    console.error("usage: check_main <entry.or>");
    exit(2);
    return;
  }
  const lo = loadAll(fs, argv[0]);
  match (lo.program) {
    None => {
      for (const d of lo.diags) {
        console.error(render(lo.sm, d));
      }
      exit(1);
    },
    Some(prog) => {
      match (check(prog, lo.sm)) {
        Ok(_) => {
          console.log("ok");
        },
        Err(ds) => {
          for (const d of ds) {
            console.error(render(lo.sm, d));
          }
          exit(1);
        }
      }
    }
  }
}
