// error: E0452
// A Stream is a resource handle: a closure (here the body of an inner scope) cannot capture it, so it cannot outlive its scope.
import { Host, useNet } from "std:host";
import { useListener, useAccepted, Listener, Stream, recv } from "std:net";
function main(host: Host): void {
  useNet(host, net => {
    const r = useListener(net, "127.0.0.1", 0, 4, (ln: Listener) => {
      useAccepted(ln, 100, (s: Stream, p) => {
        const inner = useAccepted(ln, 100, (s2: Stream, p2) => { recv(s, 10, 10); });
      });
    });
  });
}
