// JSON value type, accessors and deterministic serializer (spec 18 §3: JSON-RPC for `orin lsp`).
//
// Numbers: Orin-B has no floats, so `JNum` holds an `int`. Parsing (see parse.or) accepts an
// optional fraction and TRUNCATES it toward zero (`1.9` -> 1, `-1.9` -> -1); exponent notation
// and integers with more than 18 digits are rejected with an error message.
//
// Objects keep their fields in insertion order (a JField array); lookups are linear. A
// duplicate key resolves to the FIRST occurrence in `getField`. `jsonEq` is structural equality
// (field order matters: it is part of the deterministic output).
//
// Strings are Orin byte strings holding UTF-8. `stringifyJson` (write.or) escapes `"` `\` and control
// characters (< 0x20) and passes all other bytes (including UTF-8 sequences) through unchanged,
// so output is deterministic and compact (no whitespace).

export type Json = JNull | JBool(bool) | JNum(int) | JStr(string) | JArr(Json[]) | JObj(JField[]);

export type JField = { key: string; value: Json; };

// ---- constructors -------------------------------------------------------------------------

export function jField(key: string, value: Json): JField {
  return JField { key: key, value: value };
}

export function jObj(fields: JField[]): Json {
  return JObj(fields);
}

// ---- accessors ----------------------------------------------------------------------------

export function getField(j: Json, key: string): Option<Json> {
  return match (j) {
    JObj(fs) => findField(fs, key),
    _ => None
  };
}

// The value of the first field named `key` (a duplicate key resolves to the first occurrence).
@Ensures(result.isSome() == fs.some(f => f.key == key))
function findField(fs: JField[], key: string): Option<Json> {
  const k = fs.findIndex(f => f.key == key);
  return k.isSome() ? Some(fs[k.unwrap()].value) : None;
}

export function asStr(j: Json): Option<string> {
  return match (j) {
    JStr(s) => Some(s),
    _ => None
  };
}

export function asInt(j: Json): Option<int> {
  return match (j) {
    JNum(n) => Some(n),
    _ => None
  };
}

export function asBool(j: Json): Option<bool> {
  return match (j) {
    JBool(b) => Some(b),
    _ => None
  };
}

export function asArr(j: Json): Option<Json[]> {
  return match (j) {
    JArr(a) => Some(a),
    _ => None
  };
}

export function isNull(j: Json): bool {
  return match (j) {
    JNull => true,
    _ => false
  };
}

export function getStr(j: Json, key: string): Option<string> {
  const f = getField(j, key);
  if (f.isNone()) {
    return None;
  }
  return asStr(f.unwrap());
}

export function getInt(j: Json, key: string): Option<int> {
  const f = getField(j, key);
  if (f.isNone()) {
    return None;
  }
  return asInt(f.unwrap());
}

export function getBool(j: Json, key: string): Option<bool> {
  const f = getField(j, key);
  if (f.isNone()) {
    return None;
  }
  return asBool(f.unwrap());
}

export function getArr(j: Json, key: string): Option<Json[]> {
  const f = getField(j, key);
  if (f.isNone()) {
    return None;
  }
  return asArr(f.unwrap());
}

// Follow a path of object keys: getPath(j, ["params", "textDocument", "uri"]).
export function getPath(j: Json, path: string[]): Option<Json> {
  let cur = j;
  for (const k of path) {
    const f = getField(cur, k);
    if (f.isNone()) {
      return None;
    }
    cur = f.unwrap();
  }
  return Some(cur);
}

export function getPathStr(j: Json, path: string[]): Option<string> {
  const f = getPath(j, path);
  if (f.isNone()) {
    return None;
  }
  return asStr(f.unwrap());
}

export function getPathInt(j: Json, path: string[]): Option<int> {
  const f = getPath(j, path);
  if (f.isNone()) {
    return None;
  }
  return asInt(f.unwrap());
}

// ---- equality and shape (used by the contracts of the parser and the serializer) ---------------

// Structural equality: same variant, same scalar, same elements / fields (keys and values) in the same order.
export function jsonEq(a: Json, b: Json): bool {
  return match (a) {
    JNull => isNull(b),
    JBool(x) => match (b) {
      JBool(y) => x == y,
      _ => false
    },
    JNum(x) => match (b) {
      JNum(y) => x == y,
      _ => false
    },
    JStr(x) => match (b) {
      JStr(y) => x == y,
      _ => false
    },
    JArr(xs) => match (b) {
      JArr(ys) => jsonsEq(xs, ys),
      _ => false
    },
    JObj(xs) => match (b) {
      JObj(ys) => fieldsEq(xs, ys),
      _ => false
    }
  };
}

function jsonsEq(xs: Json[], ys: Json[]): bool {
  if (xs.length != ys.length) {
    return false;
  }
  let i: usize = 0;
  while (i < xs.length) {
    if (!jsonEq(xs[i], ys[i])) {
      return false;
    }
    i += 1;
  }
  return true;
}

function fieldsEq(xs: JField[], ys: JField[]): bool {
  if (xs.length != ys.length) {
    return false;
  }
  let i: usize = 0;
  while (i < xs.length) {
    if (xs[i].key != ys[i].key || !jsonEq(xs[i].value, ys[i].value)) {
      return false;
    }
    i += 1;
  }
  return true;
}

// Nesting of `j`: the largest number of arrays / objects that enclose a value inside it (a scalar or an empty
// container is 0, `[1]` is 1). The parser rejects a document whose nesting exceeds MAX_DEPTH (parse.or).
export function nesting(j: Json): usize {
  return match (j) {
    JArr(xs) => xs.length == 0 ? 0 : 1 + maxNesting(xs),
    JObj(fs) => fs.length == 0 ? 0 : 1 + maxFieldNesting(fs),
    _ => 0
  };
}

function maxNesting(xs: Json[]): usize {
  let m: usize = 0;
  for (const x of xs) {
    const n = nesting(x);
    if (n > m) {
      m = n;
    }
  }
  return m;
}

function maxFieldNesting(fs: JField[]): usize {
  let m: usize = 0;
  for (const f of fs) {
    const n = nesting(f.value);
    if (n > m) {
      m = n;
    }
  }
  return m;
}
