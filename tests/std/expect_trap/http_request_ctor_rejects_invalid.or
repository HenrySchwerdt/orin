// `orin test` must report this test as FAILED (a trap): the constructor of Request validates in every build; an
// HTTP/1.1 request without a Host field is not a well-formed request.
import { Request, Get, Http11, emptyHeaders } from "std:http";
import { empty } from "std:bytes";

@Test
function constructorTrapsOnMissingHost(): void {
  const q = new Request(Get, "/", Http11, emptyHeaders(), empty(), emptyHeaders());
  q.target();
}
