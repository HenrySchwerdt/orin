// Template literals: interpolation of string, integers, float, f32 and bool; text-only templates;
// adjacent and empty parts; any expression inside ${}.
function twice(n: i32): i32 {
  return n * 2;
}

type P = { x: i32; name: string; };

function main(): void {
  const name = "Ann";
  const age: u8 = 31;
  console.log(`Hello ${name}, you are ${age}`);
  console.log(`plain text without interpolation`);
  console.log(``);
  console.log(`${name}`);
  console.log(`${name}${name}`);
  console.log(`[${name}${age}${name}]`);
  console.log(`${1}${2}${3}`);
  console.log(`a${""}b`);

  // every interpolable type
  const s: string = "str";
  const i8v: i8 = -8;
  const i16v: i16 = -16;
  const i32v: i32 = -32;
  const i64v: i64 = -64;
  const isz: isize = -1;
  const u8v: u8 = 8;
  const u16v: u16 = 16;
  const u32v: u32 = 32;
  const u64v: u64 = 18446744073709551615;
  const usz: usize = 99;
  const n: int = 5;
  const f: float = 1.5;
  const f2: f32 = 0.1;
  const t = true;
  console.log(`${s} ${i8v} ${i16v} ${i32v} ${i64v} ${isz} ${u8v} ${u16v} ${u32v} ${u64v} ${usz} ${n} ${f} ${f2} ${t} ${!t}`);

  // arbitrary expressions
  console.log(`${1 + 2 * 3} ${twice(21)} ${name + "!"} ${age > 18} ${age.toI32() - 40}`);
  const xs = [10, 20, 30];
  const p = P { x: 7, name: "pt" };
  console.log(`${xs[1]} ${xs.length} ${p.x} ${p.name} ${xs.length > 2 ? "many" : "few"}`);
  console.log(`${parseInt("12").unwrapOr(0)} ${(2.5).floor()} ${(3).toFloat()}`);
  console.log(`${match (n) { 5 => "five", _ => "other" }}`);

  // in other expression positions
  const joined = `<` + name + `>` + `${age}`;
  console.log(joined);
  console.log((`abc`).length.toString());
  console.log(`${name}`.length.toString());
  const arr = [`one`, `t${"w"}o`, `${3}`];
  console.log(arr.join(","));
  console.log(`x` == "x" ? `equal` : `different`);
  let acc = "";
  for (const k of [1, 2, 3]) {
    acc += `[${k}]`;
  }
  console.log(acc);
}
