import { Route, Get, Post } from "./route";

export class Users {
  @Route("/users/:id", Get)
  find(id: int): string {
    return "user " + id.toString();
  }

  @Route("/users", Post)
  create(): string {
    return "created";
  }

  @Route("/users/:id/posts/:post", Get)
  post(id: int, post: int): string {
    return "post " + post.toString() + " of " + id.toString();
  }

  helper(): int {
    return 1;
  }
}
