// The conversion happens inside arrow functions (the vtable is created while checking a lifted body).
interface Shape {
  area(): int;
}

class Circle implements Shape {
  constructor(public r: int) {}
  area(): int { return 3 * this.r * this.r; }
}

function build(f: (r: int) => Shape, n: int): int {
  return f(n).area();
}

function main(): void {
  const mk = (r: int): Shape => new Circle(r);
  console.log(build(mk, 2).toString());
  console.log(build(r => new Circle(r + 1), 2).toString());
  const wrap = (c: Circle): Shape => c;
  console.log(wrap(new Circle(1)).area().toString());
  const shapes = [1, 2, 3].map(r => mk(r));
  console.log(shapes.map(s => s.area().toString()).join(" "));
}
