      return false;
    }
    seen[free[i]] = true;
    i += 1;
  }
  let ids: usize[] = [root];
  let depths: usize[] = [0];
  let leafDepth: int = -1;
  let reachable: usize = 0;
  while (ids.length > 0) {
    const id = ids.pop().unwrap();
    const d = depths.pop().unwrap();
    if (seen[id]) {
      return false;
    }
    seen[id] = true;
    reachable += 1;
    const kc = nodes[id].keys.length;
