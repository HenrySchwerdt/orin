function show(xs: int[]): string {
  let s = "[";
  let i: usize = 0;
  while (i < xs.length) {
    if (i > 0) { s = s + ","; }
    s = s + xs[i].toString();
    i += 1;
  }
  return s + "]";
}

function fill(xs: int[]): int[] {
  let ys = xs;
  ys.push(0);
  ys[0] = -1;
  return ys;
}

function main(): void {
  let a = [1, 2, 3];
  const b = a;
  a[0] = 99;
  a.push(4);
  console.log(show(a));
  console.log(show(b));
  let c = a;
  c.pop();
  console.log(show(c));
  console.log(show(a));
  const orig = [5, 6];
  const r = fill(orig);
  console.log(show(orig));
  console.log(show(r));
}
