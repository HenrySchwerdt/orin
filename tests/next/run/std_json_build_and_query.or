import { Json, JNum, JStr, JArr, JObj, field, stringify, get, asInt, asArray, parse } from "std:json/legacy";

type Point = { x: int; y: int; };

function toJson(p: Point): Json {
  return JObj([field("x", JNum(p.x)), field("y", JNum(p.y))]);
}

function fromJson(j: Json): Option<Point> {
  const x = get(j, "x");
  const y = get(j, "y");
  if (x.isNone() || y.isNone()) {
    return None;
  }
  const xi = asInt(x.unwrap());
  const yi = asInt(y.unwrap());
  if (xi.isNone() || yi.isNone()) {
    return None;
  }
  return Some(Point { x: xi.unwrap(), y: yi.unwrap() });
}

function main(): void {
  const pts = [Point { x: 1, y: 2 }, Point { x: -3, y: 4 }];
  const doc = JArr(pts.map(p => toJson(p)));
  const text = stringify(doc);
  console.log(text);
  const back = asArray(parse(text).unwrap()).unwrap();
  let sum = 0;
  for (const j of back) {
    const p = fromJson(j).unwrap();
    sum += p.x * 10 + p.y;
  }
  console.log(sum.toString());
  console.log(fromJson(JStr("no")).isNone().toString());
}
