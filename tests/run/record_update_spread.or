type Person = { name: string; age: int; city: string; };

function describe(p: Person): string {
  return p.name + "," + p.age.toString() + "," + p.city;
}

function main(): void {
  const base = Person { name: "Ann", age: 30, city: "Oslo" };
  const older = Person { ...base, age: 31 };
  const moved = Person { ...base, name: "Bob", city: "Rome" };
  console.log(describe(base));
  console.log(describe(older));
  console.log(describe(moved));
  const again = Person { ...older, age: older.age + 1 };
  console.log(describe(again));
  console.log(describe(older));
}
