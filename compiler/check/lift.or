// Closure conversion (ADR-0011): an arrow function body and a top-level function used as a value become
// lifted functions (FuncInfo.mode 6) whose first parameter is the environment record of the captured
// variables. The checkers (expr.or) check the body; what is built here is the record, the entry
// prologue, the `Function` and its registration in the environment.

import { Span, Diagnostic, diag } from "../diag";
import { Type, Function, Local, FieldDef, RecordDef, HBlock, HStmt, HExpr, HExprKind } from "../hir";
import { Env, FuncInfo, isVoid } from "./env";
import { FnCtx } from "./fnctx";
import { mk, dummyDecl } from "./ops";
import { functionBound } from "./hirok";

export type LiftOut = { env: Env; fid: usize; };

// Registers the HIR of a lifted function (an arrow body or a function-value wrapper) in the
// environment, as function `fid` (FuncInfo.mode 6: its HIR is already checked). `ptys` are the
// parameter types, the environment record first.
@Requires(ptys.length == fn.paramCount && fn.paramCount <= fn.locals.length)
@Ensures(result.fid == env0.funcs.length && result.env.funcs.length == env0.funcs.length + 1)
@Ensures(result.env.lifted.length == env0.lifted.length + 1)
@Ensures(result.env.funcs[result.fid].mode == 6 && result.env.funcs[result.fid].cls == env0.lifted.length)
@Ensures(result.env.funcs[result.fid].paramLocals.length == fn.paramCount)
export function registerLifted(fx: FnCtx, env0: Env, fn: Function, ptys: Type[], span: Span): LiftOut {
  let e = env0;
  const lid = e.lifted.length;
  e.lifted.push(fn);
  const fid = e.funcs.length;
  let pl: Local[] = [];
  let k: usize = 0;
  while (k < fn.paramCount) {
    pl.push(fn.locals[k]);
    k += 1;
  }
  e.funcs.push(FuncInfo {
    unit: fx.unit,
    qname: fn.name,
    decl: dummyDecl(fn.name, span),
    params: ptys,
    paramLocals: pl,
    ret: fn.ret,
    tpNames: fx.tpNames,
    tpTys: fx.tpTys,
    depth: fx.depth,
    mode: 6,
    cls: lid,
    srcRet: TyVoid
  });
  return LiftOut { env: e, fid: fid };
}

// Closure conversion of a checked arrow body `stmts` (checked in the context `inner`, whose captures
// are the variables the body used): the environment record `lname$env` with one field per capture, the
// prologue `let <capture> = env.<field>` for each, and the lifted function with the result type
// `finalRet`. `ptys` are the arrow's own parameter types.
@Requires(inner.locals.length >= ptys.length + 1)
@Ensures(result.env.records.length == inner.env.records.length + 1)
@Ensures(result.env.lifted.length == inner.env.lifted.length + 1)
@Ensures(functionBound(result.env.lifted[result.env.lifted.length - 1]))
@Ensures(result.env.lifted[result.env.lifted.length - 1].paramCount == ptys.length + 1)
export function liftClosure(
  inner: FnCtx, lname: string, ptys: Type[], stmts: HStmt[], finalRet: Type, span: Span
): LiftOut {
  let e = inner.env;
  const rid = e.records.length;
  let fields: FieldDef[] = [];
  let k: usize = 0;
  while (k < inner.caps.names.length) {
    fields.push(FieldDef { name: inner.caps.names[k], ty: inner.caps.tys[k] });
    k += 1;
  }
  e.records.push(RecordDef { name: lname + "$env", fields: fields });
  const envTy = TyRecord(rid);
  let all: HStmt[] = [];
  k = 0;
  while (k < inner.caps.names.length) {
    const base = mk(XLocal(0), envTy, span);
    all.push(HLet(inner.caps.ids[k], mk(XField(base, rid, k), inner.caps.tys[k], span)));
    k += 1;
  }
  for (const h of stmts) {
    all.push(h);
  }
  let locals = inner.locals;
  locals[0] = Local { name: "env$", ty: envTy, mutable: false };
  const fn = Function {
    name: lname,
    paramCount: 1 + ptys.length,
    locals: locals,
    ret: finalRet,
    body: HBlock { stmts: all },
    span: span
  };
  let pfull: Type[] = [envTy];
  for (const t of ptys) {
    pfull.push(t);
  }
  return registerLifted(inner, e, fn, pfull, span);
}

export type WrapOut = { env: Env; wid: usize; created: bool; };

// The index of the lifted wrapper named `wname` in `env.funcs`, if one exists.
function findWrapper(env: Env, wname: string): Option<usize> {
  let k: usize = 0;
  while (k < env.funcs.length) {
    if (env.funcs[k].mode == 6 && env.funcs[k].qname == wname) {
      return Some(k);
    }
    k += 1;
  }
  return None;
}

// The lifted wrapper `f$closure(env, a, ..) { return f(a, ..); }` of function `fid`, so that the
// function can be used as a value. Created once per function (`created` tells whether this call did).
@Requires(fid < fx.env.funcs.length)
@Ensures(result.isOk() ==> result.unwrap().wid < result.unwrap().env.funcs.length)
@Ensures(result.isOk() ==> result.unwrap().env.funcs[result.unwrap().wid].mode == 6)
@Ensures(result.isOk() ==> result.unwrap().created
    ? result.unwrap().env.funcs.length == fx.env.funcs.length + 1
    : result.unwrap().env.funcs.length == fx.env.funcs.length)
export function wrapperOf(fx: FnCtx, span: Span, fid: usize): Result<WrapOut, Diagnostic> {
  const f = fx.env.funcs[fid];
  if (f.mode != 0) {
    return Err(diag("E0400", span, "function `" + f.decl.name.name + "` cannot be used as a value"));
  }
  const wname = f.qname + "$closure";
  const found = findWrapper(fx.env, wname);
  if (found.isSome()) {
    return Ok(WrapOut { env: fx.env, wid: found.unwrap(), created: false });
  }
  let e = fx.env;
  const rid = e.records.length;
  const none: FieldDef[] = [];
  e.records.push(RecordDef { name: wname + "$env", fields: none });
  const envTy = TyRecord(rid);
  let locals: Local[] = [Local { name: "env$", ty: envTy, mutable: false }];
  let args: HExpr[] = [];
  let pfull: Type[] = [envTy];
  let i: usize = 0;
  while (i < f.params.length) {
    locals.push(Local { name: "a" + i.toString(), ty: f.params[i], mutable: false });
    args.push(mk(XLocal(i + 1), f.params[i], span));
    pfull.push(f.params[i]);
    i += 1;
  }
  const call = mk(XCall(fid, args), f.ret, span);
  const st: HStmt = isVoid(f.ret) ? HExprStmt(call) : HReturn(Some(call));
  const fn = Function {
    name: wname,
    paramCount: 1 + f.params.length,
    locals: locals,
    ret: f.ret,
    body: HBlock { stmts: [st] },
    span: span
  };
  const lo = registerLifted(fx, e, fn, pfull, span);
  return Ok(WrapOut { env: lo.env, wid: lo.fid, created: true });
}
