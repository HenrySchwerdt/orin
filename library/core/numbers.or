// std prelude: number <-> string conversions (spec 19, R1). See module.or for the rules.
// Replaces orin_parse_int / orin_int_to_string / orin_usize_to_string / orin_bool_to_string.

// Decimal digits with no sign, no leading zeros (`0` for zero).
export function usizeToString(u: usize): string {
  if (u < 10) {
    return String.fromCharCode(48 + u.toInt());
  }
  let p: usize = 1;
  while (u / p >= 10) {
    p = p * 10;
  }
  let out = "";
  let r = u;
  while (p > 0) {
    out += String.fromCharCode(48 + (r / p).toInt());
    r = r % p;
    p = p / 10;
  }
  return out;
}

export function intToString(v: int): string {
  if (v >= 0) {
    return usizeToString(v.toUsize());
  }
  if (v == -9223372036854775807 - 1) {
    return "-9223372036854775808";
  }
  return "-" + usizeToString((-v).toUsize());
}

export function boolToString(v: bool): string {
  return v ? "true" : "false";
}

// Optional `-`, then one or more ASCII digits; None on anything else or when the value does not
// fit in an int. (No `+` sign, no whitespace.)
export function strParseInt(s: string): Option<int> {
  const n = s.length;
  let i: usize = 0;
  let neg = false;
  if (n > 0 && s.charCodeAt(0) == 45) {
    neg = true;
    i = 1;
  }
  if (i >= n) {
    return None;
  }
  const lo = -9223372036854775807 - 1;
  const hi = 9223372036854775807;
  let acc: int = 0;
  while (i < n) {
    const c = s.charCodeAt(i);
    if (c < 48 || c > 57) {
      return None;
    }
    const d = c - 48;
    if (neg) {
      if (acc < (lo + d) / 10) {
        return None;
      }
      acc = acc * 10 - d;
    } else {
      if (acc > (hi - d) / 10) {
        return None;
      }
      acc = acc * 10 + d;
    }
    i += 1;
  }
  return Some(acc);
}
