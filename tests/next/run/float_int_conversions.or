function main(): void {
  const n: int = 7;
  const u: usize = 9;
  console.log(n.toFloat().toString());
  console.log(u.toFloat().toString());
  console.log((n.toFloat() / 2.0).toString());
  console.log((-n).toFloat().toString());
  console.log(9007199254740993.toFloat().toString());
  console.log(3.99.toInt().toString());
  console.log((-3.99).toInt().toString());
  console.log(0.5.toInt().toString());
  console.log((-0.5).toInt().toString());
  console.log(1e18.toInt().toString());
  console.log((-9223372036854775808.0).toInt().toString());
  console.log(2.5.round().toString());
  console.log((-2.5).round().toString());
  console.log(3.5.round().toString());
  console.log(0.4.round().toString());
  console.log(2.7.floor().toString());
  console.log((-2.7).floor().toString());
  console.log(2.2.ceil().toString());
  console.log((-2.2).ceil().toString());
  console.log(2.5.floor().toInt().toString());
  console.log(16.0.sqrt().toString());
  console.log(2.0.sqrt().toString());
  console.log((-8.5).abs().toString());
  console.log(2.0.pow(10.0).toString());
  console.log(9.0.pow(0.5).toString());
}
