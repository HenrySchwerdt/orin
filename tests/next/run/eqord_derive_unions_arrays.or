type Tree = Leaf | Node(Tree, int, Tree);
type Pair<A, B> = { a: A; b: B; };
type Color = Red | Green | Blue;
type Wrap = { c: Color; xs: string[]; o: Option<int>; r: Result<int, string>; };

function contains<T extends Eq>(xs: T[], x: T): bool {
  for (const y of xs) {
    if (y == x) { return true; }
  }
  return false;
}

function sortBy<T extends Ord>(xs: T[]): T[] {
  let out = xs;
  let i: usize = 1;
  while (i < out.length) {
    let j = i;
    while (j > 0 && out[j - 1] > out[j]) {
      const t = out[j];
      out[j] = out[j - 1];
      out[j] = out[j];
      j -= 1;
    }
    i += 1;
  }
  return out;
}

function minOf<T extends Ord>(a: Option<T>, b: Option<T>): Option<T> {
  return a < b ? a : b;
}

function main(): void {
  const t1 = Node(Node(Leaf, 1, Leaf), 2, Leaf);
  const t2 = Node(Node(Leaf, 1, Leaf), 2, Leaf);
  const t3 = Node(Leaf, 2, Leaf);
  console.log((t1 == t2).toString());
  console.log((t1 == t3).toString());
  console.log((t3 < t1).toString());
  console.log(t1.hash() == t2.hash() ? "h" : "x");
  const p1 = Pair<int, string> { a: 1, b: "x" };
  const p2 = Pair<int, string> { a: 1, b: "y" };
  console.log(p1.compare(p2).toString());
  console.log(contains([p1], p2).toString());
  console.log(contains([Red, Green], Blue).toString());
  console.log(contains(["a", "b"], "b").toString());
  const w1 = Wrap { c: Green, xs: ["a"], o: Some(1), r: Ok(3) };
  const w2 = Wrap { c: Green, xs: ["a"], o: Some(1), r: Err("e") };
  console.log((w1 == w2).toString());
  console.log((w1 < w2).toString());
  console.log(minOf(Some(3), None).isSome().toString());
  console.log(minOf(Some(3), Some(1)).unwrap().toString());
  const f = (a: int, b: int): bool => a < b;
  const g = (a: Pair<int, string>, b: Pair<int, string>): bool => a == b;
  console.log(g(p1, p1).toString());
  const big: u8 = 200;
  const small: u8 = 3;
  console.log((big > small).toString());
  console.log(big.compare(small).toString());
  const i32a: i32 = -5;
  console.log((i32a.hash() == i32a.hash()).toString());
  console.log(true.compare(false).toString());
  console.log("abc".compare("abd").toString());
  console.log(("b" > "a").toString());
}
