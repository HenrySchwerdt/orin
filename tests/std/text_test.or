// std:text: whitespace is ASCII; byte-oriented, preserves Unicode payload bytes.
import { assertEqString, assertEqBool } from "std:test";
import { dedent, indentLines, normalizeNewlines, trimBlankLines } from "std:text";

@Test
function trimsOnlyOuterBlankLines(): void {
  assertEqString(trimBlankLines("\n \t\nhello\n\nworld\n  \n"), "hello\n\nworld", "outer blank");
  assertEqString(trimBlankLines(" \n\t\n"), "", "all blank");
  assertEqString(trimBlankLines(""), "", "empty");
  assertEqString(trimBlankLines(" hello \n"), " hello ", "keep content whitespace");
}

@Test
function dedentsSharedIndentation(): void {
  assertEqString(dedent("    alpha\n      beta\n    gamma"), "alpha\n  beta\ngamma", "common prefix");
  assertEqString(dedent("  foo\n\n    bar\n"), "foo\n\n  bar\n", "blank + trailing LF");
  assertEqString(dedent("abc\n def"), "abc\n def", "zero indent");
  assertEqString(dedent(""), "", "empty input");
  assertEqString(dedent("   \n \t"), "   \n \t", "all blank unchanged");
}

@Test
function prefixesOnlyNonEmptyLines(): void {
  assertEqString(indentLines("a\n\nb\n", "  "), "  a\n\n  b\n", "indent nonempty");
  assertEqString(indentLines("", "--"), "", "empty");
  assertEqString(indentLines("a", ""), "a", "empty prefix");
  assertEqString(indentLines("é\nλ", ">"), ">é\n>λ", "keep utf8 bytes");
}

@Test
function newlineNormalization(): void {
  assertEqString(normalizeNewlines("a\r\nb\rc\nd\r"), "a\nb\nc\nd\n", "mixed newline");
  assertEqString(normalizeNewlines("abc"), "abc", "unchanged");
  assertEqString(normalizeNewlines("\r\n\r"), "\n\n", "only newline");
  assertEqString(normalizeNewlines(""), "", "empty");
}

@Test
function transformationsAreIdempotent(): void {
  const doc = "\n    line a\n      line b\n\n";
  const once = dedent(trimBlankLines(doc));
  assertEqString(dedent(once), once, "dedent idempotence");
  assertEqString(trimBlankLines(once), once, "trim idempotence");
  const nl = normalizeNewlines("x\r\ny\rz");
  assertEqString(normalizeNewlines(nl), nl, "newline idempotence");
}
