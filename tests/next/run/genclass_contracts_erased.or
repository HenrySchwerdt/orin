// Without --check-contracts the clauses of a generic class are type-checked and erased: the violations
// below have no effect on behaviour.
@Invariant(this.items.length <= this.cap)
class Bounded<T> {
  items: T[] = [];
  cap: usize;

  @Requires(cap > 0)
  constructor(cap: usize) {
    this.cap = cap;
  }

  @Requires(this.items.length < this.cap)
  @Ensures(this.items.length == old(this.items.length) + 1)
  push(x: T): void {
    this.items.push(x);
  }
}

function main(): void {
  let b = new Bounded<int>(0);
  b.push(1);
  b.push(2);
  console.log(b.items.length.toString());
}
