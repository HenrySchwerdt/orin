function greet(name: string, age: u8): string {
  const a = `Hello ${name}, you are ${age+1}!`;
  const b = `plain, no interpolation`;
  const c = `nested ${ `inner ${name}` } and { braces } and \` and \${not}`;
  const d = `two
lines ${ age }
  keep   this   spacing`;
  const e = `${name}${name}${ name }`;
  /* a comment */
  const f = `// not a comment ${"}"} /* nor this */`;
  return a + b + c + d + e + f; // trailing comment
}
function main(): void {
  const x: u64 = 18446744073709551615;
  const y: i64 = -9223372036854775808;
  const z: u64 = 0xFFFFFFFFFFFFFFFF;
  const par = `parenthesised ${x}` + 18446744073709551615.toString();
  console.log(par);
  console.log(greet(`n`, 7) + x.toString() + y.toString() + z.toString());
}
