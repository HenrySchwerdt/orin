// Arrays of interface values: literal, push, index, length, for-of, slice.
interface Animal {
  sound(): string;
  legs(): int;
}

class Dog implements Animal {
  sound(): string { return "woof"; }
  legs(): int { return 4; }
}

class Bird implements Animal {
  constructor(public songs: int) {}
  sound(): string { return "tweet"; }
  legs(): int { return 2; }
}

function main(): void {
  let zoo: Animal[] = [];
  zoo.push(new Dog());
  zoo.push(new Bird(3));
  zoo.push(new Dog());
  console.log(zoo.length.toString());
  let legs = 0;
  for (const a of zoo) {
    legs += a.legs();
  }
  console.log(legs.toString());
  console.log(zoo[1].sound());
  const tail = zoo.slice(1, 3);
  console.log(tail.length.toString() + tail[1].sound());
  const sounds = zoo.map(a => a.sound());
  console.log(sounds.join(","));
}
