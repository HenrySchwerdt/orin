type Shape = Circle(int) | Rect(int, int) | Empty;

function area(s: Shape): int {
  return match (s) {
    Circle(r) => r * r * 3,
    Rect(w, h) => w * h,
    Empty => 0,
  };
}

function describe(s: Shape): void {
  match (s) {
    Circle(r) => { console.log("circle r=" + r.toString()); },
    Rect(w, _) => { console.log("rect w=" + w.toString()); },
    Empty => { console.log("empty"); },
  }
}

function grow(s: Shape): Shape {
  return match (s) {
    Circle(r) => Circle(r + 1),
    Rect(w, h) => Rect(w + 1, h + 1),
    Empty => Empty,
  };
}

function main(): void {
  const shapes: Shape[] = [Circle(2), Rect(3, 4), Empty];
  for (const s of shapes) {
    describe(s);
    console.log(area(s).toString());
  }
  console.log(area(grow(Circle(2))).toString());
  console.log(area(grow(Rect(1, 1))).toString());
  console.log(area(grow(Empty)).toString());
}
