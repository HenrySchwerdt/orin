// Workspace inspection. Paths are explicit; direct invocation discovers ancestors without a cwd primitive.
import { FsGrant, readFile, writeFile, exists, listDir } from "std:fs";
import {
  SourceFile, SourceMap, Diagnostic, render, renderTerminal, TerminalOptions, terminalOptions,
  terminalSafe,
} from "../diag";
import { parseWorkspace } from "./workspace";
import { parseToml } from "./toml";
import { Tree, Resolved, resolveWorkspace, lockText, checkLock } from "./resolve";
import { join } from "std:path";

function skipped(name: string): bool {
  return name == ".git/" || name == ".orin/" || name == "build/" || name == "node_modules/";
}

// Keep every returned path relative to the workspace; file ids and tree lookup use that same order.
type Directory = { path: string; entries: string[]; };

function walk(fs: FsGrant, root: string): Directory[] {
  let out: Directory[] = [];
  let todo: string[] = [""];
  while (todo.length > 0) {
    const d = todo.pop().unwrap();
    const entries = listDir(fs, join([root, d]));
    out.push(Directory { path: d, entries: entries });
    for (const e of entries) {
      if (e.endsWith("/") && !skipped(e)) {
        const name = e.substring(0, e.length - 1);
        const path = d == "" ? name : d + "/" + name;
        todo.push(path);
      }
    }
  }
  return out;
}

function report(files: SourceFile[], d: Diagnostic, ui: TerminalOptions): usize {
  const sources = SourceMap { files: files };
  const compact = render(sources, d).split("\n").map(line => terminalSafe(line)).join("\n");
  console.error(ui.rich ? renderTerminal(sources, d, ui.color, ui.ascii) : compact);
  return 1;
}

function usage(): usize {
  console.error("usage: orin workspace list|lock|check [--root <directory>]");
  return 2;
}

// Standalone projects use a pipe-delimited lock. Unknown files must not be replaced either.
function workspaceLock(text: string): bool {
  const parsed = parseToml(0, text);
  if (parsed.isErr()) {
    return false;
  }
  let member = false;
  for (const table of parsed.unwrap().tables) {
    if (table.path.length == 0 && table.entries.length == 0) {
      continue;
    }
    if (table.path.length != 2 || table.path[0] != "member") {
      return false;
    }
    if (table.entries.length != 3) {
      return false;
    }
    for (const entry of table.entries) {
      const valid = match (entry.value) {
        TStr(v) => entry.key == "path" || entry.key == "version",
        TArr(vs) => entry.key == "dependencies",
        _ => false,
      };
      if (!valid) {
        return false;
      }
    }
    member = true;
  }
  return member || text == "# generated by `orin lock`; do not edit\n";
}

export function runWorkspace(fs: FsGrant, argv: string[]): usize {
  return runWorkspaceWithOptions(fs, argv, terminalOptions([]));
}

export function runWorkspaceWithOptions(fs: FsGrant, argv: string[], ui: TerminalOptions): usize {
  if (argv.length == 1 && (argv[0] == "--help" || argv[0] == "-h")) {
    console.log("usage: orin workspace list|lock|check [--root <directory>]");
    return 0;
  }
  const sub = argv.length > 0 ? argv[0] : "";
  if (sub != "list" && sub != "lock" && sub != "check") {
    return usage();
  }
  let root = ".";
  let explicit = false;
  let defaultOnly = false;
  let rest = argv.slice(1, argv.length);
  if (sub == "list" && rest.length > 0 && rest[0] == "--default") {
    defaultOnly = true;
    rest = rest.slice(1, rest.length);
  }
  if (rest.length != 0) {
    if (rest.length != 2 || rest[0] != "--root" || rest[1] == "" || rest[1].startsWith("--")) {
      return usage();
    }
    root = rest[1];
    explicit = true;
  }
  if (!explicit) {
    // Relative paths have no lexical filesystem-root sentinel. Bound the walk, and offer --root to bypass it.
    let depth: usize = 0;
    while (!exists(fs, join([root, "orin-workspace.toml"])) && depth < 256) {
      root = join([root, ".."]);
      depth += 1;
    }
    if (!exists(fs, join([root, "orin-workspace.toml"]))) {
      console.error(
        "error: no orin-workspace.toml found within 256 ancestors; use --root <directory>",
      );
      return 1;
    }
  }
  const wsPath = join([root, "orin-workspace.toml"]);
  const wsRead = readFile(fs, wsPath);
  if (wsRead.isErr()) {
    console.error(terminalSafe("error: cannot read " + wsPath + ": " + wsRead.unwrapErr()));
    return 1;
  }
  const wsText = wsRead.unwrap();
  let files: SourceFile[] = [SourceFile { path: wsPath, text: wsText }];
  const wr = parseWorkspace(0, wsText);
  if (wr.isErr()) {
    return report(files, wr.unwrapErr(), ui);
  }
  const listings = walk(fs, root);
  let dirs: string[] = [];
  let workspaces: string[] = [];
  let npmDirs: string[] = [];
  let texts: Option<string>[] = [];
  for (const listing of listings) {
    const d = listing.path;
    if (d == "") {
      continue;
    }
    dirs.push(d);
    const path = join([root, d]);
    if (listing.entries.includes("orin-workspace.toml")) {
      workspaces.push(d);
    }
    if (listing.entries.includes("package.json")) {
      npmDirs.push(d);
    }
    const manifestPath = join([path, "orin.toml"]);
    let text: Option<string> = None;
    if (listing.entries.includes("orin.toml") || listing.entries.includes("orin.toml/")) {
      const read = readFile(fs, manifestPath);
      if (read.isErr()) {
        console.error(terminalSafe("error: cannot read " + manifestPath + ": " + read.unwrapErr()));
        return 1;
      }
      text = Some(read.unwrap());
    }
    texts.push(text);
    files.push(SourceFile { path: manifestPath, text: text.unwrapOr("") });
  }
  const tree = Tree {
    dirs: dirs,
    workspaceDirs: workspaces,
    npmDirs: npmDirs,
    manifest: (d: string) => {
      let i: usize = 0;
      while (i < dirs.length) {
        if (dirs[i] == d) {
          return texts[i];
        }
        i += 1;
      }
      return None;
    },
  };
  const rr = resolveWorkspace(wr.unwrap(), tree, 1);
  if (rr.isErr()) {
    return report(files, rr.unwrapErr(), ui);
  }
  const r: Resolved = rr.unwrap();
  if (sub == "list") {
    for (const i of r.order) {
      // `--default`: only the `default-members` (all members when the key is absent), still in build order.
      if (defaultOnly && r.defaults.length > 0 && !r.defaults.includes(i)) {
        continue;
      }
      console.log(terminalSafe(r.members[i].name + "  " + r.members[i].dir));
    }
    return 0;
  }
  const lockPath = join([root, "orin.lock"]);
  if (sub == "lock") {
    if (exists(fs, lockPath)) {
      const previous = readFile(fs, lockPath);
      if (previous.isErr()) {
        console.error(terminalSafe("error: cannot read " + lockPath + ": " + previous.unwrapErr()));
        return 1;
      }
      if (!workspaceLock(previous.unwrap())) {
        console.error("error: refusing to replace a standalone project or unrecognized orin.lock");
        return 1;
      }
    }
    const w = writeFile(fs, lockPath, lockText(r));
    if (w.isErr()) {
      console.error(terminalSafe("error: cannot write " + lockPath + ": " + w.unwrapErr()));
      return 1;
    }
    return 0;
  }
  const lock = readFile(fs, lockPath);
  if (lock.isErr()) {
    console.error(
      terminalSafe("error[E0509]: cannot read " + lockPath + "; run `orin workspace lock`"),
    );
    return 1;
  }
  files.push(SourceFile { path: lockPath, text: lock.unwrap() });
  return match (checkLock(r, files.length - 1, lock.unwrap())) {
    Some(d) => report(files, d, ui),
    None => 0,
  };
}
