// The same program without --check-contracts: clauses are erased, nothing is checked (ADR-0012).
class Cell<T> {
  v: T;

  constructor(v: T) {
    this.v = v;
  }

  @Requires(n > 0)
  many<U>(u: U, n: int): U[] {
    return [u];
  }
}

function main(): void {
  const c = new Cell<int>(1);
  console.log(c.many("x", 0).length.toString());
}
