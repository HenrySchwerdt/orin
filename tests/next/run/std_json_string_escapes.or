import { parse, stringify, asString, quote } from "std:json";

function main(): void {
  const j = parse("\"a\\nb\\t\\\"q\\\" \\\\ \\/ \\b\\f\\r\"").unwrap();
  const s = asString(j).unwrap();
  console.log(s.length.toString());
  console.log(stringify(j));
  console.log(quote("plain"));
  console.log(quote(""));
  console.log(quote("tab\there"));
  console.log(quote(String.fromCharCode(0)));
  console.log(quote(String.fromCharCode(127)).length.toString());
}
