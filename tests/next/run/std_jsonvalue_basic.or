// flags: --check-contracts
import {
  parseDocument, writeDocument, defaultReadOptions, defaultLimits, JsonValue, JsonMember,
  JsonDuplicatePolicy, JsonReadOptions,
} from "std:json";
import { numberFromInt } from "std:json/number";
function main(): void {
  const source = " {\"n\":9007199254740993,\"f\":1.00e+3,\"s\":\"\\ud83d\\ude00\",\"e\":\"\"} ";
  console.log(
    writeDocument(parseDocument(source, defaultReadOptions()).unwrap(), defaultLimits()).unwrap(),
  );
  const duplicate = "{\"a\":1,\"\\u0061\":2}";
  console.log(parseDocument(duplicate, defaultReadOptions()).unwrapErr().offset.toString());
  const opt = JsonReadOptions { limits: defaultLimits(), duplicates: PreserveDuplicates };
  console.log(writeDocument(parseDocument(duplicate, opt).unwrap(), opt.limits).unwrap());
  const built = ValueObject([
    JsonMember { key: "id", value: ValueNumber(numberFromInt(-9223372036854775807 - 1)) },
  ]);
  console.log(writeDocument(built, defaultLimits()).unwrap());
}
