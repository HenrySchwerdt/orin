type Pair<A, B> = { first: A; second: B; };

function describe(p: Pair<int, string>): string {
  return p.first.toString() + ":" + p.second;
}

function main(): void {
  const p: Pair<int, string> = Pair { first: 1, second: "one" };
  console.log(describe(p));
  const q = Pair { first: 2, second: "two" };
  console.log(describe(q));
  const r = Pair<int, string> { first: 3, second: "three" };
  console.log(describe(r));
  const s = Pair { first: true, second: [1, 2] };
  console.log(s.first.toString() + s.second.length.toString());
  let m = Pair { first: 0, second: "z" };
  m.first = 9;
  m.second += "!";
  console.log(describe(m));
  console.log(describe(q));
}
