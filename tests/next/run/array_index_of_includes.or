function main(): void {
  const ints = [10, 20, 30, 20];
  console.log(ints.indexOf(20).unwrap().toString());
  console.log(ints.indexOf(99).isNone().toString());
  console.log(ints.includes(30).toString() + ints.includes(31).toString());
  const sizes: usize[] = [4, 8, 15];
  console.log(sizes.indexOf(15).unwrap().toString() + sizes.includes(8).toString());
  const flags = [false, false, true];
  console.log(flags.indexOf(true).unwrap().toString() + flags.includes(false).toString());
  const names = ["ann", "bob", "cy"];
  console.log(names.indexOf("cy").unwrap().toString() + names.includes("dee").toString());
  const empty: string[] = [];
  console.log(empty.includes("x").toString() + empty.indexOf("x").isNone().toString());
  console.log("hello".indexOf("l").unwrap().toString() + "hello".includes("ell").toString());
}
