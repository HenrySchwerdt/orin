function main(): void {
  let m = new Map<string, int>();
  let i = 0;
  while (i < 100000) {
    m.set("user-" + i.toString(), i);
    i += 1;
  }
  console.log(m.size.toString());
  let hits = 0;
  i = 0;
  while (i < 100000) {
    if (m.has("user-" + (i * 2).toString())) {
      hits += 1;
    }
    i += 1;
  }
  console.log(hits.toString());
  console.log(m.get("user-77777").unwrap().toString());
  console.log(m.keys()[99999]);
  i = 0;
  while (i < 50000) {
    m.set("user-" + i.toString(), i + 1);
    i += 1;
  }
  console.log(m.size.toString());
  console.log(m.get("user-10").unwrap().toString());
}
