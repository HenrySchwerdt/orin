// exit: 3
// process.exit inside a scope: the open file is flushed and closed by the runtime's exit hook.
import { useFile, Write } from "std:fs";
import { exit } from "std:process";

function main(): void {
  const r = useFile("build/tests/fs_exit_in_scope.txt", Write, f => {
    f.write("written before exit");
    console.log("in scope");
    exit(3);
  });
  console.log("not reached");
}
