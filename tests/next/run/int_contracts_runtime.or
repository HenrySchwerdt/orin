// flags: --check-contracts
// exit: 101
// stderr: trap: contract violated: @Requires(x > 0 && x <= 200)
// Runtime contract checks on fixed-width integers: literals adopt the parameter type, comparisons and
// arithmetic of any width, @Ensures with result, @Invariant on a loop counter of a narrow type.
@Requires(x > 0 && x <= 200)
@Ensures(result == x.toU16() * 2)
function double(x: u8): u16 {
  return x.toU16() * 2;
}

@Requires(a >= -100 && a <= 100)
@Ensures(result >= -100 && result <= 100)
function clampAdd(a: i8, b: i8): i8 {
  return a.saturatingAdd(b).saturatingMul(1);
}

@Requires(n >= 0)
function sumTo(n: i32): i32 {
  let s: i32 = 0;
  let i: i32 = 0;
  @Invariant(i >= 0 && i <= n)
  while (i < n) {
    i += 1;
    s += i;
  }
  return s;
}

@Requires(big > 9223372036854775807)
function huge(big: u64): u64 {
  return big;
}

function main(): void {
  console.log(double(100).toString());
  console.log(clampAdd(50, 40).toString());
  console.log(sumTo(1000).toString());
  console.log(huge(18446744073709551615).toString());
  console.log(double(0).toString());
  console.log("not reached");
}
