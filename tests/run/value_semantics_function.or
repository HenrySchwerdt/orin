function show(xs: int[]): string {
  let s = "[";
  let i: usize = 0;
  while (i < xs.length) {
    if (i > 0) { s = s + ","; }
    s = s + xs[i].toString();
    i += 1;
  }
  return s + "]";
}

type Person = { name: string; };

function fill(xs: int[]): int[] {
  let ys = xs;
  ys.push(99);
  ys[0] = 0;
  return ys;
}

function rename(p: Person): Person {
  let q = p;
  q.name = "changed";
  return q;
}

function main(): void {
  const a = [1, 2, 3];
  const b = fill(a);
  console.log(show(a));
  console.log(show(b));
  let c = [7];
  c = fill(c);
  console.log(show(c));
  const p = Person { name: "orig" };
  const q = rename(p);
  console.log(p.name);
  console.log(q.name);
}
