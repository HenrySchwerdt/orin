// Pure config validation; parsing and demo output are separate at the boundary.
import { JsonValue, parseDocument, defaultReadOptions, defaultLimits } from "std:json";
import {
  DecodeError, UnknownFieldPolicy, decodeRoot, checkFields, requiredField, optionalField,
  decodeString, decodeInt, decodeBool,
} from "std:json/decode";

export type Config = { endpoint: string; port: int; enabled: bool; };
export function decodeConfig(v: JsonValue): Result<Config, DecodeError> {
  const root = decodeRoot(v, defaultLimits())?;
  checkFields(root, ["endpoint", "port", "enabled"], RejectUnknown)?;
  const endpoint = decodeString(requiredField(root, "endpoint")?)?;
  const port = decodeInt(requiredField(root, "port")?, 1, 65535)?;
  const flag = optionalField(root, "enabled")?;
  let enabled = true;
  if (flag.isSome()) {
    enabled = decodeBool(flag.unwrap())?;
  }
  return Ok(Config { endpoint: endpoint, port: port, enabled: enabled });
}
function main(): void {
  const value = parseDocument(
    "{\"endpoint\":\"localhost\",\"port\":8.080e3}",
    defaultReadOptions(),
  ).unwrap();
  const config = decodeConfig(value).unwrap();
  console.log(config.endpoint);
  console.log(config.port.toString());
  console.log(config.enabled.toString());
}
