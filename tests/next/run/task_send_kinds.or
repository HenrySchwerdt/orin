// std:task: every kind of value crosses a task boundary: a Map, an interface value (a boxed class instance) and a closure travel
// through channels and are used by the receiving task (1 + 2 + 7*7 + 101).
import { scope, spawn, channel } from "std:task";

interface Shape {
  area(): int;
}

class Sq implements Shape {
  side: int;
  constructor(side: int) {
    this.side = side;
  }
  area(): int {
    return this.side * this.side;
  }
}

function main(): void {
  let m = new Map<string, int>();
  m.set("a", 1);
  m.set("b", 2);
  const ch = channel<Map<string, int>>(2);
  const shapes = channel<Shape>(2);
  const f = (x: int) => x + 100;
  const fch = channel<(x: int) => int>(1);
  const total = scope(s => {
    const h = spawn(s, () => {
      const got = ch.rx.recv().unwrap();
      const sh = shapes.rx.recv().unwrap();
      const fn = fch.rx.recv().unwrap();
      return got.get("a").unwrap() + got.get("b").unwrap() + sh.area() + fn(1);
    });
    ch.tx.send(m);
    shapes.tx.send(new Sq(7));
    fch.tx.send(f);
    return h.join();
  });
  console.log(total.toString());
}
