function sign(n: int): string {
  return n < 0 ? "neg" : n == 0 ? "zero" : "pos";
}

function max(a: int, b: int): int {
  return a > b ? a : b;
}

function main(): void {
  console.log(sign(-5));
  console.log(sign(0));
  console.log(sign(7));
  console.log(max(3, 9).toString());
  console.log(max(9, 3).toString());
  const x = 4;
  const label = x % 2 == 0 ? "even" : "odd";
  console.log(label);
  const neg = x > 3 ? -1 : 1;
  console.log(neg.toString());
  const nested = (x > 3 ? 10 : 20) + (x > 5 ? 1 : 2);
  console.log(nested.toString());
}
