// std:encoding: strict RFC 4648 byte codecs. See docs/std-encoding.md for
// padding policy, error precedence, allocation and complexity. No crypto claims.
import { Bytes, ByteBuilder } from "std:bytes";

export type EncodingErrorKind = InvalidByte | InvalidLength | InvalidPadding | NonCanonical;
export type EncodingError = { position: usize; kind: EncodingErrorKind; };

@Ensures(result.length > 0)
export function encodingErrorMessage(e: EncodingError): string {
  const why = match (e.kind) {
    InvalidByte => "invalid alphabet byte",
    InvalidLength => "invalid encoded length",
    InvalidPadding => "invalid padding",
    NonCanonical => "nonzero unused bits",
  };
  return `encoding error at byte ${e.position.toString()}: ${why}`;
}

function bad(position: usize, kind: EncodingErrorKind): Result<Bytes, EncodingError> {
  return Err(EncodingError { position: position, kind: kind });
}

function hexValue(c: int): int {
  if (c >= 48 && c <= 57) {
    return c - 48;
  }
  if (c >= 65 && c <= 70) {
    return c - 55;
  }
  if (c >= 97 && c <= 102) {
    return c - 87;
  }
  return -1;
}

// Lowercase ASCII hex. O(n) time/storage; one final conversion to string.
@Ensures(result.length / 2 == src.length() && result.length % 2 == 0)
export function hexEncode(src: Bytes): string {
  const digits = "0123456789abcdef";
  const data = src.storage();
  const start = src.storageStart();
  const n = src.length();
  let out = new ByteBuilder();
  let i: usize = 0;
  while (i < n) {
    const b = data[start + i].toInt();
    out.appendU8(digits.charCodeAt((b / 16).toUsize()).toU8());
    out.appendU8(digits.charCodeAt((b % 16).toUsize()).toU8());
    i += 1;
  }
  return out.build().toRawString();
}

// Both cases accepted. Invalid bytes precede odd-length errors. O(n).
@Ensures(result.isOk() ==> src.length() % 2 == 0 && result.unwrap().length() == src.length() / 2)
@Ensures(result.isErr() ==> result.unwrapErr().position <= src.length())
export function hexDecode(src: Bytes): Result<Bytes, EncodingError> {
  const data = src.storage();
  const start = src.storageStart();
  const n = src.length();
  let i: usize = 0;
  while (i < n) {
    if (hexValue(data[start + i].toInt()) < 0) {
      return bad(i, InvalidByte);
    }
    i += 1;
  }
  if (n % 2 != 0) {
    return bad(n, InvalidLength);
  }
  let out = new ByteBuilder();
  i = 0;
  while (i < n) {
    const hi = hexValue(data[start + i].toInt());
    const lo = hexValue(data[start + i + 1].toInt());
    out.appendU8((hi * 16 + lo).toU8());
    i += 2;
  }
  return Ok(out.build());
}

function alphabet(url: bool): string {
  return url
      ? "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"
      : "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
}

function value(c: int, url: bool): int {
  if (c >= 65 && c <= 90) {
    return c - 65;
  }
  if (c >= 97 && c <= 122) {
    return c - 71;
  }
  if (c >= 48 && c <= 57) {
    return c + 4;
  }
  if (c == (url ? 45 : 43)) {
    return 62;
  }
  if (c == (url ? 95 : 47)) {
    return 63;
  }
  return -1;
}

function encode64(src: Bytes, padded: bool, url: bool): string {
  const digits = alphabet(url);
  const data = src.storage();
  const start = src.storageStart();
  const n = src.length();
  let out = new ByteBuilder();
  let i: usize = 0;
  while (i < n) {
    const a = data[start + i].toInt();
    const remaining = n - i;
    let b = 0;
    let c = 0;
    if (remaining > 1) {
      b = data[start + i + 1].toInt();
    }
    if (remaining > 2) {
      c = data[start + i + 2].toInt();
    }
    out.appendU8(digits.charCodeAt((a / 4).toUsize()).toU8());
    out.appendU8(digits.charCodeAt((a % 4 * 16 + b / 16).toUsize()).toU8());
    if (remaining > 1) {
      out.appendU8(digits.charCodeAt((b % 16 * 4 + c / 64).toUsize()).toU8());
    } else {
      if (padded) {
        out.appendU8(61);
      }
    }
    if (remaining > 2) {
      out.appendU8(digits.charCodeAt((c % 64).toUsize()).toU8());
    } else {
      if (padded) {
        out.appendU8(61);
      }
    }
    // Avoid stepping past the last (possibly partial) group.
    i += remaining < 3 ? remaining : 3;
  }
  return out.build().toRawString();
}

function decode64(src: Bytes, padded: bool, url: bool): Result<Bytes, EncodingError> {
  const data = src.storage();
  const start = src.storageStart();
  const n = src.length();
  let count = n;
  let padding: usize = 0;
  let i: usize = 0;
  while (i < n) {
    const c = data[start + i].toInt();
    if (c == 61) {
      if (!padded || padding == 2 || i % 4 < 2) {
        return bad(i, InvalidPadding);
      }
      if (padding == 0) {
        count = i;
      }
      padding += 1;
    } else {
      if (value(c, url) < 0) {
        return bad(i, InvalidByte);
      }
      if (padding > 0) {
        return bad(i, InvalidPadding);
      }
    }
    i += 1;
  }
  const tail = count % 4;
  if (padded) {
    if (n % 4 != 0) {
      return bad(n, InvalidLength);
    }
    if (padding == 1 && tail != 3 || padding == 2 && tail != 2) {
      return bad(n, InvalidPadding);
    }
  } else {
    if (tail == 1) {
      return bad(n, InvalidLength);
    }
  }
  if (tail == 2 && value(data[start + count - 1].toInt(), url) % 16 != 0) {
    return bad(count - 1, NonCanonical);
  }
  if (tail == 3 && value(data[start + count - 1].toInt(), url) % 4 != 0) {
    return bad(count - 1, NonCanonical);
  }
  let out = new ByteBuilder();
  let acc = 0;
  let phase: usize = 0;
  i = 0;
  while (i < count) {
    const v = value(data[start + i].toInt(), url);
    if (phase == 0) {
      acc = v;
    }
    if (phase == 1) {
      out.appendU8((acc * 4 + v / 16).toU8());
      acc = v % 16;
    }
    if (phase == 2) {
      out.appendU8((acc * 16 + v / 4).toU8());
      acc = v % 4;
    }
    if (phase == 3) {
      out.appendU8((acc * 64 + v).toU8());
      acc = 0;
    }
    phase = (phase + 1) % 4;
    i += 1;
  }
  return Ok(out.build());
}

// RFC 4648 standard alphabet; padded selects required padding versus forbidden.
@Ensures(padded ==> result.length % 4 == 0)
@Ensures(padded
    ==> result.length / 4 == src.length() / 3 + (src.length() % 3 == 0 ? 0 : 1).toUsize())
@Ensures(!padded ==> result.length / 4 == src.length() / 3)
@Ensures(!padded ==> result.length % 4 == (src.length() % 3 == 0 ? 0 : src.length() % 3 + 1))
export function base64Encode(src: Bytes, padded: bool): string {
  return encode64(src, padded, false);
}

@Ensures(result.isErr() ==> result.unwrapErr().position <= src.length())
@Ensures(result.isOk() ==> result.unwrap().length() <= src.length())
export function base64Decode(src: Bytes, padded: bool): Result<Bytes, EncodingError> {
  return decode64(src, padded, false);
}

// RFC 4648 URL alphabet; padding policy identical to standard Base64.
@Ensures(padded ==> result.length % 4 == 0)
@Ensures(padded
    ==> result.length / 4 == src.length() / 3 + (src.length() % 3 == 0 ? 0 : 1).toUsize())
@Ensures(!padded ==> result.length / 4 == src.length() / 3)
@Ensures(!padded ==> result.length % 4 == (src.length() % 3 == 0 ? 0 : src.length() % 3 + 1))
export function base64UrlEncode(src: Bytes, padded: bool): string {
  return encode64(src, padded, true);
}

@Ensures(result.isErr() ==> result.unwrapErr().position <= src.length())
@Ensures(result.isOk() ==> result.unwrap().length() <= src.length())
export function base64UrlDecode(src: Bytes, padded: bool): Result<Bytes, EncodingError> {
  return decode64(src, padded, true);
}
