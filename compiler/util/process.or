// Running shell commands.

import { ProcessGrant } from "std:process";
import { shell, shellTimeout } from "std:io";

// Runs a shell command, returns its exit status (-1: could not run / signalled).
export function shellRun(proc: ProcessGrant, cmd: string): int {
  return shell(proc, cmd);
}

// seconds > 0: native monotonic deadline; -2 timeout. 0 explicitly disables the limit.
export function shellRunTimeout(proc: ProcessGrant, cmd: string, seconds: int): int {
  if (seconds == 0) { return shell(proc, cmd); }
  return shellTimeout(proc, cmd, seconds);
}
