function name(n: int): string {
  return match (n) {
    0 => "zero",
    1 => "one",
    2 => "two",
    _ => "many",
  };
}

function cmd(s: string): int {
  return match (s) {
    "start" => 1,
    "stop" => 2,
    "" => 3,
    _ => 0,
  };
}

function yn(b: bool): string {
  return match (b) {
    true => "yes",
    _ => "no",
  };
}

function wild(n: int): int {
  match (n) {
    7 => { return 70; },
    _ => { return n; },
  }
}

function main(): void {
  console.log(name(0));
  console.log(name(1));
  console.log(name(2));
  console.log(name(99));
  console.log(name(-1));
  console.log(cmd("start").toString());
  console.log(cmd("stop").toString());
  console.log(cmd("").toString());
  console.log(cmd("other").toString());
  console.log(yn(true));
  console.log(yn(false));
  console.log(wild(7).toString());
  console.log(wild(8).toString());
}
