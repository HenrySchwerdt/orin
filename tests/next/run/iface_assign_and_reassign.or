// Interface-typed `let` variables are reassigned with different classes; old values are released.
interface Animal {
  noise(): string;
}

class Cat implements Animal {
  noise(): string { return "meow"; }
}

class Cow implements Animal {
  constructor(public n: int) {}
  noise(): string { return "moo" + this.n.toString(); }
}

function main(): void {
  let a: Animal = new Cat();
  console.log(a.noise());
  a = new Cow(1);
  console.log(a.noise());
  const b = a;
  a = new Cow(2);
  console.log(b.noise() + a.noise());
  let xs: Animal[] = [new Cat(), new Cat()];
  xs[1] = new Cow(9);
  console.log(xs[0].noise() + xs[1].noise());
}
