// flags: --check-contracts
import { ByteBuilder, ByteReader, fromString } from "std:bytes";
import { hexDecodeText } from "std:encoding";

function main(): void {
  let w = new ByteBuilder();
  w.appendU8(1);
  w.appendU16Be(0x0203);
  w.appendU32Le(0x08070605);
  w.appendString("hi");
  const b = w.build();
  console.log(b.toHex());
  console.log(b.length().toString());
  let r = new ByteReader(b);
  console.log(r.readU8().unwrap().toString());
  console.log(r.readU16Be().unwrap().toString());
  console.log(r.readU32Le().unwrap().toString());
  console.log(r.readExact(2).unwrap().toRawString());
  const e = r.readU8();
  console.log(e.isErr().toString());
  console.log(e.unwrapErr().offset.toString());
  console.log(fromString("a\x7f").toHex());
  console.log(hexDecodeText("zz").isErr().toString());
}
