// The core operations of the runtime core dialect (ADR-0013, ADR-0052 step R3a, spec 19 section 4): ONE builtin
// `BCore(k)` whose number k selects the operation. They give Orin code raw access to memory so that the C object model of
// runtime/core can be rewritten in Orin (R3b..R3f). An address is a plain `usize`; there is no new type and no operation
// that turns an address back into a reference. They are reachable only through the internal module `std:fsraw`, which only
// library code can import (E0301 for user code); a later step narrows that gate to the runtime modules.
//
// | k  | name     | C                                         | arguments -> result                                       |
// |----|----------|-------------------------------------------|-----------------------------------------------------------|
// | 0  | load8    | 1-byte load, zero-extended                | (addr) -> usize                                           |
// | 1  | load32   | 4-byte load, zero-extended                | (addr) -> usize                                           |
// | 2  | load64   | 8-byte load                               | (addr) -> usize                                           |
// | 3  | loadF64  | 8-byte load as an IEEE double             | (addr) -> float                                           |
// | 4  | store8   | 1-byte store of the low 8 bits            | (addr, v: usize) -> void                                  |
// | 5  | store32  | 4-byte store of the low 32 bits           | (addr, v: usize) -> void                                  |
// | 6  | store64  | 8-byte store                              | (addr, v: usize) -> void                                  |
// | 7  | storeF64 | 8-byte store of an IEEE double            | (addr, v: float) -> void                                  |
// | 8  | memAlloc | orin_platform_alloc                       | (n: usize) -> usize (never 0; n = 0 allocates 1 byte)     |
// | 9  | memFree  | orin_platform_free                        | (addr) -> void                                            |
// | 10 | memCopy  | orin_platform_mem_copy                    | (dst, src, n) -> void (the ranges must not overlap)       |
// | 11 | memSet   | orin_platform_mem_set                     | (dst, byte: usize (low 8 bits), n) -> void                |
// | 12 | addrOf   | pointer to usize                          | (x: string | array | record) -> usize, the object      |
// |    |          |                                           | address; reads x, the reference count does not change     |
//
// Loads and stores are native-endian and need no alignment (both backends emit an unaligned access). The memory
// operations map to the L0 functions of runtime/platform/orin_platform.h; the LLVM backend emits the same behaviour with
// libc malloc / free and the LLVM memory intrinsics (L0's functions are static inline in a C header). Effects (ADR-0031):
// every core operation is conservative: a load reads mutable memory, the others write it, so none of them is pure.

export function coreOpCount(): usize {
  return 13;
}

function names(): string[] {
  return [
    "load8", "load32", "load64", "loadF64", "store8", "store32", "store64", "storeF64", "memAlloc", "memFree", "memCopy",
    "memSet", "addrOf"
  ];
}

// The name std:fsraw exports operation k under; "" for an unknown k.
export function coreOpName(k: usize): string {
  const ns = names();
  return k < ns.length ? ns[k] : "";
}

// The operation called `name` in std:fsraw.
export function coreOpFromName(name: string): Option<usize> {
  const ns = names();
  let i: usize = 0;
  while (i < ns.length) {
    if (ns[i] == name) {
      return Some(i);
    }
    i += 1;
  }
  return None;
}

// Result kind: 0 void, 1 a 64-bit integer (usize), 2 an IEEE double.
export function coreOpRet(k: usize): int {
  if (k == 3) {
    return 2;
  }
  if (k == 0 || k == 1 || k == 2 || k == 8 || k == 12) {
    return 1;
  }
  return 0;
}

// True for a load (reads memory, writes nothing); false for the operations that write or allocate. addrOf touches no
// memory at all and is counted as a read.
export function coreOpReads(k: usize): bool {
  return k <= 3 || k == 12;
}
