// Array API prelude (spec 08, ADR-0011): the non-mutating array methods, written in Orin.
//
// This file is compiled together with every program as a hidden unit named `std:array`
// (check/checker.or injects it; compiler/prelude/source.or embeds this text and is generated by
// tools/gen_prelude.py). It is not importable and its names are not in scope of user code: the
// checker rewrites `xs.map(f)` to a call of the generic function `map` below with the receiver as
// first argument. Generic functions are checked once abstractly and instantiated per use, so a
// program that never calls an array method pays nothing but the (small) abstract check.
//
// Every function returns a new value; none mutates its arguments (value semantics, spec 03).

export function map<T, U>(xs: T[], f: (x: T) => U): U[] {
  let out: U[] = [];
  for (const x of xs) {
    out.push(f(x));
  }
  return out;
}

export function filter<T>(xs: T[], pred: (x: T) => bool): T[] {
  let out: T[] = [];
  for (const x of xs) {
    if (pred(x)) {
      out.push(x);
    }
  }
  return out;
}

export function find<T>(xs: T[], pred: (x: T) => bool): Option<T> {
  for (const x of xs) {
    if (pred(x)) {
      return Some(x);
    }
  }
  return None;
}

export function findIndex<T>(xs: T[], pred: (x: T) => bool): Option<usize> {
  let i: usize = 0;
  for (const x of xs) {
    if (pred(x)) {
      return Some(i);
    }
    i += 1;
  }
  return None;
}

export function some<T>(xs: T[], pred: (x: T) => bool): bool {
  for (const x of xs) {
    if (pred(x)) {
      return true;
    }
  }
  return false;
}

export function every<T>(xs: T[], pred: (x: T) => bool): bool {
  for (const x of xs) {
    if (!pred(x)) {
      return false;
    }
  }
  return true;
}

export function reduce<T, U>(xs: T[], f: (acc: U, x: T) => U, init: U): U {
  let acc = init;
  for (const x of xs) {
    acc = f(acc, x);
  }
  return acc;
}

export function forEach<T>(xs: T[], f: (x: T) => void): void {
  for (const x of xs) {
    f(x);
  }
}

// Stable merge sort; `cmp(a, b)` is negative, zero or positive as `a` sorts before, with or after `b`.
export function sort<T>(xs: T[], cmp: (a: T, b: T) => int): T[] {
  const n = xs.length;
  if (n <= 1) {
    return xs;
  }
  const mid = n / 2;
  const left = sort(xs.slice(0, mid), cmp);
  const right = sort(xs.slice(mid, n), cmp);
  let out: T[] = [];
  let i: usize = 0;
  let j: usize = 0;
  while (i < left.length && j < right.length) {
    if (cmp(right[j], left[i]) < 0) {
      out.push(right[j]);
      j += 1;
    } else {
      out.push(left[i]);
      i += 1;
    }
  }
  while (i < left.length) {
    out.push(left[i]);
    i += 1;
  }
  while (j < right.length) {
    out.push(right[j]);
    j += 1;
  }
  return out;
}

// `indexOf` / `includes` need `==`, which a generic body cannot use, so they exist once per
// element type that has equality; the checker picks the function from the receiver's element type.
export function indexOfInt(xs: int[], v: int): Option<usize> {
  let i: usize = 0;
  for (const x of xs) {
    if (x == v) {
      return Some(i);
    }
    i += 1;
  }
  return None;
}

export function indexOfUsize(xs: usize[], v: usize): Option<usize> {
  let i: usize = 0;
  for (const x of xs) {
    if (x == v) {
      return Some(i);
    }
    i += 1;
  }
  return None;
}

export function indexOfBool(xs: bool[], v: bool): Option<usize> {
  let i: usize = 0;
  for (const x of xs) {
    if (x == v) {
      return Some(i);
    }
    i += 1;
  }
  return None;
}

export function indexOfStr(xs: string[], v: string): Option<usize> {
  let i: usize = 0;
  for (const x of xs) {
    if (x == v) {
      return Some(i);
    }
    i += 1;
  }
  return None;
}

export function includesInt(xs: int[], v: int): bool {
  return indexOfInt(xs, v).isSome();
}

export function includesUsize(xs: usize[], v: usize): bool {
  return indexOfUsize(xs, v).isSome();
}

export function includesBool(xs: bool[], v: bool): bool {
  return indexOfBool(xs, v).isSome();
}

export function includesStr(xs: string[], v: string): bool {
  return indexOfStr(xs, v).isSome();
}
