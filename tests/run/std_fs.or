import { readFile, writeFile, exists } from "std:fs";

const PATH: string = "build/tests/tmp_std_fs.txt";

function roundtrip(path: string, data: string): Result<string, string> {
  writeFile(path, data)?;
  const back = readFile(path)?;
  return Ok(back);
}

function main(): void {
  console.log(writeFile(PATH, "alpha\nbeta").isOk().toString());
  console.log(exists(PATH).toString());
  match (readFile(PATH)) {
    Ok(s) => {
      console.log(s.length.toString());
      const parts = s.split("\n");
      console.log(parts.length.toString());
      console.log(parts[0]);
      console.log(parts[1]);
    },
    Err(e) => { console.log("read failed: " + e); },
  }
  match (roundtrip(PATH, "gamma")) {
    Ok(s) => { console.log(s); },
    Err(e) => { console.log("err " + e); },
  }
  console.log(readFile("build/tests/definitely_missing_file.txt").isErr().toString());
  console.log(exists("build/tests/definitely_missing_file.txt").toString());
  console.log(writeFile("build/tests/no_such_dir/x.txt", "x").isErr().toString());
}
