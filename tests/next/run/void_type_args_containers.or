type Box<T> = { v: T; tag: int; };
type Either<T> = Left(T) | Right(int);

function mk<T>(f: () => T, tag: int): Box<T> { return Box<T> { v: f(), tag: tag }; }
function readBox<T>(b: Box<T>): T { return b.v; }
function ident<T>(x: T): T { return x; }
function twice<T>(f: () => T): T { f(); return f(); }
function viaOption<T>(f: () => T): Option<T> { return Some(f()); }
function show<T>(o: Option<T>): string {
  return match (o) {
    Some(x) => "some",
    None => "none",
  };
}
function showRes<T>(r: Result<T, string>): string {
  return match (r) {
    Ok(v) => "ok",
    Err(e) => "err " + e,
  };
}
function eith<T>(e: Either<T>): int {
  return match (e) {
    Left(x) => 1,
    Right(n) => n,
  };
}
function apply<T, R>(f: (x: T) => R, x: T): R { return f(x); }
function loopOver<T>(xs: T[]): int {
  let n = 0;
  for (const x of xs) { n += 1; }
  return n;
}
function logIt(s: string): void { console.log(s); }

class Scope {
  count: int = 0;
  constructor() {}
  run<T>(f: () => T): T { this.count += 1; return f(); }
  twice<T>(f: () => T): T[] { return [f(), f()]; }
}

function main(): void {
  const b = mk(() => { logIt("mk"); }, 7);
  console.log(b.tag.toString());
  readBox(b);
  ident<void>(logIt("id"));
  twice(() => { logIt("tw"); });
  const o = viaOption(() => { logIt("opt"); });
  console.log(show(o));
  console.log(show<void>(None));
  const r: Result<void, string> = Ok();
  console.log(showRes(r));
  console.log(showRes<void>(Err("bad")));
  console.log(eith<void>(Right(5)).toString());
  apply<void, void>((x) => { logIt("applied"); }, logIt("arg"));
  const xs = viaArr();
  console.log(xs.length.toString());
  console.log(loopOver(xs).toString());
  let s = new Scope();
  s.run(() => { logIt("scoped"); });
  const ys = s.twice(() => { logIt("y"); });
  console.log(ys.length.toString());
  console.log(s.count.toString());
}
function viaArr(): void[] {
  let a: void[] = [];
  a.push(logIt("p1"));
  a.push(logIt("p2"));
  return a;
}
