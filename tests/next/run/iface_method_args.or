// Interface methods with parameters, including interface-typed parameters.
interface Num {
  value(): int;
  plus(k: int): int;
  versus(other: Num): int;
}

class Lit implements Num {
  constructor(public v: int) {}
  value(): int { return this.v; }
  plus(k: int): int { return this.v + k; }
  versus(other: Num): int { return this.v - other.value(); }
}

class Dbl implements Num {
  constructor(public v: int) {}
  value(): int { return this.v * 2; }
  plus(k: int): int { return this.v * 2 + k; }
  versus(other: Num): int { return this.value() - other.value(); }
}

function main(): void {
  const a: Num = new Lit(10);
  const b: Num = new Dbl(3);
  console.log(a.plus(5).toString() + " " + b.plus(5).toString());
  console.log(a.versus(b).toString() + " " + b.versus(a).toString());
  console.log(a.versus(a).toString());
}
