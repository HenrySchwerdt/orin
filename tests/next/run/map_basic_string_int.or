function main(): void {
  let m = new Map<string, int>();
  console.log(m.size.toString());
  m.set("one", 1);
  m.set("two", 2);
  m.set("three", 3);
  console.log(m.size.toString());
  console.log(m.get("two").unwrapOr(-1).toString());
  console.log(m.get("four").unwrapOr(-1).toString());
  console.log(m.has("one").toString());
  console.log(m.has("zero").toString());
  m.set("two", 22);
  console.log(m.get("two").unwrap().toString());
  console.log(m.size.toString());
  console.log(m.delete("one").toString());
  console.log(m.delete("one").toString());
  console.log(m.size.toString());
  console.log(m.keys().join(","));
  console.log(m.values().map(v => v.toString()).join(","));
  const e = m.get("three");
  match (e) {
    Some(v) => { console.log("three=" + v.toString()); },
    None => { console.log("no three"); }
  }
  let empty = new Map<string, int>();
  console.log(empty.keys().length.toString());
  console.log(empty.get("x").isNone().toString());
  console.log(empty.delete("x").toString());
}
