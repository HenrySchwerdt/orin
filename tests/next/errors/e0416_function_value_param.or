// error: E0416
// stderr: function value passed to `
// stderr: in a contract expression is not a closure literal, so its effects are unknown
// A function-typed parameter of the constrained function has unknown effects, even when it is only handed to a
// pure combinator.
@Requires(xs.every(pred))
function check(xs: int[], pred: (x: int) => bool): int {
  return xs.length.toInt();
}

function main(): void {
  console.log(check([1], x => x > 0).toString());
}
