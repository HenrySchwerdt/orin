function describe(o: Option<int>): string {
  return match (o) {
    Some(v) => "some " + v.toString(),
    None => "none",
  };
}

function code(r: Result<int, string>): string {
  match (r) {
    Ok(v) => { return "ok " + v.toString(); },
    Err(e) => { return "err " + e; },
  }
}

function orZero(o: Option<int>): int {
  return match (o) {
    Some(v) => v,
    _ => 0,
  };
}

function main(): void {
  console.log(describe(Some(3)));
  console.log(describe(None));
  console.log(code(Ok(5)));
  console.log(code(Err("boom")));
  console.log(orZero(Some(8)).toString());
  console.log(orZero(None).toString());
  const xs = [1, 2];
  console.log(describe(xs.get(0)));
  console.log(describe(xs.get(2)));
  console.log(describe(parseInt("42")));
  let ys = [5];
  console.log(describe(ys.pop()));
  console.log(describe(ys.pop()));
}
