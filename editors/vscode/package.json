{
  "name": "orin-vscode",
  "displayName": "Orin",
  "description": "Orin language support: syntax highlighting and the `orin lsp` language server (diagnostics, symbols, completion).",
  "version": "0.1.0",
  "publisher": "orin-lang",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "vscode": "^1.75.0",
    "node": ">=18"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:orin"
  ],
  "contributes": {
    "languages": [
      {
        "id": "orin",
        "aliases": [
          "Orin",
          "orin"
        ],
        "extensions": [
          ".or"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "orin",
        "scopeName": "source.orin",
        "path": "./syntaxes/orin.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Orin",
      "properties": {
        "orin.serverPath": {
          "type": "string",
          "default": "orin",
          "description": "Path to the `orin` executable. The extension runs `<serverPath> lsp` and talks LSP over stdio."
        },
        "orin.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Trace LSP traffic between VS Code and the Orin language server."
        }
      }
    },
    "commands": [
      {
        "command": "orin.restartServer",
        "title": "Orin: Restart Language Server"
      }
    ]
  },
  "scripts": {
    "test": "node --test test/grammar.test.js"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.1.0"
  },
  "icon": "images/icon.png"
}
