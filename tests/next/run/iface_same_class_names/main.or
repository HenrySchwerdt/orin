// Two classes with the same name in different modules, both converted to the same interface.
import { Shape } from "./shape";
import { makeA } from "./a";
import { makeB } from "./b";

function main(): void {
  const xs: Shape[] = [makeA(), makeB(4), makeA()];
  let t = 0;
  for (const x of xs) {
    t += x.area();
  }
  console.log(t.toString());
}
