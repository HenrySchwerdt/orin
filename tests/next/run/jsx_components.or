// JSX components (ADR-0043): attributes are arguments by parameter name (any order), children are the `children`
// parameter, components nest, are recursive, generic and imported like any function.
import { Html, render, text, trustHtml, empty } from "std:html";

function Badge(label: string): Html {
  return <span class="badge">{label}</span>;
}

function Card(title: string, count: int, featured: bool, children: Html): Html {
  return <section class={featured ? "card featured" : "card"}>
    <h2>{title} <Badge label={count.toString()} /></h2>
    {children}
  </section>;
}

// No `children` parameter needed when the component takes none; an empty `children` when none are written.
function Panel(children: Html): Html {
  return <div class="panel">{children}</div>;
}

// Recursion: a tree rendered by a component that renders itself.
type Node = { label: string; kids: Node[]; };

function Tree(node: Node): Html {
  return <li>{node.label}{node.kids.length > 0 ? <ul>{node.kids.map(k => <Tree node={k} />)}</ul> : empty()}</li>;
}

// A generic component.
function Labeled<T>(value: T, show: (x: T) => string): Html {
  return <em>{show(value)}</em>;
}

function main(): void {
  console.log(render(<Badge label="new & <hot>" />));
  console.log(render(<Card featured count={3} title="Tom & Jerry">
    <p>Body text</p>
    {text("<escaped>")}
    {trustHtml("<i>trusted</i>")}
  </Card>));
  console.log(render(<Card title="plain" count={0} featured={false}></Card>));
  console.log(render(<Panel />));
  console.log(render(<Panel><Panel>deep</Panel></Panel>));
  const t = Node { label: "root", kids: [Node { label: "a", kids: [] }, Node { label: "b<", kids: [Node { label: "c", kids: [] }] }] };
  console.log(render(<ul><Tree node={t} /></ul>));
  console.log(render(<Labeled value={7} show={(x: int) => `#${x}`} />));
  // a component call is an ordinary call: the same as writing it directly
  const same = render(Card("direct", 1, true, <b>x</b>)) == render(<Card title="direct" count={1} featured><b>x</b></Card>);
  console.log(`same: ${same}`);
}
