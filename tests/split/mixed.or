// Split-C test program (tools/test_split.sh): strings, vtables (interface calls), @Inline functions, floats, a closure
// and loops, spread over enough functions to land in several units.
interface Shape {
  area(): float;
  name(): string;
}

class Rect implements Shape {
  w: float;
  h: float;
  constructor(w: float, h: float) {
    this.w = w;
    this.h = h;
  }
  area(): float { return this.w * this.h; }
  name(): string { return "rect"; }
}

class Circle implements Shape {
  r: float;
  constructor(r: float) {
    this.r = r;
  }
  area(): float { return 3.0 * this.r * this.r; }
  name(): string { return "circle"; }
}

@Inline
function twice(x: int): int {
  return x * 2;
}

@Inline
function label(s: string): string {
  return "<" + s + ">";
}

function fib(n: int): int {
  if (n < 2) {
    return n;
  }
  return fib(n - 1) + fib(n - 2);
}

function sumTo(n: int): int {
  let t = 0;
  let i = 0;
  while (i < n) {
    t += twice(i);
    i += 1;
  }
  return t;
}

function describe(s: Shape): string {
  return label(s.name()) + " " + s.area().toString();
}

function main(): void {
  const shapes: Shape[] = [new Rect(2.0, 3.5), new Circle(2.0), new Rect(1.0, 1.0)];
  for (const s of shapes) {
    console.log(describe(s));
  }
  console.log(fib(15).toString());
  console.log(sumTo(100).toString());
  const words = ["alpha", "beta", "gamma"].map(w => label(w));
  console.log(words.join(","));
  console.log("done");
}
