// exit: 101
// stderr: trap: task panicked: integer overflow
// std:task: a panic in a task that nobody joined is not lost: when the scope ends (after joining every task) it traps with the
// message of the panic. The body's own output is still printed first.
import { scopeDo, spawnDo } from "std:task";

function overflow(k: int): int {
  let x = 9223372036854775807;
  return x + k;
}

function main(): void {
  scopeDo(s => {
    spawnDo(s, () => {
      overflow(0);
    });
    spawnDo(s, () => {
      overflow(1);
    });
    console.log("body finished");
  });
  console.log("not reached");
}
