// Edge cases of the string / number library (moved to the Orin std prelude, spec 19 R1).
// The expected output is identical for the C runtime and for the prelude implementation.
function show(xs: string[]): string {
  let parts: string[] = [];
  for (const x of xs) {
    parts.push("[" + x + "]");
  }
  return parts.join("");
}

function pi(s: string): string {
  const r = parseInt(s);
  return r.isSome() ? "Some(" + r.unwrap().toString() + ")" : "None";
}

function ix(s: string, n: string): string {
  const r = s.indexOf(n);
  return r.isSome() ? r.unwrap().toString() : "-";
}

function main(): void {
  // split
  console.log(show("a,b,,c".split(",")));
  console.log(show("".split(",")));
  console.log(show(",".split(",")));
  console.log(show("abc".split("abc")));
  console.log(show("aaa".split("aa")));
  console.log(show("a--b--c--".split("--")));
  console.log(show("abc".split("abcd")));
  console.log(show("x".split("x")));
  // trim
  console.log("[" + "  \t\n hi there \r\n".trim() + "]");
  console.log("[" + "   ".trim() + "]");
  console.log("[" + "".trim() + "]");
  console.log("[" + "x".trim() + "]");
  console.log("[" + "\x0b\x0ca\x0b\x0c".trim() + "]");
  // indexOf / includes / startsWith / endsWith
  console.log(ix("hello", "l") + " " + ix("hello", "lo") + " " + ix("hello", "") + " " + ix("", "") + " " + ix("hello", "z"));
  console.log(ix("aaab", "aab") + " " + ix("abc", "abcd") + " " + ix("abab", "bab") + " " + ix("ab", "b"));
  console.log("hello".includes("ell").toString() + " " + "hello".includes("").toString() + " " + "".includes("a").toString() + " " + "abc".includes("abcd").toString());
  console.log("hello".startsWith("he").toString() + " " + "hello".startsWith("").toString() + " " + "he".startsWith("hello").toString() + " " + "hello".startsWith("el").toString());
  console.log("hello".endsWith("lo").toString() + " " + "hello".endsWith("").toString() + " " + "lo".endsWith("hello").toString() + " " + "hello".endsWith("el").toString());
  // parseInt
  console.log(pi("0") + " " + pi("-0") + " " + pi("007") + " " + pi("-12") + " " + pi("") + " " + pi("-") + " " + pi("+1") + " " + pi(" 1") + " " + pi("1x") + " " + pi("--1"));
  console.log(pi("9223372036854775807") + " " + pi("9223372036854775808") + " " + pi("-9223372036854775808") + " " + pi("-9223372036854775809"));
  console.log(pi("99999999999999999999") + " " + pi("-99999999999999999999") + " " + pi("9223372036854775800") + " " + pi("92233720368547758070"));
  // toString
  const lo = -9223372036854775807 - 1;
  const hi = 9223372036854775807;
  console.log((0).toString() + " " + (7).toString() + " " + (10).toString() + " " + (-1).toString() + " " + (1000000).toString() + " " + (-1000000).toString());
  console.log(lo.toString() + " " + (lo + 1).toString() + " " + hi.toString());
  const z: usize = 0;
  const big = hi.toUsize();
  console.log(z.toString() + " " + big.toString() + " " + (big + big + 1).toString() + " " + (big + 1).toString());
  console.log(true.toString() + " " + false.toString());
  // join
  const none: string[] = [];
  console.log("[" + none.join(",") + "]");
  console.log("[" + ["a"].join(",") + "]");
  console.log("[" + ["a", "", "c"].join("") + "] [" + ["a", "", "c"].join(", ") + "]");
}
