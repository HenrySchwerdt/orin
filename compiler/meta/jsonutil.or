// Small constructors for the JSON documents of the `std:meta` encoding (library/std/metajson.or): objects with a fixed key
// order, and tagged unions `{"k": kind, ...}`.

import { Json, JField, JObj, JStr, JArr, JNum, JBool, JNull, jField } from "../json";

export function obj(fields: JField[]): Json {
  return JObj(fields);
}

// A union value: `{"k": kind, ...fields}`.
export function tagged(kind: string, fields: JField[]): Json {
  let all: JField[] = [jField("k", JStr(kind))];
  for (const x of fields) {
    all.push(x);
  }
  return JObj(all);
}

export function fld(key: string, value: Json): JField {
  return jField(key, value);
}

export function jstr(s: string): Json {
  return JStr(s);
}

export function jint(n: int): Json {
  return JNum(n);
}

export function jbool(b: bool): Json {
  return JBool(b);
}

export function jnull(): Json {
  return JNull;
}

export function jarr(xs: Json[]): Json {
  return JArr(xs);
}

export function strs(xs: string[]): Json {
  let out: Json[] = [];
  for (const x of xs) {
    out.push(JStr(x));
  }
  return JArr(out);
}
