// Load forwarding (ADR-0038 lever 2, T4) must not forward `p[i]` across `i = p[i]`: after the load, `p[i]` names another
// element. A union-find style walk reads p[i], steps i to it, and reads p[i] again in the same block.
function main(): void {
  let p: usize[] = [1, 2, 3, 3];
  let i: usize = 0;
  i = p[i];
  const a = p[i];
  console.log(i.toString() + " " + a.toString());
  let j: usize = 0;
  let steps = 0;
  while (p[j] != j) {
    j = p[j];
    steps += p[j].toInt();
  }
  console.log(j.toString() + " " + steps.toString());
}
