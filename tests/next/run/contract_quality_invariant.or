// warns: W0450 W0452 W0450 W0452 W0450
// W0450 (ADR-0028): an @Invariant that mentions no field of `this`. `@Invariant(true)` is also W0452.
import { exit } from "std:process";

@Invariant(true)
class A {
  n: int = 0;
}

@Invariant(helper(1))
class C {
  n: int = 0;
}

function helper(x: int): bool {
  return x > 0;
}

@Invariant(2 != 3 && 1 > 0)
type R = { n: int; };

// negatives: the invariant constrains state
@Invariant(this.n >= 0)
class D {
  n: int = 0;
}

@Invariant(this.n > 0)
type Pos = { n: int; };

function main(): void {
  let a = new A();
  let c = new C();
  let d = new D();
  console.log((a.n + c.n + d.n).toString());
  exit(0);
}
