function main(): void {
  let a = new Map<int, string>();
  a.set(-5, "minus five");
  a.set(0, "zero");
  a.set(7, "seven");
  a.set(-9223372036854775807 - 1, "min");
  a.set(9223372036854775807, "max");
  console.log(a.get(-5).unwrap());
  console.log(a.get(0).unwrap());
  console.log(a.get(9223372036854775807).unwrap());
  console.log(a.get(-9223372036854775807 - 1).unwrap());
  console.log(a.get(1).isNone().toString());
  console.log(a.keys().map(k => k.toString()).join(","));

  let u = new Map<usize, int>();
  let i: usize = 0;
  while (i < 20) {
    u.set(i * 1000003, i.toInt());
    i += 1;
  }
  console.log(u.size.toString());
  console.log(u.get(5 * 1000003).unwrap().toString());
  console.log(u.has(4).toString());
  u.set(9223372036854775807, 1);
  console.log(u.get(9223372036854775807).unwrap().toString());

  let b = new Map<bool, string>();
  b.set(true, "yes");
  b.set(false, "no");
  b.set(true, "YES");
  console.log(b.size.toString());
  console.log(b.get(true).unwrap() + " " + b.get(false).unwrap());
  console.log(b.delete(false).toString());
  console.log(b.get(false).isNone().toString());
}
