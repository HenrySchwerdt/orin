import { readLine, readBytes, writeStdout } from "std:io";

function main(): void {
  let n: int = 0;
  while (true) {
    const l = readLine();
    if (l.isNone()) {
      break;
    }
    const s = l.unwrap();
    if (s == "BYTES") {
      const b = readBytes(5);
      writeStdout("bytes=[" + b.unwrapOr("<eof>") + "]");
      writeStdout("\n");
      const rest = readBytes(100);
      console.log("short read none: " + rest.isNone().toString());
      continue;
    }
    n += 1;
    console.log(n.toString() + ": " + s + " (" + s.length.toString() + ")");
  }
  console.log("lines=" + n.toString());
  console.log("eof readLine none: " + readLine().isNone().toString());
  console.log("empty read some: " + readBytes(0).isSome().toString());
}
