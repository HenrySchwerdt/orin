import { join } from "std:path";

function main(): void {
  console.log(join(["a", "b"]));
  console.log(join(["/a", "b", "../c"]));
  console.log(join(["a", "", "b/"]));
  console.log(join([]));
  console.log(join(["", ""]));
  console.log(join(["a", "/b"]));
  console.log(join(["..", "x"]));
  console.log(join(["a/b", "../../.."]));
  console.log(join(["/", "x"]));
  console.log(join(["./a", "./b"]));
}
