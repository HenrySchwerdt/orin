// `orin fmt [--check] [--stdout] <files...>` (spec 18 §3).
//   default   rewrite each file in place when its formatting changes
//   --check   print the files that would change; exit status 1 if there are any
//   --stdout  print the formatted text instead of writing
// Files with syntax errors are reported (`path:line:col: error[CODE]: ...`) and left untouched.
// Exit status: 0 ok, 1 changes found with --check or a file had a syntax error, 2 usage / I/O error.

import { FsGrant } from "std:fs";
import { Diagnostic, SourceMap, SourceFile, render, TerminalOptions, renderTerminal } from "../diag";
import { format } from "../fmt";
import { readFile, writeFile, fsErrorMessage } from "std:fs";
import { usageError, mapOrderedFs } from "../util";

// What a worker found out about one file; `result` is only meaningful when `readError` is empty.
type FmtJob = { readError: string; src: string; result: Result<string, Diagnostic>; };

function formatOne(fs: FsGrant, path: string): FmtJob {
  const rf = readFile(fs, path);
  if (rf.isErr()) {
    return FmtJob { readError: fsErrorMessage(rf.unwrapErr()), src: "", result: Ok("") };
  }
  const src = rf.unwrap();
  return FmtJob { readError: "", src: src, result: format(0, src) };
}

function usage(): int {
  return usageError(
    "usage: orin fmt [--check] [--stdout] <file.or>...",
  );
}

export function runFmt(fs: FsGrant, args: string[], ui: TerminalOptions): int {
  let check = false;
  let toStdout = false;
  let files: string[] = [];
  for (const a of args) {
    if (a == "--check") {
      check = true;
    } else if (a == "--stdout") {
      toStdout = true;
    } else if (a.startsWith("-")) {
      console.error("error: unknown option " + a);
      return usage();
    } else {
      files.push(a);
    }
  }
  if (files.length == 0) {
    return usage();
  }
  // Read and format in worker tasks (ADR-0049, P10); diagnostics, output and writes below follow argument order.
  const jobs = mapOrderedFs(fs, files.length, (i: usize, g: FsGrant) => formatOne(g, files[i]));
  let code: int = 0;
  let k: usize = 0;
  while (k < files.length) {
    const path = files[k];
    const job = jobs[k];
    k += 1;
    if (job.readError.length > 0) {
      console.error("error: cannot read " + path + ": " + job.readError);
      code = 2;
      continue;
    }
    const src = job.src;
    const res = job.result;
    if (res.isErr()) {
      const sm = SourceMap { files: [SourceFile { path: path, text: src }] };
      console.error(
        ui.rich
            ? renderTerminal(sm, res.unwrapErr(), ui.color, ui.ascii)
            : render(sm, res.unwrapErr()),
      );
      if (code == 0) {
        code = 1;
      }
      continue;
    }
    const out = res.unwrap();
    if (check) {
      if (out != src) {
        console.log(path);
        if (code == 0) {
          code = 1;
        }
      }
    } else if (toStdout) {
      if (out.endsWith("\n")) {
        console.log(out.substring(0, out.length - 1));
      } else {
        console.log(out);
      }
    } else if (out != src) {
      const w = writeFile(fs, path, out);
      if (w.isErr()) {
        console.error("error: cannot write " + path + ": " + fsErrorMessage(w.unwrapErr()));
        code = 2;
      }
    }
  }
  return code;
}
