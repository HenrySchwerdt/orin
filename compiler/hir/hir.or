// Typed, fully resolved HIR — Stage 1 shared contract (v1).
// Mirrors bootstrap/src/hir.rs (read its invariant list; identical here). Owned by the lead
// architect. Producer: compiler/check. Consumer: compiler/codegen.
// Ids are indices (usize) into Program.records / unions / functions and Function.locals.

import { Span } from "../diag";

export type Type =
  TyInt
  | TyUsize
  | TyBool
  | TyFloat                       // IEEE-754 binary64 (ADR-0018)
  | TyF32                         // IEEE-754 binary32
  | TyString
  | TyVoid
  | TyArray(Type)
  | TyOption(Type)
  | TyResult(Type, Type)
  | TyRecord(usize)
  | TyUnion(usize)
  | TyFn(Type[], Type)            // function value: parameter types, result (closures, ADR-0011)
  | TyIface(usize);               // interface value (ADR-0019): index into the checker's interface table;
                                  // a heap object { vtable pointer, boxed class value }

export type Program = {
  records: RecordDef[];
  unions: UnionDef[];
  functions: Function[];
  main: usize;
  vtables: VTable[];              // one per (class, interface) pair that is converted (ADR-0019)
  ifaces: IfaceDef[];             // interface table (names for diagnostics and tooling; TyIface indexes it)
  inlineFns: string[];            // names of the `@Inline` functions (ADR-0024): a backend hint, semantics unchanged
};

// An interface: qualified name and method names in slot order (ADR-0019).
export type IfaceDef = { name: string; methods: string[]; };

// A vtable: the class method functions (receiver first, all parameters borrowed) in interface-method order.
export type VTable = { name: string; funcs: usize[]; };

export type FieldDef = { name: string; ty: Type; };

// Qualified, unique, deterministic names, e.g. "users/user.User".
export type RecordDef = { name: string; fields: FieldDef[]; };

export type UnionDef = { name: string; variants: VariantDef[]; };

export type VariantDef = { name: string; payload: Type[]; };

export type Function = {
  name: string;
  paramCount: usize;      // the first paramCount locals are the parameters
  locals: Local[];
  ret: Type;
  body: HBlock;
  span: Span;
};

export type Local = { name: string; ty: Type; mutable: bool; };

export type HBlock = { stmts: HStmt[]; };

export type HStmt =
  HLet(usize, HExpr)                          // local, init
  | HAssign(Place, Option<BinOp>, HExpr)      // place, compound op (Add..Rem) or None, value
  | HExprStmt(HExpr)
  | HIf(HExpr, HBlock, Option<HBlock>)
  | HWhile(HExpr, HBlock)
  | HForOf(usize, HExpr, HBlock)              // local, iterated array, body
  | HBreak
  | HContinue
  | HReturn(Option<HExpr>)
  | HBlockStmt(HBlock);

export type Place = { root: usize; path: PlaceElem[]; ty: Type; };

export type PlaceElem = PField(usize, usize) | PIndex(HExpr);   // PField(recordId, fieldIndex)

export type HExpr = { kind: HExprKind; ty: Type; span: Span; };

export type UnOp = UnNot | UnNeg;

export type BinOp =
  OpAdd | OpSub | OpMul | OpDiv | OpRem
  | OpEq | OpNe | OpLt | OpLe | OpGt | OpGe
  | OpAnd | OpOr;

export type HExprKind =
  XInt(int)
  | XFloat(string)                            // float literal: canonical decimal text (type TyFloat / TyF32)
  | XBool(bool)
  | XStr(string)
  | XLocal(usize)
  | XUnary(UnOp, HExpr)
  | XBinary(BinOp, HExpr, HExpr)
  | XCall(usize, HExpr[])                     // function id, args
  | XBuiltin(Builtin, HExpr[])                // receiver (if any) is args[0]
  | XMutMethod(MutBuiltin, Place, HExpr[])
  | XField(HExpr, usize, usize)               // base, recordId, fieldIndex
  | XIndex(HExpr, HExpr)
  | XRecord(usize, Option<HExpr>, FieldInitH[])   // recordId, spread, explicit fields (source order)
  | XVariant(usize, HExpr[])                  // tag, payload; union given by HExpr.ty
  | XArray(HExpr[])
  | XTry(HExpr)
  | XCond(HExpr, HExpr, HExpr)
  | XMatch(HExpr, HArm[])
  // --- closures (ADR-0011, docs/mir.md v1.3) ---
  // XClosure(fn, captures): a function value built from the lifted function `fn` (its first parameter
  // is the environment record) and the captured values, evaluated at creation (snapshot); type TyFn.
  // XCallIndirect(callee, args): call of a function value (type TyFn), args in source order.
  | XClosure(usize, HExpr[])
  | XCallIndirect(HExpr, HExpr[])
  // --- interfaces (ADR-0019, docs/mir.md v1.5) ---
  // XIface(vtable, value): the value of a class type converted to an interface type (HExpr.ty is TyIface):
  // a snapshot of `value` boxed together with the vtable `Program.vtables[vtable]`.
  // XCallVirtual(recv, slot, args): call of interface method number `slot` on the interface value `recv`.
  | XIface(usize, HExpr)
  | XCallVirtual(HExpr, usize, HExpr[]);

export type FieldInitH = { index: usize; value: HExpr; };

// value: arm value for non-void match expressions; None if void or body diverges.
export type HArm = { pattern: HPattern; body: HBlock; value: Option<HExpr>; };

export type HPattern =
  HPWildcard
  | HPVariant(usize, Option<usize>[])         // tag, bindings (Some(local) or None for `_`)
  | HPInt(int)
  | HPStr(string)
  | HPBool(bool);

export type Builtin =
  BConsoleLog | BConsoleError | BStringFromCharCode | BParseInt
  | BFsReadFile | BFsWriteFile | BFsExists | BProcessArgs | BProcessExit
  | BIoReadBytes | BIoReadLine | BIoWriteStdout | BIoShell | BTimeNowMillis
  | BStrLength | BStrCharCodeAt | BStrCharAt | BStrSubstring | BStrIndexOf
  | BStrIncludes | BStrStartsWith | BStrEndsWith | BStrSplit | BStrTrim
  | BArrLength | BArrGet | BArrSlice | BArrConcat | BArrJoin
  | BIntToString | BIntToUsize | BUsizeToString | BUsizeToInt | BBoolToString
  | BOptIsSome | BOptIsNone | BOptUnwrap | BOptUnwrapOr
  | BResIsOk | BResIsErr | BResUnwrap | BResUnwrapErr
  // --- floats (ADR-0018). Arguments / results are `float` or `f32` (an f32 is kept in a double that is
  // exactly representable in binary32; lowering rounds after every builtin whose result type is f32) ---
  | BParseFloat | BFloatToString | BF32ToString | BIntToFloat | BUsizeToFloat | BFloatToInt | BF32Round
  | BF32ToFloat | BFloatFloor | BFloatCeil | BFloatRound | BFloatSqrt | BFloatAbs | BFloatPow
  | BFloatIsNaN | BFloatIsFinite;

export type MutBuiltin = MArrPush | MArrPop;
