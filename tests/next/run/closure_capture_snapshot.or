// Captured variables are snapshotted when the closure is created (ADR-0011): later changes of
// the outer `let` are not seen by the closure.
function main(): void {
  let n = 10;
  const get = () => n;
  const plus = (x: int) => x + n;
  n = 20;
  n += 5;
  console.log(get().toString());
  console.log(plus(1).toString());
  console.log(n.toString());

  let s = "a";
  const sf = () => s + "!";
  s += "b";
  console.log(sf() + " " + s);

  let flag = true;
  const ff = () => flag;
  flag = false;
  console.log(ff().toString() + flag.toString());

  let fs: (() => int)[] = [];
  let i = 0;
  while (i < 3) {
    fs.push(() => i * 10);
    i += 1;
  }
  for (const f of fs) {
    console.log(f().toString());
  }
  console.log(i.toString());

  // A closure created later sees the new value.
  const get2 = () => n;
  n = 0;
  console.log(get2().toString());
}
