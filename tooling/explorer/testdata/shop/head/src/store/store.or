import { FsGrant, writeFile } from "std:fs";
import { ClockGrant, nowMillis } from "std:clock";

/**
 * Writes the order log, stamped with the time of the order.
 *
 * ```
 * saveOrder(fs, clock, "orders.log", "42 cents");
 * ```
 */
export function saveOrder(fs: FsGrant, clock: ClockGrant, path: string, line: string): void {
  writeFile(fs, path, nowMillis(clock).toString() + " " + line);
}
