// std:collections -- sets, a ring-buffer deque, sorted maps and a priority queue (ADR-0030 §3, layer
// "collections"). Pure safe Orin on top of arrays and `Map`; no C, no new built-ins.
//
// What is generic and what is not (language limits, see docs/std.md "Limitations"):
//   * `Map<K, V>` keys must be `int`, `usize`, `bool` or `string` *concretely* (E0400 for a type parameter), and
//     there is no `==`, `<` or hash on a type parameter. So the sets and sorted maps are specialised by key:
//     `IntSet` / `StringSet`, `SortedMap<V>` (int keys) / `SortedStringMap<V>` (string keys). The values and
//     the elements of `Deque<T>` and `PriorityQueue<T>` are fully generic.
//   * A contract cannot call a function value (E0416), so a comparator closure could not appear in the heap
//     invariant. `PriorityQueue<T>` therefore orders by an explicit `int` priority given to `push`.
//   * Because `==` does not exist on a type parameter, the contracts of the generic containers state sizes,
//     membership, ordering of keys/priorities and presence, but not "the value that comes back is the one that
//     was put in" (that needs equality on `V` / `T`). The tests check values with `int` instances and against a
//     naive reference model.
//
// Names (ADR-0048 section 1.1): `size()` / `isEmpty()` / `clear()` on every class; `has(k)` membership; `get(k)` the
// checked read (`Option`); `set(k, v)` associates (sorted maps; `put` is a deprecated wrapper); `add(x)` for sets;
// `remove(k)` returns `Option<V>` on maps and `bool` (was it present) on sets; `keys()` / `values()` / `entries()` copy
// a keyed container out, `toArray()` a linear one; `first()` / `last()` the ends of an ordered map (`front` / `back` on
// the `Deque`, whose two ends are both mutable). Import as a namespace: `import * as collections from "std:collections"`.
//
// Contract standard (ADR-0030 §3): every class has `@Invariant`s that `--check-contracts` / `orin test` verify
// after every public method, and every public method states `@Requires` / `@Ensures`. Helpers that contracts call
// are loops (no closures, no recursion). All classes are values with copy-on-write storage like every class.
//
// Complexity summary (n = size, t = B-tree minimum degree, default choice 16):
//   IntSet / StringSet        has, add, remove expected O(1) (the prelude's open-addressing hash map); union O(n + m),
//                             intersection O(min(n, m)), difference and isSubsetOf O(n)
//   Deque<T>                  pushFront/pushBack/popFront/popBack/get/front/back amortised O(1); toArray O(n)
//   SortedMap / SortedStringMap  B-tree in an arena: has/get/set/remove/floorKey/ceilKey/firstKey/lastKey/first/last/
//                             popFirst/popLast all O(t log_t n) = O(log n); keys/values/entries O(n); size O(1)
//   PriorityQueue<T>          4-ary heap: push, pop O(log n); peek, minPriority, size O(1)
// Each choice was compared with the simpler alternative it replaces (numbers in docs/std.md): B-tree vs sorted
// array 31 ms vs 1782 ms for 20,000 random inserts + lookups + removals; 4-ary struct-of-arrays heap vs boxed binary
// heap 122 ms vs 300 ms; table-driven UTF-8 validator vs per-sequence decoder 5 ms vs 82 ms per MB; plain-slot ring
// vs `Option` slots 84 ms vs 128 ms.

// ---------------------------------------------------------------------------------------------- helpers

// allTrue(xs): bool -- every element is true. Loop-based (contracts cannot use `every`).
export function allTrue(xs: bool[]): bool {
  let i: usize = 0;
  while (i < xs.length) {
    if (!xs[i]) {
      return false;
    }
    i += 1;
  }
  return true;
}

// isStrictlyIncreasing(xs): bool -- xs[0] < xs[1] < ... (so sorted and without duplicates).
export function isStrictlyIncreasing(xs: int[]): bool {
  let i: usize = 1;
  while (i < xs.length) {
    if (xs[i - 1] >= xs[i]) {
      return false;
    }
    i += 1;
  }
  return true;
}

// compareStrings(a, b): int -- -1, 0 or 1; byte-wise lexicographic order (shorter prefix first), the order of
// `SortedStringMap`. O(min(a.length, b.length)).
@Ensures(result >= -1 && result <= 1)
@Ensures((result == 0) == (a.length == b.length && !differsAt(a, b)))
export function compareStrings(a: string, b: string): int {
  const n = a.length < b.length ? a.length : b.length;
  let i: usize = 0;
  while (i < n) {
    const x = a.charCodeAt(i);
    const y = b.charCodeAt(i);
    if (x < y) {
      return -1;
    }
    if (x > y) {
      return 1;
    }
    i += 1;
  }
  if (a.length < b.length) {
    return -1;
  }
  if (a.length > b.length) {
    return 1;
  }
  return 0;
}

// Does some byte inside the common length differ?
function differsAt(a: string, b: string): bool {
  const n = a.length < b.length ? a.length : b.length;
  let i: usize = 0;
  while (i < n) {
    if (a.charCodeAt(i) != b.charCodeAt(i)) {
      return true;
    }
    i += 1;
  }
  return false;
}

// isStrictlyIncreasingStrings(xs): bool -- compareStrings(xs[i-1], xs[i]) < 0 for all i.
export function isStrictlyIncreasingStrings(xs: string[]): bool {
  let i: usize = 1;
  while (i < xs.length) {
    if (compareStrings(xs[i - 1], xs[i]) >= 0) {
      return false;
    }
    i += 1;
  }
  return true;
}

// ------------------------------------------------------------------------------------------ IntSet

// A set of ints on top of `Map<int, bool>`. Invariants: the map's size matches its key list and every stored flag
// is true (a key is a member exactly when it is in the map).
@Invariant(this.items.size == this.items.keys().length)
@Invariant(allTrue(this.items.values()))
export class IntSet {
  private items: Map<int, bool> = new Map<int, bool>();

  // size(): usize -- number of members. O(1).
  @Ensures(result == this.items.keys().length)
  size(): usize {
    return this.items.size;
  }

  // isEmpty(): bool -- no members. O(1).
  @Ensures(result == (this.size() == 0))
  isEmpty(): bool {
    return this.items.size == 0;
  }

  // has(x): bool -- is x a member? Expected O(1).
  @Ensures(result ==> this.size() > 0)
  has(x: int): bool {
    return this.items.has(x);
  }

  // add(x): bool -- insert x; true when it was not a member (the size grows by 1), false when it already was. Expected O(1).
  @Ensures(this.has(x))
  @Ensures(result == !old(this.has(x)))
  @Ensures(result ==> this.size() == old(this.size()) + 1)
  @Ensures(!result ==> this.size() == old(this.size()))
  add(x: int): bool {
    if (this.items.has(x)) {
      return false;
    }
    this.items.set(x, true);
    return true;
  }

  // remove(x): bool -- delete x; true when it was a member (the size shrinks by 1). Expected O(1).
  @Ensures(!this.has(x))
  @Ensures(result == old(this.has(x)))
  @Ensures(result ==> this.size() == old(this.size()) - 1)
  @Ensures(!result ==> this.size() == old(this.size()))
  remove(x: int): bool {
    if (!this.items.has(x)) {
      return false;
    }
    this.items.delete(x);
    return true;
  }

  // clear(): void -- remove all members. O(1).
  @Ensures(this.size() == 0)
  clear(): void {
    this.items = new Map<int, bool>();
  }

  // toArray(): int[] -- the members in insertion order (not sorted). O(n).
  @Ensures(result.length == this.size())
  toArray(): int[] {
    return this.items.keys();
  }

  // isSubsetOf(other): bool -- every member of this is a member of other. O(n).
  @Ensures(result ==> this.size() <= other.size())
  @Ensures(this.size() == 0 ==> result)
  isSubsetOf(other: IntSet): bool {
    if (this.items.size > other.size()) {
      return false;
    }
    const xs = this.items.keys();
    let i: usize = 0;
    while (i < xs.length) {
      if (!other.has(xs[i])) {
        return false;
      }
      i += 1;
    }
    return true;
  }

  // union(other): IntSet -- the members of either. O(n + m).
  @Ensures(this.isSubsetOf(result) && other.isSubsetOf(result))
  @Ensures(result.size() >= this.size() && result.size() <= this.size() + other.size())
  union(other: IntSet): IntSet {
    // start from the larger set (a copy-on-write value copy) and insert only the smaller one's members
    let out = this;
    let small = other;
    if (other.size() > this.items.size) {
      out = other;
      small = this;
    }
    const xs = small.toArray();
    let i: usize = 0;
    while (i < xs.length) {
      out.add(xs[i]);
      i += 1;
    }
    return out;
  }

  // intersection(other): IntSet -- the members of both. O(n).
  @Ensures(result.isSubsetOf(this) && result.isSubsetOf(other))
  @Ensures(result.size() <= this.size() && result.size() <= other.size())
  intersection(other: IntSet): IntSet {
    // walk the smaller set and probe the larger one
    let out = new IntSet();
    const walk = this.items.size <= other.size() ? this : other;
    const probe = this.items.size <= other.size() ? other : this;
    const xs = walk.toArray();
    let i: usize = 0;
    while (i < xs.length) {
      if (probe.has(xs[i])) {
        out.add(xs[i]);
      }
      i += 1;
    }
    return out;
  }

  // difference(other): IntSet -- the members of this that are not in other. O(n).
  @Ensures(result.isSubsetOf(this))
  @Ensures(result.intersection(other).isEmpty())
  @Ensures(result.size() + this.intersection(other).size() == this.size())
  difference(other: IntSet): IntSet {
    let out = new IntSet();
    const xs = this.items.keys();
    let i: usize = 0;
    while (i < xs.length) {
      if (!other.has(xs[i])) {
        out.add(xs[i]);
      }
      i += 1;
    }
    return out;
  }
}

// --------------------------------------------------------------------------------------- StringSet

// A set of strings on top of `Map<string, bool>`; same invariants as `IntSet`.
@Invariant(this.items.size == this.items.keys().length)
@Invariant(allTrue(this.items.values()))
export class StringSet {
  private items: Map<string, bool> = new Map<string, bool>();

  // size(): usize -- number of members. O(1).
  @Ensures(result == this.items.keys().length)
  size(): usize {
    return this.items.size;
  }

  // isEmpty(): bool -- no members. O(1).
  @Ensures(result == (this.size() == 0))
  isEmpty(): bool {
    return this.items.size == 0;
  }

  // has(x): bool -- is x a member? Expected O(1 + |x|).
  @Ensures(result ==> this.size() > 0)
  has(x: string): bool {
    return this.items.has(x);
  }

  // add(x): bool -- insert x; true when it was not a member (the size grows by 1). Expected O(1 + |x|).
  @Ensures(this.has(x))
  @Ensures(result == !old(this.has(x)))
  @Ensures(result ==> this.size() == old(this.size()) + 1)
  @Ensures(!result ==> this.size() == old(this.size()))
  add(x: string): bool {
    if (this.items.has(x)) {
      return false;
    }
    this.items.set(x, true);
    return true;
  }

  // remove(x): bool -- delete x; true when it was a member (the size shrinks by 1). Expected O(1 + |x|).
  @Ensures(!this.has(x))
  @Ensures(result == old(this.has(x)))
  @Ensures(result ==> this.size() == old(this.size()) - 1)
  @Ensures(!result ==> this.size() == old(this.size()))
  remove(x: string): bool {
    if (!this.items.has(x)) {
      return false;
    }
    this.items.delete(x);
    return true;
  }

  // clear(): void -- remove all members. O(1).
  @Ensures(this.size() == 0)
  clear(): void {
    this.items = new Map<string, bool>();
  }

  // toArray(): string[] -- the members in insertion order (not sorted). O(n).
  @Ensures(result.length == this.size())
  toArray(): string[] {
    return this.items.keys();
  }

  // isSubsetOf(other): bool -- every member of this is a member of other. O(n).
  @Ensures(result ==> this.size() <= other.size())
  @Ensures(this.size() == 0 ==> result)
  isSubsetOf(other: StringSet): bool {
    if (this.items.size > other.size()) {
      return false;
    }
    const xs = this.items.keys();
    let i: usize = 0;
    while (i < xs.length) {
      if (!other.has(xs[i])) {
        return false;
      }
      i += 1;
    }
    return true;
  }

  // union(other): StringSet -- the members of either. O(n + m).
  @Ensures(this.isSubsetOf(result) && other.isSubsetOf(result))
  @Ensures(result.size() >= this.size() && result.size() <= this.size() + other.size())
  union(other: StringSet): StringSet {
    // start from the larger set (a copy-on-write value copy) and insert only the smaller one's members
    let out = this;
    let small = other;
    if (other.size() > this.items.size) {
      out = other;
      small = this;
    }
    const xs = small.toArray();
    let i: usize = 0;
    while (i < xs.length) {
      out.add(xs[i]);
      i += 1;
    }
    return out;
  }

  // intersection(other): StringSet -- the members of both. O(n).
  @Ensures(result.isSubsetOf(this) && result.isSubsetOf(other))
  @Ensures(result.size() <= this.size() && result.size() <= other.size())
  intersection(other: StringSet): StringSet {
    // walk the smaller set and probe the larger one
    let out = new StringSet();
    const walk = this.items.size <= other.size() ? this : other;
    const probe = this.items.size <= other.size() ? other : this;
    const xs = walk.toArray();
    let i: usize = 0;
    while (i < xs.length) {
      if (probe.has(xs[i])) {
        out.add(xs[i]);
      }
      i += 1;
    }
    return out;
  }

  // difference(other): StringSet -- the members of this that are not in other. O(n).
  @Ensures(result.isSubsetOf(this))
  @Ensures(result.intersection(other).isEmpty())
  @Ensures(result.size() + this.intersection(other).size() == this.size())
  difference(other: StringSet): StringSet {
    let out = new StringSet();
    const xs = this.items.keys();
    let i: usize = 0;
    while (i < xs.length) {
      if (!other.has(xs[i])) {
        out.add(xs[i]);
      }
      i += 1;
    }
    return out;
  }
}

// --------------------------------------------------------------------------------------------- Deque

// A double-ended queue on a ring buffer: `buf` has `capacity` slots (0 until the first push, then 4, 8, 16, ...),
// the element number i from the front lives in slot (head + i) mod capacity, and the ring is unrolled into a
// buffer of twice the size when it is full. Index arithmetic wraps by one conditional subtraction (no division).
// The language has no uninitialised slot and no default value of a type parameter, so slots that are not live hold
// `filler`, a copy of the first element ever pushed (a popped slot is overwritten with it, so at most that one
// value is kept alive beyond its time). Earlier versions used `Option<T>` slots, which boxes every element and made
// the invariant "exactly the live slots are Some" statable; measured on 500,000 push/pop rounds, plain slots take
// 84 ms against 128 ms. What the invariants can still state without equality on T is the index discipline:
// `len <= capacity`, `head` in range, and a filler exists exactly when there is storage.
@Invariant(this.len <= this.buf.length)
@Invariant(this.buf.length == 0 ? this.head == 0 : this.head < this.buf.length)
@Invariant(this.filler.isSome() == (this.buf.length > 0))
export class Deque<T> {
  private buf: T[] = [];
  private head: usize = 0;
  private len: usize = 0;
  private filler: Option<T> = None;

  // size(): usize -- number of elements. O(1).
  @Ensures(result == this.len)
  size(): usize {
    return this.len;
  }

  // isEmpty(): bool -- no elements. O(1).
  @Ensures(result == (this.size() == 0))
  isEmpty(): bool {
    return this.len == 0;
  }

  // capacity(): usize -- number of slots of the ring (0 until the first push; then 4, 8, 16, ...). O(1).
  @Ensures(result == this.buf.length)
  capacity(): usize {
    return this.buf.length;
  }

  // Slot of the element number i from the front (i <= len; i = len is the slot after the back).
  // A private method does not assume the class invariant, so `head < buf.length` is stated here; it holds at
  // every call (found by `orin verify --contracts`, ADR-0031 B).
  @Requires(this.buf.length > 0 && this.head < this.buf.length && i <= this.len)
  @Ensures(result < this.buf.length)
  private slot(i: usize): usize {
    const idx = this.head + i;
    if (idx >= this.buf.length) {
      return idx - this.buf.length;
    }
    return idx;
  }

  // Doubles the ring (4 slots at first) when it is full, unrolling it so that head becomes 0. O(n).
  private grow(x: T): void {
    if (this.filler.isNone()) {
      this.filler = Some(x);
    }
    const cap = this.buf.length;
    if (this.len < cap) {
      return;
    }
    const ncap: usize = cap == 0 ? 4 : cap * 2;
    const fill = this.filler.unwrap();
    let nb: T[] = [];
    let i: usize = 0;
    while (i < this.len) {
      nb.push(this.buf[this.slot(i)]);
      i += 1;
    }
    while (nb.length < ncap) {
      nb.push(fill);
    }
    this.buf = nb;
    this.head = 0;
  }

  // pushBack(x): void -- append x. Amortised O(1).
  @Ensures(this.size() == old(this.size()) + 1)
  @Ensures(this.back().isSome() && this.get(this.size() - 1).isSome())
  @Ensures(old(this.isEmpty()) ==> this.front().isSome())
  @Ensures(this.capacity() >= old(this.capacity()))
  pushBack(x: T): void {
    this.grow(x);
    this.buf[this.slot(this.len)] = x;
    this.len += 1;
  }

  // pushFront(x): void -- prepend x. Amortised O(1).
  @Ensures(this.size() == old(this.size()) + 1)
  @Ensures(this.front().isSome() && this.get(0).isSome())
  @Ensures(old(this.isEmpty()) ==> this.back().isSome())
  @Ensures(this.capacity() >= old(this.capacity()))
  pushFront(x: T): void {
    this.grow(x);
    if (this.head == 0) {
      this.head = this.buf.length - 1;
    } else {
      this.head -= 1;
    }
    this.buf[this.head] = x;
    this.len += 1;
  }

  // popFront(): Option<T> -- remove and return the first element, None when empty. O(1).
  @Ensures(result.isSome() == (old(this.size()) > 0))
  @Ensures(result.isSome() ==> this.size() == old(this.size()) - 1)
  @Ensures(result.isNone() ==> this.size() == 0)
  popFront(): Option<T> {
    if (this.len == 0) {
      return None;
    }
    const v = this.buf[this.head];
    this.buf[this.head] = this.filler.unwrap();
    this.head += 1;
    if (this.head == this.buf.length) {
      this.head = 0;
    }
    this.len -= 1;
    return Some(v);
  }

  // popBack(): Option<T> -- remove and return the last element, None when empty. O(1).
  @Ensures(result.isSome() == (old(this.size()) > 0))
  @Ensures(result.isSome() ==> this.size() == old(this.size()) - 1)
  @Ensures(result.isNone() ==> this.size() == 0)
  popBack(): Option<T> {
    if (this.len == 0) {
      return None;
    }
    const at = this.slot(this.len - 1);
    const v = this.buf[at];
    this.buf[at] = this.filler.unwrap();
    this.len -= 1;
    return Some(v);
  }

  // front(): Option<T> -- the first element without removing it, None when empty. O(1).
  @Ensures(result.isSome() == (this.size() > 0))
  front(): Option<T> {
    if (this.len == 0) {
      return None;
    }
    return Some(this.buf[this.head]);
  }

  // back(): Option<T> -- the last element without removing it, None when empty. O(1).
  @Ensures(result.isSome() == (this.size() > 0))
  back(): Option<T> {
    if (this.len == 0) {
      return None;
    }
    return Some(this.buf[this.slot(this.len - 1)]);
  }

  // get(i): Option<T> -- the i-th element from the front, None when i >= size(). O(1).
  @Ensures(result.isSome() == (i < this.size()))
  get(i: usize): Option<T> {
    if (i >= this.len) {
      return None;
    }
    return Some(this.buf[this.slot(i)]);
  }

  // clear(): void -- remove all elements and release the storage. O(1).
  @Ensures(this.size() == 0 && this.capacity() == 0)
  clear(): void {
    this.buf = [];
    this.head = 0;
    this.len = 0;
    this.filler = None;
  }

  // toArray(): T[] -- the elements front to back. O(n).
  @Ensures(result.length == this.size())
  toArray(): T[] {
    let out: T[] = [];
    let i: usize = 0;
    while (i < this.len) {
      out.push(this.buf[this.slot(i)]);
      i += 1;
    }
    return out;
  }
}

// BEGIN GENERATED by tools/gen_sorted_map.py from tools/sorted_map.tmpl: do not edit, run the script
// ------------------------------------------------------------------------------------------ SortedMap

// One node of the B-tree: `keys` sorted, `vals` parallel to them, `kids` empty for a leaf, else keys.length + 1
// child ids (indices into the arena `nodes` of the map).
export type IntNode<V> = { keys: int[]; vals: V[]; kids: usize[]; };

// An entry of `SortedMap`: what `first`, `last`, `popFirst`, `popLast` return and `entries` lists.
export type SortedEntry<V> = { key: int; value: V; };

// The first index whose key is >= k (keys.length when there is none). Binary search, O(log keys.length).
@Ensures(result <= keys.length)
@Ensures(result < keys.length ==> (keys[result] >= k))
@Ensures(result > 0 ==> (keys[result - 1] < k))
export function lowerBoundInt(keys: int[], k: int): usize {
  let lo: usize = 0;
  let hi: usize = keys.length;
  while (lo < hi) {
    const mid = lo + (hi - lo) / 2;
    if ((keys[mid] < k)) {
      lo = mid + 1;
    } else {
      hi = mid;
    }
  }
  return lo;
}

// Is `nodes` a well-formed B-tree arena of minimum degree t rooted at `root`, with free list `free`? Checked
// iteratively with an explicit stack: every node id is in range and reached exactly once (no dangling or shared
// ids, no cycles), keys and values have the same length, a leaf has no children and an inner node has one more
// child than keys (and at least one key), every non-root node holds t-1 .. 2t-1 keys and the root at most 2t-1,
// all leaves have the same depth, the free list holds distinct ids of unreachable nodes, and every arena slot is
// either reachable or free.
export function btreeIntShapeOk<V>(nodes: IntNode<V>[], root: usize, t: usize, free: usize[]): bool {
  const n = nodes.length;
  if (t < 2 || root >= n) {
    return false;
  }
  let seen: bool[] = [];
  let i: usize = 0;
  while (i < n) {
    seen.push(false);
    i += 1;
  }
  i = 0;
  while (i < free.length) {
    if (free[i] >= n || seen[free[i]]) {
      return false;
    }
    seen[free[i]] = true;
    i += 1;
  }
  let ids: usize[] = [root];
  let depths: usize[] = [0];
  let leafDepth: int = -1;
  let reachable: usize = 0;
  while (ids.length > 0) {
    const id = ids.pop().unwrap();
    const d = depths.pop().unwrap();
    if (seen[id]) {
      return false;
    }
    seen[id] = true;
    reachable += 1;
    const kc = nodes[id].keys.length;
    if (nodes[id].vals.length != kc || kc > 2 * t - 1) {
      return false;
    }
    if (id != root && kc < t - 1) {
      return false;
    }
    const kk = nodes[id].kids.length;
    if (kk == 0) {
      if (leafDepth < 0) {
        leafDepth = d.toInt();
      } else if (leafDepth != d.toInt()) {
        return false;
      }
    } else {
      if (kk != kc + 1 || kc == 0) {
        return false;
      }
      let c: usize = 0;
      while (c < kk) {
        if (nodes[id].kids[c] >= n) {
          return false;
        }
        ids.push(nodes[id].kids[c]);
        depths.push(d + 1);
        c += 1;
      }
    }
  }
  return reachable + free.length == n;
}

// Are the keys ordered? Inside every node strictly increasing, and every key of a child lies strictly between the
// separator keys around it in the parent (inherited bounds), which together say the in-order sequence is strictly
// increasing. Iterative; tolerates a broken shape (out-of-range ids, revisits) by answering false.
export function btreeIntOrderOk<V>(nodes: IntNode<V>[], root: usize): bool {
  if (root >= nodes.length) {
    return false;
  }
  let ids: usize[] = [root];
  let loFlags: bool[] = [false];
  let los: int[] = [0];
  let hiFlags: bool[] = [false];
  let his: int[] = [0];
  let visited: usize = 0;
  while (ids.length > 0) {
    visited += 1;
    if (visited > nodes.length) {
      return false;
    }
    const id = ids.pop().unwrap();
    const hasLo = loFlags.pop().unwrap();
    const lo = los.pop().unwrap();
    const hasHi = hiFlags.pop().unwrap();
    const hi = his.pop().unwrap();
    const kc = nodes[id].keys.length;
    let j: usize = 0;
    while (j < kc) {
      if (j > 0 && (nodes[id].keys[j - 1] >= nodes[id].keys[j])) {
        return false;
      }
      j += 1;
    }
    if (kc > 0) {
      if (hasLo && (nodes[id].keys[0] <= lo)) {
        return false;
      }
      if (hasHi && (nodes[id].keys[kc - 1] >= hi)) {
        return false;
      }
    }
    const kk = nodes[id].kids.length;
    if (kk > 0 && kk != kc + 1) {
      return false;
    }
    let c: usize = 0;
    while (c < kk) {
      if (nodes[id].kids[c] >= nodes.length) {
        return false;
      }
      ids.push(nodes[id].kids[c]);
      if (c == 0) {
        loFlags.push(hasLo);
        los.push(lo);
      } else {
        loFlags.push(true);
        los.push(nodes[id].keys[c - 1]);
      }
      if (c == kc) {
        hiFlags.push(hasHi);
        his.push(hi);
      } else {
        hiFlags.push(true);
        his.push(nodes[id].keys[c]);
      }
      c += 1;
    }
  }
  return true;
}

// The number of keys stored in the tree below `root` (iterative; a revisit or bad id stops the walk early).
export function btreeIntKeyCount<V>(nodes: IntNode<V>[], root: usize): usize {
  if (root >= nodes.length) {
    return 0;
  }
  let ids: usize[] = [root];
  let total: usize = 0;
  let visited: usize = 0;
  while (ids.length > 0) {
    visited += 1;
    if (visited > nodes.length) {
      return total;
    }
    const id = ids.pop().unwrap();
    total += nodes[id].keys.length;
    let c: usize = 0;
    while (c < nodes[id].kids.length) {
      if (nodes[id].kids[c] < nodes.length) {
        ids.push(nodes[id].kids[c]);
      }
      c += 1;
    }
  }
  return total;
}

// Height of the tree: the number of levels (1 for a single leaf root). Follows the first child down. O(height).
export function btreeIntHeight<V>(nodes: IntNode<V>[], root: usize): usize {
  let h: usize = 1;
  let id = root;
  while (id < nodes.length && nodes[id].kids.length > 0 && h <= nodes.length) {
    id = nodes[id].kids[0];
    h += 1;
  }
  return h;
}

// The fewest keys a tree of minimum degree t and the given height can hold: the root has 1 key, every other node
// at least t-1, so level d >= 1 has >= 2 t^(d-1) nodes and the total is 2 t^(h-1) - 1 (height 1: 1 key, but the
// root leaf may also be empty, so 0 is returned for an empty tree by the caller). This is why height is O(log_t n).
@Requires(t >= 2 && h >= 1)
export function btreeMinKeysInt(h: usize, t: usize): usize {
  let p: usize = 1;
  let d: usize = 1;
  while (d < h) {
    p *= t;
    d += 1;
  }
  return 2 * p - 1;
}

// All keys in order, by an explicit-stack in-order walk (the stack holds a node id and how many of its children
// were visited). O(n).
export function btreeIntKeys<V>(nodes: IntNode<V>[], root: usize): int[] {
  let out: int[] = [];
  let ids: usize[] = [root];
  let js: usize[] = [0];
  while (ids.length > 0) {
    const top = ids.length - 1;
    const id = ids[top];
    const j = js[top];
    const kc = nodes[id].keys.length;
    if (nodes[id].kids.length == 0) {
      let a: usize = 0;
      while (a < kc) {
        out.push(nodes[id].keys[a]);
        a += 1;
      }
      ids.pop();
      js.pop();
    } else {
      if (j > 0 && j - 1 < kc) {
        out.push(nodes[id].keys[j - 1]);
      }
      if (j <= kc) {
        js[top] = j + 1;
        ids.push(nodes[id].kids[j]);
        js.push(0);
      } else {
        ids.pop();
        js.pop();
      }
    }
  }
  return out;
}

// All values in key order (same walk as `btreeIntKeys`). O(n).
export function btreeIntVals<V>(nodes: IntNode<V>[], root: usize): V[] {
  let out: V[] = [];
  let ids: usize[] = [root];
  let js: usize[] = [0];
  while (ids.length > 0) {
    const top = ids.length - 1;
    const id = ids[top];
    const j = js[top];
    const kc = nodes[id].keys.length;
    if (nodes[id].kids.length == 0) {
      let a: usize = 0;
      while (a < kc) {
        out.push(nodes[id].vals[a]);
        a += 1;
      }
      ids.pop();
      js.pop();
    } else {
      if (j > 0 && j - 1 < kc) {
        out.push(nodes[id].vals[j - 1]);
      }
      if (j <= kc) {
        js[top] = j + 1;
        ids.push(nodes[id].kids[j]);
        js.push(0);
      } else {
        ids.pop();
        js.pop();
      }
    }
  }
  return out;
}

// An ordered map from int keys to values of type V: a B-tree of minimum degree t (every node but the root holds
// t-1 .. 2t-1 keys, all leaves at the same depth) whose nodes live in an arena (`nodes`) and refer to each other
// by index, so the structure is a plain value (copy-on-write arrays, no pointers, no parent links). `free` lists
// the arena slots of merged-away nodes for reuse. Insertion splits full nodes on the way down and deletion makes
// every node it enters hold at least t keys (borrow from a sibling or merge), so both run in one root-to-leaf pass.
//
// Invariants (`@Invariant`, checked after every public method by `orin test` / `--check-contracts`): the arena is a
// valid B-tree of degree t (shape, occupancy, equal leaf depth, no dangling or shared ids, consistent free list),
// keys are ordered (sorted within nodes and bounded by the separators above them) and the stored count equals the
// number of keys. Complexity: has/get/set/remove/floorKey/ceilKey/firstKey/lastKey/first/last/popFirst/popLast O(t log_t n)
// (a binary search of O(log t) in each of O(log_t n) nodes, plus O(t) to shift keys inside one node per level on
// updates); size/isEmpty O(1); keys/values/entries O(n); `height()` <= 1 + log_t((n+1)/2). Use t = 16 unless you
// have measured otherwise; `minDegree` 2 gives the smallest nodes and deepest trees (useful for tests).
@Invariant(this.t >= 2)
@Invariant(btreeIntShapeOk(this.nodes, this.root, this.t, this.free))
@Invariant(btreeIntOrderOk(this.nodes, this.root))
@Invariant(btreeIntKeyCount(this.nodes, this.root) == this.count)
export class SortedMap<V> {
  private t: usize;
  private nodes: IntNode<V>[] = [IntNode<V> { keys: [], vals: [], kids: [] }];
  private root: usize = 0;
  private free: usize[] = [];
  private count: usize = 0;

  // new SortedMap<V>(minDegree): an empty map; every node but the root keeps minDegree-1 .. 2*minDegree-1 keys.
  @Requires(minDegree >= 2)
  constructor(minDegree: usize) {
    this.t = minDegree;
  }

  // size(): usize -- number of entries. O(1).
  @Ensures(result == this.count)
  size(): usize {
    return this.count;
  }

  // isEmpty(): bool -- no entries. O(1).
  @Ensures(result == (this.size() == 0))
  isEmpty(): bool {
    return this.count == 0;
  }

  // height(): usize -- number of levels of the tree (1 for the root leaf). It is logarithmic: a tree with this many levels
  // holds at least 2 t^(h-1) - 1 keys, so n keys need at most about log_t(n/2) + 1 levels. O(height).
  @Ensures(result >= 1)
  @Ensures(this.count > 0 ==> btreeMinKeysInt(result, this.t) <= this.count)
  height(): usize {
    return btreeIntHeight(this.nodes, this.root);
  }

  // has(k): bool -- is there an entry for k? O(t log_t n).
  @Ensures(result ==> this.size() > 0)
  has(k: int): bool {
    let x = this.root;
    while (true) {
      const i = lowerBoundInt(this.nodes[x].keys, k);
      if (i < this.nodes[x].keys.length && (this.nodes[x].keys[i] == k)) {
        return true;
      }
      if (this.nodes[x].kids.length == 0) {
        return false;
      }
      x = this.nodes[x].kids[i];
    }
    return false;
  }

  // get(k): Option<V> -- the value for k, None when absent. O(t log_t n).
  @Ensures(result.isSome() == this.has(k))
  get(k: int): Option<V> {
    let x = this.root;
    while (true) {
      const i = lowerBoundInt(this.nodes[x].keys, k);
      if (i < this.nodes[x].keys.length && (this.nodes[x].keys[i] == k)) {
        return Some(this.nodes[x].vals[i]);
      }
      if (this.nodes[x].kids.length == 0) {
        return None;
      }
      x = this.nodes[x].kids[i];
    }
    return None;
  }

  // A fresh arena slot (reusing a freed one) holding the given node contents.
  private alloc(keys: int[], vals: V[], kids: usize[]): usize {
    if (this.free.length > 0) {
      const id = this.free.pop().unwrap();
      this.nodes[id] = IntNode<V> { keys: keys, vals: vals, kids: kids };
      return id;
    }
    this.nodes.push(IntNode<V> { keys: keys, vals: vals, kids: kids });
    return this.nodes.length - 1;
  }

  // Empties an arena slot and puts it on the free list.
  private release(id: usize): void {
    this.nodes[id] = IntNode<V> { keys: [], vals: [], kids: [] };
    this.free.push(id);
  }

  private insertKey(id: usize, pos: usize, k: int, v: V): void {
    this.nodes[id].keys.push(k);
    this.nodes[id].vals.push(v);
    let j = this.nodes[id].keys.length - 1;
    while (j > pos) {
      this.nodes[id].keys[j] = this.nodes[id].keys[j - 1];
      this.nodes[id].vals[j] = this.nodes[id].vals[j - 1];
      j -= 1;
    }
    this.nodes[id].keys[pos] = k;
    this.nodes[id].vals[pos] = v;
  }

  private removeKey(id: usize, pos: usize): void {
    let j = pos;
    while (j + 1 < this.nodes[id].keys.length) {
      this.nodes[id].keys[j] = this.nodes[id].keys[j + 1];
      this.nodes[id].vals[j] = this.nodes[id].vals[j + 1];
      j += 1;
    }
    this.nodes[id].keys.pop();
    this.nodes[id].vals.pop();
  }

  private insertKid(id: usize, pos: usize, kid: usize): void {
    this.nodes[id].kids.push(kid);
    let j = this.nodes[id].kids.length - 1;
    while (j > pos) {
      this.nodes[id].kids[j] = this.nodes[id].kids[j - 1];
      j -= 1;
    }
    this.nodes[id].kids[pos] = kid;
  }

  private removeKid(id: usize, pos: usize): void {
    let j = pos;
    while (j + 1 < this.nodes[id].kids.length) {
      this.nodes[id].kids[j] = this.nodes[id].kids[j + 1];
      j += 1;
    }
    this.nodes[id].kids.pop();
  }

  // Splits the full child number i of node x around its median key, which moves up into x.
  private splitChild(x: usize, i: usize): void {
    const t = this.t;
    const y = this.nodes[x].kids[i];
    const yk = this.nodes[y].keys;
    const yv = this.nodes[y].vals;
    const yc = this.nodes[y].kids;
    const med = yk[t - 1];
    const medv = yv[t - 1];
    let zc: usize[] = [];
    if (yc.length > 0) {
      zc = yc.slice(t, yc.length);
      this.nodes[y].kids = yc.slice(0, t);
    }
    const z = this.alloc(yk.slice(t, yk.length), yv.slice(t, yv.length), zc);
    this.nodes[y].keys = yk.slice(0, t - 1);
    this.nodes[y].vals = yv.slice(0, t - 1);
    this.insertKey(x, i, med, medv);
    this.insertKid(x, i + 1, z);
  }

  // set(k, v): bool -- associate k with v; true when k was new (the size grows by 1), false when an existing value was
  // replaced. Never traps. One root-to-leaf pass that splits full nodes on the way down. O(t log_t n).
  @Ensures(this.has(k) && this.get(k).isSome())
  @Ensures(result == !old(this.has(k)))
  @Ensures(result ==> this.size() == old(this.size()) + 1)
  @Ensures(!result ==> this.size() == old(this.size()))
  set(k: int, v: V): bool {
    const maxKeys = 2 * this.t - 1;
    if (this.nodes[this.root].keys.length == maxKeys) {
      const nr = this.alloc([], [], [this.root]);
      this.root = nr;
      this.splitChild(nr, 0);
    }
    let x = this.root;
    while (true) {
      const i = lowerBoundInt(this.nodes[x].keys, k);
      if (i < this.nodes[x].keys.length && (this.nodes[x].keys[i] == k)) {
        this.nodes[x].vals[i] = v;
        return false;
      }
      if (this.nodes[x].kids.length == 0) {
        this.insertKey(x, i, k, v);
        this.count += 1;
        return true;
      }
      let ci = i;
      if (this.nodes[this.nodes[x].kids[i]].keys.length == maxKeys) {
        this.splitChild(x, i);
        const m = this.nodes[x].keys[i];
        if ((k == m)) {
          this.nodes[x].vals[i] = v;
          return false;
        }
        if ((k > m)) {
          ci = i + 1;
        }
      }
      x = this.nodes[x].kids[ci];
    }
    return false;
  }

  // Child number ci of x has t-1 keys: give it one more from a sibling (rotation through x) or merge it with a
  // sibling. Returns the id of the child to descend into afterwards. May shrink the root.
  @Deprecated("use set(k, v) (ADR-0048)")
  @Ensures(this.has(k) && this.get(k).isSome())
  @Ensures(result == !old(this.has(k)))
  put(k: int, v: V): bool {
    return this.set(k, v);
  }

  private fill(x: usize, ci: usize): usize {
    const t = this.t;
    const len = this.nodes[x].keys.length;
    const c = this.nodes[x].kids[ci];
    if (ci > 0 && this.nodes[this.nodes[x].kids[ci - 1]].keys.length >= t) {
      const l = this.nodes[x].kids[ci - 1];
      const ll = this.nodes[l].keys.length;
      this.insertKey(c, 0, this.nodes[x].keys[ci - 1], this.nodes[x].vals[ci - 1]);
      this.nodes[x].keys[ci - 1] = this.nodes[l].keys[ll - 1];
      this.nodes[x].vals[ci - 1] = this.nodes[l].vals[ll - 1];
      if (this.nodes[l].kids.length > 0) {
        this.insertKid(c, 0, this.nodes[l].kids[this.nodes[l].kids.length - 1]);
        this.nodes[l].kids.pop();
      }
      this.nodes[l].keys.pop();
      this.nodes[l].vals.pop();
      return c;
    }
    if (ci < len && this.nodes[this.nodes[x].kids[ci + 1]].keys.length >= t) {
      const r = this.nodes[x].kids[ci + 1];
      this.insertKey(c, this.nodes[c].keys.length, this.nodes[x].keys[ci], this.nodes[x].vals[ci]);
      this.nodes[x].keys[ci] = this.nodes[r].keys[0];
      this.nodes[x].vals[ci] = this.nodes[r].vals[0];
      this.removeKey(r, 0);
      if (this.nodes[r].kids.length > 0) {
        this.nodes[c].kids.push(this.nodes[r].kids[0]);
        this.removeKid(r, 0);
      }
      return c;
    }
    if (ci < len) {
      this.mergeChildren(x, ci);
      return c;
    }
    const left = this.nodes[x].kids[ci - 1];
    this.mergeChildren(x, ci - 1);
    return left;
  }

  // Merges child i+1 of x and the separator key i into child i; releases child i+1. If x was the root and ends up
  // without keys, its only child becomes the root.
  private mergeChildren(x: usize, i: usize): void {
    const y = this.nodes[x].kids[i];
    const z = this.nodes[x].kids[i + 1];
    this.nodes[y].keys.push(this.nodes[x].keys[i]);
    this.nodes[y].vals.push(this.nodes[x].vals[i]);
    let a: usize = 0;
    while (a < this.nodes[z].keys.length) {
      this.nodes[y].keys.push(this.nodes[z].keys[a]);
      this.nodes[y].vals.push(this.nodes[z].vals[a]);
      a += 1;
    }
    let b: usize = 0;
    while (b < this.nodes[z].kids.length) {
      this.nodes[y].kids.push(this.nodes[z].kids[b]);
      b += 1;
    }
    this.removeKey(x, i);
    this.removeKid(x, i + 1);
    this.release(z);
    if (x == this.root && this.nodes[x].keys.length == 0) {
      this.root = y;
      this.release(x);
    }
  }

  // remove(k): Option<V> -- delete the entry for k and return its value, None when absent. One root-to-leaf pass (CLRS
  // top-down deletion): a node is only entered when it has at least t keys, so removing from a leaf never
  // underflows. A key in an inner node is replaced by its predecessor or successor (or the children are merged) and
  // that key is deleted further down. O(t log_t n).
  @Ensures(!this.has(k))
  @Ensures(result.isSome() == old(this.has(k)))
  @Ensures(result.isSome() ==> this.size() == old(this.size()) - 1)
  @Ensures(result.isNone() ==> this.size() == old(this.size()))
  remove(k: int): Option<V> {
    const t = this.t;
    let x = this.root;
    let target = k;
    let removed: Option<V> = None;
    let saved = false;
    while (true) {
      const len = this.nodes[x].keys.length;
      const i = lowerBoundInt(this.nodes[x].keys, target);
      const isLeaf = this.nodes[x].kids.length == 0;
      if (i < len && (this.nodes[x].keys[i] == target)) {
        if (isLeaf) {
          if (!saved) {
            removed = Some(this.nodes[x].vals[i]);
          }
          this.removeKey(x, i);
          this.count -= 1;
          return removed;
        }
        if (!saved) {
          removed = Some(this.nodes[x].vals[i]);
          saved = true;
        }
        const y = this.nodes[x].kids[i];
        const z = this.nodes[x].kids[i + 1];
        if (this.nodes[y].keys.length >= t) {
          let w = y;
          while (this.nodes[w].kids.length > 0) {
            w = this.nodes[w].kids[this.nodes[w].kids.length - 1];
          }
          const last = this.nodes[w].keys.length - 1;
          this.nodes[x].keys[i] = this.nodes[w].keys[last];
          this.nodes[x].vals[i] = this.nodes[w].vals[last];
          target = this.nodes[w].keys[last];
          x = y;
        } else if (this.nodes[z].keys.length >= t) {
          let w = z;
          while (this.nodes[w].kids.length > 0) {
            w = this.nodes[w].kids[0];
          }
          this.nodes[x].keys[i] = this.nodes[w].keys[0];
          this.nodes[x].vals[i] = this.nodes[w].vals[0];
          target = this.nodes[w].keys[0];
          x = z;
        } else {
          this.mergeChildren(x, i);
          x = y;
        }
      } else {
        if (isLeaf) {
          return removed;
        }
        const c = this.nodes[x].kids[i];
        if (this.nodes[c].keys.length < t) {
          x = this.fill(x, i);
        } else {
          x = c;
        }
      }
    }
    return removed;
  }

  // firstKey(): Option<int> -- the smallest key, None when empty. O(height).
  @Ensures(result.isSome() == (this.size() > 0))
  @Ensures(result.isSome() ==> this.has(result.unwrap()))
  firstKey(): Option<int> {
    if (this.count == 0) {
      return None;
    }
    let x = this.root;
    while (this.nodes[x].kids.length > 0) {
      x = this.nodes[x].kids[0];
    }
    return Some(this.nodes[x].keys[0]);
  }

  // lastKey(): Option<int> -- the largest key, None when empty. O(height).
  @Ensures(result.isSome() == (this.size() > 0))
  @Ensures(result.isSome() ==> this.has(result.unwrap()))
  lastKey(): Option<int> {
    if (this.count == 0) {
      return None;
    }
    let x = this.root;
    while (this.nodes[x].kids.length > 0) {
      x = this.nodes[x].kids[this.nodes[x].kids.length - 1];
    }
    return Some(this.nodes[x].keys[this.nodes[x].keys.length - 1]);
  }

  // floorKey(k): Option<int> -- the greatest key <= k, None when there is none. One descent. O(t log_t n).
  @Ensures(result.isSome() ==> (result.unwrap() <= k) && this.has(result.unwrap()))
  @Ensures(result.isNone() ==> this.firstKey().isNone() || (this.firstKey().unwrap() > k))
  floorKey(k: int): Option<int> {
    let best: Option<int> = None;
    let x = this.root;
    while (true) {
      const i = lowerBoundInt(this.nodes[x].keys, k);
      if (i < this.nodes[x].keys.length && (this.nodes[x].keys[i] == k)) {
        return Some(k);
      }
      if (i > 0) {
        best = Some(this.nodes[x].keys[i - 1]);
      }
      if (this.nodes[x].kids.length == 0) {
        return best;
      }
      x = this.nodes[x].kids[i];
    }
    return best;
  }

  // ceilKey(k): Option<int> -- the smallest key >= k, None when there is none. One descent. O(t log_t n).
  @Ensures(result.isSome() ==> (result.unwrap() >= k) && this.has(result.unwrap()))
  @Ensures(result.isNone() ==> this.lastKey().isNone() || (this.lastKey().unwrap() < k))
  ceilKey(k: int): Option<int> {
    let best: Option<int> = None;
    let x = this.root;
    while (true) {
      const i = lowerBoundInt(this.nodes[x].keys, k);
      if (i < this.nodes[x].keys.length) {
        if ((this.nodes[x].keys[i] == k)) {
          return Some(k);
        }
        best = Some(this.nodes[x].keys[i]);
      }
      if (this.nodes[x].kids.length == 0) {
        return best;
      }
      x = this.nodes[x].kids[i];
    }
    return best;
  }

  // first(): Option<SortedEntry<V>> -- the entry with the smallest key, None when empty; nothing is removed. O(height).
  @Ensures(result.isSome() == (this.size() > 0))
  @Ensures(result.isSome() ==> (result.unwrap().key == this.firstKey().unwrapOr(0)))
  first(): Option<SortedEntry<V>> {
    const f = this.firstKey();
    if (f.isNone()) {
      return None;
    }
    return Some(SortedEntry<V> { key: f.unwrap(), value: this.get(f.unwrap()).unwrap() });
  }

  // last(): Option<SortedEntry<V>> -- the entry with the largest key, None when empty; nothing is removed. O(height).
  @Ensures(result.isSome() == (this.size() > 0))
  @Ensures(result.isSome() ==> (result.unwrap().key == this.lastKey().unwrapOr(0)))
  last(): Option<SortedEntry<V>> {
    const l = this.lastKey();
    if (l.isNone()) {
      return None;
    }
    return Some(SortedEntry<V> { key: l.unwrap(), value: this.get(l.unwrap()).unwrap() });
  }

  // popFirst(): Option<SortedEntry<V>> -- remove the entry with the smallest key and return it, None when empty. O(t log_t n).
  @Ensures(result.isSome() == (old(this.size()) > 0))
  @Ensures(result.isSome() ==> this.size() == old(this.size()) - 1 && !this.has(result.unwrap().key))
  @Ensures(result.isSome() ==> (result.unwrap().key == old(this.firstKey().unwrapOr(0))))
  @Ensures(result.isSome() && this.size() > 0 ==> (this.firstKey().unwrap() > result.unwrap().key))
  popFirst(): Option<SortedEntry<V>> {
    const f = this.firstKey();
    if (f.isNone()) {
      return None;
    }
    const v = this.remove(f.unwrap()).unwrap();
    return Some(SortedEntry<V> { key: f.unwrap(), value: v });
  }

  // popLast(): Option<SortedEntry<V>> -- remove the entry with the largest key and return it, None when empty. O(t log_t n).
  @Ensures(result.isSome() == (old(this.size()) > 0))
  @Ensures(result.isSome() ==> this.size() == old(this.size()) - 1 && !this.has(result.unwrap().key))
  @Ensures(result.isSome() ==> (result.unwrap().key == old(this.lastKey().unwrapOr(0))))
  @Ensures(result.isSome() && this.size() > 0 ==> (this.lastKey().unwrap() < result.unwrap().key))
  popLast(): Option<SortedEntry<V>> {
    const l = this.lastKey();
    if (l.isNone()) {
      return None;
    }
    const v = this.remove(l.unwrap()).unwrap();
    return Some(SortedEntry<V> { key: l.unwrap(), value: v });
  }

  // keys(): int[] -- all keys in increasing order. Never fails. O(n).
  @Ensures(result.length == this.size() && isStrictlyIncreasing(result))
  keys(): int[] {
    return btreeIntKeys(this.nodes, this.root);
  }

  // values(): V[] -- all values in key order. Never fails. O(n).
  @Ensures(result.length == this.size())
  values(): V[] {
    return btreeIntVals(this.nodes, this.root);
  }

  // entries(): SortedEntry<V>[] -- all entries in increasing key order. Never fails. O(n).
  @Ensures(result.length == this.size())
  entries(): SortedEntry<V>[] {
    const ks = btreeIntKeys(this.nodes, this.root);
    const vs = btreeIntVals(this.nodes, this.root);
    let out: SortedEntry<V>[] = [];
    let i: usize = 0;
    while (i < ks.length) {
      out.push(SortedEntry<V> { key: ks[i], value: vs[i] });
      i += 1;
    }
    return out;
  }

  @Deprecated("use keys() (ADR-0048)")
  @Ensures(result.length == this.size() && isStrictlyIncreasing(result))
  keyArray(): int[] {
    return this.keys();
  }

  @Deprecated("use values() (ADR-0048)")
  @Ensures(result.length == this.size())
  valueArray(): V[] {
    return this.values();
  }

  // clear(): void -- remove all entries. O(1).
  @Ensures(this.size() == 0)
  clear(): void {
    this.nodes = [IntNode<V> { keys: [], vals: [], kids: [] }];
    this.root = 0;
    this.free = [];
    this.count = 0;
  }
}

// ------------------------------------------------------------------------------------------ SortedStringMap

// One node of the B-tree: `keys` sorted, `vals` parallel to them, `kids` empty for a leaf, else keys.length + 1
// child ids (indices into the arena `nodes` of the map).
export type StringNode<V> = { keys: string[]; vals: V[]; kids: usize[]; };

// An entry of `SortedStringMap`: what `first`, `last`, `popFirst`, `popLast` return and `entries` lists.
export type SortedStringEntry<V> = { key: string; value: V; };

// The first index whose key is >= k (keys.length when there is none). Binary search, O(log keys.length).
@Ensures(result <= keys.length)
@Ensures(result < keys.length ==> (compareStrings(keys[result], k) >= 0))
@Ensures(result > 0 ==> (compareStrings(keys[result - 1], k) < 0))
export function lowerBoundString(keys: string[], k: string): usize {
  let lo: usize = 0;
  let hi: usize = keys.length;
  while (lo < hi) {
    const mid = lo + (hi - lo) / 2;
    if ((compareStrings(keys[mid], k) < 0)) {
      lo = mid + 1;
    } else {
      hi = mid;
    }
  }
  return lo;
}

// Is `nodes` a well-formed B-tree arena of minimum degree t rooted at `root`, with free list `free`? Checked
// iteratively with an explicit stack: every node id is in range and reached exactly once (no dangling or shared
// ids, no cycles), keys and values have the same length, a leaf has no children and an inner node has one more
// child than keys (and at least one key), every non-root node holds t-1 .. 2t-1 keys and the root at most 2t-1,
// all leaves have the same depth, the free list holds distinct ids of unreachable nodes, and every arena slot is
// either reachable or free.
export function btreeStringShapeOk<V>(nodes: StringNode<V>[], root: usize, t: usize, free: usize[]): bool {
  const n = nodes.length;
  if (t < 2 || root >= n) {
    return false;
  }
  let seen: bool[] = [];
  let i: usize = 0;
  while (i < n) {
    seen.push(false);
    i += 1;
  }
  i = 0;
  while (i < free.length) {
    if (free[i] >= n || seen[free[i]]) {
      return false;
    }
    seen[free[i]] = true;
    i += 1;
  }
  let ids: usize[] = [root];
  let depths: usize[] = [0];
  let leafDepth: int = -1;
  let reachable: usize = 0;
  while (ids.length > 0) {
    const id = ids.pop().unwrap();
    const d = depths.pop().unwrap();
    if (seen[id]) {
      return false;
    }
    seen[id] = true;
    reachable += 1;
    const kc = nodes[id].keys.length;
    if (nodes[id].vals.length != kc || kc > 2 * t - 1) {
      return false;
    }
    if (id != root && kc < t - 1) {
      return false;
    }
    const kk = nodes[id].kids.length;
    if (kk == 0) {
      if (leafDepth < 0) {
        leafDepth = d.toInt();
      } else if (leafDepth != d.toInt()) {
        return false;
      }
    } else {
      if (kk != kc + 1 || kc == 0) {
        return false;
      }
      let c: usize = 0;
      while (c < kk) {
        if (nodes[id].kids[c] >= n) {
          return false;
        }
        ids.push(nodes[id].kids[c]);
        depths.push(d + 1);
        c += 1;
      }
    }
  }
  return reachable + free.length == n;
}

// Are the keys ordered? Inside every node strictly increasing, and every key of a child lies strictly between the
// separator keys around it in the parent (inherited bounds), which together say the in-order sequence is strictly
// increasing. Iterative; tolerates a broken shape (out-of-range ids, revisits) by answering false.
export function btreeStringOrderOk<V>(nodes: StringNode<V>[], root: usize): bool {
  if (root >= nodes.length) {
    return false;
  }
  let ids: usize[] = [root];
  let loFlags: bool[] = [false];
  let los: string[] = [""];
  let hiFlags: bool[] = [false];
  let his: string[] = [""];
  let visited: usize = 0;
  while (ids.length > 0) {
    visited += 1;
    if (visited > nodes.length) {
      return false;
    }
    const id = ids.pop().unwrap();
    const hasLo = loFlags.pop().unwrap();
    const lo = los.pop().unwrap();
    const hasHi = hiFlags.pop().unwrap();
    const hi = his.pop().unwrap();
    const kc = nodes[id].keys.length;
    let j: usize = 0;
    while (j < kc) {
      if (j > 0 && (compareStrings(nodes[id].keys[j - 1], nodes[id].keys[j]) >= 0)) {
        return false;
      }
      j += 1;
    }
    if (kc > 0) {
      if (hasLo && (compareStrings(nodes[id].keys[0], lo) <= 0)) {
        return false;
      }
      if (hasHi && (compareStrings(nodes[id].keys[kc - 1], hi) >= 0)) {
        return false;
      }
    }
    const kk = nodes[id].kids.length;
    if (kk > 0 && kk != kc + 1) {
      return false;
    }
    let c: usize = 0;
    while (c < kk) {
      if (nodes[id].kids[c] >= nodes.length) {
        return false;
      }
      ids.push(nodes[id].kids[c]);
      if (c == 0) {
        loFlags.push(hasLo);
        los.push(lo);
      } else {
        loFlags.push(true);
        los.push(nodes[id].keys[c - 1]);
      }
      if (c == kc) {
        hiFlags.push(hasHi);
        his.push(hi);
      } else {
        hiFlags.push(true);
        his.push(nodes[id].keys[c]);
      }
      c += 1;
    }
  }
  return true;
}

// The number of keys stored in the tree below `root` (iterative; a revisit or bad id stops the walk early).
export function btreeStringKeyCount<V>(nodes: StringNode<V>[], root: usize): usize {
  if (root >= nodes.length) {
    return 0;
  }
  let ids: usize[] = [root];
  let total: usize = 0;
  let visited: usize = 0;
  while (ids.length > 0) {
    visited += 1;
    if (visited > nodes.length) {
      return total;
    }
    const id = ids.pop().unwrap();
    total += nodes[id].keys.length;
    let c: usize = 0;
    while (c < nodes[id].kids.length) {
      if (nodes[id].kids[c] < nodes.length) {
        ids.push(nodes[id].kids[c]);
      }
      c += 1;
    }
  }
  return total;
}

// Height of the tree: the number of levels (1 for a single leaf root). Follows the first child down. O(height).
export function btreeStringHeight<V>(nodes: StringNode<V>[], root: usize): usize {
  let h: usize = 1;
  let id = root;
  while (id < nodes.length && nodes[id].kids.length > 0 && h <= nodes.length) {
    id = nodes[id].kids[0];
    h += 1;
  }
  return h;
}

// The fewest keys a tree of minimum degree t and the given height can hold: the root has 1 key, every other node
// at least t-1, so level d >= 1 has >= 2 t^(d-1) nodes and the total is 2 t^(h-1) - 1 (height 1: 1 key, but the
// root leaf may also be empty, so 0 is returned for an empty tree by the caller). This is why height is O(log_t n).
@Requires(t >= 2 && h >= 1)
export function btreeMinKeysString(h: usize, t: usize): usize {
  let p: usize = 1;
  let d: usize = 1;
  while (d < h) {
    p *= t;
    d += 1;
  }
  return 2 * p - 1;
}

// All keys in order, by an explicit-stack in-order walk (the stack holds a node id and how many of its children
// were visited). O(n).
export function btreeStringKeys<V>(nodes: StringNode<V>[], root: usize): string[] {
  let out: string[] = [];
  let ids: usize[] = [root];
  let js: usize[] = [0];
  while (ids.length > 0) {
    const top = ids.length - 1;
    const id = ids[top];
    const j = js[top];
    const kc = nodes[id].keys.length;
    if (nodes[id].kids.length == 0) {
      let a: usize = 0;
      while (a < kc) {
        out.push(nodes[id].keys[a]);
        a += 1;
      }
      ids.pop();
      js.pop();
    } else {
      if (j > 0 && j - 1 < kc) {
        out.push(nodes[id].keys[j - 1]);
      }
      if (j <= kc) {
        js[top] = j + 1;
        ids.push(nodes[id].kids[j]);
        js.push(0);
      } else {
        ids.pop();
        js.pop();
      }
    }
  }
  return out;
}

// All values in key order (same walk as `btreeStringKeys`). O(n).
export function btreeStringVals<V>(nodes: StringNode<V>[], root: usize): V[] {
  let out: V[] = [];
  let ids: usize[] = [root];
  let js: usize[] = [0];
  while (ids.length > 0) {
    const top = ids.length - 1;
    const id = ids[top];
    const j = js[top];
    const kc = nodes[id].keys.length;
    if (nodes[id].kids.length == 0) {
      let a: usize = 0;
      while (a < kc) {
        out.push(nodes[id].vals[a]);
        a += 1;
      }
      ids.pop();
      js.pop();
    } else {
      if (j > 0 && j - 1 < kc) {
        out.push(nodes[id].vals[j - 1]);
      }
      if (j <= kc) {
        js[top] = j + 1;
        ids.push(nodes[id].kids[j]);
        js.push(0);
      } else {
        ids.pop();
        js.pop();
      }
    }
  }
  return out;
}

// An ordered map from string keys to values of type V: a B-tree of minimum degree t (every node but the root holds
// t-1 .. 2t-1 keys, all leaves at the same depth) whose nodes live in an arena (`nodes`) and refer to each other
// by index, so the structure is a plain value (copy-on-write arrays, no pointers, no parent links). `free` lists
// the arena slots of merged-away nodes for reuse. Insertion splits full nodes on the way down and deletion makes
// every node it enters hold at least t keys (borrow from a sibling or merge), so both run in one root-to-leaf pass.
//
// Invariants (`@Invariant`, checked after every public method by `orin test` / `--check-contracts`): the arena is a
// valid B-tree of degree t (shape, occupancy, equal leaf depth, no dangling or shared ids, consistent free list),
// keys are ordered (sorted within nodes and bounded by the separators above them) and the stored count equals the
// number of keys. Complexity: has/get/set/remove/floorKey/ceilKey/firstKey/lastKey/first/last/popFirst/popLast O(t log_t n)
// (a binary search of O(log t) in each of O(log_t n) nodes, plus O(t) to shift keys inside one node per level on
// updates); size/isEmpty O(1); keys/values/entries O(n); `height()` <= 1 + log_t((n+1)/2). Use t = 16 unless you
// have measured otherwise; `minDegree` 2 gives the smallest nodes and deepest trees (useful for tests).
@Invariant(this.t >= 2)
@Invariant(btreeStringShapeOk(this.nodes, this.root, this.t, this.free))
@Invariant(btreeStringOrderOk(this.nodes, this.root))
@Invariant(btreeStringKeyCount(this.nodes, this.root) == this.count)
export class SortedStringMap<V> {
  private t: usize;
  private nodes: StringNode<V>[] = [StringNode<V> { keys: [], vals: [], kids: [] }];
  private root: usize = 0;
  private free: usize[] = [];
  private count: usize = 0;

  // new SortedStringMap<V>(minDegree): an empty map; every node but the root keeps minDegree-1 .. 2*minDegree-1 keys.
  @Requires(minDegree >= 2)
  constructor(minDegree: usize) {
    this.t = minDegree;
  }

  // size(): usize -- number of entries. O(1).
  @Ensures(result == this.count)
  size(): usize {
    return this.count;
  }

  // isEmpty(): bool -- no entries. O(1).
  @Ensures(result == (this.size() == 0))
  isEmpty(): bool {
    return this.count == 0;
  }

  // height(): usize -- number of levels of the tree (1 for the root leaf). It is logarithmic: a tree with this many levels
  // holds at least 2 t^(h-1) - 1 keys, so n keys need at most about log_t(n/2) + 1 levels. O(height).
  @Ensures(result >= 1)
  @Ensures(this.count > 0 ==> btreeMinKeysString(result, this.t) <= this.count)
  height(): usize {
    return btreeStringHeight(this.nodes, this.root);
  }

  // has(k): bool -- is there an entry for k? O(t log_t n).
  @Ensures(result ==> this.size() > 0)
  has(k: string): bool {
    let x = this.root;
    while (true) {
      const i = lowerBoundString(this.nodes[x].keys, k);
      if (i < this.nodes[x].keys.length && (compareStrings(this.nodes[x].keys[i], k) == 0)) {
        return true;
      }
      if (this.nodes[x].kids.length == 0) {
        return false;
      }
      x = this.nodes[x].kids[i];
    }
    return false;
  }

  // get(k): Option<V> -- the value for k, None when absent. O(t log_t n).
  @Ensures(result.isSome() == this.has(k))
  get(k: string): Option<V> {
    let x = this.root;
    while (true) {
      const i = lowerBoundString(this.nodes[x].keys, k);
      if (i < this.nodes[x].keys.length && (compareStrings(this.nodes[x].keys[i], k) == 0)) {
        return Some(this.nodes[x].vals[i]);
      }
      if (this.nodes[x].kids.length == 0) {
        return None;
      }
      x = this.nodes[x].kids[i];
    }
    return None;
  }

  // A fresh arena slot (reusing a freed one) holding the given node contents.
  private alloc(keys: string[], vals: V[], kids: usize[]): usize {
    if (this.free.length > 0) {
      const id = this.free.pop().unwrap();
      this.nodes[id] = StringNode<V> { keys: keys, vals: vals, kids: kids };
      return id;
    }
    this.nodes.push(StringNode<V> { keys: keys, vals: vals, kids: kids });
    return this.nodes.length - 1;
  }

  // Empties an arena slot and puts it on the free list.
  private release(id: usize): void {
    this.nodes[id] = StringNode<V> { keys: [], vals: [], kids: [] };
    this.free.push(id);
  }

  private insertKey(id: usize, pos: usize, k: string, v: V): void {
    this.nodes[id].keys.push(k);
    this.nodes[id].vals.push(v);
    let j = this.nodes[id].keys.length - 1;
    while (j > pos) {
      this.nodes[id].keys[j] = this.nodes[id].keys[j - 1];
      this.nodes[id].vals[j] = this.nodes[id].vals[j - 1];
      j -= 1;
    }
    this.nodes[id].keys[pos] = k;
    this.nodes[id].vals[pos] = v;
  }

  private removeKey(id: usize, pos: usize): void {
    let j = pos;
    while (j + 1 < this.nodes[id].keys.length) {
      this.nodes[id].keys[j] = this.nodes[id].keys[j + 1];
      this.nodes[id].vals[j] = this.nodes[id].vals[j + 1];
      j += 1;
    }
    this.nodes[id].keys.pop();
    this.nodes[id].vals.pop();
  }

  private insertKid(id: usize, pos: usize, kid: usize): void {
    this.nodes[id].kids.push(kid);
    let j = this.nodes[id].kids.length - 1;
    while (j > pos) {
      this.nodes[id].kids[j] = this.nodes[id].kids[j - 1];
      j -= 1;
    }
    this.nodes[id].kids[pos] = kid;
  }

  private removeKid(id: usize, pos: usize): void {
    let j = pos;
    while (j + 1 < this.nodes[id].kids.length) {
      this.nodes[id].kids[j] = this.nodes[id].kids[j + 1];
      j += 1;
    }
    this.nodes[id].kids.pop();
  }

  // Splits the full child number i of node x around its median key, which moves up into x.
  private splitChild(x: usize, i: usize): void {
    const t = this.t;
    const y = this.nodes[x].kids[i];
    const yk = this.nodes[y].keys;
    const yv = this.nodes[y].vals;
    const yc = this.nodes[y].kids;
    const med = yk[t - 1];
    const medv = yv[t - 1];
    let zc: usize[] = [];
    if (yc.length > 0) {
      zc = yc.slice(t, yc.length);
      this.nodes[y].kids = yc.slice(0, t);
    }
    const z = this.alloc(yk.slice(t, yk.length), yv.slice(t, yv.length), zc);
    this.nodes[y].keys = yk.slice(0, t - 1);
    this.nodes[y].vals = yv.slice(0, t - 1);
    this.insertKey(x, i, med, medv);
    this.insertKid(x, i + 1, z);
  }

  // set(k, v): bool -- associate k with v; true when k was new (the size grows by 1), false when an existing value was
  // replaced. Never traps. One root-to-leaf pass that splits full nodes on the way down. O(t log_t n).
  @Ensures(this.has(k) && this.get(k).isSome())
  @Ensures(result == !old(this.has(k)))
  @Ensures(result ==> this.size() == old(this.size()) + 1)
  @Ensures(!result ==> this.size() == old(this.size()))
  set(k: string, v: V): bool {
    const maxKeys = 2 * this.t - 1;
    if (this.nodes[this.root].keys.length == maxKeys) {
      const nr = this.alloc([], [], [this.root]);
      this.root = nr;
      this.splitChild(nr, 0);
    }
    let x = this.root;
    while (true) {
      const i = lowerBoundString(this.nodes[x].keys, k);
      if (i < this.nodes[x].keys.length && (compareStrings(this.nodes[x].keys[i], k) == 0)) {
        this.nodes[x].vals[i] = v;
        return false;
      }
      if (this.nodes[x].kids.length == 0) {
        this.insertKey(x, i, k, v);
        this.count += 1;
        return true;
      }
      let ci = i;
      if (this.nodes[this.nodes[x].kids[i]].keys.length == maxKeys) {
        this.splitChild(x, i);
        const m = this.nodes[x].keys[i];
        if ((compareStrings(k, m) == 0)) {
          this.nodes[x].vals[i] = v;
          return false;
        }
        if ((compareStrings(k, m) > 0)) {
          ci = i + 1;
        }
      }
      x = this.nodes[x].kids[ci];
    }
    return false;
  }

  // Child number ci of x has t-1 keys: give it one more from a sibling (rotation through x) or merge it with a
  // sibling. Returns the id of the child to descend into afterwards. May shrink the root.
  @Deprecated("use set(k, v) (ADR-0048)")
  @Ensures(this.has(k) && this.get(k).isSome())
  @Ensures(result == !old(this.has(k)))
  put(k: string, v: V): bool {
    return this.set(k, v);
  }

  private fill(x: usize, ci: usize): usize {
    const t = this.t;
    const len = this.nodes[x].keys.length;
    const c = this.nodes[x].kids[ci];
    if (ci > 0 && this.nodes[this.nodes[x].kids[ci - 1]].keys.length >= t) {
      const l = this.nodes[x].kids[ci - 1];
      const ll = this.nodes[l].keys.length;
      this.insertKey(c, 0, this.nodes[x].keys[ci - 1], this.nodes[x].vals[ci - 1]);
      this.nodes[x].keys[ci - 1] = this.nodes[l].keys[ll - 1];
      this.nodes[x].vals[ci - 1] = this.nodes[l].vals[ll - 1];
      if (this.nodes[l].kids.length > 0) {
        this.insertKid(c, 0, this.nodes[l].kids[this.nodes[l].kids.length - 1]);
        this.nodes[l].kids.pop();
      }
      this.nodes[l].keys.pop();
      this.nodes[l].vals.pop();
      return c;
    }
    if (ci < len && this.nodes[this.nodes[x].kids[ci + 1]].keys.length >= t) {
      const r = this.nodes[x].kids[ci + 1];
      this.insertKey(c, this.nodes[c].keys.length, this.nodes[x].keys[ci], this.nodes[x].vals[ci]);
      this.nodes[x].keys[ci] = this.nodes[r].keys[0];
      this.nodes[x].vals[ci] = this.nodes[r].vals[0];
      this.removeKey(r, 0);
      if (this.nodes[r].kids.length > 0) {
        this.nodes[c].kids.push(this.nodes[r].kids[0]);
        this.removeKid(r, 0);
      }
      return c;
    }
    if (ci < len) {
      this.mergeChildren(x, ci);
      return c;
    }
    const left = this.nodes[x].kids[ci - 1];
    this.mergeChildren(x, ci - 1);
    return left;
  }

  // Merges child i+1 of x and the separator key i into child i; releases child i+1. If x was the root and ends up
  // without keys, its only child becomes the root.
  private mergeChildren(x: usize, i: usize): void {
    const y = this.nodes[x].kids[i];
    const z = this.nodes[x].kids[i + 1];
    this.nodes[y].keys.push(this.nodes[x].keys[i]);
    this.nodes[y].vals.push(this.nodes[x].vals[i]);
    let a: usize = 0;
    while (a < this.nodes[z].keys.length) {
      this.nodes[y].keys.push(this.nodes[z].keys[a]);
      this.nodes[y].vals.push(this.nodes[z].vals[a]);
      a += 1;
    }
    let b: usize = 0;
    while (b < this.nodes[z].kids.length) {
      this.nodes[y].kids.push(this.nodes[z].kids[b]);
      b += 1;
    }
    this.removeKey(x, i);
    this.removeKid(x, i + 1);
    this.release(z);
    if (x == this.root && this.nodes[x].keys.length == 0) {
      this.root = y;
      this.release(x);
    }
  }

  // remove(k): Option<V> -- delete the entry for k and return its value, None when absent. One root-to-leaf pass (CLRS
  // top-down deletion): a node is only entered when it has at least t keys, so removing from a leaf never
  // underflows. A key in an inner node is replaced by its predecessor or successor (or the children are merged) and
  // that key is deleted further down. O(t log_t n).
  @Ensures(!this.has(k))
  @Ensures(result.isSome() == old(this.has(k)))
  @Ensures(result.isSome() ==> this.size() == old(this.size()) - 1)
  @Ensures(result.isNone() ==> this.size() == old(this.size()))
  remove(k: string): Option<V> {
    const t = this.t;
    let x = this.root;
    let target = k;
    let removed: Option<V> = None;
    let saved = false;
    while (true) {
      const len = this.nodes[x].keys.length;
      const i = lowerBoundString(this.nodes[x].keys, target);
      const isLeaf = this.nodes[x].kids.length == 0;
      if (i < len && (compareStrings(this.nodes[x].keys[i], target) == 0)) {
        if (isLeaf) {
          if (!saved) {
            removed = Some(this.nodes[x].vals[i]);
          }
          this.removeKey(x, i);
          this.count -= 1;
          return removed;
        }
        if (!saved) {
          removed = Some(this.nodes[x].vals[i]);
          saved = true;
        }
        const y = this.nodes[x].kids[i];
        const z = this.nodes[x].kids[i + 1];
        if (this.nodes[y].keys.length >= t) {
          let w = y;
          while (this.nodes[w].kids.length > 0) {
            w = this.nodes[w].kids[this.nodes[w].kids.length - 1];
          }
          const last = this.nodes[w].keys.length - 1;
          this.nodes[x].keys[i] = this.nodes[w].keys[last];
          this.nodes[x].vals[i] = this.nodes[w].vals[last];
          target = this.nodes[w].keys[last];
          x = y;
        } else if (this.nodes[z].keys.length >= t) {
          let w = z;
          while (this.nodes[w].kids.length > 0) {
            w = this.nodes[w].kids[0];
          }
          this.nodes[x].keys[i] = this.nodes[w].keys[0];
          this.nodes[x].vals[i] = this.nodes[w].vals[0];
          target = this.nodes[w].keys[0];
          x = z;
        } else {
          this.mergeChildren(x, i);
          x = y;
        }
      } else {
        if (isLeaf) {
          return removed;
        }
        const c = this.nodes[x].kids[i];
        if (this.nodes[c].keys.length < t) {
          x = this.fill(x, i);
        } else {
          x = c;
        }
      }
    }
    return removed;
  }

  // firstKey(): Option<string> -- the smallest key, None when empty. O(height).
  @Ensures(result.isSome() == (this.size() > 0))
  @Ensures(result.isSome() ==> this.has(result.unwrap()))
  firstKey(): Option<string> {
    if (this.count == 0) {
      return None;
    }
    let x = this.root;
    while (this.nodes[x].kids.length > 0) {
      x = this.nodes[x].kids[0];
    }
    return Some(this.nodes[x].keys[0]);
  }

  // lastKey(): Option<string> -- the largest key, None when empty. O(height).
  @Ensures(result.isSome() == (this.size() > 0))
  @Ensures(result.isSome() ==> this.has(result.unwrap()))
  lastKey(): Option<string> {
    if (this.count == 0) {
      return None;
    }
    let x = this.root;
    while (this.nodes[x].kids.length > 0) {
      x = this.nodes[x].kids[this.nodes[x].kids.length - 1];
    }
    return Some(this.nodes[x].keys[this.nodes[x].keys.length - 1]);
  }

  // floorKey(k): Option<string> -- the greatest key <= k, None when there is none. One descent. O(t log_t n).
  @Ensures(result.isSome() ==> (compareStrings(result.unwrap(), k) <= 0) && this.has(result.unwrap()))
  @Ensures(result.isNone() ==> this.firstKey().isNone() || (compareStrings(this.firstKey().unwrap(), k) > 0))
  floorKey(k: string): Option<string> {
    let best: Option<string> = None;
    let x = this.root;
    while (true) {
      const i = lowerBoundString(this.nodes[x].keys, k);
      if (i < this.nodes[x].keys.length && (compareStrings(this.nodes[x].keys[i], k) == 0)) {
        return Some(k);
      }
      if (i > 0) {
        best = Some(this.nodes[x].keys[i - 1]);
      }
      if (this.nodes[x].kids.length == 0) {
        return best;
      }
      x = this.nodes[x].kids[i];
    }
    return best;
  }

  // ceilKey(k): Option<string> -- the smallest key >= k, None when there is none. One descent. O(t log_t n).
  @Ensures(result.isSome() ==> (compareStrings(result.unwrap(), k) >= 0) && this.has(result.unwrap()))
  @Ensures(result.isNone() ==> this.lastKey().isNone() || (compareStrings(this.lastKey().unwrap(), k) < 0))
  ceilKey(k: string): Option<string> {
    let best: Option<string> = None;
    let x = this.root;
    while (true) {
      const i = lowerBoundString(this.nodes[x].keys, k);
      if (i < this.nodes[x].keys.length) {
        if ((compareStrings(this.nodes[x].keys[i], k) == 0)) {
          return Some(k);
        }
        best = Some(this.nodes[x].keys[i]);
      }
      if (this.nodes[x].kids.length == 0) {
        return best;
      }
      x = this.nodes[x].kids[i];
    }
    return best;
  }

  // first(): Option<SortedStringEntry<V>> -- the entry with the smallest key, None when empty; nothing is removed. O(height).
  @Ensures(result.isSome() == (this.size() > 0))
  @Ensures(result.isSome() ==> (compareStrings(result.unwrap().key, this.firstKey().unwrapOr("")) == 0))
  first(): Option<SortedStringEntry<V>> {
    const f = this.firstKey();
    if (f.isNone()) {
      return None;
    }
    return Some(SortedStringEntry<V> { key: f.unwrap(), value: this.get(f.unwrap()).unwrap() });
  }

  // last(): Option<SortedStringEntry<V>> -- the entry with the largest key, None when empty; nothing is removed. O(height).
  @Ensures(result.isSome() == (this.size() > 0))
  @Ensures(result.isSome() ==> (compareStrings(result.unwrap().key, this.lastKey().unwrapOr("")) == 0))
  last(): Option<SortedStringEntry<V>> {
    const l = this.lastKey();
    if (l.isNone()) {
      return None;
    }
    return Some(SortedStringEntry<V> { key: l.unwrap(), value: this.get(l.unwrap()).unwrap() });
  }

  // popFirst(): Option<SortedStringEntry<V>> -- remove the entry with the smallest key and return it, None when empty. O(t log_t n).
  @Ensures(result.isSome() == (old(this.size()) > 0))
  @Ensures(result.isSome() ==> this.size() == old(this.size()) - 1 && !this.has(result.unwrap().key))
  @Ensures(result.isSome() ==> (compareStrings(result.unwrap().key, old(this.firstKey().unwrapOr(""))) == 0))
  @Ensures(result.isSome() && this.size() > 0 ==> (compareStrings(this.firstKey().unwrap(), result.unwrap().key) > 0))
  popFirst(): Option<SortedStringEntry<V>> {
    const f = this.firstKey();
    if (f.isNone()) {
      return None;
    }
    const v = this.remove(f.unwrap()).unwrap();
    return Some(SortedStringEntry<V> { key: f.unwrap(), value: v });
  }

  // popLast(): Option<SortedStringEntry<V>> -- remove the entry with the largest key and return it, None when empty. O(t log_t n).
  @Ensures(result.isSome() == (old(this.size()) > 0))
  @Ensures(result.isSome() ==> this.size() == old(this.size()) - 1 && !this.has(result.unwrap().key))
  @Ensures(result.isSome() ==> (compareStrings(result.unwrap().key, old(this.lastKey().unwrapOr(""))) == 0))
  @Ensures(result.isSome() && this.size() > 0 ==> (compareStrings(this.lastKey().unwrap(), result.unwrap().key) < 0))
  popLast(): Option<SortedStringEntry<V>> {
    const l = this.lastKey();
    if (l.isNone()) {
      return None;
    }
    const v = this.remove(l.unwrap()).unwrap();
    return Some(SortedStringEntry<V> { key: l.unwrap(), value: v });
  }

  // keys(): string[] -- all keys in increasing order. Never fails. O(n).
  @Ensures(result.length == this.size() && isStrictlyIncreasingStrings(result))
  keys(): string[] {
    return btreeStringKeys(this.nodes, this.root);
  }

  // values(): V[] -- all values in key order. Never fails. O(n).
  @Ensures(result.length == this.size())
  values(): V[] {
    return btreeStringVals(this.nodes, this.root);
  }

  // entries(): SortedStringEntry<V>[] -- all entries in increasing key order. Never fails. O(n).
  @Ensures(result.length == this.size())
  entries(): SortedStringEntry<V>[] {
    const ks = btreeStringKeys(this.nodes, this.root);
    const vs = btreeStringVals(this.nodes, this.root);
    let out: SortedStringEntry<V>[] = [];
    let i: usize = 0;
    while (i < ks.length) {
      out.push(SortedStringEntry<V> { key: ks[i], value: vs[i] });
      i += 1;
    }
    return out;
  }

  @Deprecated("use keys() (ADR-0048)")
  @Ensures(result.length == this.size() && isStrictlyIncreasingStrings(result))
  keyArray(): string[] {
    return this.keys();
  }

  @Deprecated("use values() (ADR-0048)")
  @Ensures(result.length == this.size())
  valueArray(): V[] {
    return this.values();
  }

  // clear(): void -- remove all entries. O(1).
  @Ensures(this.size() == 0)
  clear(): void {
    this.nodes = [StringNode<V> { keys: [], vals: [], kids: [] }];
    this.root = 0;
    this.free = [];
    this.count = 0;
  }
}

