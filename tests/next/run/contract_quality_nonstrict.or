// warns: none
// Without --strict-contracts (or `[contracts] strict = true`) the strict warnings W0470 / W0471 are off.
import { exit } from "std:process";

class Bare {
  v: int = 0;

  bump(): void {
    this.v += 1;
  }
}

function main(): void {
  let b = new Bare();
  b.bump();
  console.log((b.v).toString());
  exit(0);
}
