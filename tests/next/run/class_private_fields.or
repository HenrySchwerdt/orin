// Private fields and methods are accessible inside the class body only.
class Account {
  private balance: int;
  private history: int[] = [];
  owner: string;
  constructor(owner: string, opening: int) {
    this.owner = owner;
    this.balance = opening;
  }
  private record(amount: int): void {
    this.history.push(amount);
  }
  deposit(amount: int): void {
    this.balance += amount;
    this.record(amount);
  }
  withdraw(amount: int): bool {
    if (amount > this.balance) {
      return false;
    }
    this.balance -= amount;
    this.record(0 - amount);
    return true;
  }
  total(): int {
    return this.balance;
  }
  count(): usize {
    return this.history.length;
  }
}

function main(): void {
  let acc = new Account("zoe", 100);
  acc.deposit(50);
  const ok = acc.withdraw(500);
  const ok2 = acc.withdraw(30);
  console.log(acc.owner + " " + acc.total().toString() + " " + ok.toString() + " " + ok2.toString());
  console.log(acc.count().toString());
}
