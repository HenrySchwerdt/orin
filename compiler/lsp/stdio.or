// Process stdio for the language server loop (spec 18 §3): the only compiler file that uses
// `std:io`.

import { StdioGrant } from "std:io";
import { readBytes, readLine, writeStdout } from "std:io";

export function stdinReadBytes(stdio: StdioGrant, n: usize): Option<string> {
  return readBytes(stdio, n);
}

export function stdinReadLine(stdio: StdioGrant): Option<string> {
  return readLine(stdio);
}

export function stdoutWrite(stdio: StdioGrant, s: string): void {
  writeStdout(stdio, s);
}
