// Canonical AST dump, used for differential parser testing (Stage 1 vs Stage 0).
//
// FORMAT (deterministic, s-expression-like; one top-level item per line)
//
//   module  := item ("\n" item)*              (no trailing text; the printer adds "\n")
//   item    := (import STR NAME*) | (reexport STR NAME*)
//            | (fn EXP NAME (tparams NAME*) (params (param NAME TYPE)*) RET BLOCK)
//            | (type EXP NAME (tparams NAME*) TBODY)
//            | (const EXP NAME TYPE_OR_DASH EXPR)
//            | (class EXP NAME (tparams NAME*) EXT (implements NAME*) MEMBER*)   (beyond Orin-B, ADR-0009/0019)
//            | (interface EXP NAME (tparams NAME*) EXT (imethod NAME (params (param NAME TYPE)*) RET)*)   (ADR-0019)
//            (a function type parameter with a bound is written NAME:BOUND, ADR-0019)
//   EXT     := - | NAME
//   MEMBER  := (cfield ACC NAME TYPE EXPR_OR_DASH) | (ctor (cparams (cparam PACC NAME TYPE)*) BLOCK)
//            | (method ACC KIND NAME (tparams NAME*) (params (param NAME TYPE)*) RET BLOCK)
//   ACC     := public | private        PACC := - | public | private        KIND := static | inst
//   EXP     := export | local
//   RET     := TYPE | -                       (- = no annotation)
//   TBODY   := (dalias TYPE) | (drecord (field NAME TYPE)*) | (dunion (variant NAME TYPE*)*)
//   TYPE    := NAME | (app NAME TYPE+) | (array TYPE) | (fn (p NAME TYPE)* TYPE)   e.g. Result<int, string[]> =
//                                                           (app Result int (array string))
//   BLOCK   := (block STMTLINE*)   each statement on its own line, indented 2 spaces deeper
//              than the line holding the enclosing construct; ")" ends the last line.
//   STMT    := (let@S MUT NAME TYPE_OR_DASH EXPR)          MUT := let | const
//            | (assign@S OP EXPR EXPR)                     OP := = += -= *= /= %=
//            | (expr@S EXPR) | (return@S) | (return@S EXPR)
//            | (if@S EXPR BLOCK ELSE)                      ELSE := - | STMT (sblock or if)
//            | (while@S EXPR BLOCK) | (for@S NAME EXPR BLOCK)
//            | (break@S) | (continue@S) | (sblock@S BLOCK)
//   EXPR    := (int@S N) | (str@S "escaped") | (bool@S true|false) | (ident@S NAME)
//            | (unary@S OP EXPR)                           OP := ! -
//            | (binary@S OP EXPR EXPR)                     OP := + - * / % == != < <= > >= && ||
//            | (call@S EXPR EXPR*) | (member@S EXPR NAME) | (index@S EXPR EXPR) | (try@S EXPR)
//            | (cond@S EXPR EXPR EXPR) | (arr@S EXPR*)
//            | (record@S NAME SPREAD (field NAME EXPR)*)   SPREAD := - | EXPR
//            | (new@S NAME [TYPE*] EXPR*) | (this@S)
//            | (arrow@S (p NAME TYPE_OR_DASH)* RET EXPR_OR_BLOCK)       (beyond Orin-B, ADR-0011)
//            | (match@S EXPR ARMLINE*)  each arm on its own line, indented 2 deeper:
//                  (arm PAT EXPR_OR_BLOCK)
//   PAT     := _ | (pident NAME) | (pvariant NAME PAT*) | (pint N) | (pstr "escaped") | (pbool B)
//   Contract clauses (beyond Orin-B, ADR-0012) appear only when present:
//            ITEM/MEMBER ... (contracts CLAUSE*) before the closing ")" of fn / type / class / ctor / method,
//            STMT := (contract@S KIND EXPR_OR_STR) before a loop       KIND := requires | ensures | invariant
//            | decreases | rule;  EXPR also has (binary@S ==> EXPR EXPR)
//   Built-in annotations (beyond Orin-B, ADR-0024) appear after the contracts, only when present:
//            (annotations (test@S) (deprecated@S "msg") (inline@S)) before the closing ")" of fn / type / class
//            / method / interface / imethod
//   S       := "@" start "-" end              byte offsets, half-open [start, end)
//
// Notes:
//  * Only statements and expressions carry spans. A parenthesised expression has no node
//    of its own: it dumps as the inner expression, with its span widened to include the
//    parentheses (this is what Stage 0 does; `((x))` takes the outermost pair).
//  * A negative literal is (unary@S - (int@S N)); the parser does not fold it.
//    Negative patterns are (pint -N).
//  * Strings are escaped: \\ \" \n \t \r, any other byte < 0x20 or >= 0x7f as \xHH (lowercase).
//  * Statement spans include the terminating `;`; block/if/while/for spans end at `}`.

import {
  Ident, Module, Item, ImportDecl, FunctionDecl, TypeDecl, TypeDeclBody, FieldDecl,
  VariantDecl, ConstDecl,
  TypeExpr, TypeExprKind, Block, Stmt, AssignOp, StmtKind, Expr, UnaryOp, BinaryOp,
  ExprKind, FieldInit, MatchArm, ArmBody, Pattern, PatternKind, InterfaceDecl, IfaceMethod, ClassDecl, ClassMember, CtorParam, Param,
  FnTyParam, ArrowParam, ArrowBody, ContractClause, Annotation, OxElement, OxAttr, OxChild
} from "../syntax";
import { Span } from "../diag";

export function dumpModule(m: Module): string {
  let lines: string[] = [];
  for (const it of m.items) {
    lines.push(dumpItem(it));
  }
  return lines.join("\n");
}

// ---------------------------------------------------------------------------
// Small helpers
// ---------------------------------------------------------------------------

function hex2(c: int): string {
  const d = "0123456789abcdef";
  return d.charAt((c / 16).toUsize()) + d.charAt((c % 16).toUsize());
}

function quote(s: string): string {
  let parts: string[] = ["\""];
  let i: usize = 0;
  while (i < s.length) {
    const c = s.charCodeAt(i);
    if (c == 34) {
      parts.push("\\\"");
    } else if (c == 92) {
      parts.push("\\\\");
    } else if (c == 10) {
      parts.push("\\n");
    } else if (c == 9) {
      parts.push("\\t");
    } else if (c == 13) {
      parts.push("\\r");
    } else if (c < 32 || c > 126) {
      parts.push("\\x" + hex2(c));
    } else {
      parts.push(s.charAt(i));
    }
    i += 1;
  }
  parts.push("\"");
  return parts.join("");
}

function spanStr(sp: Span): string {
  return "@" + sp.start.toString() + "-" + sp.end.toString();
}

function expWord(b: bool): string {
  if (b) {
    return "export";
  }
  return "local";
}

// " a b c" (empty string for no names)
function namesTail(ids: Ident[]): string {
  let s = "";
  for (const id of ids) {
    s += " " + id.name;
  }
  return s;
}

// " x y z" (empty string for none)
function joinTail(xs: string[]): string {
  if (xs.length == 0) {
    return "";
  }
  return " " + xs.join(" ");
}

// ---------------------------------------------------------------------------
// Items and types
// ---------------------------------------------------------------------------

function dumpItem(it: Item): string {
  return match (it) {
    IImport(d) => "(" + (d.provider ? "import-ox " : "import ") + quote(d.path) + namesTail(d.names) + ")",
    IReExport(d) => "(reexport " + quote(d.path) + namesTail(d.names) + ")",
    IFunction(f) => dumpFn(f),
    IType(t) => dumpTypeDecl(t),
    IConst(c) => dumpConst(c),
    IClass(c) => dumpClass(c),
    IInterface(k) => dumpInterface(k)
  };
}

function accWord(priv: bool): string {
  if (priv) {
    return "private";
  }
  return "public";
}

function dumpClass(c: ClassDecl): string {
  let parts: string[] = [];
  for (const m of c.members) {
    parts.push("\n  " + dumpMember(m));
  }
  const ext = match (c.ext) {
    Some(id) => id.name,
    None => "-"
  };
  return "(class " + expWord(c.exported) + " " + c.name.name + " (tparams" + tparamsTail(c.typeParams, c.bounds) + ") " + ext
    + " (implements" + namesTail(c.impls) + ")" + parts.join("") + contractsTail(c.contracts) + annotationsTail(c.annotations) + ")";
}

function dumpInterface(k: InterfaceDecl): string {
  let parts: string[] = [];
  for (const m of k.methods) {
    let ps: string[] = [];
    for (const p of m.params) {
      ps.push("(param " + p.name.name + " " + dumpType(p.ty) + ")");
    }
    parts.push("\n  (imethod " + m.name.name + " (params" + joinTail(ps) + ") " + optType(m.ret) + annotationsTail(m.annotations) + ")");
  }
  const ext = match (k.ext) {
    Some(id) => id.name,
    None => "-"
  };
  return "(interface " + expWord(k.exported) + " " + k.name.name + " (tparams" + namesTail(k.typeParams) + ") " + ext
    + parts.join("") + annotationsTail(k.annotations) + ")";
}

// Type parameter names, each followed by `:Bound` when it has a bound (ADR-0019).
function tparamsTail(ids: Ident[], bounds: Option<Ident>[]): string {
  let xs: string[] = [];
  let i: usize = 0;
  while (i < ids.length) {
    let t = ids[i].name;
    if (i < bounds.length && bounds[i].isSome()) {
      t += ":" + bounds[i].unwrap().name;
    }
    xs.push(t);
    i += 1;
  }
  return joinTail(xs);
}

function dumpCtorParam(p: CtorParam): string {
  let acc = "-";
  if (p.access == 1) {
    acc = "public";
  } else if (p.access == 2) {
    acc = "private";
  }
  return "(cparam " + acc + " " + p.name.name + " " + dumpType(p.ty) + ")";
}

function dumpMember(m: ClassMember): string {
  return match (m) {
    MField(f) => "(cfield " + accWord(f.priv) + " " + f.name.name + " " + dumpType(f.ty) + " " + optExpr(f.init, "  ") + annotationsTail(f.annotations) + ")",
    MCtor(c) => dumpCtor(c.params, c.body, c.contracts),
    MMethod(md) => dumpMethod(md.priv, md.isStatic, md.name, md.typeParams, md.params, md.ret, md.body, md.contracts, md.annotations)
  };
}

// ` (contracts (kind@S ..)..)`, or "" when there are none.
function contractsTail(cs: ContractClause[]): string {
  if (cs.length == 0) {
    return "";
  }
  let parts: string[] = [];
  for (const c of cs) {
    parts.push(dumpClause(c));
  }
  return " (contracts " + parts.join(" ") + ")";
}

// ` (annotations (test@S) (deprecated@S "msg") (inline@S))`, or "" when there are none.
function annotationsTail(as: Annotation[]): string {
  if (as.length == 0) {
    return "";
  }
  let parts: string[] = [];
  for (const a of as) {
    const t = match (a.kind) {
      ATest => "(test" + spanStr(a.span) + ")",
      ADeprecated => "(deprecated" + spanStr(a.span) + " " + quote(a.message) + ")",
      AInline => "(inline" + spanStr(a.span) + ")",
      ASealed => "(sealed" + spanStr(a.span) + ")",
      ACustom(id, args) => dumpCustomAnnotation(a, id, args),
      AAnnotation(ts) => "(annotation" + spanStr(a.span) + namesTail(ts) + ")"
    };
    parts.push(t);
  }
  return " (annotations " + parts.join(" ") + ")";
}

function dumpCustomAnnotation(a: Annotation, id: Ident, args: Expr[]): string {
  let xs: string[] = [];
  for (const e of args) {
    xs.push(dumpExpr(e, "  "));
  }
  return "(anno" + spanStr(a.span) + " " + id.name + joinTail(xs) + ")";
}

function dumpClause(c: ContractClause): string {
  const kind = match (c.kind) {
    CRequires => "requires",
    CEnsures => "ensures",
    CInvariant => "invariant",
    CDecreases => "decreases",
    CRule => "rule"
  };
  const arg = match (c.expr) {
    Some(e) => dumpExpr(e, "  "),
    None => quote(c.rule)
  };
  return "(" + kind + spanStr(c.span) + " " + arg + ")";
}

function dumpCtor(params: CtorParam[], body: Block, cs: ContractClause[]): string {
  let ps: string[] = [];
  for (const p of params) {
    ps.push(dumpCtorParam(p));
  }
  return "(ctor (cparams" + joinTail(ps) + ") " + dumpBlock(body, "  ") + contractsTail(cs) + ")";
}

function dumpMethod(priv: bool, isStatic: bool, name: Ident, tps: Ident[], params: Param[], ret: Option<TypeExpr>, body: Block, cs: ContractClause[], as: Annotation[]): string {
  let ps: string[] = [];
  for (const p of params) {
    ps.push("(param " + p.name.name + " " + dumpType(p.ty) + ")");
  }
  let kind = "inst";
  if (isStatic) {
    kind = "static";
  }
  return "(method " + accWord(priv) + " " + kind + " " + name.name + " (tparams" + namesTail(tps) + ") (params"
    + joinTail(ps) + ") " + optType(ret) + " " + dumpBlock(body, "  ") + contractsTail(cs) + annotationsTail(as) + ")";
}

function dumpFn(f: FunctionDecl): string {
  let ps: string[] = [];
  for (const p of f.params) {
    ps.push("(param " + p.name.name + " " + dumpType(p.ty) + ")");
  }
  return "(fn " + expWord(f.exported) + " " + f.name.name + " (tparams" + tparamsTail(f.typeParams, f.bounds) + ") (params"
    + joinTail(ps) + ") " + optType(f.ret) + " " + dumpBlock(f.body, "") + contractsTail(f.contracts) + annotationsTail(f.annotations) + ")";
}

function dumpTypeDecl(t: TypeDecl): string {
  return "(type " + expWord(t.exported) + " " + t.name.name + " (tparams" + namesTail(t.typeParams) + ") "
    + dumpTypeBody(t.body) + contractsTail(t.contracts) + annotationsTail(t.annotations) + ")";
}

function dumpTypeBody(b: TypeDeclBody): string {
  return match (b) {
    DAlias(t) => "(dalias " + dumpType(t) + ")",
    DRecord(fields) => dumpFields(fields),
    DUnion(variants) => dumpVariants(variants)
  };
}

function dumpFields(fields: FieldDecl[]): string {
  let parts: string[] = [];
  for (const f of fields) {
    parts.push("(field " + f.name.name + " " + dumpType(f.ty) + annotationsTail(f.annotations) + ")");
  }
  return "(drecord" + joinTail(parts) + ")";
}

function dumpVariants(variants: VariantDecl[]): string {
  let parts: string[] = [];
  for (const v of variants) {
    let tys: string[] = [];
    for (const t of v.payload) {
      tys.push(dumpType(t));
    }
    parts.push("(variant " + v.name.name + joinTail(tys) + ")");
  }
  return "(dunion" + joinTail(parts) + ")";
}

function dumpConst(c: ConstDecl): string {
  return "(const " + expWord(c.exported) + " " + c.name.name + " " + optType(c.ty) + " " + dumpExpr(c.value, "") + annotationsTail(c.annotations) + ")";
}

function dumpType(t: TypeExpr): string {
  return match (t.kind) {
    TNamed(id, args) => dumpNamed(id, args),
    TArray(el) => "(array " + dumpType(el) + ")",
    TFn(ps, ret) => dumpFnType(ps, ret)
  };
}

function dumpFnType(ps: FnTyParam[], ret: TypeExpr): string {
  let parts: string[] = [];
  for (const p of ps) {
    parts.push("(p " + p.name.name + " " + dumpType(p.ty) + ")");
  }
  return "(fn" + joinTail(parts) + " " + dumpType(ret) + ")";
}

function dumpNamed(id: Ident, args: TypeExpr[]): string {
  if (args.length == 0) {
    return id.name;
  }
  let parts: string[] = [];
  for (const a of args) {
    parts.push(dumpType(a));
  }
  return "(app " + id.name + " " + parts.join(" ") + ")";
}

function typesStr(ts: TypeExpr[]): string {
  let parts: string[] = [];
  for (const t of ts) {
    parts.push(dumpType(t));
  }
  return "[" + parts.join(" ") + "]";
}

function optType(o: Option<TypeExpr>): string {
  return match (o) {
    Some(t) => dumpType(t),
    None => "-"
  };
}

// ---------------------------------------------------------------------------
// Statements. `ind` is the indentation of the line the construct starts on.
// ---------------------------------------------------------------------------

function dumpBlock(b: Block, ind: string): string {
  const ind2 = ind + "  ";
  let parts: string[] = ["(block"];
  for (const s of b.stmts) {
    parts.push("\n" + ind2 + dumpStmt(s, ind2));
  }
  return parts.join("") + ")";
}

function assignStr(op: AssignOp): string {
  return match (op) {
    OpAssign => "=",
    OpAddAssign => "+=",
    OpSubAssign => "-=",
    OpMulAssign => "*=",
    OpDivAssign => "/=",
    OpRemAssign => "%="
  };
}

function mutWord(mutable: bool): string {
  if (mutable) {
    return "let";
  }
  return "const";
}

function dumpElse(els: Option<Stmt>, ind: string): string {
  return match (els) {
    Some(s) => dumpStmt(s, ind),
    None => "-"
  };
}

function dumpReturn(sp: string, v: Option<Expr>, ind: string): string {
  return match (v) {
    Some(e) => "(return" + sp + " " + dumpExpr(e, ind) + ")",
    None => "(return" + sp + ")"
  };
}

function dumpStmt(s: Stmt, ind: string): string {
  const sp = spanStr(s.span);
  return match (s.kind) {
    SLet(mutable, name, ty, init) => "(let" + sp + " " + mutWord(mutable) + " " + name.name + " " + optType(ty)
      + " " + dumpExpr(init, ind) + ")",
    SAssign(target, op, value) => "(assign" + sp + " " + assignStr(op) + " " + dumpExpr(target, ind) + " "
      + dumpExpr(value, ind) + ")",
    SExpr(e) => "(expr" + sp + " " + dumpExpr(e, ind) + ")",
    SReturn(v) => dumpReturn(sp, v, ind),
    SIf(c, th, els) => "(if" + sp + " " + dumpExpr(c, ind) + " " + dumpBlock(th, ind) + " " + dumpElse(els, ind) + ")",
    SWhile(c, body) => "(while" + sp + " " + dumpExpr(c, ind) + " " + dumpBlock(body, ind) + ")",
    SForOf(name, it, body) => "(for" + sp + " " + name.name + " " + dumpExpr(it, ind) + " " + dumpBlock(body, ind) + ")",
    SBreak => "(break" + sp + ")",
    SContinue => "(continue" + sp + ")",
    SBlock(b) => "(sblock" + sp + " " + dumpBlock(b, ind) + ")",
    SContract(c) => "(contract" + sp + " " + dumpClause(c) + ")"
  };
}

// ---------------------------------------------------------------------------
// Expressions
// ---------------------------------------------------------------------------

function unaryStr(op: UnaryOp): string {
  return match (op) {
    UNot => "!",
    UNeg => "-"
  };
}

function binaryStr(op: BinaryOp): string {
  return match (op) {
    BAdd => "+",
    BSub => "-",
    BMul => "*",
    BDiv => "/",
    BRem => "%",
    BEq => "==",
    BNe => "!=",
    BLt => "<",
    BLe => "<=",
    BGt => ">",
    BGe => ">=",
    BAnd => "&&",
    BOr => "||",
    BImplies => "==>"
  };
}

// " e1 e2" (empty string for none)
function exprsTail(xs: Expr[], ind: string): string {
  let parts: string[] = [];
  for (const x of xs) {
    parts.push(dumpExpr(x, ind));
  }
  return joinTail(parts);
}

function templateParts(parts: string[]): string {
  let out: string[] = [];
  for (const p of parts) {
    out.push(quote(p));
  }
  return "[" + out.join(" ") + "]";
}

// OX (ADR-0043, ADR-0044): `(ox@span name (attr name value)* child*)`; a fragment has the name `<>`, a spread attribute
// is `(spread expr)`, a named slot `(slot name child*)`.
function dumpOx(el: OxElement, ind: string): string {
  const nm = match (el.name) {
    Some(n) => n.name,
    None => "<>",
  };
  let out = "(ox" + spanStr(el.span) + " " + nm + (el.selfClosing ? " /" : "");
  for (const a of el.attrs) {
    const v = match (a.value) {
      JVStr(s) => quote(s),
      JVExpr(x) => dumpExpr(x, ind),
      JVTrue => "true",
      JVSpread(x) => dumpExpr(x, ind),
    };
    match (a.value) {
      JVSpread(_) => {
        out += " (spread " + v + ")";
      },
      _ => {
        out += " (attr " + a.name.name + " " + v + ")";
      },
    }
  }
  return out + dumpOxKids(el.children, ind) + ")";
}

function dumpOxKids(kids: OxChild[], ind: string): string {
  let out = "";
  for (const c of kids) {
    out += " " + match (c) {
      JText(t, _) => "(text " + quote(t) + ")",
      JExpr(x) => dumpExpr(x, ind),
      JElem(sub) => dumpOx(sub, ind),
      JSlot(n, ks, _) => "(slot " + n.name + dumpOxKids(ks, ind) + ")",
    };
  }
  return out;
}

function optExpr(o: Option<Expr>, ind: string): string {
  return match (o) {
    Some(e) => dumpExpr(e, ind),
    None => "-"
  };
}

function dumpExpr(e: Expr, ind: string): string {
  const sp = spanStr(e.span);
  return match (e.kind) {
    EInt(v) => "(int" + sp + " " + v.toString() + ")",
    EFloat(t) => "(float" + sp + " " + t + ")",
    EBigInt(v) => "(bigint" + sp + " " + v.toString() + ")",
    ETemplate(parts, xs) => "(template" + sp + " " + templateParts(parts) + exprsTail(xs, ind) + ")",
    EOx(el) => dumpOx(el, ind),
    EStr(s) => "(str" + sp + " " + quote(s) + ")",
    EBool(b) => "(bool" + sp + " " + b.toString() + ")",
    EIdent(id) => "(ident" + sp + " " + id.name + ")",
    EUnary(op, x) => "(unary" + sp + " " + unaryStr(op) + " " + dumpExpr(x, ind) + ")",
    EBinary(op, l, r) => "(binary" + sp + " " + binaryStr(op) + " " + dumpExpr(l, ind) + " " + dumpExpr(r, ind) + ")",
    ECall(f, args) => "(call" + sp + " " + dumpExpr(f, ind) + exprsTail(args, ind) + ")",
    EMember(x, id) => "(member" + sp + " " + dumpExpr(x, ind) + " " + id.name + ")",
    EIndex(x, i) => "(index" + sp + " " + dumpExpr(x, ind) + " " + dumpExpr(i, ind) + ")",
    ETry(x) => "(try" + sp + " " + dumpExpr(x, ind) + ")",
    ECond(c, a, b) => "(cond" + sp + " " + dumpExpr(c, ind) + " " + dumpExpr(a, ind) + " " + dumpExpr(b, ind) + ")",
    EArray(xs) => "(arr" + sp + exprsTail(xs, ind) + ")",
    ERecord(id, spread, fields) => dumpRecord(sp, id, spread, fields, ind),
    ETyApp(id, targs) => "(tyapp" + sp + " " + id.name + " " + typesStr(targs) + ")",
    EMethodT(x, id, targs) => "(methodt" + sp + " " + dumpExpr(x, ind) + " " + id.name + " " + typesStr(targs) + ")",
    ERecordT(id, targs, spread, fields) => dumpRecord(sp, id, spread, fields, ind) + " ; " + typesStr(targs),
    EMatch(scrut, arms) => dumpMatch(sp, scrut, arms, ind),
    ENew(id, targs, args) => "(new" + sp + " " + id.name + " " + typesStr(targs) + exprsTail(args, ind) + ")",
    EThis => "(this" + sp + ")",
    EArrow(ps, ret, body) => dumpArrow(sp, ps, ret, body, ind)
  };
}

function dumpArrow(sp: string, ps: ArrowParam[], ret: Option<TypeExpr>, body: ArrowBody, ind: string): string {
  let parts: string[] = [];
  for (const p of ps) {
    parts.push("(p " + p.name.name + " " + optType(p.ty) + ")");
  }
  const b = match (body) {
    AExpr(e) => dumpExpr(e, ind),
    ABlock(blk) => dumpBlock(blk, ind)
  };
  return "(arrow" + sp + joinTail(parts) + " " + optType(ret) + " " + b + ")";
}

function dumpRecord(sp: string, id: Ident, spread: Option<Expr>, fields: FieldInit[], ind: string): string {
  let parts: string[] = [];
  for (const f of fields) {
    parts.push("(field " + f.name.name + " " + dumpExpr(f.value, ind) + ")");
  }
  return "(record" + sp + " " + id.name + " " + optExpr(spread, ind) + joinTail(parts) + ")";
}

function dumpMatch(sp: string, scrut: Expr, arms: MatchArm[], ind: string): string {
  const ind2 = ind + "  ";
  let parts: string[] = ["(match" + sp + " " + dumpExpr(scrut, ind)];
  for (const a of arms) {
    parts.push("\n" + ind2 + "(arm " + dumpPat(a.pattern) + " " + dumpArmBody(a.body, ind2) + ")");
  }
  return parts.join("") + ")";
}

function dumpArmBody(b: ArmBody, ind: string): string {
  return match (b) {
    BExpr(e) => dumpExpr(e, ind),
    BBlock(blk) => dumpBlock(blk, ind)
  };
}

function dumpPat(p: Pattern): string {
  return match (p.kind) {
    PWildcard => "_",
    PIdent(id) => "(pident " + id.name + ")",
    PVariant(id, subs) => dumpVariantPat(id, subs),
    PInt(v) => "(pint " + v.toString() + ")",
    PStr(s) => "(pstr " + quote(s) + ")",
    PBool(b) => "(pbool " + b.toString() + ")"
  };
}

function dumpVariantPat(id: Ident, subs: Pattern[]): string {
  let parts: string[] = [];
  for (const s of subs) {
    parts.push(dumpPat(s));
  }
  return "(pvariant " + id.name + joinTail(parts) + ")";
}
