type Registry = { name: string; ids: Map<string, int>; count: int; };

function main(): void {
  let r = Registry { name: "main", ids: new Map<string, int>(), count: 0 };
  r.ids.set("alpha", 1);
  r.ids.set("beta", 2);
  r.count += 2;
  console.log(r.ids.size.toString() + " " + r.count.toString());
  const copy = r;
  r.ids.set("gamma", 3);
  console.log(copy.ids.size.toString() + " " + r.ids.size.toString());
  console.log(r.ids.delete("alpha").toString());
  console.log(r.ids.keys().join(","));
  console.log(copy.ids.keys().join(","));

  let shards: Map<int, int>[] = [];
  let i = 0;
  while (i < 4) {
    shards.push(new Map<int, int>());
    i += 1;
  }
  i = 0;
  while (i < 20) {
    shards[(i % 4).toUsize()].set(i, i * 10);
    i += 1;
  }
  console.log(shards[0].size.toString() + " " + shards[3].size.toString());
  console.log(shards[2].get(6).unwrap().toString());
  console.log(shards[1].keys().map(k => k.toString()).join(","));
}
