type Expr = Lit(int) | Add(Expr, Expr) | Mul(Expr, Expr) | Neg(Expr);

function evalExpr(e: Expr): int {
  return match (e) {
    Lit(n) => n,
    Add(a, b) => evalExpr(a) + evalExpr(b),
    Mul(a, b) => evalExpr(a) * evalExpr(b),
    Neg(a) => 0 - evalExpr(a),
  };
}

function showExpr(e: Expr): string {
  return match (e) {
    Lit(n) => n.toString(),
    Add(a, b) => "(" + showExpr(a) + " + " + showExpr(b) + ")",
    Mul(a, b) => "(" + showExpr(a) + " * " + showExpr(b) + ")",
    Neg(a) => "-" + showExpr(a),
  };
}

function main(): void {
  const e = Add(Lit(2), Mul(Lit(3), Neg(Lit(4))));
  console.log(showExpr(e));
  console.log(evalExpr(e).toString());
  console.log(evalExpr(Add(Lit(1), Lit(2))).toString());
}
