// Command-line parsing of the mutation checks. Mirrors the argparse interface of tools/mutate_std.py and
// tools/mutate_ox.py (the same flags and messages): `--opt=value`, `-jN`, unambiguous prefixes of long options
// (`--orin`), the last occurrence wins, a value that starts with `-` is not accepted as the value of the previous option,
// errors exit with status 2 and print `usage` and `error:`. One addition: `--root DIR` (the repository root; the Python
// scripts derive it from the location of the script, this program from the flag, default: the current directory).
// Pure functions: tests/cli_test.or.

import { strip, reprStr } from "./text";

export type OptDef = { name: string; valued: bool; };

export type Parsed<T> = { ok: bool; value: T; error: string; help: bool; };

// int(v) of Python for the values of -j: optional surrounding blanks, optional sign, digits.
export function parseIntLoose(v: string): Option<int> {
  const t = strip(v);
  let k: usize = 0;
  if (t.length > 0 && (t.charCodeAt(0) == 43 || t.charCodeAt(0) == 45)) {
    k = 1;
  }
  if (k >= t.length) {
    return None;
  }
  let i = k;
  while (i < t.length) {
    const c = t.charCodeAt(i);
    if (c < 48 || c > 57) {
      return None;
    }
    i += 1;
  }
  return parseInt(t.charCodeAt(0) == 43 ? t.substring(1, t.length) : t);
}

function fail<T>(init: T, msg: string): Parsed<T> {
  return Parsed { ok: false, value: init, error: msg, help: false };
}

// The full name of a long option given as `--x...` (exact or an unambiguous prefix), or the error text.
function resolveLong(defs: OptDef[], given: string): Result<string, string> {
  for (const d of defs) {
    if (d.name == given) {
      return Ok(d.name);
    }
  }
  let hits: string[] = [];
  for (const d of defs) {
    if (d.name.startsWith(given)) {
      hits.push(d.name);
    }
  }
  if (hits.length == 1) {
    return Ok(hits[0]);
  }
  if (hits.length > 1) {
    return Err("ambiguous option: " + given + " could match " + hits.join(", "));
  }
  return Err("unrecognized arguments: " + given);
}

function takesValue(defs: OptDef[], name: string): bool {
  for (const d of defs) {
    if (d.name == name) {
      return d.valued;
    }
  }
  return false;
}

// argparse refuses a value that looks like an option (starts with `-`) unless it is a negative number.
function looksLikeOption(v: string): bool {
  if (v.length < 2 || v.charCodeAt(0) != 45) {
    return false;
  }
  return parseInt(v).isNone();
}

function displayName(name: string): string {
  return name == "--jobs" ? "-j/--jobs" : name;
}

// Parses `argv` against the long options `defs` (`-h` and `-j` are the short forms of `--help` and `--jobs`). Every
// option is handed to `apply(value so far, long name, value)` in order ("" for a flag), which returns the new value or
// the message of an argparse-style error. `-h` stops the parse with `help` set, as argparse prints the help at once.
export function parseWith<T>(argv: string[], defs: OptDef[], init: T, apply: (o: T, name: string, value: string) => Result<T, string>): Parsed<T> {
  let o = init;
  let unknown: string[] = [];
  let i: usize = 0;
  while (i < argv.length) {
    const a = argv[i];
    i += 1;
    let name = "";
    let inline = "";
    let hasInline = false;
    if (a.startsWith("--") && a.length > 2) {
      const eq = a.indexOf("=");
      const given = eq.isSome() ? a.substring(0, eq.unwrap()) : a;
      const r = resolveLong(defs, given);
      if (r.isErr()) {
        if (r.unwrapErr().startsWith("ambiguous")) {
          return fail(init, r.unwrapErr());
        }
        unknown.push(a);
        continue;
      }
      name = r.unwrap();
      if (eq.isSome()) {
        if (!takesValue(defs, name)) {
          return fail(init, "argument " + displayName(name) + ": ignored explicit argument " + reprStr(a.substring(eq.unwrap() + 1, a.length)));
        }
        hasInline = true;
        inline = a.substring(eq.unwrap() + 1, a.length);
      }
    } else if (a == "-h") {
      return Parsed { ok: true, value: o, error: "", help: true };
    } else if (a.startsWith("-j")) {
      name = "--jobs";
      if (a.length > 2) {
        hasInline = true;
        inline = a.substring(2, a.length);
        if (inline.startsWith("=")) {
          inline = inline.substring(1, inline.length);
        }
      }
    } else {
      unknown.push(a);
      continue;
    }
    if (name == "--help") {
      return Parsed { ok: true, value: o, error: "", help: true };
    }
    let value = inline;
    if (takesValue(defs, name) && !hasInline) {
      if (i >= argv.length || looksLikeOption(argv[i])) {
        return fail(init, "argument " + displayName(name) + ": expected one argument");
      }
      value = argv[i];
      i += 1;
    }
    const r = apply(o, name, value);
    if (r.isErr()) {
      return fail(init, r.unwrapErr());
    }
    o = r.unwrap();
  }
  if (unknown.length > 0) {
    return fail(init, "unrecognized arguments: " + unknown.join(" "));
  }
  return Parsed { ok: true, value: o, error: "", help: false };
}

// The `-j/--jobs` value: argparse `type=int`.
export function jobsValue(value: string): Result<int, string> {
  const n = parseIntLoose(value);
  if (n.isNone()) {
    return Err("argument -j/--jobs: invalid int value: " + reprStr(value));
  }
  return Ok(n.unwrap() < 1 ? 1 : n.unwrap());
}

// ------------------------------------------------------------------------------------------------ mutation std

export type StdOptions = {
  orinc: string;
  target: string;     // --module: "" (every module except net), a module name, or net
  list: bool;
  shardI: usize;      // --shard I/N
  shardN: usize;
  jobs: int;          // 0: not given (use $ORIN_JOBS, else the CPU count)
  root: string;
};

export function defaultStdOptions(): StdOptions {
  return StdOptions { orinc: "build/bootstrap/orin2", target: "", list: false, shardI: 1, shardN: 1, jobs: 0, root: "." };
}

export function stdUsage(): string {
  return "usage: orin-mutation std [-h] [--orinc ORINC] [--module MODULE] [--list]\n"
  + "                         [--shard SHARD] [-j JOBS] [--root ROOT]";
}

export function stdHelp(): string {
  return stdUsage() + "\n\n"
  + "options:\n"
  + "  -h, --help       show this help message and exit\n"
  + "  --orinc ORINC\n"
  + "  --module MODULE\n"
  + "  --list\n"
  + "  --shard SHARD    I/N: run only the I-th of N interleaved parts of the\n"
  + "                   selected mutants (CI matrix)\n"
  + "  -j, --jobs JOBS  parallel cases (default: $ORIN_JOBS, else the CPU count; 1\n"
  + "                   = sequential)\n"
  + "  --root ROOT      repository root holding library/, tests/ and runtime/ (default: the current directory)";
}

function stdDefs(): OptDef[] {
  return [
    OptDef { name: "--help", valued: false }, OptDef { name: "--orinc", valued: true }, OptDef { name: "--module", valued: true },
    OptDef { name: "--list", valued: false }, OptDef { name: "--shard", valued: true }, OptDef { name: "--jobs", valued: true },
    OptDef { name: "--root", valued: true }
  ];
}

// `--shard I/N` (parse_shard of tools/mutate_std.py); the two numbers, or the error text.
export function parseShard(text: string): Result<usize[], string> {
  const parts = text.split("/");
  if (parts.length != 2) {
    return Err("argument --shard: --shard expects I/N, for example 2/3");
  }
  const a = parseIntLoose(parts[0]);
  const b = parseIntLoose(parts[1]);
  if (a.isNone() || b.isNone()) {
    return Err("argument --shard: --shard expects I/N, for example 2/3");
  }
  if (a.unwrap() < 1 || a.unwrap() > b.unwrap()) {
    return Err("argument --shard: --shard I/N needs 1 <= I <= N");
  }
  return Ok([a.unwrap().toUsize(), b.unwrap().toUsize()]);
}

function applyStd(o: StdOptions, name: string, value: string): Result<StdOptions, string> {
  if (name == "--orinc") {
    return Ok(StdOptions { ...o, orinc: value });
  }
  if (name == "--module") {
    return Ok(StdOptions { ...o, target: value });
  }
  if (name == "--list") {
    return Ok(StdOptions { ...o, list: true });
  }
  if (name == "--root") {
    return Ok(StdOptions { ...o, root: value });
  }
  if (name == "--shard") {
    const s = parseShard(value);
    if (s.isErr()) {
      return Err(s.unwrapErr());
    }
    return Ok(StdOptions { ...o, shardI: s.unwrap()[0], shardN: s.unwrap()[1] });
  }
  const j = jobsValue(value);
  if (j.isErr()) {
    return Err(j.unwrapErr());
  }
  return Ok(StdOptions { ...o, jobs: j.unwrap() });
}

export function parseStdArgs(argv: string[]): Parsed<StdOptions> {
  return parseWith(argv, stdDefs(), defaultStdOptions(), applyStd);
}

// ------------------------------------------------------------------------------------------------- mutation ox

export type OxOptions = {
  orinc: string;
  cc: string;         // "": not given ($CC, else cc)
  list: bool;
  only: string;
  jobs: int;
  root: string;
};

export function defaultOxOptions(): OxOptions {
  return OxOptions { orinc: "build/dev/orin", cc: "", list: false, only: "", jobs: 0, root: "." };
}

export function oxUsage(): string {
  return "usage: orin-mutation ox [-h] [--orinc ORINC] [--cc CC] [--list] [--only ONLY]\n"
  + "                        [-j JOBS] [--root ROOT]";
}

export function oxHelp(): string {
  return oxUsage() + "\n\n"
  + "Mutation check for the OX part of the compiler (ADR-0043, ADR-0044).\n\n"
  + "Each mutant is a small, deliberately wrong change of the OX lexer, parser or checker (compiler/syntax/lexer.or,\n"
  + "parser.or, compiler/check/ox.or, expr.or, stmt.or): a provider rule that is ignored (static encoding, attribute rules,\n"
  + "void and raw-text elements, presence attributes), a value that is not encoded, a sealed record that can be built,\n"
  + "attributes evaluated out of source order, broken whitespace rules, ... The\n"
  + "compiler sources are copied to build/mutate_ox/<mutant>/, the mutation is applied, the mutated compiler is built (one\n"
  + "self-compile by --orinc, then cc -O1) and the OX conformance tests (`tests/next/{run,errors}/ox_*`) are run with it.\n"
  + "A mutant is killed when a test fails (or the mutated compiler does not build). Every mutant must be killed.\n\n"
  + "Usage: tools/mutation.sh ox [--orinc build/dev/orin] [--list] [--only NAME[,NAME]] [-j N]\n"
  + "A mutant costs one compiler build (about a minute), so -j 2 on a 4-CPU machine.\n"
  + "Exit status 1 if any mutant survives.\n\n"
  + "options:\n"
  + "  -h, --help       show this help message and exit\n"
  + "  --orinc ORINC\n"
  + "  --cc CC\n"
  + "  --list\n"
  + "  --only ONLY\n"
  + "  -j, --jobs JOBS  parallel cases (default: $ORIN_JOBS, else the CPU count; 1\n"
  + "                   = sequential)\n"
  + "  --root ROOT      repository root holding compiler/, tests/ and runtime/ (default: the current directory)";
}

function oxDefs(): OptDef[] {
  return [
    OptDef { name: "--help", valued: false }, OptDef { name: "--orinc", valued: true }, OptDef { name: "--cc", valued: true },
    OptDef { name: "--list", valued: false }, OptDef { name: "--only", valued: true }, OptDef { name: "--jobs", valued: true },
    OptDef { name: "--root", valued: true }
  ];
}

function applyOx(o: OxOptions, name: string, value: string): Result<OxOptions, string> {
  if (name == "--orinc") {
    return Ok(OxOptions { ...o, orinc: value });
  }
  if (name == "--cc") {
    return Ok(OxOptions { ...o, cc: value });
  }
  if (name == "--list") {
    return Ok(OxOptions { ...o, list: true });
  }
  if (name == "--only") {
    return Ok(OxOptions { ...o, only: value });
  }
  if (name == "--root") {
    return Ok(OxOptions { ...o, root: value });
  }
  const j = jobsValue(value);
  if (j.isErr()) {
    return Err(j.unwrapErr());
  }
  return Ok(OxOptions { ...o, jobs: j.unwrap() });
}

export function parseOxArgs(argv: string[]): Parsed<OxOptions> {
  return parseWith(argv, oxDefs(), defaultOxOptions(), applyOx);
}
