// Field initializers; the constructor may override them with leading `this.f = e;` statements.
class Config {
  name: string = "default";
  retries: int = 3;
  verbose: bool = false;
  tags: string[] = [];
  constructor() {}
  describe(): string {
    return this.name + ":" + this.retries.toString() + ":" + this.verbose.toString() + ":"
      + this.tags.length.toString();
  }
}

class Named {
  name: string = "anon";
  count: int = 1;
  constructor(name: string) {
    this.name = name;
  }
  describe(): string {
    return this.name + this.count.toString();
  }
}

class Implicit {
  a: int = 4;
  b: int = 5;
  sum(): int {
    return this.a + this.b;
  }
}

function main(): void {
  const c = new Config();
  console.log(c.describe());
  console.log(new Named("bob").describe());
  console.log(new Implicit().sum().toString());
}
