// `orin test` must report this test as FAILED (a trap): a parser validates its limits in every build (a parser
// with a zero header-line limit could never make progress).
import { HttpLimits, RequestParser } from "std:http";

@Test
function parserConstructorTrapsOnZeroLimits(): void {
  const l = HttpLimits { maxStartLine: 0, maxHeaderCount: 0, maxHeaderLine: 0, maxHeaderBytes: 0, maxChunkLine: 0, maxBody: 0 };
  const p = new RequestParser(l);
  p.isIdle();
}
