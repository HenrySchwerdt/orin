// `orin test` must report this test as FAILED (a trap): a piece of a pool that lends a graph (ADR-0049 row 13a) indexes out of
// bounds, and the pool ends with the piece's own message, `index out of bounds`, as the sequential path does.
import { forkJoinLent } from "std:task";

type Rec = { name: string; xs: int[]; };

@Test
function pieceTrapReachesTheCaller(): void {
  let recs: Rec[] = [];
  let i = 0;
  while (i < 64) {
    recs.push(Rec { name: "r" + i.toString(), xs: [i, i + 1] });
    i += 1;
  }
  const rs = forkJoinLent(recs, 16, 4, k => recs[k * 4].xs[k == 9 ? 5 : 1] + recs[k * 4 + 3].name.length.toInt());
  rs.length;
}
