// OX (ADR-0043): HTML elements, static and dynamic attributes, text whitespace rules, entities, escaping, fragments,
// void elements, nested elements in one buffer.
import { Html, render } from "std:html";
import ox from "std:html";

function main(): void {
  const name = "<b>Tom</b> & \"Jerry\" 'n";
  const n = 42;
  const big: u64 = 18446744073709551615;
  const ratio = 0.5;
  const on = true;
  const off = false;
  // text: lines trimmed, line breaks collapsed to one space, entities decoded then re-escaped
  const a = <p class="intro" id="p1">
    Hello,   {name}!
    Tom &amp; Jerry &lt;3 &copy; &#169; &#xA9; &unknown; &nbsp;end
  </p>;
  console.log(render(a));
  // dynamic attributes: string (escaped), numbers, bool (present / absent), bare name
  const b = <input type="text" value={name} size={n} max={big} step={ratio} required disabled={on} hidden={off} />;
  console.log(render(b));
  // a string literal in braces is static (escaped at compile time); an empty `{}` and a comment are no child
  const c = <div title={"a<b"}>{"x & y"}{}{/* nothing */}</div>;
  console.log(render(c));
  // fragments and nesting: one buffer for the whole tree
  const d = <><ul><li>one</li><li>two {n}</li></ul><hr /><br/></>;
  console.log(render(d));
  // custom elements, data- and aria- attributes, self-closing non-void element
  const e = <my-widget data-id={n} aria-label="close &amp; go" data-q='say "hi"'><span /></my-widget>;
  console.log(render(e));
  // whitespace-only text between tags on separate lines disappears; on one line it is kept
  const f = <div>
    <b>x</b>
    <i>y</i> <u>z</u>
  </div>;
  console.log(render(f));
  // OX as a value: Html children, Html[] children, conditional
  const items = ["a", "b<", "c"];
  const g = <ol>{items.map(i => <li>{i}</li>)}{on ? <li>yes</li> : <></>}{a}</ol>;
  console.log(render(g));
  // URL attributes: a computed value is sanitised (unsafe schemes replaced) and escaped; other attributes only escaped
  const urls = ["/item/1?a=1&b=2", "https://x.org/a", "javascript:alert(1)", " JaVaScRiPt:x", "data:text/html,<b>",
      "mailto:a@b.c", "x/y:z"];
  for (const u of urls) {
    console.log(render(<p><a href={u} title={u}>link</a><img src={u} /><form action={u}></form></p>));
  }
  // raw text elements keep static text unescaped
  const h = <script>{"if (a < b && c) { go(); }"}</script>;
  console.log(render(h));
  // OX next to the less-than operator and generics
  const lt = n < 50;
  const opt: Option<int> = Some(1);
  console.log(`${lt} ${opt.unwrapOr(0)}`);
}
