import { parse, pretty, stringify } from "std:json";

function main(): void {
  const j = parse("{\"a\":[1,2,{\"b\":[]}],\"c\":{},\"d\":\"x\"}").unwrap();
  console.log(pretty(j, 2));
  console.log(pretty(j, 0));
  console.log(pretty(parse("[]").unwrap(), 4));
  console.log(pretty(parse("[[1],[2,3]]").unwrap(), 3));
  console.log(pretty(parse("7").unwrap(), 2));
}
