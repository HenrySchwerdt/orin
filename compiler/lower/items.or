// Flat item stream used while lowering, and its conversion to basic blocks.
// An item is an instruction, a block label, a terminator (targets are label ids) or a local
// declaration. `buildBlocks` splits the stream into blocks, drops unreachable code and
// renumbers labels to block indices.

import { Instr, Terminator, MType, MBlock, SwitchCase } from "../mir";

export type Item = IxI(Instr) | IxL(usize) | IxT(Terminator) | IxD(usize, MType);

type Raw = { label: usize; instrs: Instr[]; term: Terminator; };

function switchTargets(cases: SwitchCase[], d: usize): usize[] {
  let out: usize[] = [];
  for (const k of cases) {
    out.push(k.target);
  }
  out.push(d);
  return out;
}

function succs(t: Terminator): usize[] {
  return match (t) {
    TGoto(a) => [a],
    TBranch(_, a, b) => [a, b],
    TSwitch(_, cases, d) => switchTargets(cases, d),
    TReturn(_) => [],
    TTrap(_) => []
  };
}

function mapCases(cases: SwitchCase[], f: usize[], idxOf: usize[]): SwitchCase[] {
  let out: SwitchCase[] = [];
  for (const k of cases) {
    out.push(SwitchCase { value: k.value, target: f[idxOf[k.target]] });
  }
  return out;
}

function remap(t: Terminator, f: usize[], idxOf: usize[]): Terminator {
  return match (t) {
    TGoto(a) => TGoto(f[idxOf[a]]),
    TBranch(c, a, b) => TBranch(c, f[idxOf[a]], f[idxOf[b]]),
    TSwitch(o, cases, d) => TSwitch(o, mapCases(cases, f, idxOf), f[idxOf[d]]),
    TReturn(o) => TReturn(o),
    TTrap(m) => TTrap(m)
  };
}

export function buildBlocks(items: Item[], nLabels: usize): MBlock[] {
  let raws: Raw[] = [];
  let cur: Instr[] = [];
  let curLabel: usize = 0;
  let open = false;
  for (const it of items) {
    match (it) {
      IxL(l) => {
        if (open) {
          raws.push(Raw { label: curLabel, instrs: cur, term: TGoto(l) });
        }
        cur = [];
        curLabel = l;
        open = true;
      },
      IxI(i) => {
        if (open) {
          cur.push(i);
        }
      },
      IxT(t) => {
        if (open) {
          raws.push(Raw { label: curLabel, instrs: cur, term: t });
          cur = [];
          open = false;
        }
      },
      IxD(_, _) => {}
    }
  }
  const n = raws.length;
  let idxOf: usize[] = [];
  let i: usize = 0;
  while (i < nLabels) {
    idxOf.push(n);
    i += 1;
  }
  i = 0;
  while (i < n) {
    idxOf[raws[i].label] = i;
    i += 1;
  }
  let reach: bool[] = [];
  i = 0;
  while (i < n) {
    reach.push(false);
    i += 1;
  }
  let stack: usize[] = [0];
  reach[0] = true;
  while (stack.length > 0) {
    const b = stack.pop().unwrap();
    for (const l of succs(raws[b].term)) {
      const t = idxOf[l];
      if (!reach[t]) {
        reach[t] = true;
        stack.push(t);
      }
    }
  }
  let newIdx: usize[] = [];
  let k: usize = 0;
  i = 0;
  while (i < n) {
    newIdx.push(k);
    if (reach[i]) {
      k += 1;
    }
    i += 1;
  }
  let out: MBlock[] = [];
  i = 0;
  while (i < n) {
    if (reach[i]) {
      out.push(MBlock { instrs: raws[i].instrs, term: remap(raws[i].term, newIdx, idxOf) });
    }
    i += 1;
  }
  return out;
}
