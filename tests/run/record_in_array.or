type Item = { name: string; qty: int; };

function main(): void {
  let items = [Item { name: "a", qty: 1 }, Item { name: "b", qty: 2 }];
  items[1].qty = 20;
  items[0].qty += 5;
  items.push(Item { name: "c", qty: 3 });
  const snap = items;
  items[2].qty = 30;
  for (const it of items) {
    console.log(it.name + "=" + it.qty.toString());
  }
  console.log(snap[2].qty.toString());
  let total = 0;
  for (const it of snap) {
    total += it.qty;
  }
  console.log(total.toString());
}
