// Explicit conversions between every pair of integer types (and to float); each one that can fail traps
// (see the int_trap_conv_* tests); here every value fits.
function main(): void {
  const s8: i8 = -100;
  const s16: i16 = -30000;
  const s32: i32 = -2000000000;
  const s64: i64 = -9000000000000000000;
  const ssz: isize = -5;
  const u8v: u8 = 200;
  const u16v: u16 = 60000;
  const u32v: u32 = 4000000000;
  const u64v: u64 = 18000000000000000000;
  const usz: usize = 77;

  // widening and same-width
  console.log(s8.toI16().toString());
  console.log(s8.toI32().toString());
  console.log(s8.toI64().toString());
  console.log(s8.toIsize().toString());
  console.log(s16.toI32().toString());
  console.log(s32.toI64().toString());
  console.log(s64.toIsize().toString());
  console.log(ssz.toI64().toString());
  console.log(ssz.toInt().toString());
  console.log(u8v.toU16().toString());
  console.log(u8v.toU32().toString());
  console.log(u8v.toU64().toString());
  console.log(u8v.toUsize().toString());
  console.log(u8v.toI16().toString());
  console.log(u8v.toI32().toString());
  console.log(u8v.toI64().toString());
  console.log(u16v.toI32().toString());
  console.log(u32v.toI64().toString());
  console.log(u32v.toU64().toString());
  console.log(u64v.toUsize().toString());
  console.log(usz.toU64().toString());
  console.log(usz.toInt().toString());
  console.log(usz.toI64().toString());

  // narrowing: the value fits
  console.log(s64.toString());
  console.log((300).toI16().toString());
  console.log((-128).toI8().toString());
  console.log((255).toU8().toString());
  console.log((65535).toU16().toString());
  console.log((4294967295).toU32().toString());
  console.log((2147483647).toI32().toString());
  console.log(u32v.toU32().toString());
  const small: u64 = 9223372036854775807;
  console.log(small.toI64().toString());
  const tiny: u64 = 7;
  console.log(tiny.toU8().toString());
  console.log(tiny.toI8().toString());

  // to float
  console.log(s32.toFloat().toString());
  console.log(u32v.toFloat().toString());
  console.log(u64v.toFloat().toString());
  console.log(u8v.toF32().toString());
  console.log(s8.toFloat().toString());
}
