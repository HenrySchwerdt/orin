// error: E0481
// A task body cannot capture the Scope it is spawned in: the scope belongs to the task that opened it.
import { scopeDo, spawn } from "std:task";

function main(): void {
  scopeDo(s => {
    const outer = spawn(s, () => {
      const inner = spawn(s, () => 1);
      return inner.join();
    });
    console.log(outer.join().toString());
  });
}
