// Bytes <-> string conversion of a 1 MiB buffer, 40 round trips: std:bytes `bytesFromString` (string -> u8[]) and
// `toRawString` (u8[] -> string), one byte per character. Go converts with []byte(s) / string(b); C widens each byte to a
// 64-bit slot like Orin's u8[] (an Orin u8 array element occupies 8 bytes) and narrows it back.
import { Bytes, bytesFromString } from "std:bytes";

function main(): void {
  let s = "";
  let i = 0;
  while (i < 65536) {
    s += "0123456789abcdef";
    i += 1;
  }
  let total: int = 0;
  let round = 0;
  while (round < 40) {
    const b = bytesFromString(s);
    const t = b.toRawString();
    total += t.length.toInt() + t.charCodeAt((round * 7919).toUsize()) + b.at(round.toUsize()).toInt();
    round += 1;
  }
  console.log("len " + s.length.toString());
  console.log("total " + total.toString());
}
