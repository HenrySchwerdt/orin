type Box<T> = { value: T; };
type Pair<A, B> = { first: A; second: B; };

function box<T>(x: T): Box<T> {
  return Box { value: x };
}

function unbox<T>(b: Box<T>): T {
  return b.value;
}

function pairUp<A, B>(a: A, b: B): Pair<A, B> {
  return Pair { first: a, second: b };
}

function main(): void {
  console.log(unbox(box(1)).toString());
  console.log(unbox(box("s")));
  console.log(unbox(box(true)).toString());
  console.log(unbox(box([1, 2])).length.toString());
  console.log(unbox(unbox(box(box(8)))).toString());
  const p1 = pairUp(1, "a");
  const p2 = pairUp("a", 1);
  const p3 = pairUp(1, "b");
  const p4 = pairUp(box(1), box("c"));
  console.log(p1.first.toString() + p1.second);
  console.log(p2.first + p2.second.toString());
  console.log(p3.first.toString() + p3.second);
  console.log(p4.first.value.toString() + p4.second.value);
  const bs: Box<int>[] = [box(1), box(2), box(3)];
  let total = 0;
  for (const b of bs) {
    total += b.value;
  }
  console.log(total.toString());
}
