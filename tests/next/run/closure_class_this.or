class Account {
  private balance: int = 0;
  constructor(public owner: string, private fee: int) {}
  deposit(n: int): void {
    this.balance += n;
  }
  reader(): () => int {
    return () => this.balance;
  }
  withFee(): (x: int) => int {
    return x => x - this.fee;
  }
  label(): () => string {
    return () => this.owner + ":" + this.balance.toString();
  }
}

function main(): void {
  let acc = new Account("zed", 2);
  acc.deposit(50);
  const read = acc.reader();
  const net = acc.withFee();
  const label = acc.label();
  acc.deposit(1000);
  console.log(read().toString() + " " + net(10).toString() + " " + label());
  console.log(acc.reader()().toString());
  const accounts = [new Account("a", 1), new Account("b", 3)];
  const fees = accounts.map(a => a.withFee()(100));
  console.log(fees[0].toString() + " " + fees[1].toString());
}
