function main(): void {
  const a = "a,b,c".split(",");
  console.log(a.length.toString());
  console.log(a.join("-"));
  const b = "a,,b".split(",");
  console.log(b.length.toString());
  console.log("[" + b[1] + "]");
  const c = "one::two::three".split("::");
  console.log(c.length.toString());
  console.log(c[2]);
  const d = "abc".split(",");
  console.log(d.length.toString());
  console.log(d[0]);
  const e = "x y z".split(" ");
  console.log(e.join("+"));
}
