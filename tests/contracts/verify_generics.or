// Inputs for tools/test_verify_contracts.py: generic functions and classes are checked once, abstractly (ADR-0035): a type
// parameter T is an opaque value, so only what does not look inside a T can be proved (lengths, positions, order of
// operations). A call of a generic function from outside is not modelled.
// expect: copy loop-invariant VERIFIED
// expect: copy bounds VERIFIED
// expect: copy loop-invariant VERIFIED
// expect: copy ensures VERIFIED
// expect: dropLast ensures VERIFIED
// expect: pushOne ensures REFUTED
// expect: Stack.constructor invariant VERIFIED
// expect: Stack.push ensures VERIFIED
// expect: Stack.push invariant VERIFIED
// expect: Stack.pop unwrap VERIFIED
// expect: Stack.pop ensures VERIFIED
// expect: Stack.pop invariant VERIFIED
// expect: Stack.size ensures VERIFIED
// expect: Stack.setMark invariant REFUTED
// expect: Stack.pushTwice ensures VERIFIED
// expect: Stack.pushTwice invariant VERIFIED

// The length of a copy: a user loop invariant over the prefix copied so far.
@Ensures(result.length == xs.length)
function copy<T>(xs: T[]): T[] {
  let out: T[] = [];
  let i: usize = 0;
  @Invariant(out.length == i && i <= xs.length)
  while (i < xs.length) {
    out.push(xs[i]);
    i += 1;
  }
  return out;
}

@Requires(xs.length > 0)
@Ensures(result.length == xs.length - 1)
function dropLast<T>(xs: T[]): T[] {
  let out = xs;
  out.pop();
  return out;
}

// Wrong: a push adds one element.
@Ensures(result.length == xs.length)
function pushOne<T>(xs: T[], x: T): T[] {
  let out = xs;
  out.push(x);
  return out;
}

@Invariant(this.items.length >= this.mark)
class Stack<T> {
  private items: T[] = [];
  private mark: usize = 0;

  constructor() {
  }

  @Ensures(this.items.length == old(this.items.length) + 1)
  push(x: T): void {
    this.items.push(x);
  }

  @Requires(this.items.length > this.mark)
  @Ensures(this.items.length == old(this.items.length) - 1)
  pop(): T {
    const x = this.items.pop();
    return x.unwrap();
  }

  @Ensures(result == this.items.length)
  size(): usize {
    return this.items.length;
  }

  // Wrong: the mark can pass the number of items.
  setMark(m: usize): void {
    this.mark = m;
  }

  // Calls inside the same class are modular like any other call.
  @Ensures(this.items.length == old(this.items.length) + 2)
  pushTwice(x: T, y: T): void {
    this.push(x);
    this.push(y);
  }
}

function main(): void {
  console.log(copy([1, 2]).length.toString());
}
