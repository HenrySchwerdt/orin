// Orin std prelude (spec 19 layer L2, migration step R1; ADR-0013).
//
// Pure library logic that used to live in runtime/orin_runtime.c, written in safe Orin. The
// self-hosted compiler loads this module implicitly into every program (compiler/loader/prelude.or)
// and lowers the corresponding built-in methods to calls of these functions
// (compiler/lower/prelude.or). Unit names start with `$` ("$std/strings"); that marks a unit as
// prelude code (ordinary user code can never produce such a name).
//
// RULES for code in this directory:
//   * only the primitives the C runtime keeps (length, charCodeAt, charAt, substring,
//     String.fromCharCode, `+`, array push/index/length, console, process.exit) may be used;
//   * never call a built-in method that is itself implemented here (`.split`, `.trim`,
//     `.indexOf`, `.includes`, `.startsWith`, `.endsWith`, `parseInt`, `.join`, `.toString()` on
//     int / usize / bool): the lowering would turn it into a (recursive) call of the prelude;
//   * stay within the language accepted by the self-hosted compiler; Stage 0 never sees this code.
export { strIndexOf, strIncludes, strStartsWith, strEndsWith, strSplit, strTrim, strJoin } from "./strings";
export { strParseInt, intToString, usizeToString, boolToString } from "./numbers";
