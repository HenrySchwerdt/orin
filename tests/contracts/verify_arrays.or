// Inputs for tools/test_verify_contracts.py: arrays as sequences (ADR-0031 B6): length, indexing with an in-bounds
// obligation, push / pop, element assignment, slices, and what is REFUTED / UNKNOWN. `// expect:` lines are
// `function kind status`.
// expect: first ensures VERIFIED
// expect: first bounds VERIFIED
// expect: appended ensures VERIFIED
// expect: appended ensures VERIFIED
// expect: off_by_one ensures VERIFIED
// expect: off_by_one bounds REFUTED
// expect: no_precondition ensures VERIFIED
// expect: no_precondition bounds REFUTED
// expect: set_elem ensures VERIFIED
// expect: set_elem ensures VERIFIED
// expect: set_elem bounds VERIFIED
// expect: drop_last ensures VERIFIED
// expect: take_last ensures VERIFIED
// expect: take_last unwrap VERIFIED
// expect: wrong_len ensures REFUTED
// expect: last_two ensures VERIFIED
// expect: last_two bounds VERIFIED
// expect: last_two bounds VERIFIED
// expect: get_some ensures VERIFIED
// expect: sum_loop bounds VERIFIED
// expect: sum_loop ensures UNKNOWN
// expect: main call-precondition VERIFIED

@Requires(xs.length > 0)
@Ensures(result == xs[0])
function first(xs: int[]): int {
  return xs[0];
}

@Ensures(result.length == xs.length + 1)
@Ensures(result[xs.length] == x)
function appended(xs: int[], x: int): int[] {
  let out = xs;
  out.push(x);
  return out;
}

// Wrong: the last element is xs[xs.length - 1]; xs[xs.length] is out of range.
@Requires(xs.length > 0)
@Ensures(result == xs[xs.length - 1])
function off_by_one(xs: int[]): int {
  return xs[xs.length];
}

// Wrong: the empty array has no first element, and nothing excludes it.
@Ensures(result == xs[0])
function no_precondition(xs: int[]): int {
  return xs[0];
}

@Requires(i < xs.length)
@Ensures(result[i] == v)
@Ensures(result.length == xs.length)
function set_elem(xs: int[], i: usize, v: int): int[] {
  let out = xs;
  out[i] = v;
  return out;
}

@Requires(xs.length > 0)
@Ensures(result.length == xs.length - 1)
function drop_last(xs: int[]): int[] {
  let out = xs;
  out.pop();
  return out;
}

@Requires(xs.length > 0)
@Ensures(result == xs[xs.length - 1])
function take_last(xs: int[]): int {
  let out = xs;
  const x = out.pop();
  return x.unwrap();
}

// Wrong: push adds one element, not two.
@Ensures(result.length == xs.length + 2)
function wrong_len(xs: int[]): int[] {
  let out = xs;
  out.push(1);
  return out;
}

@Requires(xs.length >= 2)
@Ensures(result == xs[xs.length - 1] + xs[xs.length - 2])
function last_two(xs: int[]): int {
  return xs[xs.length - 1] + xs[xs.length - 2];
}

@Requires(i < xs.length)
@Ensures(result.isSome())
function get_some(xs: int[], i: usize): Option<int> {
  return xs.get(i);
}

// A counting loop: the counter bound is inferred, but what the loop computes is not stated: UNKNOWN.
@Ensures(result >= 0)
function sum_loop(xs: int[]): int {
  let s = 0;
  let i: usize = 0;
  while (i < xs.length) {
    s += xs[i];
    i += 1;
  }
  return s;
}

function main(): void {
  console.log(first([1, 2]).toString());
}
