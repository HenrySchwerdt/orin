import { newGraph, add, get, set, remove, addEdge, neighbors, contains, size, graphErrorMessage, StaleId, ForeignId, GraphError } from "std:graph";

function describe<T>(r: Result<T, GraphError>): string {
  return match (r) {
    Ok(v) => "ok",
    Err(e) => graphErrorMessage(e)
  };
}

function main(): void {
  let g = newGraph<int>(5);
  const a = add(g, 10);
  g = a.graph;
  const b = add(g, 20);
  g = b.graph;
  g = remove(g, a.id).unwrap();
  console.log(size(g).toString());
  console.log(describe(get(g, a.id)));
  console.log(describe(set(g, a.id, 1)));
  console.log(describe(remove(g, a.id)));
  console.log(describe(neighbors(g, a.id)));
  console.log(describe(addEdge(g, a.id, b.id)));
  console.log(describe(addEdge(g, b.id, a.id)));
  console.log(contains(g, a.id).toString());
  console.log(get(g, b.id).unwrap().toString());
  match (get(g, a.id)) {
    Ok(v) => { console.log("?"); },
    Err(e) => {
      match (e) {
        StaleId => { console.log("matched StaleId"); },
        ForeignId => { console.log("wrong"); }
      }
    }
  }
}
