// `T extends Eq` / `Ord` / `Hash` on functions and classes (ADR-0034): the operators and `equals` / `compare` / `hash` work on
// the type parameter; every instance uses the structural or explicit comparison of its concrete type.
type Version = { major: int; minor: int; };
type Token = Word(string) | Num(int) | Eof;

function maxOf<T extends Ord>(xs: T[]): T {
  let best = xs[0];
  for (const x of xs) {
    if (x > best) {
      best = x;
    }
  }
  return best;
}

function minOf<T extends Ord>(a: T, b: T): T {
  return a <= b ? a : b;
}

function indexOf<T extends Eq>(xs: T[], x: T): int {
  let i: usize = 0;
  while (i < xs.length) {
    if (xs[i] == x) {
      return i.toInt();
    }
    i += 1;
  }
  return -1;
}

function sorted<T extends Ord>(xs: T[]): T[] {
  let out = xs;
  let i: usize = 1;
  while (i < out.length) {
    let j = i;
    while (j > 0 && out[j - 1].compare(out[j]) > 0) {
      const t = out[j - 1];
      out[j - 1] = out[j];
      out[j] = t;
      j -= 1;
    }
    i += 1;
  }
  return out;
}

class Counter<K extends Hash> {
  keys: K[] = [];
  counts: Map<K, int> = new Map<K, int>();
  add(k: K): void {
    this.counts.set(k, this.counts.get(k).unwrapOr(0) + 1);
    if (!this.counts.has(k) || this.counts.get(k).unwrapOr(0) == 1) {
      this.keys.push(k);
    }
  }
  count(k: K): int {
    return this.counts.get(k).unwrapOr(0);
  }
  total(): usize {
    return this.keys.length;
  }
}

function main(): void {
  console.log(maxOf([3, 9, 2]).toString());
  console.log(maxOf(["pear", "apple", "zebra", "mango"]));
  const vs = [Version { major: 1, minor: 4 }, Version { major: 2, minor: 0 }, Version { major: 1, minor: 10 }];
  const top = maxOf(vs);
  console.log(`${top.major}.${top.minor}`);
  console.log(minOf(Version { major: 1, minor: 4 }, Version { major: 1, minor: 3 }).minor.toString());
  console.log(indexOf(["a", "b", "c"], "c").toString());
  console.log(indexOf([Word("x"), Num(1), Eof], Num(1)).toString());
  console.log(indexOf([Word("x"), Num(1)], Eof).toString());
  console.log(indexOf([[1, 2], [3]], [3]).toString());
  const s = sorted([Num(5), Eof, Word("b"), Num(2), Word("a")]);
  for (const t of s) {
    const text = match (t) {
      Word(w) => "w:" + w,
      Num(n) => "n:" + n.toString(),
      Eof => "eof",
    };
    console.log(text);
  }
  let c = new Counter<Version>();
  c.add(Version { major: 1, minor: 0 });
  c.add(Version { major: 1, minor: 0 });
  c.add(Version { major: 2, minor: 0 });
  console.log(c.count(Version { major: 1, minor: 0 }).toString());
  console.log(c.count(Version { major: 9, minor: 9 }).toString());
  console.log(c.total().toString());
  let d = new Counter<string[]>();
  d.add(["a", "b"]);
  d.add(["a", "b"]);
  d.add(["b"]);
  console.log(d.count(["a", "b"]).toString());
  console.log(d.total().toString());
}
