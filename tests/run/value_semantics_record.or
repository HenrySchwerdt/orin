type Point = { x: int; y: int; };
type Line = { a: Point; b: Point; };
type Bag = { items: int[]; };

function bump(p: Point): Point {
  let q = p;
  q.x = q.x + 1;
  return q;
}

function main(): void {
  let a = Point { x: 1, y: 2 };
  const b = a;
  a.x = 100;
  console.log(b.x.toString());
  console.log(a.x.toString());
  let c = a;
  c.y = 7;
  console.log(a.y.toString());
  console.log(c.y.toString());
  const orig = Point { x: 5, y: 5 };
  const bumped = bump(orig);
  console.log(orig.x.toString());
  console.log(bumped.x.toString());
  let n = Line { a: Point { x: 0, y: 0 }, b: Point { x: 1, y: 1 } };
  const m = n;
  n.a.x = 50;
  console.log(m.a.x.toString());
  console.log(n.a.x.toString());
  let r = Bag { items: [1, 2] };
  const s = r;
  r.items.push(3);
  console.log(s.items.length.toString());
  console.log(r.items.length.toString());
}
