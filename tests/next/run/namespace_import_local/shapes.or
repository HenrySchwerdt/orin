export type Shape = Circle(int) | Rect(int, int);
export type Pt = { x: int; y: int; };
export const ORIGIN_X: int = 7;
export function area(s: Shape): int {
  return match (s) { Circle(r) => 3 * r * r, Rect(w, h) => w * h };
}
export function first<T>(xs: T[]): T { return xs[0]; }
export type Box<T> = { v: T; };
export type Opt2<T> = Mk(T) | Nil;
export function unwrap<T>(o: Opt2<T>, d: T): T { return match (o) { Mk(v) => v, Nil => d }; }
export class Counter {
  n: int = 0;
  constructor(public k: int) { this.n = k; }
  get(): int { return this.n; }
}
