// warns: none
// Negatives for the contract-quality warnings (ADR-0028): meaningful contracts, and look-alikes that must
// not be reported (a float compared with itself is a NaN test; `length` of a record is an ordinary field).
import { exit } from "std:process";

type Shape = { length: int; width: int; };

@Requires(s.length >= 0)
function lengthField(s: Shape): int {
  return s.length;
}

@Requires(f == f)
function notNaN(f: float): float {
  return f;
}

@Requires(x > 0)
@Ensures(result > x)
function inc(x: int): int {
  return x + 1;
}

@Invariant(this.n >= 0)
class Counter {
  n: int;

  constructor() {
    this.n = 0;
  }

  @Ensures(this.n == old(this.n) + 1)
  bump(): void {
    this.n += 1;
  }

  @Ensures(result == this.n)
  value(): int {
    return this.n;
  }
}

function main(): void {
  let c = new Counter();
  c.bump();
  console.log((inc(c.value()) + lengthField(Shape { length: 2, width: 3 })).toString());
  console.log(notNaN(1.5) > 1.0 ? "ok" : "no");
  exit(0);
}
