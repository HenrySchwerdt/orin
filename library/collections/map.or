// Map<K, V> prelude (spec 08 std:map, ADR-0018): a value-semantics hash map written in Orin.
//
// This file is part of the `$array` prelude root (unit `$array/map`, always loaded; see library/collections/module.or).
// User code never imports it: the checker maps the type names `Map` / `MapEntry` to the generic records
// below, `new Map<K, V>()` to `mapNew`, and `m.get(k)` etc. to the functions below with the receiver as
// first argument (check/body.or, mapMethodCall). Keys are `int`, `usize`, `bool` or `string` (validated by the
// checker when the type is written, E0400).
//
// Representation (copy-on-write like every record/array): insertion-ordered entry arrays plus an
// open-addressing index table of entry numbers with linear probing.
//   _keys / _vals / _live   entry i: its key, value and whether it is still present (deleted entries stay
//                           as tombstones until the next rebuild, so `_keys.length - size` entries are dead)
//   _tab                    index table (length 0 or a power of two >= 8): entry number or -1 (empty);
//                           the entry count (incl. dead ones) never exceeds half of its length
//   size                    number of live entries
// Mutating operations take the map and return the updated map (the caller assigns it back, ADR-0009 style
// lowering `m = mapSet(m, k, v)`); with owned parameters (ADR-0010) a unique map is updated in place.
// Expected O(1) get/has/set/delete; keys/values/entries O(n); a rebuild (growth, or compaction when more
// than half of the entries are dead) is amortised O(1) per insertion.

export type Map<K, V> = {
  size: usize;
  _keys: K[];
  _vals: V[];
  _live: bool[];
  _tab: int[];
};

export type MapEntry<K, V> = { key: K; value: V; };

// ---------------------------------------------------------------- key classes
// `keyHash` / `keyEq` are placeholders: a generic body cannot compare or hash a `K`, so the checker
// replaces an instance `keyHash<int>` by `hashInt`, `keyHash<string>` by `hashString`, ... (check/types.or,
// instFunc). The bodies below are only ever type-checked (abstractly), never run.
// keyHash(k): usize -- placeholder for the hash of a key; the checker replaces every instance by `hashInt`, `hashUsize`,
// `hashBool` or `hashString`. Implementation hook, not API; the body is never run.
export function keyHash<K>(k: K): usize {
  return 0;
}

// keyEq(a, b): bool -- placeholder for key equality; replaced like `keyHash` by `eqInt`, `eqUsize`, `eqBool` or
// `eqString`. Implementation hook, not API; the body is never run.
export function keyEq<K>(a: K, b: K): bool {
  return false;
}

// hashInt(k): usize -- the hash of an int key. Hooks `hashInt`/`hashUsize`/`hashBool`/`hashString` are implementation
// details of `Map`, not API. Hashes are < 2^32 and never trap: all intermediate products stay below 2^64. O(1).
export function hashInt(k: int): usize {
  let r = k % 2147483647;
  if (r < 0) {
    r += 2147483647;
  }
  return (r.toUsize() * 2654435761) % 4294967291;
}

// hashUsize(k): usize -- the hash of a usize key. O(1).
export function hashUsize(k: usize): usize {
  return ((k % 2147483647) * 2654435761) % 4294967291;
}

// hashBool(k): usize -- the hash of a bool key. O(1).
export function hashBool(k: bool): usize {
  return k ? 1 : 0;
}

// hashString(s): usize -- the hash of a string key (polynomial, modulus 1000000007). O(s.length).
export function hashString(s: string): usize {
  let h: usize = 5381;
  const n = s.length;
  let i: usize = 0;
  while (i < n) {
    h = (h * 131 + s.charCodeAt(i).toUsize()) % 1000000007;
    i += 1;
  }
  return h;
}

// eqInt(a, b): bool -- key equality for int keys. `eqUsize`, `eqBool`, `eqString` likewise. O(1) (O(n) for strings).
export function eqInt(a: int, b: int): bool {
  return a == b;
}

export function eqUsize(a: usize, b: usize): bool {
  return a == b;
}

export function eqBool(a: bool, b: bool): bool {
  return a == b;
}

export function eqString(a: string, b: string): bool {
  return a == b;
}

// ---------------------------------------------------------------- Eq / Ord / Hash building blocks (ADR-0034)
// The derived `compare` and `hash` of the checker (check/derive.or) call these for the scalar components: `compare`
// returns -1, 0 or 1; `hashMix` folds a component hash into an accumulator (both stay below 2^32, no trap).
export function cmpInt(a: int, b: int): int {
  return a < b ? -1 : (a > b ? 1 : 0);
}

export function cmpUsize(a: usize, b: usize): int {
  return a < b ? -1 : (a > b ? 1 : 0);
}

export function cmpBool(a: bool, b: bool): int {
  return a == b ? 0 : (b ? -1 : 1);
}

// Lexicographic by byte.
export function cmpStr(a: string, b: string): int {
  const na = a.length;
  const nb = b.length;
  let i: usize = 0;
  while (i < na && i < nb) {
    const x = a.charCodeAt(i);
    const y = b.charCodeAt(i);
    if (x < y) {
      return -1;
    }
    if (x > y) {
      return 1;
    }
    i += 1;
  }
  return na < nb ? -1 : (na > nb ? 1 : 0);
}

export function hashMix(h: usize, x: usize): usize {
  return (h * 1000003 + x % 4294967291) % 4294967291;
}

// ---------------------------------------------------------------- table
// Entry number of the live entry with key `k`, or -1.
function findEntry<K, V>(m: Map<K, V>, k: K): int {
  const cap = m._tab.length;
  if (cap == 0) {
    return -1;
  }
  let i = keyHash(k) % cap;
  while (true) {
    const e = m._tab[i];
    if (e < 0) {
      return -1;
    }
    const u = e.toUsize();
    if (m._live[u] && keyEq(m._keys[u], k)) {
      return e;
    }
    i += 1;
    if (i == cap) {
      i = 0;
    }
  }
  return -1;
}

// Index table of the live entries of `ks` / `live` with `cap` slots (a power of two, load <= 1/2).
function buildTab<K>(ks: K[], live: bool[], cap: usize): int[] {
  let tab: int[] = [];
  let j: usize = 0;
  while (j < cap) {
    tab.push(-1);
    j += 1;
  }
  let e: usize = 0;
  while (e < ks.length) {
    if (live[e]) {
      let i = keyHash(ks[e]) % cap;
      while (tab[i] >= 0) {
        i += 1;
        if (i == cap) {
          i = 0;
        }
      }
      tab[i] = e.toInt();
    }
    e += 1;
  }
  return tab;
}

function tabCapFor(entries: usize): usize {
  let cap: usize = 8;
  while (cap < entries * 4) {
    cap = cap * 2;
  }
  return cap;
}

// The map with dead entries dropped (insertion order kept) and an index table sized for `extra` more
// entries. Returns `m` itself (updated in place when unique) when there is nothing to compact.
function rebuild<K, V>(m: Map<K, V>, extra: usize): Map<K, V> {
  let r = m;
  if (r._keys.length == r.size) {
    r._tab = buildTab(r._keys, r._live, tabCapFor(r.size + extra));
    return r;
  }
  let ks: K[] = [];
  let vs: V[] = [];
  let lv: bool[] = [];
  let i: usize = 0;
  while (i < r._keys.length) {
    if (r._live[i]) {
      ks.push(r._keys[i]);
      vs.push(r._vals[i]);
      lv.push(true);
    }
    i += 1;
  }
  const tab = buildTab(ks, lv, tabCapFor(ks.length + extra));
  return Map { size: ks.length, _keys: ks, _vals: vs, _live: lv, _tab: tab };
}

// ---------------------------------------------------------------- API
// Map methods (user code writes `m.get(k)`; the checker lowers a call to the function below with the map as the first
// argument and assigns the result back for the mutating ones). Expected O(1) per operation, see the header.
//
// new Map<K, V>(): Map<K, V> -- an empty map. O(1).
export function mapNew<K, V>(): Map<K, V> {
  return Map { size: 0, _keys: [], _vals: [], _live: [], _tab: [] };
}

// get(k): Option<V> -- the value stored under k, or None. Never traps. O(1) expected.
export function mapGet<K, V>(m: Map<K, V>, k: K): Option<V> {
  const e = findEntry(m, k);
  if (e < 0) {
    return None;
  }
  return Some(m._vals[e.toUsize()]);
}

// has(k): bool -- is there an entry for k? Never traps. O(1) expected.
export function mapHas<K, V>(m: Map<K, V>, k: K): bool {
  return findEntry(m, k) >= 0;
}

// set(k, v): void -- associates k with v, replacing an existing value. Never traps. O(1) expected, amortised over
// rebuilds.
export function mapSet<K, V>(m: Map<K, V>, k: K, v: V): Map<K, V> {
  let r = m;
  const at = findEntry(r, k);
  if (at >= 0) {
    r._vals[at.toUsize()] = v;
    return r;
  }
  if ((r._keys.length + 1) * 2 > r._tab.length) {
    r = rebuild(r, 1);
  }
  const cap = r._tab.length;
  let i = keyHash(k) % cap;
  while (r._tab[i] >= 0) {
    i += 1;
    if (i == cap) {
      i = 0;
    }
  }
  r._tab[i] = r._keys.length.toInt();
  r._keys.push(k);
  r._vals.push(v);
  r._live.push(true);
  r.size += 1;
  return r;
}

// delete(k): void -- removes the entry for k; a no-op when absent. ADR-0048 wants the spelling `remove(k): Option<V>`
// like the other keyed collections; that is a checker change (method table), not made here. O(1) expected.
export function mapDelete<K, V>(m: Map<K, V>, k: K): Map<K, V> {
  let r = m;
  const at = findEntry(r, k);
  if (at < 0) {
    return r;
  }
  r._live[at.toUsize()] = false;
  r.size -= 1;
  if (r._keys.length > 16 && r.size * 2 < r._keys.length) {
    r = rebuild(r, 0);
  }
  return r;
}

// keys(): K[] -- the live keys in insertion order. Never traps. O(n); allocates the result.
export function mapKeys<K, V>(m: Map<K, V>): K[] {
  let out: K[] = [];
  let i: usize = 0;
  while (i < m._keys.length) {
    if (m._live[i]) {
      out.push(m._keys[i]);
    }
    i += 1;
  }
  return out;
}

// values(): V[] -- the live values in insertion order. Never traps. O(n); allocates the result.
export function mapValues<K, V>(m: Map<K, V>): V[] {
  let out: V[] = [];
  let i: usize = 0;
  while (i < m._keys.length) {
    if (m._live[i]) {
      out.push(m._vals[i]);
    }
    i += 1;
  }
  return out;
}

// entries(): MapEntry<K, V>[] -- the live entries in insertion order. Never traps. O(n); allocates the result.
export function mapEntries<K, V>(m: Map<K, V>): MapEntry<K, V>[] {
  let out: MapEntry<K, V>[] = [];
  let i: usize = 0;
  while (i < m._keys.length) {
    if (m._live[i]) {
      out.push(MapEntry { key: m._keys[i], value: m._vals[i] });
    }
    i += 1;
  }
  return out;
}
