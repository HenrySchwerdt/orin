// HIR -> MIR lowering entry point: one `Lowerer` (lowerer.or) per function.

import { Program } from "../hir";
import { MProgram, MFunction, MVTable } from "../mir";
import { collectLits } from "./util";
import { lowerFunction } from "./lowerer";
import { preludeIds } from "./prelude";
import { progWellLowered } from "./wellformed";

// The MIR of a program: the same functions in the same order (indices are shared with the HIR: calls, vtables and
// `main` refer to them), the same vtables, the string table the literals index. Every function is well lowered
// (locals declared, branch targets in range, no unreachable block, string indices in range, a source span on every
// instruction and terminator).
@Ensures(result.functions.length == prog.functions.length && result.main == prog.main)
@Ensures(result.vtables.length == prog.vtables.length
    && result.inlineFns.length == prog.inlineFns.length)
@Ensures(result.functions.every(f => f.blocks.length >= 1))
@Ensures(progWellLowered(result))
export function lower(prog: Program): MProgram {
  let lits = collectLits(prog);
  lits.pre = preludeIds(prog);
  let fns: MFunction[] = [];
  let i: usize = 0;
  while (i < prog.functions.length) {
    fns.push(lowerFunction(prog, i, lits));
    i += 1;
  }
  const vts: MVTable[] = prog.vtables.map(v => MVTable { name: v.name, funcs: v.funcs });
  return MProgram {
    functions: fns,
    strings: lits.strs,
    main: prog.main,
    vtables: vts,
    inlineFns: prog.inlineFns,
  };
}
