import { parse, stringify, pretty, Json, JNull, JBool, JNum, JStr, JArr, JObj, field } from "std:json";

function main(): void {
  const doc: Json = JObj([
    field("name", JStr("Orin \"lang\"\n\ttab \\ slash")),
    field("n", JNum(-42)),
    field("big", JNum(9223372036854775807)),
    field("ok", JBool(true)),
    field("nothing", JNull),
    field("list", JArr([JNum(1), JStr("two"), JArr([]), JObj([])])),
    field("nested", JObj([field("deep", JObj([field("x", JArr([JNull]))]))])),
    field("ctl", JStr(String.fromCharCode(1) + String.fromCharCode(31) + String.fromCharCode(8) + String.fromCharCode(12)))
  ]);
  const text = stringify(doc);
  console.log(text);
  const again = parse(text).unwrap();
  console.log((stringify(again) == text).toString());
  const p = pretty(doc, 2);
  const third = parse(p).unwrap();
  console.log((stringify(third) == text).toString());
  const q = pretty(doc, 4);
  console.log((stringify(parse(q).unwrap()) == text).toString());
}
