// Function body checking: statements, places, expressions, calls and match.
// Port of `FnCx` (bootstrap/src/checker/mod.rs). All of these functions are mutually recursive
// (match arms contain blocks, blocks contain expressions), so they live in one file; the
// non-recursive parts are in env.or, fnctx.or, builtins.or and pattern.or.
//
// Every function takes the read-only `Env` and the function context `FnCtx` and returns the
// updated context together with its result. Errors abort the whole function body.

import { Span, Diagnostic, diag } from "../diag";
import {
  Ident, Block, Stmt, StmtKind, Expr, ExprKind, FieldInit, MatchArm, ArmBody, TypeExpr, TNamed, AssignOp,
  UnaryOp, BinaryOp, Pattern, TypeDecl, DRecord, DUnion, FieldDecl
} from "../syntax";
import {
  Type, FieldDef, VariantDef, HBlock, HStmt, Place, PlaceElem, HExpr, HExprKind, UnOp, BinOp, FieldInitH, HArm,
  HPattern, Builtin, MutBuiltin
} from "../hir";
import {
  Env, ValEnt, ConstLit, EntRecord, EntUnion, EntAlias, EntGen, typeEq, isInt, isUsize, isBool, isString, isVoid,
  isIntish, isArrayTy, expIsUsize, showType, mismatch, globalVal, findType, originOf
} from "./env";
import { classOfRec, findMethod, fieldIsPrivate } from "./classes";
import {
  FnCtx, newLocal, declare, declaredInScope, pushScope, popScope, lookupLocal, pushLoop, popLoop, markBreak
} from "./fnctx";
import { builtinSig, methodSig, Sig, MSig } from "./builtins";
import { checkPattern, PatOut } from "./pattern";
import {
  TScope, resolveType, aliasType, instType, instFunc, unify, noBinds, mentionsUnbound, indexOfName, scopeOf
} from "./types";

export type ExprOut = { fx: FnCtx; expr: HExpr; };
export type BlockOut = { fx: FnCtx; block: HBlock; div: bool; };
type ArgsOut = { fx: FnCtx; args: HExpr[]; };
type PairOut = { fx: FnCtx; l: HExpr; r: HExpr; };
type PlaceOut = { fx: FnCtx; place: Place; mutable: bool; rootName: string; };
type StmtOut = { fx: FnCtx; stmt: HStmt; div: bool; };
type MatchOut = { fx: FnCtx; expr: HExpr; div: bool; };
type LetInit = { fx: FnCtx; expr: HExpr; ty: Type; };
type ElseOut = { fx: FnCtx; block: Option<HBlock>; div: bool; };
type TyFx = { fx: FnCtx; ty: Type; };
type InferOut = { fx: FnCtx; tys: Type[]; args: HExpr[]; };

function mk(kind: HExprKind, ty: Type, span: Span): HExpr {
  return HExpr { kind: kind, ty: ty, span: span };
}

function done(fx: FnCtx, kind: HExprKind, ty: Type, span: Span): Result<ExprOut, Diagnostic> {
  return Ok(ExprOut { fx: fx, expr: mk(kind, ty, span) });
}

function noExprs(): HExpr[] {
  const xs: HExpr[] = [];
  return xs;
}

// ---------------------------------------------------------------------------
// Syntactic helpers
// ---------------------------------------------------------------------------

function isArithOp(op: BinaryOp): bool {
  return match (op) {
    BAdd => true,
    BSub => true,
    BMul => true,
    BDiv => true,
    BRem => true,
    _ => false
  };
}

// Syntactic "untyped integer expression": adopts the type demanded by context.
function untypedInt(e: Expr): bool {
  return match (e.kind) {
    EInt(_) => true,
    EUnary(op, x) => match (op) { UNeg => untypedInt(x), _ => false },
    EBinary(op, l, r) => isArithOp(op) && untypedInt(l) && untypedInt(r),
    _ => false
  };
}

function toBinOp(op: BinaryOp): BinOp {
  return match (op) {
    BAdd => OpAdd,
    BSub => OpSub,
    BMul => OpMul,
    BDiv => OpDiv,
    BRem => OpRem,
    BEq => OpEq,
    BNe => OpNe,
    BLt => OpLt,
    BLe => OpLe,
    BGt => OpGt,
    BGe => OpGe,
    BAnd => OpAnd,
    BOr => OpOr
  };
}

function intishHint(exp: Option<Type>): Option<Type> {
  return match (exp) {
    Some(t) => isIntish(t) ? Some(t) : None,
    None => None
  };
}

function hintOf(t: Type): Option<Type> {
  return isIntish(t) ? Some(t) : None;
}

function fieldIndex(fields: FieldDef[], name: string): Option<usize> {
  let i: usize = 0;
  for (const f of fields) {
    if (f.name == name) {
      return Some(i);
    }
    i += 1;
  }
  return None;
}

function noField(env: Env, name: Ident, t: Type): Diagnostic {
  return diag("E0405", name.span, "no field `" + name.name + "` on type `" + showType(env, t) + "`");
}

// ---------------------------------------------------------------------------
// Expressions
// ---------------------------------------------------------------------------

function expect(env: Env, fx: FnCtx, e: Expr, ty: Type): Result<ExprOut, Diagnostic> {
  const r = checkExpr(env, fx, e, Some(ty))?;
  if (!typeEq(r.expr.ty, ty)) {
    return Err(mismatch(r.fx.env, e.span, ty, r.expr.ty));
  }
  return Ok(r);
}

export function checkExpr(env: Env, fx: FnCtx, e: Expr, exp: Option<Type>): Result<ExprOut, Diagnostic> {
  const span = e.span;
  return match (e.kind) {
    EInt(n) => done(fx, XInt(n), expIsUsize(exp) ? TyUsize : TyInt, span),
    EStr(s) => done(fx, XStr(s), TyString, span),
    EBool(b) => done(fx, XBool(b), TyBool, span),
    EIdent(id) => checkIdent(env, fx, id, exp, span),
    EUnary(op, x) => checkUnary(env, fx, span, op, x, exp),
    EBinary(op, l, r) => checkBinary(env, fx, span, op, l, r, exp),
    ECall(callee, args) => checkCall(env, fx, span, callee, args, exp),
    EMember(base, name) => checkMember(env, fx, span, base, name),
    EIndex(base, idx) => checkIndex(env, fx, span, base, idx),
    ETry(x) => checkTry(env, fx, span, x),
    ECond(c, t, f) => checkCond(env, fx, span, c, t, f, exp),
    EArray(elems) => checkArray(env, fx, span, elems, exp),
    ERecord(name, spread, fields) => checkRecord(env, fx, span, name, None, spread, fields, exp),
    ERecordT(name, targs, spread, fields) => checkRecord(env, fx, span, name, Some(targs), spread, fields, exp),
    ETyApp(_, _) => Err(diag("E0400", span, "type arguments are only allowed on a call or a record literal")),
    EMatch(s, arms) => checkMatchExpr(env, fx, span, s, arms, exp),
    ENew(name, targs, args) => checkNew(env, fx, span, name, targs, args),
    EThis => checkThis(fx, span)
  };
}

function checkMatchExpr(
  env: Env, fx: FnCtx, span: Span, scrut: Expr, arms: MatchArm[], exp: Option<Type>
): Result<ExprOut, Diagnostic> {
  const r = checkMatch(env, fx, span, scrut, arms, exp, false)?;
  return Ok(ExprOut { fx: r.fx, expr: r.expr });
}

function constKind(lit: ConstLit): HExprKind {
  return match (lit) {
    LitInt(n) => XInt(n),
    LitStr(s) => XStr(s),
    LitBool(b) => XBool(b)
  };
}

function checkIdent(env: Env, fx: FnCtx, id: Ident, exp: Option<Type>, span: Span): Result<ExprOut, Diagnostic> {
  const lo = lookupLocal(fx, id.name);
  if (lo.isSome()) {
    const l = lo.unwrap();
    return done(fx, XLocal(l), fx.locals[l].ty, span);
  }
  const g = globalVal(env, fx.unit, id.name);
  if (g.isSome()) {
    return identVal(env, fx, g.unwrap(), id, span, exp);
  }
  if (id.name == "None") {
    return noneLit(env, fx, exp, span);
  }
  if (id.name == "Some" || id.name == "Ok" || id.name == "Err") {
    return Err(diag("E0404", span, "`" + id.name + "` must be called with arguments"));
  }
  return Err(diag("E0300", id.span, "unresolved name `" + id.name + "`"));
}

function identVal(env: Env, fx: FnCtx, ent: ValEnt, id: Ident, span: Span, exp: Option<Type>): Result<ExprOut, Diagnostic> {
  return match (ent) {
    VConst(i) => done(fx, constKind(env.consts[i].lit), env.consts[i].ty, span),
    VVariant(u, tag) => {
      const def = fx.env.unions[u].variants[tag];
      if (def.payload.length > 0) {
        return Err(diag(
          "E0404",
          span,
          "variant `" + def.name + "` expects " + def.payload.length.toString() + " argument(s)"
        ));
      }
      return done(fx, XVariant(tag, noExprs()), TyUnion(u), span);
    },
    VGVariant(g, tag) => genericVariant(env, fx, span, g, tag, None, [], exp),
    VGFunc(_) => Err(diag("E0400", span, "function `" + id.name + "` cannot be used as a value")),
    VFunc(_) => Err(diag("E0400", span, "function `" + id.name + "` cannot be used as a value")),
    VStd(_) => Err(diag("E0400", span, "function `" + id.name + "` cannot be used as a value"))
  };
}

function noneLit(env: Env, fx: FnCtx, exp: Option<Type>, span: Span): Result<ExprOut, Diagnostic> {
  return match (exp) {
    Some(t) => match (t) {
      TyOption(inner) => done(fx, XVariant(1, noExprs()), TyOption(inner), span),
      _ => Err(diag("E0400", span, "expected `" + showType(fx.env, t) + "`, found an `Option`"))
    },
    None => Err(diag("E0407", span, "cannot infer the type of `None`; add a type annotation"))
  };
}

function checkUnary(
  env: Env, fx: FnCtx, span: Span, op: UnaryOp, inner: Expr, exp: Option<Type>
): Result<ExprOut, Diagnostic> {
  return match (op) {
    UNeg => checkNeg(env, fx, span, inner, exp),
    UNot => {
      const o = checkExpr(env, fx, inner, None)?;
      if (!isBool(o.expr.ty)) {
        return Err(diag("E0410", span, "`!` requires `bool`, found `" + showType(o.fx.env, o.expr.ty) + "`"));
      }
      return done(o.fx, XUnary(UnNot, o.expr), TyBool, span);
    }
  };
}

function intLitValue(e: Expr): Option<int> {
  return match (e.kind) {
    EInt(n) => Some(n),
    _ => None
  };
}

function checkNeg(env: Env, fx: FnCtx, span: Span, inner: Expr, exp: Option<Type>): Result<ExprOut, Diagnostic> {
  const lit = intLitValue(inner);
  if (lit.isSome()) {
    if (expIsUsize(exp)) {
      return Err(diag("E0400", span, "negative integer literal cannot have type `usize`"));
    }
    return done(fx, XInt(-lit.unwrap()), TyInt, span);
  }
  const o = checkExpr(env, fx, inner, None)?;
  if (!isInt(o.expr.ty)) {
    return Err(diag("E0410", span, "cannot negate a value of type `" + showType(o.fx.env, o.expr.ty) + "`"));
  }
  return done(o.fx, XUnary(UnNeg, o.expr), TyInt, span);
}

function checkOperands(
  env: Env, fx: FnCtx, lhs: Expr, rhs: Expr, hint: Option<Type>
): Result<PairOut, Diagnostic> {
  if (untypedInt(lhs) && !untypedInt(rhs)) {
    const r = checkExpr(env, fx, rhs, hint)?;
    const l = checkExpr(env, r.fx, lhs, hintOf(r.expr.ty))?;
    return Ok(PairOut { fx: l.fx, l: l.expr, r: r.expr });
  }
  const l = checkExpr(env, fx, lhs, hint)?;
  const h: Option<Type> = untypedInt(rhs) ? hintOf(l.expr.ty) : None;
  const r = checkExpr(env, l.fx, rhs, h)?;
  return Ok(PairOut { fx: r.fx, l: l.expr, r: r.expr });
}

function checkBinary(
  env: Env, fx: FnCtx, span: Span, op: BinaryOp, lhs: Expr, rhs: Expr, exp: Option<Type>
): Result<ExprOut, Diagnostic> {
  const hop = toBinOp(op);
  const isLogic = match (op) { BAnd => true, BOr => true, _ => false };
  if (isLogic) {
    const l = checkExpr(env, fx, lhs, None)?;
    const r = checkExpr(env, l.fx, rhs, None)?;
    if (r.fx.pre.length > l.fx.pre.length) {
      return Err(condHoistErr(rhs.span));
    }
    if (!isBool(l.expr.ty) || !isBool(r.expr.ty)) {
      return Err(diag(
        "E0410",
        span,
        "`&&`/`||` require `bool` operands, found `" + showType(r.fx.env, l.expr.ty) + "` and `"
          + showType(r.fx.env, r.expr.ty) + "`"
      ));
    }
    return done(r.fx, XBinary(hop, l.expr, r.expr), TyBool, span);
  }
  const arith = isArithOp(op);
  const hint: Option<Type> = arith ? intishHint(exp) : None;
  const p = checkOperands(env, fx, lhs, rhs, hint)?;
  const lt = p.l.ty;
  const rt = p.r.ty;
  if (!typeEq(lt, rt) && isIntish(lt) && isIntish(rt)) {
    return Err(diag(
      "E0400",
      span,
      "cannot mix `" + showType(p.fx.env, lt) + "` and `" + showType(p.fx.env, rt) + "`; convert explicitly"
    ));
  }
  if (!typeEq(lt, rt)) {
    return Err(diag(
      "E0410",
      span,
      "operands have different types `" + showType(p.fx.env, lt) + "` and `" + showType(p.fx.env, rt) + "`"
    ));
  }
  const ok = match (op) {
    BAdd => isIntish(lt) || isString(lt),
    BSub => isIntish(lt),
    BMul => isIntish(lt),
    BDiv => isIntish(lt),
    BRem => isIntish(lt),
    BEq => isIntish(lt) || isBool(lt) || isString(lt),
    BNe => isIntish(lt) || isBool(lt) || isString(lt),
    _ => isIntish(lt)
  };
  if (!ok) {
    return Err(diag("E0410", span, "operator is not defined for type `" + showType(p.fx.env, lt) + "`"));
  }
  return done(p.fx, XBinary(hop, p.l, p.r), arith ? lt : TyBool, span);
}

function checkMember(env: Env, fx: FnCtx, span: Span, base: Expr, name: Ident): Result<ExprOut, Diagnostic> {
  const b = checkExpr(env, fx, base, None)?;
  const t = b.expr.ty;
  if (name.name == "length") {
    if (isString(t)) {
      return done(b.fx, XBuiltin(BStrLength, [b.expr]), TyUsize, span);
    }
    if (isArrayTy(t)) {
      return done(b.fx, XBuiltin(BArrLength, [b.expr]), TyUsize, span);
    }
  }
  return match (t) {
    TyRecord(r) => {
      const def = b.fx.env.records[r];
      const io = fieldIndex(def.fields, name.name);
      if (io.isNone()) {
        return Err(diag("E0405", name.span, "no field `" + name.name + "` on type `" + def.name + "`"));
      }
      const i = io.unwrap();
      checkFieldAccess(b.fx, r, name)?;
      return done(b.fx, XField(b.expr, r, i), def.fields[i].ty, span);
    },
    _ => Err(noField(fx.env, name, t))
  };
}

function checkIndex(env: Env, fx: FnCtx, span: Span, base: Expr, index: Expr): Result<ExprOut, Diagnostic> {
  const b = checkExpr(env, fx, base, None)?;
  return match (b.expr.ty) {
    TyArray(t) => {
      const i = expect(env, b.fx, index, TyUsize)?;
      return done(i.fx, XIndex(b.expr, i.expr), t, span);
    },
    _ => Err(diag("E0400", span, "cannot index into type `" + showType(b.fx.env, b.expr.ty) + "`"))
  };
}

function checkTry(env: Env, fx: FnCtx, span: Span, inner: Expr): Result<ExprOut, Diagnostic> {
  const o = checkExpr(env, fx, inner, None)?;
  return match (o.expr.ty) {
    TyResult(t, et) => {
      match (fx.ret) {
        TyResult(_, e2) => {
          if (!typeEq(e2, et)) {
            return Err(diag(
              "E0406",
              span,
              "error type `" + showType(o.fx.env, et) + "` does not match the function's error type `"
                + showType(o.fx.env, e2) + "`"
            ));
          }
        },
        _ => {
          return Err(diag(
            "E0406",
            span,
            "`?` used in a function returning `" + showType(fx.env, fx.ret) + "`, not a `Result`"
          ));
        }
      }
      return done(o.fx, XTry(o.expr), t, span);
    },
    _ => Err(diag("E0406", span, "`?` requires a `Result`, found `" + showType(o.fx.env, o.expr.ty) + "`"))
  };
}

function checkCond(
  env: Env, fx: FnCtx, span: Span, cond: Expr, thenE: Expr, elsE: Expr, exp: Option<Type>
): Result<ExprOut, Diagnostic> {
  const c = expect(env, fx, cond, TyBool)?;
  let cur = c.fx;
  let t: HExpr = mk(XBool(false), TyBool, span);
  let f: HExpr = mk(XBool(false), TyBool, span);
  const npre = cur.pre.length;
  if (untypedInt(thenE) && !untypedInt(elsE)) {
    const fr = checkExpr(env, cur, elsE, exp)?;
    const tr = checkExpr(env, fr.fx, thenE, hintOf(fr.expr.ty))?;
    cur = tr.fx;
    t = tr.expr;
    f = fr.expr;
  } else {
    const tr = checkExpr(env, cur, thenE, exp)?;
    const h = untypedInt(elsE) && isIntish(tr.expr.ty) ? Some(tr.expr.ty) : exp;
    const fr = checkExpr(env, tr.fx, elsE, h)?;
    cur = fr.fx;
    t = tr.expr;
    f = fr.expr;
  }
  if (cur.pre.length > npre) {
    return Err(condHoistErr(span));
  }
  if (!typeEq(t.ty, f.ty)) {
    return Err(diag(
      "E0400",
      elsE.span,
      "branches of conditional have different types `" + showType(fx.env, t.ty) + "` and `"
        + showType(fx.env, f.ty) + "`"
    ));
  }
  return done(cur, XCond(c.expr, t, f), t.ty, span);
}

function checkArray(
  env: Env, fx: FnCtx, span: Span, elems: Expr[], exp: Option<Type>
): Result<ExprOut, Diagnostic> {
  let cur = fx;
  let pre: Option<HExpr>[] = [];
  for (const _e of elems) {
    pre.push(None);
  }
  let elemTy: Type = TyInt;
  let fromExp = false;
  match (exp) {
    Some(t) => {
      match (t) {
        TyArray(et) => {
          elemTy = et;
          fromExp = true;
        },
        _ => {}
      }
    },
    None => {}
  }
  if (!fromExp) {
    if (elems.length == 0) {
      return Err(diag("E0407", span, "cannot infer the element type of `[]`; add a type annotation"));
    }
    let k: usize = 0;
    let found = false;
    while (k < elems.length && !found) {
      if (!untypedInt(elems[k])) {
        found = true;
      } else {
        k += 1;
      }
    }
    if (found) {
      const he = checkExpr(env, cur, elems[k], None)?;
      cur = he.fx;
      elemTy = he.expr.ty;
      pre[k] = Some(he.expr);
    }
  }
  if (isVoid(elemTy)) {
    return Err(diag("E0400", span, "array elements cannot be `void`"));
  }
  let out: HExpr[] = [];
  let i: usize = 0;
  for (const e of elems) {
    match (pre[i]) {
      Some(he) => { out.push(he); },
      None => {
        const r = expect(env, cur, e, elemTy)?;
        cur = r.fx;
        out.push(r.expr);
      }
    }
    i += 1;
  }
  return done(cur, XArray(out), TyArray(elemTy), span);
}

function resolveFx(fx: FnCtx, te: TypeExpr, voidOk: bool): Result<TyFx, Diagnostic> {
  const sc = TScope { unit: fx.unit, names: fx.tpNames, tys: fx.tpTys, depth: 0 };
  const r = resolveType(fx.env, sc, te, voidOk)?;
  return Ok(TyFx { fx: withEnv(fx, r.env), ty: r.ty });
}

// `fx` with its environment replaced by `e` (instances only ever grow the tables).
function withEnv(fx: FnCtx, e: Env): FnCtx {
  if (e.insts.length == fx.env.insts.length) {
    return fx;
  }
  let f = fx;
  f.env = e;
  return f;
}

// `Name<P1, ..., Pn>` for a generic declaration: the "return type" of its constructors.
function selfTypeExpr(d: TypeDecl): TypeExpr {
  let args: TypeExpr[] = [];
  for (const p of d.typeParams) {
    args.push(TypeExpr { kind: TNamed(p, []), span: p.span });
  }
  return TypeExpr { kind: TNamed(d.name, args), span: d.name.span };
}

function paramNameList(ps: Ident[]): string[] {
  let out: string[] = [];
  for (const p of ps) {
    out.push(p.name);
  }
  return out;
}

function checkRecord(
  env: Env, fx: FnCtx, span: Span, name: Ident, targs: Option<TypeExpr[]>, spread: Option<Expr>,
  fields: FieldInit[], exp: Option<Type>
): Result<ExprOut, Diagnostic> {
  if (indexOfName(fx.tpNames, name.name).isSome()) {
    return Err(diag("E0400", name.span, "`" + name.name + "` is a type parameter, not a record type"));
  }
  const found = findType(env.units[fx.unit].scope, name.name);
  if (found.isNone()) {
    return Err(diag("E0300", name.span, "unknown type `" + name.name + "`"));
  }
  let cur = fx;
  let t: Type = TyVoid;
  match (found.unwrap()) {
    EntGen(g) => {
      return checkGenericRecord(env, fx, span, g, name, targs, spread, fields, exp);
    },
    EntRecord(r) => { t = TyRecord(r); },
    EntUnion(u) => { t = TyUnion(u); },
    EntAlias(i) => {
      const none: int[] = [];
      const r = aliasType(cur.env, i, none)?;
      cur = withEnv(cur, r.env);
      t = r.ty;
    }
  }
  if (targs.isSome()) {
    return Err(diag("E0400", name.span, "type `" + name.name + "` is not generic"));
  }
  const rid = match (t) {
    TyRecord(r) => r,
    _ => {
      return Err(diag(
        "E0400",
        name.span,
        "`" + name.name + "` is not a record type (it is `" + showType(cur.env, t) + "`)"
      ));
    }
  };
  const co = classOfRec(cur.env, rid);
  if (co.isSome() && !inClass(cur, co.unwrap())) {
    return Err(diag(
      "E0408",
      name.span,
      "class `" + name.name + "` cannot be built with a record literal outside its own body; use `new " + name.name + "(..)`"
    ));
  }
  return checkRecordOf(env, cur, span, rid, spread, fields);
}

function fieldDeclIndex(fields: FieldDecl[], name: string): Option<usize> {
  let i: usize = 0;
  for (const f of fields) {
    if (f.name.name == name) {
      return Some(i);
    }
    i += 1;
  }
  return None;
}

// Record literal of a generic record type: the instance comes from the spread, the explicit type
// arguments, the expected type or the field values (in that order of authority).
function checkGenericRecord(
  env: Env, fx: FnCtx, span: Span, g: usize, name: Ident, targs: Option<TypeExpr[]>, spread: Option<Expr>,
  fields: FieldInit[], exp: Option<Type>
): Result<ExprOut, Diagnostic> {
  const gt = env.gtypes[g];
  const fdecls = match (gt.decl.body) {
    DRecord(fs) => fs,
    _ => {
      return Err(diag("E0400", name.span, "`" + name.name + "` is not a record type"));
    }
  };
  match (spread) {
    Some(se) => {
      const s = checkExpr(env, fx, se, None)?;
      const o = originOf(s.fx.env, s.expr.ty);
      let ok = false;
      let rid: usize = 0;
      match (o) {
        Some(inst) => {
          if (inst.kind == 0 && inst.gid == g) {
            ok = true;
            rid = inst.id;
          }
        },
        None => {}
      }
      if (!ok) {
        return Err(diag(
          "E0400", se.span,
          "spread of `" + name.name + "` literal must be an instance of `" + name.name + "`, found `"
            + showType(s.fx.env, s.expr.ty) + "`"
        ));
      }
      return checkRecordOf(env, s.fx, span, rid, spread, fields);
    },
    None => {}
  }
  let idxs: usize[] = [];
  let seen: bool[] = [];
  for (const _f of fdecls) {
    seen.push(false);
  }
  let ptes: TypeExpr[] = [];
  let vals: Expr[] = [];
  for (const f of fields) {
    const io = fieldDeclIndex(fdecls, f.name.name);
    if (io.isNone()) {
      return Err(diag("E0411", f.name.span, "record `" + name.name + "` has no field `" + f.name.name + "`"));
    }
    const idx = io.unwrap();
    if (seen[idx]) {
      return Err(diag("E0411", f.name.span, "field `" + f.name.name + "` given more than once"));
    }
    seen[idx] = true;
    idxs.push(idx);
    ptes.push(fdecls[idx].ty);
    vals.push(f.value);
  }
  let missing: string[] = [];
  let k: usize = 0;
  for (const fd of fdecls) {
    if (!seen[k]) {
      missing.push(fd.name.name);
    }
    k += 1;
  }
  if (missing.length > 0) {
    return Err(diag("E0411", span, "missing field(s) in record literal: " + missing.join(", ")));
  }
  const io = infer(
    env, fx, span, "record `" + name.name + "`", gt.unit, gt.decl.typeParams, ptes,
    Some(selfTypeExpr(gt.decl)), vals, exp, targs
  )?;
  const inst = instType(io.fx.env, g, io.tys, 0, span)?;
  const f2 = withEnv(io.fx, inst.env);
  const rid = match (inst.ty) {
    TyRecord(r) => r,
    _ => 0
  };
  let out: FieldInitH[] = [];
  let i: usize = 0;
  while (i < idxs.length) {
    out.push(FieldInitH { index: idxs[i], value: io.args[i] });
    i += 1;
  }
  return done(f2, XRecord(rid, None, out), TyRecord(rid), span);
}

function checkRecordOf(
  env: Env, fx: FnCtx, span: Span, rid: usize, spread: Option<Expr>, fields: FieldInit[]
): Result<ExprOut, Diagnostic> {
  const def = fx.env.records[rid];
  let cur = fx;
  let sp: Option<HExpr> = None;
  match (spread) {
    Some(s) => {
      const r = expect(env, cur, s, TyRecord(rid))?;
      cur = r.fx;
      sp = Some(r.expr);
    },
    None => {}
  }
  let seen: bool[] = [];
  for (const _f of def.fields) {
    seen.push(false);
  }
  let out: FieldInitH[] = [];
  for (const f of fields) {
    const io = fieldIndex(def.fields, f.name.name);
    if (io.isNone()) {
      return Err(diag("E0411", f.name.span, "record `" + def.name + "` has no field `" + f.name.name + "`"));
    }
    const idx = io.unwrap();
    if (seen[idx]) {
      return Err(diag("E0411", f.name.span, "field `" + f.name.name + "` given more than once"));
    }
    seen[idx] = true;
    const v = expect(env, cur, f.value, def.fields[idx].ty)?;
    cur = v.fx;
    out.push(FieldInitH { index: idx, value: v.expr });
  }
  if (sp.isNone()) {
    let missing: string[] = [];
    let i: usize = 0;
    for (const fd of def.fields) {
      if (!seen[i]) {
        missing.push(fd.name);
      }
      i += 1;
    }
    if (missing.length > 0) {
      return Err(diag("E0411", span, "missing field(s) in record literal: " + missing.join(", ")));
    }
  }
  return done(cur, XRecord(rid, sp, out), TyRecord(rid), span);
}

// ---------------------------------------------------------------------------
// Calls
// ---------------------------------------------------------------------------

function argsExpect(
  env: Env, fx: FnCtx, span: Span, what: string, args: Expr[], params: Type[]
): Result<ArgsOut, Diagnostic> {
  if (args.length != params.length) {
    return Err(diag(
      "E0404",
      span,
      what + " expects " + params.length.toString() + " argument(s), found " + args.length.toString()
    ));
  }
  let cur = fx;
  let out: HExpr[] = [];
  let i: usize = 0;
  for (const a of args) {
    const r = expect(env, cur, a, params[i])?;
    cur = r.fx;
    out.push(r.expr);
    i += 1;
  }
  return Ok(ArgsOut { fx: cur, args: out });
}

function checkCall(
  env: Env, fx: FnCtx, span: Span, callee: Expr, args: Expr[], exp: Option<Type>
): Result<ExprOut, Diagnostic> {
  return match (callee.kind) {
    EIdent(id) => callIdent(env, fx, span, callee, id, args, exp),
    ETyApp(id, targs) => callTyApp(env, fx, span, callee, id, targs, args, exp),
    EMember(base, name) => callMember(env, fx, span, base, name, args),
    _ => Err(diag("E0400", callee.span, "expression is not callable"))
  };
}

function callIdent(
  env: Env, fx: FnCtx, span: Span, callee: Expr, id: Ident, args: Expr[], exp: Option<Type>
): Result<ExprOut, Diagnostic> {
  if (lookupLocal(fx, id.name).isSome()) {
    return Err(diag("E0400", callee.span, "`" + id.name + "` is not a function"));
  }
  const g = globalVal(env, fx.unit, id.name);
  if (g.isNone()) {
    if (id.name == "parseInt") {
      return callBuiltin(env, fx, span, "function `parseInt`", BParseInt, args);
    }
    if (id.name == "Some" || id.name == "Ok" || id.name == "Err") {
      return builtinCtor(env, fx, span, id.name, args, exp);
    }
    return Err(diag("E0300", id.span, "unresolved name `" + id.name + "`"));
  }
  return match (g.unwrap()) {
    VGFunc(gi) => callGeneric(env, fx, span, gi, id, None, args, exp),
    VGVariant(gi, tag) => genericVariant(env, fx, span, gi, tag, None, args, exp),
    VFunc(fid) => {
      const f = fx.env.funcs[fid];
      const a = argsExpect(env, fx, span, "function `" + id.name + "`", args, f.params)?;
      return done(a.fx, XCall(fid, a.args), f.ret, span);
    },
    VVariant(u, tag) => {
      const v = fx.env.unions[u].variants[tag];
      const a = argsExpect(env, fx, span, "variant `" + v.name + "`", args, v.payload)?;
      return done(a.fx, XVariant(tag, a.args), TyUnion(u), span);
    },
    VStd(b) => callBuiltin(env, fx, span, "function `" + id.name + "`", b, args),
    VConst(_) => Err(diag("E0400", callee.span, "`" + id.name + "` is not a function"))
  };
}


// ---------------------------------------------------------------------------
// Generic calls (beyond Orin-B, ADR-0007)
// ---------------------------------------------------------------------------

function callTyApp(
  env: Env, fx: FnCtx, span: Span, callee: Expr, id: Ident, targs: TypeExpr[], args: Expr[], exp: Option<Type>
): Result<ExprOut, Diagnostic> {
  if (lookupLocal(fx, id.name).isSome()) {
    return Err(diag("E0400", callee.span, "`" + id.name + "` is not a function"));
  }
  const g = globalVal(env, fx.unit, id.name);
  if (g.isNone()) {
    return Err(diag("E0300", id.span, "unresolved name `" + id.name + "`"));
  }
  return match (g.unwrap()) {
    VGFunc(gi) => callGeneric(env, fx, span, gi, id, Some(targs), args, exp),
    VGVariant(gi, tag) => genericVariant(env, fx, span, gi, tag, Some(targs), args, exp),
    _ => Err(diag("E0400", callee.span, "`" + id.name + "` is not generic and takes no type arguments"))
  };
}

// Resolves a parameter / result type expression of a generic callee with its type parameters
// bound to `tys` (only mentioned parameters need to be real).
function resolveBound(fx: FnCtx, unit: usize, tp: string[], tys: Type[], te: TypeExpr, voidOk: bool): Result<TyFx, Diagnostic> {
  const sc = TScope { unit: unit, names: tp, tys: tys, depth: 0 };
  const r = resolveType(fx.env, sc, te, voidOk)?;
  return Ok(TyFx { fx: withEnv(fx, r.env), ty: r.ty });
}

function bindsOrVoid(binds: Option<Type>[]): Type[] {
  let out: Type[] = [];
  for (const b of binds) {
    out.push(b.unwrapOr(TyVoid));
  }
  return out;
}

// Infers the type arguments of a call to a generic callee (function, variant constructor or
// record literal) and checks the arguments. Order of authority: explicit type arguments; else
// the expected type; then the arguments left to right (arguments that cannot be typed alone,
// such as `[]` or `None`, and bare integer literals are deferred until the others are known).
// Returns the type arguments and the checked arguments in source order.
function infer(
  env: Env, fx0: FnCtx, span: Span, what: string, unit: usize, tps: Ident[], paramTEs: TypeExpr[],
  retTE: Option<TypeExpr>, args: Expr[], exp: Option<Type>, explicit: Option<TypeExpr[]>
): Result<InferOut, Diagnostic> {
  if (args.length != paramTEs.length) {
    return Err(diag(
      "E0404",
      span,
      what + " expects " + paramTEs.length.toString() + " argument(s), found " + args.length.toString()
    ));
  }
  const tp = paramNameList(tps);
  let fx = fx0;
  let binds = noBinds(tp.length);
  match (explicit) {
    Some(ts) => {
      if (ts.length != tp.length) {
        return Err(diag(
          "E0400",
          span,
          what + " expects " + tp.length.toString() + " type argument(s), found " + ts.length.toString()
        ));
      }
      let k: usize = 0;
      for (const t of ts) {
        const r = resolveFx(fx, t, false)?;
        fx = r.fx;
        binds[k] = Some(r.ty);
        k += 1;
      }
    },
    None => {
      match (exp) {
        Some(et) => {
          match (retTE) {
            Some(rt) => { binds = unify(fx.env, unit, rt, et, tp, binds); },
            None => {}
          }
        },
        None => {}
      }
    }
  }
  let outArgs: Option<HExpr>[] = [];
  for (const _a of args) {
    outArgs.push(None);
  }
  let deferred: usize[] = [];
  let i: usize = 0;
  while (i < args.length) {
    const te = paramTEs[i];
    if (!mentionsUnbound(te, tp, binds)) {
      const pt = resolveBound(fx, unit, tp, bindsOrVoid(binds), te, false)?;
      const r = expect(env, pt.fx, args[i], pt.ty)?;
      fx = r.fx;
      outArgs[i] = Some(r.expr);
    } else if (untypedInt(args[i])) {
      deferred.push(i);
    } else {
      match (checkExpr(env, fx, args[i], None)) {
        Ok(r) => {
          fx = r.fx;
          outArgs[i] = Some(r.expr);
          binds = unify(fx.env, unit, te, r.expr.ty, tp, binds);
        },
        Err(d) => {
          if (d.code == "E0407") {
            deferred.push(i);
          } else {
            return Err(d);
          }
        }
      }
    }
    i += 1;
  }
  // Deferred arguments: resolvable ones are checked against their parameter; others are typed on
  // their own. Bare integer literals (default `int`) go last, one at a time.
  let pending = deferred;
  while (pending.length > 0) {
    let progress = false;
    let rest: usize[] = [];
    let firstErr: Option<Diagnostic> = None;
    for (const di of pending) {
      const te = paramTEs[di];
      if (!mentionsUnbound(te, tp, binds)) {
        const pt = resolveBound(fx, unit, tp, bindsOrVoid(binds), te, false)?;
        const r = expect(env, pt.fx, args[di], pt.ty)?;
        fx = r.fx;
        outArgs[di] = Some(r.expr);
        progress = true;
      } else if (untypedInt(args[di])) {
        rest.push(di);
      } else {
        match (checkExpr(env, fx, args[di], None)) {
          Ok(r) => {
            fx = r.fx;
            outArgs[di] = Some(r.expr);
            binds = unify(fx.env, unit, te, r.expr.ty, tp, binds);
            progress = true;
          },
          Err(d) => {
            if (d.code != "E0407") {
              return Err(d);
            }
            if (firstErr.isNone()) {
              firstErr = Some(d);
            }
            rest.push(di);
          }
        }
      }
    }
    if (!progress) {
      let lit: Option<usize> = None;
      for (const di of rest) {
        if (lit.isNone() && untypedInt(args[di])) {
          lit = Some(di);
        }
      }
      if (lit.isNone()) {
        return Err(firstErr.unwrap());
      }
      const li = lit.unwrap();
      const r = checkExpr(env, fx, args[li], None)?;
      fx = r.fx;
      outArgs[li] = Some(r.expr);
      binds = unify(fx.env, unit, paramTEs[li], r.expr.ty, tp, binds);
      let rest2: usize[] = [];
      for (const di of rest) {
        if (di != li) {
          rest2.push(di);
        }
      }
      rest = rest2;
    }
    pending = rest;
  }
  let tys: Type[] = [];
  let bi: usize = 0;
  for (const b of binds) {
    match (b) {
      Some(t) => {
        if (isVoid(t)) {
          return Err(diag("E0400", span, "type argument `" + tp[bi] + "` of " + what + " cannot be `void`"));
        }
        tys.push(t);
      },
      None => {
        return Err(diag(
          "E0407",
          span,
          "cannot infer type argument `" + tp[bi] + "` of " + what + "; add explicit type arguments or a type annotation"
        ));
      }
    }
    bi += 1;
  }
  let hargs: HExpr[] = [];
  let j: usize = 0;
  for (const oa of outArgs) {
    const he = oa.unwrap();
    const pt = resolveBound(fx, unit, tp, tys, paramTEs[j], false)?;
    fx = pt.fx;
    if (!typeEq(he.ty, pt.ty)) {
      return Err(mismatch(fx.env, args[j].span, pt.ty, he.ty));
    }
    hargs.push(he);
    j += 1;
  }
  return Ok(InferOut { fx: fx, tys: tys, args: hargs });
}

function callGeneric(
  env: Env, fx: FnCtx, span: Span, g: usize, id: Ident, explicit: Option<TypeExpr[]>, args: Expr[],
  exp: Option<Type>
): Result<ExprOut, Diagnostic> {
  const gf = env.gfuncs[g];
  let ptes: TypeExpr[] = [];
  for (const p of gf.decl.params) {
    ptes.push(p.ty);
  }
  const io = infer(
    env, fx, span, "function `" + id.name + "`", gf.unit, gf.decl.typeParams, ptes, gf.decl.ret, args, exp, explicit
  )?;
  let cur = io.fx;
  let ret: Type = TyVoid;
  match (gf.decl.ret) {
    Some(rte) => {
      const r = resolveBound(cur, gf.unit, paramNameList(gf.decl.typeParams), io.tys, rte, true)?;
      cur = r.fx;
      ret = r.ty;
    },
    None => {}
  }
  let fid: usize = 0;
  if (!cur.abs) {
    const fo = instFunc(cur.env, g, io.tys, cur.depth + 1, span)?;
    cur = withEnv(cur, fo.env);
    fid = fo.fid;
  }
  return done(cur, XCall(fid, io.args), ret, span);
}

function genericVariant(
  env: Env, fx: FnCtx, span: Span, g: usize, tag: usize, explicit: Option<TypeExpr[]>, args: Expr[],
  exp: Option<Type>
): Result<ExprOut, Diagnostic> {
  const gt = env.gtypes[g];
  const vs = match (gt.decl.body) {
    DUnion(x) => x,
    _ => {
      return Err(diag("E0400", span, "not a variant constructor"));
    }
  };
  const v = vs[tag];
  const io = infer(
    env, fx, span, "variant `" + v.name.name + "`", gt.unit, gt.decl.typeParams, v.payload,
    Some(selfTypeExpr(gt.decl)), args, exp, explicit
  )?;
  const inst = instType(io.fx.env, g, io.tys, 0, span)?;
  return match (inst.ty) {
    TyUnion(u) => done(withEnv(io.fx, inst.env), XVariant(tag, io.args), TyUnion(u), span),
    _ => Err(diag("E0400", span, "not a variant constructor"))
  };
}

function callBuiltin(
  env: Env, fx: FnCtx, span: Span, what: string, b: Builtin, args: Expr[]
): Result<ExprOut, Diagnostic> {
  const sig = builtinSig(b);
  const a = argsExpect(env, fx, span, what, args, sig.params)?;
  return done(a.fx, XBuiltin(b, a.args), sig.ret, span);
}

function callMember(
  env: Env, fx: FnCtx, span: Span, base: Expr, name: Ident, args: Expr[]
): Result<ExprOut, Diagnostic> {
  match (base.kind) {
    EIdent(bid) => {
      const special = (bid.name == "console" || bid.name == "String")
        && lookupLocal(fx, bid.name).isNone()
        && globalVal(env, fx.unit, bid.name).isNone();
      if (special) {
        let b: Option<Builtin> = None;
        if (bid.name == "console" && name.name == "log") {
          b = Some(BConsoleLog);
        } else if (bid.name == "console" && name.name == "error") {
          b = Some(BConsoleError);
        } else if (bid.name == "String" && name.name == "fromCharCode") {
          b = Some(BStringFromCharCode);
        }
        if (b.isNone()) {
          return Err(diag("E0405", name.span, "`" + bid.name + "` has no member `" + name.name + "`"));
        }
        return callBuiltin(env, fx, span, "`" + bid.name + "." + name.name + "`", b.unwrap(), args);
      }
      if (lookupLocal(fx, bid.name).isNone() && globalVal(env, fx.unit, bid.name).isNone()) {
        const te = findType(env.units[fx.unit].scope, bid.name);
        if (te.isSome()) {
          match (te.unwrap()) {
            EntRecord(r) => {
              const co = classOfRec(fx.env, r);
              if (co.isSome()) {
                return staticCall(env, fx, span, co.unwrap(), name, args);
              }
            },
            _ => {}
          }
        }
      }
    },
    _ => {}
  }
  return methodCall(env, fx, span, base, name, args);
}

function builtinCtor(
  env: Env, fx: FnCtx, span: Span, name: string, args: Expr[], exp: Option<Type>
): Result<ExprOut, Diagnostic> {
  if (name == "Some") {
    return someCtor(env, fx, span, args, exp);
  }
  if (exp.isNone()) {
    // Ok(x) / Err(x) cannot infer the other type parameter.
    let cur = fx;
    for (const a of args) {
      const r = checkExpr(env, cur, a, None)?;
      cur = r.fx;
    }
    if (name == "Ok") {
      return Err(diag("E0407", span, "cannot infer the error type of `Ok(..)`; add a type annotation"));
    }
    return Err(diag("E0407", span, "cannot infer the success type of `Err(..)`; add a type annotation"));
  }
  const et = exp.unwrap();
  return match (et) {
    TyResult(t, e) => name == "Ok" ? okCtor(env, fx, span, args, t, e) : errCtor(env, fx, span, args, t, e),
    _ => Err(diag("E0400", span, "expected `" + showType(fx.env, et) + "`, found a `Result`"))
  };
}

function someCtor(env: Env, fx: FnCtx, span: Span, args: Expr[], exp: Option<Type>): Result<ExprOut, Diagnostic> {
  if (args.length != 1) {
    return Err(diag("E0404", span, "`Some` expects 1 argument, found " + args.length.toString()));
  }
  let inner: Option<Type> = None;
  match (exp) {
    Some(t) => {
      match (t) {
        TyOption(x) => { inner = Some(x); },
        _ => {}
      }
    },
    None => {}
  }
  const p = match (inner) {
    Some(x) => expect(env, fx, args[0], x)?,
    None => checkExpr(env, fx, args[0], None)?
  };
  if (isVoid(p.expr.ty)) {
    return Err(diag("E0400", args[0].span, "`Option<void>` is not allowed"));
  }
  return done(p.fx, XVariant(0, [p.expr]), TyOption(p.expr.ty), span);
}

function okCtor(
  env: Env, fx: FnCtx, span: Span, args: Expr[], t: Type, e: Type
): Result<ExprOut, Diagnostic> {
  const want: usize = isVoid(t) ? 0 : 1;
  if (args.length != want) {
    return Err(diag("E0404", span, "`Ok` expects " + want.toString() + " argument(s), found " + args.length.toString()));
  }
  if (want == 0) {
    return done(fx, XVariant(0, noExprs()), TyResult(t, e), span);
  }
  const p = expect(env, fx, args[0], t)?;
  return done(p.fx, XVariant(0, [p.expr]), TyResult(t, e), span);
}

function errCtor(
  env: Env, fx: FnCtx, span: Span, args: Expr[], t: Type, e: Type
): Result<ExprOut, Diagnostic> {
  if (args.length != 1) {
    return Err(diag("E0404", span, "`Err` expects 1 argument, found " + args.length.toString()));
  }
  const p = expect(env, fx, args[0], e)?;
  return done(p.fx, XVariant(1, [p.expr]), TyResult(t, e), span);
}

function isPlaceShaped(fx: FnCtx, base: Expr): bool {
  return match (base.kind) {
    EIdent(id) => lookupLocal(fx, id.name).isSome(),
    EThis => true,
    EMember(_, _) => true,
    EIndex(_, _) => true,
    _ => false
  };
}

function methodCall(
  env: Env, fx: FnCtx, span: Span, base: Expr, name: Ident, args: Expr[]
): Result<ExprOut, Diagnostic> {
  const n = name.name;
  const bo = checkExpr(env, fx, base, None);
  if (bo.isOk()) {
    const b0 = bo.unwrap();
    match (b0.expr.ty) {
      TyRecord(r) => {
        const co = classOfRec(b0.fx.env, r);
        if (co.isSome()) {
          return classMethodCall(env, b0.fx, span, base, b0, co.unwrap(), name, args);
        }
      },
      _ => {}
    }
  }
  if (n == "push" || n == "pop") {
    return mutMethodCall(env, fx, span, base, name, args);
  }
  const b = bo?;
  const so = methodSig(b.expr.ty, n);
  if (so.isNone()) {
    return Err(diag("E0405", name.span, "no method `" + n + "` on type `" + showType(b.fx.env, b.expr.ty) + "`"));
  }
  const s = so.unwrap();
  const a = argsExpect(env, b.fx, span, "method `" + n + "`", args, s.params)?;
  let all: HExpr[] = [b.expr];
  for (const x of a.args) {
    all.push(x);
  }
  return done(a.fx, XBuiltin(s.op, all), s.ret, span);
}

function mutMethodCall(
  env: Env, fx: FnCtx, span: Span, base: Expr, name: Ident, args: Expr[]
): Result<ExprOut, Diagnostic> {
  const n = name.name;
  if (isPlaceShaped(fx, base)) {
    const pi = checkPlace(env, fx, base)?;
    return match (pi.place.ty) {
      TyArray(t) => {
        if (!pi.mutable) {
          return Err(diag(
            "E0401",
            base.span,
            "cannot call `" + n + "` on `" + pi.rootName + "`: it is not declared with `let`"
          ));
        }
        const isPush = n == "push";
        const params: Type[] = isPush ? [t] : [];
        const a = argsExpect(env, markMut(pi.fx, pi.place), span, "method `" + n + "`", args, params)?;
        const op: MutBuiltin = isPush ? MArrPush : MArrPop;
        const ret: Type = isPush ? TyVoid : TyOption(t);
        return done(a.fx, XMutMethod(op, pi.place, a.args), ret, span);
      },
      _ => Err(diag("E0405", name.span, "no method `" + n + "` on type `" + showType(pi.fx.env, pi.place.ty) + "`"))
    };
  }
  const b = checkExpr(env, fx, base, None)?;
  if (isArrayTy(b.expr.ty)) {
    return Err(diag("E0401", base.span, "receiver of `" + n + "` must be a mutable place"));
  }
  return Err(diag("E0405", name.span, "no method `" + n + "` on type `" + showType(b.fx.env, b.expr.ty) + "`"));
}

// ---------------------------------------------------------------------------
// Places
// ---------------------------------------------------------------------------

function extendPath(p: Place, elem: PlaceElem, ty: Type): Place {
  let path = p.path;
  path.push(elem);
  return Place { root: p.root, path: path, ty: ty };
}

function checkPlace(env: Env, fx: FnCtx, e: Expr): Result<PlaceOut, Diagnostic> {
  return match (e.kind) {
    EIdent(id) => {
      const lo = lookupLocal(fx, id.name);
      if (lo.isSome()) {
        const l = lo.unwrap();
        const loc = fx.locals[l];
        const path: PlaceElem[] = [];
        return Ok(PlaceOut {
          fx: fx,
          place: Place { root: l, path: path, ty: loc.ty },
          mutable: loc.mutable,
          rootName: id.name
        });
      }
      if (globalVal(env, fx.unit, id.name).isSome()) {
        return Err(diag("E0401", e.span, "cannot assign to `" + id.name + "`"));
      }
      return Err(diag("E0300", id.span, "unresolved name `" + id.name + "`"));
    },
    EThis => {
      const lo = lookupLocal(fx, "this");
      if (lo.isNone()) {
        return Err(thisErr(fx, e.span));
      }
      const l = lo.unwrap();
      const path: PlaceElem[] = [];
      return Ok(PlaceOut {
        fx: fx,
        place: Place { root: l, path: path, ty: fx.locals[l].ty },
        mutable: fx.locals[l].mutable,
        rootName: "this"
      });
    },
    EMember(base, name) => {
      const p = checkPlace(env, fx, base)?;
      return match (p.place.ty) {
        TyRecord(r) => {
          const def = p.fx.env.records[r];
          const io = fieldIndex(def.fields, name.name);
          if (io.isNone()) {
            return Err(diag("E0405", name.span, "no field `" + name.name + "` on type `" + def.name + "`"));
          }
          checkFieldAccess(p.fx, r, name)?;
          const i = io.unwrap();
          return Ok(PlaceOut {
            fx: p.fx,
            place: extendPath(p.place, PField(r, i), def.fields[i].ty),
            mutable: p.mutable,
            rootName: p.rootName
          });
        },
        TyString => name.name == "length"
          ? Err(diag("E0401", e.span, "`length` is read-only"))
          : Err(noField(fx.env, name, p.place.ty)),
        TyArray(_) => name.name == "length"
          ? Err(diag("E0401", e.span, "`length` is read-only"))
          : Err(noField(fx.env, name, p.place.ty)),
        _ => Err(noField(fx.env, name, p.place.ty))
      };
    },
    EIndex(base, index) => {
      const p = checkPlace(env, fx, base)?;
      return match (p.place.ty) {
        TyArray(t) => {
          const idx = expect(env, p.fx, index, TyUsize)?;
          return Ok(PlaceOut {
            fx: idx.fx,
            place: extendPath(p.place, PIndex(idx.expr), t),
            mutable: p.mutable,
            rootName: p.rootName
          });
        },
        _ => Err(diag("E0400", e.span, "cannot index into type `" + showType(p.fx.env, p.place.ty) + "`"))
      };
    },
    _ => Err(diag("E0401", e.span, "expression is not an assignable place"))
  };
}

// ---------------------------------------------------------------------------
// Match
// ---------------------------------------------------------------------------

function variantsOf(env: Env, t: Type): Option<VariantDef[]> {
  return match (t) {
    TyUnion(u) => Some(env.unions[u].variants),
    TyOption(x) => Some([VariantDef { name: "Some", payload: [x] }, VariantDef { name: "None", payload: noTypes() }]),
    TyResult(a, b) => Some([
      VariantDef { name: "Ok", payload: isVoid(a) ? noTypes() : [a] },
      VariantDef { name: "Err", payload: [b] }
    ]),
    _ => None
  };
}

function noTypes(): Type[] {
  const xs: Type[] = [];
  return xs;
}

function isLiteralScrut(t: Type): bool {
  return isIntish(t) || isString(t) || isBool(t);
}

function exprAsMatch(e: Expr): Option<Expr> {
  return match (e.kind) {
    EMatch(_, _) => Some(e),
    _ => None
  };
}

// One match arm: returns the arm plus whether it diverges and the (possibly inferred) target type.
type ArmOut = { fx: FnCtx; arm: HArm; div: bool; target: Option<Type>; covered: bool[]; wild: bool; };

function checkArm(
  env: Env, fx0: FnCtx, arm: MatchArm, sty: Type, variants: Option<VariantDef[]>, covered: bool[],
  wild: bool, target: Option<Type>, stmtPos: bool
): Result<ArmOut, Diagnostic> {
  const fx1 = pushScope(fx0);
  const po = checkPattern(env, fx1, arm.pattern, sty, variants, covered, wild)?;
  let cur = po.fx;
  const outerPre = cur.pre;
  const noPre: HStmt[] = [];
  cur.pre = noPre;
  let body: HBlock = HBlock { stmts: [] };
  let value: Option<HExpr> = None;
  let div = false;
  let tgt = target;
  match (arm.body) {
    BExpr(e) => {
      if (stmtPos) {
        let he: HExpr = mk(XBool(false), TyBool, e.span);
        match (e.kind) {
          EMatch(sc, inner) => {
            const m = checkMatch(env, cur, e.span, sc, inner, None, true)?;
            cur = m.fx;
            he = m.expr;
            div = m.div;
          },
          _ => {
            const r = checkExpr(env, cur, e, None)?;
            cur = r.fx;
            he = r.expr;
          }
        }
        body = isNop(he) ? HBlock { stmts: [] } : HBlock { stmts: [HExprStmt(he)] };
      } else {
        match (tgt) {
          Some(t) => {
            const r = expect(env, cur, e, t)?;
            cur = r.fx;
            value = Some(r.expr);
          },
          None => {
            const r = checkExpr(env, cur, e, None)?;
            cur = r.fx;
            tgt = Some(r.expr.ty);
            value = Some(r.expr);
          }
        }
      }
    },
    BBlock(b) => {
      const bo = checkBlock(env, cur, b)?;
      cur = bo.fx;
      if (!stmtPos && !bo.div) {
        let d = diag(
          "E0400",
          b.span,
          "block arm of a match used as an expression must end in `return`, `break` or `continue`"
        );
        d.notes.push("a block arm has no value; use an expression arm to produce a value");
        return Err(d);
      }
      body = bo.block;
      div = bo.div;
    }
  }
  if (cur.pre.length > 0) {
    let all: HStmt[] = [];
    for (const h of cur.pre) {
      all.push(h);
    }
    for (const h of body.stmts) {
      all.push(h);
    }
    body = HBlock { stmts: all };
  }
  cur.pre = outerPre;
  cur = popScope(cur);
  return Ok(ArmOut {
    fx: cur,
    arm: HArm { pattern: po.pat, body: body, value: value },
    div: div,
    target: tgt,
    covered: po.covered,
    wild: po.wild
  });
}

function checkMatch(
  env: Env, fx: FnCtx, span: Span, scrut: Expr, arms: MatchArm[], exp: Option<Type>, stmtPos: bool
): Result<MatchOut, Diagnostic> {
  const s = checkExpr(env, fx, scrut, None)?;
  const sty = s.expr.ty;
  const variants = variantsOf(s.fx.env, sty);
  if (variants.isNone() && !isLiteralScrut(sty)) {
    return Err(diag("E0402", scrut.span, "cannot match on a value of type `" + showType(fx.env, sty) + "`"));
  }
  let covered: bool[] = [];
  if (variants.isSome()) {
    for (const _v of variants.unwrap()) {
      covered.push(false);
    }
  }
  let wild = false;
  let target: Option<Type> = stmtPos ? Some(TyVoid) : exp;
  let cur = s.fx;
  let harms: HArm[] = [];
  let allDiv = true;
  for (const arm of arms) {
    const r = checkArm(env, cur, arm, sty, variants, covered, wild, target, stmtPos)?;
    cur = r.fx;
    target = r.target;
    allDiv = allDiv && r.div;
    harms.push(r.arm);
    covered = r.covered;
    wild = r.wild;
  }
  if (!wild) {
    if (variants.isSome()) {
      let missing: string[] = [];
      let i: usize = 0;
      for (const v of variants.unwrap()) {
        if (!covered[i]) {
          missing.push(v.name);
        }
        i += 1;
      }
      if (missing.length > 0) {
        return Err(diag("E0402", span, "non-exhaustive match: missing " + missing.join(", ")));
      }
    } else {
      return Err(diag("E0402", span, "match on a scalar value requires a `_` arm"));
    }
  }
  if (target.isNone()) {
    return Err(diag("E0407", span, "cannot infer the type of a match whose arms all diverge"));
  }
  const ty = target.unwrap();
  const div = stmtPos && arms.length > 0 && allDiv;
  return Ok(MatchOut { fx: cur, expr: mk(XMatch(s.expr, harms), ty, span), div: div });
}

// ---------------------------------------------------------------------------
// Statements
// ---------------------------------------------------------------------------

export function checkBlock(env: Env, fx: FnCtx, b: Block): Result<BlockOut, Diagnostic> {
  let cur = pushScope(fx);
  let stmts: HStmt[] = [];
  let div = false;
  for (const s of b.stmts) {
    // Statements hoisted out of this statement's expressions (mutating method calls) go first;
    // the pending list of an enclosing statement is set aside meanwhile.
    const outer = cur.pre;
    const none: HStmt[] = [];
    cur.pre = none;
    const r = checkStmt(env, cur, s)?;
    cur = r.fx;
    for (const h of cur.pre) {
      stmts.push(h);
    }
    cur.pre = outer;
    stmts.push(r.stmt);
    div = r.div;
  }
  cur = popScope(cur);
  return Ok(BlockOut { fx: cur, block: HBlock { stmts: stmts }, div: div });
}

function sout(fx: FnCtx, stmt: HStmt, div: bool): Result<StmtOut, Diagnostic> {
  return Ok(StmtOut { fx: fx, stmt: stmt, div: div });
}

function checkStmt(env: Env, fx: FnCtx, s: Stmt): Result<StmtOut, Diagnostic> {
  return match (s.kind) {
    SLet(mutable, name, ty, init) => stmtLet(env, fx, mutable, name, ty, init),
    SAssign(target, op, value) => stmtAssign(env, fx, target, op, value),
    SExpr(e) => stmtExpr(env, fx, e),
    SReturn(v) => stmtReturn(env, fx, s.span, v),
    SIf(c, thenB, els) => stmtIf(env, fx, c, thenB, els),
    SWhile(c, body) => stmtWhile(env, fx, c, body),
    SForOf(name, iter, body) => stmtForOf(env, fx, name, iter, body),
    SBreak => {
      if (fx.loops.length == 0) {
        return Err(diag("E0409", s.span, "`break` outside of a loop"));
      }
      return sout(markBreak(fx), HBreak, true);
    },
    SContinue => {
      if (fx.loops.length == 0) {
        return Err(diag("E0409", s.span, "`continue` outside of a loop"));
      }
      return sout(fx, HContinue, true);
    },
    SBlock(b) => {
      const r = checkBlock(env, fx, b)?;
      return sout(r.fx, HBlockStmt(r.block), r.div);
    }
  };
}

function letInit(env: Env, fx: FnCtx, ty: Option<TypeExpr>, init: Expr): Result<LetInit, Diagnostic> {
  return match (ty) {
    Some(te) => {
      const tr = resolveFx(fx, te, false)?;
      const t = tr.ty;
      const e = expect(env, tr.fx, init, t)?;
      return Ok(LetInit { fx: e.fx, expr: e.expr, ty: t });
    },
    None => {
      const e = checkExpr(env, fx, init, None)?;
      return Ok(LetInit { fx: e.fx, expr: e.expr, ty: e.expr.ty });
    }
  };
}

function stmtLet(
  env: Env, fx: FnCtx, mutable: bool, name: Ident, ty: Option<TypeExpr>, init: Expr
): Result<StmtOut, Diagnostic> {
  const li = letInit(env, fx, ty, init)?;
  if (isVoid(li.ty)) {
    return Err(diag("E0400", init.span, "cannot bind a `void` value to a variable"));
  }
  if (declaredInScope(li.fx, name.name)) {
    return Err(diag("E0304", name.span, "`" + name.name + "` is already declared in this block"));
  }
  const nl = newLocal(li.fx, name.name, li.ty, mutable);
  const f2 = declare(nl.fx, name, nl.id)?;
  return sout(f2, HLet(nl.id, li.expr), false);
}

function assignOpOf(op: AssignOp): Option<BinOp> {
  return match (op) {
    OpAssign => None,
    OpAddAssign => Some(OpAdd),
    OpSubAssign => Some(OpSub),
    OpMulAssign => Some(OpMul),
    OpDivAssign => Some(OpDiv),
    OpRemAssign => Some(OpRem)
  };
}

function isAddOp(o: BinOp): bool {
  return match (o) { OpAdd => true, _ => false };
}

function stmtAssign(env: Env, fx: FnCtx, target: Expr, op: AssignOp, value: Expr): Result<StmtOut, Diagnostic> {
  const pi = checkPlace(env, fx, target)?;
  if (!pi.mutable) {
    return Err(diag(
      "E0401",
      target.span,
      "cannot assign to `" + pi.rootName + "`: it is not declared with `let`"
    ));
  }
  const pty = pi.place.ty;
  const hop = assignOpOf(op);
  if (hop.isSome()) {
    const o = hop.unwrap();
    const ok = isIntish(pty) || (isAddOp(o) && isString(pty));
    if (!ok) {
      return Err(diag(
        "E0410",
        target.span,
        "compound assignment is not defined for type `" + showType(fx.env, pty) + "`"
      ));
    }
  }
  const v = expect(env, markMut(pi.fx, pi.place), value, pty)?;
  return sout(v.fx, HAssign(pi.place, hop, v.expr), false);
}

function stmtExpr(env: Env, fx: FnCtx, e: Expr): Result<StmtOut, Diagnostic> {
  return match (e.kind) {
    EMatch(sc, arms) => {
      const m = checkMatch(env, fx, e.span, sc, arms, None, true)?;
      return sout(m.fx, HExprStmt(m.expr), m.div);
    },
    _ => {
      const r = checkExpr(env, fx, e, None)?;
      if (isNop(r.expr)) {
        return sout(r.fx, HBlockStmt(HBlock { stmts: [] }), false);
      }
      return sout(r.fx, HExprStmt(r.expr), false);
    }
  };
}

function stmtReturn(env: Env, fx: FnCtx, span: Span, v: Option<Expr>): Result<StmtOut, Diagnostic> {
  return match (v) {
    None => {
      if (!isVoid(fx.ret)) {
        return Err(diag("E0400", span, "`return;` in a function returning `" + showType(fx.env, fx.ret) + "`"));
      }
      if (fx.fmode == 1 || fx.fmode == 3) {
        return sout(fx, HReturn(Some(thisRead(fx, span))), true);
      }
      return sout(fx, HReturn(None), true);
    },
    Some(e) => {
      if (isVoid(fx.ret)) {
        return Err(diag("E0400", e.span, "cannot return a value from a function returning `void`"));
      }
      const r = expect(env, fx, e, fx.ret)?;
      if (fx.fmode == 4) {
        const rid = match (fx.lret) { TyRecord(x) => x, _ => 0 };
        // The result is computed first (it may mutate `this`), then `this` is read.
        let f1 = r.fx;
        const nl = newLocal(f1, "$v" + f1.tmps.toString(), r.expr.ty, false);
        f1 = nl.fx;
        f1.tmps += 1;
        f1.pre.push(HLet(nl.id, r.expr));
        const val = mk(XLocal(nl.id), r.expr.ty, span);
        const wrapped = mk(
          XRecord(rid, None, [FieldInitH { index: 0, value: thisRead(f1, span) }, FieldInitH { index: 1, value: val }]),
          fx.lret,
          span
        );
        return sout(f1, HReturn(Some(wrapped)), true);
      }
      return sout(r.fx, HReturn(Some(r.expr)), true);
    }
  };
}

function elseBranch(env: Env, fx: FnCtx, els: Option<Stmt>): Result<ElseOut, Diagnostic> {
  return match (els) {
    None => Ok(ElseOut { fx: fx, block: None, div: false }),
    Some(es) => match (es.kind) {
      SBlock(b) => {
        const r = checkBlock(env, fx, b)?;
        return Ok(ElseOut { fx: r.fx, block: Some(r.block), div: r.div });
      },
      _ => {
        const outer = fx.pre;
        let f0 = fx;
        const none: HStmt[] = [];
        f0.pre = none;
        const r = checkStmt(env, f0, es)?;
        let stmts: HStmt[] = [];
        for (const h of r.fx.pre) {
          stmts.push(h);
        }
        stmts.push(r.stmt);
        let f1 = r.fx;
        f1.pre = outer;
        return Ok(ElseOut { fx: f1, block: Some(HBlock { stmts: stmts }), div: r.div });
      }
    }
  };
}

function stmtIf(env: Env, fx: FnCtx, cond: Expr, thenB: Block, els: Option<Stmt>): Result<StmtOut, Diagnostic> {
  const c = expect(env, fx, cond, TyBool)?;
  const t = checkBlock(env, c.fx, thenB)?;
  const e = elseBranch(env, t.fx, els)?;
  const div = t.div && els.isSome() && e.div;
  return sout(e.fx, HIf(c.expr, t.block, e.block), div);
}

function isTrueLit(e: HExpr): bool {
  return match (e.kind) {
    XBool(b) => b,
    _ => false
  };
}

function stmtWhile(env: Env, fx: FnCtx, cond: Expr, body: Block): Result<StmtOut, Diagnostic> {
  const c = expect(env, fx, cond, TyBool)?;
  if (c.fx.pre.length > fx.pre.length) {
    return Err(condHoistErr(cond.span));
  }
  const b = checkBlock(env, pushLoop(c.fx), body)?;
  const lp = popLoop(b.fx);
  return sout(lp.fx, HWhile(c.expr, b.block), isTrueLit(c.expr) && !lp.broke);
}

function stmtForOf(env: Env, fx: FnCtx, name: Ident, iter: Expr, body: Block): Result<StmtOut, Diagnostic> {
  const it = checkExpr(env, fx, iter, None)?;
  return match (it.expr.ty) {
    TyArray(elem) => {
      const nl = newLocal(pushScope(it.fx), name.name, elem, false);
      const f2 = declare(nl.fx, name, nl.id)?;
      const b = checkBlock(env, pushLoop(f2), body)?;
      const lp = popLoop(b.fx);
      return sout(popScope(lp.fx), HForOf(nl.id, it.expr, b.block), false);
    },
    _ => Err(diag(
      "E0400",
      iter.span,
      "`for ... of` requires an array, found `" + showType(it.fx.env, it.expr.ty) + "`"
    ))
  };
}

// ---------------------------------------------------------------------------
// Classes (beyond Orin-B, ADR-0009)
// ---------------------------------------------------------------------------

// The void marker returned for a hoisted mutating call: the statement `p = C.m(p, ..)` is already in
// `fx.pre`; a statement whose expression is this marker emits nothing more.
function isNop(e: HExpr): bool {
  return match (e.kind) {
    XBool(_) => isVoid(e.ty),
    _ => false
  };
}

function nopExpr(span: Span): HExpr {
  return mk(XBool(false), TyVoid, span);
}

function condHoistErr(span: Span): Diagnostic {
  return diag(
    "E0408",
    span,
    "a call to a mutating method is not allowed in a conditionally evaluated expression (`&&`/`||` operand, `?:` branch, `while` condition); move it into its own statement"
  );
}

// True inside the constructor / methods of class `c` (private members are visible there).
function inClass(fx: FnCtx, c: usize): bool {
  return fx.fmode != 0 && fx.fcls == c;
}

function thisErr(fx: FnCtx, span: Span): Diagnostic {
  if (fx.fmode == 1) {
    return diag("E0300", span, "`this` cannot be used before every field is initialized by the leading `this.f = e;` statements of the constructor");
  }
  if (fx.fmode == 5) {
    return diag("E0300", span, "`this` is not available in a static method");
  }
  return diag("E0300", span, "`this` can only be used inside a class constructor or method");
}

function thisRead(fx: FnCtx, span: Span): HExpr {
  const l = lookupLocal(fx, "this").unwrapOr(0);
  return mk(XLocal(l), fx.locals[l].ty, span);
}

function checkThis(fx: FnCtx, span: Span): Result<ExprOut, Diagnostic> {
  const lo = lookupLocal(fx, "this");
  if (lo.isNone()) {
    return Err(thisErr(fx, span));
  }
  const l = lo.unwrap();
  return done(fx, XLocal(l), fx.locals[l].ty, span);
}

function checkFieldAccess(fx: FnCtx, r: usize, name: Ident): Result<bool, Diagnostic> {
  const co = classOfRec(fx.env, r);
  if (co.isSome()) {
    const c = co.unwrap();
    const ci = fx.env.classes[c];
    if (fieldIsPrivate(ci, name.name) && !inClass(fx, c)) {
      return Err(diag("E0405", name.span, "field `" + name.name + "` of class `" + ci.name + "` is private"));
    }
  }
  return Ok(true);
}

// Records that the `this` of the method being analysed is mutated through `place`.
function markMut(fx: FnCtx, place: Place): FnCtx {
  const t = lookupLocal(fx, "this");
  if (t.isSome() && t.unwrap() == place.root) {
    let f = fx;
    f.mutThis = true;
    return f;
  }
  return fx;
}

function checkNew(
  env: Env, fx: FnCtx, span: Span, name: Ident, targs: TypeExpr[], args: Expr[]
): Result<ExprOut, Diagnostic> {
  if (targs.length > 0) {
    return Err(diag("E0408", name.span, "generic classes are not supported yet (ADR-0009)"));
  }
  const found = findType(env.units[fx.unit].scope, name.name);
  if (found.isNone()) {
    return Err(diag("E0300", name.span, "unknown class `" + name.name + "`"));
  }
  const co = match (found.unwrap()) {
    EntRecord(r) => classOfRec(fx.env, r),
    _ => None
  };
  if (co.isNone()) {
    return Err(diag("E0400", name.span, "`" + name.name + "` is not a class"));
  }
  const ci = fx.env.classes[co.unwrap()];
  const f = fx.env.funcs[ci.ctor];
  const a = argsExpect(env, fx, span, "constructor of `" + name.name + "`", args, f.params)?;
  return done(a.fx, XCall(ci.ctor, a.args), TyRecord(ci.rec), span);
}

function tailTypes(ts: Type[]): Type[] {
  let out: Type[] = [];
  let i: usize = 1;
  while (i < ts.length) {
    out.push(ts[i]);
    i += 1;
  }
  return out;
}

function staticCall(
  env: Env, fx: FnCtx, span: Span, c: usize, name: Ident, args: Expr[]
): Result<ExprOut, Diagnostic> {
  const ci = fx.env.classes[c];
  const mo = findMethod(ci, name.name);
  if (mo.isNone()) {
    return Err(diag("E0405", name.span, "class `" + ci.name + "` has no static method `" + name.name + "`"));
  }
  const mi = ci.methods[mo.unwrap()];
  if (mi.priv && !inClass(fx, c)) {
    return Err(diag("E0405", name.span, "method `" + name.name + "` of class `" + ci.name + "` is private"));
  }
  if (!mi.isStatic) {
    return Err(diag("E0405", name.span, "`" + name.name + "` is an instance method of `" + ci.name + "`; call it on a value"));
  }
  const f = fx.env.funcs[mi.fid];
  const a = argsExpect(env, fx, span, "method `" + name.name + "`", args, f.params)?;
  return done(a.fx, XCall(mi.fid, a.args), f.ret, span);
}

// Receiver index expressions are evaluated twice by the lowering `p = C.m(p, ..)`; only
// side-effect-free ones are accepted.
function pureH(e: HExpr): bool {
  return match (e.kind) {
    XInt(_) => true,
    XBool(_) => true,
    XStr(_) => true,
    XLocal(_) => true,
    XField(b, _, _) => pureH(b),
    XIndex(a, i) => pureH(a) && pureH(i),
    XUnary(_, a) => pureH(a),
    XBinary(_, a, b) => pureH(a) && pureH(b),
    XBuiltin(b, xs) => {
      let ok = match (b) {
        BArrLength => true,
        BStrLength => true,
        BIntToUsize => true,
        BUsizeToInt => true,
        _ => false
      };
      for (const x of xs) {
        ok = ok && pureH(x);
      }
      return ok;
    },
    _ => false
  };
}

function purePlace(p: Place): bool {
  for (const el of p.path) {
    match (el) {
      PIndex(ix) => {
        if (!pureH(ix)) {
          return false;
        }
      },
      PField(_, _) => {}
    }
  }
  return true;
}

// `recv.m(args)` where the receiver has class type `c` (already checked as `b`).
function classMethodCall(
  env: Env, fx0: FnCtx, span: Span, base: Expr, b: ExprOut, c: usize, name: Ident, args: Expr[]
): Result<ExprOut, Diagnostic> {
  const ci = fx0.env.classes[c];
  const mo = findMethod(ci, name.name);
  if (mo.isNone()) {
    return Err(diag("E0405", name.span, "no method `" + name.name + "` on class `" + ci.name + "`"));
  }
  const mi = ci.methods[mo.unwrap()];
  if (mi.priv && !inClass(fx0, c)) {
    return Err(diag("E0405", name.span, "method `" + name.name + "` of class `" + ci.name + "` is private"));
  }
  if (mi.isStatic) {
    return Err(diag("E0405", name.span, "`" + name.name + "` is a static method; call it as `" + ci.name + "." + name.name + "(..)`"));
  }
  const f = fx0.env.funcs[mi.fid];
  const a = argsExpect(env, fx0, span, "method `" + name.name + "`", args, tailTypes(f.params))?;
  let all: HExpr[] = [b.expr];
  for (const x of a.args) {
    all.push(x);
  }
  if (!mi.mutating) {
    return done(a.fx, XCall(mi.fid, all), f.srcRet, span);
  }
  if (!isPlaceShaped(a.fx, base)) {
    return Err(diag(
      "E0401",
      base.span,
      "receiver of mutating method `" + name.name + "` must be a mutable place (a `let` variable, field or element)"
    ));
  }
  const pi = checkPlace(env, a.fx, base)?;
  if (!pi.mutable) {
    return Err(diag(
      "E0401",
      base.span,
      "cannot call mutating method `" + name.name + "` on `" + pi.rootName + "`: it is not declared with `let`"
    ));
  }
  let fx = markMut(pi.fx, pi.place);
  if (fx.probe) {
    if (mi.hasRet) {
      return done(fx, XCall(mi.fid, noExprs()), f.srcRet, span);
    }
    return Ok(ExprOut { fx: fx, expr: nopExpr(span) });
  }
  if (!purePlace(pi.place)) {
    return Err(diag(
      "E0408",
      base.span,
      "the receiver of mutating method `" + name.name + "` must not contain index expressions with side effects"
    ));
  }
  const call = mk(XCall(mi.fid, all), f.ret, span);
  if (!mi.hasRet) {
    fx.pre.push(HAssign(pi.place, None, call));
    return Ok(ExprOut { fx: fx, expr: nopExpr(span) });
  }
  const tmpName = "$r" + fx.tmps.toString();
  fx.tmps += 1;
  const nl = newLocal(fx, tmpName, f.ret, false);
  fx = nl.fx;
  const tmp = mk(XLocal(nl.id), f.ret, span);
  fx.pre.push(HLet(nl.id, call));
  const selfTy = TyRecord(ci.rec);
  fx.pre.push(HAssign(pi.place, None, mk(XField(tmp, mi.retRec, 0), selfTy, span)));
  return done(fx, XField(tmp, mi.retRec, 1), f.srcRet, span);
}
