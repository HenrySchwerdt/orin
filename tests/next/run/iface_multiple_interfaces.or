// A class implements several interfaces; each conversion has its own vtable.
interface Named {
  label(): string;
}

interface Sized {
  size(): int;
}

class File implements Named, Sized {
  constructor(public name: string, public bytes: int) {}
  label(): string { return this.name; }
  size(): int { return this.bytes; }
}

class Dir implements Sized {
  size(): int { return 0; }
}

function show(n: Named): string { return "<" + n.label() + ">"; }
function weigh(s: Sized): int { return s.size(); }

function main(): void {
  const f = new File("a.txt", 10);
  console.log(show(f) + weigh(f).toString());
  const all: Sized[] = [f, new Dir(), new File("b", 5)];
  let sum = 0;
  for (const s of all) {
    sum += weigh(s);
  }
  console.log(sum.toString());
}
