import { Graph, graphErrorMessage, StaleId, ForeignId, GraphError } from "std:graph";

function describe<T>(r: Result<T, GraphError>): string {
  return match (r) {
    Ok(v) => "ok",
    Err(e) => graphErrorMessage(e)
  };
}

function describeVoid(r: Result<void, GraphError>): string {
  return match (r) {
    Ok => "ok",
    Err(e) => graphErrorMessage(e)
  };
}

function main(): void {
  let g = new Graph<int>(5);
  const a = g.add(10);
  const b = g.add(20);
  g.remove(a).unwrap();
  console.log(g.size().toString());
  console.log(describe(g.get(a)));
  console.log(describeVoid(g.set(a, 1)));
  console.log(describe(g.remove(a)));
  console.log(describe(g.neighbors(a)));
  console.log(describeVoid(g.addEdge(a, b)));
  console.log(describeVoid(g.addEdge(b, a)));
  console.log(g.contains(a).toString());
  console.log(g.get(b).unwrap().toString());
  match (g.get(a)) {
    Ok(v) => { console.log("?"); },
    Err(e) => {
      match (e) {
        StaleId => { console.log("matched StaleId"); },
        ForeignId => { console.log("wrong"); }
      }
    }
  }
  // a failed operation does not change the graph
  console.log(g.size().toString() + " " + g.ids().length.toString());
}
