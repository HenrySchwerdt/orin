// Word-frequency counting with the built-in Map<string, int>: 1,000,000 updates over 50,000 distinct keys.
function main(): void {
  let freq = new Map<string, int>();
  let i = 0;
  while (i < 1000000) {
    const key = "w" + ((i * 7919) % 50000).toString();
    freq.set(key, freq.get(key).unwrapOr(0) + 1);
    i += 1;
  }
  let check = 0;
  for (const e of freq.entries()) {
    check += e.value * (e.key.length.toInt());
  }
  console.log("distinct: " + freq.size.toString());
  console.log("check: " + check.toString());
  console.log("w123: " + freq.get("w123").unwrapOr(0).toString());
}
