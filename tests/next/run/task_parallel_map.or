// std:task: parallelMap maps a function over chunks of an array in several tasks; the result is in order and equal to the
// sequential map for every number of parts.
import { parallelMap } from "std:task";

function collatz(n: int): int {
  let x = n;
  let steps = 0;
  while (x != 1) {
    x = x % 2 == 0 ? x / 2 : 3 * x + 1;
    steps += 1;
  }
  return steps;
}

function main(): void {
  let xs: int[] = [];
  let i = 1;
  while (i <= 2000) {
    xs.push(i);
    i += 1;
  }
  const want = xs.map(collatz);
  let ok = true;
  const partCounts: usize[] = [0, 1, 2, 3, 4, 7, 16, 5000];
  for (const parts of partCounts) {
    const got = parallelMap(xs, collatz, parts);
    if (got.length != want.length) {
      ok = false;
    }
    let k: usize = 0;
    while (k < want.length && k < got.length) {
      if (got[k] != want[k]) {
        ok = false;
      }
      k += 1;
    }
  }
  console.log(ok ? "all equal" : "MISMATCH");
  console.log(parallelMap(["a", "bb", "ccc"], s => s.length.toString(), 2).join(","));
  const empty: int[] = [];
  console.log(parallelMap(empty, collatz, 4).length.toString());
}
