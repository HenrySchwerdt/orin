function show(xs: int[]): string {
  let s = "[";
  let i: usize = 0;
  while (i < xs.length) {
    if (i > 0) { s = s + ","; }
    s = s + xs[i].toString();
    i += 1;
  }
  return s + "]";
}

function showOpt(o: Option<int>): void {
  match (o) {
    Some(v) => { console.log("some " + v.toString()); },
    None => { console.log("none"); },
  }
}

function main(): void {
  let xs: int[] = [];
  xs.push(1);
  xs.push(2);
  xs.push(3);
  console.log(show(xs));
  showOpt(xs.pop());
  console.log(show(xs));
  showOpt(xs.pop());
  showOpt(xs.pop());
  showOpt(xs.pop());
  console.log(xs.length.toString());
  xs.push(9);
  console.log(show(xs));
  let ys = [5];
  ys.push(6);
  console.log(show(ys));
}
