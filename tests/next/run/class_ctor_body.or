// After the field-initializing prefix the constructor body may use `this` freely.
class Series {
  items: int[];
  total: int;
  constructor(n: int) {
    this.items = [];
    this.total = 0;
    let i = 1;
    while (i <= n) {
      this.add(i);
      i += 1;
    }
  }
  add(x: int): void {
    this.items.push(x);
    this.total += x;
  }
  early(limit: int): Series {
    return new Series(limit);
  }
}

class Guard {
  v: int;
  constructor(v: int) {
    this.v = v;
    if (v < 0) {
      this.v = 0;
      return;
    }
    this.v = v * 2;
  }
}

function main(): void {
  const s = new Series(4);
  console.log(s.total.toString() + " " + s.items.length.toString());
  console.log(s.early(10).total.toString());
  console.log(new Guard(0 - 5).v.toString() + " " + new Guard(21).v.toString());
}
