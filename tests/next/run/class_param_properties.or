// Parameter properties declare fields; plain constructor parameters do not.
export class User {
  constructor(public id: int, private name: string, scale: int, public score: int) {}
  displayName(): string {
    return this.name + "#" + this.id.toString();
  }
}

class Point {
  constructor(public x: int, public y: int) {}
  sum(): int {
    return this.x + this.y;
  }
}

function main(): void {
  const u = new User(7, "ann", 3, 40);
  console.log(u.displayName());
  console.log(u.score.toString());
  const p = new Point(3, 4);
  console.log(p.sum().toString());
  const q = new Point(p.y, p.x);
  console.log(q.x.toString() + "," + q.y.toString());
}
