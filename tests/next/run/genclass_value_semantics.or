// Generic class values are snapshots (ADR-0009): copies are independent, also through arrays, fields,
// function arguments, Option and Map; mutation goes through copy-on-write per instance.
class Counter<T> {
  items: T[] = [];
  label: string;
  constructor(label: string) {
    this.label = label;
  }
  add(x: T): void {
    this.items.push(x);
  }
  size(): usize {
    return this.items.length;
  }
  rename(l: string): void {
    this.label = l;
  }
}

type Holder = { c: Counter<int>; n: int; };

function addTwo(c: Counter<int>): usize {
  let local = c;
  local.add(1);
  local.add(2);
  return local.size();
}

function main(): void {
  let a = new Counter<int>("a");
  a.add(1);
  const b = a;
  a.add(2);
  a.rename("A");
  console.log(a.size().toString() + a.label + " " + b.size().toString() + b.label);
  // a callee's changes stay in the callee
  console.log(addTwo(a).toString() + " " + a.size().toString());
  // arrays and fields hold snapshots
  let arr = [a, b];
  arr[0].add(3);
  console.log(arr[0].size().toString() + " " + arr[1].size().toString() + " " + a.size().toString());
  let h = Holder { c: a, n: 0 };
  h.c.add(4);
  console.log(h.c.size().toString() + " " + a.size().toString());
  // Option, Map
  let o: Option<Counter<int>> = Some(a);
  a.add(5);
  console.log(o.unwrap().size().toString() + " " + a.size().toString());
  let m = new Map<string, Counter<string>>();
  let s = new Counter<string>("s");
  m.set("k", s);
  s.add("x");
  console.log(m.get("k").unwrap().size().toString() + " " + s.size().toString());
  // iteration works on a snapshot
  let k = new Counter<int>("k");
  k.add(1);
  let seen: usize = 0;
  for (const c of [k, k]) {
    k.add(2);
    seen += c.size().toString().length;
  }
  console.log(seen.toString());
}
