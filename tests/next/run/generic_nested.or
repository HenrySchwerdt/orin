type Pair<A, B> = { first: A; second: B; };

function wrap<T>(x: T): Option<T> {
  return Some(x);
}

function describe(o: Option<Pair<int, string[]>>): string {
  return match (o) {
    Some(p) => p.first.toString() + "/" + p.second.join(","),
    None => "nothing",
  };
}

function main(): void {
  const p = Pair { first: 1, second: ["a", "b"] };
  console.log(describe(Some(p)));
  console.log(describe(None));
  const w: Option<Pair<int, string[]>> = wrap(p);
  console.log(describe(w));
  const deep = wrap(wrap(wrap(Pair { first: wrap(1), second: [wrap("z")] })));
  match (deep) {
    Some(a) => {
      match (a) {
        Some(b) => {
          match (b) {
            Some(c) => {
              console.log(c.first.unwrap().toString() + c.second[0].unwrap());
            },
            None => {},
          }
        },
        None => {},
      }
    },
    None => {},
  }
  const nested: Pair<Pair<int, int>, Option<Pair<string, bool>>> = Pair {
    first: Pair { first: 1, second: 2 },
    second: Some(Pair { first: "k", second: true }),
  };
  console.log(nested.first.second.toString() + nested.second.unwrap().first);
}
