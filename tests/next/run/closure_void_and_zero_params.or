function run(f: () => void): void {
  f();
}

function each(xs: string[], f: (s: string) => void): void {
  for (const x of xs) {
    f(x);
  }
}

function make(msg: string): () => void {
  return () => console.log(msg);
}

function main(): void {
  const hello = () => console.log("hello");
  hello();
  run(hello);
  run(() => {
    console.log("block");
  });
  run(make("made"));
  const prefix = ">";
  each(["a", "b"], s => console.log(prefix + s));
  each(
    ["c"],
    (s: string): void => {
      console.log(s + s);
    },
  );
  const early = (n: int): void => {
    if (n < 0) {
      return;
    }
    console.log("n=" + n.toString());
  };
  early(-1);
  early(2);
  const noop: () => void = () => {};
  noop();
  console.log("done");
}
