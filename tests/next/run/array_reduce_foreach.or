function main(): void {
  const xs = [1, 2, 3, 4];
  console.log(xs.reduce((a, x) => a + x, 0).toString());
  console.log(xs.reduce((a, x) => a * x, 1).toString());
  const joined = xs.reduce((s, x) => s + x.toString() + ";", "");
  console.log(joined);
  const maxv = xs.reduce((m, x) => x > m ? x : m, 0);
  console.log(maxv.toString());
  const rev = xs.reduce((acc: int[], x) => [x].concat(acc), []);
  console.log(rev.map(x => x.toString()).join(""));
  const none: int[] = [];
  console.log(none.reduce((a, x) => a + x, 42).toString());
  xs.forEach(x => {
    console.log("item " + x.toString());
  });
  let k = 0;
  const label = "L";
  ["a", "b"].forEach(s => console.log(label + s));
  console.log(k.toString());
}
