// Companion modules (ADR-0046 S4): `./models.gen` does not exist on disk; its content is the recorded output of the
// `Json` processor (models.gen.Json.json). Generated functions, records, unions, classes and constants are used like
// hand-written ones; the generated code reads the private names of models.or.
import { makeUser, makeAccount } from "./models";
import {
  Pair, Shape, Circle, Dot, GREETING, describeUser, totalBalance, shapeArea, Counter, countdown, classify,
  secretCode, firstOr, orZero, doubled, firstTwo, kind,
} from "./models.gen";

function show(n: int): void {
  console.log(n.toString());
}

function main(): void {
  const ann = makeUser(3, "ann");
  console.log(describeUser(ann));
  console.log(GREETING);
  const accounts = [makeAccount(ann, 100), makeAccount(ann, 20)];
  // 120 (balances) + 10 (helper(5)) + 42 (secretBump(1))
  show(totalBalance(accounts));
  const p = Pair { left: 1, right: 2 };
  show(p.left + p.right);
  show(shapeArea(Circle(4)));
  show(shapeArea(Dot));
  let c = new Counter(10);
  show(c.bump(5));
  show(c.bump(1));
  show(countdown(7));
  console.log(classify(-4));
  console.log(classify(0));
  console.log(classify(9));
  console.log(classify(1000));
  show(secretCode());
  show(firstOr([], 99));
  show(firstOr([5, 6], 99));
  show(orZero(Some(8)));
  show(orZero(None));
  for (const x of firstTwo(4)) {
    show(x);
  }
  console.log(kind(1));
  console.log(kind(2));
  match (doubled(Ok(21))) {
    Ok(v) => { show(v); },
    Err(e) => { console.log(e); },
  }
  match (doubled(Err("bad"))) {
    Ok(v) => { show(v); },
    Err(e) => { console.log(e); },
  }
}
