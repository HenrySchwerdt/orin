// Arrow functions (ADR-0011): expression and block bodies, typed and untyped parameters.
function apply(f: (x: int) => int, v: int): int {
  return f(v);
}

function main(): void {
  const inc = (x: int): int => x + 1;
  const dbl = (x: int) => x * 2;
  const sq = (x: int) => {
    return x * x;
  };
  console.log(apply(inc, 41).toString());
  console.log(apply(dbl, 21).toString());
  console.log(apply(sq, 7).toString());
  console.log(apply(x => x - 1, 10).toString());
  console.log(apply(x => x + 100, 1).toString());
  console.log(
    apply((x: int): int => {
      return x % 7;
    }, 100).toString(),
  );
  const greet = (name: string, n: int) => name + "#" + n.toString();
  console.log(greet("ann", 3));
  const isEven = (n: int): bool => n % 2 == 0;
  console.log(isEven(4).toString() + isEven(5).toString());
  const zero = () => 0;
  const hello = () => "hello";
  console.log(zero().toString() + hello());
}
