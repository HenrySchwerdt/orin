// Generic classes (ADR-0026): `Box<T>`, explicit and inferred type arguments, one instance per type argument.
class Box<T> {
  value: T;
  constructor(v: T) {
    this.value = v;
  }
  get(): T {
    return this.value;
  }
  set(v: T): void {
    this.value = v;
  }
  swap(v: T): T {
    const old = this.value;
    this.value = v;
    return old;
  }
}

function unbox(b: Box<string>): string {
  return b.get() + "!";
}

function makeBox(n: int): Box<int> {
  return new Box(n * 2);
}

function main(): void {
  // explicit type arguments
  let a = new Box<int>(1);
  a.set(5);
  console.log(a.get().toString());
  // inferred from the constructor argument
  const s = new Box("hi");
  console.log(s.get());
  let f = new Box(2.5);
  const old = f.swap(3.5);
  console.log(old.toString() + " " + f.get().toString());
  // inferred from the expected type (no argument mentions T)
  const b: Box<bool> = new Box(true);
  console.log(b.get().toString());
  // from the parameter type and from the return type
  console.log(unbox(new Box("x")));
  console.log(makeBox(21).get().toString());
  // a bare integer literal defaults to `int`, adopts an explicit type argument
  const n = new Box(7);
  const u = new Box<usize>(7);
  const w = new Box<u8>(200);
  console.log(n.get().toString() + " " + u.get().toString() + " " + w.get().toString());
  // distinct instantiations are distinct types, nesting works
  const nested = new Box<Box<int>>(new Box<int>(7));
  console.log(nested.get().get().toString());
  let deep = new Box(new Box(new Box("deep")));
  deep.set(new Box(new Box("deeper")));
  console.log(deep.get().get().get());
  // an instantiation used before its first `new`
  const e: Option<Box<string>> = None;
  console.log(e.isNone().toString());
}
