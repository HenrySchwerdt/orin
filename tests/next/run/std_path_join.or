import { joinAll, join } from "std:path";

function main(): void {
  console.log(joinAll(["a", "b"]));
  console.log(joinAll(["/a", "b", "../c"]));
  console.log(joinAll(["a", "", "b/"]));
  console.log(joinAll([]));
  console.log(joinAll(["", ""]));
  console.log(joinAll(["a", "/b"]));
  console.log(joinAll(["..", "x"]));
  console.log(joinAll(["a/b", "../../.."]));
  console.log(joinAll(["/", "x"]));
  console.log(joinAll(["./a", "./b"]));
  console.log(join("a", "b"));
  console.log(join("/a", "b/../c"));
  console.log(join("", "x"));
  console.log(join("x", ""));
  console.log(join("", ""));
  console.log(join("a", "/b"));
}
