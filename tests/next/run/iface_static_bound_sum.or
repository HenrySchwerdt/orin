// Generic bound: T extends Shape is monomorphised (static dispatch), for several classes.
interface Shape {
  area(): int;
}

class Circle implements Shape {
  constructor(public r: int) {}
  area(): int { return 3 * this.r * this.r; }
}

class Square implements Shape {
  constructor(public s: int) {}
  area(): int { return this.s * this.s; }
}

function total<T extends Shape>(xs: T[]): int {
  let t = 0;
  for (const x of xs) {
    t += x.area();
  }
  return t;
}

function biggest<T extends Shape>(xs: T[]): int {
  let best = 0;
  let i: usize = 0;
  while (i < xs.length) {
    const a = xs[i].area();
    if (a > best) {
      best = a;
    }
    i += 1;
  }
  return best;
}

function main(): void {
  console.log(total([new Circle(1), new Circle(2)]).toString());
  console.log(total([new Square(2), new Square(3)]).toString());
  console.log(biggest([new Circle(2), new Circle(1)]).toString());
  const none: Square[] = [];
  console.log(total(none).toString());
  console.log(total<Square>([new Square(5)]).toString());
}
