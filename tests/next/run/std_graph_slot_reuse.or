import { newGraph, add, get, remove, contains, size } from "std:graph";

function main(): void {
  let g = newGraph<string>(3);
  const a = add(g, "first");
  g = a.graph;
  g = remove(g, a.id).unwrap();
  const b = add(g, "second");
  g = b.graph;
  // The slot is reused, but the old id stays stale because the generation moved on.
  console.log(get(g, b.id).unwrap());
  console.log(get(g, a.id).isErr().toString());
  console.log(contains(g, a.id).toString() + " " + contains(g, b.id).toString());
  console.log((a.id.index == b.id.index).toString());
  console.log((a.id.gen != b.id.gen).toString());
  console.log(size(g).toString());
  g = remove(g, b.id).unwrap();
  const c = add(g, "third");
  g = c.graph;
  console.log(get(g, b.id).isErr().toString() + " " + get(g, c.id).unwrap());
}
