// exit: 101
// stderr: trap: task panicked: unwrap on None
// std:task: a panic in a task ends only that task; join turns it into a trap of the joining task, with the task's message.
import { scope, spawn } from "std:task";

function boom(): int {
  const none: Option<int> = None;
  return none.unwrap();
}

function main(): void {
  console.log("before");
  const r = scope(s => {
    const good = spawn(s, () => 7);
    const bad = spawn(s, () => boom());
    console.log("good: " + good.join().toString());
    return bad.join();
  });
  console.log("not reached " + r.toString());
}
