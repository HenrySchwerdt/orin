// Closing brackets of nested type arguments (`>>`, `>>>`) in annotations, `new`, explicit call type
// arguments, aliases and `implements` lists. The lexer emits single `>` tokens, so no splitting is needed.
interface Shape {
  area(): int;
}

class Box<T> {
  value: T;
  constructor(v: T) {
    this.value = v;
  }
  get(): T {
    return this.value;
  }
}

class Wrap<T> implements Shape {
  inner: Box<Box<T>>;
  constructor(i: Box<Box<T>>) {
    this.inner = i;
  }
  area(): int {
    return 3;
  }
}

type Deep = Map<string, Box<Box<float>>>;

function id<T>(x: T): T {
  return x;
}

function main(): void {
  const a: Box<Box<int>> = new Box<Box<int>>(new Box<int>(1));
  const m: Deep = new Map<string, Box<Box<float>>>();
  let mm = m;
  mm.set("k", new Box(new Box(2.5)));
  const t: Box<Box<Box<int>>> = new Box<Box<Box<int>>>(new Box<Box<int>>(new Box<int>(7)));
  const w = new Wrap<int>(new Box<Box<int>>(a.get()));
  const arr: Box<Box<string>>[] = [new Box(new Box("s"))];
  const x = id<Box<Box<int>>>(a);
  const s: Shape = w;
  console.log(a.get().get().toString() + " " + mm.get("k").unwrap().get().get().toString());
  console.log(t.get().get().get().toString() + " " + w.area().toString());
  console.log(arr[0].get().get());
  console.log(x.get().get().toString() + " " + s.area().toString());
  // `>` comparisons next to each other still parse as before
  const n = 3;
  console.log((n > 2 && n > 1).toString());
}
