class Cell<T> {
  v: T;
  n: int = 0;
  constructor(v: T) { this.v = v; }
  get(): T { return this.v; }
  set(x: T): void { this.v = x; this.n += 1; }
  swap(x: T): T { const old = this.v; this.v = x; this.n += 1; return old; }
  count(): int { return this.n; }
}
function logIt(s: string): void { console.log(s); }
function capture<T>(f: () => T): () => T {
  const r = f();
  return () => { logIt("inner"); return r; };
}
function pop2<T>(xs: T[]): Option<T> {
  let ys = xs;
  return ys.pop();
}
type Rec<T> = { v: T; tag: int; };
function spreadIt<T>(b: Rec<T>, t: int): Rec<T> {
  return Rec<T> { ...b, tag: t };
}
function main(): void {
  let c = new Cell<void>(logIt("cell"));
  c.get();
  c.set(logIt("set"));
  c.swap(logIt("swap"));
  console.log(c.count().toString());
  const g = capture(() => { logIt("cap"); });
  g();
  let a: void[] = [];
  a.push(logIt("x"));
  const p = pop2(a);
  console.log(p.isSome().toString());
  console.log(a.length.toString());
  const e = pop2(a);
  const sp = spreadIt(Rec<void> { v: logIt("rec"), tag: 1 }, 5);
  console.log(sp.tag.toString());
  console.log(e.isSome().toString());
}
