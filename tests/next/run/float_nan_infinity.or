// NaN, Infinity, -0.0: printing, arithmetic and comparisons (IEEE-754, no traps)
function main(): void {
  const zero = 0.0;
  const inf = 1.0 / zero;
  const ninf = -1.0 / zero;
  const nan = zero / zero;
  console.log(inf.toString());
  console.log(ninf.toString());
  console.log(nan.toString());
  console.log((inf - inf).toString());
  console.log((inf * 0.0).toString());
  console.log((inf + 1.0).toString());
  console.log((ninf * -2.0).toString());
  console.log((-zero).toString());
  console.log((zero * -1.0).toString());
  console.log((nan == nan).toString());
  console.log((nan != nan).toString());
  console.log((nan < 1.0).toString());
  console.log((nan > 1.0).toString());
  console.log((nan <= nan).toString());
  console.log((nan >= nan).toString());
  console.log((zero == -zero).toString());
  console.log((inf > 1e308).toString());
  console.log((ninf < -1e308).toString());
  console.log(nan.isNaN().toString());
  console.log(inf.isNaN().toString());
  console.log(inf.isFinite().toString());
  console.log(nan.isFinite().toString());
  console.log(1.5.isFinite().toString());
  console.log((1e308 * 10.0).toString());
  console.log((5e-324 / 2.0).toString());
  console.log((1.0 / (-zero)).toString());
}
