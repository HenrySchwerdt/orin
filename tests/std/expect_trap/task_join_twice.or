// `orin test` must report this test as FAILED (a trap) in every build: a task result can be taken only once, a second join
// of the same handle traps instead of returning a stale value.
import { scope, spawn } from "std:task";

@Test
function joinTwiceTraps(): void {
  const r = scope(s => {
    const h = spawn(s, () => 1);
    return h.join() + h.join();
  });
  r + 1;
}
