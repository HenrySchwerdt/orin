function run<T>(f: () => T): T { return f(); }
function keep<T>(f: () => T): Option<T> { const r = f(); return Some(r); }
function wrapOk<T>(f: () => T): Result<T, string> { const r = f(); return Ok(r); }
function many<T>(f: () => T, n: int): T[] {
  let out: T[] = [];
  let i = 0;
  while (i < n) { out.push(f()); i += 1; }
  return out;
}
function main(): void {
  run(() => { console.log("hi"); });
  run<void>(() => { console.log("x"); });
  const o = keep(() => { console.log("keep"); });
  console.log(o.isSome().toString());
  const k = wrapOk(() => { console.log("wrap"); });
  console.log(k.isOk().toString());
  const xs = many(() => { console.log("m"); }, 3);
  console.log(xs.length.toString());
}
