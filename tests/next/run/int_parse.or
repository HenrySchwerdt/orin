// parseI8 .. parseUsize: Option of the value; None unless the whole string is an optionally negated decimal
// that fits the type. parseInt is parseI64.
function show8(o: Option<i8>): string {
  return match (o) {
    Some(v) => "Some(" + v.toString() + ")",
    None => "None"
  };
}

function showU8(o: Option<u8>): string {
  return match (o) {
    Some(v) => "Some(" + v.toString() + ")",
    None => "None"
  };
}

function main(): void {
  console.log(show8(parseI8("127")));
  console.log(show8(parseI8("-128")));
  console.log(show8(parseI8("128")));
  console.log(show8(parseI8("-129")));
  console.log(show8(parseI8("")));
  console.log(show8(parseI8("-")));
  console.log(show8(parseI8("12a")));
  console.log(show8(parseI8(" 1")));
  console.log(show8(parseI8("+1")));
  console.log(showU8(parseU8("255")));
  console.log(showU8(parseU8("256")));
  console.log(showU8(parseU8("-1")));
  console.log(showU8(parseU8("007")));
  console.log(parseI16("-32768").unwrap().toString());
  console.log(parseI16("32768").isNone().toString());
  console.log(parseU16("65535").unwrap().toString());
  console.log(parseI32("2147483647").unwrap().toString());
  console.log(parseI32("-2147483648").unwrap().toString());
  console.log(parseI32("2147483648").isNone().toString());
  console.log(parseU32("4294967295").unwrap().toString());
  console.log(parseU32("4294967296").isNone().toString());
  console.log(parseI64("-9223372036854775808").unwrap().toString());
  console.log(parseI64("9223372036854775808").isNone().toString());
  console.log(parseInt("9223372036854775807").unwrap().toString());
  console.log(parseIsize("-5").unwrap().toString());
  console.log(parseU64("18446744073709551615").unwrap().toString());
  console.log(parseU64("18446744073709551616").isNone().toString());
  console.log(parseU64("99999999999999999999999").isNone().toString());
  console.log(parseUsize("42").unwrap().toString());
  console.log(parseUsize("-42").isNone().toString());
  const v: i32 = parseI32("123").unwrap() + 1;
  console.log(v.toString());
  const n = parseU8("200").unwrap();
  console.log((n.wrappingAdd(100)).toString());
}
