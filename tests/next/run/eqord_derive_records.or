type Point = { x: int; y: int; };
type Shape = Circle(int) | Rect(int, int) | Empty;

function max<T extends Ord>(a: T, b: T): T {
  return a > b ? a : b;
}

function same<T extends Eq>(a: T, b: T): bool {
  return a == b;
}

function main(): void {
  const p = Point { x: 1, y: 2 };
  const q = Point { x: 1, y: 3 };
  console.log((p == q).toString());
  console.log((p != q).toString());
  console.log((p < q).toString());
  console.log(p.compare(q).toString());
  console.log(max(p, q).y.toString());
  console.log(max("a", "b"));
  console.log(max(3, 9).toString());
  console.log(same(Circle(2), Circle(2)).toString());
  console.log(same(Circle(2), Rect(2, 3)).toString());
  console.log((Rect(1, 2) < Rect(1, 3)).toString());
  console.log((Empty < Circle(0)).toString());
  const a: int[] = [1, 2, 3];
  const b: int[] = [1, 2, 4];
  console.log((a < b).toString());
  console.log((a == b).toString());
  const o1: Option<string> = Some("x");
  const o2: Option<string> = None;
  console.log((o1 == o2).toString());
  console.log((o2 < o1).toString());
  console.log((p.hash() == Point { x: 1, y: 2 }.hash()).toString());
  let m = new Map<Point, string>();
  m.set(p, "p");
  m.set(q, "q");
  console.log(m.get(Point { x: 1, y: 3 }).unwrapOr("none"));
  console.log(m.size.toString());
}
