type Entry = { word: string; count: int; };

function addWord(entries: Entry[], w: string): Entry[] {
  let es = entries;
  let i: usize = 0;
  while (i < es.length) {
    if (es[i].word == w) {
      es[i].count += 1;
      return es;
    }
    i += 1;
  }
  es.push(Entry { word: w, count: 1 });
  return es;
}

function main(): void {
  const text = "the cat and the dog and the bird";
  let entries: Entry[] = [];
  for (const w of text.split(" ")) {
    entries = addWord(entries, w);
  }
  for (const e of entries) {
    console.log(e.word + ": " + e.count.toString());
  }
  let best = entries[0];
  for (const e of entries) {
    if (e.count > best.count) {
      best = e;
    }
  }
  console.log("most frequent: " + best.word + " (" + best.count.toString() + ")");
  console.log("distinct: " + entries.length.toString());
}
