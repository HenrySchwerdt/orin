function main(): void {
  report(quarter(12));
  report(quarter(6));
  report(quarter(8));
  console.log(pick(5).toString());
  console.log(pick(-5).toString());
  console.log(pick2(true).toString());
}

function report(r: Result<int, string>): void {
  match (r) {
    Ok(v) => { console.log("ok " + v.toString()); },
    Err(e) => { console.log("err " + e); },
  }
}

function half(n: int): Result<int, string> {
  if (n % 2 != 0) {
    return Err("odd");
  }
  return Ok(n / 2);
}

function quarter(n: int): Result<int, string> {
  const h = half(n)?;
  const q = half(h)?;
  return Ok(q);
}

function flag(n: int): bool {
  return n > 0;
}

function pick(n: int): int {
  return flag(n) ? 1 : 2;
}

function pick2(b: bool): int {
  return b ?10 : 20;
}
