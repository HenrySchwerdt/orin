// Orin protocol test harness (ADR-0047 phase 5): the Orin port of tools/test_lsp.py and tools/test_mcp.py, with the same
// test cases, assertions, `FAIL: ...` lines, summary and exit status. See tooling/protocol/README.md and docs/testing.md.
//
//   orin-protocol lsp|mcp [--orin PATH] [--orin2 PATH] [--root DIR]
//
// Builds `compiler/main.or` with the bootstrapped compiler (`--orin2`) into build/protocol/<suite>/orin unless `--orin`
// names a compiler binary, starts `orin lsp` / `orin mcp` and speaks the protocol with it.
// Exit status: 0 every check passed, 1 a check failed or the run could not be completed, 2 usage.

import { Host, withHost } from "std:host";
import { ProcessGrant, args, exit } from "std:process";
import { FsGrant, readFile, exists } from "std:fs";
import { shell } from "std:io";
import { shq, strip } from "./text";
import { Options, parseArgs, usage, helpText } from "./cli";
import { Session, LSP, MCP } from "./session";
import { runLsp } from "./lsp";
import { runMcp } from "./mcp";

function readText(fs: FsGrant, path: string): string {
  const r = readFile(fs, path);
  return r.isOk() ? r.unwrap() : "";
}

// `mktemp -d` with a prefix (the `tempfile.mkdtemp` of the Python scripts); "" on failure. `note` is a scratch file.
function makeTemp(fs: FsGrant, proc: ProcessGrant, prefix: string, note: string): string {
  if (shell(proc, "mktemp -d \"${TMPDIR:-/tmp}/" + prefix + "XXXXXX\" > " + shq(note)) != 0) {
    return "";
  }
  let p = strip(readText(fs, note));
  while (p.includes("//")) {
    p = p.split("//").join("/");
  }
  return p;
}

// The absolute form of a path given relative to the current directory.
function absolute(cwd: string, p: string): string {
  return p.startsWith("/") ? p : cwd + "/" + p;
}

// Builds the compiler under test (`orin compile compiler/main.or`, then the C compiler), like `build()` of the Python
// scripts. Returns the binary, or "" after printing the error.
function buildCompiler(fs: FsGrant, proc: ProcessGrant, root: string, orin2: string, outDir: string): string {
  if (shell(proc, "mkdir -p " + shq(outDir)) != 0) {
    console.error("cannot create " + outDir);
    return "";
  }
  const c = outDir + "/orin.c";
  const exe = outDir + "/orin";
  const err = outDir + "/build.err";
  const compile = "cd " + shq(root) + " && " + shq(orin2) + " compile compiler/main.or -o " + shq(c) + " 2> " + shq(err);
  if (shell(proc, compile) != 0) {
    console.error("orin2 failed to compile compiler/main.or:\n" + readText(fs, err));
    return "";
  }
  const cc = "cd " + shq(root) + " && cc -O1 -w -I runtime/core " + shq(c)
    + " runtime/core/orin_runtime.c runtime/platform/orin_platform.c -o " + shq(exe) + " 2> " + shq(err);
  if (shell(proc, cc) != 0) {
    console.error("cc failed:\n" + readText(fs, err));
    return "";
  }
  return exe;
}

function run(fs: FsGrant, proc: ProcessGrant, argv: string[]): int {
  const parsed = parseArgs(argv);
  if (!parsed.ok) {
    console.error(usage());
    console.error("orin-protocol: error: " + parsed.error);
    return 2;
  }
  if (parsed.options.help) {
    console.log(helpText());
    return 0;
  }
  const o: Options = parsed.options;
  const lsp = o.suite == "lsp";

  // the working directory and the repository root, absolute (the commands below `cd`)
  const scratch = "/tmp/orin-protocol-cwd." + o.suite;
  if (shell(proc, "pwd -P > " + shq(scratch) + " && cd " + shq(o.root) + " && pwd -P >> " + shq(scratch)) != 0) {
    console.error("orin-protocol: cannot enter the root " + o.root);
    return 1;
  }
  const where = readText(fs, scratch).split("\n");
  const cwd = where[0];
  const root = where[1];

  let exe = o.orin;
  if (exe == "") {
    const orin2Full = o.orin2.startsWith("/") ? o.orin2 : root + "/" + o.orin2;
    if (!exists(fs, orin2Full)) {
      console.error("missing " + orin2Full + " (run tools/bootstrap.sh)");
      return 1;
    }
    exe = buildCompiler(fs, proc, root, orin2Full, root + "/build/protocol/" + o.suite);
    if (exe == "") {
      return 1;
    }
  } else {
    exe = absolute(cwd, exe);
  }

  const note = scratch + ".tmp";
  const dir = makeTemp(fs, proc, "orin-protocol-" + o.suite + ".", note);
  if (dir == "") {
    console.error("orin-protocol: cannot create a work directory");
    return 1;
  }
  const proj = makeTemp(fs, proc, lsp ? "orin_lsp_" : "orin-mcp-", note);
  if (proj == "") {
    console.error("orin-protocol: cannot create a project directory");
    return 1;
  }
  const s = new Session(dir, lsp ? LSP : MCP);
  if (lsp) {
    runLsp(fs, proc, s, exe, proj);
  } else {
    runMcp(fs, proc, s, exe, root, proj);
  }
  const fatal = s.fatal(fs);
  if (fatal != "") {
    console.error((lsp ? "test_lsp: " : "test_mcp: ") + fatal);
    // the server may still be running: end its input and kill it
    shell(proc, "kill $(cat " + shq(dir + "/pid") + ") 2>/dev/null; : 1<> " + shq(dir + "/ctl") + "; rm -rf " + shq(dir) + " " + shq(scratch) + " " + shq(note) + "; true");
    return 1;
  }
  const t = s.totals(fs);
  if (lsp) {
    console.log("test_lsp: " + t.checks.toString() + " checks, " + t.failures.toString() + " failed");
  } else {
    console.log(t.checks.toString() + " checks, " + t.failures.toString() + " failures");
  }
  shell(proc, "rm -rf " + shq(dir) + " " + shq(scratch) + " " + shq(note));
  return t.failures > 0 ? 1 : 0;
}

function main(host: Host): void {
  const code = withHost(host, (fs, proc, stdio, clock) => run(fs, proc, args(proc)));
  exit(code);
}
