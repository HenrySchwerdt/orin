function size<V>(m: Map<string, V>): usize {
  return m.size;
}

function firstValue<V>(m: Map<string, V>): Option<V> {
  const ks = m.keys();
  if (ks.length == 0) {
    return None;
  }
  return m.get(ks[0]);
}

function fill(n: int): Map<int, string> {
  let m = new Map<int, string>();
  let i = 0;
  while (i < n) {
    m.set(i, "v" + i.toString());
    i += 1;
  }
  return m;
}

function main(): void {
  let a = new Map<string, float>();
  a.set("x", 1.5);
  a.set("y", 2.5);
  console.log(size(a).toString());
  console.log(firstValue(a).unwrap().toString());
  let b = new Map<string, bool>();
  console.log(firstValue(b).isNone().toString());
  b.set("t", true);
  console.log(firstValue(b).unwrap().toString());
  const f = fill(5);
  console.log(f.keys().length.toString());
  console.log(f.get(3).unwrap());
}
