// error: E0402
import { newGraph, add, get, remove } from "std:graph";

function main(): void {
  const g = newGraph<int>(1);
  const a = add(g, 1);
  match (get(a.graph, a.id)) {
    Ok(v) => { console.log(v.toString()); },
    Err(e) => {
      match (e) {
        StaleId => { console.log("stale"); }
      }
    }
  }
}
