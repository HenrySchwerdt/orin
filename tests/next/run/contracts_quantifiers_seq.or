// flags: --check-contracts
// exit: 101
// stderr: contract violated: @Requires(this.items.length == 0 || this.items[this.items.length - 1] <= x)
// Bounded quantifiers and sums in contracts (ADR-0031 C11-C13, ADR-0035) run as ordinary code under
// --check-contracts: `every` / `some` over an array, `range(a, b).every(..)` over an index range, `sum` / `sumBy`
// from std:seq. `orin verify --contracts` reads the same clauses as quantified formulas
// (tests/contracts/verify_quantifiers.or); the run-time meaning is the one of the code.
import { range, sum, sumBy } from "std:seq";

type Item = { price: int; qty: int; };

@Invariant(range(1, this.items.length).every(i => this.items[i - 1] <= this.items[i]))
class SortedList {
  private items: int[] = [];

  constructor() {
  }

  @Requires(this.items.length == 0 || this.items[this.items.length - 1] <= x)
  @Ensures(this.items.length == old(this.items.length) + 1)
  append(x: int): void {
    this.items.push(x);
  }

  size(): usize {
    return this.items.length;
  }
}

@Invariant(this.total == sumBy(this.items, it => it.price * it.qty))
class Invoice {
  private items: Item[] = [];
  private total: int = 0;

  constructor() {
  }

  @Ensures(this.total == old(this.total) + price * qty)
  add(price: int, qty: int): void {
    this.items.push(Item { price: price, qty: qty });
    this.total += price * qty;
  }

  @Ensures(result == sumBy(this.items, it => it.price * it.qty))
  amount(): int {
    return this.total;
  }
}

@Requires(xs.every(x => x > 0))
@Ensures(result == sum(xs))
@Ensures(xs.length == 0 || result > 0)
function total(xs: int[]): int {
  let s = 0;
  for (const x of xs) {
    s += x;
  }
  return s;
}

@Requires(range(0, xs.length).every(i => xs[i] >= 0))
@Ensures(result.length == xs.length && result.every(x => x >= 1))
function bump(xs: int[]): int[] {
  return xs.map(x => x + 1);
}

function main(): void {
  let l = new SortedList();
  l.append(1);
  l.append(3);
  l.append(3);
  console.log(l.size().toString());
  let inv = new Invoice();
  inv.add(5, 2);
  inv.add(1, 7);
  console.log(inv.amount().toString());
  console.log(total([1, 2, 3]).toString());
  console.log(bump([0, 1]).length.toString());
  console.log(range(2, 5).length.toString());
  console.log(sum([4, 5, 6]).toString());
  console.log([1, 2, 3].some(x => x == 2) ? "some" : "none");
  let bad = new SortedList();
  bad.append(5);
  // The last call breaks the ordering precondition: a violation report at run time, exit 101.
  bad.append(4);
}
