        return false;
      }
      if (hasHi && (compareBytewise(nodes[id].keys[kc - 1], hi) >= 0)) {
        return false;
      }
    }
    const kk = nodes[id].kids.length;
    if (kk > 0 && kk != kc + 1) {
      return false;
    }
    let c: usize = 0;
    while (c < kk) {
      if (nodes[id].kids[c] >= nodes.length) {
        return false;
      }
      ids.push(nodes[id].kids[c]);
      if (c == 0) {
