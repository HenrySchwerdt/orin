// flags: --check-contracts
// Contract clauses on a generic class and its methods (ADR-0012 x ADR-0026): the expressions are checked
// once with opaque type parameters (so they may use T-typed values only the way every type allows), and the
// runtime checks run per instantiation.
interface Sized {
  size(): usize;
}

@Invariant(this.items.length <= this.cap)
class Bounded<T> {
  items: T[] = [];
  cap: usize;

  @Requires(cap > 0)
  constructor(cap: usize) {
    this.cap = cap;
  }

  @Requires(this.items.length < this.cap)
  @Ensures(this.items.length == old(this.items.length) + 1)
  push(x: T): void {
    this.items.push(x);
  }

  @Requires(this.items.length > 0)
  @Ensures(this.items.length + 1 == old(this.items.length))
  pop(): T {
    return this.items.pop().unwrap();
  }

  @Ensures(result == this.items.length)
  count(): usize {
    return this.items.length;
  }

  @Ensures(result.length == this.items.length)
  snapshot(): T[] {
    return this.items;
  }
}

// a bound lets the contract call the interface method on a T-typed value
class Sack implements Sized {
  n: usize;
  constructor(n: usize) {
    this.n = n;
  }
  size(): usize {
    return this.n;
  }
}

@Invariant(this.total >= 0)
class Weighed<T extends Sized> {
  total: int = 0;
  last: Option<T> = None;

  @Requires(x.size() < 100)
  @Ensures(this.total == old(this.total) + x.size().toInt())
  add(x: T): void {
    this.total += x.size().toInt();
    this.last = Some(x);
  }
}

function main(): void {
  let a = new Bounded<int>(2);
  a.push(1);
  a.push(2);
  const before = a.count();
  const top = a.pop();
  console.log(before.toString() + " " + top.toString());
  let b = new Bounded<string>(1);
  b.push("x");
  const snap = b.snapshot().length;
  console.log(snap.toString() + " " + b.pop());
  let w = new Weighed<Sack>();
  w.add(new Sack(5));
  w.add(new Sack(7));
  console.log(w.total.toString());
}
