// std:text -- pure text-layout utilities for compilers, diagnostics, documentation and CLIs.
//
// Orin strings are byte strings (see std:utf8). All indices below count bytes, never
// Unicode code points. Whitespace in this module means ASCII SP, TAB or CR.
// UTF-8 data is preserved byte-for-byte; Unicode segmentation belongs in std:utf8.
// No platform calls, no additional trusted code, no runtime reflection.
// Every function is total (never traps) and O(n) in the size of its input and output.

// True when `line` consists only of ASCII SP, TAB and CR (the empty line included).
export function isBlankLine(line: string): bool {
  let i: usize = 0;
  while (i < line.length) {
    const c = line.charCodeAt(i);
    if (c != 32 && c != 9 && c != 13) {
      return false;
    }
    i += 1;
  }
  return true;
}

// The leading run of ASCII SP / TAB of `line`, as a string (the indentation itself, not its width).
@Ensures(result.length <= line.length && line.startsWith(result))
export function leadingIndent(line: string): string {
  let i: usize = 0;
  while (i < line.length) {
    const c = line.charCodeAt(i);
    if (c != 32 && c != 9) {
      break;
    }
    i += 1;
  }
  return line.substring(0, i);
}

// The longest common prefix of `a` and `b`, byte by byte.
@Ensures(a.startsWith(result) && b.startsWith(result))
function commonPrefix(a: string, b: string): string {
  let i: usize = 0;
  while (i < a.length && i < b.length && a.charCodeAt(i) == b.charCodeAt(i)) {
    i += 1;
  }
  return a.substring(0, i);
}

// trimBlankLines: removes outer whitespace-only lines, retaining internal blank lines.
// An empty or whitespace-only input produces "". The line break after the last kept line is removed.
@Ensures(result.length <= text.length)
@Ensures(result.length == 0 || !isBlankLine(result.split("\n")[0]))
@Ensures(result.length == 0 || !isBlankLine(result.split("\n")[result.split("\n").length - 1]))
export function trimBlankLines(text: string): string {
  const lines = text.split("\n");
  let first: usize = 0;
  while (first < lines.length && isBlankLine(lines[first])) {
    first += 1;
  }
  let last = lines.length;
  while (last > first && isBlankLine(lines[last - 1])) {
    last -= 1;
  }
  return lines.slice(first, last).join("\n");
}

// dedent: removes the longest common indentation *prefix* (the same sequence of SP / TAB bytes, as in
// Python's textwrap.dedent) from every nonblank line. A tab and a space never match, so "\tfoo\n  bar"
// has no common indentation and is returned unchanged. Blank lines become empty; the number of lines,
// and therefore a trailing newline, is preserved.
@Ensures(result.length <= text.length)
@Ensures(result.split("\n").length == text.split("\n").length)
export function dedent(text: string): string {
  const lines = text.split("\n");
  let common = "";
  let found = false;
  for (const line of lines) {
    if (!isBlankLine(line)) {
      const ind = leadingIndent(line);
      common = found ? commonPrefix(common, ind) : ind;
      found = true;
    }
  }
  if (!found) {
    return text;
  }
  return lines.map(line => isBlankLine(line) ? "" : line.substring(common.length, line.length)).join("\n");
}

// indentLines: prefixes each non-empty line with `prefix`; empty lines (and so a trailing newline) stay
// empty. The prefix may be any byte string. O(n + number_of_lines * prefix.length).
@Ensures(result.length >= text.length)
@Ensures(prefix.length == 0 ==> result == text)
@Ensures(result.split("\n").length == text.split("\n").length)
export function indentLines(text: string, prefix: string): string {
  if (text.length == 0 || prefix.length == 0) {
    return text;
  }
  return text.split("\n").map(line => line.length == 0 ? "" : prefix + line).join("\n");
}

// normalizeNewlines: converts CRLF and a lone CR to LF without touching other bytes.
// This is deliberately not a Unicode normalization operation.
@Ensures(result.length <= text.length)
@Ensures(result.indexOf("\r").isNone())
@Ensures(text.indexOf("\r").isNone() ==> result == text)
export function normalizeNewlines(text: string): string {
  let parts: string[] = [];
  let start: usize = 0;
  let i: usize = 0;
  while (i < text.length) {
    if (text.charCodeAt(i) == 13) {
      parts.push(text.substring(start, i));
      parts.push("\n");
      if (i + 1 < text.length && text.charCodeAt(i + 1) == 10) {
        i += 1;
      }
      i += 1;
      start = i;
    } else {
      i += 1;
    }
  }
  if (start == 0) {
    return text;
  }
  parts.push(text.substring(start, text.length));
  return parts.join("");
}
