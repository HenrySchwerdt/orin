// Plain data types; the codecs are generated into the companion module `./models.gen` by the `@Json` processor.
import { Json, JsonName } from "json-codec";

@Json
export type Address = { street: string; zip: int; };

@Json
export type User = {
  id: int;
  @JsonName("display_name") name: string;
  admin: bool;
  tags: string[];
  nick: Option<string>;
  address: Address;
  previous: Address[];
  scores: Option<int[]>;
};
