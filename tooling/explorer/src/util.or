// Small deterministic helpers: string order, slugs, truncation, counting.

export function strCmp(a: string, b: string): int {
  const n = a.length < b.length ? a.length : b.length;
  let i: usize = 0;
  while (i < n) {
    const x = a.charCodeAt(i);
    const y = b.charCodeAt(i);
    if (x != y) {
      return x < y ? -1 : 1;
    }
    i += 1;
  }
  if (a.length == b.length) {
    return 0;
  }
  return a.length < b.length ? -1 : 1;
}

export function lower(s: string): string {
  let out = "";
  let i: usize = 0;
  while (i < s.length) {
    const c = s.charCodeAt(i);
    out += c >= 65 && c <= 90 ? String.fromCharCode(c + 32) : s.substring(i, i + 1);
    i += 1;
  }
  return out;
}

// A file-name safe, lower-case form of `s`: [a-z0-9._-] stay, every other run of characters becomes one `-`.
export function slugOf(s: string): string {
  const l = lower(s);
  let out = "";
  let lastDash = true;
  let i: usize = 0;
  while (i < l.length) {
    const c = l.charCodeAt(i);
    const ok = (c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c == 46 || c == 95;
    if (ok) {
      out += l.substring(i, i + 1);
      lastDash = false;
    } else if (!lastDash) {
      out += "-";
      lastDash = true;
    }
    i += 1;
  }
  while (out.startsWith(".") || out.startsWith("-")) {
    out = out.substring(1, out.length);
  }
  while (out.endsWith("-") || out.endsWith(".")) {
    out = out.substring(0, out.length - 1);
  }
  if (out.length == 0) {
    out = "x";
  }
  return out.length > 80 ? out.substring(0, 80) : out;
}

// `s` cut to at most `n` characters with an ellipsis (ASCII cut; non-ASCII bytes are never split because the cut moves back
// to a character boundary).
export function clip(s: string, n: usize): string {
  if (s.length <= n) {
    return s;
  }
  let k = n;
  while (k > 0 && s.charCodeAt(k) >= 128 && s.charCodeAt(k) < 192) {
    k -= 1;
  }
  return s.substring(0, k) + "…";
}

export function firstLine(s: string): string {
  const i = s.indexOf("\n");
  return i.isSome() ? s.substring(0, i.unwrap()) : s;
}

export function plural(n: int, one: string, many: string): string {
  return n.toString() + " " + (n == 1 ? one : many);
}

// the part of `s` after the last occurrence of `sep` (all of `s` when there is none)
export function afterLast(s: string, sep: string): string {
  const parts = s.split(sep);
  return parts[parts.length - 1];
}

// "12 %" style: whole percent of a / b, "0 %" when b is 0
export function percent(a: int, b: int): string {
  return b == 0 ? "0 %" : ((a * 100) / b).toString() + " %";
}
