// `orin test` must report this test as FAILED (a trap): the constructor of Headers validates in every build, so a
// header value with CR LF (header injection) cannot be built with `new`. tools/test_std.sh expects the failure;
// tools/mutation.sh std uses it to kill the mutant that skips the validation.
import { Headers } from "std:http";

@Test
function constructorTrapsOnInjection(): void {
  const h = new Headers(["X-A", "X-B"], ["1", "2\r\nSet-Cookie: stolen=1"]);
  h.count();
}
