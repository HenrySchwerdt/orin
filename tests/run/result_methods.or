function main(): void {
  const ok: Result<int, string> = Ok(3);
  const er: Result<int, string> = Err("bad");
  console.log(ok.isOk().toString());
  console.log(ok.isErr().toString());
  console.log(er.isOk().toString());
  console.log(er.isErr().toString());
  console.log(ok.unwrap().toString());
  console.log(er.unwrapErr());
  const v: Result<void, string> = Ok();
  console.log(v.isOk().toString());
  const e2: Result<void, string> = Err("no");
  console.log(e2.unwrapErr());
}
