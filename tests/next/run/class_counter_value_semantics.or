// Spec 03: copies are snapshots; mutating methods rebind the receiver.
class Counter {
  constructor(public value: int) {}
  increment(): void {
    this.value += 1;
  }
  get(): int {
    return this.value;
  }
}

function main(): void {
  let a = new Counter(0);
  const b = a;
  a.increment();
  console.log(a.value.toString());
  console.log(b.value.toString());
  let c = b;
  c.increment();
  c.increment();
  console.log(c.get().toString() + " " + b.get().toString() + " " + a.get().toString());
}
