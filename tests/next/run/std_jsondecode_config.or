import { decodeConfig } from "../../../examples/json_config";
import { JsonValue, parseDocument, defaultReadOptions } from "std:json";
import { formatPath } from "std:json/decode";
function main(): void {
  const config = decodeConfig(
    parseDocument("{\"endpoint\":\"localhost\",\"port\":8.080e3}", defaultReadOptions()).unwrap(),
  ).unwrap();
  console.log(config.endpoint);
  console.log(config.port.toString());
  console.log(config.enabled.toString());
  console.log(
    formatPath(
      decodeConfig(
        parseDocument("{\"endpoint\":\"localhost\",\"port\":0}", defaultReadOptions()).unwrap(),
      ).unwrapErr().path,
    ),
  );
}
